+		DC->getCVarString( "eta_storyMap", storyMap, sizeof( storyMap ) );
+		DC->getCVarString( "mapname", mapname, sizeof( mapname ) );
+		if ( !briefing[0] && storyMap[0] && !Q_stricmp( storyMap, mapname ) ) {
