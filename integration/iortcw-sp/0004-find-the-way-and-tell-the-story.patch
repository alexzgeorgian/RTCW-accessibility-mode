+/*
+ * Whether the story values are this level's. A level built for the mode
+ * names itself in eta_storyMap as it spawns; the values another level
+ * left behind are never read on one that did not set them.
+ */
+static qboolean CG_AccessibilityStoryLevel( void ) {
+	char storyMap[MAX_QPATH], mapname[MAX_QPATH];
+
+	trap_Cvar_VariableStringBuffer( "eta_storyMap", storyMap, sizeof( storyMap ) );
+	trap_Cvar_VariableStringBuffer( "mapname", mapname, sizeof( mapname ) );
+	return ( storyMap[0] && !Q_stricmp( storyMap, mapname ) ) ? qtrue : qfalse;
+}
+
+/* A story value, or empty on a level that is not telling one. A script
+   cannot set a cvar to nothing, so "none" clears one. */
+static void CG_AccessibilityStoryValue( const char *name, char *out, int size ) {
+	out[0] = '\0';
+	if ( CG_AccessibilityStoryLevel() ) {
+		trap_Cvar_VariableStringBuffer( name, out, size );
+		if ( !Q_stricmp( out, "none" ) ) {
+			out[0] = '\0';
+		}
+	}
+}
 static eta_enemy_t eta_enemies[MAX_GENTITIES];
 
 /*
@@ -169,8 +209,50 @@ static void CG_AccessibilityAmmo( int weapon, int *loaded, int *reserve ) {
 	*reserve = ps->ammo[BG_FindAmmoForWeapon( weapon )];
 }
 
+/*
+ * A name the level gives a kind of character, from eta_enemyNames:
+ * "1=Sentinel;7=Elite sentinel", by RTCW's character numbers. A story set
+ * on another world calls its soldiers what the book calls them.
+ */
+static const char *CG_AccessibilityLevelName( int aiChar ) {
+	static char name[64];
+	char names[MAX_STRING_CHARS];
+	char *p;
+
+	CG_AccessibilityStoryValue( "eta_enemyNames", names, sizeof( names ) );
+	for ( p = names; *p; ) {
+		int number = atoi( p );
+		char *eq = strchr( p, '=' );
+		char *end = strchr( p, ';' );
+
+		if ( !eq ) {
+			break;
+		}
+		if ( number == aiChar && ( !end || eq < end ) ) {
+			int length = end ? (int)( end - eq - 1 ) : (int)strlen( eq + 1 );
+
+			if ( length >= (int)sizeof( name ) ) {
+				length = sizeof( name ) - 1;
+			}
+			memcpy( name, eq + 1, length );
+			name[length] = '\0';
+			return name[0] ? name : NULL;
+		}
+		if ( !end ) {
+			break;
+		}
+		p = end + 1;
+	}
+	return NULL;
+}
+
 /* An enemy as the player would name him. */
 static const char *CG_AccessibilityEnemyName( const centity_t *cent ) {
+	const char *named = CG_AccessibilityLevelName( cent->currentState.aiChar );
+
+	if ( named ) {
+		return named;
+	}
 	switch ( cent->currentState.aiChar ) {
 	case AICHAR_SOLDIER:        return "Soldier";
 	case AICHAR_AMERICAN:       return "American";
@@ -592,11 +674,23 @@ static void CG_AccessibilityEnemies_f( void ) {
 static void CG_AccessibilityObjective_f( void ) {
 	char objective[MAX_STRING_CHARS];
 
-	trap_Cvar_VariableStringBuffer( "eta_objective", objective, sizeof( objective ) );
+	CG_AccessibilityStoryValue( "eta_objective", objective, sizeof( objective ) );
 	if ( !objective[0] ) {
 		CG_AccessibilitySayNow( "No objective given. The notebook, on N, has this level's orders" );
 		return;
 	}
+	if ( eta.hasGoal ) {
+		char goal[MAX_STRING_CHARS];
+		size_t length = strlen( objective );
+
+		/* The objective is a sentence with its own full stop. */
+		if ( length && objective[length - 1] == '.' ) {
+			objective[length - 1] = '\0';
+		}
+		Q_strncpyz( goal, CG_AccessibilityGoalText(), sizeof( goal ) );
+		CG_AccessibilitySayNow( va( "Objective: %s. Go to %s", objective, goal ) );
+		return;
+	}
 	CG_AccessibilitySayNow( va( "Objective: %s", objective ) );
 }
 
