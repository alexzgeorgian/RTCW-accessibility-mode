+			/* A briefing ends in a full stop of its own. */
+			while ( length && ( briefing[length - 1] == '.' || briefing[length - 1] == ' ' ) ) {
+				briefing[--length] = '\0';
+			}
+		}
+		Q_strcat( briefing, sizeof( briefing ), briefing[0] ? ". Press Enter to begin" : "Press Enter to begin" );
 		ETA_ReadLong( briefing );
 		return;
 	}
