@@ -804,6 +898,138 @@ static void CG_AccessibilityStoryFrame( void ) {
 	}
 }
 
+/*
+=================
+The goal
+
+A level's script marks the next place to go with eta_goal: "x y z" and
+a name, "480 1216 48 the generator". A beacon sounds from there, a
+soft tone every second and a bit, which the engine's 3D sound puts
+where it is; O says its direction and distance; arriving is said. An
+empty eta_goal clears it.
+=================
+*/
+
+#define ETA_GOAL_REACHED 80.0f
+
+static void CG_AccessibilityGoalFrame( void ) {
+	char spec[MAX_STRING_CHARS];
+	float distance;
+
+	CG_AccessibilityStoryValue( "eta_goal", spec, sizeof( spec ) );
+	if ( strcmp( spec, eta.goalSpec ) ) {
+		char *p = spec;
+		int i;
+
+		Q_strncpyz( eta.goalSpec, spec, sizeof( eta.goalSpec ) );
+		eta.hasGoal = qfalse;
+		eta.atGoal = qfalse;
+		eta.goalName[0] = '\0';
+		for ( i = 0; i < 3; i++ ) {
+			char *token = COM_Parse( &p );
+
+			if ( !token[0] ) {
+				break;
+			}
+			eta.goal[i] = atof( token );
+		}
+		if ( i == 3 ) {
+			while ( *p == ' ' ) {
+				p++;
+			}
+			Q_strncpyz( eta.goalName, p[0] ? p : "the goal", sizeof( eta.goalName ) );
+			eta.hasGoal = qtrue;
+			eta.lastBeacon = 0;
+		}
+	}
+
+	if ( !eta.hasGoal ) {
+		return;
+	}
+
+	distance = Distance( eta.goal, cg.predictedPlayerState.origin );
+	if ( distance < ETA_GOAL_REACHED ) {
+		if ( !eta.atGoal ) {
+			eta.atGoal = qtrue;
+			CG_AccessibilitySay( va( "At %s", eta.goalName ) );
+		}
+	} else if ( distance > ETA_GOAL_REACHED * 2 ) {
+		eta.atGoal = qfalse;
+	}
+
+	if ( eta.cueBeacon && cg.time - eta.lastBeacon >= 1300 && !eta.atGoal ) {
+		trap_S_StartSound( eta.goal, ENTITYNUM_WORLD, CHAN_AUTO, eta.cueBeacon );
+		eta.lastBeacon = cg.time;
+	}
+}
+
+/* The goal in words: "the generator, ahead right, 12 meters". */
+static const char *CG_AccessibilityGoalText( void ) {
+	int meters;
+	const char *where;
+
+	if ( !eta.hasGoal ) {
+		return NULL;
+	}
+	where = CG_AccessibilityDirection( eta.goal, &meters );
+	return va( "%s, %s, %i %s%s", eta.goalName, where, meters, meters == 1 ? "meter" : "meters",
+			   CG_AccessibilityHeight( eta.goal ) );
+}
+
+/*
+=================
+Walking into things
+
+Pressing to walk and not moving is the one thing a sighted player never
+has to be told. A thud from the side that is blocked says it: a wall
+ahead, a crate to the left.
+=================
+*/
+
+static void CG_AccessibilityBumpFrame( void ) {
+	const playerState_t *ps = &cg.predictedPlayerState;
+	usercmd_t cmd;
+	vec3_t angles, forward, right, wish, end, mins, maxs;
+	trace_t tr;
+	float speed;
+
+	if ( !eta.cueBump || cg.time - eta.lastBump < 450 ) {
+		return;
+	}
+	if ( !trap_GetUserCmd( trap_GetCurrentCmdNumber(), &cmd ) ) {
+		return;
+	}
+	if ( !cmd.forwardmove && !cmd.rightmove ) {
+		return;
+	}
+	speed = sqrt( ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1] );
+	if ( speed > 40.0f ) {
+		return;
+	}
+
+	VectorSet( angles, 0, ps->viewangles[YAW], 0 );
+	AngleVectors( angles, forward, right, NULL );
+	VectorScale( forward, cmd.forwardmove, wish );
+	VectorMA( wish, cmd.rightmove, right, wish );
+	wish[2] = 0;
+	if ( VectorNormalize( wish ) < 0.1f ) {
+		return;
+	}
+
+	VectorSet( mins, -15, -15, 0 );
+	VectorSet( maxs, 15, 15, 40 );
+	VectorMA( ps->origin, 24.0f, wish, end );
+	CG_Trace( &tr, ps->origin, mins, maxs, end, ps->clientNum, MASK_PLAYERSOLID );
+	if ( tr.fraction < 1.0f ) {
+		vec3_t point;
+
+		VectorMA( ps->origin, 24.0f, wish, point );
+		point[2] += ps->viewheight;
+		trap_S_StartSound( point, ENTITYNUM_WORLD, CHAN_AUTO, eta.cueBump );
+		eta.lastBump = cg.time;
+	}
+}
+
 /*
 =================
 The frame
@@ -879,7 +1105,8 @@ static void CG_AccessibilityPlayerFrame( void ) {
 	/* While the aim turns the view, where it points is the enemy; the
 	   compass would talk over the shots. */
 	if ( ETA_HudNarrator_UpdateFacing( ps->viewangles[YAW], cg.time, &facing ) && !eta.aiming ) {
-		ETA_HudNarrator_SpeakFacing( facing );
+		/* Through Say, so it waits its turn behind a story line. */
+		CG_AccessibilitySay( va( "Facing %s", ETA_HudNarrator_FacingName( facing ) ) );
 	}
 }
 
@@ -890,6 +1117,8 @@ void CG_AccessibilityFrame( void ) {
 	CG_AccessibilityStoryFrame();
 	CG_AccessibilityPlayerFrame();
 	if ( !eta.dead ) {
+		CG_AccessibilityGoalFrame();
+		CG_AccessibilityBumpFrame();
 		CG_AccessibilityEnemiesFrame();
 		CG_AccessibilityAimFrame();
 	}
@@ -942,14 +1171,19 @@ void CG_AccessibilityInit( void ) {
 
 	trap_Cvar_Register( NULL, "eta_enemyCue", "1", CVAR_ARCHIVE );
 	trap_Cvar_Register( NULL, "eta_storyVoice", "1", CVAR_ARCHIVE );
-	/* Story state from the last level is not this one's. */
-	trap_Cvar_Set( "eta_line", "" );
+	/* A saved game loaded is the same level coming back: its last line
+	   is not news. */
+	if ( CG_AccessibilityStoryLevel() ) {
+		trap_Cvar_VariableStringBuffer( "eta_line", eta.lastLine, sizeof( eta.lastLine ) );
+	}
 
 	eta.cueEnemy = trap_S_RegisterSound( "sound/accessibility/crosshair_enemy.wav" );
 	eta.cueOnTarget = trap_S_RegisterSound( "sound/accessibility/marker_beacon.wav" );
 	eta.cueObjective = trap_S_RegisterSound( "sound/accessibility/flag_capture.wav" );
 	eta.cueLowHealth = cgs.media.noAmmoSound;
 	eta.cueHit = trap_S_RegisterSound( "sound/accessibility/bump_object.wav" );
+	eta.cueBeacon = trap_S_RegisterSound( "sound/accessibility/marker_beacon.wav" );
+	eta.cueBump = trap_S_RegisterSound( "sound/accessibility/bump_wall.wav" );
 
 	CG_AccessibilitySay( "Level loaded" );
 }
