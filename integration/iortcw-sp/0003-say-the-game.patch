+	{ "accessibilityStopSpeech", CG_AccessibilityStop_f },
+	{ "accessibilityStatus",     CG_AccessibilityStatus_f },
+	{ "accessibilityEnemies",    CG_AccessibilityEnemies_f },
+	{ "accessibilityObjective",  CG_AccessibilityObjective_f },
+	{ "accessibilityStory",      CG_AccessibilityStory_f },
+	{ "accessibilityDebug",      CG_AccessibilityDebug_f },
+	{ "+accessibilityAim",       CG_AccessibilityAimDown_f },
+	{ "-accessibilityAim",       CG_AccessibilityAimUp_f },
+};
