+/* For checking the enemy finder on a build machine: every character in
+   the snapshot, printed. */
+static void CG_AccessibilityDebug_f( void ) {
+	int i;
+
+	if ( !cg.snap ) {
+		return;
+	}
+	CG_Printf( "%i entities in snapshot\n", cg.snap->numEntities );
+	for ( i = 0; i < cg.snap->numEntities; i++ ) {
+		centity_t *cent = &cg_entities[cg.snap->entities[i].number];
