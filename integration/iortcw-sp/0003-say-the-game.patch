+qboolean CG_AccessibilityConsoleCommand( const char *cmd ) {
+	int i;
+
+	for ( i = 0; i < ARRAY_LEN( eta_commands ); i++ ) {
+		if ( !Q_stricmp( cmd, eta_commands[i].cmd ) ) {
+			eta_commands[i].function();
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
