+		CG_Printf( "  %i: aiChar %i team %i flags %x valid %i sight %i dist %i\n", cent->currentState.number,
+				   cent->currentState.aiChar, cent->currentState.teamNum, cent->currentState.eFlags,
+				   cent->currentValid, CG_AccessibilityInSight( cent ),
+				   (int)Distance( cent->lerpOrigin, cg.predictedPlayerState.origin ) );
+	}
+}
