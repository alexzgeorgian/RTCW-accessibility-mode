+/* Whether an item is on screen: visible, and shown by its cvar test.
+   The briefing screens hold every level's text and show one by mapname. */
+static qboolean ETA_ItemShown( itemDef_t *item ) {
+	if ( !( item->window.flags & WINDOW_VISIBLE ) ) {
+		return qfalse;
+	}
+	if ( item->cvarFlags & ( CVAR_SHOW | CVAR_HIDE ) && !Item_EnableShowViaCvar( item, CVAR_SHOW ) ) {
+		return qfalse;
+	}
+	return qtrue;
+}
+
+/* Every text a screen shows, in order, its spacing collapsed: a briefing
+   is laid out with runs of spaces that are only room on the page. */
+static void ETA_ScreenText( menuDef_t *menu, char *out, size_t size ) {
+	int i;
+
+	out[0] = '\0';
+	for ( i = 0; i < menu->itemCount; i++ ) {
+		itemDef_t *item = menu->items[i];
+		char text[1024];
+		char *r, *w;
+
+		if ( item->type != ITEM_TYPE_TEXT || !ETA_ItemShown( item ) || !item->text || !item->text[0] ) {
+			continue;
+		}
+		Q_strncpyz( text, DC->getTranslatedString ? DC->getTranslatedString( item->text ) : item->text, sizeof( text ) );
+		/* Line breaks first: cleaning the colour codes drops them, and
+		   the words either side would run together. */
+		for ( r = text; *r; r++ ) {
+			if ( *r == '\n' || *r == '\r' || *r == '\t' ) {
+				*r = ' ';
+			}
+		}
+		Q_CleanStr( text );
+		for ( r = w = text; *r; r++ ) {
+			if ( *r == ' ' && ( w == text || w[-1] == ' ' ) ) {
+				continue;
+			}
+			/* "site.." from the page's own punctuation. */
+			if ( *r == '.' && w > text && w[-1] == '.' ) {
+				continue;
+			}
+			*w++ = *r;
+		}
+		*w = '\0';
+		ETA_SpeakableLabel( text );
+		if ( !text[0] ) {
+			continue;
+		}
+		/* Screens draw some texts twice, offset, for a shadow or a
+		   second layout; said once. */
+		if ( strstr( out, text ) ) {
+			continue;
+		}
+		if ( out[0] ) {
+			Q_strcat( out, size, ". " );
+		}
+		Q_strcat( out, size, text );
+	}
+}
+
+/*
+ * A text longer than one spoken line - a briefing, a notebook page - read
+ * a piece at a time: the speech library takes a line of a few hundred
+ * characters, and each line replaces the one before it. Each piece ends
+ * at a sentence, and the next is said once the last has had time to be
+ * heard. Moving to a control stops the reading; F6 repeats the piece.
+ */
+#define ETA_READ_PIECE 240
+
+static char eta_reading[4096];
+static int eta_readingAt;
+static int eta_readingNext;
+
+static void ETA_ReadPiece( void ) {
+	char piece[ETA_READ_PIECE + 1];
+	int length = (int)strlen( eta_reading + eta_readingAt );
+	int cut = length;
+
+	if ( length <= 0 ) {
+		eta_reading[0] = '\0';
+		eta_readingAt = 0;
+		return;
+	}
+	if ( cut > ETA_READ_PIECE ) {
+		int i;
+
+		cut = ETA_READ_PIECE;
+		/* Back to the end of a sentence, or failing one a space. */
+		for ( i = ETA_READ_PIECE - 1; i > ETA_READ_PIECE / 3; i-- ) {
+			char c = eta_reading[eta_readingAt + i];
+
+			if ( ( c == '.' || c == '!' || c == '?' ) && eta_reading[eta_readingAt + i + 1] == ' ' ) {
+				cut = i + 1;
+				break;
+			}
+		}
+		if ( cut == ETA_READ_PIECE ) {
+			for ( i = ETA_READ_PIECE - 1; i > 0; i-- ) {
+				if ( eta_reading[eta_readingAt + i] == ' ' ) {
+					cut = i;
+					break;
+				}
+			}
+		}
+	}
+	memcpy( piece, eta_reading + eta_readingAt, cut );
+	piece[cut] = '\0';
+	eta_readingAt += cut;
+	while ( eta_reading[eta_readingAt] == ' ' ) {
+		eta_readingAt++;
+	}
+
+	ETA_MenuNarrator_OnConfirmDialogShown( piece );
+	eta_readingNext = DC->realTime + ETA_Speech_EstimateDurationMs( piece );
+}
+
+static void ETA_ReadLong( const char *text ) {
+	Q_strncpyz( eta_reading, text, sizeof( eta_reading ) );
+	eta_readingAt = 0;
+	ETA_ReadPiece();
+}
+
+static void ETA_ReadStop( void ) {
+	eta_reading[0] = '\0';
+	eta_readingAt = 0;
+}
+
+/* Each frame: the next piece, when its turn comes. */
+static void ETA_ReadFrame( void ) {
+	if ( eta_reading[0] && eta_reading[eta_readingAt] && DC->realTime >= eta_readingNext ) {
+		ETA_ReadPiece();
+	} else if ( eta_reading[0] && !eta_reading[eta_readingAt] ) {
+		ETA_ReadStop();
+	}
+}
