@@ -0,0 +1,963 @@
+/*
+===========================================================================
+
+Return to Castle Wolfenstein single player: the accessibility mode.
+
+Built only with FEATURE_ACCESSIBILITY. What the game says while it is
+played, for a player who cannot see it: the weapon in hand and its
+ammunition, health, what was picked up, where a hit came from, the
+enemies in sight with where they are, and the story - the lines a level
+script hands over and its objective. The rest of the cgame calls in here
+from marked hooks; the words are the library's where it has them
+(src/accessibility), and the mod's own otherwise.
+
+Licensed with the rest of the iortcw single-player game code, GPL v3.
+
+===========================================================================
+*/
+
+#include "cg_local.h"
+
+#ifdef FEATURE_ACCESSIBILITY
+
+#include "core/accessibility_runtime.h"
+#include "hud/hud_narrator.h"
+#include "speech/speech_manager.h"
+#include "audio/audio_cue_system.h"
+
+/* The two AI teams that fight the player. The game keeps them in its own
+   ai_cast.h, which the cgame does not include. */
+#define ETA_AITEAM_NAZI     0
+#define ETA_AITEAM_MONSTER  2
+
+/* Game units per meter, as the mod says distances everywhere else: a
+   player is 72 units tall, about two meters. */
+#define ETA_UNITS_PER_METER 36.0f
+
+/* How far an enemy is still worth naming. Beyond this, in RTCW's long
+   outdoor levels, a soldier is a dot nobody could hit. */
+#define ETA_ENEMY_RANGE     2400.0f
+
+/* An enemy that has been out of sight this long is news again when it
+   comes back; shorter, and a soldier bobbing behind a crate would be
+   announced every time his head showed. */
+#define ETA_ENEMY_FORGET_MS 6000
+
+/* At most one sighting said in this time, the rest left to the enemies
+   key. A room of five soldiers is said as the first, then "and 4 more". */
+#define ETA_SIGHTING_GAP_MS 1200
+
+typedef struct {
+	int lastSeen;       /* cg.time it was last in sight, 0 never */
+	int announced;      /* cg.time it was last said */
+	int dead;
+} eta_enemy_t;
+
+typedef struct {
+	qboolean initialised;
+
+	int weapon;
+	int health;
+	int armor;
+	int ducked;
+	qboolean dead;
+	int clipAmmo;
+
+	int lastSighting;
+	int pendingSightings;
+
+	char lastLine[MAX_STRING_CHARS];
+	char lastObjective[MAX_STRING_CHARS];
+
+	/* aiming at the nearest enemy, with the keys a player would press */
+	qboolean aiming;
+	int aimTarget;
+	qboolean onTarget;
+
+	int lastEnemyCue;
+
+	sfxHandle_t cueEnemy;
+	sfxHandle_t cueOnTarget;
+	sfxHandle_t cueLowHealth;
+	sfxHandle_t cueObjective;
+	sfxHandle_t cueHit;
+} eta_game_t;
+
+static eta_game_t eta;
+static eta_enemy_t eta_enemies[MAX_GENTITIES];
+
+/*
+=================
+Speech
+=================
+*/
+
+/*
+ * Each line said replaces the one still being spoken - the SAPI backend
+ * purges before it speaks - so a story line is protected: until it has
+ * had time to be heard, what the game says on its own (an enemy coming
+ * into sight, the facing, health) waits or is dropped. What the player
+ * asks for with a key, and death, are always said at once.
+ */
+static int eta_storyUntil;
+
+static void CG_AccessibilitySay( const char *text ) {
+	if ( text && text[0] && cg.time >= eta_storyUntil ) {
+		ETA_Speech_Say( text );
+	}
+}
+
+static void CG_AccessibilitySayNow( const char *text ) {
+	if ( text && text[0] ) {
+		eta_storyUntil = 0;
+		ETA_Speech_Say( text );
+	}
+}
+
+static void CG_AccessibilitySayStory( const char *text ) {
+	if ( text && text[0] ) {
+		ETA_Speech_Say( text );
+		eta_storyUntil = cg.time + ETA_Speech_EstimateDurationMs( text );
+	}
+}
+
+static int CG_AccessibilityCvarInt( const char *name ) {
+	char value[16];
+
+	trap_Cvar_VariableStringBuffer( name, value, sizeof( value ) );
+	return atoi( value );
+}
+
+/*
+=================
+Words for things
+=================
+*/
+
+/* A weapon by the name the game gives its pickup. */
+static const char *CG_AccessibilityWeaponName( int weapon ) {
+	gitem_t *item;
+
+	if ( weapon <= WP_NONE || weapon >= WP_NUM_WEAPONS ) {
+		return "no weapon";
+	}
+	item = BG_FindItemForWeapon( weapon );
+	if ( item && item->pickup_name && item->pickup_name[0] ) {
+		return item->pickup_name;
+	}
+	return "weapon";
+}
+
+/* The ammunition of the weapon in hand, as the HUD draws it: what is
+   loaded and what is left to load. */
+static void CG_AccessibilityAmmo( int weapon, int *loaded, int *reserve ) {
+	const playerState_t *ps = &cg.predictedPlayerState;
+
+	*loaded = -1;
+	*reserve = -1;
+	if ( weapon <= WP_NONE || weapon >= WP_NUM_WEAPONS ) {
+		return;
+	}
+	switch ( weapon ) {
+	case WP_KNIFE:
+		return;
+	default:
+		break;
+	}
+	/* RTCW keeps both in arrays of their own, under the same index. */
+	*loaded = ps->ammoclip[BG_FindClipForWeapon( weapon )];
+	*reserve = ps->ammo[BG_FindAmmoForWeapon( weapon )];
+}
+
+/* An enemy as the player would name him. */
+static const char *CG_AccessibilityEnemyName( const centity_t *cent ) {
+	switch ( cent->currentState.aiChar ) {
+	case AICHAR_SOLDIER:        return "Soldier";
+	case AICHAR_AMERICAN:       return "American";
+	case AICHAR_ZOMBIE:         return "Zombie";
+	case AICHAR_WARZOMBIE:      return "War zombie";
+	case AICHAR_VENOM:          return "Venom soldier";
+	case AICHAR_LOPER:          return "Loper";
+	case AICHAR_ELITEGUARD:     return "Elite guard";
+	case AICHAR_STIMSOLDIER1:
+	case AICHAR_STIMSOLDIER2:
+	case AICHAR_STIMSOLDIER3:   return "Super soldier";
+	case AICHAR_SUPERSOLDIER:   return "Super soldier";
+	case AICHAR_BLACKGUARD:     return "Black guard";
+	case AICHAR_PROTOSOLDIER:   return "Proto soldier";
+	case AICHAR_FROGMAN:        return "Frogman";
+	case AICHAR_HELGA:          return "Helga";
+	case AICHAR_HEINRICH:       return "Heinrich";
+	case AICHAR_PARTISAN:       return "Partisan";
+	case AICHAR_CIVILIAN:       return "Civilian";
+	default:                    return "Enemy";
+	}
+}
+
+/*
+ * Where a point is from the player, in the words the mod uses
+ * everywhere: "ahead", "ahead left", "left", "behind left" and so on,
+ * relative to where the player is facing, with the distance in meters.
+ */
+static const char *CG_AccessibilityDirection( const vec3_t point, int *meters ) {
+	static const char *sectors[8] = {
+		"ahead", "ahead left", "left", "behind left",
+		"behind", "behind right", "right", "ahead right"
+	};
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t delta;
+	float relative;
+	int sector;
+
+	VectorSubtract( point, ps->origin, delta );
+	if ( meters ) {
+		*meters = (int)( VectorLength( delta ) / ETA_UNITS_PER_METER + 0.5f );
+	}
+	relative = AngleNormalize360( vectoyaw( delta ) - ps->viewangles[YAW] );
+	sector = (int)( ( relative + 22.5f ) / 45.0f ) & 7;
+
+	return sectors[sector];
+}
+
+/* "above" or "below" when a thing is well off the player's level. */
+static const char *CG_AccessibilityHeight( const vec3_t point ) {
+	float dz = point[2] - cg.predictedPlayerState.origin[2];
+
+	if ( dz > 96.0f ) {
+		return ", above";
+	}
+	if ( dz < -96.0f ) {
+		return ", below";
+	}
+	return "";
+}
+
+/*
+=================
+Enemies
+=================
+*/
+
+static qboolean CG_AccessibilityIsEnemy( const centity_t *cent ) {
+	const entityState_t *s = &cent->currentState;
+
+	if ( !cent->currentValid || s->eType != ET_PLAYER ) {
+		return qfalse;
+	}
+	if ( s->number == cg.snap->ps.clientNum ) {
+		return qfalse;
+	}
+	if ( s->eFlags & EF_DEAD ) {
+		return qfalse;
+	}
+	return ( s->teamNum == ETA_AITEAM_NAZI || s->teamNum == ETA_AITEAM_MONSTER ) ? qtrue : qfalse;
+}
+
+/* The middle of an enemy's chest, which is where the aim goes. */
+static void CG_AccessibilityEnemyChest( const centity_t *cent, vec3_t chest ) {
+	VectorCopy( cent->lerpOrigin, chest );
+	chest[2] += ( cent->currentState.eFlags & EF_CROUCHING ) ? 12.0f : 32.0f;
+}
+
+/* Can the player see him: a clear line from the eyes to his chest. */
+static qboolean CG_AccessibilityInSight( const centity_t *cent ) {
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t eye, chest;
+	trace_t tr;
+
+	VectorCopy( ps->origin, eye );
+	eye[2] += ps->viewheight;
+	CG_AccessibilityEnemyChest( cent, chest );
+
+	if ( Distance( eye, chest ) > ETA_ENEMY_RANGE ) {
+		return qfalse;
+	}
+	CG_Trace( &tr, eye, NULL, NULL, chest, ps->clientNum, MASK_SHOT );
+	return ( tr.fraction >= 1.0f || tr.entityNum == cent->currentState.number ) ? qtrue : qfalse;
+}
+
+/* The nearest enemy in sight, or -1. */
+static int CG_AccessibilityNearestEnemy( void ) {
+	int i, best = -1;
+	float bestDist = 0;
+
+	for ( i = 0; i < cg.snap->numEntities; i++ ) {
+		centity_t *cent = &cg_entities[cg.snap->entities[i].number];
+		float dist;
+
+		if ( !CG_AccessibilityIsEnemy( cent ) || !CG_AccessibilityInSight( cent ) ) {
+			continue;
+		}
+		dist = Distance( cent->lerpOrigin, cg.predictedPlayerState.origin );
+		if ( best < 0 || dist < bestDist ) {
+			best = cent->currentState.number;
+			bestDist = dist;
+		}
+	}
+	return best;
+}
+
+static void CG_AccessibilitySayEnemy( const centity_t *cent, const char *prefix ) {
+	int meters;
+	const char *where = CG_AccessibilityDirection( cent->lerpOrigin, &meters );
+
+	CG_AccessibilitySay( va( "%s%s, %s, %i %s%s", prefix, CG_AccessibilityEnemyName( cent ), where,
+							 meters, meters == 1 ? "meter" : "meters", CG_AccessibilityHeight( cent->lerpOrigin ) ) );
+}
+
+/*
+ * Enemies coming into sight, said once each, and a tick from the
+ * nearest one so its place can be heard. A sighted player sees a soldier
+ * step out; this is that moment, and the tick is where to point.
+ */
+static void CG_AccessibilityEnemiesFrame( void ) {
+	int i, nearest = -1;
+	float nearestDist = 0;
+
+	for ( i = 0; i < cg.snap->numEntities; i++ ) {
+		int num = cg.snap->entities[i].number;
+		centity_t *cent = &cg_entities[num];
+		eta_enemy_t *seen = &eta_enemies[num];
+		float dist;
+
+		/* One the player has seen, falling: the shot landed. */
+		if ( cent->currentState.eType == ET_PLAYER && ( cent->currentState.eFlags & EF_DEAD ) ) {
+			if ( seen->lastSeen && !seen->dead ) {
+				seen->dead = 1;
+				CG_AccessibilitySayNow( va( "%s down", CG_AccessibilityEnemyName( cent ) ) );
+			}
+			continue;
+		}
+		if ( seen->dead ) {
+			/* A slot reused, or a body raised: someone new. */
+			memset( seen, 0, sizeof( *seen ) );
+		}
+
+		if ( !CG_AccessibilityIsEnemy( cent ) ) {
+			continue;
+		}
+		if ( !CG_AccessibilityInSight( cent ) ) {
+			continue;
+		}
+
+		if ( !seen->lastSeen || cg.time - seen->lastSeen > ETA_ENEMY_FORGET_MS ) {
+			if ( cg.time - eta.lastSighting >= ETA_SIGHTING_GAP_MS ) {
+				CG_AccessibilitySayEnemy( cent, "" );
+				eta.lastSighting = cg.time;
+				seen->announced = cg.time;
+			} else {
+				eta.pendingSightings++;
+			}
+		}
+		seen->lastSeen = cg.time;
+
+		dist = Distance( cent->lerpOrigin, cg.predictedPlayerState.origin );
+		if ( nearest < 0 || dist < nearestDist ) {
+			nearest = num;
+			nearestDist = dist;
+		}
+	}
+
+	if ( eta.pendingSightings && cg.time - eta.lastSighting >= ETA_SIGHTING_GAP_MS ) {
+		CG_AccessibilitySay( va( "and %i more", eta.pendingSightings ) );
+		eta.pendingSightings = 0;
+		eta.lastSighting = cg.time;
+	}
+
+	/* The tick: faster the closer he is, from his own position, so the
+	   engine's 3D sound puts it where he stands. */
+	if ( nearest >= 0 && eta.cueEnemy && CG_AccessibilityCvarInt( "eta_enemyCue" ) ) {
+		int gap = 300 + (int)( nearestDist / 4.0f );
+
+		if ( gap > 1200 ) {
+			gap = 1200;
+		}
+		if ( cg.time - eta.lastEnemyCue >= gap ) {
+			vec3_t chest;
+
+			CG_AccessibilityEnemyChest( &cg_entities[nearest], chest );
+			trap_S_StartSound( chest, ENTITYNUM_WORLD, CHAN_AUTO, eta.cueEnemy );
+			eta.lastEnemyCue = cg.time;
+		}
+	}
+}
+
+/*
+=================
+Aim
+
+Nothing here can write the view angles: that is the client's, and this
+is the cgame. What it can do is what a player can - press the engine's
+own +left, +right, +lookup and +lookdown - and let go at the right
+moment. They are pressed under key numbers no keyboard has, so a
+player's own keys on the same buttons are never released by this, as
+the ET mode's turning does.
+=================
+*/
+
+#define ETA_KEY_LEFT    "998"
+#define ETA_KEY_RIGHT   "999"
+#define ETA_KEY_UP      "996"
+#define ETA_KEY_DOWN    "995"
+
+static int eta_aimYaw, eta_aimPitch;
+
+static void CG_AccessibilityAimKeys( int yaw, int pitch ) {
+	if ( yaw != eta_aimYaw ) {
+		if ( eta_aimYaw ) {
+			trap_SendConsoleCommand( va( "-%s %s\n", eta_aimYaw < 0 ? "left" : "right", eta_aimYaw < 0 ? ETA_KEY_LEFT : ETA_KEY_RIGHT ) );
+		}
+		if ( yaw ) {
+			trap_SendConsoleCommand( va( "+%s %s\n", yaw < 0 ? "left" : "right", yaw < 0 ? ETA_KEY_LEFT : ETA_KEY_RIGHT ) );
+		}
+		eta_aimYaw = yaw;
+	}
+	if ( pitch != eta_aimPitch ) {
+		if ( eta_aimPitch ) {
+			trap_SendConsoleCommand( va( "-%s %s\n", eta_aimPitch < 0 ? "lookup" : "lookdown", eta_aimPitch < 0 ? ETA_KEY_UP : ETA_KEY_DOWN ) );
+		}
+		if ( pitch ) {
+			trap_SendConsoleCommand( va( "+%s %s\n", pitch < 0 ? "lookup" : "lookdown", pitch < 0 ? ETA_KEY_UP : ETA_KEY_DOWN ) );
+		}
+		eta_aimPitch = pitch;
+	}
+}
+
+static void CG_AccessibilityAimStop( void ) {
+	CG_AccessibilityAimKeys( 0, 0 );
+	eta.aiming = qfalse;
+	eta.aimTarget = -1;
+	eta.onTarget = qfalse;
+}
+
+/*
+ * One frame of turning toward the target. Turning right lowers the yaw
+ * and looking down raises the pitch - the engine's own sense, in
+ * CL_AdjustAngles.
+ */
+static void CG_AccessibilityAimFrame( void ) {
+	const playerState_t *ps = &cg.predictedPlayerState;
+	centity_t *cent;
+	vec3_t eye, chest, delta, wanted;
+	float yawError, pitchError, deadzone;
+	int yaw = 0, pitch = 0;
+
+	if ( !eta.aiming ) {
+		return;
+	}
+
+	/* Keep the target while he is alive and in sight; then the next. */
+	if ( eta.aimTarget < 0 || !CG_AccessibilityIsEnemy( &cg_entities[eta.aimTarget] )
+		 || !CG_AccessibilityInSight( &cg_entities[eta.aimTarget] ) ) {
+		int next = CG_AccessibilityNearestEnemy();
+
+		if ( next < 0 ) {
+			CG_AccessibilityAimKeys( 0, 0 );
+			if ( eta.aimTarget >= 0 || eta.onTarget ) {
+				CG_AccessibilitySayNow( "No enemy in sight" );
+			}
+			eta.aimTarget = -1;
+			eta.onTarget = qfalse;
+			return;
+		}
+		eta.aimTarget = next;
+		eta.onTarget = qfalse;
+	}
+
+	cent = &cg_entities[eta.aimTarget];
+	VectorCopy( ps->origin, eye );
+	eye[2] += ps->viewheight;
+	CG_AccessibilityEnemyChest( cent, chest );
+	VectorSubtract( chest, eye, delta );
+	vectoangles( delta, wanted );
+
+	yawError = AngleSubtract( wanted[YAW], ps->viewangles[YAW] );
+	pitchError = AngleSubtract( wanted[PITCH], ps->viewangles[PITCH] );
+
+	/* Within a third of the target's width at that range is on him. */
+	deadzone = RAD2DEG( atan2( 6.0f, VectorLength( delta ) ) );
+	if ( deadzone < 1.0f ) {
+		deadzone = 1.0f;
+	}
+
+	if ( fabs( yawError ) > deadzone ) {
+		yaw = yawError > 0.0f ? -1 : 1;
+	}
+	if ( fabs( pitchError ) > deadzone ) {
+		pitch = pitchError > 0.0f ? 1 : -1;
+	}
+	CG_AccessibilityAimKeys( yaw, pitch );
+
+	if ( !yaw && !pitch && !eta.onTarget ) {
+		eta.onTarget = qtrue;
+		if ( eta.cueOnTarget ) {
+			trap_S_StartLocalSound( eta.cueOnTarget, CHAN_LOCAL_SOUND );
+		}
+	} else if ( ( yaw || pitch ) && eta.onTarget && ( fabs( yawError ) > deadzone * 3 || fabs( pitchError ) > deadzone * 3 ) ) {
+		eta.onTarget = qfalse;
+	}
+}
+
+static void CG_AccessibilityAimDown_f( void ) {
+	int target = CG_AccessibilityNearestEnemy();
+
+	if ( target < 0 ) {
+		CG_AccessibilitySayNow( "No enemy in sight" );
+		return;
+	}
+	eta.aiming = qtrue;
+	eta.aimTarget = target;
+	eta.onTarget = qfalse;
+	CG_AccessibilitySayEnemy( &cg_entities[target], "Aiming at " );
+}
+
+static void CG_AccessibilityAimUp_f( void ) {
+	CG_AccessibilityAimStop();
+}
+
+/*
+=================
+Keys
+=================
+*/
+
+static void CG_AccessibilityStatus_f( void ) {
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int loaded, reserve;
+	char text[512];
+
+	if ( !cg.snap ) {
+		return;
+	}
+
+	Com_sprintf( text, sizeof( text ), "Health %i", ps->stats[STAT_HEALTH] > 0 ? ps->stats[STAT_HEALTH] : 0 );
+	if ( ps->stats[STAT_ARMOR] > 0 ) {
+		Q_strcat( text, sizeof( text ), va( ", armor %i", ps->stats[STAT_ARMOR] ) );
+	}
+	Q_strcat( text, sizeof( text ), va( ". %s", CG_AccessibilityWeaponName( ps->weapon ) ) );
+	CG_AccessibilityAmmo( ps->weapon, &loaded, &reserve );
+	if ( loaded >= 0 ) {
+		Q_strcat( text, sizeof( text ), va( ", %i loaded", loaded ) );
+		if ( reserve >= 0 ) {
+			Q_strcat( text, sizeof( text ), va( ", %i spare", reserve ) );
+		}
+	}
+	Q_strcat( text, sizeof( text ), va( ". Facing %s", ETA_HudNarrator_FacingName( ETA_HudNarrator_FacingFromYaw( ps->viewangles[YAW] ) ) ) );
+
+	CG_AccessibilitySayNow( text );
+}
+
+/* Every enemy in sight, nearest first, up to five. */
+static void CG_AccessibilityEnemies_f( void ) {
+	int order[MAX_GENTITIES];
+	float dist[MAX_GENTITIES];
+	int count = 0, i, j;
+
+	if ( !cg.snap ) {
+		return;
+	}
+
+	for ( i = 0; i < cg.snap->numEntities; i++ ) {
+		centity_t *cent = &cg_entities[cg.snap->entities[i].number];
+		float d;
+
+		if ( !CG_AccessibilityIsEnemy( cent ) || !CG_AccessibilityInSight( cent ) ) {
+			continue;
+		}
+		d = Distance( cent->lerpOrigin, cg.predictedPlayerState.origin );
+		for ( j = count; j > 0 && dist[j - 1] > d; j-- ) {
+			order[j] = order[j - 1];
+			dist[j] = dist[j - 1];
+		}
+		order[j] = cent->currentState.number;
+		dist[j] = d;
+		count++;
+	}
+
+	if ( !count ) {
+		CG_AccessibilitySayNow( "No enemies in sight" );
+		return;
+	}
+
+	eta_storyUntil = 0;
+	ETA_Speech_BeginReport();
+	CG_AccessibilitySay( va( "%i %s in sight", count, count == 1 ? "enemy" : "enemies" ) );
+	for ( i = 0; i < count && i < 5; i++ ) {
+		CG_AccessibilitySayEnemy( &cg_entities[order[i]], "" );
+	}
+	ETA_Speech_EndReport();
+}
