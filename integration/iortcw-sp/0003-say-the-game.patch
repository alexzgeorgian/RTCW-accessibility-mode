+}
+
+/* A hit: its side, by the cue the library plays for it. front and left
+   are the damage indicator's own, the direction the hit came from. */
+void CG_AccessibilityDamage( float front, float left ) {
+	int degrees = (int)RAD2DEG( atan2( -left, front ) );
+
+	if ( degrees < 0 ) {
+		degrees += 360;
+	}
+	ETA_AudioCueSystem_PlayDamageDirectionCue( degrees );
+}
+
+/* A center print is a message the level gives the player; it is said. */
+void CG_AccessibilityCenterPrint( const char *text ) {
+	char clean[MAX_STRING_CHARS];
+	char *c;
+
+	Q_strncpyz( clean, text, sizeof( clean ) );
+	for ( c = clean; *c; c++ ) {
+		if ( *c == '\n' ) {
+			*c = ' ';
+		}
+	}
+	Q_CleanStr( clean );
+	CG_AccessibilitySay( clean );
+}
+
+/* The notebook gained a page: new orders. */
+void CG_AccessibilityNotebookPage( void ) {
+	CG_AccessibilitySay( "New notebook entry. N opens the notebook" );
+}
+
+/*
+=================
+Story
+
+A level built for this mode tells its story through two cvars its
+scripts set with the "cvar" action: eta_line, a line to say, and
+eta_objective, the current objective. Each is said when it changes. A
+line may name a recorded voice too - "sound/... | the words" - which is
+played, with the words spoken only when eta_storyVoice is 0.
+=================
+*/
+
+static void CG_AccessibilityStoryFrame( void ) {
+	char line[MAX_STRING_CHARS];
+	char objective[MAX_STRING_CHARS];
+
+	trap_Cvar_VariableStringBuffer( "eta_line", line, sizeof( line ) );
+	if ( line[0] && strcmp( line, eta.lastLine ) ) {
+		char *bar = strchr( line, '|' );
+		const char *words = line;
+
+		Q_strncpyz( eta.lastLine, line, sizeof( eta.lastLine ) );
+		if ( bar ) {
+			char sound[MAX_QPATH];
+			int length = (int)( bar - line );
+
+			if ( length >= (int)sizeof( sound ) ) {
+				length = sizeof( sound ) - 1;
+			}
+			memcpy( sound, line, length );
+			sound[length] = '\0';
+			while ( length > 0 && sound[length - 1] == ' ' ) {
+				sound[--length] = '\0';
+			}
+			words = bar + 1;
+			while ( *words == ' ' ) {
+				words++;
+			}
+			Q_strncpyz( eta.lastLine, words, sizeof( eta.lastLine ) );
+			if ( sound[0] && CG_AccessibilityCvarInt( "eta_storyVoice" ) ) {
+				trap_S_StartLocalSound( trap_S_RegisterSound( sound ), CHAN_ANNOUNCER );
+				words = NULL;
+			}
+		}
+		if ( words ) {
+			CG_AccessibilitySayStory( words );
+		}
+	}
+
+	/* An objective set with a line waits for the line to be heard. */
+	if ( cg.time < eta_storyUntil ) {
+		return;
+	}
+	trap_Cvar_VariableStringBuffer( "eta_objective", objective, sizeof( objective ) );
+	if ( strcmp( objective, eta.lastObjective ) ) {
+		Q_strncpyz( eta.lastObjective, objective, sizeof( eta.lastObjective ) );
+		if ( objective[0] ) {
+			if ( eta.cueObjective ) {
+				trap_S_StartLocalSound( eta.cueObjective, CHAN_LOCAL_SOUND );
+			}
+			CG_AccessibilitySayStory( va( "New objective: %s", objective ) );
+		}
+	}
+}
+
+/*
+=================
+The frame
+=================
+*/
+
+static void CG_AccessibilityPlayerFrame( void ) {
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int health = ps->stats[STAT_HEALTH];
+	int ducked = ( ps->pm_flags & PMF_DUCKED ) ? 1 : 0;
+	qboolean dead = ( health <= 0 || ps->pm_type == PM_DEAD ) ? qtrue : qfalse;
+	ETA_Facing facing;
+
+	if ( !eta.initialised ) {
+		eta.weapon = ps->weapon;
+		eta.health = health;
+		eta.armor = ps->stats[STAT_ARMOR];
+		eta.ducked = ducked;
+		eta.dead = dead;
+		eta.initialised = qtrue;
+		return;
+	}
+
+	if ( dead != eta.dead ) {
+		eta.dead = dead;
+		if ( dead ) {
+			CG_AccessibilityAimStop();
+			CG_AccessibilitySayNow( "You died. Fire to load the last save" );
+			return;
+		}
+	}
+	if ( dead ) {
+		return;
+	}
+
+	if ( ps->weapon != eta.weapon ) {
+		int loaded, reserve;
+
+		eta.weapon = ps->weapon;
+		CG_AccessibilityAmmo( ps->weapon, &loaded, &reserve );
+		if ( loaded >= 0 ) {
+			CG_AccessibilitySay( va( "%s, %i%s", CG_AccessibilityWeaponName( ps->weapon ), loaded,
+									 reserve >= 0 ? va( ", %i spare", reserve ) : "" ) );
+		} else {
+			CG_AccessibilitySay( CG_AccessibilityWeaponName( ps->weapon ) );
+		}
+	}
+
+	/* Health: a pickup says what it gave; a loss is said at each quarter
+	   crossed, and under a quarter the library's low-health cue. */
+	if ( health > eta.health ) {
+		CG_AccessibilitySay( va( "Health %i", health ) );
+	} else if ( health < eta.health ) {
+		if ( health / 25 < eta.health / 25 ) {
+			CG_AccessibilitySay( va( "Health %i", health ) );
+		}
+		if ( health < 25 ) {
+			ETA_AudioCueSystem_PlayLowHealthCue();
+		}
+	}
+	eta.health = health;
+
+	if ( ps->stats[STAT_ARMOR] > eta.armor ) {
+		CG_AccessibilitySay( va( "Armor %i", ps->stats[STAT_ARMOR] ) );
+	}
+	eta.armor = ps->stats[STAT_ARMOR];
+
+	if ( ducked != eta.ducked ) {
+		eta.ducked = ducked;
+		ETA_HudNarrator_SpeakStance( ducked ? ETA_STANCE_CROUCHED : ETA_STANCE_STANDING );
+	}
+
+	/* While the aim turns the view, where it points is the enemy; the
+	   compass would talk over the shots. */
+	if ( ETA_HudNarrator_UpdateFacing( ps->viewangles[YAW], cg.time, &facing ) && !eta.aiming ) {
+		ETA_HudNarrator_SpeakFacing( facing );
+	}
+}
+
+void CG_AccessibilityFrame( void ) {
+	if ( !cg.snap || cg.cameraMode ) {
+		return;
+	}
+	CG_AccessibilityStoryFrame();
+	CG_AccessibilityPlayerFrame();
+	if ( !eta.dead ) {
+		CG_AccessibilityEnemiesFrame();
+		CG_AccessibilityAimFrame();
+	}
+}
+
+/*
+=================
+Start and end of a level
+=================
+*/
+
+/* The library's cues through the game's own sound: a hit from its side
+   is a hit sound panned there. */
+static void CG_AccessibilityCueBackend( ETA_AudioCueType type, int directionDegrees, int hasDirection, void *userData ) {
+	(void)userData;
+
+	switch ( type ) {
+	case ETA_AUDIO_CUE_LOW_HEALTH:
+		if ( eta.cueLowHealth ) {
+			trap_S_StartLocalSound( eta.cueLowHealth, CHAN_LOCAL_SOUND );
+		}
+		break;
+	case ETA_AUDIO_CUE_DAMAGE_DIRECTION:
+		if ( eta.cueHit && hasDirection ) {
+			vec3_t angles, forward, point;
+
+			/* 0 ahead and 90 right, where the engine's yaw grows to the left. */
+			VectorSet( angles, 0, cg.predictedPlayerState.viewangles[YAW] - directionDegrees, 0 );
+			AngleVectors( angles, forward, NULL, NULL );
+			VectorMA( cg.predictedPlayerState.origin, 64.0f, forward, point );
+			trap_S_StartSound( point, ENTITYNUM_WORLD, CHAN_AUTO, eta.cueHit );
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+void CG_AccessibilityInit( void ) {
+	memset( &eta, 0, sizeof( eta ) );
+	eta_storyUntil = 0;
+	memset( eta_enemies, 0, sizeof( eta_enemies ) );
+	eta.aimTarget = -1;
+
+	ETA_AccessibilityRuntime_Init();
+	ETA_HudNarrator_Init();
+	ETA_HudNarrator_ResetFacing();
+	ETA_AudioCueSystem_Init();
+	ETA_AudioCueSystem_SetBackend( CG_AccessibilityCueBackend, NULL );
+
+	trap_Cvar_Register( NULL, "eta_enemyCue", "1", CVAR_ARCHIVE );
+	trap_Cvar_Register( NULL, "eta_storyVoice", "1", CVAR_ARCHIVE );
+	/* Story state from the last level is not this one's. */
+	trap_Cvar_Set( "eta_line", "" );
+
+	eta.cueEnemy = trap_S_RegisterSound( "sound/accessibility/crosshair_enemy.wav" );
+	eta.cueOnTarget = trap_S_RegisterSound( "sound/accessibility/marker_beacon.wav" );
+	eta.cueObjective = trap_S_RegisterSound( "sound/accessibility/flag_capture.wav" );
+	eta.cueLowHealth = cgs.media.noAmmoSound;
+	eta.cueHit = trap_S_RegisterSound( "sound/accessibility/bump_object.wav" );
+
+	CG_AccessibilitySay( "Level loaded" );
+}
+
+void CG_AccessibilityShutdown( void ) {
+	CG_AccessibilityAimStop();
+	ETA_AudioCueSystem_Shutdown();
+	ETA_AccessibilityRuntime_Shutdown();
+}
