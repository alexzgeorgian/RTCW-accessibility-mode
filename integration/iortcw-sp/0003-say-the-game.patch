+/* What was picked up, said by its name, with what it gave. */
+void CG_AccessibilityItemPickup( int itemNum ) {
+	gitem_t *item;
+
+	if ( itemNum <= 0 || itemNum >= bg_numItems ) {
+		return;
+	}
+	item = &bg_itemlist[itemNum];
+	if ( !item->pickup_name || !item->pickup_name[0] ) {
