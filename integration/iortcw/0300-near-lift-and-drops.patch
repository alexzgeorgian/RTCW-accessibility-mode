+/*
+ * A lift's call button or lever, or the train's lever, on this floor and
+ * near: on T wherever the areas put it. The tester, choosing the lift on
+ * T and walking off toward it, found it gone from T once they were in
+ * another area, and only the control room left, which they could not
+ * reach without the lift.
+ */
+#define ETA_THINGS_RIDE_NEAR 1600.0f
+
+static qboolean ETA_ThingRideNear(const eta_thing_t *thing)
+{
+	return (qboolean)( ETA_ThingRideControl(thing) && !ETA_ThingOffLevel(thing)
+	                   && Distance(cg.predictedPlayerState.origin, thing->point) < ETA_THINGS_RIDE_NEAR );
+}
