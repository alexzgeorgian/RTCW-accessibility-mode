-	return (qboolean)(!thing->done && ( thing->known || thing->ride || !Q_stricmpn(thing->name, "Tram button", 11) )
+	return (qboolean)(!thing->done && ( thing->known || thing->ride || !Q_stricmpn(thing->name, "Tram button", 11)
+	                                    || ETA_ThingRideNear(thing) )
 	                  && (thing->kind != ETA_THING_SECRET || eta_secretsLead.integer));
 }
 
