diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index 15edea30..26b32436 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -3756,6 +3756,40 @@ static const etaSecretJump_t *ETA_SecretJumpFor(const vec3_t at)
 	return NULL;
 }
 
+/* What the current step asks, for O to say again. */
+static const char *ETA_SecretJumpStepWords(void)
+{
+	switch (eta_sj.step)
+	{
+	case ETA_SJ_TOSTART:
+		return "On the way up to the secret area. Stand still while you are turned to the start of the run; then hold W, "
+		       "and you are stopped there";
+	case ETA_SJ_RUN:
+		return "At the start of the run. Stand still while you are turned; then hold Shift and W together: the jump onto "
+		       "the rail is made for you";
+	case ETA_SJ_RAIL:
+		return "On the rail, over the drop. Stand still while you are turned to the top of the wall; then hold W: the hop "
+		       "up is made for you";
+	case ETA_SJ_WALL:
+		return "On top of the wall. Stand still while you are turned to the beam; then hold W: walk off the end of the wall "
+		       "onto the beam";
+	}
+	return NULL;
+}
+
+qboolean CG_AccessibilitySecretJumpSayStep(void)
+{
+	const char *words;
+
+	if (!eta_sj.armed || eta_sj.jumped || eta_sj.walked || !( words = ETA_SecretJumpStepWords() ))
+	{
+		return qfalse;
+	}
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(words);
+	return qtrue;
+}
+
 /* The way up being taken, step by step: the way's own jump hints keep
    quiet meanwhile - "press space at the edge" said over it. */
 qboolean CG_AccessibilitySecretJumpActive(void)
@@ -3885,6 +3919,12 @@ static qboolean ETA_SecretJumpLead(const playerState_t *ps)
 		ETA_SecretJumpArm(j);
 		return qtrue;
 	}
+	if (!Q_stricmp(name, ETA_SJ_NAME))
+	{
+		/* Already on the way there: O leads as it does anywhere. */
+		eta_sj.leadTo = j;
+		return qfalse;
+	}
 	CG_AccessibilityChoose(j->runFrom, ETA_SJ_NAME);
 	eta_sj.leadTo = j;
 	ETA_HudNarrator_HoldPassive(cg.time);
@@ -4127,6 +4167,32 @@ static qboolean ETA_SecretJumpFrame(const usercmd_t *cmd)
 		return qtrue;
 	}
 
+	if (eta_sj.step == ETA_SJ_RUN && fabsf(AngleSubtract(eta_sj.yaw, ps->viewangles[YAW])) > 3.0f)
+	{
+		/* Turned off the line - by something else, or not yet turned:
+		   W let go of, and the turn goes on; the edge guard watches. */
+		trap_SendConsoleCommand("-forward\n");
+		return qfalse;
+	}
+
+	if (eta_sj.step == ETA_SJ_RUN && ( !( cmd->buttons & BUTTON_SPRINT ) || ps->sprintTime <= 2000 ))
+	{
+		/* Without Shift, or without breath for a sprint, the jump falls
+		   short, into a pocket below the beam: not begun. */
+		static int saidAt;
+
+		trap_SendConsoleCommand("-forward\n");
+		if (cg.time - saidAt > 3000 || cg.time < saidAt)
+		{
+			saidAt = cg.time;
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(( cmd->buttons & BUTTON_SPRINT )
+			               ? "Out of breath for the run. Wait a few seconds, then Shift and W again"
+			               : "Shift and W together: without Shift the jump falls short. Not begun");
+		}
+		return qfalse;
+	}
+
 	switch (eta_sj.step)
 	{
 	case ETA_SJ_RUN:
@@ -4687,6 +4753,12 @@ void CG_AccessibilityFaceTheWay(void)
 	{
 		return;
 	}
+	/* The way up to a secret under way: O says the step again, and
+	   leads nowhere else - turned away, W would walk off the drop. */
+	if (CG_AccessibilitySecretJumpSayStep())
+	{
+		return;
+	}
 	/* On a lift with a bridge - the crypt's pillar: O is for the bridge,
 	   whatever was chosen before. The tester heard "no way found" on it,
 	   O still on something the pillar's top has no way to. */
