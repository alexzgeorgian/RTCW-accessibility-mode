 void CG_AccessibilitySecretJumpTest_f( void );
 qboolean CG_AccessibilitySecretJumpActive( void );
+qboolean CG_AccessibilitySecretJumpSayStep( void );
 int CG_AccessibilityGateState( int gate, const vec3_t from, qboolean *moving );
