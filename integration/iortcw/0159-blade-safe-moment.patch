+/*
+ * A blade's go. The crypt's draws back up slowly, seven seconds, and then
+ * waits 0.5, 1.5, 2.25 or 5 seconds at random before it swings, the half
+ * nearest the button first. Across at a run takes a second and more even
+ * from the edge of its reach, so "back up: run across now" was a gamble
+ * the tester lost again and again, and the cross key won by luck. Its go
+ * is 0.8 seconds after it is up: not swung by then, the wait is a long
+ * one, and there is time. ETA_GO_NONE when it is not known; ETA_GO_EARLY
+ * when it swung before it, the next time to be waited for.
+ */
+#define ETA_BLADE_GO_AFTER 800   /* its first move is a no-op of 150 ms: a swing at 0.5 s is seen by then */
+#define ETA_BLADE_DRAWBACK 3000   /* a turn this long: drawn back, not a blow */
+
+static int ETA_BladeGo(int g)
+{
+	int i, j;
+
+	if (g < 0 || g >= eta_trapGroupCount || !cg.snap)
+	{
+		return 0;
+	}
+	for (i = 0; i < eta_trapMoverCount; i++)
+	{
+		if (eta_trapMovers[i].group != g || Q_stricmp(eta_trapMovers[i].kind, "blade"))
+		{
+			continue;
+		}
+		for (j = 0; j < cg.snap->numEntities; j++)
+		{
+			const entityState_t *es = &cg.snap->entities[j];
+
+			if (es->eType != ET_MOVER || es->modelindex != eta_trapMovers[i].model)
+			{
+				continue;
+			}
+			if (es->apos.trType != TR_STATIONARY && es->apos.trDuration >= ETA_BLADE_DRAWBACK)
+			{
+				eta_trapGroups[g].retractEnd = es->apos.trTime + es->apos.trDuration;
+				eta_trapGroups[g].swungEarly = qfalse;
+			}
+			else if (eta_trapGroups[g].retractEnd && es->apos.trTime > eta_trapGroups[g].retractEnd + 30
+			         && es->apos.trTime < eta_trapGroups[g].retractEnd + ETA_BLADE_GO_AFTER + 1000)
+			{
+				eta_trapGroups[g].swungEarly = qtrue;
+			}
+			break;
+		}
+	}
+	if (!eta_trapGroups[g].retractEnd)
+	{
+		return 0;
+	}
+	return eta_trapGroups[g].swungEarly ? -1 : eta_trapGroups[g].retractEnd + ETA_BLADE_GO_AFTER;
+}
+
+/* For the cross key: the nearest trap's go, as ETA_BladeGo. */
+int CG_AccessibilityTrapGo(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  g, best = -1;
+	float                bestGap = 480.0f;
+
+	for (g = 0; g < eta_trapGroupCount; g++)
+	{
+		float gap;
+
+		if (eta_trapGroups[g].zoneDone != 2
+		    || ps->origin[2] < eta_trapGroups[g].zoneMins[2] - 48.0f || ps->origin[2] > eta_trapGroups[g].zoneMaxs[2] + 48.0f)
+		{
+			continue;
+		}
+		gap = ETA_ZoneGap(ps->origin, eta_trapGroups[g].zoneMins, eta_trapGroups[g].zoneMaxs);
+		if (gap < bestGap)
+		{
+			bestGap = gap;
+			best    = g;
+		}
+	}
+	return best < 0 ? 0 : ETA_BladeGo(best);
+}
