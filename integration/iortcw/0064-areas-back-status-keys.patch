+/* Where to lead to an area: where the player stood on coming into it,
+   else just through a door into it. */
+static qboolean ETA_AreaSpot(int area, vec3_t out)
+{
+	int i;
+
+	if (eta_areas.hasSpot[area])
+	{
+		VectorCopy(eta_areas.spot[area], out);
+		return qtrue;
+	}
+	for (i = 0; i < eta_areas.exitCount; i++)
+	{
+		const eta_areaExit_t *exit = &eta_areas.exits[i];
+
+		if (exit->area[0] == area || exit->area[1] == area)
+		{
+			VectorCopy(exit->side[exit->area[0] == area ? 0 : 1], out);
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/*
+ * Semicolon: the areas explored, one after another and round again -
+ * those with things left in them first, nearest first, then the rest -
+ * each chosen for O to lead back to. The tester came to the last area of
+ * the first level with a rifle still left behind, and no key that went
+ * back through the areas already seen.
+ */
+void CG_AccessibilityAreasBack(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 here, i, j, count = 0, withThings = 0, meters, left, area;
+	float               far[ETA_AREAS_MAX];
+	vec3_t              at, delta;
+	char                height[64], name[32], things[48];
+	qboolean            fresh;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	if (!eta_areas.loaded)
+	{
+		ETA_Speech_Say("This level is all one area. T finds things, O leads to the way out");
+		return;
+	}
+	here  = CG_AccessibilityAreaHere();
+	fresh = (qboolean)(cg.time < eta_areas.backPressedAt || cg.time - eta_areas.backPressedAt >= ETA_AREA_LIST_MS
+	                   || here != eta_areas.backArea || !eta_areas.backCount);
+	eta_areas.backPressedAt = cg.time;
+
+	if (fresh)
+	{
+		/* Those with things left, then the rest. */
+		for (j = 0; j < 2; j++)
+		{
+			int start = count;
+
+			for (i = 0; i < eta_areas.count && i < ETA_AREAS_MAX; i++)
+			{
+				if (!eta_areas.number[i] || i == here || !ETA_AreaSpot(i, at))
+				{
+					continue;
+				}
+				if (( CG_AccessibilityThingsLeftIn(i) > 0 ) != ( j == 0 ))
+				{
+					continue;
+				}
+				far[count]              = Distance(ps->origin, at) + fabsf(at[2] - ps->origin[2]);
+				eta_areas.back[count++] = i;
+			}
+			if (!j)
+			{
+				withThings = count;
+			}
+			/* Nearest first within each part. */
+			for (i = start; i < count; i++)
+			{
+				int k;
+
+				for (k = i + 1; k < count; k++)
+				{
+					if (far[k] < far[i])
+					{
+						int   t  = eta_areas.back[i];
+						float ft = far[i];
+
+						eta_areas.back[i] = eta_areas.back[k];
+						eta_areas.back[k] = t;
+						far[i]            = far[k];
+						far[k]            = ft;
+					}
+				}
+			}
+		}
+		eta_areas.backCount = count;
+		eta_areas.backArea  = here;
+		eta_areas.backPos   = -1;
+		if (!count)
+		{
+			ETA_Speech_Say("No other area explored yet. X finds the doors out");
+			return;
+		}
+	}
+
+	eta_areas.backPos = ( eta_areas.backPos + 1 ) % eta_areas.backCount;
+	area              = eta_areas.back[eta_areas.backPos];
+	ETA_AreaSpot(area, at);
+	left = CG_AccessibilityThingsLeftIn(area);
+	if (left)
+	{
+		Com_sprintf(things, sizeof(things), ", %d %s left", left, left == 1 ? "thing" : "things");
+	}
+	else
+	{
+		Q_strncpyz(things, ", nothing left", sizeof(things));
+	}
+
+	VectorSubtract(at, ps->origin, delta);
+	meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
+	meters = meters < 1 ? 1 : meters;
+	ETA_HudNarrator_HeightText(delta[2] * ETA_QU_TO_METERS, height, sizeof(height));
+
+	ETA_Speech_BeginReport();
+	if (fresh)
+	{
+		ETA_Speech_Say(withThings ? va("%d other %s explored, %d with things left", eta_areas.backCount,
+		                               eta_areas.backCount == 1 ? "area" : "areas", withThings)
+		               : va("%d other %s explored, nothing left in them", eta_areas.backCount,
+		                    eta_areas.backCount == 1 ? "area" : "areas"));
+	}
+	ETA_Speech_Say(va("%d of %d, area %d%s, %s, %d %s%s%s. O leads there", eta_areas.backPos + 1, eta_areas.backCount,
+	                  eta_areas.number[area], things, ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at)),
+	                  meters, meters == 1 ? "meter" : "meters", height[0] ? ", " : "", height));
+	ETA_Speech_EndReport();
+
+	Com_sprintf(name, sizeof(name), "area %d", eta_areas.number[area]);
+	CG_AccessibilityChoose(at, name);
+}
+
 #endif
