+/*
+ * A tunnel's way in that is a door, where the way-finder cannot go: the
+ * forest's corridor to its ladder up is reached through a side door in
+ * the road tunnel's north wall, which swings open for two seconds and
+ * shuts. The search took it for a wall and led along the open road past
+ * the two soldiers at the tunnel's far end, out and up the stairs to the
+ * ladder's top. The tester asked for the waypoint to the tunnel to go
+ * the walkthrough's way - through the side door, along the corridor.
+ * Outside the tunnel, O leads to the door first.
+ */
+typedef struct
+{
+	const char *map;
+	float       door[3];      /* where to stand: in front of it, on the near side */
+	float       inside[3];    /* a step past it: been here, the door is behind */
+} etaTunnelDoor_t;
+
+static const etaTunnelDoor_t eta_tunnelDoors[] =
+{
+	{ "forest", { -128.0f, 3770.0f, 232.0f }, { -128.0f, 4420.0f, 256.0f } },
+};
+
+static qboolean eta_tunnelDoorDone[ARRAY_LEN(eta_tunnelDoors)];
+
+/* The tunnel's door to lead to first, if the way to via goes through one
+   and the player has not been through it. */
+static qboolean ETA_TunnelDoorFirst(const vec3_t from, const vec3_t via, vec3_t door)
+{
+	char base[MAX_QPATH];
+	int  i;
+
+	COM_StripExtension(COM_SkipPath(cgs.mapname), base, sizeof(base));
+	for (i = 0; i < (int)ARRAY_LEN(eta_tunnelDoors); i++)
+	{
+		const etaTunnelDoor_t *d = &eta_tunnelDoors[i];
+		vec3_t                at, in;
+
+		if (Q_stricmp(d->map, base))
+		{
+			continue;
+		}
+		VectorCopy(d->door, at);
+		VectorCopy(d->inside, in);
+		/* Past it: nearer the ladder than the door is, or been inside. */
+		if (Distance(from, in) < 192.0f || Distance(from, via) < Distance(at, via))
+		{
+			eta_tunnelDoorDone[i] = qtrue;
+		}
+		if (eta_tunnelDoorDone[i] || Distance(at, via) > Distance(from, via))
+		{
+			continue;
+		}
+		VectorCopy(at, door);
+		return qtrue;
+	}
+	return qfalse;
+}
