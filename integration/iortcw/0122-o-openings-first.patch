+/* Anything still to explore: a way never tried, or a door from an area
+   been in to one not. While there is, O leads to the openings, as X does;
+   rooms with things not found come only after. The tester, led to a room
+   with a thing not found instead of on through the openings, found O
+   broken again. */
+static qboolean ETA_AreaExitOpens(const eta_areaExit_t *exit);
+
+qboolean CG_AccessibilityAreasSomethingNew(void)
+{
+	vec3_t      at, lead;
+	const char *word;
+	int         i;
+
+	for (i = 0; i < CG_AccessibilityNewWayCount(); i++)
+	{
+		if (CG_AccessibilityNewWayAt(i, at, lead, &word))
+		{
+			return qtrue;
+		}
+	}
+	if (!eta_areas.loaded)
+	{
+		return qfalse;
+	}
+	for (i = 0; i < eta_areas.exitCount; i++)
+	{
+		const eta_areaExit_t *exit = &eta_areas.exits[i];
+
+		if (exit->area[0] < 0 || exit->area[1] < 0)
+		{
+			continue;
+		}
+		if (!eta_areas.number[exit->area[0]] != !eta_areas.number[exit->area[1]] && ETA_AreaExitOpens(exit))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
