 /**
  * @brief "Jump up, ahead", once, as the player comes to a jump on the way.
@@ -1419,6 +1415,56 @@ static const char *ETA_RouteJumpKey(void)
  * nothing here: the ladder is said as the player reaches it, with F to
  * climb (cg_draw.c).
  */
+static qboolean ETA_RouteJumpIsDoor(const vec3_t edge, const vec3_t landing)
+{
+	trace_t through;
+	vec3_t  a, b;
+	int     model;
+
+	VectorCopy(edge, a);
+	VectorCopy(landing, b);
+	a[2] += 32.0f;
+	b[2] += 32.0f;
+
+	CG_Trace(&through, a, NULL, NULL, b, cg.predictedPlayerState.clientNum, MASK_PLAYERSOLID);
+	if (through.fraction < 1.0f && through.entityNum >= 0 && through.entityNum < ENTITYNUM_WORLD
+	    && cg_entities[through.entityNum].currentState.eType == ET_MOVER)
+	{
+		return qtrue;
+	}
+	/* And by the map's own door boxes, for one the snapshot does
+	   not hold solid. */
+	for (model = 1; model < MAX_MODELS && model < cgs.numInlineModels; model++)
+	{
+		vec3_t   mins, maxs;
+		qboolean opens;
+		int      k;
+		float    t;
+
+		if (!CG_AccessibilityDoorBox(model, mins, maxs, &opens))
+		{
+			continue;
+		}
+		for (t = 0.0f; t <= 1.0f; t += 0.125f)
+		{
+			for (k = 0; k < 3; k++)
+			{
+				float p = a[k] + ( b[k] - a[k] ) * t;
+
+				if (p < mins[k] - 2.0f || p > maxs[k] + 2.0f)
+				{
+					break;
+				}
+			}
+			if (k == 3)
+			{
+				return qtrue;
+			}
+		}
+	}
+	return qfalse;
+}
