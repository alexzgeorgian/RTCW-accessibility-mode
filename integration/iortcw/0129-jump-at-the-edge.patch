+/*
+ * The jump on the way, made at the edge. The tester, faced across the
+ * spike pit in the catacombs, held W and jumped, and fell in: the edge
+ * guard let go of W three metres short, and the jump was made from
+ * standing. With the way's next step a jump, and the player going toward
+ * where it lands with W held, the guard leaves them be, and jump is
+ * pressed for them at the lip - the timing a sighted player has, and a
+ * blind one cannot. Jump already held is let go a frame first: held, the
+ * game will not jump again.
+ */
+static struct
+{
+	int phase;   /* 0 none, 1 let go, to press next frame, 2 pressed */
+	int at;
+} eta_jumpAssist;
+
+static qboolean ETA_JumpAssistFrame(const usercmd_t *cmd)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              landing, edgeAt, toward;
+	qboolean            up, edge;
+	float               rise, walked, speed, off;
+
+	if (eta_jumpAssist.phase == 1)
+	{
+		trap_SendConsoleCommand("+moveup\n");
+		eta_jumpAssist.phase = 2;
+		eta_jumpAssist.at    = cg.time;
+		return qtrue;
+	}
+	if (eta_jumpAssist.phase == 2)
+	{
+		if (cg.time - eta_jumpAssist.at > 200 || cg.time < eta_jumpAssist.at)
+		{
+			trap_SendConsoleCommand("-moveup\n");
+			eta_jumpAssist.phase = 0;
+		}
+		return qtrue;
+	}
+	if (cmd->forwardmove <= 0 || ps->groundEntityNum == ENTITYNUM_NONE
+	    || !CG_AccessibilityMarkerJumpAhead(landing, &up, edgeAt))
+	{
+		return qfalse;
+	}
+	VectorSubtract(landing, ps->origin, toward);
+	toward[2] = 0.0f;
+	off = fabsf(AngleSubtract(ps->viewangles[YAW], vectoyaw(toward)));
+	if (off > 35.0f)
+	{
+		return qfalse;
+	}
+	speed = sqrtf(ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1]);
+	/* At the way's square before the jump - up onto something, or over
+	   something in the way - or, over a gap, at its lip. */
+	{
+		vec3_t   flat;
+		qboolean lip;
+
+		VectorSubtract(edgeAt, ps->origin, flat);
+		flat[2] = 0.0f;
+		edge = (qboolean)( VectorLength(flat) < 24.0f + speed * 0.05f );
+		if (!edge && !up)
+		{
+			walked = ETA_StairsKeepProbe(ps->viewangles[YAW], &rise, &lip);
+			edge   = (qboolean)( lip && walked <= 20.0f + speed * 0.05f );
+		}
+	}
+	if (edge)
+	{
+		if (cmd->upmove > 0)
+		{
+			trap_SendConsoleCommand("-moveup\n");
+			eta_jumpAssist.phase = 1;
+		}
+		else
+		{
+			trap_SendConsoleCommand("+moveup\n");
+			eta_jumpAssist.phase = 2;
+			eta_jumpAssist.at    = cg.time;
+		}
+	}
+	/* Going to the jump: not stopped at its edge. */
+	return qtrue;
+}
