+/* " 6 meters, then left.": the way's next turn, for O facing the way,
+   or nothing when it goes on straight or is not known. */
+static const char *ETA_TurnAheadText(void)
+{
+	float distance;
+	int   side, meters;
+
+	if (!CG_AccessibilityMarkerTurn(&distance, &side))
+	{
+		return "";
+	}
+	meters = (int)(distance * ETA_QU_TO_METERS + 0.5f);
+	if (meters < 1)
+	{
+		return va(" %s here.", side == 2 ? "Back" : side < 0 ? "Left" : "Right");
+	}
+	return va(" %d %s, then %s.", meters, meters == 1 ? "meter" : "meters",
+	          side == 2 ? "back" : side < 0 ? "left" : "right");
+}
