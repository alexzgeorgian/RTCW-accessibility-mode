+static void ETA_RouteStartAt(const vec3_t origin, float out[3])
+{
+	static const float offsets[17][2] =
+	{
+		{ 0, 0 },
+		{ 8, 0 }, { -8, 0 }, { 0, 8 }, { 0, -8 }, { 8, 8 }, { -8, 8 }, { -8, -8 }, { 8, -8 },
+		{ 16, 0 }, { -16, 0 }, { 0, 16 }, { 0, -16 }, { 16, 16 }, { -16, 16 }, { -16, -16 }, { 16, -16 }
+	};
+	int lift, i;
+
+	for (lift = 0; lift <= 16; lift += 8)
+	{
+		for (i = 0; i < 17; i++)
+		{
+			VectorSet(out, origin[0] + offsets[i][0], origin[1] + offsets[i][1], origin[2] + lift);
+			if (ETA_RouteStartFrom(out))
+			{
+				return;
+			}
+		}
+	}
+	VectorCopy(origin, out);
+}
