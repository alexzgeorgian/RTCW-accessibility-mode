+/*
+ * Where the search starts: where the player stands, or a little off it,
+ * where the search's box fits and a step can be taken from. Standing on
+ * the step before a door near the end of the first level, no step from
+ * the player's feet was taken - the box met the door frame - and O said
+ * "No way found from here yet" however often it was pressed.
+ */
+static qboolean ETA_RouteStartFrom(const float at[3])
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	trace_t trace;
+	int     k;
+
+	trap_CM_BoxTrace(&trace, at, at, mins, maxs, 0, MASK_PLAYERSOLID);
+	if (trace.startsolid)
+	{
+		return qfalse;
+	}
+	for (k = 0; k < 8; k++)
+	{
+		float to[3];
+
+		to[0] = at[0] + ETA_ROUTE_CELL * cosf(DEG2RAD(45.0f * k));
+		to[1] = at[1] + ETA_ROUTE_CELL * sinf(DEG2RAD(45.0f * k));
+		to[2] = at[2];
+		if (ETA_RouteMove(NULL, at, to) != ETA_PATH_NONE)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
