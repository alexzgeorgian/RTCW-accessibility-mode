+
+static qboolean ETA_PlaceInSight(const vec3_t from, const vec3_t to)
+{
+	trace_t trace;
+	vec3_t  a, b;
+
+	VectorCopy(from, a);
+	VectorCopy(to, b);
+	a[2] += 32.0f;
+	b[2] += 32.0f;
+	trap_CM_BoxTrace(&trace, a, b, vec3_origin, vec3_origin, 0, MASK_SOLID);
+	return (qboolean)(trace.fraction >= 0.97f);
+}
+
+/* The place at a point: the nearest one found there, 1 up, or 0. */
+static int ETA_PlaceAt(const vec3_t at)
+{
+	int   i, best = 0;
+	float bestFar = ETA_PLACE_NEAR;
+
+	for (i = 0; i < eta_places.count; i++)
+	{
+		float dx = eta_places.at[i][0] - at[0], dy = eta_places.at[i][1] - at[1];
+		float far = sqrtf(dx * dx + dy * dy);
+
+		if (far < bestFar && fabsf(eta_places.at[i][2] - at[2]) < ETA_WAYS_SAME_FLOOR
+		    && ETA_PlaceInSight(at, eta_places.at[i]))
+		{
+			best    = i + 1;
+			bestFar = far;
+		}
+	}
+	return best;
+}
+
+/* What a place is known by: a switch in it, or else a thing lying in
+   it, or else its ways. "" when it has no switch and asked for one. */
+static void ETA_PlaceName(const vec3_t at, qboolean switchOnly, char *out, size_t size)
+{
+	vec3_t   point;
+	char     name[64], bestName[64] = "";
+	qboolean item, bestItem = qtrue;
+	float    bestFar = 0.0f;
+	int      i, kind, most = 0, mostKind = 0;
+
+	for (i = 0; CG_AccessibilityMapThing(i, point, name, sizeof(name), &item); i++)
+	{
+		float far = Distance(point, at);
+
+		if (!name[0] || (item && switchOnly) || far >= ETA_PLACE_THING || fabsf(point[2] - at[2]) > 96.0f)
+		{
+			continue;
+		}
+		/* A switch before anything lying about; the nearest of each. */
+		if ((!bestName[0] || (!item && bestItem) || (item == bestItem && far < bestFar))
+		    && ETA_PlaceInSight(at, point))
+		{
+			Q_strncpyz(bestName, name, sizeof(bestName));
+			bestItem = item;
+			bestFar  = far;
+		}
+	}
+	if (bestName[0])
+	{
+		/* "Switch for a door": by the switch is enough to know it by. */
+		char *cut = (char *)Q_stristr(bestName, " for a door");
+
+		if (cut)
+		{
+			*cut = '\0';
+		}
+		bestName[0] = (char)tolower((unsigned char)bestName[0]);
+		Com_sprintf(out, size, "by the %s", bestName);
+		return;
+	}
+	if (switchOnly)
+	{
+		out[0] = '\0';
+		return;
+	}
+
+	for (kind = 0; kind < (int)ARRAY_LEN(eta_wayWords); kind++)
+	{
+		int n = 0;
+
+		for (i = 0; i < eta_ways.wayCount; i++)
+		{
+			n += eta_ways.ways[i].kind == (eta_wayKind_t)kind;
+		}
+		if (n > most)
+		{
+			most     = n;
+			mostKind = kind;
+		}
+	}
+	if (most == 1)
+	{
+		Q_strncpyz(name, eta_wayWords[mostKind], sizeof(name));
+		name[0] = (char)tolower((unsigned char)name[0]);
+		Com_sprintf(out, size, "with %s %s", strchr("aeiou", name[0]) ? "an" : "a", name);
+	}
+	else
+	{
+		Com_sprintf(out, size, "with %d %s", most, eta_wayWordsMany[mostKind]);
+	}
+}
+
+/* After a look on its own: a place come to, new or again. */
+static void ETA_PlaceLook(void)
+{
+	char summary[256], name[48];
+	int  at = ETA_PlaceAt(eta_ways.start);
+
+	if (at)
+	{
+		if (at != eta_places.current)
+		{
+			eta_places.current = at;
+			if (eta_waysCallouts.integer
+			    && (cg.time - eta_places.backAt >= ETA_PLACE_BACK_MS || cg.time < eta_places.backAt))
+			{
+				eta_places.backAt = cg.time;
+				ETA_Speech_BeginReport();
+				ETA_Speech_Say(va("Back in place %d, %s", at, eta_places.name[at - 1]));
+				ETA_Speech_EndReport();
+			}
+		}
+		return;
+	}
+
+	name[0] = '\0';
+	if (eta_ways.wayCount < 3)
+	{
+		ETA_PlaceName(eta_ways.start, qtrue, name, sizeof(name));
+		if (!name[0])
+		{
+			/* A corridor, or a room with one way in and one out: no
+			   place of its own, and none the player is in. */
+			if (eta_places.current && Distance(eta_ways.start, eta_places.at[eta_places.current - 1]) > ETA_PLACE_NEAR)
+			{
+				eta_places.current = 0;
+			}
+			return;
+		}
+	}
+	if (eta_places.count >= ETA_PLACES_MAX)
+	{
+		return;
+	}
+	if (!name[0])
+	{
+		ETA_PlaceName(eta_ways.start, qfalse, name, sizeof(name));
+	}
+
+	VectorCopy(eta_ways.start, eta_places.at[eta_places.count]);
+	Q_strncpyz(eta_places.name[eta_places.count], name, sizeof(eta_places.name[0]));
+	eta_places.count++;
+	eta_places.current = eta_places.count;
+	eta_places.backAt  = cg.time;
+
+	if (eta_waysCallouts.integer)
+	{
+		ETA_WaysSummary(summary, sizeof(summary));
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(va("%s %d, %s. %s", ETA_WaysKnownPlace(eta_ways.start) ? "Place" : "New place",
+		                  eta_places.count, name, summary));
+		ETA_Speech_EndReport();
+	}
+}
+
+/* The place at a point, for the trail (cg_accessibility_world.c): 1 up,
+   or 0. */
+int CG_AccessibilityPlaceAt(const vec3_t at)
+{
+	return ETA_PlaceAt(at);
+}
+
+/* For F1: "In place 3, by the switch, of 5 found". */
+void CG_AccessibilityPlaceText(char *out, size_t size)
+{
+	if (!eta_places.count)
+	{
+		Q_strncpyz(out, "No places found yet", size);
+	}
+	else if (eta_places.current)
+	{
+		Com_sprintf(out, size, "In place %d, %s, of %d found", eta_places.current,
+		            eta_places.name[eta_places.current - 1], eta_places.count);
+	}
+	else
+	{
+		Com_sprintf(out, size, "Between places, %d found", eta_places.count);
+	}
+}
