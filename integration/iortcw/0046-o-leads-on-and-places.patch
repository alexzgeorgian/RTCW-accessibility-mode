+#define ETA_PLACE_NEAR     240.0f   /* this near, and in sight: in it */
+#define ETA_PLACE_THING    160.0f   /* a thing this near it names it */
+#define ETA_PLACE_BACK_MS  8000     /* "Back in" no oftener */
+
+static struct
+{
+	vec3_t at[ETA_PLACES_MAX];
+	char   name[ETA_PLACES_MAX][48];
+	int    count;
+	int    current;   /* the place the player is in, 1 up, or 0 */
+	int    backAt;
