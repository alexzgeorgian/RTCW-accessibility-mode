+/*
+ * The next turn of the way: how far ahead, and which way it goes - -1
+ * left, 1 right, 2 back. The point the ping is on is the furthest along
+ * the way the player can walk to straight; past it, the way bends. The
+ * tester, turned to face the way, was told only how far the marker was,
+ * and walked on past the corner. qfalse with no way known, or none to
+ * turn.
+ */
+#define ETA_ROUTE_TURN_PAST  64.0f   /* this far on past the point: the way's new heading */
+#define ETA_ROUTE_TURN_ANGLE 35.0f
+
+qboolean CG_AccessibilityMarkerTurn(float *distance, int *side)
+{
+	const playerState_t *ps    = &cg.predictedPlayerState;
+	int                 count = ETA_PathFinder_PointCount(), i;
+	vec3_t              point, toSteer, past;
+	float               heading, rel;
+
+	if (!eta_marker.active || !eta_route.done || !eta_route.steering || eta_route.aimSet || eta_route.overEdge
+	    || eta_route.steerIndex <= 0 || eta_route.steerIndex >= count - 1)
+	{
+		return qfalse;
+	}
+
+	VectorSubtract(eta_route.steer, ps->origin, toSteer);
+	toSteer[2] = 0.0f;
+	for (i = eta_route.steerIndex + 1; i < count; i++)
+	{
+		ETA_PathFinder_Point(i, point);
+		VectorSubtract(point, eta_route.steer, past);
+		past[2] = 0.0f;
+		if (VectorLength(past) >= ETA_ROUTE_TURN_PAST)
+		{
+			break;
+		}
+	}
+	if (i >= count)
+	{
+		return qfalse;
+	}
+
+	/* Right on the point, the way there has no direction: the player's
+	   own heading is the way they came to it. */
+	heading = VectorLength(toSteer) < 24.0f ? ps->viewangles[YAW] : vectoyaw(toSteer);
+	rel     = AngleNormalize180(vectoyaw(past) - heading);
+	if (fabsf(rel) < ETA_ROUTE_TURN_ANGLE)
+	{
+		return qfalse;
+	}
+	*side     = fabsf(rel) > 125.0f ? 2 : rel > 0.0f ? -1 : 1;
+	*distance = VectorLength(toSteer);
+	return qtrue;
+}
