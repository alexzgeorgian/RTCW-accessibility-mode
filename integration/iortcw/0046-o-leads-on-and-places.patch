+static int eta_routeLockedCount;
+
+static void ETA_RouteLockedDoors(void)
+{
+	vec3_t origin, mins, maxs;
+	int    index, model, n, k;
+
+	eta_routeLockedCount = 0;
+	for (index = 0; eta_routeLockedCount < ETA_ROUTE_LOCKED_MAX && CG_AccessibilityLockedDoor(index, &model, origin);
+	     index++)
+	{
+		qboolean open = qfalse;
+
+		for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+		{
+			const entityState_t *es = &cg.snap->entities[n];
+
+			if (es->eType == ET_MOVER && es->modelindex == model)
+			{
+				open = (qboolean)(es->apos.trType != TR_STATIONARY || es->pos.trType != TR_STATIONARY
+				                  || VectorLength(es->apos.trBase) > 1.0f || Distance(es->pos.trBase, origin) > 1.0f);
+				break;
+			}
+		}
+		if (open)
+		{
+			continue;
+		}
+
+		trap_R_ModelBounds(cgs.inlineDrawModel[model], mins, maxs);
+		eta_routeLocked[eta_routeLockedCount].clip = trap_CM_InlineModel(model);
+		VectorCopy(origin, eta_routeLocked[eta_routeLockedCount].origin);
+		for (k = 0; k < 3; k++)
+		{
+			eta_routeLocked[eta_routeLockedCount].mins[k] = origin[k] + mins[k] - 32.0f;
+			eta_routeLocked[eta_routeLockedCount].maxs[k] = origin[k] + maxs[k] + 32.0f;
+		}
+		eta_routeLockedCount++;
+	}
+}
+
+/* Whether a walk from one point to another goes into a door locked shut. */
+static qboolean ETA_RouteThroughLocked(const float from[3], const float to[3])
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	int i, k;
+
+	for (i = 0; i < eta_routeLockedCount; i++)
+	{
+		trace_t trace;
+
+		for (k = 0; k < 3; k++)
+		{
+			if ((from[k] < eta_routeLocked[i].mins[k] && to[k] < eta_routeLocked[i].mins[k])
+			    || (from[k] > eta_routeLocked[i].maxs[k] && to[k] > eta_routeLocked[i].maxs[k]))
+			{
+				break;
+			}
+		}
+		if (k < 3)
+		{
+			continue;
+		}
+		trap_CM_TransformedBoxTrace(&trace, from, to, mins, maxs, eta_routeLocked[i].clip, MASK_PLAYERSOLID,
+		                            eta_routeLocked[i].origin, vec3_origin);
+		if (trace.startsolid || trace.fraction < 1.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
