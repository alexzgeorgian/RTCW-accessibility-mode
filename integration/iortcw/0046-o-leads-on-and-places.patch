+/*
+ * The doors locked for good, closed: walls to the way. The way is the
+ * map's own collision, which has no doors in it - a door opens - so it
+ * went through a door the map locks, the one only the soldiers open near
+ * the end of the first level. From one side of it the way said to go
+ * through; from the door itself, held shut, it was found round; and back
+ * again, it said through. The tester went round and round. One a soldier
+ * has opened stands open, and the way goes through while it does.
+ */
+#define ETA_ROUTE_LOCKED_MAX 32
+
+static struct
+{
+	clipHandle_t clip;
+	vec3_t       origin;
+	vec3_t       mins, maxs;   /* where it stands, and a body's width round it */
