@@ -5964,6 +5964,29 @@ static void ETA_LiftScriptLine(const char *a, const char *b, const char *c, cons
 static int eta_weakRail[ETA_WEAK_RAILS];
 static int eta_weakRailCount;
 
+/* Where the level posts its soldiers at the start (the ai_ entities'
+   origins): a ladder with one posted at its top is a watchtower's. */
+#define ETA_POSTS 128
+
+static vec3_t eta_post[ETA_POSTS];
+static int    eta_postCount;
+
+qboolean CG_AccessibilityPostNear(const vec3_t at, float across, float up)
+{
+	int i;
+
+	for (i = 0; i < eta_postCount; i++)
+	{
+		if (fabsf(eta_post[i][2] - at[2]) < up
+		    && ( eta_post[i][0] - at[0] ) * ( eta_post[i][0] - at[0] ) + ( eta_post[i][1] - at[1] ) * ( eta_post[i][1] - at[1] )
+		       < across * across)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
