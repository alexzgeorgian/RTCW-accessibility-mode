diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
index 9d93b9d7..088b5d66 100644
--- a/SP/code/cgame/cg_accessibility_route.c
+++ b/SP/code/cgame/cg_accessibility_route.c
@@ -3053,6 +3053,20 @@ void CG_AccessibilityMarkerFrame(void)
 		arrived = (qboolean)( VectorLength(flat) <= ETA_MARKER_DOOR_UNITS );
 	}
 
+	/* An objective's place, where the level's script meets it: an
+	   invisible trigger, often a thin strip across a doorway. Reached
+	   two metres short of it, the objective was not met - the rocket
+	   base's "Locate exit" said "Marker reached" again and again, a
+	   step from its strip. Reached on it. */
+	if (arrived && !Q_stricmp(eta_marker.name, "your next objective"))
+	{
+		vec3_t flat;
+
+		VectorSubtract(eta_marker.origin, cg.predictedPlayerState.origin, flat);
+		flat[2] = 0.0f;
+		arrived = (qboolean)( VectorLength(flat) <= ETA_MARKER_DOOR_UNITS );
+	}
+
 	/* The back of the truck: at the foot of its ramp, so that straight
 	   on is up it. */
 	if (arrived && !Q_stricmp(eta_marker.name, "the back of the truck"))
