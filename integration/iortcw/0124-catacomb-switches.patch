 	eta_areas.current = eta_areas.pending = -1;
 	eta_areas.bots    = bots;
 	/* Without the bots' rooms, cut at every door, not only those the map
@@ -1805,6 +1834,15 @@ void CG_AccessibilityAreaExits(void)
 			{
 				far[i] += 1000000.0f;
 			}
+			/* One O found no way to: after the others. */
+			else if (eta_areas.list[i] != ETA_AREA_ELSEWHERE && far[i] > 0.0f
+			         && ( ETA_AreaNoWayNear(at)
