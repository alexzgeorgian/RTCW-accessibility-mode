@@ -3906,6 +3906,73 @@ static int ETA_DoorToward(float yaw)
 /* A drop the way goes down, deeper than a stair: faced and said. */
 #define ETA_CLIMB_DROP_SAID 80.0f
 
+static void ETA_FaceTheWayUnreachable(void)
+{
+	vec3_t      origin;
+	const char *name = NULL;
+	char        what[48];
+
+	Q_strncpyz(what, CG_AccessibilityMarkerInfo(origin, &name) && name ? name : "there", sizeof(what));
+
+	/* The level's way out, not open yet - shut until the story opens
+	   it: on to the nearest place not explored, as X's first. The
+	   tester, in the village, heard O say there was no way, and had
+	   to use X all the time. O again goes on to X's next. */
+	if (!Q_stricmp(what, "the way out"))
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say("The way out is not open yet");
+		/* First the openings not yet explored, as X's; only when
+		   none is left, the rooms where things are still to be
+		   found. */
+		if (CG_AccessibilityAreasSomethingNew() || !CG_AccessibilityAreasLeadUnfound())
+		{
+			ETA_Speech_Say("On to the nearest place not explored");
+			CG_AccessibilityAreaExits();
+		}
+		CG_AccessibilityWayOut();
+		return;
+	}
+	/* A way X's list gave, O's own lead on with the way out shut: no
+	   way to it, so on to the next on the list, not the same "no way"
+	   again and again. */
+	if (!Q_stricmpn(what, "the opening ", 12) || !Q_stricmpn(what, "the door to ", 12)
+	    || !Q_stricmpn(what, "the door back ", 14) || !Q_stricmpn(what, "the new ", 8)
+	    || !Q_stricmpn(what, "the stairs ", 11))
+	{
+		static vec3_t triedFrom;
+		static int    tries;
+
+		CG_AccessibilityAreasNoWay(origin);
+		ETA_HudNarrator_HoldPassive(cg.time);
+		/* Each found to have no way goes on to the next by itself; from
+		   the same spot, once round them and no more - the test player in
+		   the catacombs heard the two ways there taken in turn without
+		   end. */
+		if (Distance(triedFrom, cg.predictedPlayerState.origin) > 48.0f)
+		{
+			VectorCopy(cg.predictedPlayerState.origin, triedFrom);
+			tries = 0;
+		}
+		if (++tries > 4)
+		{
+			ETA_Speech_Say(va("No way to %s from here yet, nor to the other ways on found so far. A jump, a switch or "
+			                  "something to break may be what is needed: X lists the ways, T what is left to do", what));
+			CG_AccessibilityMarkerForget();
+			return;
+		}
+		ETA_Speech_Say(va("No way to %s from here yet. On to the next", what));
+		CG_AccessibilityAreaExits();
+		CG_AccessibilityWayOut();
+		return;
+	}
+	CG_AccessibilityThingsNoWay(origin);   /* T lists it last, saying so */
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(va("No way to %s from here yet: a locked door is in between, or a part of the level not open "
+	                  "yet. X says what opens the doors here, and T what is left to do", what));
+	return;
+}
