@@ -396,6 +396,34 @@ qboolean CG_AccessibilityAreasSomethingNew(void)
 	return qfalse;
 }
 
+/* Ways O found no way to from where the player was: put last on X's list
+   when it is made again, so O goes on to the others first. In the
+   catacombs the test player was led to an opening behind a wall, and O
+   said "No way there from here yet" a hundred and seventy times. */
+#define ETA_AREA_NO_WAY_MAX 32
+static vec3_t eta_areaNoWay[ETA_AREA_NO_WAY_MAX];
+static int    eta_areaNoWayCount;
+
+void CG_AccessibilityAreasNoWay(const vec3_t point)
+{
+	VectorCopy(point, eta_areaNoWay[eta_areaNoWayCount % ETA_AREA_NO_WAY_MAX]);
+	eta_areaNoWayCount++;
+}
+
+static qboolean ETA_AreaNoWayNear(const vec3_t point)
+{
+	int i, n = eta_areaNoWayCount < ETA_AREA_NO_WAY_MAX ? eta_areaNoWayCount : ETA_AREA_NO_WAY_MAX;
+
+	for (i = 0; i < n; i++)
+	{
+		if (Distance(point, eta_areaNoWay[i]) < 96.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
