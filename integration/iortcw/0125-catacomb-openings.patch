diff --git a/SP/code/cgame/cg_accessibility_areas.c b/SP/code/cgame/cg_accessibility_areas.c
index 9c5e8694..d9b43088 100644
--- a/SP/code/cgame/cg_accessibility_areas.c
+++ b/SP/code/cgame/cg_accessibility_areas.c
@@ -2146,7 +2146,31 @@ void CG_AccessibilityAreaExits(void)
 	{
 		Q_strncpyz(name, exit->model ? "the door to a new area" : "the opening to a new area", sizeof(name));
 	}
-	CG_AccessibilityChoose(exit->side[side], name);
+	/* Where it stands on the floor beyond: an opening's spot worked out
+	   at the height of its top, in the second catacomb level, floated
+	   four metres up, and no way was ever found to it. */
+	{
+		static const vec3_t fmins = { -12.0f, -12.0f, 0.0f }, fmaxs = { 12.0f, 12.0f, 8.0f };
+		vec3_t              top, bottom, onFloor;
+		trace_t             trace;
+
+		VectorCopy(exit->side[side], top);
+		top[2] += 16.0f;
+		VectorCopy(top, bottom);
+		bottom[2] -= 320.0f;
+		VectorCopy(exit->side[side], onFloor);
+		trap_CM_BoxTrace(&trace, top, bottom, fmins, fmaxs, 0, MASK_PLAYERSOLID);
+		if (!exit->model && !trace.startsolid && trace.fraction < 1.0f && top[2] - trace.endpos[2] > 48.0f
+		    && top[2] - trace.endpos[2] < 160.0f)
+		{
+			onFloor[2] = trace.endpos[2] + 24.0f;
+			if (ETA_AreaOf(onFloor) != other)
+			{
+				VectorCopy(exit->side[side], onFloor);
+			}
+		}
+		CG_AccessibilityChoose(onFloor, name);
+	}
 	/* Reached on coming into the area beyond, not three metres short of
 	   its doorway: the tester, stopped there still on this side, was led
 	   to the same opening again and again. */
diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
index c497019c..d07fdf04 100644
--- a/SP/code/cgame/cg_accessibility_route.c
