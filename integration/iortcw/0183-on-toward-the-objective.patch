+static int CG_AccessibilityObjectiveBits( void );
+static int CG_AccessibilityObjectiveCount( void );
+
+/* For O (cg_accessibility_unlock.c): whether objective n, from 1, is met,
+   and its words. */
+qboolean CG_AccessibilityObjectiveDone( int n ) {
+	return (qboolean)( n > 0 && n <= ETA_MAX_OBJECTIVES && ( CG_AccessibilityObjectiveBits() & ( 1 << ( n - 1 ) ) ) );
+}
+
+const char *CG_AccessibilityObjectiveText( int n ) {
+	if ( n <= 0 || n > CG_AccessibilityObjectiveCount() ) {
+		return "";
+	}
+	return eta.objectiveText[n - 1];
+}
