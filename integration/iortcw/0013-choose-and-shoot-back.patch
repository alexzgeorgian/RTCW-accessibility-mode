 static qboolean ETA_AimAcquire(float maxMeters)
 {
 	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	qboolean       byKey = (qboolean)(maxMeters <= 0.0f);
+	int            count = CG_AccessibilityEnemyTargets(list, ETA_AIM_MAX_TARGETS, byKey);
+	int            index = 0, i;
 
-	if (CG_AccessibilityEnemyTargets(list, ETA_AIM_MAX_TARGETS) <= 0
-	    || (maxMeters > 0.0f && list[0].meters > maxMeters))
+	if (count <= 0 || (!byKey && list[0].meters > maxMeters))
 	{
 		return qfalse;
 	}
 
-	eta_aim.entityNum = list[0].entityNum;
-	VectorCopy(list[0].point, eta_aim.point);
+	if (byKey && eta_enemyChoose.held && cg.time >= eta_enemyChoose.at
+	    && cg.time - eta_enemyChoose.at < ETA_ENEMY_CHOOSE_MS)
+	{
+		for (i = 0; i < count; i++)
+		{
+			if (list[i].entityNum == eta_enemyChoose.entityNum)
+			{
+				index = i;
+				break;
+			}
+		}
+	}
+
+	eta_aim.entityNum = list[index].entityNum;
+	VectorCopy(list[index].point, eta_aim.point);
 	eta_aim.lostSince = 0;
