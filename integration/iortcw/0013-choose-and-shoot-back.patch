+/**
+ * @brief Shot: who by and where from, and the lock turned on them.
+ *
+ * The tester died in gunfights while still turning to find who was
+ * shooting: the lock by itself takes only an enemy in view, and one
+ * behind them was not. So a hit says who it was and where from - "Hit by
+ * Soldier, behind left, 8 meters" - and, with the lock by itself on, the
+ * aim is turned straight onto them, wherever they are, if they can be
+ * seen: the quickest way to shoot back. A lock the player holds on
+ * someone else is left alone.
+ */
+#define ETA_HIT_SAY_MS 1500
+
+static struct
+{
+	int      damageEvent;
+	int      saidAt;
+	qboolean primed;
+} eta_hit;
+
+static void ETA_HitFrame(void)
+{
+	const playerState_t *ps = &cg.snap->ps;
+	int                 attacker;
+	vec3_t              point;
+
+	if (!eta_hit.primed || ps->damageEvent == eta_hit.damageEvent)
+	{
+		eta_hit.primed      = qtrue;
+		eta_hit.damageEvent = ps->damageEvent;
+		return;
+	}
+	eta_hit.damageEvent = ps->damageEvent;
+
+	attacker = ps->persistant[PERS_ATTACKER];
+	if (!ps->damageCount || attacker < 0 || attacker >= MAX_CLIENTS || attacker == ps->clientNum
+	    || !cg_entities[attacker].currentValid || cg_entities[attacker].currentState.eType != ET_PLAYER)
+	{
+		return;
+	}
+
+	if (cg.time - eta_hit.saidAt > ETA_HIT_SAY_MS || cg.time < eta_hit.saidAt)
+	{
+		eta_hit.saidAt = cg.time;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_AimSay(va("Hit by %s", CG_AccessibilityCharacterName(attacker)), cg_entities[attacker].lerpOrigin);
+	}
+
+	if (!eta_autoLock.integer || eta_climb.active || cg.cameraMode
+	    || (eta_aim.mode == ETA_AIM_LOCK && (!eta_aim.automatic || eta_aim.entityNum == attacker))
+	    || !CG_AccessibilityEnemyAimPoint(attacker, point))
+	{
+		return;
+	}
+
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+	ETA_AimStop();
+	eta_aim.mode      = ETA_AIM_LOCK;
+	eta_aim.automatic = qtrue;
+	eta_aim.started   = cg.time;
+	eta_aim.entityNum = attacker;
+	eta_aim.lostSince = 0;
+	eta_aim.saidLost  = qfalse;
+	VectorCopy(point, eta_aim.point);
+}
+
 void CG_AccessibilityAimFrame(void)
 {
