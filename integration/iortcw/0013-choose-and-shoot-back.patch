 }
 
+static void ETA_EnemyChooseStep(int step)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	int            count, index = -1, i;
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	count = CG_AccessibilityEnemyTargets(list, ETA_AIM_MAX_TARGETS, qtrue);
+
+	if (count <= 0)
+	{
+		eta_enemyChoose.held = qfalse;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say("No enemy in sight");
+		return;
+	}
+
+	if (eta_enemyChoose.held && cg.time >= eta_enemyChoose.at && cg.time - eta_enemyChoose.at < ETA_ENEMY_CHOOSE_MS)
+	{
+		for (i = 0; i < count; i++)
+		{
+			if (list[i].entityNum == eta_enemyChoose.entityNum)
+			{
+				index = i;
+				break;
+			}
+		}
+	}
+
+	index = index < 0 ? (step > 0 ? 0 : count - 1) : (index + step + count) % count;
+
+	eta_enemyChoose.held      = qtrue;
+	eta_enemyChoose.entityNum = list[index].entityNum;
+	eta_enemyChoose.at        = cg.time;
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_AimSay(va("%s, %d of %d", list[index].name, index + 1, count), list[index].point);
+}
+
+void CG_AccessibilityEnemyNext_f(void)
+{
+	ETA_EnemyChooseStep(1);
+}
+
+void CG_AccessibilityEnemyPrev_f(void)
+{
+	ETA_EnemyChooseStep(-1);
+}
