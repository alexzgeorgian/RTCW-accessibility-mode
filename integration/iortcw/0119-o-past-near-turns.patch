@@ -2384,6 +2402,35 @@ qboolean CG_AccessibilityMarkerSteerPoint(vec3_t out)
 #define ETA_ROUTE_TURN_PAST  64.0f   /* this far on past the point: the way's new heading */
 #define ETA_ROUTE_TURN_ANGLE 35.0f
 
+/* Where the way goes on after its next turn: a little past the corner.
+   With the corner a step away, O faces on round it: turned to face the
+   corner itself, at the switchback stairs on the village's way to the
+   wine cellar, the test player was told "1 meter, then back", turned,
+   and was told it again, round and round. */
+qboolean CG_AccessibilityMarkerPastTurn(vec3_t out)
+{
+	int    count = ETA_PathFinder_PointCount(), i;
+	vec3_t point, past;
+
+	if (!eta_marker.active || !eta_route.done || !eta_route.steering || eta_route.steerIndex <= 0
+	    || eta_route.steerIndex >= count - 1)
+	{
+		return qfalse;
+	}
+	for (i = eta_route.steerIndex + 1; i < count; i++)
+	{
+		ETA_PathFinder_Point(i, point);
+		VectorSubtract(point, eta_route.steer, past);
+		past[2] = 0.0f;
+		if (VectorLength(past) >= ETA_ROUTE_TURN_PAST)
+		{
+			VectorCopy(point, out);
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
