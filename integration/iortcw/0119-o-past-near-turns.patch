 static void ETA_AreaNameBase(int area, char *out, size_t size)
+{
+	if (area >= 0 && area < ETA_AREAS_MAX && eta_areaNameCache[area][0])
+	{
+		Q_strncpyz(out, eta_areaNameCache[area], size);
+		return;
+	}
