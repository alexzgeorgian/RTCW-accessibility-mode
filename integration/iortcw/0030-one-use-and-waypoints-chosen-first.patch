--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -1435,6 +1435,34 @@ static float ETA_PropFlatDistance(const ETA_BspProp *prop, const vec3_t at)
 	return sqrt(dx * dx + dy * dy);
 }
 
+/* The name of the thing nearest a point on its floor, within a reach;
+   NULL for none. */
+static const char *ETA_PropNearName(const vec3_t at, float reach)
+{
+	const char *best = NULL;
+	float       bestDistance = reach;
+	int         i;
+
+	for (i = 0; i < eta_mapPropCount; i++)
+	{
+		const ETA_BspProp *prop = &eta_mapProps[i];
+		float              distance;
+
+		if (prop->maxs[2] < at[2] - 32.0f || prop->mins[2] > at[2] + 64.0f)
+		{
+			continue;
+		}
+		distance = ETA_PropFlatDistance(prop, at);
+		if (distance <= bestDistance)
+		{
+			bestDistance = distance;
+			best         = prop->name;
+		}
+	}
+
+	return best;
+}
