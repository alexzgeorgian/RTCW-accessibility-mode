+/*
+ * Whether a marker's name is one of this level's places along the way -
+ * or the start of one, as the marker keeps it. Named as places look, like
+ * every other place on the list: the tester found "hidden way" and
+ * "hidden place" meant nothing in a level with no hideout in it.
+ */
+qboolean CG_AccessibilityWayPlaceNamed(const char *name)
+{
+	char base[MAX_QPATH];
+	int  i, length;
+
+	if (!name || !( length = strlen(name) ))
+	{
+		return qfalse;
+	}
+	COM_StripExtension(COM_SkipPath(cgs.mapname), base, sizeof(base));
+	for (i = 0; i < (int)ARRAY_LEN(eta_hiddenPlaces); i++)
+	{
+		if (!Q_stricmp(eta_hiddenPlaces[i].map, base) && !Q_stricmpn(eta_hiddenPlaces[i].name, name, length)
+		    && ( !eta_hiddenPlaces[i].name[length] || eta_hiddenPlaces[i].name[length] == ',' ))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
