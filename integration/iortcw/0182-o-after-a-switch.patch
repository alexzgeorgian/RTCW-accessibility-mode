 {
 	int n;
@@ -9778,6 +9891,7 @@ void CG_AccessibilityWorldFrame(qboolean held)
 	ETA_TrapsFrame();
 	ETA_WorldRead();
 	ETA_DoorsSeen();
+	ETA_DoorsLiveFrame();
 
 	ETA_BeaconDoors();
 	ETA_BeaconLadders();
