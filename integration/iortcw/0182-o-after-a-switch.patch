+/* Out of sight: open as the game says it is now (g_main.c), or failing
+   that as last seen, or as the map starts it. Kept as last seen, a door a
+   switch in another room had opened stayed shut: in the church, after
+   the first switch, O said there was no way on. */
 qboolean CG_AccessibilityDoorOpenUnseen(int model)
 {
+	char live;
+
 	if (model <= 0 || model >= MAX_MODELS)
 	{
 		return qfalse;
 	}
+	live = CG_AccessibilityDoorLive(model);
+	if (live)
+	{
+		return (qboolean)( live == 'O' );
+	}
 	return (qboolean)( eta_doorSeen[model] == 1 || ( !eta_doorSeen[model] && eta_doorStartOpen[model] ) );
 }
 
+/* The doors as the game says they are now (g_main.c): when one opens or
+   shuts anywhere, seen or not - or a gate starts to move, or the player
+   uses something - what O found no way to, and the places it found
+   blocked, are tried again. */
+static void ETA_DoorsLiveFrame(void)
+{
+	static char last[MAX_MODELS + 1];
+	char        now[MAX_MODELS + 1];
+	int         model;
+	qboolean    changed = qfalse;
+
+	for (model = 1; model < MAX_MODELS; model++)
+	{
+		char live = eta_doorLocked[model] >= 0 ? CG_AccessibilityDoorLive(model) : 0;
+
+		now[model] = live ? live : '-';
+		if (last[model] && last[model] != now[model] && ( last[model] == 'O' || now[model] == 'O' ))
+		{
+			changed = qtrue;
+		}
+	}
+	now[0]         = '!';
+	now[MAX_MODELS] = '\0';
+
+	/* A gate the script moves - the church's portcullises, which its
+	   first switches raise - starting or stopping where it can be seen: the
+	   player stood held against it while it was down, and O marked the
+	   place blocked and found no way on after it rose. Not the traps,
+	   which move all the time. */
+	{
+		static qboolean wasMoving[MAX_MODELS];
+		int             n, k;
+
+		for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+		{
+			const entityState_t *es = &cg.snap->entities[n];
+			qboolean            moving, trap = qfalse;
+
+			if (es->eType != ET_MOVER || es->modelindex <= 0 || es->modelindex >= MAX_MODELS)
+			{
+				continue;
+			}
+			for (k = 0; k < eta_trapMoverCount; k++)
+			{
+				trap = (qboolean)( trap || eta_trapMovers[k].model == es->modelindex );
+			}
+			if (trap || eta_plateModel[es->modelindex])
+			{
+				continue;
+			}
+			moving = (qboolean)( es->pos.trType != TR_STATIONARY || es->apos.trType != TR_STATIONARY );
+			/* Starting, and stopping: the church's portcullis takes
+			   thirteen seconds to rise, and the way is open only then. */
+			if (moving != wasMoving[es->modelindex])
+			{
+				changed = qtrue;
+			}
+			wasMoving[es->modelindex] = moving;
+		}
+	}
+
+	/* And the use key pressed, F or the game's own: a switch somewhere
+	   may have opened the way. */
+	{
+		static qboolean wasUsing;
+		usercmd_t       cmd;
+		qboolean        using = qfalse;
+
+		if (trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd))
+		{
+			using = (qboolean)( ( cmd.buttons & BUTTON_ACTIVATE ) != 0 );
+		}
+		if (using && !wasUsing)
+		{
+			changed = qtrue;
+		}
+		wasUsing = using;
+	}
+
+	if (changed)
+	{
+		CG_AccessibilityAreasNoWayForget();
+		CG_AccessibilityThingsNoWayForget();
+		CG_AccessibilityRouteDoorsChanged();
+	}
+	memcpy(last, now, sizeof(last));
+}
+
