diff --git a/SP/code/cgame/cg_accessibility.c b/SP/code/cgame/cg_accessibility.c
index 636f6f69..2820e78f 100644
--- a/SP/code/cgame/cg_accessibility.c
+++ b/SP/code/cgame/cg_accessibility.c
@@ -61,7 +61,7 @@ static const struct {
 	const char *defaultValue;
 } etaSettings[] = {
 	{ &eta_environmentCallouts, "eta_environmentCallouts", "1" },
-	{ &eta_facingCallouts,      "eta_facingCallouts",      "1" },
+	{ &eta_facingCallouts,      "eta_facingCallouts",      "0" },
 	{ &eta_placeCallouts,       "eta_placeCallouts",       "1" },
 	{ &eta_openingCallouts,     "eta_openingCallouts",     "1" },
 	{ &eta_doorCues,            "eta_doorCues",            "1" },
@@ -679,6 +679,22 @@ void CG_AccessibilityInit( void ) {
 	}
 	CG_AccessibilityWorldInit();
 
+	/* Settings whose default has changed since a player's config was
+	   written, changed once for them: the facing callouts, said while
+	   turning, which the tester found too much (H says it on asking).
+	   eta_settingsVersion records it, so a player who turns them back on
+	   keeps them on. */
+	{
+		vmCvar_t version;
+
+		trap_Cvar_Register( &version, "eta_settingsVersion", "0", CVAR_ARCHIVE );
+		if ( version.integer < 1 ) {
+			trap_Cvar_Set( "eta_facingCallouts", "0" );
+			trap_Cvar_Update( &eta_facingCallouts );
+			trap_Cvar_Set( "eta_settingsVersion", "1" );
+		}
+	}
+
 	trap_AddCommand( "accessibilityStatus" );
 	trap_AddCommand( "accessibilityObjectives" );
 	trap_AddCommand( "accessibilityRepeat" );
