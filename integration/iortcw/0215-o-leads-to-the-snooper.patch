+/*
+ * An objective met by picking something up: the forest's Snooper rifle,
+ * whose pickup fires the script that meets it. It is no brush, so O never
+ * knew of it, and the tester searched the whole forest for it - and for
+ * the Thompson, dropped beside it. Led to where it lies.
+ */
+static qboolean ETA_UnlockPickedUp(const eta_unlockRecord_t *r)
+{
+	return (qboolean)( r->placed && ( !Q_stricmpn(r->classname, "weapon_", 7) || !Q_stricmpn(r->classname, "item_", 5)
+	                                  || !Q_stricmpn(r->classname, "holdable_", 9) ) );
+}
+
+static void ETA_UnlockObjectiveAt(const vec3_t at)
+{
+	int i;
+
+	for (i = 0; i < eta_objectivePlaceCount; i++)
+	{
+		if (eta_objectivePlaces[i].objective == eta_unlockObjective && Distance(eta_objectivePlaces[i].at, at) < 64.0f)
+		{
+			return;
+		}
+	}
+	if (eta_objectivePlaceCount < ETA_OBJECTIVE_PLACES)
+	{
+		VectorCopy(at, eta_objectivePlaces[eta_objectivePlaceCount].at);
+		eta_objectivePlaces[eta_objectivePlaceCount].objective = eta_unlockObjective;
+		eta_objectivePlaceCount++;
+	}
 }
 
