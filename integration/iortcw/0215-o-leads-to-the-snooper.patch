+/* A place that meets two objectives at once: the forest's supply truck,
+   boarded at the end, meets "stowaway" and "no alarms" together. */
+static qboolean ETA_ObjectivePlaceShared(int index)
+{
+	int i;
+
+	for (i = 0; i < eta_objectivePlaceCount; i++)
+	{
+		if (eta_objectivePlaces[i].objective != eta_objectivePlaces[index].objective
+		    && Distance(eta_objectivePlaces[i].at, eta_objectivePlaces[index].at) < 64.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
