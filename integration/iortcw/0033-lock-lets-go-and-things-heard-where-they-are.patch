diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index 31ba3214..3b1eb562 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -2785,12 +2785,98 @@ static void ETA_HitFrame(void)
 	VectorCopy(point, eta_aim.point);
 }
 
+/**
+ * @brief The thing chosen with K or J, heard from where it is.
+ *
+ * 1428, the tester said, had no marker for it: a beep from the point
+ * chosen, and the turn to it on a key. So the thing chosen plays its own
+ * sound, softer and quicker than the marker's ping, from where it is -
+ * out of sight too - until the player reaches it, chooses another, or
+ * uses it.
+ */
+static void ETA_ChosenBeaconFrame(void)
+{
+	vec3_t point;
+
+	if (!eta_choose.held || !eta_choose.byPlayer || cg.time < eta_choose.at
+	    || cg.time - eta_choose.at >= ETA_CHOOSE_HOLD_MS || !ETA_ChooseWhere(&eta_choose.target, point))
+	{
+		return;
+	}
+
+	/* Reached: there is nothing more to find. */
+	if (Distance(cg.predictedPlayerState.origin, point) * ETA_QU_TO_METERS <= ETA_USE_REACH_METERS + 0.5f)
+	{
+		return;
+	}
+
+	CG_AccessibilityLoopAt(point, CG_AccessibilityLoopSound(ETA_LOOP_CHOSEN),
+	                       CG_AccessibilityLoopVolume(ETA_LOOP_CHOSEN), 1200.0f);
+}
+
+/**
+ * @brief Each enemy in sight, heard from where they stand.
+ *
+ * As BROK the InvestiGator plays its fights: a low soft pulse from every
+ * enemy in clear sight within ETA_ENEMY_CUE_RANGE, all round, so where
+ * each is can be heard while the guns are firing, and a quiet one is
+ * not lost. Looked for ten times a second; the sound kept on in between.
+ * eta_enemyCues 0, or M with the enemy callouts, turns it off.
+ */
+#define ETA_ENEMY_CUE_RANGE 25.0f   /* metres */
+#define ETA_ENEMY_CUE_MAX   6
+
+static void ETA_EnemyCueFrame(void)
+{
+	static vec3_t points[ETA_ENEMY_CUE_MAX];
+	static int    entities[ETA_ENEMY_CUE_MAX];
+	static int    count, lookAt;
+	int           i;
+
+	if (!eta_enemyCues.integer || !cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		count = 0;
+		return;
+	}
+
+	if (cg.time - lookAt >= 100 || cg.time < lookAt)
+	{
+		etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+		int            n = CG_AccessibilityEnemyTargets(list, ETA_AIM_MAX_TARGETS, qtrue);
+
+		lookAt = cg.time;
+		count  = 0;
+		for (i = 0; i < n && count < ETA_ENEMY_CUE_MAX; i++)
+		{
+			if (list[i].meters <= ETA_ENEMY_CUE_RANGE)
+			{
+				entities[count] = list[i].entityNum;
+				VectorCopy(list[i].point, points[count]);
+				count++;
+			}
+		}
+	}
+
+	for (i = 0; i < count; i++)
+	{
+		/* Where they are now, between looks: they move. */
+		if (entities[i] >= 0 && entities[i] < MAX_GENTITIES && cg_entities[entities[i]].currentValid)
+		{
+			VectorCopy(cg_entities[entities[i]].lerpOrigin, points[i]);
+		}
+		CG_AccessibilityLoopAt(points[i], CG_AccessibilityLoopSound(ETA_LOOP_ENEMY),
+		                       CG_AccessibilityLoopVolume(ETA_LOOP_ENEMY) / 2, 1200.0f);
+	}
+}
+
 void CG_AccessibilityAimFrame(void)
 {
 	if (cg.snap && cg.snap->ps.pm_type == PM_NORMAL)
 	{
 		ETA_HitFrame();
 		ETA_FacePendingFrame();
+		ETA_ChosenBeaconFrame();
+		ETA_EnemyCueFrame();
 	}
 
 	/* A climb has the keys to itself. */
@@ -2982,6 +3068,24 @@ void CG_AccessibilityAimFrame(void)
 		return;
 	}
 
+	/* The one locked on has fallen: the lock lets go by itself. The
+	   tester had to press U again over a dead enemy - or was carried on
+	   to the next one without asking. "Down", and the aim is theirs. */
+	if (eta_aim.entityNum >= 0 && eta_aim.entityNum < MAX_GENTITIES
+	    && (!cg_entities[eta_aim.entityNum].currentValid
+	        || (cg_entities[eta_aim.entityNum].currentState.eFlags & EF_DEAD)))
+	{
+		qboolean automatic = eta_aim.automatic;
+
+		ETA_AimStop();
+		if (!automatic)
+		{
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("Down. Lock off");
+		}
+		return;
+	}
+
 	/* Gone - down, behind a wall, out of view: hold still a moment, then
 	   take the next one in sight, or say it is over. */
 	ETA_AimKeys(0, 0);
