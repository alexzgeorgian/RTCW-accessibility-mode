    test player stepped off it again and again. */
+/*
+ * The soldiers alive in the level as the way is planned, from the server
+ * (CS_ETA_ENEMIES): the way keeps its distance from them. The tester, in
+ * the forest, was led to the Snooper rifle the long way round, past five
+ * soldiers, and remembered a quieter way. A square within ETA_ROUTE_ENEMY_
+ * NEAR of one costs up to ETA_ROUTE_ENEMY_SQUARES more, the more the
+ * nearer, however many are near - enough to take a way round worth the
+ * walk, never to leave the player with none. In the forest, with the
+ * farmhouse's soldiers in, the way to the rifle turns north short of the
+ * house and goes round along the low ground instead of through it.
+ */
+#define ETA_ROUTE_ENEMY_MAX      40
+#define ETA_ROUTE_ENEMY_NEAR     768.0f   /* about 20 metres */
+#define ETA_ROUTE_ENEMY_SQUARES  16.0f
+
+static vec3_t eta_routeEnemies[ETA_ROUTE_ENEMY_MAX];
+static int    eta_routeEnemyCount;
+
+static void ETA_RouteEnemiesRead(void)
+{
+	const char *list = CG_ConfigString(CS_ETA_ENEMIES);
+
+	eta_routeEnemyCount = 0;
+	while (list && *list && eta_routeEnemyCount < ETA_ROUTE_ENEMY_MAX)
+	{
+		int    c;
+		vec3_t at;
+
+		if (sscanf(list, "%d %f %f %f", &c, &at[0], &at[1], &at[2]) == 4)
+		{
+			VectorCopy(at, eta_routeEnemies[eta_routeEnemyCount]);
+			eta_routeEnemyCount++;
+		}
+		list = strchr(list, ';');
+		if (list)
+		{
+			list++;
+		}
+	}
+}
+
+static float ETA_RouteEnemyExtra(const float at[3])
+{
+	float extra = 0.0f;
+	int   i;
+
+	for (i = 0; i < eta_routeEnemyCount; i++)
+	{
+		float dx = at[0] - eta_routeEnemies[i][0], dy = at[1] - eta_routeEnemies[i][1];
+		float d  = sqrtf(dx * dx + dy * dy);
+
+		if (d < ETA_ROUTE_ENEMY_NEAR && fabsf(at[2] - eta_routeEnemies[i][2]) < 512.0f)
+		{
+			extra += ETA_ROUTE_ENEMY_SQUARES * ( 1.0f - d / ETA_ROUTE_ENEMY_NEAR );
+		}
+	}
+	return extra < ETA_ROUTE_ENEMY_SQUARES ? extra : ETA_ROUTE_ENEMY_SQUARES;
+}
