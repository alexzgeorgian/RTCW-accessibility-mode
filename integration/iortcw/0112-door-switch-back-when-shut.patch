 	return qfalse;
 }
 
+/* For a switch that works a door: 1 with its door shut, 0 with it open
+   or moving, -1 for no door or one not in view. A door that shuts again
+   after a while - the middle station's hatch - wants its switch again. */
+int CG_AccessibilitySwitchDoorShut(const vec3_t point)
+{
+	int i, j;
+
+	ETA_WorldRead();
+	for (i = 1; i < MAX_MODELS; i++)
+	{
+		int door = eta_opensDoor[i];
+
+		if (door <= 0 || door >= MAX_MODELS || Distance(cgs.inlineModelMidpoints[i], point) >= 48.0f)
+		{
+			continue;
+		}
+		for (j = 0; cg.snap && j < cg.snap->numEntities; j++)
+		{
+			const entityState_t *es = &cg.snap->entities[j];
+
+			if (es->eType == ET_MOVER && es->modelindex == door)
+			{
+				return (es->pos.trType == TR_STATIONARY && es->apos.trType == TR_STATIONARY
+				        && VectorLength(es->apos.trBase) < 1.0f
+				        && Distance(es->pos.trBase, eta_doorOrigins[door]) < 1.0f) ? 1 : 0;
+			}
+		}
+		return -1;
+	}
+	return -1;
+}
