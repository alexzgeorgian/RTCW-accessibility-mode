+/*
+ * For T: whether a point is a switch of an order - its place, of how
+ * many, and how it stands - so T lists all of the order together, in
+ * order, wherever each is. 0 when it is not.
+ */
+int CG_AccessibilityPuzzleSwitchAt(const vec3_t point, int *place, int *places, char *state, size_t stateSize)
+{
+	int m, next;
+
+	ETA_WorldRead();
+	next = ETA_OrderNextModel();
+	for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+	{
+		if (!eta_switchPlace[m] || !eta_switchPart[m] || Distance(cgs.inlineModelMidpoints[m], point) > 48.0f)
+		{
+			continue;
+		}
+		*place  = eta_switchPlace[m];
+		*places = eta_switchPlaces[m];
+		if (eta_switchPressed[m])
+		{
+			Q_strncpyz(state, ", pressed already", stateSize);
+		}
+		else if (next && next != m && !eta_orderBroken)
+		{
+			Com_sprintf(state, stateSize, ", not yet: the %s one first", eta_switchSide[next]);
+		}
+		else
+		{
+			Q_strncpyz(state, next == m ? ", next to press" : "", stateSize);
+		}
+		return m;
+	}
+	return 0;
+}
