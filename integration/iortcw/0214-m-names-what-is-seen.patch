+/* The things the map places as models of their own - the forest's
+   trees, a wagon - not in its rooms' surfaces: read with the map's
+   entities, named by their model as the surfaces are by their shader,
+   and added to the things in the rooms. The tester asked M to name what
+   is seen as it looks, and the forest's 160 trees were not among them. */
+#define ETA_MODEL_PROPS 512
+static struct
+{
+	char   name[ETA_BSP_PROP_NAME];
+	vec3_t at;
+}          eta_modelProps[ETA_MODEL_PROPS];
+static int eta_modelPropCount;
+
+static void ETA_ModelPropsAdd(void)
+{
+	int i;
+
+	for (i = 0; i < eta_modelPropCount && eta_mapPropCount < ETA_MAP_PROPS; i++)
+	{
+		ETA_BspProp *prop = &eta_mapProps[eta_mapPropCount++];
+		qboolean     tree = (qboolean)!Q_stricmp(eta_modelProps[i].name, "Tree");
+		float        half = tree ? 40.0f : 24.0f;
+
+		Q_strncpyz(prop->name, eta_modelProps[i].name, sizeof(prop->name));
+		VectorSet(prop->mins, eta_modelProps[i].at[0] - half, eta_modelProps[i].at[1] - half,
+		          eta_modelProps[i].at[2] - 16.0f);
+		VectorSet(prop->maxs, eta_modelProps[i].at[0] + half, eta_modelProps[i].at[1] + half,
+		          eta_modelProps[i].at[2] + ( tree ? 256.0f : 56.0f ));
+	}
+}
