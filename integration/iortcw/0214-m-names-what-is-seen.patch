@@ -433,6 +446,89 @@ void CG_AccessibilityViewText(char *out, size_t size)
 	}
 	Q_strcat(out, size, ".");
 
+	/* The things the map is furnished with, as they look - trees, a
+	   truck, crates - in view, each kind once, with how many and the
+	   nearest: "2 trees, nearest ahead left, 8 meters". */
+	{
+		struct
+		{
+			const char *name;
+			int         count;
+			float       near, left;
+		} kinds[8];
+		int nk = 0, k, p;
+
+		int props = CG_AccessibilityPropCount();
+
+		for (p = 0; p < props; p++)
+		{
+			vec3_t      center;
+			float       far, left;
+			trace_t     tr;
+			const char *pname = CG_AccessibilityPropGet(p, center);
+
+			if (!pname)
+			{
+				continue;
+			}
+			far = Distance(eye, center);
+			if (far > ETA_VIEW_RANGE || fabsf(center[2] - eye[2]) > 256.0f)
+			{
+				continue;
+			}
+			left = CG_AccessibilityLeftOfView(center);
+			if (fabsf(left) > 60.0f || !Q_stricmp(pname, "Window"))
+			{
+				continue;
+			}
+			/* Seen: the eye's line to it meets nothing short of it - a
+			   tree's own trunk stops the line, and counts. */
+			CG_Trace(&tr, eye, NULL, NULL, center, ps->clientNum, MASK_SOLID);
+			if (tr.fraction < 1.0f && Distance(tr.endpos, center) > 160.0f)
+			{
+				continue;
+			}
+			for (k = 0; k < nk && Q_stricmp(kinds[k].name, pname); k++)
+			{
+			}
+			if (k == nk)
+			{
+				if (nk == (int)ARRAY_LEN(kinds))
+				{
+					continue;
+				}
+				kinds[nk].name  = pname;
+				kinds[nk].count = 0;
+				kinds[nk].near  = 1.0e9f;
+				nk++;
+			}
+			kinds[k].count++;
+			if (far < kinds[k].near)
+			{
+				kinds[k].near = far;
+				kinds[k].left = left;
+			}
+		}
+		for (k = 0; k < nk && k < 4; k++)
+		{
+			int  m = (int)( kinds[k].near * ETA_QU_TO_METERS + 0.5f );
+			char name[64];
+
+			Q_strncpyz(name, kinds[k].name, sizeof(name));
+			name[0] = (char)tolower((unsigned char)name[0]);
+			Q_strcat(out, size, kinds[k].count > 1
+			         ? va("%s%d %s%s, nearest %s, %d %s", k ? "; " : " You see: ", kinds[k].count, name,
+			              name[strlen(name) - 1] == 's' ? "" : "s", ETA_HudNarrator_RelativeDirection(kinds[k].left),
+			              m < 1 ? 1 : m, m == 1 ? "meter" : "meters")
+			         : va("%sa %s, %s, %d %s", k ? "; " : " You see: ", name,
+			              ETA_HudNarrator_RelativeDirection(kinds[k].left), m < 1 ? 1 : m, m == 1 ? "meter" : "meters"));
+		}
+		if (nk)
+		{
+			Q_strcat(out, size, ".");
+		}
+	}
+
 	/* Things to use, and people, in view: in front, and not behind a wall. */
