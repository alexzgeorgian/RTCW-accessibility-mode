+/* Whether a thing chosen with T or Y, not the one just used, is F's. */
+static qboolean ETA_UseThingChosen(void)
+{
+	vec3_t   at;
+	char     name[64];
+	qboolean pending;
+
+	return (qboolean)(CG_AccessibilityThingChoice(at, name, sizeof(name), &pending)
+	                  && !(eta_use.usedAt && Distance(at, eta_use.usedPoint) < ETA_F_LED_NEAR));
+}
