diff --git a/SP/code/cgame/cg_accessibility_areas.c b/SP/code/cgame/cg_accessibility_areas.c
new file mode 100644
index 00000000..5c2e8a6c
--- /dev/null
+++ b/SP/code/cgame/cg_accessibility_areas.c
@@ -0,0 +1,514 @@
+/*
+ * name:	cg_accessibility_areas.c
+ *
+ * desc:	[Accessibility]: the level as areas to explore, as 1428 has
+ *			them - the parts the map is made of, the doors out of each,
+ *			and which have been explored.
+ *
+ *			Only built with FEATURE_ACCESSIBILITY.
+ */
+
+#ifdef FEATURE_ACCESSIBILITY
+
+#include "cg_local.h"
+
+#include "hud/hud_narrator.h"
+#include "map/bsp_areas.h"
+#include "speech/speech_manager.h"
+
+#define CG_DPrintf(...) ((void)0)
+
+/**
+ * @brief "New area, area 3. 2 doors out, 1 to a new area. 4 things here."
+ *
+ * The tester, with the ways on, the numbered places and the things of the
+ * whole level on six keys, was lost among them: too much to find, and no
+ * sense of where in the level they were. 1428 is not an open world, but
+ * it has areas to explore, each with its ways out. So has every map here:
+ * the compiler cuts it into areas, split where a door closes the way.
+ * The player is told the area they come into, new or again; X goes
+ * through the doors out of it, nearest first, saying where each leads -
+ * a new area, or one explored - and leads to it; T keeps to what is in
+ * the area. Areas are numbered as the player first comes into them.
+ */
+
+#define ETA_AREAS_MAX       1024
+#define ETA_AREA_EXITS_MAX  256
+#define ETA_AREA_SETTLE_MS  700     /* in a new area this long: come into it */
+#define ETA_AREA_PICK_MS    8000    /* X again this soon: the next door */
+#define ETA_AREA_PICK_MOVED 80.0f   /* and this near where it was pressed */
+#define ETA_AREA_SAME_DOOR  136.0f  /* the other half of a double door */
+#define ETA_AREA_THINGS_NEAR 400.0f /* a thing whose area is not known, this near: here */
+#define ETA_AREA_THROUGH    224.0f  /* led this far through a door, where the floor goes on */
+
+typedef struct
+{
+	int      model;
+	int      area[2];
+	vec3_t   side[2];   /* standing just through it, in each area */
+	vec3_t   middle;
+	qboolean opens;
+} eta_areaExit_t;
+
+static struct
+{
+	qboolean       loaded;
+	int            count;
+	eta_areaExit_t exits[ETA_AREA_EXITS_MAX];
+	int            exitCount;
+	int            number[ETA_AREAS_MAX];   /* as first come into, from 1, or 0 */
+	int            numbered;
+	int            current;                 /* the map's own number, or -1 */
+	int            pending, pendingAt;
+	int            pressedAt, picks, target, targetSide;
+	vec3_t         pressedFrom;
+} eta_areas;
+
+/* The area a point is in: a point in a wall or in the floor - a switch,
+   an item on the ground - is tried a little way off. */
+static int ETA_AreaOf(const vec3_t at)
+{
+	static const float nudge[][3] =
+	{
+		{ 0, 0, 0 }, { 0, 0, 16 }, { 16, 0, 0 }, { -16, 0, 0 }, { 0, 16, 0 }, { 0, -16, 0 },
+		{ 0, 0, 40 }, { 32, 0, 16 }, { -32, 0, 16 }, { 0, 32, 16 }, { 0, -32, 16 }
+	};
+	int i;
+
+	if (!eta_areas.loaded)
+	{
+		return -1;
+	}
+	for (i = 0; i < (int)ARRAY_LEN(nudge); i++)
+	{
+		vec3_t point;
+		int    area;
+
+		VectorAdd(at, nudge[i], point);
+		area = ETA_BspAreas_At(point);
+		if (area >= 0 && area < ETA_AREAS_MAX)
+		{
+			return area;
+		}
+	}
+	return -1;
+}
+
+/* Each door the map has, between the areas on its two sides. */
+static void ETA_AreasDoors(void)
+{
+	int model;
+
+	eta_areas.exitCount = 0;
+	for (model = 1; model < MAX_MODELS && eta_areas.exitCount < ETA_AREA_EXITS_MAX; model++)
+	{
+		vec3_t   mins, maxs, middle, side[2];
+		int      area[2], thin, s, k;
+		float    reach;
+		qboolean opens;
+
+		if (!CG_AccessibilityDoorBox(model, mins, maxs, &opens))
+		{
+			continue;
+		}
+		thin = maxs[0] - mins[0] < maxs[1] - mins[1] ? 0 : 1;
+		for (k = 0; k < 3; k++)
+		{
+			middle[k] = (mins[k] + maxs[k]) * 0.5f;
+		}
+		middle[2] = mins[2] + 24.0f;
+
+		/* Through it either way - a door set deep in its wall needs a
+		   longer step to be out of it. */
+		for (s = 0; s < 2; s++)
+		{
+			area[s] = -1;
+			for (reach = 32.0f; reach <= 96.0f && area[s] < 0; reach += 32.0f)
+			{
+				VectorCopy(middle, side[s]);
+				side[s][thin] = s ? maxs[thin] + reach : mins[thin] - reach;
+				side[s][2]   += 16.0f;
+				area[s]       = ETA_BspAreas_At(side[s]);
+				side[s][2]   -= 16.0f;
+			}
+		}
+		if (area[0] < 0 || area[1] < 0 || area[0] == area[1] || area[0] >= ETA_AREAS_MAX || area[1] >= ETA_AREAS_MAX)
+		{
+			continue;
+		}
+
+		/* Led well through, not to the doorstep: the marker is reached
+		   3 meters short, and a player stopped there by the door, still
+		   in the area, was told the door was reached and went no
+		   further. As far as the floor goes on in the area beyond. */
+		for (s = 0; s < 2; s++)
+		{
+			float sign = s ? 1.0f : -1.0f, edge = s ? maxs[thin] : mins[thin];
+
+			for (reach = ETA_AREA_THROUGH; reach > fabsf(side[s][thin] - edge); reach -= 32.0f)
+			{
+				static const vec3_t boxMins = { -12.0f, -12.0f, -16.0f }, boxMaxs = { 12.0f, 12.0f, 16.0f };
+				vec3_t              point, from;
+				trace_t             trace;
+
+				VectorCopy(side[s], point);
+				point[thin] = edge + sign * reach;
+				point[2]   += 16.0f;
+				if (ETA_BspAreas_At(point) != area[s])
+				{
+					continue;
+				}
+				VectorCopy(side[s], from);
+				from[2] += 16.0f;
+				trap_CM_BoxTrace(&trace, from, point, boxMins, boxMaxs, 0, MASK_PLAYERSOLID);
+				if (trace.startsolid || trace.fraction < 1.0f)
+				{
+					continue;
+				}
+				point[2] -= 16.0f;
+				VectorCopy(point, side[s]);
+				break;
+			}
+		}
+
+		/* The other half of a double door is the same way through. */
+		for (k = 0; k < eta_areas.exitCount; k++)
+		{
+			eta_areaExit_t *other = &eta_areas.exits[k];
+			float          dx     = other->middle[0] - middle[0], dy = other->middle[1] - middle[1];
+
+			if (dx * dx + dy * dy < ETA_AREA_SAME_DOOR * ETA_AREA_SAME_DOOR && fabsf(other->middle[2] - middle[2]) < 64.0f
+			    && ( ( other->area[0] == area[0] && other->area[1] == area[1] )
+			         || ( other->area[0] == area[1] && other->area[1] == area[0] ) ))
+			{
+				break;
+			}
+		}
+		if (k < eta_areas.exitCount)
+		{
+			continue;
+		}
+
+		CG_DPrintf("accessibility: door *%d between areas %d and %d, at %.0f %.0f %.0f\n", model, area[0], area[1],
+		           middle[0], middle[1], middle[2]);
+		eta_areas.exits[k].model = model;
+		eta_areas.exits[k].opens = opens;
+		VectorCopy(middle, eta_areas.exits[k].middle);
+		for (s = 0; s < 2; s++)
+		{
+			eta_areas.exits[k].area[s] = area[s];
+			VectorCopy(side[s], eta_areas.exits[k].side[s]);
+		}
+		eta_areas.exitCount++;
+	}
+}
+
+/* From cg_accessibility_world.c, once the map's areas are read. */
+void CG_AccessibilityAreasLoaded(int count)
+{
+	memset(&eta_areas, 0, sizeof(eta_areas));
+	eta_areas.current = eta_areas.pending = eta_areas.target = -1;
+	eta_areas.count   = count;
+	eta_areas.loaded  = (qboolean)(count > 1);
+	if (eta_areas.loaded)
+	{
+		ETA_AreasDoors();
+	}
+	CG_Printf("eta: %s has %d areas, %d doors between them\n", cgs.mapname, count, eta_areas.exitCount);
+}
+
+/* Whether the level is told as areas: a map with more than one. */
+qboolean CG_AccessibilityAreasOn(void)
+{
+	return eta_areas.loaded;
+}
+
+/* The map's own number of the area a point is in, or -1. */
+int CG_AccessibilityAreaOf(const vec3_t at)
+{
+	return ETA_AreaOf(at);
+}
+
+/* The area the player is in, as the map numbers it, or -1. */
+int CG_AccessibilityAreaHere(void)
+{
+	if (!eta_areas.loaded)
+	{
+		return -1;
+	}
+	return eta_areas.current >= 0 ? eta_areas.current : ETA_AreaOf(cg.predictedPlayerState.origin);
+}
+
+/* Whether a thing at a point is in the area the player is in. */
+qboolean CG_AccessibilityAreaHolds(int area, const vec3_t at)
+{
+	int there;
+
+	if (!eta_areas.loaded || area < 0)
+	{
+		return qtrue;
+	}
+	there = ETA_AreaOf(at);
+	return (qboolean)(there == area
+	                  || ( there < 0 && Distance(at, cg.predictedPlayerState.origin) < ETA_AREA_THINGS_NEAR ));
+}
+
+static int ETA_AreaDoorsOut(int area, int *toNew)
+{
+	int i, count = 0;
+
+	*toNew = 0;
+	for (i = 0; i < eta_areas.exitCount; i++)
+	{
+		const eta_areaExit_t *exit = &eta_areas.exits[i];
+
+		if (exit->area[0] == area || exit->area[1] == area)
+		{
+			count++;
+			*toNew += !eta_areas.number[exit->area[exit->area[0] == area ? 1 : 0]];
+		}
+	}
+	return count;
+}
+
+/* "2 doors out, 1 to a new area". */
+static void ETA_AreaDoorsText(int area, char *out, size_t size)
+{
+	int toNew, count = ETA_AreaDoorsOut(area, &toNew);
+
+	if (!count)
+	{
+		Q_strncpyz(out, "No doors out", size);
+	}
+	else if (!toNew)
+	{
+		Com_sprintf(out, size, "%d %s out, all to areas explored", count, count == 1 ? "door" : "doors");
+	}
+	else
+	{
+		Com_sprintf(out, size, "%d %s out, %d to %s", count, count == 1 ? "door" : "doors", toNew,
+		            toNew == 1 ? "a new area" : "new areas");
+	}
+}
+
+/* Each frame: the area come into, said once the player is in it. */
+void CG_AccessibilityAreasFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	char                doors[96], things[160];
+	qboolean            first;
+	int                 area;
+
+	if (!eta_areas.loaded || !cg.snap || ps->pm_type != PM_NORMAL || ps->groundEntityNum == ENTITYNUM_NONE)
+	{
+		return;
+	}
+	area = ETA_AreaOf(ps->origin);
+	if (area < 0 || area == eta_areas.current)
+	{
+		eta_areas.pending = -1;
+		return;
+	}
+	if (area != eta_areas.pending)
+	{
+		eta_areas.pending   = area;
+		eta_areas.pendingAt = cg.time;
+		return;
+	}
+	if (cg.time - eta_areas.pendingAt < ETA_AREA_SETTLE_MS && cg.time >= eta_areas.pendingAt)
+	{
+		return;
+	}
+
+	/* The level begins in an area: numbered, not said over the start. */
+	first             = (qboolean)(eta_areas.current < 0);
+	eta_areas.current = area;
+	eta_areas.pending = -1;
+	if (!eta_areas.number[area])
+	{
+		eta_areas.number[area] = ++eta_areas.numbered;
+		if (first || !eta_waysCallouts.integer)
+		{
+			return;
+		}
+		ETA_AreaDoorsText(area, doors, sizeof(doors));
+		CG_AccessibilityThingsInArea(area, things, sizeof(things));
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(va("New area, area %d. %s. %s", eta_areas.number[area], doors, things));
+		ETA_Speech_EndReport();
+		return;
+	}
+	if (!first && eta_waysCallouts.integer)
+	{
+		CG_AccessibilityThingsInArea(area, things, sizeof(things));
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(va("Back in area %d. %s", eta_areas.number[area], things));
+		ETA_Speech_EndReport();
+	}
+}
+
+/* For F1: "In area 3, of 5 explored. 2 doors out, 1 to a new area". */
+void CG_AccessibilityAreaText(char *out, size_t size)
+{
+	int  area = CG_AccessibilityAreaHere();
+	char doors[96];
+
+	if (area < 0 || !eta_areas.number[area])
+	{
+		Com_sprintf(out, size, "%d %s explored", eta_areas.numbered, eta_areas.numbered == 1 ? "area" : "areas");
+		return;
+	}
+	ETA_AreaDoorsText(area, doors, sizeof(doors));
+	Com_sprintf(out, size, "In area %d, of %d explored. %s", eta_areas.number[area], eta_areas.numbered, doors);
+}
+
+/* Whether the marker is still on the door X led to. */
+static qboolean ETA_AreaMarkerOurs(void)
+{
+	vec3_t     origin;
+	const char *name;
+
+	if (eta_areas.target < 0 || eta_areas.target >= eta_areas.exitCount)
+	{
+		return qfalse;
+	}
+	return (qboolean)(CG_AccessibilityMarkerInfo(origin, &name)
+	                  && Distance(origin, eta_areas.exits[eta_areas.target].side[eta_areas.targetSide]) < 1.0f);
+}
+
+/*
+ * X: the doors out of the area the player is in, nearest first, and to
+ * the one chosen, as T leads to a thing - turned toward the way there,
+ * with the ping. X again within a few seconds, the next door; later,
+ * still on the way to one, turned toward the way again. A door to an
+ * area not yet explored is said so, and so is the one toward the way out.
+ */
+void CG_AccessibilityAreaExits(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 order[ETA_AREA_EXITS_MAX], count = 0, area, wayOutArea = -1, i, j, meters;
+	char                where[96], height[64], name[64], doors[96];
+	const eta_areaExit_t *exit;
+	vec3_t              delta, wayOut;
+	qboolean            again;
+	int                 other;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	if (!eta_areas.loaded)
+	{
+		ETA_Speech_Say("This level is all one area. T finds things, O leads to the way out");
+		return;
+	}
+	area = CG_AccessibilityAreaHere();
+	if (area < 0)
+	{
+		ETA_Speech_Say("Not in an area here. O leads to the way out");
+		return;
+	}
+	if (!eta_areas.number[area])
+	{
+		eta_areas.number[area] = ++eta_areas.numbered;
+	}
+
+	/* Again soon, standing where it was pressed: the next door. Walked
+	   on since, toward the one chosen: turned toward the way again. */
+	again               = (qboolean)(cg.time >= eta_areas.pressedAt && cg.time - eta_areas.pressedAt < ETA_AREA_PICK_MS
+	                                 && Distance(ps->origin, eta_areas.pressedFrom) < ETA_AREA_PICK_MOVED);
+	eta_areas.pressedAt = cg.time;
+	VectorCopy(ps->origin, eta_areas.pressedFrom);
+	if (!again && ETA_AreaMarkerOurs())
+	{
+		CG_AccessibilityFaceTheWay();
+		return;
+	}
+
+	for (i = 0; i < eta_areas.exitCount; i++)
+	{
+		if (eta_areas.exits[i].area[0] == area || eta_areas.exits[i].area[1] == area)
+		{
+			order[count++] = i;
+		}
+	}
+	if (!count)
+	{
+		ETA_Speech_Say(va("Area %d has no doors out. O leads to the way out", eta_areas.number[area]));
+		eta_areas.target = -1;
+		return;
+	}
+
+	/* Nearest first, a floor counting double. */
+	for (i = 0; i < count; i++)
+	{
+		for (j = i + 1; j < count; j++)
+		{
+			const float *a = eta_areas.exits[order[i]].middle, *b = eta_areas.exits[order[j]].middle;
+			float       fa = Distance(ps->origin, a) + fabsf(a[2] - ps->origin[2]);
+			float       fb = Distance(ps->origin, b) + fabsf(b[2] - ps->origin[2]);
+
+			if (fb < fa)
+			{
+				int t = order[i];
+
+				order[i] = order[j];
+				order[j] = t;
+			}
+		}
+	}
+
+	eta_areas.picks = again ? eta_areas.picks + 1 : 0;
+	eta_areas.target     = order[eta_areas.picks % count];
+	exit                 = &eta_areas.exits[eta_areas.target];
+	eta_areas.targetSide = exit->area[0] == area ? 1 : 0;
+	other                = exit->area[eta_areas.targetSide];
+
+	if (CG_AccessibilityExitPoint(ps->origin, wayOut))
+	{
+		wayOutArea = ETA_AreaOf(wayOut);
+	}
+
+	if (eta_areas.number[other])
+	{
+		Com_sprintf(where, sizeof(where), "back to area %d", eta_areas.number[other]);
+	}
+	else
+	{
+		Q_strncpyz(where, "to a new area", sizeof(where));
+	}
+	if (other == wayOutArea && wayOutArea != area)
+	{
+		Q_strcat(where, sizeof(where), ", where the way out is");
+	}
+
+	VectorSubtract(exit->middle, ps->origin, delta);
+	meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
+	meters = meters < 1 ? 1 : meters;
+	ETA_HudNarrator_HeightText(delta[2] * ETA_QU_TO_METERS, height, sizeof(height));
+
+	ETA_Speech_BeginReport();
+	if (!eta_areas.picks)
+	{
+		ETA_AreaDoorsText(area, doors, sizeof(doors));
+		ETA_Speech_Say(va("Area %d. %s", eta_areas.number[area], doors));
+	}
+	ETA_Speech_Say(va("Door %d of %d, %s%s, %s, %d %s%s%s", eta_areas.picks % count + 1, count, where,
+	                  exit->opens ? "" : ", locked",
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(exit->middle)),
+	                  meters, meters == 1 ? "meter" : "meters", height[0] ? ", " : "", height));
+	ETA_Speech_EndReport();
+
+	if (eta_areas.number[other])
+	{
+		Com_sprintf(name, sizeof(name), "the door back to area %d", eta_areas.number[other]);
+	}
+	else
+	{
+		Q_strncpyz(name, "the door to a new area", sizeof(name));
+	}
