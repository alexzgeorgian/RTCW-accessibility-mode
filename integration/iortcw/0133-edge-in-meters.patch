 /*
- * How near the edge: walking toward a drop with W held, a soft tick,
- * again and again, quicker the nearer the edge - from about three metres
- * out, every 0.4 seconds, to every 0.07 at the lip. The tester heard how
- * deep a ledge was, and never how near it was, so could not tell when to
- * jump the spike pit. Along the way the player is going, as the edge
- * guard looks: stairs down are no edge.
+ * How near the edge, in metres: walking toward a drop with W held, "Edge
+ * in 3 meters", then "2 meters", then "1 meter", each once as the edge
+ * comes nearer; very near, the drop warning says how deep it is. The
+ * tester heard how deep a ledge was, never how near, and could not tell
+ * when to jump the spike pit; a ticking sound, tried, was not what they
+ * wanted - the metres were. Along the way the player is going, as the
+ * edge guard looks: stairs down are no edge.
  */
-static void ETA_EdgeTickFrame(const usercmd_t *cmd)
+static void ETA_EdgeNearFrame(const usercmd_t *cmd)
 {
-	static int          lastTick;
+	static int          saidMeters;
+	static int          seenAt;
 	const playerState_t *ps = &cg.predictedPlayerState;
-	float               walked, rise, interval;
+	float               walked, rise;
 	qboolean            edge;
-	sfxHandle_t         sfx;
+	int                 meters;
 
+	/* Forgotten once no edge has been ahead for a moment: W let go and
+	   pressed again on the way to it is the same approach. */
+	if (saidMeters && ( cg.time - seenAt > 1500 || cg.time < seenAt ))
+	{
+		saidMeters = 0;
+	}
 	if (cmd->forwardmove <= 0 || ps->groundEntityNum == ENTITYNUM_NONE || (ps->pm_flags & PMF_LADDER)
 	    || CG_AccessibilityClimbing())
 	{
@@ -3395,17 +3369,39 @@ static void ETA_EdgeTickFrame(const usercmd_t *cmd)
 	{
 		return;
 	}
-	interval = 70.0f + walked * 2.5f;
-	if (cg.time - lastTick < (int)interval && cg.time >= lastTick)
+
+	/* Deeper than a step or two down, as the drop warning counts one. */
+	{
+		vec3_t  dir, lip, bottom;
+		trace_t trace;
+
+		VectorSet(dir, cosf(DEG2RAD(ps->viewangles[YAW])), sinf(DEG2RAD(ps->viewangles[YAW])), 0.0f);
+		VectorMA(ps->origin, walked + ETA_STAIRS_KEEP_STEP + 16.0f, dir, lip);
+		lip[2] = ps->origin[2] + ps->mins[2] + rise + 8.0f;
+		VectorCopy(lip, bottom);
+		bottom[2] -= 64.0f + 8.0f;
+		CG_Trace(&trace, lip, NULL, NULL, bottom, ps->clientNum, MASK_PLAYERSOLID);
+		if (trace.fraction < 1.0f)
+		{
+			return;
+		}
+	}
+	seenAt = cg.time;
+
+	meters = (int)ceilf(walked * ETA_QU_TO_METERS);
+	meters = meters < 1 ? 1 : meters;
+	if (meters > 3)
 	{
 		return;
 	}
-	lastTick = cg.time;
-	sfx      = CG_AccessibilityLoopSound(ETA_LOOP_EDGE_TICK);
-	if (sfx && CG_AccessibilityBumpVolume() > 0)
+	/* Each once, nearer. */
+	if (saidMeters && meters >= saidMeters)
 	{
-		trap_S_StartLocalSound(sfx, CHAN_LOCAL_SOUND);
+		return;
 	}
+	saidMeters = meters;
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(meters == 3 ? "Edge in 3 meters" : meters == 2 ? "2 meters" : "1 meter");
 }
 
