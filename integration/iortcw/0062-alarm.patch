+/* The game's own alarm, which drowned out everything else. */
+vmCvar_t eta_alarmVolume;
 
 static const struct {
 	vmCvar_t *cvar;
@@ -104,6 +106,33 @@ static int ETA_VolumePercent( const vmCvar_t *cvar ) {
 	return cvar->integer <= 0 ? 0 : cvar->integer >= 100 ? 100 : cvar->integer;
 }
 
+/*
+ * A loop sound: the alarm, 0 to 255 as the alarm volume setting
+ * says, and -1 for any other sound, played as the game plays it. The
+ * tester, with an alarm going, could not hear the mode's own sounds or
+ * find their way for it.
+ */
+int CG_AccessibilitySpeakerVolume( int loopSound ) {
+	const char *name;
+
+	if ( loopSound <= 0 || loopSound >= MAX_SOUNDS ) {
+		return -1;
+	}
+	name = CG_ConfigString( CS_SOUNDS + loopSound );
+	if ( !name || ( !Q_stristr( name, "alarm" ) && !Q_stristr( name, "klaxon" ) && !Q_stristr( name, "siren" ) ) ) {
+		return -1;
+	}
+	return ( 255 * ETA_VolumePercent( &eta_alarmVolume ) ) / 100;
+}
+
+/* Whether a sound is played as the game plays it: anything but the alarm,
+   and the alarm at full volume. */
+qboolean CG_AccessibilityAlarmLoud( int sound ) {
+	int volume = CG_AccessibilitySpeakerVolume( sound );
+
+	return (qboolean)( volume < 0 || volume >= 255 );
+}
+
 /* The loop's volume, 0 to 255, from its kind's setting. */
