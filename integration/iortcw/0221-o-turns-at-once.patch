+ * holds four), and kept (a cache by cell, cleared as each way is
+ * planned): looked along for every square, they doubled the search.
  */
 #define ETA_ROUTE_SEEN_FAR      2048.0f   /* about 50 metres */
 #define ETA_ROUTE_SEEN_SQUARES  4.0f
@@ -493,7 +496,7 @@ static struct
 
 static float ETA_RouteSeenExtra(const float at[3])
 {
-	int          sx = (int)floorf(at[0] / 32.0f), sy = (int)floorf(at[1] / 32.0f), sz = (int)floorf(at[2] / 64.0f);
+	int          sx = (int)floorf(at[0] / 64.0f), sy = (int)floorf(at[1] / 64.0f), sz = (int)floorf(at[2] / 64.0f);
 	int          key = ( ( sx & 0x3ff ) | ( ( sy & 0x3ff ) << 10 ) | ( ( sz & 0x7f ) << 20 ) ) + 1;
 	unsigned int slot = ( (unsigned int)key * 2654435761u ) & ( ETA_ROUTE_SEEN_CACHE - 1 );
 	float        extra = 0.0f;
@@ -2124,6 +2127,7 @@ static void ETA_RouteFollow(ETA_PathState state, const vec3_t here)
 		   when the search began: a long search must not be thrown away
 		   the moment it finishes. */
 		eta_route.done   = qtrue;
+		eta_route.known  = qtrue;
 		eta_route.doneAt = cg.time;
 	}
 
@@ -3114,12 +3118,23 @@ qboolean CG_AccessibilityMarkerInfo(vec3_t origin, const char **name)
    forest, takes some seconds of the search's share of each frame. */
 qboolean CG_AccessibilityRouteSearching(void)
 {
-	return (qboolean)(eta_marker.active && !eta_route.done && ETA_PathFinder_State() == ETA_PATH_SEARCHING);
+	/* Or about to be: a marker just set is looked for from the next
+	   frame, and meanwhile the finder still holds the last search's
+	   state. O, pressed toward the objective, said "No way found" while
+	   its search had not begun. */
+	ETA_PathState state = ETA_PathFinder_State();
+
+	return (qboolean)(eta_marker.active && !eta_route.done
+	                  && ( !eta_route.planned || state == ETA_PATH_SEARCHING || state == ETA_PATH_IDLE ));
 }
 
+/* Known, too, while it is looked for again from where the player has
+   got to - every five seconds, and when they stray: O, pressed then, said
+   "Finding the way" every few presses on a way it already had. The point
+   it steers by is kept until the new way is ready. */
 qboolean CG_AccessibilityMarkerWayKnown(void)
 {
-	return (qboolean)(eta_marker.active && eta_route.done);
+	return (qboolean)(eta_marker.active && ( eta_route.done || ( eta_route.known && eta_route.steering ) ));
 }
 
