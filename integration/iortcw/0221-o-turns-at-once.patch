+#define ETA_ROUTE_BUDGET_MS     8       /* searching per frame, at most: the forest's 150 metres took 0.7 s; twice that
+                                           since the way keeps clear of soldiers, so twice the share */
 #define ETA_ROUTE_BUDGET_STEP   4       /* squares between looks at the clock */
 #define ETA_ROUTE_REPLAN_MS     5000    /* the world changes: look again */
