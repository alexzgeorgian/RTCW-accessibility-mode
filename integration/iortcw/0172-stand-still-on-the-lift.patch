 static void ETA_NarrateDropAhead(void)
 {
 	static char   lastDescription[64];
@@ -650,6 +652,14 @@ static void ETA_NarrateDropAhead(void)
 
 	ps = &cg.predictedPlayerState;
 
+	/* Riding a lift up, every metre was "Ledge ahead": heard as a call to
+	   move, on top of the crypt's pillar, where moving is falling off. */
+	if (ETA_OnLift())
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
 	/* Only from solid ground. In the air there is nothing to warn about
 	   that has not already happened, and the drop would be measured from
 	   wherever the player had fallen to by now. */
@@ -4763,6 +4773,32 @@ static struct
 	qboolean onBridge, offSaid;        /* standing on its bridge; "off the bridge!" said */
 } eta_lifts[ETA_MAX_LIFTS];
 static int eta_liftCount;
+
+/* Standing on a lift - the crypt's pillar. */
+static qboolean ETA_OnLift(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  l;
+
+	if (ps->groundEntityNum <= 0 || ps->groundEntityNum >= ENTITYNUM_WORLD)
+	{
+		return qfalse;
+	}
+	for (l = 0; l < eta_liftCount; l++)
+	{
+		if (cg_entities[ps->groundEntityNum].currentState.eType == ET_MOVER
+		    && cg_entities[ps->groundEntityNum].currentState.modelindex == eta_lifts[l].mover)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+qboolean CG_AccessibilityOnLift(void)
+{
+	return ETA_OnLift();
+}
