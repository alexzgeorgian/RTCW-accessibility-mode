+	   marked as seen for good: the tester found it no longer started.
+	   Given back once, and played now; Escape still skips it. */
+	if ( installed.integer < introAt ) {
+		char played[16];
+
+		played[0] = '\0';
+		trap_Cvar_VariableStringBuffer( "com_introplayed", played, sizeof( played ) );
