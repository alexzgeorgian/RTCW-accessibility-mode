+/* Where stairs come out: followed from where they start, a step at a
+   time, until the floor runs level - or a wall, where they turn. The
+   tester: stairs have no numbers, and which one leads where is not
+   known. */
+static void ETA_AreaStairsEnd(const vec3_t feature, const vec3_t lead, vec3_t out)
+{
+	static const vec3_t mins = { -12.0f, -12.0f, -6.0f };
+	static const vec3_t maxs = { 12.0f, 12.0f, 6.0f };
+	vec3_t dir, here, next, down;
+	trace_t trace;
+	int    i, level = 0;
+
+	VectorSubtract(lead, feature, dir);
+	dir[2] = 0.0f;
+	VectorCopy(lead, out);
+	if (VectorNormalize(dir) < 1.0f)
+	{
+		return;
+	}
+	VectorCopy(lead, here);
+	for (i = 0; i < 25 && level < 3; i++)
+	{
+		vec3_t from;
+
+		VectorMA(here, 32.0f, dir, next);
+		VectorCopy(here, from);
+		from[2] += 24.0f;
+		next[2]  = from[2] + 18.0f;
+		trap_CM_BoxTrace(&trace, from, next, mins, maxs, 0, MASK_PLAYERSOLID);
+		if (trace.startsolid || trace.fraction < 1.0f)
+		{
+			break;
+		}
+		VectorCopy(next, down);
+		down[2] = here[2] - 256.0f;
+		trap_CM_BoxTrace(&trace, next, down, mins, maxs, 0, MASK_PLAYERSOLID);
+		if (trace.startsolid || trace.fraction >= 1.0f)
+		{
+			break;
+		}
+		level = fabsf(trace.endpos[2] + mins[2] - here[2]) < 4.0f ? level + 1 : 0;
+		VectorCopy(trace.endpos, here);
+		here[2] += mins[2];
+		VectorCopy(here, out);
+	}
+	out[2] += 24.0f;
+}
+
+/* Stairs from where the player is: which way they go from the end the
+   player is nearer, how far, and what is at the other end - "stairs up,
+   4 meters up, to a corridor, north to south, in area 3". Both ends of a
+   flight are often in one area, so the area alone says nothing. Where O
+   leads: the near end. */
+static void ETA_AreaStairsText(int area, const vec3_t feature, const vec3_t lead, qboolean up, qboolean known,
+                               char *out, size_t size, vec3_t leadTo)
+{
+	vec3_t    end, from, to;
+	ETA_Place place;
+	char      what[96], where[48];
+	float     rise;
+	int       meters, there;
+	qboolean  fromEnd;
+
+	ETA_AreaStairsEnd(feature, lead, end);
+	fromEnd = (qboolean)( fabsf(cg.predictedPlayerState.origin[2] - end[2])
+	                      < fabsf(cg.predictedPlayerState.origin[2] - feature[2]) - 24.0f );
+	VectorCopy(fromEnd ? end : feature, from);
+	VectorCopy(fromEnd ? feature : end, to);
+	VectorCopy(fromEnd ? end : lead, leadTo);
+	rise   = to[2] - from[2];
+	meters = (int)( fabsf(rise) * ETA_QU_TO_METERS + 0.5f );
+	if (fabsf(rise) >= 24.0f)
+	{
+		up = (qboolean)( rise > 0.0f );
+	}
+	else if (fromEnd)
+	{
+		up = (qboolean)!up;
+	}
+
+	CG_AccessibilityPlace(to, &place);
+	ETA_Place_Text(&place, what, sizeof(what));
+	what[0] = (char)tolower((unsigned char)what[0]);
+	there = ETA_AreaOf(to);
+	where[0] = '\0';
+	if (there >= 0 && there != area)
+	{
+		Com_sprintf(where, sizeof(where), eta_areas.number[there] ? ", in area %d" : ", in a new area",
+		            eta_areas.number[there]);
+	}
+	Com_sprintf(out, size, "%sstairs %s%s%s%s%s%s", known ? "" : "new ", up ? "up" : "down",
+	            meters >= 1 ? va(", %d %s %s", meters, meters == 1 ? "meter" : "meters", up ? "up" : "down") : "",
+	            what[0] ? ", to " : "",
+	            !what[0] || !Q_stricmpn(what, "open", 4) || !Q_stricmpn(what, "indoors", 7) ? ""
+	            : !Q_stricmpn(what, "alley", 5) ? "an " : "a ",
+	            what, where);
+}
