+/*
+ * The places outdoors with things come across, kept with what is
+ * explored (see CG_AccessibilityAreasBack): what the things list knows is
+ * only what has been seen since the level was last started, and the
+ * tester, playing on from a save, found the Colt's drop gone from
+ * semicolon's list. Each kept with its name and how many things were left
+ * there when last saved; one seen again since stands in for its keeping.
+ */
+#define ETA_OUTDOOR_KEPT 16
+
+static struct
+{
+	vec3_t at;
+	char   what[48];
+	int    left;
+} eta_outdoorKept[ETA_OUTDOOR_KEPT];
+static int eta_outdoorKeptCount;
+
+/* The places outdoors as now known, then those kept from before that are
+   not among them. */
+static int ETA_OutdoorPlaces(vec3_t *at, char (*what)[48], int *left, int max)
+{
+	int n = CG_AccessibilityThingsOutdoors(at, what, left, max), i, j;
+
+	for (i = 0; i < eta_outdoorKeptCount && n < max; i++)
+	{
+		for (j = 0; j < n; j++)
+		{
+			if (Distance(at[j], eta_outdoorKept[i].at) < 600.0f)
+			{
+				break;
+			}
+		}
+		if (j < n)
+		{
+			continue;
+		}
+		VectorCopy(eta_outdoorKept[i].at, at[n]);
+		Q_strncpyz(what[n], eta_outdoorKept[i].what, sizeof(what[0]));
+		left[n++] = eta_outdoorKept[i].left;
+	}
+	return n;
+}
+
