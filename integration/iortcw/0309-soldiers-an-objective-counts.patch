+/*
+ * Whether a script event leads on to the one that meets an objective,
+ * through a few "trigger" lines, and whether a count is waited for on
+ * the way - "accum 0 abort_if_less_than 6": soldiers beaten.
+ */
+static qboolean ETA_EventMeets(const char *owner, const char *event, int objective, int depth, qboolean *counted)
+{
+	int i;
+
+	for (i = 0; i < eta_unlockLineCount; i++)
+	{
+		const eta_unlockLine_t *l = &eta_unlockLines[i];
+
+		if (Q_stricmp(l->owner, owner) || Q_stricmp(l->event, event))
+		{
+			continue;
+		}
+		if (( l->verb == 'o' && atoi(l->what) == objective )
+		    || ( l->verb == 't' && depth < 4 && ETA_EventMeets(l->what, l->whatEvent, objective, depth + 1, counted) ))
+		{
+			if (l->need > 0)
+			{
+				*counted = qtrue;
+			}
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/*
+ * Whether a soldier, by the script's name for them, is one an objective
+ * counts beaten: their death goes on to the line that meets it, with a
+ * count waited for on the way. Kugelstadt's first objective is six
+ * soldiers beaten, its third nine, the flamethrower man among them; O
+ * led past them all toward the tank's next stop, and the tester could
+ * not find the flamethrower man to fight.
+ */
+qboolean CG_AccessibilityObjectiveCounts(int objective, const char *ainame)
+{
+	qboolean counted = qfalse;
+
+	return (qboolean)( objective > 0 && ainame && ainame[0] && ETA_EventMeets(ainame, "death", objective, 0, &counted)
+	                   && counted );
+}
+
+/* Whether an objective is met by soldiers beaten, any of them. */
+qboolean CG_AccessibilityObjectiveByCount(int objective)
+{
+	int i;
+
+	for (i = 0; objective > 0 && i < eta_unlockLineCount; i++)
+	{
+		if (eta_unlockLines[i].verb == 't' && !Q_stricmp(eta_unlockLines[i].event, "death")
+		    && CG_AccessibilityObjectiveCounts(objective, eta_unlockLines[i].owner))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
