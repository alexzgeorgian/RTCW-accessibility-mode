+/*
+ * The nearest enemy alive that an objective not met yet counts beaten,
+ * from the server's list of the living, which names each as the script
+ * does: where, what, the objective, and how many it counts are still
+ * alive. Three of Kugelstadt's objectives are soldiers beaten - one
+ * with the flamethrower man among them - and O led past them toward
+ * the tank's next stop, the tester never finding him to fight.
+ */
+qboolean CG_AccessibilityCountedEnemy(vec3_t at, int *aichar, int *objective, int *alive)
+{
+	const char          *list = CG_ConfigString(CS_ETA_ENEMIES);
+	const playerState_t *ps   = &cg.predictedPlayerState;
+	float               best  = 1.0e9f;
+	int                 o;
+
+	*aichar    = 0;
+	*objective = 0;
+	*alive     = 0;
+	/* The first such objective in the notebook's order that has anyone
+	   left alive; the others wait for their soldiers to come in. */
+	for (o = 1; o <= 8 && CG_AccessibilityObjectiveText(o)[0] && !*aichar; o++)
+	{
+		const char *each = list;
+
+		if (CG_AccessibilityObjectiveDone(o) || !CG_AccessibilityObjectiveByCount(o))
+		{
+			continue;
+		}
+		while (each && *each)
+		{
+			int    c;
+			vec3_t there;
+			char   name[32];
+
+			if (sscanf(each, "%d %f %f %f %31[^;]", &c, &there[0], &there[1], &there[2], name) == 5
+			    && CG_AccessibilityObjectiveCounts(o, name))
+			{
+				( *alive )++;
+				if (Distance(there, ps->origin) < best)
+				{
+					best       = Distance(there, ps->origin);
+					*aichar    = c;
+					*objective = o;
+					VectorCopy(there, at);
+				}
+			}
+			each = strchr(each, ';');
+			if (each)
+			{
+				each++;
+			}
+		}
+	}
+	return *aichar != 0;
+}
