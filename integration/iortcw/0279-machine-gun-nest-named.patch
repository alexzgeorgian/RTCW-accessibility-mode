diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 76e986e6..44613bc7 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -5971,6 +5971,25 @@ static int eta_weakRailCount;
 static vec3_t eta_post[ETA_POSTS];
 static int    eta_postCount;
 
+/* The level's mounted guns (misc_mg42), where they stand: a place with
+   one is named by it - the tester knew the forest's "machine gun nest",
+   but semicolon called it "the grassy open ground with a ladder up". */
+#define ETA_MOUNTED_GUNS 32
+
+static vec3_t eta_mountedGun[ETA_MOUNTED_GUNS];
+static int    eta_mountedGunCount;
+
+int CG_AccessibilityMountedGuns(vec3_t *out, int max)
+{
+	int i;
+
+	for (i = 0; i < eta_mountedGunCount && i < max; i++)
+	{
+		VectorCopy(eta_mountedGun[i], out[i]);
+	}
+	return i;
+}
+
 qboolean CG_AccessibilityPostNear(const vec3_t at, float across, float up)
 {
 	int i;
@@ -6104,6 +6123,7 @@ static void ETA_ReadMapEntities(void)
 	eta_modelPropCount  = 0;
 	eta_weakRailCount   = 0;
 	eta_postCount       = 0;
+	eta_mountedGunCount = 0;
 	eta_rideCount       = 0;
 	eta_tramCornerCount = 0;
 	eta_tramStationCount = -1;
@@ -6188,6 +6208,13 @@ static void ETA_ReadMapEntities(void)
 			eta_postCount++;
 		}
 
+		if (!Q_stricmp(classname, "misc_mg42") && origin[0] && eta_mountedGunCount < ETA_MOUNTED_GUNS
+		    && sscanf(origin, "%f %f %f", &eta_mountedGun[eta_mountedGunCount][0], &eta_mountedGun[eta_mountedGunCount][1],
+		              &eta_mountedGun[eta_mountedGunCount][2]) == 3)
+		{
+			eta_mountedGunCount++;
+		}
+
 		if (!Q_stricmp(classname, "trigger_deathCheck") && model[0] == '*' && eta_weakRailCount < ETA_WEAK_RAILS)
 		{
 			eta_weakRail[eta_weakRailCount++] = atoi(model + 1);
