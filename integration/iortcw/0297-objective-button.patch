+++ b/SP/code/cgame/cg_accessibility_unlock.c
@@ -940,6 +940,23 @@ qboolean CG_AccessibilityObjectiveInOrder(const vec3_t from, vec3_t out, int *ob
  * player event that alerts him, and the trigger that fires that event.
  * Where the trigger is; qfalse with none.
  */
+/* The objective a player script event meets, by "objectivemet N" in
+   it: 0 for none. */
+int CG_AccessibilityObjectiveOfEvent(const char *event)
+{
+	int i;
+
+	for (i = 0; event && event[0] && i < eta_unlockLineCount; i++)
+	{
+		if (eta_unlockLines[i].verb == 'o' && !Q_stricmp(eta_unlockLines[i].owner, "player")
+		    && !Q_stricmp(eta_unlockLines[i].event, event))
+		{
+			return atoi(eta_unlockLines[i].what);
+		}
+	}
+	return 0;
+}
