@@ -4897,9 +4897,26 @@ typedef struct
 {
 	int  model;
 	char name[32];
+	char target[48];   /* the script event it fires */
 } eta_user_t;
 static eta_user_t eta_users[ETA_MAX_USERS];
 
+/* A switch's name, as said: one that meets an objective by which - the
+   rocket base's launch abort button was "Button", and the tester asked
+   whether it was on T's list at all. The script is read after the
+   switches are named, so asked here, as it is said. */
+static const char *ETA_UserName(int i)
+{
+	int objective;
+
+	if (( !Q_stricmp(eta_users[i].name, "Button") || !Q_stricmp(eta_users[i].name, "Switch") )
+	    && ( objective = CG_AccessibilityObjectiveOfEvent(eta_users[i].target) ) > 0)
+	{
+		return va("Button, objective %d", objective);
+	}
+	return eta_users[i].name;
+}
