+/* The tram's stations: the two ends of its way, and a corner with a
+   button by it between them. Named by height: upper, middle, lower. The
+   tester, at the middle station, could not tell where they were from
+   the area's number alone. */
+#define ETA_MAX_TRAM_STATIONS 4
+static vec3_t eta_tramStations[ETA_MAX_TRAM_STATIONS];
+static int    eta_tramStationCount = -1;
+
+static void ETA_TramStationAdd(const vec3_t at)
+{
+	int i;
+
+	for (i = 0; i < eta_tramStationCount; i++)
+	{
+		if (Distance(eta_tramStations[i], at) < 512.0f)
+		{
+			return;
+		}
+	}
+	if (eta_tramStationCount < ETA_MAX_TRAM_STATIONS)
+	{
+		VectorCopy(at, eta_tramStations[eta_tramStationCount]);
+		eta_tramStationCount++;
+	}
+}
+
+qboolean CG_AccessibilityTramButtonNear(const vec3_t point, float range);
+
+static void ETA_TramStationsMake(void)
+{
+	int   i, j, a = -1, b = -1;
+	float far = 0.0f;
+
+	eta_tramStationCount = 0;
+	if (eta_tramCornerCount < 2)
+	{
+		return;
+	}
+	for (i = 0; i < eta_tramCornerCount; i++)
+	{
+		for (j = i + 1; j < eta_tramCornerCount; j++)
+		{
+			if (Distance(eta_tramCorners[i], eta_tramCorners[j]) > far)
+			{
+				far = Distance(eta_tramCorners[i], eta_tramCorners[j]);
+				a   = i;
+				b   = j;
+			}
+		}
+	}
+	ETA_TramStationAdd(eta_tramCorners[a]);
+	ETA_TramStationAdd(eta_tramCorners[b]);
+	for (i = 0; i < eta_tramCornerCount; i++)
+	{
+		if (CG_AccessibilityTramButtonNear(eta_tramCorners[i], 400.0f))
+		{
+			ETA_TramStationAdd(eta_tramCorners[i]);
+		}
+	}
+}
+
+/* ", by the middle tram station", or nothing: where the player is. */
+void CG_AccessibilityTramStationText(const vec3_t at, char *out, size_t size)
+{
+	int i, best = -1, above, below;
+
+	out[0] = '\0';
+	if (eta_tramStationCount < 0)
+	{
+		ETA_TramStationsMake();
+	}
+	for (i = 0; i < eta_tramStationCount; i++)
+	{
+		/* The corners are the tram's own origin, over its roof. */
+		float dx = at[0] - eta_tramStations[i][0], dy = at[1] - eta_tramStations[i][1];
+		float dz = at[2] - ( eta_tramStations[i][2] - 360.0f );
+
+		if (dx * dx + dy * dy < 768.0f * 768.0f && dz > -320.0f && dz < 320.0f)
+		{
+			best = i;
+			break;
+		}
+	}
+	if (best < 0)
+	{
+		return;
+	}
+	for (i = above = below = 0; i < eta_tramStationCount; i++)
+	{
+		above += eta_tramStations[i][2] > eta_tramStations[best][2] + 64.0f;
+		below += eta_tramStations[i][2] < eta_tramStations[best][2] - 64.0f;
+	}
+	Com_sprintf(out, size, ", by the %stram station",
+	            eta_tramStationCount == 1 ? "" : !above ? "upper " : !below ? "lower " : "middle ");
+}
