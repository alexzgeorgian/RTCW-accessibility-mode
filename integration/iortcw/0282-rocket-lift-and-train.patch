+const char *CG_AccessibilityRideThingName(void)
+{
+	return eta_rideCount && ETA_RideNear() >= 0 && eta_rides[ETA_RideNear()].train ? "Train, jump onto it" : "Tram, walk in";
+}
+
+const char *CG_AccessibilityRideAction(void)
+{
+	return eta_rideCount && ETA_RideNear() >= 0 && eta_rides[ETA_RideNear()].train
+	       ? "Pull its lever first: it leaves 2 seconds later. Then jump onto it, and stay on"
+	       : "Walk in, and stay inside";
+}
+
+/*
+ * The train's lever pulled: it leaves two seconds later, and the lever is
+ * four metres from it. The tester pulled it, and it left without them;
+ * its top is a little higher than a step, and they could not get up. Said
+ * at once, with where it is, and turned toward it.
+ */
+void CG_AccessibilityRideBoardNow(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t               mins, maxs, at;
+	qboolean             moving;
+	int                  i = ETA_RideNear(), meters;
+
+	if (i < 0 || !eta_rides[i].train || !ETA_RideBox(i, mins, maxs, &moving) || ETA_RideCarries(i, mins, maxs, ps->origin))
+	{
+		return;
+	}
+	at[0]  = ps->origin[0] < mins[0] ? mins[0] + 16.0f : ps->origin[0] > maxs[0] ? maxs[0] - 16.0f : ps->origin[0];
+	at[1]  = ps->origin[1] < mins[1] ? mins[1] + 16.0f : ps->origin[1] > maxs[1] ? maxs[1] - 16.0f : ps->origin[1];
+	at[2]  = maxs[2] + 24.0f;
+	meters = (int)( Distance(at, ps->origin) * ETA_QU_TO_METERS + 0.5f );
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(va("The train leaves in 2 seconds. Turning you to it: walk %d %s and jump onto it", meters < 1 ? 1 : meters,
+	                  meters == 1 ? "meter" : "meters"));
+	CG_AccessibilityFacePoint(at);
+}
