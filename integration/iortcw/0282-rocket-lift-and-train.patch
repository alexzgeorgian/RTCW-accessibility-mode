 /* Its coming and going, as it changes. */
+/* For T: the ride near, by its name, and what to do. */
+static int ETA_RideNear(void)
+{
+	vec3_t   mins, maxs;
+	qboolean moving;
+	int      i, best = -1;
+	float    bestFar = 0.0f;
+
+	for (i = 0; i < eta_rideCount; i++)
+	{
+		vec3_t mid;
+
+		if (!ETA_RideBox(i, mins, maxs, &moving))
+		{
+			continue;
+		}
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		if (best < 0 || Distance(mid, cg.predictedPlayerState.origin) < bestFar)
+		{
+			best    = i;
+			bestFar = Distance(mid, cg.predictedPlayerState.origin);
+		}
+	}
+	return best;
+}
