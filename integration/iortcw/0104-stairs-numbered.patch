diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index 424e83d2..e8e8aca0 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -2689,6 +2689,54 @@ int CG_AccessibilityOnStairs(void)
 	return cg.time < eta_stairKeep.until ? eta_stairKeep.sense : 0;
 }
 
+/* A flight of stairs walked to its end: said, with its number, and the
+   stairs marked as used. The tester did not know which stairs had been
+   climbed up or down, or whether a flight was done. */
+static struct
+{
+	qboolean on;
+	vec3_t   from;
+	int      lastAt;
+} eta_flight;
+
+static void ETA_StairsDoneFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		eta_flight.on = qfalse;
+		return;
+	}
+	if (CG_AccessibilityOnStairs())
+	{
+		if (!eta_flight.on)
+		{
+			eta_flight.on = qtrue;
+			VectorCopy(ps->origin, eta_flight.from);
+		}
+		eta_flight.lastAt = cg.time;
+		return;
+	}
+	if (eta_flight.on && ps->groundEntityNum != ENTITYNUM_NONE
+	    && ( cg.time - eta_flight.lastAt > 700 || cg.time < eta_flight.lastAt ))
+	{
+		float rise = ps->origin[2] - eta_flight.from[2];
+
+		eta_flight.on = qfalse;
+		if (fabsf(rise) >= 64.0f)
+		{
+			int number = CG_AccessibilityStairsWalked(eta_flight.from, ps->origin);
+			int meters = (int)( fabsf(rise) * ETA_QU_TO_METERS + 0.5f );
+
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(va("%s of %s%s, %d %s %s", rise > 0.0f ? "Top" : "Bottom", number ? "stairs " : "the stairs",
+			                  number ? va("%d", number) : "", meters, meters == 1 ? "meter" : "meters",
+			                  rise > 0.0f ? "up" : "down"));
+		}
+	}
+}
+
