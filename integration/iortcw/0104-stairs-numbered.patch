 			if (!eta_guide.active)
 			{
 				ETA_StairsKeepFrame();
+				ETA_StairsDoneFrame();
 			}
 			else
 			{
diff --git a/SP/code/cgame/cg_accessibility_ways.c b/SP/code/cgame/cg_accessibility_ways.c
index bb20c828..8802671d 100644
--- a/SP/code/cgame/cg_accessibility_ways.c
+++ b/SP/code/cgame/cg_accessibility_ways.c
@@ -1588,6 +1588,62 @@ qboolean CG_AccessibilityNewWayNearest(vec3_t lead, char *name, size_t nameSize,
 	return qtrue;
 }
 
+/* Stairs by number: the stairs among the ways found, in the order found,
+   from 1 - the same each time the level is played, as the ways found are
+   kept with the areas explored. The tester: stairs have no numbers, and
+   which ones were climbed up or down is not known. */
+int CG_AccessibilityStairsNumber(int index)
+{
+	int i, n = 0;
+
+	if (index < 0 || index >= eta_frontier.count)
+	{
+		return 0;
+	}
+	for (i = 0; i <= index; i++)
+	{
+		n += eta_frontier.ways[i].kind == ETA_WAY_STAIRS_UP || eta_frontier.ways[i].kind == ETA_WAY_STAIRS_DOWN;
+	}
+	return ( eta_frontier.ways[index].kind == ETA_WAY_STAIRS_UP || eta_frontier.ways[index].kind == ETA_WAY_STAIRS_DOWN )
+	       ? n : 0;
+}
+
+/* The stairs found nearest a flight just walked, from where it began to
+   where it ended: its number, and marked as used. 0 for none known. */
+int CG_AccessibilityStairsWalked(const vec3_t from, const vec3_t to)
+{
+	int   i, best = -1;
+	float bestFar = 256.0f;
+
+	for (i = 0; i < eta_frontier.count; i++)
+	{
+		eta_frontier_t *way = &eta_frontier.ways[i];
+		float          far;
+
+		if (way->kind != ETA_WAY_STAIRS_UP && way->kind != ETA_WAY_STAIRS_DOWN)
+		{
+			continue;
+		}
+		far = MIN(MIN(Distance(way->feature, from), Distance(way->feature, to)),
+		          MIN(Distance(way->lead, from), Distance(way->lead, to)));
+		if (far < bestFar)
+		{
+			bestFar = far;
+			best    = i;
+		}
+	}
+	if (best < 0)
+	{
+		return 0;
+	}
+	if (!eta_frontier.ways[best].tried)
+	{
+		eta_frontier.ways[best].tried = qtrue;
+		CG_AccessibilityExploredChanged();
+	}
+	return CG_AccessibilityStairsNumber(best);
+}
+
 /* The ways found, tried or not, kept with the areas explored so that a
    save loaded or a death does not make them new again
    (cg_accessibility_areas.c). */
