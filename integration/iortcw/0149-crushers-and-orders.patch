+/*
+ * Crushers. In the second catacomb level a button at the end of a
+ * corridor sets two walls sliding in from either side, over where the
+ * player stands to press it: the tester pressed it and was crushed, and
+ * nothing had said so. What a switch sets going is in the level's own
+ * scripts - the switch fires a script trigger, whose lines in the
+ * player's AI script set script movers going, whose own script sends
+ * them to path corners - so it is read from them: a switch whose movers
+ * end up over the place it is pressed from is a crusher, and said so
+ * before it is pressed. And while any mover closes on the player, the
+ * way out of its path is said at once.
+ */
+#define ETA_MAX_SCRIPT_TRIGGERS 128
+#define ETA_MAX_SCRIPT_MOVERS   256
+#define ETA_MAX_CORNERS         512
+static struct
+{
+	char targetname[48];
+	char event[48];
+} eta_scriptTriggers[ETA_MAX_SCRIPT_TRIGGERS];
+static int eta_scriptTriggerCount;
+static struct
+{
+	char   scriptname[48];
+	int    model;
+	vec3_t origin;    /* where the map puts it */
+} eta_scriptMovers[ETA_MAX_SCRIPT_MOVERS];
+static int eta_scriptMoverCount;
+static struct
+{
+	char   targetname[48];
+	vec3_t at;
+} eta_corners[ETA_MAX_CORNERS];
+static int      eta_cornerCount;
+static qboolean eta_crushSwitch[MAX_MODELS];
+/*
+ * Switches pressed in an order. In the same level three hidden buttons,
+ * pressed south, east, west, open two hidden doors upstairs; in any
+ * other order, not. The order is in the scripts too: each switch's event
+ * sets off one event of a counting entity, which goes on only when its
+ * count stands at that switch's place ("accum 0 abort_if_not_equal 1",
+ * then "accum 0 inc 1"). A count the switches only add to, in any order -
+ * the pillar's - gives every switch the same place, and is no order.
+ */
+#define ETA_MAX_ORDERED 16
+static struct
+{
+	int  model;
+	char counter[48];   /* the counting entity */
+	int  place;         /* 0 first */
+	char alerts[48];    /* what the event sets off, when it sets something */
+} eta_ordered[ETA_MAX_ORDERED];
+static int eta_orderedCount;
+static int eta_switchPlace[MAX_MODELS];        /* 1 first; 0 none */
+static int eta_switchPlaces[MAX_MODELS];       /* of how many */
+static qboolean eta_switchOpensHidden[MAX_MODELS];   /* the last sets off hidden doors */
+static int eta_switchNoticeAt[MAX_MODELS];
+#define ETA_CRUSH_WARNING ": walls close on you. Press, then run back"
+
+/* The level's script file, its name the map's with ext for .bsp: NULL
+   when there is none, or it is too long for buf. */
+static char *ETA_ReadMapScript(const char *ext, char *buf, int size)
+{
+	fileHandle_t f;
+	char         name[MAX_QPATH];
+	int          length;
+
+	COM_StripExtension(cgs.mapname, name, sizeof(name));
+	Q_strcat(name, sizeof(name), ext);
+	length = trap_FS_FOpenFile(name, &f, FS_READ);
+	if (length <= 0 || !f)
+	{
+		return NULL;
+	}
+	if (length >= size)
+	{
+		trap_FS_FCloseFile(f);
+		return NULL;
+	}
+	trap_FS_Read(buf, length, f);
+	buf[length] = '\0';
+	trap_FS_FCloseFile(f);
+	return buf;
+}
+
+/*
+ * In a script: the words of the block "trigger <event>" of <owner>'s,
+ * found two deep (owner { ... trigger event { here } }), handed to
+ * found() one line's first four words at a time. A brace is counted by
+ * a word's first letter: one of the levels has "{7".
+ */
+typedef void (*eta_scriptLine_t)(const char *a, const char *b, const char *c, const char *d, void *context);
+
+static void ETA_ScriptEvent(char *text, const char *owner, const char *event, eta_scriptLine_t found, void *context)
+{
+	char       *p = text;
+	char        top[64] = "", words[4][64];
+	int         depth = 0, inEvent = 0, n = 0, lastLine = 0;
+	char       *token;
+
+	COM_BeginParseSession("accessibility");
+	while (( token = COM_ParseExt(&p, qtrue) ) != NULL && token[0])
+	{
+		if (token[0] == '{')
+		{
+			depth++;
+			if (depth == 2 && n == 2 && !Q_stricmp(words[0], "trigger") && !Q_stricmp(words[1], event)
+			    && !Q_stricmp(top, owner))
+			{
+				inEvent = 2;
+			}
+			n = 0;
+			continue;
+		}
+		if (token[0] == '}')
+		{
+			if (inEvent && depth == inEvent && n)
+			{
+				found(words[0], n > 1 ? words[1] : "", n > 2 ? words[2] : "", n > 3 ? words[3] : "", context);
+			}
+			if (depth == inEvent)
+			{
+				inEvent = 0;
+			}
+			depth = MAX(0, depth - 1);
+			n = 0;
+			continue;
+		}
+		if (depth == 0)
+		{
+			Q_strncpyz(top, token, sizeof(top));
+			continue;
+		}
+		/* A new line: the last one's words are done. */
+		if (n && COM_GetCurrentParseLine() != lastLine)
+		{
+			if (inEvent && depth == inEvent)
+			{
+				found(words[0], n > 1 ? words[1] : "", n > 2 ? words[2] : "", n > 3 ? words[3] : "", context);
+			}
+			n = 0;
+		}
+		lastLine = COM_GetCurrentParseLine();
+		if (n < 4)
+		{
+			Q_strncpyz(words[n], token, sizeof(words[0]));
+		}
+		n++;
+	}
+}
+
+typedef struct
+{
+	int    switchModel;
+	char   movers[8][2][48];   /* mover, its event */
+	int    moverCount;
+	char  *script;
+	vec3_t moverMins, moverMaxs;
+	vec3_t zoneMins, zoneMaxs;   /* where the switch is pressed from */
+	qboolean crush;
+} eta_crushSearch_t;
+
+/* Whether a mover at at overlaps the place a switch is pressed from. */
+static qboolean ETA_CrushOver(const eta_crushSearch_t *search, const vec3_t at)
+{
+	int k;
+
+	for (k = 0; k < 3; k++)
+	{
+		if (at[k] + search->moverMaxs[k] <= search->zoneMins[k] || at[k] + search->moverMins[k] >= search->zoneMaxs[k])
+		{
+			return qfalse;
+		}
+	}
+	return qtrue;
+}
+
+static void ETA_CrushMoverLine(const char *a, const char *b, const char *c, const char *d, void *context)
+{
+	eta_crushSearch_t *search = (eta_crushSearch_t *)context;
+	int                i;
+
+	(void)c;
+	(void)d;
+	if (Q_stricmp(a, "gotomarker") || !b[0])
+	{
+		return;
+	}
+	for (i = 0; i < eta_cornerCount && Q_stricmp(eta_corners[i].targetname, b); i++)
+	{
+	}
+	if (i < eta_cornerCount && ETA_CrushOver(search, eta_corners[i].at))
+	{
+		search->crush = qtrue;
+	}
+}
+
+static void ETA_CrushAiLine(const char *a, const char *b, const char *c, const char *d, void *context)
+{
+	eta_crushSearch_t *search = (eta_crushSearch_t *)context;
+
+	(void)d;
+	if (!Q_stricmp(a, "trigger") && b[0] && c[0] && search->moverCount < (int)ARRAY_LEN(search->movers))
+	{
+		Q_strncpyz(search->movers[search->moverCount][0], b, sizeof(search->movers[0][0]));
+		Q_strncpyz(search->movers[search->moverCount][1], c, sizeof(search->movers[0][1]));
+		search->moverCount++;
+	}
+}
+
+/* Whether what a switch is aimed at - a script trigger named name - sets
+   going a mover that ends over where the switch is pressed from. */
+/* The level's AI and mover scripts, read once a level: qfalse without
+   both. */
+static char eta_aiText[160 * 1024], eta_scriptText[160 * 1024];
+
+static qboolean ETA_MapScripts(void)
+{
+	static char     readFor[MAX_QPATH];
+	static qboolean have;
+
+	if (Q_stricmp(readFor, cgs.mapname))
+	{
+		Q_strncpyz(readFor, cgs.mapname, sizeof(readFor));
+		have = (qboolean)( ETA_ReadMapScript(".ai", eta_aiText, sizeof(eta_aiText)) != NULL
+		                   && ETA_ReadMapScript(".script", eta_scriptText, sizeof(eta_scriptText)) != NULL );
+	}
+	return have;
+}
+
+/* The player's script event a switch's target fires: NULL if none. */
+static const char *ETA_SwitchEvent(const char *name)
+{
+	int i;
+
+	for (i = 0; i < eta_scriptTriggerCount; i++)
+	{
+		if (!Q_stricmp(eta_scriptTriggers[i].targetname, name))
+		{
+			return eta_scriptTriggers[i].event;
+		}
+	}
+	return NULL;
+}
+
+static qboolean ETA_CrushFrom(const char *name, int switchModel)
+{
+	char             *ai = eta_aiText, *script = eta_scriptText;
+	const char       *event = ETA_SwitchEvent(name);
+	eta_crushSearch_t search;
+	int               j, m;
+
+	if (!event || !ETA_MapScripts())
+	{
+		return qfalse;
+	}
+	memset(&search, 0, sizeof(search));
+	search.switchModel = switchModel;
+	if (switchModel <= 0 || switchModel >= MAX_MODELS || !cgs.inlineDrawModel[switchModel])
+	{
+		return qfalse;
+	}
+	/* Where it is pressed from: in front of it, a body's reach. */
+	trap_R_ModelBounds(cgs.inlineDrawModel[switchModel], search.zoneMins, search.zoneMaxs);
+	for (j = 0; j < 2; j++)
+	{
+		search.zoneMins[j] -= 64.0f;
+		search.zoneMaxs[j] += 64.0f;
+	}
+	search.zoneMins[2] -= 48.0f;
+	search.zoneMaxs[2] += 16.0f;
+	/* Parsing writes nothing to the text, so it is read again each time. */
+	ETA_ScriptEvent(ai, "player", event, ETA_CrushAiLine, &search);
+	for (j = 0; j < search.moverCount && !search.crush; j++)
+	{
+		for (m = 0; m < eta_scriptMoverCount && Q_stricmp(eta_scriptMovers[m].scriptname, search.movers[j][0]); m++)
+		{
+		}
+		if (m == eta_scriptMoverCount || eta_scriptMovers[m].model <= 0 || eta_scriptMovers[m].model >= MAX_MODELS
+		    || !cgs.inlineDrawModel[eta_scriptMovers[m].model])
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[eta_scriptMovers[m].model], search.moverMins, search.moverMaxs);
+		/* Not the switch's own moving part, nor a table tipped over
+		   where it stands: something as tall as a body, that comes from
+		   somewhere clear of the place. */
+		if (search.moverMaxs[2] - search.moverMins[2] < 48.0f || ETA_CrushOver(&search, eta_scriptMovers[m].origin))
+		{
+			continue;
+		}
+		ETA_ScriptEvent(script, search.movers[j][0], search.movers[j][1], ETA_CrushMoverLine, &search);
+	}
+	return search.crush;
+}
+
+typedef struct
+{
+	char pairs[8][2][48];    /* entity, its event, from the player's script */
+	int  pairCount;
+	int  place;              /* -1 none */
+	int  added;              /* "inc" seen after the check */
+	char alerts[48];
+} eta_orderSearch_t;
+
+static void ETA_OrderAiLine(const char *a, const char *b, const char *c, const char *d, void *context)
+{
+	eta_orderSearch_t *search = (eta_orderSearch_t *)context;
+
+	(void)d;
+	if (!Q_stricmp(a, "trigger") && b[0] && c[0] && search->pairCount < (int)ARRAY_LEN(search->pairs))
+	{
+		Q_strncpyz(search->pairs[search->pairCount][0], b, sizeof(search->pairs[0][0]));
+		Q_strncpyz(search->pairs[search->pairCount][1], c, sizeof(search->pairs[0][1]));
+		search->pairCount++;
+	}
+}
+
+static void ETA_OrderScriptLine(const char *a, const char *b, const char *c, const char *d, void *context)
+{
+	eta_orderSearch_t *search = (eta_orderSearch_t *)context;
+
+	(void)b;
+	if (!Q_stricmp(a, "accum") && !Q_stricmp(c, "abort_if_not_equal") && d[0] && search->place < 0 && !search->added)
+	{
+		search->place = atoi(d);
+	}
+	else if (!Q_stricmp(a, "accum") && !Q_stricmp(c, "inc"))
+	{
+		search->added = 1;
+	}
+	else if (!Q_stricmp(a, "alertentity") && b[0] && !search->alerts[0])
+	{
+		Q_strncpyz(search->alerts, b, sizeof(search->alerts));
+	}
+}
+
+/* The places a switch's event holds in counted orders: added to
+   eta_ordered. */
+static void ETA_OrderFrom(const char *name, int switchModel)
+{
+	const char       *event = ETA_SwitchEvent(name);
+	eta_orderSearch_t search;
+	int               j;
+
+	if (!event || !ETA_MapScripts())
+	{
+		return;
+	}
+	memset(&search, 0, sizeof(search));
+	ETA_ScriptEvent(eta_aiText, "player", event, ETA_OrderAiLine, &search);
+	for (j = 0; j < search.pairCount && eta_orderedCount < ETA_MAX_ORDERED; j++)
+	{
+		eta_orderSearch_t one;
+
+		memset(&one, 0, sizeof(one));
+		one.place = -1;
+		ETA_ScriptEvent(eta_scriptText, search.pairs[j][0], search.pairs[j][1], ETA_OrderScriptLine, &one);
+		if (one.place < 0)
+		{
+			continue;
+		}
+		eta_ordered[eta_orderedCount].model = switchModel;
+		eta_ordered[eta_orderedCount].place = one.place;
+		Q_strncpyz(eta_ordered[eta_orderedCount].counter, search.pairs[j][0], sizeof(eta_ordered[0].counter));
+		Q_strncpyz(eta_ordered[eta_orderedCount].alerts, one.alerts, sizeof(eta_ordered[0].alerts));
+		eta_orderedCount++;
+	}
+}
