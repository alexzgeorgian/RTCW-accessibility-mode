+			continue;
+		}
+		for (j = 0; j < linkCount; j++)
+		{
+			if (links[j].kind == 'u' && !Q_stricmp(links[j].target, links[i].targetname)
+			    && links[j].model > 0 && links[j].model < MAX_MODELS)
+			{
