+/*
+ * A mover closing on the player: a wall or block sliding to where they
+ * stand, set going by a switch or by the level. Said the moment it
+ * starts, with the shortest way out of its path - "Walls closing! Run
+ * behind, 5 meters" - once for each move. Not what the player rides,
+ * and not the traps, said as they are.
+ */
+#define ETA_CRUSH_MAX_RUN 384.0f
+
+static int eta_crushSaidFor[MAX_GENTITIES];
+static int eta_crushUrgentUntil;
+#define ETA_CRUSH_URGENT_MS 2500   /* the warning heard out: nothing else said */
+
+static void ETA_CrushFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t               ends[16][2];
+	int                  endCount = 0, n, k, key = 0, said = -1;
+	qboolean             closing = qfalse;
+	vec3_t               body[2];
+
+	ETA_Speech_HoldForUrgent(cg.time < eta_crushUrgentUntil && cg.time + ETA_CRUSH_URGENT_MS >= eta_crushUrgentUntil
+	                         && ps->pm_type == PM_NORMAL);
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode || cg.time - cgs.levelStartTime < 3000)
+	{
+		return;
+	}
+	VectorSet(body[0], ps->origin[0] - 16.0f, ps->origin[1] - 16.0f, ps->origin[2] - 16.0f);
+	VectorSet(body[1], ps->origin[0] + 16.0f, ps->origin[1] + 16.0f, ps->origin[2] + 32.0f);
+
+	for (n = 0; n < cg.snap->numEntities && endCount < (int)ARRAY_LEN(ends); n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		vec3_t               end, mins, maxs;
+		qboolean             trap = qfalse, over = qtrue, doorOpens;
+		int                  t;
+
+		if (es->eType != ET_MOVER || es->solid != SOLID_BMODEL
+		    || ( es->pos.trType != TR_LINEAR_STOP && es->pos.trType != TR_ACCELERATE && es->pos.trType != TR_DECCELERATE )
+		    || cg.time > es->pos.trTime + es->pos.trDuration || es->modelindex <= 0 || es->modelindex >= MAX_MODELS
+		    || !cgs.inlineDrawModel[es->modelindex] || es->number == ps->groundEntityNum)
+		{
+			continue;
+		}
+		for (t = 0; t < eta_trapMoverCount && !trap; t++)
+		{
+			trap = (qboolean)( eta_trapMovers[t].model == es->modelindex );
+		}
+		/* A door closing on someone in its way stops and opens again. */
+		if (trap || CG_AccessibilityDoorModel(es->modelindex, &doorOpens))
+		{
+			continue;
+		}
+		BG_EvaluateTrajectory(&es->pos, es->pos.trTime + es->pos.trDuration, end);
+		trap_R_ModelBounds(cgs.inlineDrawModel[es->modelindex], mins, maxs);
+		VectorAdd(end, mins, ends[endCount][0]);
+		VectorAdd(end, maxs, ends[endCount][1]);
+		for (k = 0; k < 3; k++)
+		{
+			over = (qboolean)( over && ends[endCount][1][k] > body[0][k] && ends[endCount][0][k] < body[1][k] );
+		}
+		if (over && eta_crushSaidFor[es->number] != es->pos.trTime)
+		{
+			closing = qtrue;
+			key     = es->pos.trTime;
+			said    = es->number;
+		}
+		endCount++;
+	}
+	if (!closing)
+	{
+		return;
+	}
+
+	/* Every mover closing on them now has the same start: said once. */
+	for (n = 0; n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+
+		if (es->eType == ET_MOVER && es->pos.trTime == key)
+		{
+			eta_crushSaidFor[es->number] = key;
+		}
+	}
+	eta_crushSaidFor[said] = key;
+
+	/* The shortest run, of eight ways round from where they face, to a
+	   place out of every closing mover's path, with nothing in the way
+	   and floor under it. */
+	{
+		static const vec3_t probeMins = { -15.0f, -15.0f, -6.0f }, probeMaxs = { 15.0f, 15.0f, 24.0f };
+		float               bestRun = 1.0e9f, bestTurn = 0.0f;
+		int                 way;
+
+		for (way = 0; way < 8; way++)
+		{
+			float  turn = (float)( way * 45 );
+			vec3_t angles = { 0.0f, 0.0f, 0.0f }, forward, at;
+			float  run;
+
+			angles[YAW] = ps->viewangles[YAW] + turn;
+			AngleVectors(angles, forward, NULL, NULL);
+			for (run = 32.0f; run <= ETA_CRUSH_MAX_RUN && run < bestRun; run += 16.0f)
+			{
+				trace_t  trace;
+				vec3_t   down;
+				qboolean clear = qtrue;
+				int      e;
+
+				VectorMA(ps->origin, run, forward, at);
+				trap_CM_BoxTrace(&trace, ps->origin, at, probeMins, probeMaxs, 0, MASK_PLAYERSOLID);
+				if (trace.fraction < 1.0f || trace.startsolid)
+				{
+					break;   /* a wall this way */
+				}
+				VectorCopy(at, down);
+				down[2] -= 64.0f;
+				trap_CM_BoxTrace(&trace, at, down, probeMins, probeMaxs, 0, MASK_PLAYERSOLID);
+				if (trace.fraction >= 1.0f)
+				{
+					break;   /* an edge */
+				}
+				for (e = 0; e < endCount && clear; e++)
+				{
+					clear = (qboolean)!( ends[e][1][0] > at[0] - 18.0f && ends[e][0][0] < at[0] + 18.0f
+					                     && ends[e][1][1] > at[1] - 18.0f && ends[e][0][1] < at[1] + 18.0f
+					                     && ends[e][1][2] > at[2] - 16.0f && ends[e][0][2] < at[2] + 32.0f );
+				}
+				if (clear)
+				{
+					bestRun  = run + 16.0f;   /* and a little more, to be clear of it */
+					bestTurn = turn;
+					break;
+				}
+			}
+		}
+
+		ETA_Speech_HoldForUrgent(qfalse);
+		ETA_Speech_Stop();
+		eta_crushUrgentUntil = cg.time + ETA_CRUSH_URGENT_MS;
+		if (bestRun < 1.0e8f)
+		{
+			int meters = (int)( bestRun * ETA_QU_TO_METERS + 0.5f );
+
+			/* The way first: there is under a second to start. */
+			ETA_Speech_Say(va("Run %s, %d %s! Walls closing", ETA_HudNarrator_RelativeDirection(AngleNormalize180(bestTurn)),
+			                  meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters"));
+		}
+		else
+		{
+			ETA_Speech_Say("Get out! Walls closing");
+		}
+		ETA_Speech_HoldForUrgent(qtrue);
+	}
+}
