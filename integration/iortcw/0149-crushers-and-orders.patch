+/*
+ * Come up to a switch that is one of an order, or that closes walls on
+ * the player: what it is, once, in full - the short name T and F give
+ * has no room for it.
+ */
+#define ETA_SWITCH_NOTICE_NEAR  192.0f
+#define ETA_SWITCH_NOTICE_AGAIN 30000
+
+static const char *ETA_CompassWord(float dx, float dy)
+{
+	static const char *words[8] = { "east", "north-east", "north", "north-west", "west", "south-west", "south", "south-east" };
+	float              yaw = atan2f(dy, dx) * 180.0f / (float)M_PI;
+	int                way = (int)floorf(( yaw + 22.5f + 360.0f ) / 45.0f) % 8;
+
+	return words[way];
+}
+
+static void ETA_SwitchNoticeFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  model, best = 0;
+	float                bestDistance = ETA_SWITCH_NOTICE_NEAR;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		return;
+	}
+	for (model = 1; model < MAX_MODELS && model < cgs.numInlineModels; model++)
+	{
+		float distance;
+
+		if (!eta_switchPlace[model] && !eta_crushSwitch[model])
+		{
+			continue;
+		}
+		distance = Distance(ps->origin, cgs.inlineModelMidpoints[model]);
+		if (distance > 800.0f)
+		{
+			eta_switchNoticeAt[model] = 0;   /* gone away: said again on coming back */
+		}
+		else if (distance < bestDistance && !eta_switchNoticeAt[model])
+		{
+			best         = model;
+			bestDistance = distance;
+		}
+	}
+	if (!best)
+	{
+		return;
+	}
+	eta_switchNoticeAt[best] = cg.time;
+
+	{
+		char text[MAX_STRING_CHARS] = "";
+
+		if (eta_switchPlace[best])
+		{
+			vec3_t middle = { 0.0f, 0.0f, 0.0f };
+			int    place, count = 0, m;
+
+			for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+			{
+				if (eta_switchPlaces[m] == eta_switchPlaces[best] && eta_switchPlace[m])
+				{
+					VectorAdd(middle, cgs.inlineModelMidpoints[m], middle);
+					count++;
+				}
+			}
+			VectorScale(middle, 1.0f / (float)MAX(count, 1), middle);
+			Com_sprintf(text, sizeof(text), "This button is %d of %d, pressed in order:", eta_switchPlace[best], eta_switchPlaces[best]);
+			for (place = 1; place <= eta_switchPlaces[best]; place++)
+			{
+				for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+				{
+					if (eta_switchPlaces[m] == eta_switchPlaces[best] && eta_switchPlace[m] == place)
+					{
+						const char *way = ETA_CompassWord(cgs.inlineModelMidpoints[m][0] - middle[0],
+						                                  cgs.inlineModelMidpoints[m][1] - middle[1]);
+
+						Q_strcat(text, sizeof(text), va("%s %s %sthe %s one", place == 1 ? "" : ",",
+						                                place == 1 ? "first" : place == eta_switchPlaces[best] ? "last" : "then",
+						                                m == best ? "this one, " : "", way));
+						break;
+					}
+				}
+			}
+			Q_strcat(text, sizeof(text), eta_switchOpensHidden[best] ? ". In that order they open hidden doors."
+			                                                          : ". In that order they set something off.");
+		}
+		if (eta_crushSwitch[best])
+		{
+			Q_strcat(text, sizeof(text), text[0] ? " " : "");
+			Q_strcat(text, sizeof(text), "Walls close on you here when it is pressed: press it, then run straight back at once.");
+		}
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(text);
+	}
+}
