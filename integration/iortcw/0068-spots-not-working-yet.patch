+/* A spot's state from the game (g_main.c): -1 not known, 0 switched off,
+   1 works, 2 used and gone. */
+int CG_AccessibilityUnlockState(int index)
+{
+	const char *state = CG_ConfigString(CS_ETA_TRIGGERS);
+	int        model;
+	char       c;
+
+	if (index < 0 || index >= eta_unlockSpotCount || !eta_unlockSpots[index].trigger || state[0] != '!')
+	{
+		return -1;
+	}
+	model = eta_unlockSpots[index].model;
+	c     = model < (int)strlen(state) ? state[model] : '-';
+	return c == 'o' ? 0 : c == 'a' ? 1 : c == '-' ? 2 : -1;
+}
+
+/* The spot T's list has at a point: -1 none. */
+int CG_AccessibilityUnlockSpotAt(const vec3_t at)
+{
+	int i;
+
+	for (i = 0; i < eta_unlockSpotCount; i++)
+	{
+		if (Distance(eta_unlockSpots[i].at, at) < 32.0f)
+		{
+			return i;
+		}
+	}
+	return -1;
+}
+
+/* Said after a spot's name on T's list while it does nothing yet; "" once
+   it works. */
+const char *CG_AccessibilityUnlockWhy(int index)
+{
+	if (CG_AccessibilityUnlockState(index) != 0)
+	{
+		return "";
+	}
+	if (eta_unlockSpots[index].need)
+	{
+		return va(", not working yet: it works once %d of the %d soldiers of this part are beaten",
+		          eta_unlockSpots[index].need, eta_unlockSpots[index].of);
+	}
+	return ", not working yet: something else in the level wakes it first";
+}
+
+/* Says so when a spot that did nothing starts to work. */
+void CG_AccessibilityUnlockFrame(void)
+{
+	int i, now, woke = 0;
+
+	for (i = 0; i < eta_unlockSpotCount; i++)
+	{
+		now = CG_AccessibilityUnlockState(i);
+		if (now < 0)
+		{
+			continue;
+		}
+		if (eta_unlockSpots[i].seen == 0 && now == 1)
+		{
+			woke++;
+		}
+		eta_unlockSpots[i].seen = now;
+	}
+	if (woke)
+	{
+		ETA_Speech_Say(woke == 1 ? "A spot that unlocks a door works now. T finds it"
+		               : "Spots that unlock a door work now. T finds them");
+	}
+}
