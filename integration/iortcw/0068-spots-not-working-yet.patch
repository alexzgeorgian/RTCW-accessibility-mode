 */
+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * [Accessibility]: which of the map's triggers work, for the client's T
+ * list (cg_accessibility_unlock.c). Many of the campaign's places that
+ * unlock a door start switched off and only work once the script wakes
+ * them - in Castle Keep, once most soldiers of a part are beaten - and
+ * go once walked onto. The client cannot see a trigger, so each brush
+ * model's state is told it: 'a' a trigger that works, 'o' one switched
+ * off, 'x' something else, '-' nothing (a trigger used and gone).
+ */
+static void G_AccessibilityTriggers( void ) {
+	static int  next;
+	char        state[MAX_MODELS + 1], sent[MAX_MODELS + 1];
+	gentity_t   *ent;
+	int         i, top = 1;
+
+	if ( level.time < next && level.time > next - 1000 ) {
+		return;
+	}
+	next = level.time + 500;
+
+	memset( state, '-', sizeof( state ) );
+	state[0] = '!';
+	for ( i = 0, ent = g_entities; i < level.num_entities; i++, ent++ ) {
+		int model;
+
+		/* By its name: one switched off has not been given its model. */
+		if ( !ent->inuse || !ent->model || ent->model[0] != '*' ) {
+			continue;
+		}
+		model = atoi( ent->model + 1 );
+		if ( model <= 0 || model >= MAX_MODELS ) {
+			continue;
+		}
+		if ( !Q_strncmp( ent->classname, "trigger_", 8 ) || !Q_stricmp( ent->classname, "ai_trigger" ) ) {
+			state[model] = ( ent->r.linked && ent->touch ) ? 'a' : 'o';
+		} else {
+			state[model] = 'x';
+		}
+		top = model + 1 > top ? model + 1 : top;
+	}
+	state[top] = '\0';
+	trap_GetConfigstring( CS_ETA_TRIGGERS, sent, sizeof( sent ) );
+	if ( strcmp( state, sent ) ) {
+		trap_SetConfigstring( CS_ETA_TRIGGERS, state );
+	}
+}
+#endif
