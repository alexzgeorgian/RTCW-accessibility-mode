diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index c3cb777f..cb1613da 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -6978,6 +6978,26 @@ static void ETA_FacePendingFrame(void)
 			VectorCopy(origin, aim.point);
 			ETA_AimStartSnap(&aim, NULL);
 			ETA_HudNarrator_HoldPassive(cg.time);
+			/* A hidden way's step, on open ground: the straight line is
+			   the way, and "No way found" only alarmed. The tester heard
+			   it a few metres from hidden way 3, on the slope below it -
+			   a square the search could not step out of, by a tree or on
+			   the slope itself. */
+			if (name && !Q_stricmpn(name, "hidden ", 7))
+			{
+				vec3_t flat;
+				int    meters, up;
+
+				VectorSubtract(origin, cg.predictedPlayerState.origin, flat);
+				up      = (int)( flat[2] * ETA_QU_TO_METERS + ( flat[2] >= 0.0f ? 0.5f : -0.5f ) );
+				flat[2] = 0.0f;
+				meters  = (int)( VectorLength(flat) * ETA_QU_TO_METERS + 0.5f );
+				ETA_Speech_Say(va("Facing %s in a straight line, %d %s%s. If a tree or a rock stops you, "
+				                  "step to one side, and O again",
+				                  name, meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters",
+				                  up >= 2 ? va(", %d meters above you", up) : up <= -2 ? va(", %d meters below you", -up) : ""));
+				return;
+			}
 			ETA_AimSayThen(va("No way found to %s. Turned straight toward it", name ? name : "it"), origin,
 			               "X lists the ways out of here, T what is left to do");
 			return;
