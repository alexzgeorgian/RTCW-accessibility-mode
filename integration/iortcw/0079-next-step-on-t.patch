 static qboolean ETA_AreaBeyondDoor(const eta_areaExit_t *exit, int area, const vec3_t at)
 {
 	int    mine = exit->area[0] == area ? 0 : 1;
@@ -526,7 +527,7 @@ static qboolean ETA_AreaBeyondDoor(const eta_areaExit_t *exit, int area, const v
 	}
 	VectorSubtract(at, exit->middle, off);
 	off[2] = 0.0f;
-	return (qboolean)( DotProduct(off, through) > 48.0f && ETA_AreaOf(at) != area );
+	return (qboolean)( DotProduct(off, through) > 20.0f && ETA_AreaOf(at) != area );
 }
 
 /* Whether a point is the switch that opens a locked door out of an area. */
@@ -556,6 +557,25 @@ static qboolean ETA_AreaDoorSwitch(int area, const vec3_t at)
 	return qfalse;
 }
 
+/* Whether a point is just through a locked door out of an area: reached by
+   going round, if at all, not by the door. */
+qboolean CG_AccessibilityAreaBehindLockedDoor(int area, const vec3_t at)
+{
+	int i;
+
+	for (i = 0; i < eta_areas.exitCount; i++)
+	{
+		const eta_areaExit_t *exit = &eta_areas.exits[i];
+
+		if (exit->model > 0 && ( exit->area[0] == area || exit->area[1] == area ) && !ETA_AreaExitOpens(exit)
+		    && Distance(at, exit->middle) < 256.0f && ETA_AreaBeyondDoor(exit, area, at))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
