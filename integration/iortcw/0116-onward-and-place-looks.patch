+		                                   || !Q_stricmp(kind, "square") || !Q_stricmp(kind, "open ground") );
+		const char *lookKind, *lookMark, *ground;
+
+		ETA_AreaLook(area, outdoors, &lookKind, &lookMark);
+		if (lookKind && Q_stricmp(kind, "corridor"))
+		{
+			kind = lookKind;
+		}
+		/* A plain room: under the roof, the attic; above the ground
+		   floor, upstairs. */
+		else if (!lookKind && ( !Q_stricmp(kind, "room") || !Q_stricmp(kind, "small room") ))
+		{
+			trace_t roof;
+			vec3_t  up;
+
+			VectorCopy(at, up);
+			up[2] += 256.0f;
+			CG_Trace(&roof, at, NULL, NULL, up, cg.predictedPlayerState.clientNum, MASK_SOLID);
+			if (roof.fraction < 1.0f && ( roof.surfaceFlags & SURF_ROOF ))
+			{
+				kind = !Q_stricmp(kind, "room") ? "attic" : "small attic";
+			}
+			else if (place.upper)
+			{
+				Q_strncpyz(look, va("upstairs %s", kind), sizeof(look));
+				kind = look;
+			}
+		}
+		if (outdoors && ( ground = ETA_AreaGround(at) ) != NULL)
