 }
 
+static void ETA_WorldRead(void);
+
+int CG_AccessibilityPropCount(void)
+{
+	ETA_WorldRead();
+	return eta_mapPropCount;
+}
+
+/* A thing in the rooms, by its index: its name, and the middle of it. */
+const char *CG_AccessibilityPropGet(int index, vec3_t center)
+{
+	if (index < 0 || index >= eta_mapPropCount)
+	{
+		return NULL;
+	}
+	VectorAdd(eta_mapProps[index].mins, eta_mapProps[index].maxs, center);
+	VectorScale(center, 0.5f, center);
+	return eta_mapProps[index].name;
+}
+
