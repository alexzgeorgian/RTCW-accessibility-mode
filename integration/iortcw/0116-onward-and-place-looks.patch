+			Q_strncpyz(look, va("%s %s", ground, kind), sizeof(look));
+			kind = look;
+		}
+		if (lookMark)
+		{
+			Q_strncpyz(lookMarkText, lookMark, sizeof(lookMarkText));
+		}
+	}
+
 	/* What marks it, the first of these there is. */
 	mark[0] = '\0';
 	CG_AccessibilityTramStationText(at, station, sizeof(station));
