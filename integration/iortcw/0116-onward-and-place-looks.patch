@@ -739,11 +745,140 @@ static void ETA_AreaLike(int area, char *out, size_t size);
  * named by what is in it and where it is. Two of the same name keep their
  * number to tell them apart: "the room with a switch, 4".
  */
+/*
+ * What a place is by what is in it - the map's own furniture, read from
+ * its surfaces: beds make a bedroom, a stove a kitchen, pews a church,
+ * crates a store room. The tester, used to the Enemy Territory mode's
+ * place names, asked for every part of a level to be named, and where
+ * the game names nothing, to be named by how it looks.
+ */
+#define ETA_AREA_LOOK_ROOM   0
+#define ETA_AREA_LOOK_OUT    1
+
+
+static void ETA_AreaLook(int area, qboolean outdoors, const char **kind, const char **mark)
+{
+	enum
+	{
+		L_BED, L_BUNK, L_STOVE, L_SINK, L_TOILET, L_PEW, L_FURNACE, L_GENERATOR, L_OFFICE, L_BOOK,
+		L_SEAT, L_TABLE, L_CHAIR, L_STORE, L_CELL, L_BONES, L_TRUCK, L_CART, L_TREE, L_SANDBAG, L_WINE, L_HAY, L_TOMB,
+		L_COUNT
+	};
+	static const struct
+	{
+		const char *name;
+		int         look;
+	} names[] =
+	{
+		{ "Bed", L_BED }, { "Bunk bed", L_BUNK }, { "Stove", L_STOVE }, { "Sink", L_SINK },
+		{ "Toilet", L_TOILET }, { "Bath", L_TOILET }, { "Pew", L_PEW }, { "Altar", L_PEW },
+		{ "Furnace", L_FURNACE }, { "Generator", L_GENERATOR }, { "Radio", L_OFFICE },
+		{ "Telephone", L_OFFICE }, { "Typewriter", L_OFFICE }, { "Desk", L_OFFICE },
+		{ "Bookcase", L_BOOK }, { "Books", L_BOOK }, { "Armchair", L_SEAT }, { "Sofa", L_SEAT },
+		{ "Fireplace", L_SEAT }, { "Piano", L_SEAT }, { "Table", L_TABLE }, { "Chair", L_CHAIR },
+		{ "Bench", L_CHAIR }, { "Crate", L_STORE }, { "Barrel", L_STORE }, { "Shelves", L_STORE },
+		{ "Cupboard", L_STORE }, { "Manacles", L_CELL }, { "Bones", L_BONES }, { "Truck", L_TRUCK },
+		{ "Cart", L_CART }, { "Tree", L_TREE }, { "Hedge", L_TREE }, { "Sandbags", L_SANDBAG },
+		{ "Wine rack", L_WINE }, { "Hay", L_HAY }, { "Tomb", L_TOMB }
+	};
+	int    count[L_COUNT], i, k, n = CG_AccessibilityPropCount();
+	vec3_t center;
+
+	*kind = NULL;
+	*mark = NULL;
+	if (area < 0 || area >= ETA_AREAS_MAX)
+	{
+		return;
+	}
+	if (eta_areaLookDone[area])
+	{
+		*kind = eta_areaLookKind[area][0] ? eta_areaLookKind[area] : NULL;
+		*mark = eta_areaLookMark[area][0] ? eta_areaLookMark[area] : NULL;
+		return;
+	}
+
+	memset(count, 0, sizeof(count));
+	for (i = 0; i < n; i++)
+	{
+		const char *name = CG_AccessibilityPropGet(i, center);
+
+		if (!name || ETA_AreaOf(center) != area)
+		{
+			continue;
+		}
+		for (k = 0; k < (int)ARRAY_LEN(names); k++)
+		{
+			if (!Q_stricmp(names[k].name, name))
+			{
+				count[names[k].look]++;
+				break;
+			}
+		}
+	}
+
+	eta_areaLookKind[area][0] = '\0';
+	eta_areaLookMark[area][0] = '\0';
+	if (outdoors)
+	{
+		const char *m = count[L_TRUCK] ? "with a truck" : count[L_CART] ? "with a cart" : count[L_HAY] ? "with hay"
+		                : count[L_SANDBAG] ? "with sandbags" : count[L_TREE] >= 2 ? "with trees" : NULL;
+
+		if (m)
+		{
+			Q_strncpyz(eta_areaLookMark[area], m, sizeof(eta_areaLookMark[area]));
+		}
+	}
+	else
+	{
+		const char *r = count[L_PEW] ? "church"
+		                : count[L_CELL] ? "cell"
+		                : count[L_TOMB] || count[L_BONES] >= 2 ? "crypt"
+		                : count[L_WINE] ? "wine cellar"
+		                : count[L_HAY] ? "barn"
+		                : count[L_BUNK] ? "bunk room"
+		                : count[L_BED] ? "bedroom"
+		                : count[L_TOILET] ? "bathroom"
+		                : count[L_STOVE] || count[L_SINK] ? "kitchen"
+		                : count[L_FURNACE] ? "boiler room"
+		                : count[L_GENERATOR] ? "generator room"
+		                : count[L_OFFICE] ? "office"
+		                : count[L_BOOK] ? "study"
+		                : count[L_SEAT] ? "sitting room"
+		                : count[L_TABLE] && count[L_CHAIR] ? "dining room"
+		                : count[L_STORE] >= 2 ? "store room" : NULL;
+
+		if (r)
+		{
+			Q_strncpyz(eta_areaLookKind[area], r, sizeof(eta_areaLookKind[area]));
+		}
+	}
+	eta_areaLookDone[area] = 1;
+	*kind = eta_areaLookKind[area][0] ? eta_areaLookKind[area] : NULL;
+	*mark = eta_areaLookMark[area][0] ? eta_areaLookMark[area] : NULL;
+}
+
+/* What the ground outdoors is: snow in the village, grass, gravel. */
+static const char *ETA_AreaGround(const vec3_t at)
+{
+	trace_t trace;
+	vec3_t  down;
+
+	VectorCopy(at, down);
+	down[2] -= 96.0f;
+	CG_Trace(&trace, at, NULL, NULL, down, cg.predictedPlayerState.clientNum, MASK_SOLID);
+	if (trace.fraction >= 1.0f)
+	{
+		return NULL;
+	}
+	return ( trace.surfaceFlags & SURF_SNOW ) ? "snowy" : ( trace.surfaceFlags & SURF_GRASS ) ? "grassy"
+	       : ( trace.surfaceFlags & SURF_GRAVEL ) ? "gravel" : NULL;
+}
