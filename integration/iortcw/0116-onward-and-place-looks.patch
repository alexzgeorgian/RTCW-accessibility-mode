 			Q_strncpyz(mark, k == 6 ? "with stairs up" : "with stairs down", sizeof(mark));
 		}
 	}
+	if (!mark[0] && lookMarkText[0])
+	{
+		Q_strncpyz(mark, lookMarkText, sizeof(mark));
+	}
 	if (!mark[0])
 	{
 		int toNew, doors = ETA_AreaDoorsOut(area, &toNew);
@@ -1764,9 +1945,14 @@ void CG_AccessibilityAreasDump(void)
 				doors += eta_areas.exits[i].model > 0;
 			}
 		}
-		CG_Printf("ETASWEEP area %d box %.0f %.0f %.0f to %.0f %.0f %.0f floor %.0f m2 ways %d doors %d\n", a,
