+/*
+ * L: straight to the waypoint on top - said with how far and where, and
+ * chosen, so O leads there, as a waypoint chosen from the list is.
+ */
+void CG_AccessibilityWaypointTop(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              delta;
+	char                height[64];
+	int                 meters;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	if (!eta_topSet)
+	{
+		ETA_Speech_Say("No waypoint on top yet. Shift P sets it where you stand. K steps through the others");
+		return;
+	}
+
+	VectorSubtract(eta_topPoint, ps->origin, delta);
+	meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
+	if (meters <= 1)
+	{
+		ETA_Speech_Say(eta_topName[0] ? va("You are at the waypoint on top, %s", eta_topName)
+		               : "You are at the waypoint on top");
+		return;
+	}
+	ETA_HudNarrator_HeightText(delta[2] * ETA_QU_TO_METERS, height, sizeof(height));
+	ETA_Speech_Say(va("Waypoint on top%s%s, %d meters, %s%s%s. O leads there", eta_topName[0] ? ", " : "", eta_topName,
+	                  meters, ETA_HudNarrator_RelativeDirection(AngleNormalize180(vectoyaw(delta) - ps->viewangles[YAW])),
+	                  height[0] ? ", " : "", height));
+	CG_AccessibilityChoose(eta_topPoint, eta_topName[0] ? va("the waypoint on top, %s", eta_topName)
+	                       : "the waypoint on top");
 }
 
