+/* What the map lays out to pick up around a spot, for the waypoint on
+   top: "ammo and health", "health", or "" with neither within 15 meters. */
+static void ETA_SuppliesNear(const vec3_t at, char *out, size_t size)
+{
+	qboolean ammo = qfalse, health = qfalse;
+	int      i;
+
+	out[0] = '\0';
+	ETA_WorldRead();
+	for (i = 0; i < eta_mapItemCount; i++)
+	{
+		gitem_t *it = &bg_itemlist[eta_mapItems[i].item];
+
+		if (eta_mapItems[i].hidden || Distance(at, eta_mapItems[i].at) > 15.0f / ETA_QU_TO_METERS
+		    || fabsf(at[2] - eta_mapItems[i].at[2]) > 96.0f)
+		{
+			continue;
+		}
+		if (it->giType == IT_HEALTH)
+		{
+			health = qtrue;
+		}
+		else if (it->giType == IT_AMMO || it->giType == IT_WEAPON)
+		{
+			ammo = qtrue;
+		}
+	}
+	Q_strncpyz(out, ammo && health ? "ammo and health" : ammo ? "ammo" : health ? "health" : "", size);
+}
