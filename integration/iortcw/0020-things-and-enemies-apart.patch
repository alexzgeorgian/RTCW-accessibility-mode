+/**
+ * @brief Whether the player is on a thing to use, and the enemy lock
+ * keeps off the aim.
+ *
+ * Things and enemies shared one aim. The tester chose a thing with K and
+ * pressed F; F turned to it - and the lock that takes an enemy in sight
+ * by itself took the aim the moment the turn was done, and turned them
+ * to a soldier. Being shot did the same. So while a thing chosen with K
+ * or J is held, while F keeps the player facing a thing they walk to,
+ * and for a few seconds after F turns to one, the lock does not take
+ * the aim by itself; being shot is said, and Insert locks on when the
+ * player wants it.
+ */
+static qboolean ETA_ItemFocused(void)
+{
+	if (eta_aim.mode == ETA_AIM_FOLLOW || eta_aim.mode == ETA_AIM_SNAP)
+	{
+		return qtrue;
+	}
+	if (cg.time < eta_aim.itemFocusUntil && eta_aim.itemFocusUntil - cg.time <= ETA_ITEM_FOCUS_MS)
+	{
+		return qtrue;
+	}
+	return (qboolean)(eta_choose.held && eta_choose.byPlayer && cg.time >= eta_choose.at
+	                  && cg.time - eta_choose.at < ETA_CHOOSE_HOLD_MS);
+}
