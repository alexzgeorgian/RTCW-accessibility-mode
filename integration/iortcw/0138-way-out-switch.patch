+static void ETA_DoorsSeen(void)
+{
+	int n;
+
+	for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		int                 model = es->modelindex;
+
+		if (es->eType != ET_MOVER || model <= 0 || model >= MAX_MODELS || eta_doorLocked[model] < 0)
+		{
+			continue;
+		}
+		eta_doorSeen[model] = ( es->apos.trType != TR_STATIONARY || es->pos.trType != TR_STATIONARY
+		                        || VectorLength(es->apos.trBase) > 1.0f
+		                        || Distance(es->pos.trBase, eta_doorOrigins[model]) > 1.0f ) ? 1 : 2;
+	}
+}
