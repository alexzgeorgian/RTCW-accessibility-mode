+/* A switch here pressed already, as T has it. */
+qboolean CG_AccessibilityThingPressedAt(const vec3_t point)
+{
+	int i;
+
+	for (i = 0; i < eta_things.count; i++)
+	{
+		if (eta_things.things[i].kind == ETA_THING_SWITCH && eta_things.things[i].pressed
+		    && ETA_ThingNear(eta_things.things[i].point, point, 64.0f))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
