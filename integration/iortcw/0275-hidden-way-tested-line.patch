+static const etaTestedLine_t eta_testedLines[] =
+{
+	{ "forest", eta_forestLine, (int)ARRAY_LEN(eta_forestLine) },
+};
+
+#define ETA_LINE_AHEAD   2        /* points ahead along the line: some 2 to 4 metres */
+#define ETA_LINE_OFF     256.0f   /* further off it than this: back onto it first */
+
+static int ETA_LineNearest(const etaTestedLine_t *line, const vec3_t at)
+{
+	int   i, best = 0;
+	float bestDistance = 1.0e12f;
+
+	for (i = 0; i < line->count; i++)
+	{
+		float dx = at[0] - line->at[i][0], dy = at[1] - line->at[i][1], dz = at[2] - line->at[i][2];
+		float d  = dx * dx + dy * dy + 4.0f * dz * dz;   /* height counts: the hill's two sides */
+
+		if (d < bestDistance)
+		{
+			bestDistance = d;
+			best         = i;
+		}
+	}
+	return best;
+}
+
+/* With a hidden way's step on the marker, steers along the line. */
+static void ETA_RouteTestedLine(const vec3_t here)
+{
+	char                   base[MAX_QPATH];
+	const etaTestedLine_t *line = NULL;
+	int                    i, near, goal, next;
+	vec3_t                 point;
+
+	if (!eta_marker.active
+	    || ( Q_stricmpn(eta_marker.name, "hidden way", 10) && !strstr(eta_marker.name, "side door") ))
+	{
+		return;
+	}
+	COM_StripExtension(COM_SkipPath(cgs.mapname), base, sizeof(base));
+	for (i = 0; i < (int)ARRAY_LEN(eta_testedLines); i++)
+	{
+		if (!Q_stricmp(eta_testedLines[i].map, base))
+		{
+			line = &eta_testedLines[i];
+		}
+	}
+	if (!line)
+	{
+		return;
+	}
+
+	near = ETA_LineNearest(line, here);
+	goal = ETA_LineNearest(line, eta_marker.origin);
+	VectorSet(point, line->at[near][0], line->at[near][1], line->at[near][2]);
+
+	if (Distance(here, point) > ETA_LINE_OFF)
+	{
+		next = near;                      /* off the line: back onto it */
+		eta_route.onWay    = qfalse;      /* round what is in the way, as ever */
+		eta_route.overEdge = qfalse;
+	}
+	else if (goal > near)
+	{
+		next = MIN(near + ETA_LINE_AHEAD, goal);
+	}
+	else if (goal < near)
+	{
+		next = MAX(near - ETA_LINE_AHEAD, goal);
+	}
+	else
+	{
+		return;                           /* at the step's own point: straight to it */
+	}
+
+	VectorSet(eta_route.steer, line->at[next][0], line->at[next][1], line->at[next][2] + 24.0f);
+	eta_route.steering   = qtrue;
+	eta_route.steerIndex = 0;             /* not the way-finder's: no turn ahead from its points */
+	/* On the line, its next point is walked to straight - it was walked
+	   so - rather than round to the nearest opening: on the slope up to
+	   hidden way 11 the opening search turned the test player off the
+	   line and back, to and fro. */
+	if (next != near)
+	{
+		eta_route.onWay    = qtrue;
+		eta_route.overEdge = qfalse;
+	}
+}
