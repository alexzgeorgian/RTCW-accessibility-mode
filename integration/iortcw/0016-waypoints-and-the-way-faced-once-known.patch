diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index c7f7cee..2f85a16 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -1999,8 +1999,60 @@ static void ETA_WayCueFrame(void)
 
 /**
  * @brief O again: turned to face the way, once, and how far is left.
+ *
+ * Not before the way round the walls is known: pressed straight after the
+ * way out was set, it turned the tester straight at the exit, through the
+ * walls, and W took them the wrong way. Then it waits - "Finding the way"
+ * - and turns them as soon as the way is found.
  */
+#define ETA_FACE_WAIT_MS 8000
+
+static int eta_facePendingAt;
+
+static void ETA_FaceTheWayNow(void);
+
 void CG_AccessibilityFaceTheWay(void)
+{
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL || !CG_AccessibilityMarkerActive())
+	{
+		return;
+	}
+
+	if (!CG_AccessibilityMarkerWayKnown())
+	{
+		eta_facePendingAt = cg.time;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say("Finding the way. A moment");
+		return;
+	}
+
+	eta_facePendingAt = 0;
+	ETA_FaceTheWayNow();
+}
+
+/* Every frame: a face asked for before the way was known, done once it
+   is - or given up on. */
+static void ETA_FacePendingFrame(void)
+{
+	if (!eta_facePendingAt)
+	{
+		return;
+	}
+	if (cg.time < eta_facePendingAt || cg.time - eta_facePendingAt > ETA_FACE_WAIT_MS
+	    || !CG_AccessibilityMarkerActive())
+	{
+		eta_facePendingAt = 0;
+		ETA_Speech_Say("No way found from here yet. O tries again");
+		return;
+	}
+	if (CG_AccessibilityMarkerWayKnown())
+	{
+		eta_facePendingAt = 0;
+		ETA_FaceTheWayNow();
+	}
+}
+
+static void ETA_FaceTheWayNow(void)
 {
 	const playerState_t *ps = &cg.predictedPlayerState;
 	vec3_t              target, origin, delta;
@@ -2115,6 +2167,7 @@ void CG_AccessibilityAimFrame(void)
 	if (cg.snap && cg.snap->ps.pm_type == PM_NORMAL)
 	{
 		ETA_HitFrame();
+		ETA_FacePendingFrame();
 	}
 
 	/* A climb has the keys to itself. */
