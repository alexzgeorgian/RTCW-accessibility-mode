 /**
  * @brief Whether the way needs a jump just ahead, for the walk guide to
  * take: the player is at its edge, and the landing is ahead of them.
diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 54d1104..e5ff663 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -4130,6 +4130,107 @@ void CG_AccessibilityWayOut(void)
 }
 
 
+/**
+ * @brief Waypoints: places the player marks, to come back to.
+ *
+ * 1428: Shadows over Silesia, which the tester plays, lets a player mark
+ * points of their own and be led back to them. So P marks where the
+ * player stands - "Waypoint 2 set" - and L steps through the places to
+ * go: the way out, then each waypoint, nearest said first with where it
+ * is. The one chosen takes the marker, so its ping, the way told while
+ * walking, and O facing the way all lead there. Nine are kept, the
+ * oldest given up for a tenth; a new map starts with none.
+ */
+#define ETA_MAX_WAYPOINTS 9
+
+static vec3_t eta_waypoints[ETA_MAX_WAYPOINTS];
+static int    eta_waypointCount, eta_waypointNext, eta_destination;
+
+void CG_AccessibilityWaypointPlace(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 number;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	number = eta_waypointNext + 1;
+	VectorCopy(ps->origin, eta_waypoints[eta_waypointNext]);
+	eta_waypointNext = (eta_waypointNext + 1) % ETA_MAX_WAYPOINTS;
+	if (eta_waypointCount < ETA_MAX_WAYPOINTS)
+	{
+		eta_waypointCount++;
+	}
+
+	ETA_Speech_Say(va("Waypoint %d set here. L chooses where to go", number));
+}
+
+void CG_AccessibilityWaypointNext(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              point, delta, exitPoint = { 0.0f, 0.0f, 0.0f };
+	char                height[64], name[32];
+	int                 choices, i, model = 0, meters;
+	float               bestDistance = 0.0f;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	ETA_WorldRead();
+
+	for (i = 0; i < eta_exitCount; i++)
+	{
+		if (ETA_ExitPoint(eta_exitModels[i], point)
+		    && (!model || Distance(ps->origin, point) < bestDistance))
+		{
+			model        = eta_exitModels[i];
+			bestDistance = Distance(ps->origin, point);
+			VectorCopy(point, exitPoint);
+		}
+	}
+
+	/* Choice 0 is the way out, where there is one; 1 to 9 the waypoints. */
+	choices = eta_waypointCount + 1;
+	if (!model && !eta_waypointCount)
+	{
+		ETA_Speech_Say("No waypoints yet. P marks where you stand");
+		return;
+	}
+
+	for (i = 0; i < choices; i++)
+	{
+		eta_destination = (eta_destination + 1) % choices;
+		if (eta_destination || model)
+		{
+			break;
+		}
+	}
+
+	if (eta_destination == 0)
+	{
+		VectorCopy(exitPoint, point);
+		Q_strncpyz(name, "the way out", sizeof(name));
+	}
+	else
+	{
+		VectorCopy(eta_waypoints[eta_destination - 1], point);
+		Com_sprintf(name, sizeof(name), "waypoint %d", eta_destination);
+	}
+
+	VectorSubtract(point, ps->origin, delta);
+	meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
+	ETA_HudNarrator_HeightText(delta[2] * ETA_QU_TO_METERS, height, sizeof(height));
+	name[0] = (char)toupper((unsigned char)name[0]);
+	ETA_Speech_Say(va("%s, %d meters, %s%s%s. O faces the way", name, meters < 1 ? 1 : meters,
+	                  ETA_HudNarrator_RelativeDirection(AngleNormalize180(vectoyaw(delta) - ps->viewangles[YAW])),
+	                  height[0] ? ", " : "", height));
+	name[0] = (char)tolower((unsigned char)name[0]);
+	CG_AccessibilityMarkerSet(point, name);
+}
+
 /**
  * @brief Reads what the map file holds about the map: its doors, its
  *        ladders and the things in its rooms. Once a map, on its first
@@ -4139,7 +4240,8 @@ static qboolean eta_worldRead;
 
 void CG_AccessibilityWorldInit(void)
 {
-	eta_worldRead = qfalse;
+	eta_worldRead     = qfalse;
+	eta_waypointCount = eta_waypointNext = eta_destination = 0;
 	CG_AccessibilityMarkerReset();
 }
 
