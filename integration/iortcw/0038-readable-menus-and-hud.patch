+/*
+ * What the screen shows and nothing said: the HUD's corners and the
+ * mission's figures. The secret areas and the treasure found so far, the
+ * item ready to use, the stamina bar run out, a gun's heat bar near the
+ * top, the last of the ammo, the dynamite's timer as it is set, and the
+ * air left under water - which the game shows no bar for, but a sighted
+ * player sees the surface and a blind one does not.
+ */
+#define ETA_AIR_MS      12000   /* g_active.c: under water this long, drowning */
+#define ETA_AIR_WARN_MS 7000
+
+static struct {
+	qboolean read;
+	int secrets, treasure;
+	int holding;
+	qboolean complete;
+	qboolean breathless, hot, empty;
+	int ammo;
+	int timer;
+	int underSince;
+	int airSaid;
+} etaHud;
+
+/* The mission's figures, as the exit shows them: hours, minutes and
+   seconds played, objectives done and in all, secret areas and treasure
+   found and in all, and the attempts (G_SendMissionStats). */
+static qboolean CG_AccessibilityMissionStats( int v[10] ) {
+	const char *s = CG_ConfigString( CS_MISSIONSTATS );
+
+	return (qboolean)( s && sscanf( s, "s=,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
+									&v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7], &v[8], &v[9] ) == 10 );
+}
+
+static const char *CG_AccessibilityMissionStatsText( void ) {
+	static char text[256];
+	int v[10];
+
+	if ( !CG_AccessibilityMissionStats( v ) ) {
+		return "";
+	}
+	Com_sprintf( text, sizeof( text ), "Time %s%i minute%s %i second%s", v[0] ? va( "%i hour%s ", v[0], v[0] == 1 ? "" : "s" ) : "",
+				 v[1], v[1] == 1 ? "" : "s", v[2], v[2] == 1 ? "" : "s" );
+	/* A figure the map has none of is left out. */
+	if ( v[4] ) {
+		Q_strcat( text, sizeof( text ), va( ". Objectives %i of %i", v[3], v[4] ) );
+	}
+	if ( v[6] ) {
+		Q_strcat( text, sizeof( text ), va( ". Secret areas %i of %i", v[5], v[6] ) );
+	}
+	if ( v[8] ) {
+		Q_strcat( text, sizeof( text ), va( ". Treasure %i of %i", v[7], v[8] ) );
+	}
+	Q_strcat( text, sizeof( text ), va( ". Attempts %i", v[9] ) );
+	return text;
+}
+
+static void CG_AccessibilityHudFrame( playerState_t *ps ) {
+	int v[10];
+	int ammo = -1;
+
+	/* Secret areas and treasure: how many so far, as each is found. The
+	   game says "Secret area" and the treasure's name; not how many. */
+	if ( CG_AccessibilityMissionStats( v ) ) {
+		if ( etaHud.read && v[5] > etaHud.secrets ) {
+			CG_AccessibilitySay( va( "%i of %i secret areas", v[5], v[6] ) );
+		}
+		if ( etaHud.read && v[7] > etaHud.treasure ) {
+			CG_AccessibilitySay( va( "%i of %i treasure", v[7], v[8] ) );
+		}
+		etaHud.secrets = v[5];
+		etaHud.treasure = v[7];
+	}
+
+	/* The item the item keys made ready. */
+	if ( etaHud.read && ps->holding != etaHud.holding && ps->holding > HI_NONE && ps->holding < MAX_HOLDABLE ) {
+		gitem_t *item = BG_FindItemForHoldable( ps->holding );
+
+		if ( item ) {
+			CG_AccessibilitySay( va( "%s ready, %i", CG_AccessibilityItemName( item ), ps->holdable[ps->holding] ) );
+		}
+	}
+	etaHud.holding = ps->holding;
+
+	/* The stamina bar, run out: sprinting stops. Said again once it has
+	   come back half way. */
+	if ( ps->sprintTime < 2000 && !ps->powerups[PW_NOFATIGUE] ) {
+		if ( !etaHud.breathless && etaHud.read ) {
+			CG_AccessibilitySay( "Out of breath" );
+		}
+		etaHud.breathless = qtrue;
+	} else if ( ps->sprintTime > 10000 ) {
+		etaHud.breathless = qfalse;
+	}
+
+	/* A gun that heats - the Venom, a mounted gun - near the top of its
+	   bar, where it locks up until it cools. */
+	if ( ps->curWeapHeat > 215 ) {
+		if ( !etaHud.hot ) {
+			CG_AccessibilitySay( "Overheating" );
+		}
+		etaHud.hot = qtrue;
+	} else if ( ps->curWeapHeat < 100 ) {
+		etaHud.hot = qfalse;
+	}
+
+	/* The last of the ammo for the weapon in hand. */
+	if ( ps->weapon > WP_NONE && ps->weapon < WP_NUM_WEAPONS && ps->weapon != WP_KNIFE && ps->weapon == eta.weapon ) {
+		ammo = ps->ammoclip[BG_FindClipForWeapon( ps->weapon )] + ps->ammo[BG_FindAmmoForWeapon( ps->weapon )];
+		if ( ps->weapon == WP_AKIMBO ) {
+			ammo += ps->ammoclip[BG_FindClipForWeapon( WP_COLT )];
+		}
+		if ( etaHud.read && etaHud.ammo > 0 && ammo == 0 ) {
+			CG_AccessibilitySay( "Out of ammo" );
+		}
+	}
+	etaHud.ammo = ammo;
+
+	/* The dynamite's timer, as fire held sets it. */
+	if ( ps->weapon == WP_DYNAMITE && ps->grenadeTimeLeft > 0 ) {
+		int seconds = ps->grenadeTimeLeft * 5;
+
+		seconds = ( seconds - seconds % 5000 + 5000 ) / 1000;
+		if ( seconds != etaHud.timer ) {
+			CG_AccessibilitySay( va( "Timer %i", seconds ) );
+			etaHud.timer = seconds;
+		}
+	} else {
+		etaHud.timer = 0;
+	}
+
+	/* Air, with the head under water. */
+	{
+		vec3_t eye;
+
+		VectorCopy( ps->origin, eye );
+		eye[2] += ps->viewheight;
+		if ( CG_PointContents( eye, -1 ) & CONTENTS_WATER ) {
+			if ( !etaHud.underSince ) {
+				etaHud.underSince = cg.time;
+				etaHud.airSaid = 0;
+			}
+			if ( etaHud.airSaid < 1 && cg.time - etaHud.underSince >= ETA_AIR_WARN_MS ) {
+				CG_AccessibilitySay( va( "Air running out, %i seconds", ( ETA_AIR_MS - ETA_AIR_WARN_MS ) / 1000 ) );
+				etaHud.airSaid = 1;
+			} else if ( etaHud.airSaid < 2 && cg.time - etaHud.underSince >= ETA_AIR_MS ) {
+				CG_AccessibilitySay( "Drowning. Go up" );
+				etaHud.airSaid = 2;
+			}
+		} else {
+			etaHud.underSince = 0;
+		}
+	}
+
+	/* The mission done: the screen fades and the next one loads. */
+	{
+		char value[16];
+		int reloading;
+
+		trap_Cvar_VariableStringBuffer( "g_reloading", value, sizeof( value ) );
+		reloading = atoi( value );
+		if ( ( reloading & ( RELOAD_NEXTMAP_WAITING | RELOAD_ENDGAME ) ) && !etaHud.complete ) {
+			const char *stats = CG_AccessibilityMissionStatsText();
+
+			etaHud.complete = qtrue;
+			ETA_Speech_SayLong( stats[0] ? va( "Mission complete. %s", stats ) : "Mission complete" );
+		}
+	}
+
+	etaHud.read = qtrue;
+}
