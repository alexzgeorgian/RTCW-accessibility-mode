  * Which key or keys a control is on, said out loud: the string the
  * screen draws beside the label, so the two cannot disagree.
  */
+/* A key as said: "Page Down", not the "PGDN" the screen shows, which a
+   screen reader spells out letter by letter. */
+static const char *ETA_SpokenKey( int keynum ) {
+	static const struct {
+		const char *key;
+		const char *spoken;
+	} names[] = {
+		{ "PGDN", "Page Down" }, { "PGUP", "Page Up" }, { "DEL", "Delete" }, { "INS", "Insert" },
+		{ "HOME", "Home" }, { "END", "End" }, { "UPARROW", "Up arrow" }, { "DOWNARROW", "Down arrow" },
+		{ "LEFTARROW", "Left arrow" }, { "RIGHTARROW", "Right arrow" }, { "SPACE", "Space" },
+		{ "CTRL", "Control" }, { "ALT", "Alt" }, { "SHIFT", "Shift" }, { "ENTER", "Enter" },
+		{ "TAB", "Tab" }, { "BACKSPACE", "Backspace" }, { "ESCAPE", "Escape" }, { "PAUSE", "Pause" },
+		{ "CAPSLOCK", "Caps Lock" }, { "COMMAND", "Command" },
+		{ "MOUSE1", "Left mouse button" }, { "MOUSE2", "Right mouse button" },
+		{ "MOUSE3", "Middle mouse button" }, { "MOUSE4", "Mouse button 4" }, { "MOUSE5", "Mouse button 5" },
+		{ "MWHEELUP", "Mouse wheel up" }, { "MWHEELDOWN", "Mouse wheel down" },
+		{ "KP_HOME", "Keypad 7" }, { "KP_UPARROW", "Keypad 8" }, { "KP_PGUP", "Keypad 9" },
+		{ "KP_LEFTARROW", "Keypad 4" }, { "KP_5", "Keypad 5" }, { "KP_RIGHTARROW", "Keypad 6" },
+		{ "KP_END", "Keypad 1" }, { "KP_DOWNARROW", "Keypad 2" }, { "KP_PGDN", "Keypad 3" },
+		{ "KP_INS", "Keypad 0" }, { "KP_DEL", "Keypad period" }, { "KP_ENTER", "Keypad Enter" },
+		{ "KP_SLASH", "Keypad slash" }, { "KP_MINUS", "Keypad minus" }, { "KP_PLUS", "Keypad plus" },
+		{ "KP_STAR", "Keypad star" }, { "SEMICOLON", "Semicolon" },
+		{ "\\", "Backslash" }, { "/", "Slash" }, { "=", "Equals" }, { "-", "Minus" },
+		{ ",", "Comma" }, { ".", "Period" }, { "[", "Left bracket" }, { "]", "Right bracket" },
+		{ "'", "Apostrophe" }, { "`", "Grave" }, { ";", "Semicolon" },
+	};
+	static char buf[2][32];
+	static int which;
+	char *out = buf[which ^= 1];
+	int i;
+
+	DC->keynumToStringBuf( keynum, out, 32 );
+	for ( i = 0; i < (int)( sizeof( names ) / sizeof( names[0] ) ); i++ ) {
+		if ( !Q_stricmp( out, names[i].key ) ) {
+			return names[i].spoken;
+		}
+	}
+	if ( out[0] && !out[1] ) {
+		out[0] = (char)toupper( (unsigned char)out[0] );
+	}
+	return out;
+}
