+/*
+ * The Accessibility pages: the mode's settings, as the ET mode keeps its
+ * own under ACCESSIBILITY - so the tester turns a callout or a sound off
+ * there, not with a key or the console.
+ *
+ * The pages are the mode's own file, in its pk3. The button that opens
+ * them goes into the game's menus as they load - after OPTIONS in the
+ * main menu, after SYSTEM among the paused game's tabs - from the mode's
+ * ui/accessibility_tabs.menu: the game's menu files are the game's, and
+ * are not shipped. It is placed after the item it follows, so the arrows
+ * come to it there. The game's other buttons close the pages as they open
+ * their own, as they do each other's.
+ */
+static const char *eta_accessibilityMenus[] = {
+	"eta_accessibility", "eta_acc_told", "eta_acc_sounds", "eta_acc_volumes", "eta_acc_moving"
+};
+
+#define ETA_ACCESSIBILITY_TAB "eta_accessibility_tab"
+
+static void UI_AccessibilityCloseMenus( void ) {
+	int i;
+
+	for ( i = 0; i < (int)ARRAY_LEN( eta_accessibilityMenus ); i++ ) {
+		Menus_CloseByName( eta_accessibilityMenus[i] );
+	}
+}
+
+/* Back out of the pages, to the menu they were opened from: the paused
+   game's, or the main menu. */
+static void UI_AccessibilityLeave( void ) {
+	menuDef_t *ingame = Menus_FindByName( "ingame" );
+
+	UI_AccessibilityCloseMenus();
+	Menus_ActivateByName( ingame && ( ingame->window.flags & WINDOW_VISIBLE ) ? "ingame" : "main" );
+}
+
+/* Reads past one { } block, for a tab whose menu is not loaded. */
+static void UI_AccessibilitySkipBlock( int handle ) {
+	pc_token_t token;
+	int depth = 0;
+
+	while ( trap_PC_ReadToken( handle, &token ) ) {
+		if ( token.string[0] == '{' ) {
+			depth++;
+		} else if ( token.string[0] == '}' && --depth <= 0 ) {
+			return;
+		}
+	}
+}
+
+static void UI_AccessibilityAddTab( menuDef_t *menu, const char *after, int handle ) {
+	itemDef_t *tab;
+	int i, at = -1;
+
+	if ( !MenuParse_itemDef( (itemDef_t*)menu, handle ) || menu->itemCount <= 0 ) {
+		return;
+	}
+	tab = menu->items[menu->itemCount - 1];
+	tab->window.name = String_Alloc( ETA_ACCESSIBILITY_TAB );
+	Item_UpdatePosition( tab );
+
+	/* Next after the tab it follows. */
+	for ( i = 0; i < menu->itemCount - 1; i++ ) {
+		if ( menu->items[i]->window.name && !Q_stricmp( menu->items[i]->window.name, after ) ) {
+			at = i + 1;
+		}
+	}
+	if ( at >= 0 ) {
+		for ( i = menu->itemCount - 1; i > at; i-- ) {
+			menu->items[i] = menu->items[i - 1];
+		}
+		menu->items[at] = tab;
+	}
+
+	/* The game's other tabs close the pages, as they close each other's. */
+	for ( i = 0; i < menu->itemCount; i++ ) {
+		itemDef_t *item = menu->items[i];
+
+		if ( item != tab && item->action && Q_stristr( item->action, "open " ) ) {
+			item->action = String_Alloc( va( "%s ; uiScript etaAccessibilityClose", item->action ) );
+		}
+	}
+}
+
+static void UI_AccessibilityMenus( void ) {
+	pc_token_t token;
+	int handle;
+
+	if ( !Menus_FindByName( "eta_accessibility" ) ) {
+		UI_ParseMenu( "ui/accessibility.menu" );
+	}
+
+	handle = trap_PC_LoadSource( "ui/accessibility_tabs.menu" );
+	if ( !handle ) {
+		return;
+	}
+	/* tab <menu> <item it follows> itemDef { ... } */
+	while ( trap_PC_ReadToken( handle, &token ) ) {
+		char name[64], after[64];
+		menuDef_t *menu;
+
+		if ( token.string[0] == '{' ) {
+			continue;
+		}
+		if ( token.string[0] == '}' || Q_stricmp( token.string, "tab" ) ) {
+			break;
+		}
+		if ( !trap_PC_ReadToken( handle, &token ) ) {
+			break;
+		}
+		Q_strncpyz( name, token.string, sizeof( name ) );
+		if ( !trap_PC_ReadToken( handle, &token ) ) {
+			break;
+		}
+		Q_strncpyz( after, token.string, sizeof( after ) );
+		if ( !trap_PC_ReadToken( handle, &token ) || Q_stricmp( token.string, "itemDef" ) ) {
+			break;
+		}
+
+		menu = Menus_FindByName( name );
+		if ( !menu || Menu_FindItemByName( menu, ETA_ACCESSIBILITY_TAB ) ) {
+			UI_AccessibilitySkipBlock( handle );
+			continue;
+		}
+		UI_AccessibilityAddTab( menu, after, handle );
+	}
+	trap_PC_FreeSource( handle );
+}
+
 static void UI_AccessibilityMenuOpened( menuDef_t *menu ) {
 	char text[4096];
 	const char *name = menu->window.name;
