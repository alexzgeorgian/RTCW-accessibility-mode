+/*
+ * name:	cg_accessibility_settings.h
+ *
+ * desc:	[Accessibility]: the mode's settings, by cvar and default.
+ *			Included by the cgame, which reads them, and by the ui, whose
+ *			Accessibility pages (release/rtcw/ui/accessibility.menu) set
+ *			them - so the menus show the right value before a mission has
+ *			ever loaded the cgame, and the two cannot disagree on a
+ *			default. Each line is ETA_SETTING( cvar, default ).
+ */
+
+ETA_SETTING( eta_environmentCallouts, "1" )
