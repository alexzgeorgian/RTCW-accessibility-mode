+			                  (int)(rise * ETA_QU_TO_METERS + 0.5f)));
+		}
+		else
+		{
+			ETA_Speech_Say(ladder->goesUp ? "Climbing up" : "Climbing down");
+		}
+		ETA_Speech_EndReport();
+	}
 }
 
