+	/* How far, so the climb is not heard as endless: the tester, on a
+	   twelve meter ladder, wondered why it took so long. The game climbs
+	   about three meters a second. */
+	{
+		const float *me = cg.predictedPlayerState.origin;
+		vec3_t      foot, top;
+		float       best = 96.0f, rise = 0.0f;
+		int         i;
+
+		for (i = 0; i < CG_AccessibilityLadderCount(); i++)
+		{
+			float near;
+
+			if (!CG_AccessibilityLadderEnds(i, foot, top))
