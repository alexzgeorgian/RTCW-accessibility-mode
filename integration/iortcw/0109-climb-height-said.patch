+				best = near;
+				rise = ladder->goesUp ? top[2] - me[2] : me[2] - foot[2];
+			}
+		}
+
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_BeginReport();
+		if (rise * ETA_QU_TO_METERS >= 1.5f)
