+/* How far a place is from the way out, in metres, a floor up or down
+   counting double. */
+#define ETA_ONWARD_METERS 5.0f
+
+static float ETA_WayOutFar(const vec3_t from, const vec3_t exitPoint)
+{
+	float dx = exitPoint[0] - from[0], dy = exitPoint[1] - from[1], dz = exitPoint[2] - from[2];
+
+	return (sqrtf(dx * dx + dy * dy) + 2.0f * fabsf(dz)) * ETA_QU_TO_METERS;
+}
