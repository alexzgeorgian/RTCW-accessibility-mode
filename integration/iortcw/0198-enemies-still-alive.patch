@@ -1224,6 +1224,86 @@ void CG_AccessibilityEnemyPrev_f(void)
 
 /* Turns to a thing to use and says what it is - or, with no label,
    quietly, leaving the game's own use icon to name it. */
+/*
+ * No enemy in sight: those still alive in the level, from the server -
+ * how many of each kind, and the nearest, chosen for O. The tester could
+ * not leave the church, its last objective counting twenty Elite guards
+ * dead, with four still alive in rooms left behind.
+ */
+static void ETA_EnemiesElsewhereSay(void)
+{
+	const char *list = CG_ConfigString(CS_ETA_ENEMIES);
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int         kinds[64], counts[64], nk = 0, total = 0, i;
+	int         nearChar = 0;
+	float       nearDist = 1.0e9f;
+	vec3_t      nearAt;
+	char        text[512];
+
+	while (list && *list)
+	{
+		int    c;
+		vec3_t at;
+
+		if (sscanf(list, "%d %f %f %f", &c, &at[0], &at[1], &at[2]) == 4)
+		{
+			for (i = 0; i < nk && kinds[i] != c; i++)
+			{
+			}
+			if (i == nk && nk < 64)
+			{
+				kinds[nk] = c;
+				counts[nk++] = 0;
+			}
+			if (i < nk)
+			{
+				counts[i]++;
+			}
+			total++;
+			if (Distance(at, ps->origin) < nearDist)
+			{
+				nearDist = Distance(at, ps->origin);
+				nearChar = c;
+				VectorCopy(at, nearAt);
+			}
+		}
+		list = strchr(list, ';');
+		if (list)
+		{
+			list++;
+		}
+	}
+	ETA_HudNarrator_HoldPassive(cg.time);
+	if (!total)
+	{
+		ETA_Speech_Say("No enemy in sight, and none left alive that the level has brought in yet");
+		return;
+	}
+	Q_strncpyz(text, "No enemy in sight. Still alive in the level: ", sizeof(text));
+	for (i = 0; i < nk; i++)
+	{
+		const char *name = CG_AccessibilityAiCharName(kinds[i]);
+
+		Q_strcat(text, sizeof(text), va("%s%d %s%s", i ? ", " : "", counts[i], name,
+		                                 counts[i] > 1 && name[strlen(name) - 1] != 's' ? "s" : ""));
+	}
+	{
+		vec3_t to;
+		int    meters, below;
+
+		VectorSubtract(nearAt, ps->origin, to);
+		meters = (int)( nearDist * ETA_QU_TO_METERS + 0.5f );
+		below  = (int)( -to[2] * ETA_QU_TO_METERS + ( to[2] < 0 ? 0.5f : -0.5f ) );
+		Q_strcat(text, sizeof(text), va(". The nearest, %s, %d meters, %s%s. O leads there",
+		                                 CG_AccessibilityAiCharName(nearChar), meters,
+		                                 ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(nearAt)),
+		                                 below >= 2 ? va(", %d meters below you", below)
+		                                 : below <= -2 ? va(", %d meters above you", -below) : ""));
+		CG_AccessibilityChoose(nearAt, va("the nearest %s still alive", CG_AccessibilityAiCharName(nearChar)));
+	}
+	ETA_Speech_Say(text);
+}
+
 static void ETA_AimStartSnap(const etaAimTarget_t *target, const char *label)
 {
