diff --git a/SP/code/game/g_main.c b/SP/code/game/g_main.c
index 82d03846..1bd2336b 100644
--- a/SP/code/game/g_main.c
+++ b/SP/code/game/g_main.c
@@ -2518,6 +2518,38 @@ static void G_AccessibilityTriggers( void ) {
 	if ( strcmp( state, sent ) ) {
 		trap_SetConfigstring( CS_ETA_TRIGGERS, state );
 	}
+
+	/*
+	 * The enemies alive in the level and in it now - spawned, not yet
+	 * killed - with what each is and where: "aichar x y z;" each. The
+	 * tester could not leave the church, its last objective counting
+	 * twenty Elite guards dead, and did not know four were still alive
+	 * in rooms they had left behind: the client knows only those in its
+	 * sight. Not the allies (team 1) nor the neutral (7).
+	 */
+	{
+		char list[1024], one[48], was[1024];
+		int  n = 0;
+
+		list[0] = '\0';
+		for ( i = 0, ent = g_entities; i < level.maxclients && n < 40; i++, ent++ ) {
+			if ( !ent->inuse || !( ent->r.svFlags & SVF_CASTAI ) || !ent->r.linked || ent->health <= 0
+				 || ent->aiTeam == 1 || ent->aiTeam == 7 ) {
+				continue;
+			}
+			Com_sprintf( one, sizeof( one ), "%d %d %d %d;", ent->aiCharacter, (int)ent->r.currentOrigin[0],
+						 (int)ent->r.currentOrigin[1], (int)ent->r.currentOrigin[2] );
+			if ( strlen( list ) + strlen( one ) >= sizeof( list ) ) {
+				break;
+			}
+			Q_strcat( list, sizeof( list ), one );
+			n++;
+		}
+		trap_GetConfigstring( CS_ETA_ENEMIES, was, sizeof( was ) );
+		if ( strcmp( list, was ) ) {
+			trap_SetConfigstring( CS_ETA_ENEMIES, list );
+		}
+	}
 }
 #endif
 
