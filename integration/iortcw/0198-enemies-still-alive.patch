+/* What a character is called, by its kind alone: for the enemies alive
+   elsewhere in the level, which the client does not see. */
+const char *CG_AccessibilityAiCharName(int aiChar)
+{
+	entityState_t es;
+
+	memset(&es, 0, sizeof(es));
+	es.aiChar = aiChar;
+	return ETA_CharacterKind(&es);
+}
