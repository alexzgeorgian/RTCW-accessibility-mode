+/* The nearest thing to break come across, within so far and in sight:
+   its place and name. */
+qboolean CG_AccessibilityThingsBreakableNear(float within, vec3_t out, char *name, size_t size)
+{
+	int   i, best = -1;
+	float bestFar = within;
+
+	for (i = 0; i < eta_things.count; i++)
+	{
+		const eta_thing_t *thing = &eta_things.things[i];
+		float             far;
+
+		if (thing->kind != ETA_THING_BREAKABLE || thing->done || !thing->known)
+		{
+			continue;
+		}
+		far = Distance(cg.predictedPlayerState.origin, thing->point);
+		if (far < bestFar && ETA_ThingHereInSight(thing->point))
+		{
+			best    = i;
+			bestFar = far;
+		}
+	}
+	if (best < 0)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_things.things[best].point, out);
+	Q_strncpyz(name, eta_things.things[best].name, size);
+	return qtrue;
+}
