diff --git a/SP/code/ui/ui_main.c b/SP/code/ui/ui_main.c
index 4a970560..b0ce79a1 100644
--- a/SP/code/ui/ui_main.c
+++ b/SP/code/ui/ui_main.c
@@ -8202,6 +8202,26 @@ void UI_AccessibilityInstallBinds( void ) {
 		trap_Cvar_Set( "eta_bindsInstalled", va( "%i", newest ) );
 	}
 
+	/* U was the step back through the enemies before it was the lock,
+	   and the tester, pressing it to be turned to an enemy, heard only
+	   where the enemy was: the key had kept its old command. Wherever U
+	   is still on that, it is moved on to the lock, every time - and
+	   the step goes to Y where Y is free. */
+	{
+		char current[MAX_STRING_CHARS];
+
+		current[0] = '\0';
+		trap_Key_GetBindingBuf( 'u', current, sizeof( current ) );
+		if ( !Q_stricmp( current, "accessibilityEnemyPrev" ) ) {
+			trap_Key_SetBinding( 'u', "accessibilityEnemyLock" );
+			current[0] = '\0';
+			trap_Key_GetBindingBuf( 'y', current, sizeof( current ) );
+			if ( !current[0] ) {
+				trap_Key_SetBinding( 'y', "accessibilityEnemyPrev" );
+			}
+		}
+	}
+
 	/* The controls page keeps its own copy of which key each command is
 	   on, read at start-up. Left stale, the first key changed there would
 	   write that copy back over what was just installed. */
