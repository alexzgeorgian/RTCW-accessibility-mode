-static void ETA_AimSay(const char *what, const vec3_t point)
+/* What, which way, how far, how far up or down - and then the tail,
+   if any: "Soldier, 1 of 2, behind left, 12 meters. U turns to them". */
+static void ETA_AimSayThen(const char *what, const vec3_t point, const char *tail)
 {
 	int  meters = (int)(Distance(cg.predictedPlayerState.origin, point) * ETA_QU_TO_METERS + 0.5f);
 	char height[48];
@@ -609,13 +611,18 @@ static void ETA_AimSay(const char *what, const vec3_t point)
