+/*
+ * For M: what a sighted player would see, after the ground ahead - to the
+ * left, ahead and to the right, what the eye meets and how far, the way
+ * the binoculars name a thing; then what is to use and who is in view,
+ * with where and how far. The tester asked for M to describe the place as
+ * a sighted player sees it.
+ */
+#define ETA_VIEW_RANGE 1600.0f   /* about forty metres */
+
+static void ETA_ViewLook(const vec3_t eye, float yaw, char *out, size_t size)
+{
+	vec3_t  dir, end;
+	trace_t tr;
+	int     meters;
+
+	VectorSet(dir, cosf(DEG2RAD(yaw)), sinf(DEG2RAD(yaw)), 0.0f);
+	VectorMA(eye, ETA_VIEW_RANGE, dir, end);
+	CG_Trace(&tr, eye, NULL, NULL, end, cg.snap->ps.clientNum, MASK_SHOT);
+	if (tr.fraction >= 1.0f || ( tr.surfaceFlags & SURF_SKY ))
+	{
+		Q_strncpyz(out, "open", size);
+		return;
+	}
+	meters = (int)( Distance(eye, tr.endpos) * ETA_QU_TO_METERS + 0.5f );
+	ETA_DescribeTraceHit(&tr, out, size);
+	out[0] = (char)tolower((unsigned char)out[0]);
+	Q_strcat(out, size, va(", %d %s", meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters"));
+}
+
+void CG_AccessibilityViewText(char *out, size_t size)
+{
+	static const struct
+	{
+		float       off;
+		const char *where;
+	} looks[] = {
+		{ 60.0f, "Left" }, { 30.0f, "ahead left" }, { 0.0f, "ahead" },
+		{ -30.0f, "ahead right" }, { -60.0f, "right" },
+	};
+	const playerState_t *ps = &cg.predictedPlayerState;
+	etaAimTarget_t       list[16];
+	vec3_t               eye;
+	char                 seen[5][96];
+	int                  i, count, said = 0;
+
+	out[0] = '\0';
+	if (!cg.snap)
+	{
+		return;
+	}
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+
+	/* Left to right, a look each way, the same thing said once. */
+	for (i = 0; i < (int)ARRAY_LEN(looks); i++)
+	{
+		ETA_ViewLook(eye, ps->viewangles[YAW] + looks[i].off, seen[i], sizeof(seen[i]));
+	}
+	for (i = 0; i < (int)ARRAY_LEN(looks); i++)
+	{
+		Q_strcat(out, size, va("%s%s: %s", i ? "; " : "", looks[i].where, seen[i]));
+	}
+	Q_strcat(out, size, ".");
+
+	/* Things to use, and people, in view: in front, and not behind a wall. */
+	count = CG_AccessibilityUseTargets(list, ARRAY_LEN(list));
+	count += CG_AccessibilityEnemyTargets(list + count, ARRAY_LEN(list) - count, qfalse);
+	for (i = 0; i < count && said < 4; i++)
+	{
+		float   left = CG_AccessibilityLeftOfView(list[i].point);
+		trace_t tr;
+
+		if (fabsf(left) > 50.0f || list[i].meters > 40.0f || !list[i].name[0])
+		{
+			continue;
+		}
+		CG_Trace(&tr, eye, NULL, NULL, list[i].point, ps->clientNum, MASK_SOLID);
+		if (tr.fraction < 0.97f)
+		{
+			continue;
+		}
+		Q_strcat(out, size, va("%s%s, %s, %d %s", said ? "; " : " In view: ", list[i].name,
+		                       ETA_HudNarrator_RelativeDirection(left),
+		                       (int)( list[i].meters + 0.5f ) < 1 ? 1 : (int)( list[i].meters + 0.5f ),
+		                       (int)( list[i].meters + 0.5f ) <= 1 ? "meter" : "meters"));
+		said++;
+	}
+	if (said)
+	{
+		Q_strcat(out, size, ".");
+	}
+}
