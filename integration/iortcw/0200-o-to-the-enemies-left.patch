+/* The first objective not met, from 1, or 0 with none left. */
+int CG_AccessibilityFirstObjectiveLeft( void ) {
+	int i, count = CG_AccessibilityObjectiveCount(), bits = CG_AccessibilityObjectiveBits();
+
+	for ( i = 0; i < count && i < ETA_MAX_OBJECTIVES; i++ ) {
+		if ( !( bits & ( 1 << i ) ) ) {
+			return i + 1;
+		}
+	}
+	return 0;
+}
