-			trap_SendConsoleCommand("+forward\n+sprint\n");
+			trap_SendConsoleCommand(eta_cross.walking ? "+speed\n+forward\n" : "+forward\n+sprint\n");
 			eta_cross.stage      = 3;
 			eta_cross.stageAt    = cg.time;
