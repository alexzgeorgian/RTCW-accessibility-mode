+/*
+ * Round the plates. The crypt's saws only cut when a plate on the floor
+ * sets them off - three of them, by the north wall, the south wall and
+ * in the middle - and the test player, told the wall to keep to plate by
+ * plate, drifted onto one and was cut down. Across them, then, by a way
+ * that touches none: the floor on a grid, each plate and a body's width
+ * round it kept off, the walls too, and the way found taken at a walk,
+ * corner to corner. The saws never start.
+ */
+#define ETA_CROSS_CELL   8.0f
+#define ETA_CROSS_GRID   128
+
+static int ETA_CrossPlanPath(const vec3_t from, const vec3_t to, vec3_t *out, int max)
+{
+	static short     prev[ETA_CROSS_GRID * ETA_CROSS_GRID];
+	static int       queue[ETA_CROSS_GRID * ETA_CROSS_GRID];
+	static qboolean  blocked[ETA_CROSS_GRID * ETA_CROSS_GRID];
+	static const vec3_t probeMins = { -16.0f, -16.0f, -6.0f }, probeMaxs = { 16.0f, 16.0f, 24.0f };
+	vec3_t           pmins[16], pmaxs[16], lo;
+	int              plates = 0, i, w, h, x, y, start, goal, head = 0, tail = 0, cells[ETA_CROSS_GRID * 2], n = 0, k;
+
+	for (i = 0; plates < 16 && CG_AccessibilityPlateBox(i, pmins[plates], pmaxs[plates]); i++)
+	{
+		/* Near the way, on its floor. */
+		if (pmaxs[plates][0] < MIN(from[0], to[0]) - 64.0f || pmins[plates][0] > MAX(from[0], to[0]) + 64.0f
+		    || pmaxs[plates][1] < MIN(from[1], to[1]) - 160.0f || pmins[plates][1] > MAX(from[1], to[1]) + 160.0f
+		    || fabsf(pmaxs[plates][2] - ( from[2] - 24.0f )) > 48.0f)
+		{
+			continue;
+		}
+		plates++;
+	}
+	if (!plates)
+	{
+		return 0;
+	}
+	lo[0] = MIN(from[0], to[0]) - 160.0f;
+	lo[1] = MIN(from[1], to[1]) - 160.0f;
+	lo[2] = from[2];
+	w     = (int)( ( fabsf(to[0] - from[0]) + 320.0f ) / ETA_CROSS_CELL ) + 1;
+	h     = (int)( ( fabsf(to[1] - from[1]) + 320.0f ) / ETA_CROSS_CELL ) + 1;
+	if (w > ETA_CROSS_GRID || h > ETA_CROSS_GRID)
+	{
+		return -1;
+	}
+	for (y = 0; y < h; y++)
+	{
+		for (x = 0; x < w; x++)
+		{
+			vec3_t  at, down;
+			trace_t trace;
+			int     p;
+
+			at[0] = lo[0] + x * ETA_CROSS_CELL;
+			at[1] = lo[1] + y * ETA_CROSS_CELL;
+			at[2] = lo[2];
+			blocked[y * w + x] = qfalse;
+			for (p = 0; p < plates && !blocked[y * w + x]; p++)
+			{
+				blocked[y * w + x] = (qboolean)( at[0] > pmins[p][0] - 22.0f && at[0] < pmaxs[p][0] + 22.0f
+				                                 && at[1] > pmins[p][1] - 22.0f && at[1] < pmaxs[p][1] + 22.0f );
+			}
+			if (blocked[y * w + x])
+			{
+				continue;
+			}
+			trap_CM_BoxTrace(&trace, at, at, probeMins, probeMaxs, 0, MASK_PLAYERSOLID);
+			if (trace.startsolid || trace.allsolid)
+			{
+				blocked[y * w + x] = qtrue;
+				continue;
+			}
+			VectorCopy(at, down);
+			down[2] -= 64.0f;
+			trap_CM_BoxTrace(&trace, at, down, probeMins, probeMaxs, 0, MASK_PLAYERSOLID);
+			blocked[y * w + x] = (qboolean)( trace.fraction >= 1.0f );
+			prev[y * w + x]    = -1;
+		}
+	}
+	start = (int)( ( from[1] - lo[1] ) / ETA_CROSS_CELL + 0.5f ) * w + (int)( ( from[0] - lo[0] ) / ETA_CROSS_CELL + 0.5f );
+	goal  = (int)( ( to[1] - lo[1] ) / ETA_CROSS_CELL + 0.5f ) * w + (int)( ( to[0] - lo[0] ) / ETA_CROSS_CELL + 0.5f );
+	/* An end on a plate, or by one: on past it, the way it goes. */
+	{
+		float dx = to[0] - from[0], dy = to[1] - from[1], len = sqrtf(dx * dx + dy * dy);
+		int   step;
+
+		for (step = 1; goal >= 0 && goal < w * h && blocked[goal] && step <= 16 && len > 1.0f; step++)
+		{
+			int gx = (int)( ( to[0] + dx / len * step * ETA_CROSS_CELL - lo[0] ) / ETA_CROSS_CELL + 0.5f );
+			int gy = (int)( ( to[1] + dy / len * step * ETA_CROSS_CELL - lo[1] ) / ETA_CROSS_CELL + 0.5f );
+
+			if (gx < 0 || gy < 0 || gx >= w || gy >= h)
+			{
+				break;
+			}
+			goal = gy * w + gx;
+		}
+	}
+	if (start < 0 || start >= w * h || goal < 0 || goal >= w * h || blocked[goal])
+	{
+		return -1;
+	}
+	for (i = 0; i < w * h; i++)
+	{
+		prev[i] = -1;
+	}
+	blocked[start] = qfalse;
+	prev[start]    = (short)start;
+	queue[tail++]  = start;
+	while (head < tail && prev[goal] < 0)
+	{
+		int c = queue[head++], dx, dy;
+
+		for (dy = -1; dy <= 1; dy++)
+		{
+			for (dx = -1; dx <= 1; dx++)
+			{
+				int nx = c % w + dx, ny = c / w + dy, nc = ny * w + nx;
+
+				if (( !dx && !dy ) || nx < 0 || ny < 0 || nx >= w || ny >= h || blocked[nc] || prev[nc] >= 0)
+				{
+					continue;
+				}
+				/* No corner cut past a plate or a wall. */
+				if (dx && dy && ( blocked[c / w * w + nx] || blocked[ny * w + c % w] ))
+				{
+					continue;
+				}
+				prev[nc]      = (short)c;
+				queue[tail++] = nc;
+			}
+		}
+	}
+	if (prev[goal] < 0)
+	{
+		return -1;
+	}
+	/* Back from the end, then the corners kept: the fewest straight runs
+	   that stay on free cells. */
+	for (i = goal; n < (int)ARRAY_LEN(cells); i = prev[i])
+	{
+		cells[n++] = i;
+		if (i == start)
+		{
+			break;
+		}
+	}
+	k = 0;
+	{
+		int at = n - 1;   /* cells[n - 1] is the start */
+
+		while (at > 0 && k < max)
+		{
+			int best = at - 1, j;
+
+			for (j = 0; j < at; j++)
+			{
+				int   a = cells[at], b = cells[j], steps, s;
+				float ax = a % w, ay = a / w, bx = b % w, by = b / w;
+				qboolean clear = qtrue;
+
+				steps = (int)( MAX(fabsf(bx - ax), fabsf(by - ay)) * 2.0f ) + 1;
+				for (s = 0; s <= steps && clear; s++)
+				{
+					int cx = (int)( ax + ( bx - ax ) * s / steps + 0.5f ), cy = (int)( ay + ( by - ay ) * s / steps + 0.5f );
+
+					clear = (qboolean)!blocked[cy * w + cx];
+				}
+				if (clear)
+				{
+					best = j;
+					break;
+				}
+			}
+			out[k][0] = lo[0] + ( cells[best] % w ) * ETA_CROSS_CELL;
+			out[k][1] = lo[1] + ( cells[best] / w ) * ETA_CROSS_CELL;
+			out[k][2] = from[2];
+			k++;
+			at = best;
+		}
+	}
+	return k;
+}
