diff --git a/SP/code/game/ai_cast_sight.c b/SP/code/game/ai_cast_sight.c
index de45edc2..0c03a991 100644
--- a/SP/code/game/ai_cast_sight.c
+++ b/SP/code/game/ai_cast_sight.c
@@ -776,3 +776,98 @@ escape:
 	}
 	lastdest = dest;
 }
+
+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * [Accessibility]: which soldiers could see the player now and have not
+ * yet - the guard looking their way. A sighted player sees a guard turn
+ * toward them and stops or backs off before he notices; the tester,
+ * blind, in the forest where an alarm sounded fails the mission, found
+ * no way past the bridge and could not tell who was looking. The same
+ * test the soldier's own eyes make (AICast_CheckVisibility: how far he
+ * sees, his field of view, a clear line), told to the client as
+ * "etawatch" and the soldiers' numbers whenever the set changes; it
+ * changes nothing in the soldiers. Said by cg_accessibility_world.c.
+ */
+static qboolean AICast_EtaCouldSee( gentity_t *src, gentity_t *dest ) {
+	cast_state_t *cs = AICast_GetCastState( src->s.number );
+	cast_visibility_t *vis = &cs->vislist[dest->s.number];
+	vec3_t middle, eye, viewangles, dir, entangles;
+	orientation_t or;
+	float fov;
+
+	fov = cs->attributes[FOV] * aiStateFovScales[cs->aiState];
+	if ( !fov ) {
+		fov = 180;
+	}
+	if ( cs->aiFlags & AIFL_ZOOMING ) {
+		fov *= 0.8;
+	} else if ( cs->lastEnemy >= 0 && fov < 270 ) {
+		fov = 270;
+	}
+	if ( cs->aiState >= AISTATE_ALERT && vis->visible_timestamp == vis->lastcheck_timestamp ) {
+		fov = 360;
+	}
+	VectorAdd( dest->r.mins, dest->r.maxs, middle );
+	VectorScale( middle, 0.5, middle );
+	VectorAdd( dest->client->ps.origin, middle, middle );
+	if ( trap_GetTag( src->s.number, "tag_head", &or ) ) {
+		vectoangles( or.axis[0], viewangles );
+		VectorCopy( or.origin, eye );
+		VectorMA( eye, 12, or.axis[2], eye );
+	} else {
+		VectorCopy( src->client->ps.origin, eye );
+		eye[2] += src->client->ps.viewheight;
+		VectorCopy( src->client->ps.viewangles, viewangles );
+	}
+	VectorSubtract( middle, eye, dir );
+	vectoangles( dir, entangles );
+	if ( VectorLength( dir ) > cs->attributes[ALERTNESS] ) {
+		return qfalse;
+	}
+	if ( !AICast_InFieldOfVision( viewangles, fov, entangles ) ) {
+		return qfalse;
+	}
+	return AICast_VisibleFromPos( src->client->ps.origin, src->s.number, dest->client->ps.origin, dest->s.number, qfalse );
+}
+
+void AICast_EtaWatchers( void ) {
+	static int lastCheck;
+	static char lastSent[MAX_STRING_CHARS];
+	char list[MAX_STRING_CHARS];
+	gentity_t *player = &g_entities[0];
+	int i;
+
+	if ( g_gametype.integer != GT_SINGLE_PLAYER || !player->inuse || !player->client ) {
+		return;
+	}
+	if ( level.time >= lastCheck && level.time - lastCheck < 200 ) {
+		return;
+	}
+	lastCheck = level.time;
+	list[0] = 0;
+	if ( player->health > 0 && !( player->flags & FL_NOTARGET )
+		 && player->client->pers.connected == CON_CONNECTED
+		 && !( level.lastLoadTime && level.lastLoadTime > level.time - 2000 ) ) {
+		for ( i = 1; i < level.maxclients; i++ ) {
+			gentity_t *e = &g_entities[i];
+			cast_state_t *cs;
+
+			if ( !e->inuse || !e->client || !( e->r.svFlags & SVF_CASTAI ) || e->health <= 0 ) {
+				continue;
+			}
+			cs = AICast_GetCastState( i );
+			if ( !cs || !cs->bs || cs->aiState >= AISTATE_COMBAT || AICast_SameTeam( cs, 0 ) ) {
+				continue;
+			}
+			if ( AICast_EtaCouldSee( e, player ) ) {
+				Q_strcat( list, sizeof( list ), va( " %d", i ) );
+			}
+		}
+	}
+	if ( strcmp( list, lastSent ) ) {
+		Q_strncpyz( lastSent, list, sizeof( lastSent ) );
+		trap_SendServerCommand( 0, va( "etawatch%s", list ) );
+	}
+}
+#endif
