diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 005919b7..80a62f41 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -3447,6 +3447,177 @@ static void ETA_AwareSeenWatch(void)
 	}
 }
 
+/*
+ * A guard looking the player's way: "Soldier looking your way, ahead
+ * left, 52 meters, 18 meters above you". The game tells which soldiers
+ * could see the player now and have not yet ("etawatch", ai_cast_sight.c)
+ * - what a sighted player sees as a guard turning toward them, near or
+ * far, a tower sniper as much as one on the road. Said once for each as
+ * he turns their way; again only after a while, a guard sweeping with
+ * binoculars being "back in view" in between. "Out of view" when none
+ * is looking any more.
+ */
+#define ETA_WATCH_AGAIN_MS 10000
+
+static qboolean eta_watching[MAX_CLIENTS];
+static int      eta_watchSaidAt[MAX_CLIENTS];
+static qboolean eta_watchSaid;
+
+static const char *ETA_WatchWhere(int entityNum)
+{
+	const centity_t *cent = &cg_entities[entityNum];
+	float           up    = (cent->lerpOrigin[2] - cg.snap->ps.origin[2]) * ETA_QU_TO_METERS;
+	int             meters = (int)(Distance(cent->lerpOrigin, cg.snap->ps.origin) * ETA_QU_TO_METERS + 0.5f);
+	int             rise   = (int)(fabsf(up) + 0.5f);
+
+	return va("%s, %d %s%s", ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(cent->lerpOrigin)),
+	          meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters",
+	          rise < 3 ? "" : va(", %d meters %s you", rise, up > 0 ? "above" : "below"));
+}
+
+void CG_AccessibilityWatchers(void)
+{
+	qboolean now[MAX_CLIENTS];
+	int      i, n = trap_Argc(), count = 0, fresh = -1, again = -1;
+	float    freshFar = 1.0e9f;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+	memset(now, 0, sizeof(now));
+	for (i = 1; i < n; i++)
+	{
+		char arg[16];
+		int  e;
+
+		trap_Argv(i, arg, sizeof(arg));
+		e = atoi(arg);
+		if (e > 0 && e < MAX_CLIENTS && e != cg.snap->ps.clientNum && cg_entities[e].currentValid
+		    && ETA_SeenAsEnemy(&cg_entities[e].currentState))
+		{
+			now[e] = qtrue;
+		}
+	}
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		float far;
+
+		if (!now[i])
+		{
+			continue;
+		}
+		count++;
+		if (eta_watching[i])
+		{
+			continue;
+		}
+		if (eta_watchSaidAt[i] && cg.time >= eta_watchSaidAt[i] && cg.time - eta_watchSaidAt[i] < ETA_WATCH_AGAIN_MS)
+		{
+			again = i;
+			continue;
+		}
+		far = Distance(cg_entities[i].lerpOrigin, cg.snap->ps.origin);
+		if (far < freshFar)
+		{
+			freshFar = far;
+			fresh    = i;
+		}
+	}
+	if (fresh >= 0)
+	{
+		for (i = 0; i < MAX_CLIENTS; i++)
+		{
+			if (now[i] && !eta_watching[i])
+			{
+				eta_watchSaidAt[i] = cg.time;
+			}
+		}
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(va("%s looking your way, %s%s", ETA_CharacterKind(&cg_entities[fresh].currentState),
+		                  ETA_WatchWhere(fresh), count > 1 ? va(". %d looking", count) : ""));
+		eta_watchSaid = qtrue;
+	}
+	else if (again >= 0)
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say("Back in view");
+		eta_watchSaid = qtrue;
+	}
+	else if (!count && eta_watchSaid)
+	{
+		/* One who has seen the player leaves the list, being past
+		   looking: "has seen you" has said so, and he is not out of
+		   view. */
+		for (i = 0; i < MAX_CLIENTS; i++)
+		{
+			if (eta_watching[i] && cg_entities[i].currentValid
+			    && cg_entities[i].currentState.aiState >= AISTATE_COMBAT)
+			{
+				eta_watchSaid = qfalse;
+				memcpy(eta_watching, now, sizeof(eta_watching));
+				return;
+			}
+		}
+		ETA_Speech_Say("Out of view");
+		eta_watchSaid = qfalse;
+	}
+	memcpy(eta_watching, now, sizeof(eta_watching));
+}
+
+/*
+ * An enemy falling far off: "Down, 48 meters". The tester, shooting at a
+ * guard on a tower, could not tell whether he had died - the body falls
+ * out of earshot, and the callouts say "Enemy down" only within 15
+ * meters. Said for an enemy seen alive and then dead, beyond that.
+ */
+#define ETA_DOWN_FAR_METERS 15.0f
+
+static void ETA_DownFarWatch(void)
+{
+	static int alive[MAX_CLIENTS];   /* serverTime last seen alive, 0 not */
+	int        i, far = -1;
+	float      farMeters = 0.0f;
+
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		const centity_t     *cent = &cg_entities[i];
+		const entityState_t *es   = &cent->currentState;
+		float               meters;
+
+		if (!cent->currentValid || i == cg.snap->ps.clientNum || !es->aiChar || !ETA_SeenAsEnemy(es))
+		{
+			alive[i] = 0;
+			continue;
+		}
+		if (!(es->eFlags & EF_DEAD))
+		{
+			alive[i] = cg.snap->serverTime;
+			continue;
+		}
+		if (!alive[i] || cg.snap->serverTime - alive[i] > 1000 || cg.snap->serverTime < alive[i])
+		{
+			alive[i] = 0;
+			continue;
+		}
+		alive[i] = 0;
+		meters = Distance(cent->lerpOrigin, cg.snap->ps.origin) * ETA_QU_TO_METERS;
+		if (meters > ETA_DOWN_FAR_METERS && meters > farMeters)
+		{
+			farMeters = meters;
+			far       = i;
+		}
+	}
+	if (far >= 0)
+	{
+		int m = (int)(farMeters + 0.5f);
+
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(va("Down, %s, %d meters", ETA_HudNarrator_RelativeDirection(
+		                  CG_AccessibilityLeftOfView(cg_entities[far].lerpOrigin)), m));
+	}
+}
+
 static void ETA_NarrateAwareness(qboolean held)
 {
 	static int     lastSerial = -1;
@@ -3474,6 +3645,7 @@ static void ETA_NarrateAwareness(qboolean held)
 	if (eta_playerCallouts.integer)
 	{
 		ETA_AwareSeenWatch();
+		ETA_DownFarWatch();
 	}
 
 	if (held)
