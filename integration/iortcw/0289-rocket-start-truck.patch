+/* Shut in by a door close by - the truck the rocket base starts in, its
+   tailgate up: no way anywhere until it is opened, and O said only "No
+   way found". The door, any way round within reach: turned to it, and
+   said. qfalse with none. */
+static qboolean ETA_ShutInByDoor(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	float               yaw;
+
+	for (yaw = 0.0f; yaw < 360.0f; yaw += 22.5f)
+	{
+		int door;
+
+		eta_doorToward = 224.0f;   /* the truck's floor, its tailgate at its end: some steps */
+		door           = ETA_DoorToward(yaw);
+		eta_doorToward = 96.0f;
+		if (door >= 0)
+		{
+			etaAimTarget_t way;
+			vec3_t         dir;
+
+			memset(&way, 0, sizeof(way));
+			way.entityNum = -1;
+			VectorSet(dir, cosf(DEG2RAD(yaw)), sinf(DEG2RAD(yaw)), 0.0f);
+			VectorMA(ps->origin, 256.0f, dir, way.point);
+			way.point[2] = ps->origin[2] + ps->viewheight;
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(va("A shut door, %s, is the way out of here. Turning you to it: F opens it",
+			                  ETA_HudNarrator_RelativeDirection(AngleNormalize180(yaw - ps->viewangles[YAW]))));
+			ETA_AimStartSnap(&way, NULL);
+			return qtrue;
+		}
+	}
+
+	/* Further off - the truck's floor is stacked with crates between the
+	   player and the tailgate: a shut door the level's script opens, the
+	   nearest within some steps. Led to, and F opens it there. */
+	{
+		int    n, best = -1;
+		float  bestFar = 480.0f;
+		vec3_t at, bestAt;
+
+		for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+		{
+			const entityState_t *es = &cg.snap->entities[n];
+			vec3_t               mins, maxs;
+
+			if (es->eType != ET_MOVER || !CG_AccessibilityScriptDoor(es->modelindex)
+			    || ( es->apos.trType != TR_STATIONARY && es->apos.trDuration )
+			    || fabsf(AngleNormalize180(es->apos.trBase[PITCH])) > 30.0f
+			    || fabsf(AngleNormalize180(es->apos.trBase[ROLL])) > 30.0f)
+			{
+				continue;
+			}
+			trap_R_ModelBounds(cgs.inlineDrawModel[es->modelindex], mins, maxs);
+			VectorAdd(mins, maxs, at);
+			VectorScale(at, 0.5f, at);
+			VectorAdd(at, cg_entities[es->number].lerpOrigin, at);
+			if (Distance(at, ps->origin) < bestFar)
+			{
+				bestFar = Distance(at, ps->origin);
+				best    = n;
+				VectorCopy(at, bestAt);
+			}
+		}
+		if (best >= 0)
+		{
+			vec3_t stand, toward;
+			int    meters;
+
+			/* Where to stand: a step short of it, on the player's side. */
+			VectorSubtract(ps->origin, bestAt, toward);
+			toward[2] = 0.0f;
+			VectorNormalize(toward);
+			VectorMA(bestAt, 40.0f, toward, stand);
+			stand[2] = ps->origin[2];
+			meters = (int)( Distance(stand, ps->origin) * ETA_QU_TO_METERS + 0.5f );
+			CG_AccessibilityChoose(stand, "the shut door out of here");
+			CG_AccessibilityChosenIsThing();
+			CG_AccessibilityChosenAimAt(bestAt);
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(va("Shut in: the way out of here is a shut door, %d %s, %s. O leads to it, and F opens it there",
+			                  meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters",
+			                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(bestAt))));
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
