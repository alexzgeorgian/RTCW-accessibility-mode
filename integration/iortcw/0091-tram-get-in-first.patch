+/* Whether one of the tram's buttons is this near a point. */
+qboolean CG_AccessibilityTramButtonNear(const vec3_t point, float range)
+{
+	int i;
+
+	for (i = 0; i < eta_userCount; i++)
+	{
+		if (!Q_stricmpn(eta_users[i].name, "Tram button", 11)
+		    && Distance(cgs.inlineModelMidpoints[eta_users[i].model], point) < range)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/* The tram stopped by its button, and the player not in it: pressed from
+   outside, the tram leaves a moment later without them. The tester,
+   pressing it on the platform, was left behind. */
+qboolean CG_AccessibilityTramWaitsHere(void)
+{
+	vec3_t at;
+
+	return (qboolean)( CG_AccessibilityRideAt(at) && Distance(at, cg.predictedPlayerState.origin) < 800.0f
+	                   && CG_AccessibilityTramButtonNear(at, 500.0f) );
+}
+
