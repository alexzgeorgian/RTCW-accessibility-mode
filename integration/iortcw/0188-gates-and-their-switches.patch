+/* No way found all the way there, and a gate the script moves shut
+   across it, with a switch the map gives it: to the switch, then wait for
+   the gate, then on to where the player was going. A test walk through
+   the church stood at its third portcullis for minutes, turned again and
+   again to the opening behind it; and once the switch was pressed, O
+   went off to places not explored while the gate was still rising. */
+static struct
+{
+	int    gate;       /* its model, 0 when none is being opened */
+	vec3_t target;     /* where the player was going */
+	char   name[96];
+	vec3_t switchAt;
+} eta_gateLead;
+
+static qboolean ETA_GateLead(const playerState_t *ps, qboolean noWayYet, const vec3_t routeAhead)
+{
+	vec3_t      origin, switchAt, stand, toSwitch;
+	const char *name = NULL;
+	int         gate, meters;
+
+	if (eta_gateLead.gate)
+	{
+		qboolean moving = qfalse;
+		int      state  = CG_AccessibilityGateState(eta_gateLead.gate, ps->origin, &moving);
+
+		if (state == 0 || ( !moving && state == 2 ))
+		{
+			/* Open, or out of sight: back to where the player was
+			   going, the way looked for again from here on the next
+			   press. */
+			CG_AccessibilityChoose(eta_gateLead.target, eta_gateLead.name[0] ? eta_gateLead.name : NULL);
+			eta_gateLead.gate = 0;
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(state == 2 ? "The gate is open. O leads on" : "Back on the way. O leads on");
+			return qtrue;
+		}
+		if (moving)
+		{
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("The gate is still moving. Wait for it to stop, then O");
+			return qtrue;
+		}
+		/* Shut and still: just pressed - the gate starts a few seconds
+		   after its switch - or not pressed yet. */
+		if (eta_useKeyAt && cg.time - eta_useKeyAt < 8000
+		    && Distance(ps->origin, eta_gateLead.switchAt) < 160.0f)
+		{
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("The gate starts a few seconds after the switch, and rises slowly. Wait for it to stop, then O");
+			return qtrue;
+		}
+	}
+
+	/* The way found leads through the gate - the search takes no account
+	   of what the script moves - or none was found at all. */
+	if (!routeAhead && !noWayYet && !CG_AccessibilityMarkerPartial())
+	{
+		return qfalse;
+	}
+	if (eta_gateLead.gate)
+	{
+		VectorCopy(eta_gateLead.target, origin);
+		name = eta_gateLead.name[0] ? eta_gateLead.name : NULL;
+	}
+	else if (!CG_AccessibilityMarkerInfo(origin, &name))
+	{
+		return qfalse;
+	}
+	gate = routeAhead ? CG_AccessibilityGateInWay(ps->origin, routeAhead, 256.0f, switchAt)
+	                  : CG_AccessibilityGateInWay(ps->origin, origin, 512.0f, switchAt);
+	if (!gate)
+	{
+		return qfalse;
+	}
+	if (eta_gateLead.gate != gate)
+	{
+		eta_gateLead.gate = gate;
+		VectorCopy(origin, eta_gateLead.target);
+		Q_strncpyz(eta_gateLead.name, name ? name : "", sizeof(eta_gateLead.name));
+	}
+	VectorCopy(switchAt, eta_gateLead.switchAt);
+
+	VectorSubtract(switchAt, ps->origin, toSwitch);
+	meters = (int)( VectorLength(toSwitch) * ETA_QU_TO_METERS + 0.5f );
+	ETA_HudNarrator_HoldPassive(cg.time);
+	if (meters <= 2)
+	{
+		/* Already there: aimed at it, F presses it. */
+		etaAimTarget_t aim;
+
+		memset(&aim, 0, sizeof(aim));
+		aim.entityNum = -1;
+		VectorCopy(switchAt, aim.point);
+		ETA_AimStartSnap(&aim, NULL);
+		ETA_Speech_Say(va("A gate is shut across the way. Its switch is here, %s: F presses it. The gate opens "
+		                  "slowly: wait for it to stop, then O",
+		                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(switchAt))));
+		return qtrue;
+	}
+	VectorCopy(switchAt, stand);
+	CG_AccessibilitySwitchStand(switchAt, stand);
+	CG_AccessibilityChoose(stand, "the switch that opens the gate");
+	CG_AccessibilityChosenIsThing();
+	CG_AccessibilityChosenAimAt(switchAt);
+	ETA_Speech_Say(va("A gate is shut across the way. Its switch is %d meters away, %s. O again leads to it, and F "
+	                  "presses it there. The gate opens slowly: wait for it to stop, then O",
+	                  meters, ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(switchAt))));
+	return qtrue;
+}
