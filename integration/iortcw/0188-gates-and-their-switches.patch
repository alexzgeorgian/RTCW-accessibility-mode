+/* The nearest switch that moves this gate: qfalse if none is known. */
+qboolean CG_AccessibilityGateSwitch(int gate, const vec3_t from, vec3_t out)
+{
+	float best = 0.0f;
+	int   i, found = 0;
+
+	for (i = 0; i < eta_gateSwitchCount; i++)
+	{
+		if (eta_gateSwitches[i].gate == gate && ( !found || Distance(from, eta_gateSwitches[i].at) < best ))
+		{
+			best = Distance(from, eta_gateSwitches[i].at);
+			VectorCopy(eta_gateSwitches[i].at, out);
+			found = 1;
+		}
+	}
+	return (qboolean)found;
+}
+
+/* A gate as it is now, for a player at from: 1 shut - its bottom lower
+   than their head - 2 risen clear of it, 0 not in sight. Moving or not
+   in moving, when asked. */
+int CG_AccessibilityGateState(int gate, const vec3_t from, qboolean *moving)
+{
+	int n;
+
+	for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		vec3_t              mins, maxs;
+
+		if (es->eType != ET_MOVER || es->modelindex != gate || !cgs.inlineDrawModel[gate])
+		{
+			continue;
+		}
+		if (moving)
+		{
+			*moving = (qboolean)( es->pos.trType != TR_STATIONARY || es->apos.trType != TR_STATIONARY );
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[gate], mins, maxs);
+		/* The player stands 56 units tall, their origin 24 above the
+		   floor. */
+		return cg_entities[es->number].lerpOrigin[2] + mins[2] > from[2] + 32.0f ? 2 : 1;
+	}
+	return 0;
+}
+
+/* A gate with a known switch, shut and stood still across the way from
+   the player toward a point, within reach of being the reason there is
+   no way there: its model, the switch's place, or 0. */
+int CG_AccessibilityGateInWay(const vec3_t from, const vec3_t toward, float within, vec3_t switchAt)
+{
+	int    n, best = 0;
+	float  bestFar = within;
+	vec3_t way;
+
+	VectorSubtract(toward, from, way);
+	way[2] = 0.0f;
+	if (VectorNormalize(way) < 1.0f || !cg.snap)
+	{
+		return 0;
+	}
+	for (n = 0; n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		vec3_t              mid, to;
+		float               far;
+
+		if (es->eType != ET_MOVER || es->modelindex <= 0 || es->modelindex >= MAX_MODELS
+		    || es->pos.trType != TR_STATIONARY || CG_AccessibilityGateState(es->modelindex, from, NULL) != 1)
+		{
+			continue;
+		}
+		VectorAdd(cg_entities[es->number].lerpOrigin, cgs.inlineModelMidpoints[es->modelindex], mid);
+		VectorSubtract(mid, from, to);
+		to[2] = 0.0f;
+		far = VectorNormalize(to);
+		if (far > bestFar || DotProduct(to, way) < 0.5f || fabsf(mid[2] - from[2]) > 160.0f)
+		{
+			continue;
+		}
+		if (CG_AccessibilityGateSwitch(es->modelindex, from, switchAt))
+		{
+			best    = es->modelindex;
+			bestFar = far;
+		}
+	}
+	if (best)
+	{
+		CG_AccessibilityGateSwitch(best, from, switchAt);
+	}
+	return best;
 }
 
