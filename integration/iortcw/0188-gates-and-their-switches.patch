+/*
+ * Gates the script moves - the church's portcullises - and the switches
+ * that move them. A test walk through the church, following O, stood at
+ * the third portcullis, shut, for minutes: O faced "the opening to a new
+ * area" behind it thirty-seven times, and never said a gate was in the
+ * way or that a button beside it raises it. A gate is a script_mover; a
+ * line of the script that triggers its "toggle", "up", "open" or "raise"
+ * is followed back to the switches the player presses for it.
+ */
+#define ETA_GATE_SWITCHES 16
+
+static struct
+{
+	int    gate;        /* the gate's brush model */
+	vec3_t at;          /* the switch */
+} eta_gateSwitches[ETA_GATE_SWITCHES];
+static int eta_gateSwitchCount;
+static int eta_unlockGate;        /* the gate being followed back, or 0 */
+
