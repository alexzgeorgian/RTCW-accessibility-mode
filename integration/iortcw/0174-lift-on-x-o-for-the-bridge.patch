+			}
+			return;
+		}
+	}
+	if (!CG_AccessibilityMarkerActive())
 	{
 		return;
 	}
diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 075461d7..a567359c 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -7729,6 +7729,68 @@ qboolean CG_AccessibilityLiftStatus(char *out, size_t size)
 	return qfalse;
 }
 
+/*
+ * For O on a lift: its bridge out - its far end, well past it; or not yet
+ * out - in how many seconds, 0 not known. qtrue only standing on the lift
+ * and it has a bridge.
+ */
+qboolean CG_AccessibilityLiftBridge(vec3_t far, qboolean *out, int *secs)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  l, n, k;
+
+	if (!cg.snap)
+	{
+		return qfalse;
+	}
+	for (l = 0; l < eta_liftCount; l++)
+	{
+		const entityState_t *lift = NULL, *bridge = NULL;
+
+		for (n = 0; n < cg.snap->numEntities; n++)
+		{
+			const entityState_t *es = &cg.snap->entities[n];
+
+			if (es->eType == ET_MOVER && es->modelindex == eta_lifts[l].mover)
+			{
+				lift = es;
+			}
+			else if (es->eType == ET_MOVER && eta_lifts[l].bridge && es->modelindex == eta_lifts[l].bridge)
+			{
+				bridge = es;
+			}
+		}
+		if (!lift || !bridge || ps->groundEntityNum != lift->number)
+		{
+			continue;
+		}
+		*out  = (qboolean)( eta_lifts[l].bridgeOut
+		                    && !( bridge->pos.trType != TR_STATIONARY && cg.time < bridge->pos.trTime + bridge->pos.trDuration ) );
+		*secs = bridge->pos.trType != TR_STATIONARY && cg.time < bridge->pos.trTime + bridge->pos.trDuration && !eta_lifts[l].bridgeOut
+		        ? ( bridge->pos.trTime + bridge->pos.trDuration - cg.time + 999 ) / 1000 : 0;
+		{
+			vec3_t bmins, bmaxs;
+
+			trap_R_ModelBounds(cgs.inlineDrawModel[eta_lifts[l].bridge], bmins, bmaxs);
+			VectorAdd(bmins, cg_entities[bridge->number].lerpOrigin, bmins);
+			VectorAdd(bmaxs, cg_entities[bridge->number].lerpOrigin, bmaxs);
+			VectorAdd(bmins, bmaxs, far);
+			VectorScale(far, 0.5f, far);
+			for (k = 0; k < 2; k++)
+			{
+				if (bmaxs[k] - bmins[k] >= bmaxs[!k] - bmins[!k])
+				{
+					far[k] = fabsf(bmaxs[k] - cg_entities[lift->number].lerpOrigin[k])
+					         > fabsf(bmins[k] - cg_entities[lift->number].lerpOrigin[k]) ? bmaxs[k] + 176.0f : bmins[k] - 176.0f;
+				}
+			}
+			far[2] = ps->origin[2];
+		}
+		return qtrue;
+	}
+	return qfalse;
+}
+
 /* For T: a lift down and waiting to be stood on, where; qfalse none. */
