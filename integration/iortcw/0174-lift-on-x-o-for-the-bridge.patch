+	}
+	/* On a lift with a bridge - the crypt's pillar: O is for the bridge,
+	   whatever was chosen before. The tester heard "no way found" on it,
+	   O still on something the pillar's top has no way to. */
+	{
+		vec3_t   far;
+		qboolean out;
+		int      secs;
+
+		if (CG_AccessibilityLiftBridge(far, &out, &secs))
+		{
+			ETA_HudNarrator_HoldPassive(cg.time);
+			if (out)
+			{
+				etaAimTarget_t aim;
+				int            meters = (int)( Distance(cg.predictedPlayerState.origin, far) * ETA_QU_TO_METERS + 0.5f );
+
+				CG_AccessibilityChoose(far, "the far end of the bridge");
