+/* Ridden: the last lift or ride the player was carried by is not the way
+   on again until another has carried them - not for a while only: the
+   tester, slow at the rocket base's first lift's bottom, was sent back up
+   it three minutes on, toward the bedroom it starts by. */
+static void ETA_ConnectorRidden(int lift, int ride)
+{
+	int i;
+
+	for (i = 0; i < ETA_LEVER_LIFTS; i++)
