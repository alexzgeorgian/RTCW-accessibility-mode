+/*
+ * How long a sound file plays, from its WAV header: the data's size over
+ * its rate, channels and sample size. Read once a file, then kept.
+ */
+#define ETA_VOICE_CACHE 256
+
+static struct {
+	char name[MAX_QPATH];
+	int ms;
+} etaVoiceLengths[ETA_VOICE_CACHE];
+static int etaVoiceLengthCount;
+
+static int CG_AccessibilitySoundLength( const char *file ) {
+	fileHandle_t f;
+	byte header[512];
+	int len, read, i, rate = 0, channels = 0, bits = 0, data = 0;
+
+	for ( i = 0; i < etaVoiceLengthCount; i++ ) {
+		if ( !Q_stricmp( etaVoiceLengths[i].name, file ) ) {
+			return etaVoiceLengths[i].ms;
+		}
+	}
+
+	len = trap_FS_FOpenFile( file, &f, FS_READ );
+	if ( !f ) {
+		return 0;
+	}
+	read = len < (int)sizeof( header ) ? len : (int)sizeof( header );
+	trap_FS_Read( header, read, f );
+	trap_FS_FCloseFile( f );
+
+	/* RIFF, then chunks: "fmt " for the rate, "data" for the size. */
+	for ( i = 12; i + 8 <= read; ) {
+		int size = header[i + 4] | ( header[i + 5] << 8 ) | ( header[i + 6] << 16 ) | ( header[i + 7] << 24 );
+
+		if ( !memcmp( header + i, "fmt ", 4 ) && i + 24 <= read ) {
+			channels = header[i + 10] | ( header[i + 11] << 8 );
+			rate = header[i + 12] | ( header[i + 13] << 8 ) | ( header[i + 14] << 16 ) | ( header[i + 15] << 24 );
+			bits = header[i + 22] | ( header[i + 23] << 8 );
+		} else if ( !memcmp( header + i, "data", 4 ) ) {
+			data = size;
+			break;
+		}
+		if ( size < 0 ) {
+			break;
+		}
+		i += 8 + size + ( size & 1 );
+	}
+
+	if ( rate <= 0 || channels <= 0 || bits <= 0 || data <= 0 ) {
+		/* Not one we can read - compressed, say: a few seconds. */
+		data = 0;
+	}
+	i = data ? (int)( (double)data * 1000.0 / ( (double)rate * channels * ( bits / 8 ) ) ) : 3000;
+
+	if ( etaVoiceLengthCount < ETA_VOICE_CACHE ) {
+		Q_strncpyz( etaVoiceLengths[etaVoiceLengthCount].name, file, sizeof( etaVoiceLengths[0].name ) );
+		etaVoiceLengths[etaVoiceLengthCount].ms = i;
+		etaVoiceLengthCount++;
+	}
+	return i;
+}
+
+/*
+ * A character speaking, in a cutscene: the descriptions wait until they
+ * have finished, and say what is seen in the gap after.
+ */
+static const char *etaVoiceEffects[] = { "sound/movers/", "slide_eject", "knock", "soldiers_running", "scuffle",
+										   "misc_da_dum", "misc_whistle", "crypt_shiver", "sound/world/",
+										   "lightning", "thunder", "misc_cough", "door_close", "eg_solo_loop",
+										   "ss_powerup", "war_giant", "pillar_raise", "heinr127" };
+
+void CG_AccessibilityVoice( const char *soundFile ) {
+	int until, i;
+
+	if ( !cg.cameraMode || !soundFile || !strstr( soundFile, ".wav" ) ) {
+		return;
+	}
+	/* Sound effects on the voice channel are not anyone talking, and
+	   a description may be said over them. */
+	for ( i = 0; i < (int)ARRAY_LEN( etaVoiceEffects ); i++ ) {
+		if ( strstr( soundFile, etaVoiceEffects[i] ) ) {
+			return;
+		}
+	}
+	until = cg.time + CG_AccessibilitySoundLength( soundFile );
+	if ( until > eta.voiceUntil ) {
+		eta.voiceUntil = until;
+	}
+}
+
+/* A gap long enough to say something in. */
+#define ETA_DESCRIBE_GAP_MS 250
+
+/*
+ * Every frame of a cutscene: the next description whose moment has come,
+ * once nobody is speaking - neither a character, nor our last line.
+ * "Cutscene. Escape skips it" goes with the first, as one line, for
+ * VoiceOver; alone, if no description comes in the first moments.
+ */
+static void CG_AccessibilityDescribe( void ) {
+	int i, next = -1;
+
+	for ( i = 0; i < eta.numPending; i++ ) {
+		if ( eta.pending[i].due <= cg.time && ( next < 0 || eta.pending[i].due < eta.pending[next].due ) ) {
+			next = i;
+		}
+	}
+
+	if ( cg.time < eta.voiceUntil + ETA_DESCRIBE_GAP_MS || cg.time < eta.describingUntil ) {
+		/* Someone is speaking. A start not yet announced still is, after
+		   a moment, so the player knows the keys have stopped. */
+		if ( eta.announceCutscene && cg.time - eta.cutsceneStarted > 1500 && next < 0
+			 && cg.time >= eta.describingUntil ) {
+			CG_AccessibilitySay( "Cutscene. Escape skips it" );
+			eta.announceCutscene = qfalse;
+		}
+		return;
+	}
+
+	if ( next < 0 ) {
+		if ( eta.announceCutscene && cg.time - eta.cutsceneStarted > 1500 ) {
+			CG_AccessibilitySay( "Cutscene. Escape skips it" );
+			eta.announceCutscene = qfalse;
+		}
+		return;
+	}
+
+	{
+		const char *text = eta.announceCutscene
+						   ? va( "Cutscene. Escape skips it. %s", eta.pending[next].text )
+						   : eta.pending[next].text;
+
+		CG_AccessibilitySay( text );
+		eta.describingUntil = cg.time + ETA_Speech_EstimateDurationMs( text );
+		eta.announceCutscene = qfalse;
+		eta.pending[next] = eta.pending[--eta.numPending];
+	}
+}
+
+/*
+ * A cutscene shot starting: the camera file's name, which the shot's
+ * description is kept under.
+ */
+void CG_AccessibilityCamera( const char *name ) {
+	char *dot;
+	int i;
+
+	Q_strncpyz( eta.cameraName, name ? name : "", sizeof( eta.cameraName ) );
+	dot = strrchr( eta.cameraName, '.' );
+	if ( dot ) {
+		*dot = '\0';
+	}
+	eta.cameraShot = 0;
+	eta.cameraShotTime = cg.time + 700;
+	eta.cameraCount++;
+	if ( !eta.map[0] ) {
+		CG_AccessibilityMapName();
+	}
+
+	/* A line from an earlier shot, held back by the talking, is still
+	   said in this one if it is fresh; one long overdue would describe
+	   what is no longer on the screen. */
+	for ( i = 0; i < eta.numPending; ) {
+		if ( cg.time - eta.pending[i].due < 4000 ) {
+			i++;
+			continue;
+		}
+		eta.pending[i] = eta.pending[--eta.numPending];
+	}
+
+	for ( i = 0; i < (int)ARRAY_LEN( etaCutsceneLines ) && eta.numPending < ETA_PENDING_LINES; i++ ) {
+		if ( !CG_AccessibilitySameName( etaCutsceneLines[i].map, eta.map ) ) {
+			continue;
+		}
+		if ( etaCutsceneLines[i].camera
+			 ? CG_AccessibilitySameName( etaCutsceneLines[i].camera, eta.cameraName ) && !etaCutsceneSaid[i]
+			 : etaCutsceneLines[i].shot == eta.cameraCount ) {
+			/* A mission's camera used again later is the same place:
+			   said the first time. */
+			etaCutsceneSaid[i] = qtrue;
+			Q_strncpyz( eta.pending[eta.numPending].text, etaCutsceneLines[i].text,
+						sizeof( eta.pending[eta.numPending].text ) );
+			eta.pending[eta.numPending].due = cg.time + etaCutsceneLines[i].delay;
+			eta.pending[eta.numPending].shot = eta.cameraCount;
+			eta.numPending++;
+		}
+	}
+	CG_Printf( "eta: camera %i %s on %s at %i\n", eta.cameraCount, eta.cameraName, eta.map, cg.time );
+}
+
+/* For writing the descriptions: eta_cameraShots 1 takes a picture of each
