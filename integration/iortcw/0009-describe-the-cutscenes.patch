 };
 
+/*
+ * The intro movie, described as it plays: each line at its moment, in
+ * the movie's quiet stretches, written by watching it. Called every frame
+ * the movie plays (UI_ACCESSIBILITY_CINEMATIC); a key skips the movie, as
+ * it always has.
+ */
+static const struct {
+	const char *movie;
+	int ms;
+	const char *text;
+} eta_movieLines[] = {
+#include "ui_accessibility_intro.h"
+};
+
+void UI_AccessibilityCinematic( int elapsedMs ) {
+	static char playing[MAX_QPATH];
+	static int next, lastMs;
+	char movie[MAX_QPATH];
+	int i;
+
+	trap_Cvar_VariableStringBuffer( "eta_cinematic", movie, sizeof( movie ) );
+	if ( Q_stricmp( movie, playing ) || elapsedMs < lastMs ) {
+		/* A new movie, or the same one again. */
+		Q_strncpyz( playing, movie, sizeof( playing ) );
+		next = 0;
+	}
+	lastMs = elapsedMs;
+
+	for ( i = next; i < (int)( sizeof( eta_movieLines ) / sizeof( eta_movieLines[0] ) ); i++ ) {
+		if ( Q_stricmp( eta_movieLines[i].movie, movie ) ) {
+			continue;
+		}
+		if ( eta_movieLines[i].ms > elapsedMs ) {
+			break;
+		}
+		ETA_Speech_SayLong( eta_movieLines[i].text );
+		next = i + 1;
+		break;
+	}
+}
+
