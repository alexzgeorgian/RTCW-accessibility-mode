+	if ( !atoi( value ) || !eta.cameraName[0] || cg.time < eta.cameraShotTime ) {
+		return;
+	}
+	trap_SendConsoleCommand( va( "screenshotJPEG %s_%02i_%s_%02i\n", eta.map, eta.cameraCount, eta.cameraName, eta.cameraShot ) );
+	eta.cameraShot++;
+	eta.cameraShotTime = cg.time + 2500;
+}
