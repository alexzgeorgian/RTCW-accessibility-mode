+/* The ways found, tried or not, kept with the areas explored so that a
+   save loaded or a death does not make them new again
+   (cg_accessibility_areas.c). */
+qboolean CG_AccessibilityFrontierGet(int index, vec3_t feature, vec3_t lead, int *kind, qboolean *tried)
+{
+	if (index < 0 || index >= eta_frontier.count)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_frontier.ways[index].feature, feature);
+	VectorCopy(eta_frontier.ways[index].lead, lead);
+	*kind  = (int)eta_frontier.ways[index].kind;
+	*tried = eta_frontier.ways[index].tried;
+	return qtrue;
+}
+
+void CG_AccessibilityFrontierPut(const vec3_t feature, const vec3_t lead, int kind, qboolean tried)
+{
+	if (eta_frontier.count >= ETA_FRONTIER_MAX || kind < 0 || kind > ETA_WAY_LADDER_DOWN)
+	{
+		return;
+	}
+	VectorCopy(feature, eta_frontier.ways[eta_frontier.count].feature);
+	VectorCopy(lead, eta_frontier.ways[eta_frontier.count].lead);
+	eta_frontier.ways[eta_frontier.count].kind  = (eta_wayKind_t)kind;
+	eta_frontier.ways[eta_frontier.count].tried = tried;
+	eta_frontier.count++;
+}
+
