+/*
+ * What has been explored, kept in a file of its own, so that a death, a
+ * save loaded or the level started again does not make it all new: the
+ * tester, after a reload, was led by X through doors "to a new area" into
+ * places they knew. The areas come into, with their numbers, and the ways
+ * found, tried or not. Only for one level - the one last played: coming
+ * to another level, it starts again.
+ */
+#define ETA_EXPLORED_FILE    "accessibility_explored.txt"
+#define ETA_EXPLORED_SAVE_MS 2000
+
+static qboolean eta_exploredDirty;
+static int      eta_exploredSavedAt;
+
+void CG_AccessibilityExploredChanged(void)
+{
+	eta_exploredDirty = qtrue;
+}
+
+static void ETA_ExploredSave(void)
+{
+	fileHandle_t f;
+	char         line[256];
+	vec3_t       feature, lead;
+	int          i, kind;
+	qboolean     tried;
+
+	eta_exploredDirty   = qfalse;
+	eta_exploredSavedAt = cg.time;
+	if (trap_FS_FOpenFile(ETA_EXPLORED_FILE, &f, FS_WRITE) < 0 || !f)
+	{
+		return;
+	}
+	Com_sprintf(line, sizeof(line), "map %s\n", cgs.mapname);
+	trap_FS_Write(line, strlen(line), f);
+	for (i = 0; i < eta_areas.count && i < ETA_AREAS_MAX; i++)
+	{
+		if (eta_areas.number[i])
+		{
+			Com_sprintf(line, sizeof(line), "area %d %d\n", i, eta_areas.number[i]);
+			trap_FS_Write(line, strlen(line), f);
+		}
+	}
+	for (i = 0; CG_AccessibilityFrontierGet(i, feature, lead, &kind, &tried); i++)
+	{
+		Com_sprintf(line, sizeof(line), "way %d %d %.0f %.0f %.0f %.0f %.0f %.0f\n", kind, tried ? 1 : 0,
+		            feature[0], feature[1], feature[2], lead[0], lead[1], lead[2]);
+		trap_FS_Write(line, strlen(line), f);
+	}
+	trap_FS_FCloseFile(f);
+}
+
+static void ETA_ExploredLoad(void)
+{
+	static char  text[32768];
+	fileHandle_t f;
+	char         *line, *next, map[MAX_QPATH];
+	int          length;
+
+	eta_exploredDirty = qfalse;
+	length            = trap_FS_FOpenFile(ETA_EXPLORED_FILE, &f, FS_READ);
+	if (length <= 0 || !f)
+	{
+		if (f)
+		{
+			trap_FS_FCloseFile(f);
+		}
+		return;
+	}
+	if (length >= (int)sizeof(text))
+	{
+		length = sizeof(text) - 1;
+	}
+	trap_FS_Read(text, length, f);
+	trap_FS_FCloseFile(f);
+	text[length] = '\0';
+
+	/* Another level's: nothing explored here yet. */
+	if (sscanf(text, "map %63s", map) != 1 || Q_stricmp(map, cgs.mapname))
+	{
+		return;
+	}
+	for (line = text; line && *line; line = next)
+	{
+		int    a, n, kind, tried;
+		vec3_t feature, lead;
+
+		next = strchr(line, '\n');
+		if (next)
+		{
+			*next++ = '\0';
+		}
+		if (sscanf(line, "area %d %d", &a, &n) == 2 && a >= 0 && a < ETA_AREAS_MAX && n > 0)
+		{
+			eta_areas.number[a] = n;
+			if (n > eta_areas.numbered)
+			{
+				eta_areas.numbered = n;
+			}
+		}
+		else if (sscanf(line, "way %d %d %f %f %f %f %f %f", &kind, &tried, &feature[0], &feature[1], &feature[2],
+		                &lead[0], &lead[1], &lead[2]) == 8)
+		{
+			CG_AccessibilityFrontierPut(feature, lead, kind, (qboolean)(tried != 0));
+		}
+	}
+}
+
