 }
 
@@ -300,6 +409,10 @@ void CG_AccessibilityAreasFrame(void)
 	qboolean            first;
 	int                 area;
 
+	if (eta_exploredDirty && ( cg.time - eta_exploredSavedAt >= ETA_EXPLORED_SAVE_MS || cg.time < eta_exploredSavedAt ))
+	{
+		ETA_ExploredSave();
+	}
 	if (!eta_areas.loaded || !cg.snap || ps->pm_type != PM_NORMAL || ps->groundEntityNum == ENTITYNUM_NONE)
 	{
 		return;
@@ -328,6 +441,7 @@ void CG_AccessibilityAreasFrame(void)
 	if (!eta_areas.number[area])
 	{
 		eta_areas.number[area] = ++eta_areas.numbered;
+		eta_exploredDirty      = qtrue;
 		if (first || !eta_waysCallouts.integer)
 		{
 			return;
@@ -443,6 +557,7 @@ void CG_AccessibilityAreaExits(void)
 	if (!eta_areas.number[area])
 	{
 		eta_areas.number[area] = ++eta_areas.numbered;
+		eta_exploredDirty      = qtrue;
 	}
 
 	fresh = (qboolean)(cg.time < eta_areas.pressedAt || cg.time - eta_areas.pressedAt >= ETA_AREA_LIST_MS
