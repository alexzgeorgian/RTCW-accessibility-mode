+/* A page of the paused game's menu, open over it. */
+static qboolean UI_AccessibilityIngamePage( const char *name ) {
+	static const char *pages[] = {
+		"ingame_save", "ingame_load", "ingame_controls", "ingame_options", "ingame_system", "ingame_leave"
+	};
+	menuDef_t *ingame = Menus_FindByName( "ingame" );
+	int i;
+
+	if ( !ingame || !( ingame->window.flags & WINDOW_VISIBLE ) ) {
+		return qfalse;
+	}
+	for ( i = 0; i < (int)ARRAY_LEN( pages ); i++ ) {
+		if ( !Q_stricmp( name, pages[i] ) ) {
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
