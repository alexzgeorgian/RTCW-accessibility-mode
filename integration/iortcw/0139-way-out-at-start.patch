+/* A switch here come across already, as T has it: on its list. */
+qboolean CG_AccessibilityThingKnownAt(const vec3_t point)
+{
+	int i;
+
+	for (i = 0; i < eta_things.count; i++)
+	{
+		if (eta_things.things[i].kind == ETA_THING_SWITCH && eta_things.things[i].known
+		    && ETA_ThingNear(eta_things.things[i].point, point, 64.0f))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
