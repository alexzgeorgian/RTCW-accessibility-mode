+/*
+ * The lift, for F1, X and T: on it, where it is and what to do; near it,
+ * down and waiting, where. The tester, on the crypt's pillar, asked where
+ * they were and was not told, and X and T did not name the pillar.
+ */
+qboolean CG_AccessibilityLiftStatus(char *out, size_t size)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  l, n;
+
+	out[0] = '\0';
+	if (!cg.snap)
+	{
+		return qfalse;
+	}
+	for (l = 0; l < eta_liftCount; l++)
+	{
+		const entityState_t *lift = NULL, *bridge = NULL;
+		qboolean             moving, bmoving = qfalse;
+
+		for (n = 0; n < cg.snap->numEntities; n++)
+		{
+			const entityState_t *es = &cg.snap->entities[n];
+
+			if (es->eType == ET_MOVER && es->modelindex == eta_lifts[l].mover)
+			{
+				lift = es;
+			}
+			else if (es->eType == ET_MOVER && eta_lifts[l].bridge && es->modelindex == eta_lifts[l].bridge)
+			{
+				bridge = es;
+			}
+		}
+		if (!lift)
+		{
+			continue;
+		}
+		moving = (qboolean)( lift->pos.trType != TR_STATIONARY && cg.time < lift->pos.trTime + lift->pos.trDuration );
+		if (bridge)
+		{
+			bmoving = (qboolean)( bridge->pos.trType != TR_STATIONARY && cg.time < bridge->pos.trTime + bridge->pos.trDuration );
+		}
+		if (ps->groundEntityNum == lift->number)
+		{
+			int secs = bmoving && !eta_lifts[l].bridgeOut ? ( bridge->pos.trTime + bridge->pos.trDuration - cg.time + 999 ) / 1000 : 0;
+
+			if (moving && lift->pos.trDelta[2] > 0.0f)
+			{
+				Com_sprintf(out, size, "On the lift, going up: stand still%s",
+				            secs > 1 ? va(". The bridge is out in about %d seconds", secs) : "");
+			}
+			else if (moving)
+			{
+				Q_strncpyz(out, "On the lift, going down", size);
+			}
+			else if (eta_lifts[l].bridge && eta_lifts[l].bridgeOut && !bmoving)
+			{
+				vec3_t at;
+
+				VectorAdd(cg_entities[bridge->number].lerpOrigin, cgs.inlineModelMidpoints[eta_lifts[l].bridge], at);
+				Com_sprintf(out, size, "On the lift, at the top. The bridge is out, %s: O turns you to it, then walk across",
+				            ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at)));
+			}
+			else if (secs > 0)
+			{
+				Com_sprintf(out, size, "On the lift, at the top: stand still. The bridge is out in %d seconds", secs);
+			}
+			else
+			{
+				Q_strncpyz(out, "On the lift: stand still on it, and it goes up", size);
+			}
+			return qtrue;
+		}
+		if (eta_lifts[l].announced)
+		{
+			vec3_t tmins, tmaxs, at;
+			int    meters;
+
+			trap_R_ModelBounds(cgs.inlineDrawModel[eta_lifts[l].trigger], tmins, tmaxs);
+			VectorAdd(tmins, tmaxs, at);
+			VectorScale(at, 0.5f, at);
+			meters = (int)( Distance(ps->origin, at) * ETA_QU_TO_METERS + 0.5f );
+			Com_sprintf(out, size, "The lift is down, %s, %d %s: stand on it to go up. O leads there",
+			            ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at)), meters < 1 ? 1 : meters,
+			            meters == 1 ? "meter" : "meters");
+			CG_AccessibilityChoose(at, "the lift");
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
