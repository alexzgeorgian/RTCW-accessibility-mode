+/*
+ * Alarm boxes, as things to break. A quiet one, pressed, rings and the
+ * mission is lost, so F never presses one; but a single bullet breaks
+ * it, and a guard running to a broken box can ring nothing
+ * (alarmbox_die, g_alarm.c; on_alarm1 in the forest's script). A
+ * sighted player sees the box on its wall from across the road; the
+ * tester, by the forest's gate, had no way to know one was there, nor
+ * to aim at it. So one in sight within ETA_ALARM_SEE goes on T's list as
+ * a thing to break, and F turns to it there, at any distance it can be
+ * seen from - never pressing it.
+ */
+#define ETA_ALARM_SEE 2400.0f   /* about 60 meters */
+
+/* The middle of an alarm box: its brush is set about its origin. */
+static void ETA_AlarmBoxCenter(const centity_t *cent, vec3_t out)
+{
+	vec3_t mins, maxs;
+
+	VectorCopy(cent->lerpOrigin, out);
+	if (cent->currentState.modelindex > 0 && cent->currentState.modelindex < MAX_MODELS
+	    && cgs.inlineDrawModel[cent->currentState.modelindex])
+	{
+		trap_R_ModelBounds(cgs.inlineDrawModel[cent->currentState.modelindex], mins, maxs);
+		out[0] += ( mins[0] + maxs[0] ) * 0.5f;
+		out[1] += ( mins[1] + maxs[1] ) * 0.5f;
+		out[2] += ( mins[2] + maxs[2] ) * 0.5f;
+	}
+}
+
+/* Whether a shot from the eye would reach the box: nothing solid
+   between. */
+static qboolean ETA_AlarmBoxInSight(int number, const vec3_t center)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	trace_t             trace;
+	vec3_t              eye;
+
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+	CG_Trace(&trace, eye, NULL, NULL, center, ps->clientNum, MASK_SHOT);
+	return (qboolean)( trace.fraction >= 0.99f || trace.entityNum == number );
+}
+
+/* The quiet alarm box nearest a point, within 64 units of it: its entity
+   number, and where to aim. -1 when there is none - broken, ringing, or
+   not sent from here. In sight from the eye, if asked. */
+int CG_AccessibilityAlarmBoxAt(const vec3_t near, vec3_t center, qboolean *inSight)
+{
+	int   i, best = -1;
+	float bestFar = 64.0f;
+
+	if (!cg.snap)
+	{
+		return -1;
+	}
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		vec3_t              mid;
+
+		if (es->eType != ET_ALARMBOX || es->frame != 0)
+		{
+			continue;
+		}
+		ETA_AlarmBoxCenter(&cg_entities[es->number], mid);
+		if (Distance(mid, near) < bestFar)
+		{
+			bestFar = Distance(mid, near);
+			best    = es->number;
+			VectorCopy(mid, center);
+		}
+	}
+	if (best >= 0 && inSight)
+	{
+		*inSight = ETA_AlarmBoxInSight(best, center);
+	}
+	return best;
+}
+
+static void ETA_AlarmBoxesRecord(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 i, j;
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		vec3_t              mid;
+
+		if (es->eType != ET_ALARMBOX)
+		{
+			continue;
+		}
+		ETA_AlarmBoxCenter(&cg_entities[es->number], mid);
+		for (j = 0; j < eta_things.count; j++)
+		{
+			if (eta_things.things[j].entityNum == es->number && eta_things.things[j].kind == ETA_THING_BREAKABLE)
+			{
+				break;
+			}
+		}
+		/* Shot out: off the list, and said, wherever it was seen from. */
+		if (es->frame == 2)
+		{
+			if (j < eta_things.count && !eta_things.things[j].done)
+			{
+				eta_things.things[j].done = qtrue;
+				ETA_Speech_Say("Alarm box out");
+			}
+			continue;
+		}
+		if (es->frame != 0 || j < eta_things.count || eta_things.count >= ETA_THINGS_MAX
+		    || Distance(ps->origin, mid) > ETA_ALARM_SEE || !ETA_AlarmBoxInSight(es->number, mid))
+		{
+			continue;
+		}
+		memset(&eta_things.things[j], 0, sizeof(eta_things.things[j]));
+		VectorCopy(mid, eta_things.things[j].point);
+		eta_things.things[j].entityNum = es->number;
+		eta_things.things[j].kind      = ETA_THING_BREAKABLE;
+		eta_things.things[j].known     = qtrue;
+		Q_strncpyz(eta_things.things[j].name, "Alarm box", sizeof(eta_things.things[j].name));
+		eta_things.found++;
+		eta_things.count++;
+	}
+}
