diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 01e6d749..6b64b6ae 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -6729,7 +6729,11 @@ void CG_AccessibilityWayOut(void)
 	/* A boss alive - Olaric, Heinrich: O leads to the boss, the way on
 	   being through it, and again turns toward where the boss is now.
 	   The tester, in the tomb, wanted O on the boss, U on the zombies
-	   about them, and L on the waypoint back to the ammo. */
+	   about them, and L on the waypoint back to the ammo. Not while O
+	   leads somewhere the player chose - the waypoint on top first: the
+	   tester, on the way down to the ammo, pressed O again and was led
+	   back to the fight. */
+	if (!CG_AccessibilityLeadBusy())
 	{
 		int         bossChar;
 		const char *ledTo = NULL;
@@ -7253,6 +7257,34 @@ void CG_AccessibilityWaypointNext(void)
 	ETA_DestinationStep(1);
 }
 
+/* O leads, or is about to lead, somewhere the player chose - with L, K,
+   T, X or the like - rather than its own way out or boss: nothing found
+   by itself, a boss or the nearest enemy left, takes O away from it. */
+qboolean CG_AccessibilityLeadBusy(void)
+{
+	vec3_t      at;
+	const char *name = NULL;
+
+	if (eta_chosenSet)
+	{
+		return qtrue;
+	}
+	if (!ETA_MarkerIsO() || !CG_AccessibilityMarkerInfo(at, &name) || !name)
+	{
+		return qfalse;
+	}
+	if (!Q_stricmp(name, "the way out") || !Q_stricmpn(name, "the nearest ", 12))
+	{
+		return qfalse;
+	}
+	{
+		vec3_t boss;
+		int    bossChar;
+
+		return !( CG_AccessibilityBossAlive(boss, &bossChar) && !Q_stricmp(name, CG_AccessibilityAiCharName(bossChar)) );
+	}
+}
