 #define ETA_TRAP_REACH_MARGIN 40.0f
 
+/* The margin for a group: a swinging blade's body reaches past its hurt
+   triggers; a saw slides in its slot, and does not. */
+static float ETA_TrapMargin(int g)
+{
+	int i;
+
+	for (i = 0; i < eta_trapMoverCount; i++)
+	{
+		if (eta_trapMovers[i].group == g && !Q_stricmp(eta_trapMovers[i].kind, "blade"))
+		{
+			return ETA_TRAP_REACH_MARGIN;
+		}
+	}
+	return 0.0f;
+}
