+/* For O, pressed inside a trap's reach: not a stop to face the way - the
+   test player stopped there again and again as O turned it, and the
+   blade came - but the run out, the way that leads on. */
+qboolean CG_AccessibilityTrapRun(char *text, size_t textSize)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  g, i;
+
+	for (g = 0; g < eta_trapGroupCount; g++)
+	{
+		float margin = ETA_TrapMargin(g), turn, run;
+		char  name[16] = "trap";
+
+		if (eta_trapGroups[g].zoneDone != 2
+		    || ps->origin[2] < eta_trapGroups[g].zoneMins[2] - 48.0f || ps->origin[2] > eta_trapGroups[g].zoneMaxs[2] + 48.0f
+		    || ETA_ZoneGap(ps->origin, eta_trapGroups[g].zoneMins, eta_trapGroups[g].zoneMaxs) > margin
+		    || !ETA_ZoneExit(eta_trapGroups[g].zoneMins, eta_trapGroups[g].zoneMaxs, margin, &turn, &run))
+		{
+			continue;
+		}
+		for (i = 0; i < eta_trapMoverCount; i++)
+		{
+			if (eta_trapMovers[i].group == g)
+			{
+				Q_strncpyz(name, eta_trapMovers[i].kind, sizeof(name));
+				break;
+			}
+		}
+		Com_sprintf(text, textSize, "Keep running %s, %d %s, out of the %s's reach",
+		            fabsf(AngleNormalize180(turn)) < 1.0f ? "straight ahead" : ETA_HudNarrator_RelativeDirection(AngleNormalize180(turn)),
+		            MAX(1, (int)( run * ETA_QU_TO_METERS + 0.5f )), (int)( run * ETA_QU_TO_METERS + 0.5f ) <= 1 ? "meter" : "meters",
+		            name);
+		return qtrue;
+	}
+	return qfalse;
+}
