+static void ETA_WorldRead(void);
+
+/* Whether the invisible switch at a point is switched off by the level now. */
+qboolean CG_AccessibilitySwitchOffAt(const vec3_t point)
+{
+	int i;
+
+	ETA_WorldRead();
+	for (i = 0; i < eta_userCount; i++)
+	{
+		if (Distance(cgs.inlineModelMidpoints[eta_users[i].model], point) < 32.0f)
+		{
+			return CG_AccessibilitySwitchOff(eta_users[i].model);
+		}
+	}
+	return qfalse;
+}
+
+/* Whether a switch at a point works a door: pressed twice, it works the
+   door back. */
+qboolean CG_AccessibilitySwitchOpensDoorAt(const vec3_t point)
+{
+	int i;
+
+	ETA_WorldRead();
+	for (i = 1; i < MAX_MODELS; i++)
+	{
+		if (eta_opensDoor[i] && Distance(cgs.inlineModelMidpoints[i], point) < 48.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
