+/* Whether an invisible switch is switched off by the level now. */
+qboolean CG_AccessibilitySwitchOff(int model)
+{
+	const char *state = CG_ConfigString(CS_ETA_TRIGGERS);
+
+	return (qboolean)( model > 0 && model < MAX_MODELS && state[0] == '!' && model < (int)strlen(state)
+	                   && state[model] == 'u' );
+}
