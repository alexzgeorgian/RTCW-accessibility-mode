diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 24ab924c..1bcf8066 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -2274,6 +2274,65 @@ static qboolean ETA_ClearLine(const vec3_t eye, const vec3_t point)
  * Things are listed out to a little past where they stop being news, so
  * an enemy leaving is heard leaving rather than vanishing.
  */
+/*
+ * An enemy out of sight, coming: said as one in sight is. The tester
+ * found the callouts came too late - a zombie round a corner was already
+ * on them when it was named - and, though they hear the footsteps as a
+ * sighted player does, a sighted player sees the enemy coming sooner and
+ * is shooting by then. So one coming at the player, within earshot and
+ * near their floor, is said before it is in sight; once said, it stays
+ * said while it is close, coming or not, so it is not lost and found
+ * again at every corner.
+ */
+#define ETA_HEARD_METERS     25.0f   /* coming, this close: heard */
+#define ETA_HEARD_KEEP       32.0f   /* said, and this close: still there */
+#define ETA_HEARD_FLOOR      160.0f  /* above or below by more than this: another floor */
+#define ETA_HEARD_COMING     40.0f   /* units a second toward the player: coming */
+
+static int eta_heardSince[MAX_GENTITIES];
+
+static qboolean ETA_EnemyHeardComing(const entityState_t *es, const centity_t *cent, const vec3_t delta, float meters)
+{
+	vec3_t toPlayer;
+	float  speed;
+
+	(void)cent;
+	if (es->number < 0 || es->number >= MAX_GENTITIES || (es->eFlags & EF_DEAD)
+	    || fabs(delta[2]) > ETA_HEARD_FLOOR)
+	{
+		return qfalse;
+	}
+
+	/* Said already, and still close: kept. */
+	if (eta_heardSince[es->number] && cg.time >= eta_heardSince[es->number] && meters <= ETA_HEARD_KEEP)
+	{
+		return qtrue;
+	}
+	eta_heardSince[es->number] = 0;
+
+	/* Its velocity, as the server sends a character's: extrapolated
+	   (TR_LINEAR_STOP) or not. */
+	if (meters > ETA_HEARD_METERS || ( es->pos.trType != TR_INTERPOLATE && es->pos.trType != TR_LINEAR_STOP ))
+	{
+		return qfalse;
+	}
+
+	VectorScale(delta, -1.0f, toPlayer);
+	toPlayer[2] = 0.0f;
+	if (VectorNormalize(toPlayer) < 1.0f)
+	{
+		return qfalse;
+	}
+	speed = es->pos.trDelta[0] * toPlayer[0] + es->pos.trDelta[1] * toPlayer[1];
+	if (speed < ETA_HEARD_COMING)
+	{
+		return qfalse;
+	}
+
+	eta_heardSince[es->number] = cg.time > 0 ? cg.time : 1;
+	return qtrue;
+}
