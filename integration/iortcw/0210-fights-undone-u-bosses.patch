diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 20d86394..c82551e9 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -8526,6 +8526,32 @@ static void ETA_WaypointsForgetFights(void)
 	eta_trail.waypointAt = 0;
 }
 
+/*
+ * Died, or the mission failed - an alarm sounded, someone not to be
+ * killed was: whatever happens next is undone by the load to come. The
+ * fights' waypoints go at once, and no fight is counted until the game
+ * goes on again. The tester, failed by an alarm in the forest, still had
+ * the fight's waypoint after the load.
+ */
+static qboolean eta_fightsHeld;
+
+void CG_AccessibilityFightsUndone(void)
+{
+	ETA_WaypointsForgetFights();
+	CG_AccessibilityThingsFightForget();
+	eta_fightsHeld = qtrue;
+}
+
+void CG_AccessibilityFightsGoOn(void)
+{
+	eta_fightsHeld = qfalse;
+}
+
+qboolean CG_AccessibilityFightsHeld(void)
+{
+	return eta_fightsHeld;
+}
+
 static void ETA_LoadedForget(void)
 {
 	static int lastStart;
@@ -8538,6 +8564,7 @@ static void ETA_LoadedForget(void)
 	lastStart = cgs.levelStartTime;
 	ETA_WaypointsForgetFights();
 	CG_AccessibilityThingsFightForget();
+	eta_fightsHeld = qfalse;
 	for (m = 0; m < MAX_MODELS; m++)
 	{
 		eta_switchSeen[m]     = qfalse;
