+/* Whether this level was entered by loading a save: savegame_loading,
+   as the server set it before the level started. */
+static int etaSaveLoading;
+
+int CG_AccessibilitySaveLoading( void ) {
+	return etaSaveLoading;
+}
+
 void CG_AccessibilityInit( void ) {
 	int i;
 
+	{
+		char loading[16];
+
+		trap_Cvar_VariableStringBuffer( "savegame_loading", loading, sizeof( loading ) );
+		etaSaveLoading = atoi( loading );
+	}
+
 	ETA_AccessibilityRuntime_Init();
 	ETA_HudNarrator_Init();
 	ETA_HudNarrator_SetFriendWords( "Friend", "friends" );
diff --git a/SP/code/cgame/cg_accessibility_areas.c b/SP/code/cgame/cg_accessibility_areas.c
index 340f9db3..0f9a377a 100644
--- a/SP/code/cgame/cg_accessibility_areas.c
+++ b/SP/code/cgame/cg_accessibility_areas.c
@@ -242,6 +242,18 @@ static const char *ETA_ExploredFile(void)
 	Com_sprintf(file, sizeof(file), "accessibility_explored_%s.txt", base);
 	return file;
 }
+/* As it was when the game was last saved: loading a save gives back what
+   had been explored by then, and no more. The tester asked for what is
+   explored to be remembered from a save, not kept on through a death. */
+static const char *ETA_ExploredSavedFile(void)
+{
+	static char file[MAX_QPATH];
+	char        base[MAX_QPATH];
+
+	COM_StripExtension(COM_SkipPath(cgs.mapname), base, sizeof(base));
+	Com_sprintf(file, sizeof(file), "accessibility_explored_%s_saved.txt", base);
+	return file;
+}
 #define ETA_EXPLORED_SAVE_MS 2000
 
 static qboolean eta_exploredDirty;
@@ -252,7 +264,49 @@ void CG_AccessibilityExploredChanged(void)
 	eta_exploredDirty = qtrue;
 }
 
+static void ETA_ExploredWrite(const char *name);
+
 static void ETA_ExploredSave(void)
+{
+	ETA_ExploredWrite(ETA_ExploredFile());
+}
+
+static void ETA_ExploredLoad(qboolean fromSave);
+
+/* A save of this same level loaded: the game restarts the level in
+   place, without starting the cgame again, so what was explored since
+   the save is forgotten here, and the save's own given back. */
+void CG_AccessibilityExploredRestart(void)
+{
+	char loading[16];
+	int  i;
+
+	trap_Cvar_VariableStringBuffer("savegame_loading", loading, sizeof(loading));
+	if (!atoi(loading) || !eta_areas.loaded)
+	{
+		return;
+	}
+	for (i = 0; i < ETA_AREAS_MAX; i++)
+	{
+		eta_areas.number[i]  = 0;
+		eta_areas.hasSpot[i] = 0;
+	}
+	eta_areas.numbered = 0;
+	eta_areas.current  = eta_areas.pending = -1;
+	CG_AccessibilityFrontierClear();
+	ETA_ExploredLoad(qtrue);
+}
+
+void CG_AccessibilityGameSaved(void)
+{
+	if (eta_areas.loaded)
+	{
+		ETA_ExploredWrite(ETA_ExploredFile());
+		ETA_ExploredWrite(ETA_ExploredSavedFile());
+	}
+}
+
+static void ETA_ExploredWrite(const char *name)
 {
 	fileHandle_t f;
 	char         line[256];
@@ -262,7 +316,7 @@ static void ETA_ExploredSave(void)
 
 	eta_exploredDirty   = qfalse;
 	eta_exploredSavedAt = cg.time;
-	if (trap_FS_FOpenFile(ETA_ExploredFile(), &f, FS_WRITE) < 0 || !f)
+	if (trap_FS_FOpenFile(name, &f, FS_WRITE) < 0 || !f)
 	{
 		return;
 	}
@@ -291,7 +345,7 @@ static void ETA_ExploredSave(void)
 	trap_FS_FCloseFile(f);
 }
 
-static void ETA_ExploredLoad(void)
+static void ETA_ExploredLoad(qboolean fromSave)
 {
 	static char  text[32768];
 	fileHandle_t f;
@@ -300,7 +354,21 @@ static void ETA_ExploredLoad(void)
 	qboolean     before, fromBefore = qfalse;
 
 	eta_exploredDirty = qfalse;
-	length            = trap_FS_FOpenFile(ETA_ExploredFile(), &f, FS_READ);
+	/* Entered fresh, not from a save: explored anew. From a save: as it
+	   was when saved, or failing that, as last known. */
+	if (!fromSave)
+	{
+		return;
+	}
+	length = trap_FS_FOpenFile(ETA_ExploredSavedFile(), &f, FS_READ);
+	if (length <= 0 || !f)
+	{
+		if (f)
+		{
+			trap_FS_FCloseFile(f);
+		}
+		length = trap_FS_FOpenFile(ETA_ExploredFile(), &f, FS_READ);
+	}
 	if (length <= 0 || !f)
 	{
 		if (f)
@@ -528,7 +596,7 @@ void CG_AccessibilityAreasLoaded(int count, qboolean bots)
 			ETA_AreasOpenings();
 		}
 	}
-	ETA_ExploredLoad();
+	ETA_ExploredLoad((qboolean)( CG_AccessibilitySaveLoading() != 0 ));
 	CG_Printf("eta: %s has %d areas%s, %d ways between them\n", cgs.mapname, count, bots ? " from its bots' file" : "",
 	          eta_areas.exitCount);
 }
