+/* "3 ways on: 2 doors, 1 doorway": how many, and of each kind. */
+static void ETA_WaysSummary(char *summary, size_t size)
+{
+	int kind, i, listed = 0;
+
+	Com_sprintf(summary, size, eta_ways.wayCount == 1 ? "1 way on" : "%d ways on", eta_ways.wayCount);
+	if (eta_ways.wayCount < 2)
+	{
+		return;
+	}
+	for (kind = 0; kind < (int)ARRAY_LEN(eta_wayWords); kind++)
+	{
+		int n = 0;
+
+		for (i = 0; i < eta_ways.wayCount; i++)
+		{
+			n += eta_ways.ways[i].kind == (eta_wayKind_t)kind;
+		}
+		if (n)
+		{
+			char one[64];
+
+			Q_strncpyz(one, eta_wayWords[kind], sizeof(one));
+			one[0] = (char)tolower((unsigned char)one[0]);
+			Q_strcat(summary, size, va("%s %d %s", listed++ ? "," : ":", n, n == 1 ? one : eta_wayWordsMany[kind]));
+		}
+	}
+}
