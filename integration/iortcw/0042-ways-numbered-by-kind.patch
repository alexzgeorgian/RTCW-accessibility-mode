+/* How many ways of a kind there are, and which of them this one is,
+   nearest first. */
+static int ETA_WaysOfKind(const eta_way_t *way, int *number)
+{
+	int count = 0, i;
+
+	*number = 0;
+	for (i = 0; i < eta_ways.wayCount; i++)
+	{
+		if (eta_ways.ways[i].kind == way->kind)
+		{
+			count++;
+			if (&eta_ways.ways[i] == way)
+			{
+				*number = count;
+			}
+		}
+	}
+	return count;
+}
+
