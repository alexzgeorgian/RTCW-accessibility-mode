@@ -2030,6 +2030,18 @@ static void ETA_NameFromModelPath(const char *path, char *out, size_t outSize)
  * is guessed from shape: a thing with no name is left out rather than
  * called something it might not be.
  */
+/* A meal eaten to the plate, or a stein drunk: the game leaves it there,
+   used up, and never lets it be taken (bg_misc.c, density 1 << 9). The
+   tester, at 90 health in the village, tried to eat from a plate on a
+   table and heard "You carry all you can of this". */
+qboolean CG_AccessibilityItemUsedUp(const entityState_t *es)
+{
+	return (qboolean)( es->eType == ET_ITEM && es->density == ( 1 << 9 )
+	                   && es->modelindex > 0 && es->modelindex < bg_numItems
+	                   && ( bg_itemlist[es->modelindex].giType == IT_HEALTH
+	                        || bg_itemlist[es->modelindex].giType == IT_POWERUP ) );
+}
