+/*
+ * A secret reached only by jumping. The church's: from the wooden
+ * landing over the nave, onto its low rail, up onto the top of the wall
+ * beside it, and off the wall's end onto the beam along the north wall,
+ * which leads into the gallery - the secret - and the treasure room at
+ * its end. The tester heard it in a walkthrough - "jump over something,
+ * then run over something" - and could not have found it by ear: a test
+ * player pressing the keys made the one long jump once in about twenty-
+ * five tries, and the steps found after, each short, work every time
+ * when turned exactly. So, as for the spike pits, the player chooses it
+ * with T and O leads to where it starts; there the mode turns them
+ * exactly for each step, and makes the jumps, while they hold W.
+ */
+typedef struct
+{
+	const char *map;        /* the level's file name, without maps/ and .bsp */
+	vec3_t      secret;     /* near the secret's trigger */
+	vec3_t      runFrom;    /* where the run starts, standing */
+	vec3_t      corner;     /* the point the run goes through: the heading */
+	float       jumpLeft;   /* how far short of it the jump is made */
+	float       upYaw;      /* step 2: the hop from the rail onto the wall */
+	float       offYaw;     /* step 3: the walk off the wall's end */
+	float       railZ, wallZ; /* standing on each, the origin's height */
+} etaSecretJump_t;
+
+static const etaSecretJump_t eta_secretJumps[] =
+{
+	{ "church", { 184.0f, 556.0f, 1224.0f }, { 425.0f, 400.0f, 1112.0f }, { 294.0f, 488.0f, 1112.0f }, 115.0f,
+	  90.0f, 136.0f, 1144.0f, 1176.0f },
+};
+
+#define ETA_SJ_NAME          "the start of the run to the secret area"
+#define ETA_SJ_AT            160.0f   /* this close to the start: the steps begin */
+#define ETA_SJ_ON            12.0f    /* this close, standing still: on it, the run begins */
+#define ETA_SJ_KEY_JUMP      "984"
+#define ETA_SJ_KEY_LEFT      "983"
+#define ETA_SJ_KEY_RIGHT     "982"
+
+enum { ETA_SJ_RUN = 1, ETA_SJ_RAIL, ETA_SJ_WALL, ETA_SJ_TOSTART };
+
+static struct
+{
+	const etaSecretJump_t *jump;
+	qboolean              armed;
+	int                   step;        /* ETA_SJ_RUN, _RAIL, _WALL */
+	qboolean              jumped;      /* in the air, from this step */
+	qboolean              jumpHeld;
+	qboolean              walked;      /* step 3: W pressed, off the wall */
+	qboolean              airborne;    /* off the ground since the jump or walk */
+	const etaSecretJump_t *leadTo;     /* O leading to the start: armed on arrival */
+	int                   at;          /* when armed, or jumped */
+	int                   pulseAt;
+	float                 yaw;         /* the heading of this step */
+	float                 jumpLeft;
+	vec3_t                runFrom, corner;
+} eta_sj;
+
+/* The jump for a secret at a place, on this level: or NULL. */
+static const etaSecretJump_t *ETA_SecretJumpFor(const vec3_t at)
+{
+	const char *map = cgs.mapname;
+	int        i;
+
+	if (!Q_strncmp(map, "maps/", 5))
+	{
+		map += 5;
+	}
+	for (i = 0; i < (int)ARRAY_LEN(eta_secretJumps); i++)
+	{
+		const etaSecretJump_t *j = &eta_secretJumps[i];
+
+		if (!Q_stricmpn(map, j->map, strlen(j->map)) && map[strlen(j->map)] == '.'
+		    && ( !at || Distance(at, j->secret) <= 256.0f ))
+		{
+			return j;
+		}
+	}
+	return NULL;
+}
+
+/* The way up being taken, step by step: the way's own jump hints keep
+   quiet meanwhile - "press space at the edge" said over it. */
+qboolean CG_AccessibilitySecretJumpActive(void)
+{
+	return eta_sj.armed;
+}
+
+/* For T's list: a secret reached this way is named for it. */
+qboolean CG_AccessibilitySecretByJump(const vec3_t at)
+{
+	return (qboolean)( ETA_SecretJumpFor(at) != NULL );
+}
+
+static void ETA_SecretJumpKey(qboolean down)
+{
+	if (down == eta_sj.jumpHeld)
+	{
+		return;
+	}
+	trap_SendConsoleCommand(va("%smoveup " ETA_SJ_KEY_JUMP "\n", down ? "+" : "-"));
+	eta_sj.jumpHeld = down;
+}
+
+static void ETA_SecretJumpHoldTurn(int way);
+
+static void ETA_SecretJumpDisarm(void)
+{
+	ETA_SecretJumpKey(qfalse);
+	ETA_SecretJumpHoldTurn(0);
+	eta_sj.armed  = qfalse;
+	eta_sj.jumped = qfalse;
+	eta_sj.jump   = NULL;
+}
+
+static void ETA_SecretJumpStep(int step, float yaw)
+{
+	eta_sj.step   = step;
+	eta_sj.yaw    = yaw;
+	eta_sj.jumped = qfalse;
+	eta_sj.walked   = qfalse;
+	eta_sj.airborne = qfalse;
+	eta_sj.at       = cg.time;
+}
+
+/* At the start of the run: armed, the line taken from where the player
+   stands through the corner, and what to do said. */
+static void ETA_SecretJumpArm(const etaSecretJump_t *j)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              line;
+
+	eta_sj.jump     = j;
+	eta_sj.armed    = qtrue;
+	eta_sj.jumpLeft = j->jumpLeft;
+	VectorCopy(j->runFrom, eta_sj.runFrom);
+	VectorCopy(j->corner, eta_sj.corner);
+	ETA_HudNarrator_HoldPassive(cg.time);
+	VectorSubtract(eta_sj.runFrom, ps->origin, line);
+	line[2] = 0.0f;
+	if (VectorLength(line) > ETA_SJ_ON)
+	{
+		/* Not quite there: first to the exact spot. */
+		ETA_SecretJumpStep(ETA_SJ_TOSTART, vectoyaw(line));
+		ETA_Speech_Say(va("At the way up to the secret area: four short steps, each turned for you. Stand still while "
+		                  "you are turned. Then hold W: you are stopped at the start of the run, %d %s on",
+		                  (int)( VectorLength(line) * ETA_QU_TO_METERS + 0.5f ) < 1 ? 1
+		                  : (int)( VectorLength(line) * ETA_QU_TO_METERS + 0.5f ),
+		                  (int)( VectorLength(line) * ETA_QU_TO_METERS + 0.5f ) <= 1 ? "meter" : "meters"));
+		return;
+	}
+	VectorSubtract(eta_sj.corner, ps->origin, line);
+	ETA_SecretJumpStep(ETA_SJ_RUN, vectoyaw(line));
+	ETA_Speech_Say("At the way up to the secret area: three short steps, each turned for you. Stand still while you "
+	               "are turned. Then hold Shift and W together, and keep them held: the running jump onto the low rail "
+	               "is made for you at the edge");
+}
+
+/* accessibilitySecretJumpTest: for testing, armed where the player
+   stands, on a level with such a jump. */
+void CG_AccessibilitySecretJumpTest_f(void)
+{
+	const etaSecretJump_t *j = ETA_SecretJumpFor(NULL);
+
+	if (j)
+	{
+		ETA_SecretJumpArm(j);
+	}
+}
+
+/*
+ * O, with the secret chosen and no way to it: to where the run starts.
+ * At the start: armed, if not already.
+ */
+static qboolean ETA_SecretJumpLead(const playerState_t *ps)
+{
+	vec3_t                origin, flat;
+	const char            *name = NULL;
+	const etaSecretJump_t *j;
+
+	if (!CG_AccessibilityMarkerInfo(origin, &name) || !name)
+	{
+		return qfalse;
+	}
+	if (!Q_stricmp(name, ETA_SJ_NAME))
+	{
+		j = ETA_SecretJumpFor(NULL);
+	}
+	else if (!Q_stricmpn(name, "Secret area", 11))
+	{
+		j = ETA_SecretJumpFor(origin);
+	}
+	else
+	{
+		return qfalse;
+	}
+	if (!j)
+	{
+		return qfalse;
+	}
+	if (eta_sj.armed)
+	{
+		return qtrue;
+	}
+	VectorSubtract(j->runFrom, ps->origin, flat);
+	if (fabsf(flat[2]) < 48.0f && sqrtf(flat[0] * flat[0] + flat[1] * flat[1]) < ETA_SJ_AT)
+	{
+		ETA_SecretJumpArm(j);
+		return qtrue;
+	}
+	CG_AccessibilityChoose(j->runFrom, ETA_SJ_NAME);
+	eta_sj.leadTo = j;
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say("The secret area is reached by jumping, from the wooden landing over the hall. O again leads to "
+	               "where it starts");
+	return qtrue;
+}
+
+/* Standing still: turned exactly to the step's heading - held turn
+   keys for the most of it, then nudges measured to the degree, as the
+   lock makes them (a nudge turns at most a frame's worth). qtrue once
+   on it. */
+static int eta_sjHeldTurn;   /* -1 right, 1 left, 0 none */
+
+static void ETA_SecretJumpHoldTurn(int way)
+{
+	if (way == eta_sjHeldTurn)
+	{
+		return;
+	}
+	if (eta_sjHeldTurn)
+	{
+		trap_SendConsoleCommand(va("-%s %s\n", eta_sjHeldTurn > 0 ? "left" : "right",
+		                           eta_sjHeldTurn > 0 ? ETA_SJ_KEY_LEFT : ETA_SJ_KEY_RIGHT));
+	}
+	if (way)
+	{
+		trap_SendConsoleCommand(va("+%s %s\n", way > 0 ? "left" : "right", way > 0 ? ETA_SJ_KEY_LEFT : ETA_SJ_KEY_RIGHT));
+	}
+	eta_sjHeldTurn = way;
+}
+
+static qboolean ETA_SecretJumpTurn(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	char                buf[32];
+	float               rate, err, frameMs = cg.frametime > 0 ? (float)cg.frametime : 16.0f;
+	int                 ms;
+
+	err = AngleSubtract(eta_sj.yaw, ps->viewangles[YAW]);
+	trap_Cvar_VariableStringBuffer("cl_yawspeed", buf, sizeof(buf));
+	rate = ( atof(buf) > 1.0f ? atof(buf) : 140.0f ) * 0.001f;
+
+	/* Further than two frames' turn: held. */
+	if (fabsf(err) > rate * frameMs * 2.0f)
+	{
+		ETA_SecretJumpHoldTurn(err > 0.0f ? 1 : -1);
+		return qfalse;
+	}
+	ETA_SecretJumpHoldTurn(0);
+	if (fabsf(err) <= 0.5f)
+	{
+		return qtrue;
+	}
+	ms = (int)( fabsf(err) / rate + 0.5f );
+	if (ms > 0 && ( cg.time - eta_sj.pulseAt >= (int)( 2.0f * frameMs ) || cg.time < eta_sj.pulseAt ))
+	{
+		const char *key  = err > 0.0f ? ETA_SJ_KEY_LEFT : ETA_SJ_KEY_RIGHT;
+		const char *turn = err > 0.0f ? "left" : "right";
+
+		eta_sj.pulseAt = cg.time;
+		trap_SendConsoleCommand(va("+%s %s 1000\n-%s %s %d\n", turn, key, turn, key, 1000 + ms));
+	}
+	return qfalse;
+}
+
+/*
+ * Each frame, armed: the view kept exactly on the step's heading while
+ * the player stands, the jumps made for them, and each landing said.
+ * Nothing else turns them meanwhile, and the edge guard leaves them be.
+ */
+static qboolean ETA_SecretJumpFrame(const usercmd_t *cmd)
+{
+	const playerState_t   *ps = &cg.predictedPlayerState;
+	const etaSecretJump_t *j  = eta_sj.jump;
+	vec3_t                dir, toCorner, flat;
+	qboolean              onGround = (qboolean)( ps->groundEntityNum != ENTITYNUM_NONE );
+
+	/* Led to the start, and there: the steps begin. Something else
+	   chosen meanwhile lets it go. */
+	if (!eta_sj.armed && eta_sj.leadTo)
+	{
+		vec3_t      origin;
+		const char *name = NULL;
+
+		if (CG_AccessibilityMarkerInfo(origin, &name) && name && Q_stricmp(name, ETA_SJ_NAME))
+		{
+			eta_sj.leadTo = NULL;
+		}
+		else
+		{
+			VectorSubtract(eta_sj.leadTo->runFrom, ps->origin, flat);
+			if (fabsf(flat[2]) < 48.0f && sqrtf(flat[0] * flat[0] + flat[1] * flat[1]) < ETA_SJ_AT && onGround)
+			{
+				j             = eta_sj.leadTo;
+				eta_sj.leadTo = NULL;
+				trap_SendConsoleCommand("-forward\n-back\n-moveleft\n-moveright\n");
+				ETA_SecretJumpArm(j);
+			}
+		}
+		return qfalse;
+	}
+	if (!eta_sj.armed || !j)
+	{
+		return qfalse;
+	}
+	if (eta_sj.jumpHeld && cg.time - eta_sj.at > 150)
+	{
+		ETA_SecretJumpKey(qfalse);
+	}
+	if (cmd->forwardmove > 0)
+	{
+		ETA_SecretJumpHoldTurn(0);   /* turning only while standing */
+	}
+	if (ps->pm_type != PM_NORMAL || ps->stats[STAT_HEALTH] <= 0 || cg.cameraMode)
+	{
+		ETA_SecretJumpDisarm();
+		return qfalse;
+	}
+
+	/* Down again after a jump, or a walk off: where to. */
+	if (( eta_sj.jumped || eta_sj.walked ) && !onGround)
+	{
+		eta_sj.airborne = qtrue;
+	}
+	if (( eta_sj.jumped || eta_sj.walked ) && !eta_sj.airborne && cg.time - eta_sj.at > 1500)
+	{
+		/* Never left the ground: the step again. */
+		trap_SendConsoleCommand("-forward\n-back\n-moveleft\n-moveright\n");
+		ETA_SecretJumpStep(eta_sj.step, eta_sj.yaw);
+		return qtrue;
+	}
+	if (( eta_sj.jumped || eta_sj.walked ) && eta_sj.airborne && onGround)
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		if (ps->origin[2] < j->runFrom[2] - 48.0f)
+		{
+			ETA_Speech_Say("Fallen below. The way up starts again from the wooden landing");
+			ETA_SecretJumpDisarm();
+		}
+		else if (ps->origin[1] > j->corner[1] + 24.0f)
+		{
+			ETA_Speech_Say("Over, on the beam. Keep W held, on into the secret gallery");
+			ETA_SecretJumpDisarm();
+		}
+		else if (fabsf(ps->origin[2] - j->railZ) < 6.0f && ps->origin[1] < j->corner[1] + 8.0f)
+		{
+			/* W let go of for them, as the edge guard does: held on,
+			   it walks them off the rail into the hall. */
+			trap_SendConsoleCommand("-forward\n-back\n-moveleft\n-moveright\n");
+			ETA_SecretJumpStep(ETA_SJ_RAIL, j->upYaw);
+			ETA_Speech_Say("On the rail, over the drop. Let go of W, and stand still: you are turned to the top of the "
+			               "wall. Then hold W again: the hop up is made for you");
+		}
+		else if (fabsf(ps->origin[2] - j->wallZ) < 8.0f)
+		{
+			trap_SendConsoleCommand("-forward\n-back\n-moveleft\n-moveright\n");
+			ETA_SecretJumpStep(ETA_SJ_WALL, j->offYaw);
+			ETA_Speech_Say("On top of the wall. Let go of W, and stand still: you are turned to the beam. Then hold "
+			               "W: walk off the end of the wall onto the beam, and on into the secret gallery");
+		}
+		else
+		{
+			/* Back where this step began: the same step again, W let
+			   go of first. */
+			trap_SendConsoleCommand("-forward\n-back\n-moveleft\n-moveright\n");
+			ETA_Speech_Say("Back where you were. Let go of W; then W again tries the same step");
+			ETA_SecretJumpStep(eta_sj.step, eta_sj.yaw);
+		}
+		return qtrue;
+	}
+	if (eta_sj.jumped || eta_sj.walked)
+	{
+		return qtrue;
+	}
+
+	VectorSubtract(eta_sj.runFrom, ps->origin, flat);
+	flat[2] = 0.0f;
+	if (VectorLength(flat) > 240.0f || cg.time - eta_sj.at > 120000 || cg.time < eta_sj.at)
+	{
+		ETA_SecretJumpDisarm();
+		return qfalse;
+	}
+
+	if (eta_sj.step == ETA_SJ_TOSTART)
+	{
+		vec3_t to;
+
+		VectorSubtract(eta_sj.runFrom, ps->origin, to);
+		to[2] = 0.0f;
+		VectorSet(dir, cosf(DEG2RAD(ps->viewangles[YAW])), sinf(DEG2RAD(ps->viewangles[YAW])), 0.0f);
+		{
+			/* W let go of early enough that the slide after it ends on
+			   the spot: the game's friction stops a run in about
+			   speed squared over twelve times the speed. */
+			float speed = sqrtf(ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1]);
+			float slide = speed * speed / ( 12.0f * MAX(speed, 100.0f) );
+
+			if (cmd->forwardmove > 0 && VectorLength(to) <= slide + 2.0f)
+			{
+				trap_SendConsoleCommand("-forward\n-back\n-moveleft\n-moveright\n");
+			}
+			if (speed > 10.0f)
+			{
+				return qfalse;   /* the edge guard still keeps watch */
+			}
+		}
+		if (VectorLength(to) <= ETA_SJ_ON)
+		{
+			/* Still, on the spot: turned for the run. */
+			vec3_t line;
+
+			VectorSubtract(eta_sj.corner, ps->origin, line);
+			ETA_SecretJumpStep(ETA_SJ_RUN, vectoyaw(line));
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("At the start. Stand still while you are turned. Then hold Shift and W together, and keep "
+			               "them held: the running jump onto the low rail is made for you at the edge");
+			return qtrue;
+		}
+		if (cmd->forwardmove <= 0)
+		{
+			eta_sj.yaw = vectoyaw(to);
+			ETA_SecretJumpTurn();
+			return qfalse;
+		}
+		if (fabsf(AngleSubtract(eta_sj.yaw, ps->viewangles[YAW])) > 3.0f)
+		{
+			trap_SendConsoleCommand("-forward\n");
+		}
+		/* Walking to the start, the edge guard still keeps watch. */
+		return qfalse;
+	}
+	if (cmd->forwardmove <= 0)
+	{
+		ETA_SecretJumpTurn();
+		return qtrue;
+	}
+	if (!onGround)
+	{
+		return qtrue;
+	}
+
+	switch (eta_sj.step)
+	{
+	case ETA_SJ_RUN:
+		/* Running along the line: the jump at the edge. */
+		VectorSet(dir, cosf(DEG2RAD(eta_sj.yaw)), sinf(DEG2RAD(eta_sj.yaw)), 0.0f);
+		VectorSubtract(eta_sj.corner, ps->origin, toCorner);
+		toCorner[2] = 0.0f;
+		if (DotProduct(toCorner, dir) <= eta_sj.jumpLeft)
+		{
+			ETA_SecretJumpKey(qtrue);
+			eta_sj.jumped = qtrue;
+			eta_sj.at     = cg.time;
+		}
+		break;
+	case ETA_SJ_RAIL:
+		/* Turned up to the wall first: W before that is held back by
+		   saying so - a step off the rail the wrong way is a fall. */
+		if (fabsf(AngleSubtract(eta_sj.yaw, ps->viewangles[YAW])) > 2.0f)
+		{
+			/* Not turned yet: W let go of, and the turn goes on. */
+			trap_SendConsoleCommand("-forward\n");
+			break;
+		}
+		ETA_SecretJumpKey(qtrue);
+		eta_sj.jumped = qtrue;
+		eta_sj.at     = cg.time;
+		break;
+	case ETA_SJ_WALL:
+		if (fabsf(AngleSubtract(eta_sj.yaw, ps->viewangles[YAW])) > 2.0f)
+		{
+			/* Not turned yet: W let go of, and the turn goes on. */
+			trap_SendConsoleCommand("-forward\n");
+			break;
+		}
+		eta_sj.walked = qtrue;
+		eta_sj.at     = cg.time;
+		break;
+	}
+	return qtrue;
+}
+
 static void ETA_EdgeGuardFrame(void)
 {
 	const playerState_t *ps = &cg.predictedPlayerState;
@@ -3690,6 +4182,10 @@ static void ETA_EdgeGuardFrame(void)
 	{
 		return;
 	}
+	if (ETA_SecretJumpFrame(&cmd))
+	{
+		return;
+	}
 	ETA_EdgeNearFrame(&cmd);
 	if (ETA_JumpAssistFrame(&cmd))
 	{
@@ -5034,7 +5530,7 @@ static void ETA_FacePendingFrame(void)
 		eta_facePendingAt = 0;
 		/* Still searching, but a gate with a switch is shut across the
 		   way: said now, not "no way found". */
-		if (ETA_GateLead(&cg.predictedPlayerState, qtrue, NULL))
+		if (ETA_SecretJumpLead(&cg.predictedPlayerState) || ETA_GateLead(&cg.predictedPlayerState, qtrue, NULL))
 		{
 			return;
 		}
@@ -5413,6 +5909,10 @@ static void ETA_FaceTheWayNow(void)
 		return;
 	}
 
+	if (ETA_SecretJumpLead(ps))
