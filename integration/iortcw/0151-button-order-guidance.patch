+/*
+ * The order as it is pressed. Each switch's part shows whether it is
+ * pressed, while the server sends it; what was seen is kept. The tester
+ * pressed them out of order, found a pressed one did nothing pressed
+ * again, and did not know how to start over: each press now says how
+ * many are in and which is next, O leads to it, a press out of order
+ * says what that costs and how to start again, and the reset is said.
+ */
+static int ETA_OrderCount(int *places)
+{
+	int m, count = 0;
+
+	*places = 0;
+	for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+	{
+		if (eta_switchPlace[m] && eta_switchPart[m])
+		{
+			*places = eta_switchPlaces[m];
+			count  += eta_switchPressed[m] ? 1 : 0;
+		}
+	}
+	return count;
+}
+
+/* The lowest in the order not pressed: 0 when all are. */
+static int ETA_OrderNextModel(void)
+{
+	int m, best = 0;
+
+	for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+	{
+		if (eta_switchPlace[m] && eta_switchPart[m] && !eta_switchPressed[m]
+		    && ( !best || eta_switchPlace[m] < eta_switchPlace[best] ))
+		{
+			best = m;
+		}
+	}
+	return best;
+}
+
+/* "the west one, 40 meters. O leads there", and O set to it. */
+static const char *ETA_OrderLead(int model)
+{
+	int meters = (int)( Distance(cg.predictedPlayerState.origin, cgs.inlineModelMidpoints[model]) * ETA_QU_TO_METERS + 0.5f );
+
+	CG_AccessibilityChoose(cgs.inlineModelMidpoints[model],
+	                       va("Button %d of %d, %s", eta_switchPlace[model], eta_switchPlaces[model], eta_switchSide[model]));
+	return va("the %s one, %d %s. O leads there", eta_switchSide[model], meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters");
+}
+
+/* All back to unpressed: said, when a ride brought them back. */
+static void ETA_OrderReset(qboolean say)
+{
+	int m, places, had = ETA_OrderCount(&places), next;
+
+	for (m = 1; m < MAX_MODELS; m++)
+	{
+		eta_switchSettling[m] = (qboolean)( eta_switchPressed[m] || eta_switchSettling[m] );
+		eta_switchPressed[m]  = qfalse;
+	}
+	eta_orderNext   = 1;
+	eta_orderBroken = qfalse;
+	next            = ETA_OrderNextModel();
+	if (say && had && next)
+	{
+		ETA_Speech_Say(va("The buttons have reset: press all %d again, in order. First %s", places, ETA_OrderLead(next)));
+	}
+}
+
+static void ETA_OrderFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  m, n;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		return;
+	}
+	/* Kept back while the walls' warning is heard out. */
+	if (eta_orderPending[0] && ( cg.time >= eta_crushUrgentUntil || cg.time + 10000 < eta_crushUrgentUntil ))
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(eta_orderPending);
+		eta_orderPending[0] = '\0';
+	}
+	for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+	{
+		qboolean pressed;
+
+		if (!eta_switchPlace[m] || !eta_switchPart[m])
+		{
+			continue;
+		}
+		for (n = 0; n < cg.snap->numEntities; n++)
+		{
+			if (cg.snap->entities[n].eType == ET_MOVER && cg.snap->entities[n].modelindex == eta_switchPart[m])
+			{
+				break;
+			}
+		}
+		if (n == cg.snap->numEntities)
+		{
+			continue;   /* not sent: as last seen */
+		}
+		{
+			const float *at = cg_entities[cg.snap->entities[n].number].lerpOrigin;
+
+			pressed = (qboolean)( Distance(at, eta_switchPartPressed[m]) + 1.0f < Distance(at, eta_switchPartRest[m]) );
+		}
+		/* First seen: as it is, nothing said - a game loaded with some
+		   pressed already. */
+		if (!eta_switchSeen[m])
+		{
+			eta_switchSeen[m]    = qtrue;
+			eta_switchPressed[m] = pressed;
+			if (pressed && eta_switchPlace[m] != eta_orderNext)
+			{
+				eta_orderBroken = qtrue;
+			}
+			else if (pressed)
+			{
+				eta_orderNext++;
+			}
+			continue;
+		}
+		/* Reset, its part slides back slowly: not pressed again on the
+		   way. */
+		if (eta_switchSettling[m])
+		{
+			eta_switchSettling[m] = pressed;
+			continue;
+		}
+		if (pressed == eta_switchPressed[m])
+		{
+			continue;
+		}
+		if (!pressed)
+		{
+			ETA_OrderReset(qtrue);
+			return;
+		}
+
+		/* Just pressed. */
+		eta_switchPressed[m] = qtrue;
+		{
+			int         places, count = ETA_OrderCount(&places), next = ETA_OrderNextModel();
+			qboolean    inOrder = (qboolean)( !eta_orderBroken && eta_switchPlace[m] == eta_orderNext );
+			char        text[MAX_STRING_CHARS];
+
+			if (inOrder)
+			{
+				eta_orderNext++;
+			}
+			if (!inOrder && !eta_orderBroken)
+			{
+				eta_orderBroken = qtrue;
+				Com_sprintf(text, sizeof(text), "Out of order: the hidden doors won't open this time. It still counts: "
+				            "%d of %d pressed.", count, places);
+				if (count < places)
+				{
+					Q_strcat(text, sizeof(text), " Press the rest, and the pillar still comes down. To try the order again, "
+					         "ride the pillar once: the buttons reset when it comes back down.");
+				}
+				else
+				{
+					Q_strcat(text, sizeof(text), " The pillar comes down. To try the order again, ride it once: the buttons "
+					         "reset when it comes back down.");
+				}
+			}
+			else if (count < places)
+			{
+				Com_sprintf(text, sizeof(text), "%d of %d pressed.", count, places);
+			}
+			else
+			{
+				Com_sprintf(text, sizeof(text), "All %d pressed%s.", places,
+				            eta_orderBroken ? ", but not in order: the hidden doors stay shut this time" : ", in order");
+			}
+			if (next)
+			{
+				Q_strcat(text, sizeof(text), va(" Next, %s", ETA_OrderLead(next)));
+			}
+			/* After the crushing walls' warning, not over it. */
+			if (cg.time < eta_crushUrgentUntil)
+			{
+				Q_strncpyz(eta_orderPending, text, sizeof(eta_orderPending));
+			}
+			else
+			{
+				ETA_HudNarrator_HoldPassive(cg.time);
+				ETA_Speech_Say(text);
+			}
+		}
+	}
+}
