+/* A hatch at the ladder by the player, level with them, open: F over
+   it would only swing it shut again. The tester, at the top of the
+   middle station's ladder down to the power room with its hatch open,
+   pressed F to climb down and was never taken down it. */
+/* Whether a turning door - a hatch - is anywhere but shut: turned, or
+   moving. */
+static qboolean ETA_DoorNotShut(int model)
+{
+	int i;
+
+	for (i = 0; i < MAX_GENTITIES; i++)
+	{
+		const centity_t *cent = &cg_entities[i];
+
+		if (cent->currentValid && cent->currentState.eType == ET_MOVER && cent->currentState.modelindex == model)
+		{
+			return (qboolean)( cent->currentState.apos.trType != TR_STATIONARY || cent->currentState.pos.trType != TR_STATIONARY
+			                   || VectorLength(cent->currentState.apos.trBase) > 1.0f );
+		}
+	}
+	return qfalse;
+}
+
+static qboolean ETA_HatchAtLadder(const vec3_t at)
+{
+	const float *me = cg.predictedPlayerState.origin;
+	int         model;
+
+	for (model = 1; model < MAX_MODELS; model++)
+	{
+		vec3_t   mins, maxs;
+		qboolean opens;
+
+		if (CG_AccessibilityDoorBox(model, mins, maxs, &opens) && maxs[2] - mins[2] <= 48.0f && ETA_DoorNotShut(model)
+		    && at[0] > mins[0] - 48.0f && at[0] < maxs[0] + 48.0f && at[1] > mins[1] - 48.0f && at[1] < maxs[1] + 48.0f
+		    && mins[2] > me[2] - 96.0f && mins[2] < me[2] + 96.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
