+/* Where to look to use a hatch over the ladder: up, still facing the
+   ladder, and not straight up, which the view never reaches. Turned to
+   the switch's own spot, a little behind, the test player turned off
+   the ladder and fell back to the floor. */
+static void ETA_HatchAimPoint(const vec3_t above, vec3_t point)
+{
+	vec3_t forward;
+
+	AngleVectors(cg.predictedPlayerState.viewangles, forward, NULL, NULL);
+	forward[2] = 0.0f;
+	VectorNormalize(forward);
+	VectorMA(cg.predictedPlayerState.origin, 16.0f, forward, point);
+	point[2] = above[2] + 4.0f;
+}
