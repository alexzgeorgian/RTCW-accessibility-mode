+/**
+ * @brief Whether the game climbs a ladder from this face: something in
+ *        front of the painted face - a clip brush over it - stops the
+ *        player before it, and the ladder is climbed from the other side.
+ *        The middle station's ladder down to the power room has a clip
+ *        over its back: its foot was put behind it, out of the shaft, and
+ *        the tester at the open hatch could not get down it.
+ */
+static qboolean ETA_LadderFaceClimbed(const ETA_BspLadder *ladder, const vec3_t centre, float half, const vec3_t face)
+{
+	trace_t trace;
+	vec3_t  from, to;
+	float   z;
+
+	for (z = 0.25f; z < 1.0f; z += 0.25f)
+	{
+		VectorMA(centre, half + 40.0f, face, from);
+		from[2] = ladder->mins[2] + (ladder->maxs[2] - ladder->mins[2]) * z;
+		VectorMA(centre, -half, face, to);
+		to[2] = from[2];
+		trap_CM_BoxTrace(&trace, from, to, NULL, NULL, 0, MASK_PLAYERSOLID);
+		if (!trace.startsolid && trace.fraction < 1.0f && (trace.surfaceFlags & SURF_LADDER)
+		    && DotProduct(trace.plane.normal, face) > 0.7f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
