+/* The dynamite thrown at it, there: the way out at once, ahead of the
+   fuse, and out of the blast's reach. */
+static qboolean ETA_CoverFrom(const vec3_t danger, vec3_t out);
+
+void CG_AccessibilityBreakFrame(void)
+{
+	int meters;
+
+	/* Died or restarted on the way back: its marker is let go of. */
+	if (cg.predictedPlayerState.pm_type == PM_DEAD || cg.predictedPlayerState.stats[STAT_HEALTH] <= 0)
+	{
+		vec3_t      at;
+		const char *name;
+
+		eta_breakArrivedAt = 0;
+		if (CG_AccessibilityMarkerInfo(at, &name) && name && !Q_stricmp(name, "the way back"))
+		{
+			CG_AccessibilityMarkerForget();
+		}
+		return;
+	}
+
+	if (!eta_breakArrivedAt || eta_breakDynamite <= 0 || cg.time < eta_breakArrivedAt || cg.time - eta_breakArrivedAt > 300000
+	    || CG_AccessibilityDynamiteCount() >= eta_breakDynamite
+	    || Distance(eta_breakArrivedFrom, cg.predictedPlayerState.origin) > 300.0f)
+	{
+		if (eta_breakArrivedAt && eta_breakDynamite > 0 && CG_AccessibilityDynamiteCount() > eta_breakDynamite)
+		{
+			eta_breakDynamite = CG_AccessibilityDynamiteCount();   /* more picked up */
+		}
+		return;
+	}
+	eta_breakArrivedAt = 0;
+	{
+		vec3_t cover;
+
+		if (ETA_CoverFrom(eta_breakDanger, cover))
+		{
+			meters = (int)( Distance(cover, cg.predictedPlayerState.origin) * ETA_QU_TO_METERS + 0.5f );
+			CG_AccessibilityChoose(cover, "the way back");
+			CG_AccessibilitySteerBack();
+			ETA_Speech_Say(va("Dynamite thrown. Take cover now, behind the wall %s, %d %s: hold W, you are steered there",
+			                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(cover)), meters < 1 ? 1 : meters,
+			                  meters == 1 ? "meter" : "meters"));
+			CG_AccessibilityFacePoint(cover);
+			return;
+		}
+	}
+	ETA_BreakBackKeep(eta_breakDanger);
+	if (!eta_breakBackAt)
+	{
+		ETA_Speech_Say("Dynamite thrown. Get out of this room, back the way you came, now");
+		return;
+	}
+	eta_breakBackAt = 0;
