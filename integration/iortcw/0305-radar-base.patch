+/* Cover from a blast at danger: the nearest spot, a few metres off, that
+   it cannot see and that is a straight walk from here - behind a wall,
+   as the tester took it, to the right of the radar room's door. */
+static qboolean ETA_CoverFrom(const vec3_t danger, vec3_t out)
+{
+	const float *here = cg.predictedPlayerState.origin;
+	float        best = 0.0f, r;
+	int          k, found = 0;
+
+	for (r = 64.0f; r <= 384.0f; r += 32.0f)
+	{
+		for (k = 0; k < 24; k++)
+		{
+			vec3_t  p, down;
+			trace_t tr;
+			float   yaw = k * 15.0f;
+
+			p[0] = here[0] + r * cos(DEG2RAD(yaw));
+			p[1] = here[1] + r * sin(DEG2RAD(yaw));
+			p[2] = here[2];
+			if (!ETA_CrumbClear(here, p) || CG_AccessibilityTrapUnder(p))
+			{
+				continue;
+			}
+			/* Ground under it, not a drop. */
+			VectorCopy(p, down);
+			down[2] -= 64.0f;
+			CG_Trace(&tr, p, NULL, NULL, down, cg.predictedPlayerState.clientNum, MASK_PLAYERSOLID);
+			if (tr.fraction >= 1.0f)
+			{
+				continue;
+			}
+			/* Unseen from the blast, the head as well. */
+			if (ETA_CrumbClear(danger, p))
+			{
+				continue;
+			}
+			p[2] += 32.0f;
+			if (ETA_CrumbClear(danger, p))
+			{
+				continue;
+			}
+			p[2] -= 32.0f;
+			if (!found || r < best)
+			{
+				found = 1;
+				best  = r;
+				VectorCopy(p, out);
+			}
+		}
+		if (found)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
