+/* Where to throw dynamite at it from: the nearest place outside the trap
+   its breaking sets off, in a straight line to a solid part of it through
+   the walls' gaps - doors not counted, they are opened. The tester threw
+   it at the radar control from its room's doorway, never going in. */
+static qboolean ETA_MarkerThrowSpot(vec3_t out)
+{
+	static vec3_t keptFor, kept;
+	static int    keptOk = -1;
+	vec3_t        aim;
+	float         best = 0.0f;
+	int           k, found = 0;
+	vec3_t        small = { -4.0f, -4.0f, -4.0f }, smallUp = { 4.0f, 4.0f, 4.0f };
+
+	if (keptOk >= 0 && VectorCompare(keptFor, eta_marker.origin))
+	{
+		VectorCopy(kept, out);
+		return (qboolean)keptOk;
+	}
+	if (!ETA_MarkerBreakableAim(aim))
+	{
+		VectorCopy(eta_marker.origin, aim);
+	}
+	for (k = 0; k < 72; k++)
+	{
+		vec3_t dir;
+		float  d;
+
+		dir[0] = cos(DEG2RAD(k * 5.0f));
+		dir[1] = sin(DEG2RAD(k * 5.0f));
+		dir[2] = 0.0f;
+		for (d = 32.0f; d <= 640.0f && ( !found || d < best ); d += 16.0f)
+		{
+			vec3_t  p, down, mins = { -15.0f, -15.0f, -24.0f }, maxs = { 15.0f, 15.0f, 32.0f };
+			trace_t tr;
+
+			VectorMA(aim, d, dir, p);
+			trap_CM_BoxTrace(&tr, aim, p, small, smallUp, 0, MASK_PLAYERSOLID);
+			if (tr.fraction < 1.0f)
+			{
+				break;   /* the world in the way: this way is done */
+			}
+			if (CG_AccessibilityTrapUnder(p))
+			{
+				continue;
+			}
+			/* Somewhere to stand: floor within reach below, and room. */
+			VectorCopy(p, down);
+			down[2] -= 160.0f;
+			trap_CM_BoxTrace(&tr, p, down, mins, maxs, 0, MASK_PLAYERSOLID);
+			if (tr.fraction >= 1.0f || tr.startsolid || tr.plane.normal[2] < 0.7f)
+			{
+				continue;
+			}
+			found = 1;
+			best  = d;
+			VectorCopy(tr.endpos, out);
+			break;
+		}
+	}
+	VectorCopy(eta_marker.origin, keptFor);
+	keptOk = found;
+	if (found)
+	{
+		VectorCopy(out, kept);
+	}
+	return (qboolean)found;
+}
