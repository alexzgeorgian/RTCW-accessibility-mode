+	eye[2] += cg.predictedPlayerState.viewheight;
+	CG_Trace(&tr, eye, NULL, NULL, at, cg.predictedPlayerState.clientNum, MASK_SHOT);
+	return (qboolean)( tr.fraction >= 0.97f
