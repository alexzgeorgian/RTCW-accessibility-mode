 /* Whether the marker is a place to stand - ground just under it, as
    under a waypoint or a thing lying somewhere - rather than a switch on a
    wall, which F reaches from the floor below. */
+/* The marker on something to break that the game still has whole -
+   an objective met by breaking it, like the radar base's radar control,
+   set in a wall: its middle is in the wall, never stood on. */
+static qboolean ETA_MarkerOnBreakable(void)
+{
+	int n;
+
+	for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		vec3_t               mins, maxs;
+		int                  k;
+
+		if (es->eType != ET_EXPLOSIVE || es->modelindex <= 0 || es->modelindex >= cgs.numInlineModels
+		    || !cgs.inlineDrawModel[es->modelindex] || !es->solid)
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[es->modelindex], mins, maxs);
+		VectorAdd(mins, cg_entities[es->number].lerpOrigin, mins);
+		VectorAdd(maxs, cg_entities[es->number].lerpOrigin, maxs);
+		for (k = 0; k < 3; k++)
+		{
+			if (eta_marker.origin[k] < mins[k] - 8.0f || eta_marker.origin[k] > maxs[k] + 8.0f)
+			{
+				break;
+			}
+		}
+		if (k == 3)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/* Where to stand to break the thing to break the marker is on: in front
+   of its open face. Its middle is in the wall, and the way to it ended
+   behind that wall, within the way's reach of the middle but with no
+   shot at it - the radar base's radar control backs onto a corridor. */
+static qboolean ETA_MarkerBreakableFace(float out[3])
+{
+	int n;
+
+	for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		vec3_t               mins, maxs, mid;
+		int                  k, thin = 0, side;
+
+		if (es->eType != ET_EXPLOSIVE || es->modelindex <= 0 || es->modelindex >= cgs.numInlineModels
+		    || !cgs.inlineDrawModel[es->modelindex] || !es->solid)
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[es->modelindex], mins, maxs);
+		VectorAdd(mins, cg_entities[es->number].lerpOrigin, mins);
+		VectorAdd(maxs, cg_entities[es->number].lerpOrigin, maxs);
+		for (k = 0; k < 3; k++)
+		{
+			if (eta_marker.origin[k] < mins[k] - 8.0f || eta_marker.origin[k] > maxs[k] + 8.0f)
+			{
+				break;
+			}
+		}
+		if (k < 3)
+		{
+			continue;
+		}
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		thin = ( maxs[0] - mins[0] <= maxs[1] - mins[1] ) ? 0 : 1;
+		for (side = -1; side <= 1; side += 2)
+		{
+			vec3_t  front;
+			trace_t tr;
+
+			VectorCopy(mid, front);
+			front[thin] = ( side < 0 ? mins[thin] : maxs[thin] ) + side * 40.0f;
+			if (CG_PointContents(front, -1) & MASK_PLAYERSOLID)
+			{
+				continue;
+			}
+			CG_Trace(&tr, front, NULL, NULL, mid, cg.predictedPlayerState.clientNum, MASK_SHOT);
+			if (tr.fraction >= 1.0f || tr.entityNum == es->number)
+			{
+				VectorCopy(front, out);
+				return qtrue;
+			}
+		}
+	}
+	return qfalse;
+}
+
+/* A point on the thing to break the marker is on that a shot from in
+   front of it hits: its middle may be a gap. The radar base's radar
+   control is a frame of plates with gaps between, its middle one of them,
+   and every shot turned to the middle went through. Nearest the middle,
+   tried a hand's width apart across its face. */
+static qboolean ETA_MarkerBreakableAim(vec3_t out)
+{
+	int n;
+
+	for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		vec3_t               mins, maxs, mid;
+		clipHandle_t         clip;
+		int                  k, thin, a, b;
+		float                side, best = -1.0f, u, v;
+
+		if (es->eType != ET_EXPLOSIVE || es->modelindex <= 0 || es->modelindex >= cgs.numInlineModels
+		    || !cgs.inlineDrawModel[es->modelindex] || !es->solid)
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[es->modelindex], mins, maxs);
+		VectorAdd(mins, cg_entities[es->number].lerpOrigin, mins);
+		VectorAdd(maxs, cg_entities[es->number].lerpOrigin, maxs);
+		for (k = 0; k < 3; k++)
+		{
+			if (eta_marker.origin[k] < mins[k] - 8.0f || eta_marker.origin[k] > maxs[k] + 8.0f)
+			{
+				break;
+			}
+		}
+		if (k < 3)
+		{
+			continue;
+		}
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		thin = ( maxs[0] - mins[0] <= maxs[1] - mins[1] ) ? 0 : 1;
+		a    = thin == 0 ? 1 : 0;   /* across the face */
+		b    = 2;                   /* up it */
+		side = cg.predictedPlayerState.origin[thin] >= mid[thin] ? 1.0f : -1.0f;
+		clip = trap_CM_InlineModel(es->modelindex);
+		for (u = mins[a] + 4.0f; u <= maxs[a] - 4.0f; u += 4.0f)
+		{
+			for (v = mins[b] + 4.0f; v <= maxs[b] - 4.0f; v += 4.0f)
+			{
+				vec3_t  from, to;
+				trace_t tr;
+				float   off = ( u - mid[a] ) * ( u - mid[a] ) + ( v - mid[b] ) * ( v - mid[b] );
+
+				if (best >= 0.0f && off >= best)
+				{
+					continue;
+				}
+				from[thin] = mid[thin] + side * ( ( maxs[thin] - mins[thin] ) * 0.5f + 16.0f );
+				to[thin]   = mid[thin] - side * ( ( maxs[thin] - mins[thin] ) * 0.5f + 16.0f );
+				from[a]    = to[a] = u;
+				from[b]    = to[b] = v;
+				trap_CM_BoxTrace(&tr, from, to, NULL, NULL, clip, MASK_SHOT);
+				if (tr.fraction < 1.0f && !tr.startsolid)
+				{
+					best = off;
+					VectorCopy(tr.endpos, out);
+				}
+			}
+		}
+		return (qboolean)( best >= 0.0f );
+	}
+	return qfalse;
+}
+
+/* Where to run once an objective broken is done: back along the way
+   that led to it. The radar base's radar control breaks, the dish falls,
+   and two or three seconds on the whole room it stood in goes up in
+   flames that kill at once; the test player, standing at the control,
+   died every time. */
+static vec3_t eta_breakBack;
+static int    eta_breakBackAt;
+static vec3_t eta_breakArrivedFrom;   /* where O said to fire */
+static int    eta_breakArrivedAt;
+static int    eta_breakDynamite;      /* the dynamite carried then; -1 told to fire */
+static vec3_t eta_breakDanger;        /* what blows */
+
+/* Where the player has walked on the way to the marker, a point each
+   step of a body's width, the last 64: the way they came. */
+#define ETA_CRUMBS 64
+static vec3_t eta_crumbs[ETA_CRUMBS];
+static int    eta_crumbAt[ETA_CRUMBS];
+static int    eta_crumbHead;
+
+static void ETA_CrumbFrame(void)
+{
+	const float *at   = cg.predictedPlayerState.origin;
+	int          last = ( eta_crumbHead + ETA_CRUMBS - 1 ) % ETA_CRUMBS;
+
+	if (eta_crumbAt[last] && cg.time >= eta_crumbAt[last] && Distance(eta_crumbs[last], at) < 24.0f)
+	{
+		return;
+	}
+	VectorCopy(at, eta_crumbs[eta_crumbHead]);
+	eta_crumbAt[eta_crumbHead] = cg.time ? cg.time : 1;
+	eta_crumbHead              = ( eta_crumbHead + 1 ) % ETA_CRUMBS;
+}
+
+/* The run back, as said: straight to the first leg's end, and the turn
+   and length of a second leg, if there is one. */
+static vec3_t eta_breakLeg2;
+static int    eta_breakLegs;
+
+static qboolean ETA_CrumbClear(const vec3_t from, const vec3_t to)
+{
+	trace_t tr;
+
+	CG_Trace(&tr, from, NULL, NULL, to, cg.predictedPlayerState.clientNum, MASK_PLAYERSOLID);
+	return (qboolean)( tr.fraction >= 1.0f );
+}
+
+static void ETA_BreakBackKeep(const float *danger)
+{
+	vec3_t here, exit;
+	int    order[ETA_CRUMBS], count = 0, k, i, out = -1;
+
+	eta_breakBackAt = 0;
+	eta_breakLegs   = 0;
+	VectorCopy(cg.predictedPlayerState.origin, here);
+
+	/* The steps back, newest first, as far as five minutes. */
+	for (k = 1; k < ETA_CRUMBS; k++)
+	{
+		i = ( eta_crumbHead + ETA_CRUMBS - k ) % ETA_CRUMBS;
+		if (!eta_crumbAt[i] || cg.time < eta_crumbAt[i] || cg.time - eta_crumbAt[i] > 300000)
+		{
+			break;
+		}
+		order[count++] = i;
+	}
+
+	/* Where to: out of the trap the player stands in, a body's length
+	   past its edge, if they are in one the map switches on; else eight
+	   metres back. */
+	for (k = 0; k < count; k++)
+	{
+		const char *trap = CG_AccessibilityTrapUnder(here);
+
+		const float *c = eta_crumbs[order[k]];
+
+		/* Out of the blast's reach, 600 units, by distance alone: a door
+		   shut when this is worked out is open once walked through, and
+		   the test player, just past the radar room's, died in the blast. */
+		if (danger && Distance(c, danger) < 680.0f)
+		{
+			continue;
+		}
+		if (trap ? !CG_AccessibilityTrapUnder(c) && ( k + 1 >= count || !CG_AccessibilityTrapUnder(eta_crumbs[order[k + 1]]) )
+		         : Distance(c, here) >= 320.0f)
+		{
+			out = k + 1 < count && trap ? k + 1 : k;
+			break;
+		}
+	}
+	if (out < 0)
+	{
+		out = count - 1;
+	}
+	if (out < 0)
+	{
+		return;
+	}
+	VectorCopy(eta_crumbs[order[out]], exit);
+
+	/* The first leg: the furthest step back, up to the way out, in a
+	   straight line from here. */
+	for (k = out; k >= 0; k--)
+	{
+		if (ETA_CrumbClear(here, eta_crumbs[order[k]]))
+		{
+			break;
+		}
+	}
+	if (k < 0 || Distance(eta_crumbs[order[k]], here) < 48.0f)
+	{
+		return;
+	}
+	VectorCopy(eta_crumbs[order[k]], eta_breakBack);
+	eta_breakBackAt = cg.time ? cg.time : 1;
+	eta_breakLegs   = 1;
+	/* The beacon leads the rest, and W is steered along it. */
+	VectorCopy(exit, eta_breakLeg2);
+	CG_AccessibilityChoose(exit, "the way back");
+	CG_AccessibilitySteerBack();
+}
+
+/* The objective just done: if broken where O led, the player is turned
+   back the way they came and told to run; "" otherwise. */
+const char *CG_AccessibilityObjectiveDoneRun(void)
+{
+	static char run[192];
+	int         meters;
+
+	if (!eta_breakArrivedAt || cg.time - eta_breakArrivedAt > 300000 || cg.time < eta_breakArrivedAt
+	    || Distance(eta_breakArrivedFrom, cg.predictedPlayerState.origin) > 200.0f)
+	{
+		eta_breakArrivedAt = 0;
+		return "";
+	}
+	eta_breakArrivedAt = 0;
+	ETA_BreakBackKeep(NULL);
+	if (!eta_breakBackAt)
+	{
+		return "";
+	}
+	eta_breakBackAt = 0;
+	CG_AccessibilityFacePoint(eta_breakBack);
+	meters = (int)( Distance(eta_breakLeg2, cg.predictedPlayerState.origin) * ETA_QU_TO_METERS + 0.5f );
+	Com_sprintf(run, sizeof(run), ". Run now: hold W, and you are steered back the way you came, %d %s", meters < 1 ? 1 : meters,
+	            meters == 1 ? "meter" : "meters");
+	Q_strcat(run, sizeof(run), ": it brings fire down here");
+	return run;
+}
