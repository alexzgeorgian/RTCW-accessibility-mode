 static void ETA_FaceTheWayNow(void)
 {
-	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              target, delta;
+	float               yaw;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
 	{
 		return;
 	}
 
-	/* Said, never turned: "Turn left toward the marker. The way goes
-	   east. Marker lies north, you are facing north" - the Enemy
-	   Territory mode's own words. Turned onto the way, the tester was
-	   turned into a wall; the turning is the player's, as it is there
-	   and in 1428, where the ping leads and the player turns. */
+	/* Turned toward the way, as 1428's N turns its player toward a
+	   waypoint - and, as there, always to an opening. The way's own
+	   direction once turned the tester into a wall; so it is tried as
+	   the game would walk it, and where a wall or an edge is in the way,
+	   the nearest opening either side is faced instead. Then said, in
+	   the Enemy Territory mode's words. */
+	if (CG_AccessibilityMarkerSteerPoint(target))
+	{
+		VectorSubtract(target, ps->origin, delta);
+		delta[2] = 0.0f;
+		if (VectorLength(delta) >= 16.0f && ETA_OpeningToward(vectoyaw(delta), &yaw))
+		{
+			etaAimTarget_t way;
+			vec3_t         dir;
+
+			memset(&way, 0, sizeof(way));
+			way.entityNum = -1;
+			VectorSet(dir, cosf(DEG2RAD(yaw)), sinf(DEG2RAD(yaw)), 0.0f);
+			VectorMA(ps->origin, 256.0f, dir, way.point);
+			way.point[2] = ps->origin[2] + ps->viewheight;
+			ETA_AimStartSnap(&way, NULL);
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(fabsf(AngleSubtract(yaw, vectoyaw(delta))) > 15.0f
+			               ? "Facing the opening nearest the way" : "Facing the way");
+			CG_AccessibilityMarkerWhere();
+			return;
+		}
+	}
+
 	ETA_HudNarrator_HoldPassive(cg.time);
 	CG_AccessibilityMarkerWhere();
 }
