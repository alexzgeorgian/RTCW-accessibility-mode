 static int    eta_waypointCount, eta_waypointNext, eta_destination;
 
+/* Kept as the next waypoint, named; the number it was given. */
+static int ETA_WaypointAdd(const vec3_t at, const char *name)
+{
+	int number = eta_waypointNext + 1;
+
+	VectorCopy(at, eta_waypoints[eta_waypointNext]);
+	Q_strncpyz(eta_waypointNames[eta_waypointNext], name ? name : "", sizeof(eta_waypointNames[0]));
+	eta_waypointNext = (eta_waypointNext + 1) % ETA_MAX_WAYPOINTS;
+	if (eta_waypointCount < ETA_MAX_WAYPOINTS)
+	{
+		eta_waypointCount++;
+	}
+	return number;
+}
+
+/**
+ * @brief A waypoint kept by itself: a locked door F turned to.
+ *
+ * In 1428 the tester knew each waypoint by what it was. Here the hard one
+ * to find again is the door: a switch found far off opens a door they no
+ * longer know the way back to. So a locked door F turns the player to is
+ * kept, once, named, where the player stands before it - L then leads
+ * back to it.
+ */
+void CG_AccessibilityWaypointRemember(const vec3_t at, const char *name)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              spot, toward;
+	int                 i;
+
+	for (i = 0; i < eta_waypointCount; i++)
+	{
+		if (!Q_stricmp(eta_waypointNames[i], name) && Distance(eta_waypoints[i], at) < 160.0f)
+		{
+			return;   /* already kept */
+		}
+	}
+
+	/* On the floor, a step in front of the door on the player's side:
+	   the door itself is not somewhere to stand. */
+	VectorSubtract(ps->origin, at, toward);
+	toward[2] = 0.0f;
+	if (VectorNormalize(toward) < 1.0f)
+	{
+		VectorSet(toward, 1.0f, 0.0f, 0.0f);
+	}
+	VectorMA(at, 40.0f, toward, spot);
+	spot[2] = ps->origin[2];
+	if (Distance(ps->origin, at) < 64.0f)
+	{
+		VectorCopy(ps->origin, spot);
+	}
+
+	ETA_Speech_Say(va("Waypoint %d: %s. L finds it again", ETA_WaypointAdd(spot, name), name));
+}
