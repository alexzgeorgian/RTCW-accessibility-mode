+/* The yaw nearest the one wanted that the player can walk on from here
+   - stepping up and down as the game does, no wall, no edge - tried a
+   little either side at a time, as far as a quarter turn. qfalse when
+   no way is open at all. */
+#define ETA_OPENING_CLEAR 112.0f   /* this far walked on: an opening */
+#define ETA_OPENING_SOME  32.0f    /* at the least this far, for want of better */
+
+static qboolean ETA_OpeningToward(float wanted, float *yaw)
+{
+	float best = 0.0f, bestYaw = wanted;
+	int   off, k;
+
+	for (off = 0; off <= 90; off += 10)
+	{
+		for (k = 0; k < (off ? 2 : 1); k++)
+		{
+			float    tryYaw = wanted + (float)(k ? -off : off), rise, walked;
+			qboolean edge;
+
+			walked = ETA_StairsKeepProbe(tryYaw, &rise, &edge);
+			if (edge)
+			{
+				continue;
+			}
+			if (walked >= ETA_OPENING_CLEAR)
+			{
+				*yaw = AngleNormalize360(tryYaw);
+				return qtrue;
+			}
+			if (walked > best)
+			{
+				best    = walked;
+				bestYaw = tryYaw;
+			}
+		}
+	}
+
+	if (best >= ETA_OPENING_SOME)
+	{
+		*yaw = AngleNormalize360(bestYaw);
+		return qtrue;
+	}
+	return qfalse;
+}
