+
+/* Railings the level lets break under a soldier who dies against them
+   (trigger_deathCheck): he falls with them, and the crash and the fall
+   rouse the soldiers below. The forest's watchtower has two; the tester,
+   shooting its guard there, heard the alarm a little later. A sighted
+   player sees him lean on the railing, and waits. */
+#define ETA_WEAK_RAILS 16
+
+static int eta_weakRail[ETA_WEAK_RAILS];
+static int eta_weakRailCount;
+
+qboolean CG_AccessibilityByWeakRailing(const vec3_t at)
+{
+	int i;
+
+	for (i = 0; i < eta_weakRailCount; i++)
+	{
+		vec3_t mins, maxs;
+
+		if (eta_weakRail[i] <= 0 || eta_weakRail[i] >= MAX_MODELS || !cgs.inlineDrawModel[eta_weakRail[i]])
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[eta_weakRail[i]], mins, maxs);
+		if (at[0] > mins[0] - 16.0f && at[0] < maxs[0] + 16.0f && at[1] > mins[1] - 16.0f && at[1] < maxs[1] + 16.0f
+		    && at[2] > mins[2] - 64.0f && at[2] < maxs[2] + 64.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
