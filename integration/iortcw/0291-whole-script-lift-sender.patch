+/*
+ * What sends a lift worked by its lever, when its call button will not:
+ * the rocket base's second lift comes down only with two soldiers in it,
+ * a soldier whose spawn pulls the lever ("toggle_by_ai"), alerted by a
+ * player trigger at a spot nearby. Read from the script: the lift's own
+ * lever (what the lift's events trigger), the soldier who pulls it, the
+ * player event that alerts him, and the trigger that fires that event.
+ * Where the trigger is; qfalse with none.
+ */
+/* Whether the player event that fired at a spot also starts a countdown
+   - the rocket base's launch: "trigger counter2 v2_countdown". */
+static char eta_senderEvent[48];
+
+qboolean CG_AccessibilityLiftSenderCountdown(void)
+{
+	int i;
+
+	for (i = 0; eta_senderEvent[0] && i < eta_unlockLineCount; i++)
+	{
+		if (eta_unlockLines[i].verb == 't' && !Q_stricmp(eta_unlockLines[i].owner, "player")
+		    && !Q_stricmp(eta_unlockLines[i].event, eta_senderEvent) && Q_stristr(eta_unlockLines[i].whatEvent, "countdown"))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+qboolean CG_AccessibilityLiftSenderSpot(const char *liftScript, vec3_t out)
+{
+	char lever[48] = "", ai[32] = "", event[48] = "";
+	int  i;
+
+	for (i = 0; i < eta_unlockLineCount && !lever[0]; i++)
+	{
+		if (eta_unlockLines[i].verb == 't' && !Q_stricmp(eta_unlockLines[i].owner, liftScript)
+		    && Q_stristr(eta_unlockLines[i].what, "lever"))
+		{
+			Q_strncpyz(lever, eta_unlockLines[i].what, sizeof(lever));
+		}
+	}
+	for (i = 0; lever[0] && i < eta_unlockLineCount && !ai[0]; i++)
+	{
+		if (eta_unlockLines[i].verb == 't' && !Q_stricmp(eta_unlockLines[i].what, lever)
+		    && !Q_stricmp(eta_unlockLines[i].whatEvent, "toggle_by_ai"))
+		{
+			Q_strncpyz(ai, eta_unlockLines[i].owner, sizeof(ai));
+		}
+	}
+	for (i = 0; ai[0] && i < eta_unlockLineCount && !event[0]; i++)
+	{
+		if (eta_unlockLines[i].verb == 'a' && !Q_stricmp(eta_unlockLines[i].owner, "player")
+		    && !Q_stricmp(eta_unlockLines[i].what, ai))
+		{
+			Q_strncpyz(event, eta_unlockLines[i].event, sizeof(event));
+		}
+	}
+	for (i = 0; event[0] && i < eta_unlockRecordCount; i++)
+	{
+		const eta_unlockRecord_t *r = &eta_unlockRecords[i];
+
+		if (!Q_stricmp(r->classname, "ai_trigger") && !Q_stricmp(r->ainame, "player") && !Q_stricmp(r->target, event)
+		    && r->model > 0 && r->model < MAX_MODELS)
+		{
+			VectorCopy(cgs.inlineModelMidpoints[r->model], out);
+			Q_strncpyz(eta_senderEvent, event, sizeof(eta_senderEvent));
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
