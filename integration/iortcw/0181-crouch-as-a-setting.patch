diff --git a/SP/code/client/cl_input.c b/SP/code/client/cl_input.c
index 116e0deb..1fc5e00b 100644
--- a/SP/code/client/cl_input.c
+++ b/SP/code/client/cl_input.c
@@ -193,8 +193,57 @@ float CL_KeyState( kbutton_t *key ) {
 
 void IN_UpDown( void ) {IN_KeyDown( &kb[KB_UP] );}
 void IN_UpUp( void ) {IN_KeyUp( &kb[KB_UP] );}
+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * [Accessibility]: the crouch key, pressed once to crouch and again to
+ * stand, when the Accessibility setting eta_crouchToggle is on. The
+ * tester, with one hand on the keys that move and one on those that say,
+ * could not hold it, and wanted the game's own Controls left as they
+ * were: C stays on +movedown, and only a real key's press is taken as
+ * the toggle. The mode's own crouches, on made-up key numbers past
+ * MAX_KEYS, still hold only while held. The toggle is a made-up key of
+ * its own, held down in the button until the next press - or until the
+ * cgame lets it go, at death or a cutscene.
+ */
+#define ETA_CROUCH_TOGGLE_KEY 980
+
+static qboolean IN_CrouchToggleKey( void ) {
+	int k;
+
+	if ( Cmd_Argc() < 2 || !Cvar_VariableIntegerValue( "eta_crouchToggle" ) ) {
+		return qfalse;
+	}
+	k = atoi( Cmd_Argv( 1 ) );
+	return (qboolean)( k > 0 && k < MAX_KEYS );
+}
+
+void IN_DownDown( void ) {
+	if ( IN_CrouchToggleKey() ) {
+		qboolean held = (qboolean)( kb[KB_DOWN].down[0] == ETA_CROUCH_TOGGLE_KEY
+									|| kb[KB_DOWN].down[1] == ETA_CROUCH_TOGGLE_KEY );
+		char time[16];
+
+		Q_strncpyz( time, Cmd_Argv( 2 ), sizeof( time ) );
+		Cmd_TokenizeString( va( "%cmovedown %d %s", held ? '-' : '+', ETA_CROUCH_TOGGLE_KEY, time ) );
+		if ( held ) {
+			IN_KeyUp( &kb[KB_DOWN] );
+		} else {
+			IN_KeyDown( &kb[KB_DOWN] );
+		}
+		return;
+	}
+	IN_KeyDown( &kb[KB_DOWN] );
+}
+void IN_DownUp( void ) {
+	if ( IN_CrouchToggleKey() ) {
+		return;
+	}
+	IN_KeyUp( &kb[KB_DOWN] );
+}
+#else
 void IN_DownDown( void ) {IN_KeyDown( &kb[KB_DOWN] );}
 void IN_DownUp( void ) {IN_KeyUp( &kb[KB_DOWN] );}
+#endif
 void IN_LeftDown( void ) {IN_KeyDown( &kb[KB_LEFT] );}
 void IN_LeftUp( void ) {IN_KeyUp( &kb[KB_LEFT] );}
 void IN_RightDown( void ) {IN_KeyDown( &kb[KB_RIGHT] );}
