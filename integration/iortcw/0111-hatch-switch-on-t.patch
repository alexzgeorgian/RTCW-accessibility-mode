+/* " for the hatch" for a door lying flat - a hatch - and " for a door"
+   for the rest: the tester asked after the middle station's "hatch
+   switch", which T called a switch for a door. */
+static const char *ETA_ForDoor(int door)
+{
+	vec3_t   mins, maxs;
+	qboolean opens;
+
+	if (door > 0 && door < MAX_MODELS && CG_AccessibilityDoorBox(door, mins, maxs, &opens)
+	    && maxs[2] - mins[2] <= 48.0f && maxs[0] - mins[0] >= 48.0f && maxs[1] - mins[1] >= 48.0f)
+	{
+		return " for the hatch";
+	}
+	return " for a door";
+}
