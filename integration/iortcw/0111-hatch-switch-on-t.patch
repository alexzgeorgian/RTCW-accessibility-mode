+/* Close by and in sight: on the list here, whatever area the map puts
+   it in. The switch that opens the middle station's hatch is set in the
+   wall of the room the tester stood in, a meter off, and its middle,
+   in the wall, was taken for another area's: T never had it. */
+#define ETA_THINGS_HERE_NEAR 400.0f
+
+static qboolean ETA_ThingHereInSight(const vec3_t point)
+{
+	vec3_t  eye;
+	trace_t trace;
+
+	VectorCopy(cg.predictedPlayerState.origin, eye);
+	eye[2] += cg.predictedPlayerState.viewheight;
+	if (Distance(eye, point) > ETA_THINGS_HERE_NEAR)
+	{
+		return qfalse;
+	}
+	CG_Trace(&trace, eye, NULL, NULL, point, cg.predictedPlayerState.clientNum, MASK_SOLID);
+	return (qboolean)( trace.fraction >= 0.95f
+	                   || ( trace.entityNum == ENTITYNUM_WORLD && Distance(trace.endpos, point) < 24.0f ) );
+}
+
+/* A switch on the far side of a shut door or hatch from here: the one
+   under the middle station's hatch, listed from the room above, could
+   not be pressed from there. */
+static qboolean ETA_ThingBehindShutDoor(const eta_thing_t *thing)
+{
+	vec3_t   eye;
+	trace_t  trace;
+	qboolean opens;
+
+	if (thing->kind != ETA_THING_SWITCH || thing->entityNum >= 0)
+	{
+		return qfalse;
+	}
+	VectorCopy(cg.predictedPlayerState.origin, eye);
+	eye[2] += cg.predictedPlayerState.viewheight;
+	CG_Trace(&trace, eye, NULL, NULL, thing->point, cg.predictedPlayerState.clientNum, MASK_SOLID);
+	return (qboolean)( trace.fraction < 1.0f && trace.entityNum >= 0 && trace.entityNum < ENTITYNUM_WORLD
+	                   && cg_entities[trace.entityNum].currentState.eType == ET_MOVER
+	                   && Distance(trace.endpos, thing->point) > 8.0f
+	                   && CG_AccessibilityDoorModel(cg_entities[trace.entityNum].currentState.modelindex, &opens) );
+}
