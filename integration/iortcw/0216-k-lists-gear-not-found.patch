+/*
+ * The gear the level lays out that the player has not got: each weapon
+ * on the map they do not carry, the nearest of each, after the waypoints
+ * on K. The tester searched the whole forest for the Colt and the
+ * Mauser's scope, dropped far apart, and asked for what was still to
+ * find to be pointed out. Nearest first; gone from the list once
+ * carried. Not those the level brings in later.
+ */
+#define ETA_GEAR_MAX 16
+
+static int ETA_GearList(int *list)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 i, j, count = 0;
+
+	for (i = 0; i < eta_mapItemCount; i++)
+	{
+		gitem_t *it = &bg_itemlist[eta_mapItems[i].item];
+
+		if (it->giType != IT_WEAPON || eta_mapItems[i].hidden == 'l' || it->giTag <= WP_NONE
+		    || it->giTag >= WP_NUM_WEAPONS || COM_BitCheck(ps->weapons, it->giTag))
+		{
+			continue;
+		}
+		for (j = 0; j < count; j++)
+		{
+			if (bg_itemlist[eta_mapItems[list[j]].item].giTag == it->giTag)
+			{
+				break;
+			}
+		}
+		if (j < count)
+		{
+			if (Distance(ps->origin, eta_mapItems[i].at) < Distance(ps->origin, eta_mapItems[list[j]].at))
+			{
+				list[j] = i;
+			}
+			continue;
+		}
+		if (count < ETA_GEAR_MAX)
+		{
+			list[count++] = i;
+		}
+	}
+	/* Nearest first. */
+	for (i = 1; i < count; i++)
+	{
+		int keep = list[i];
+
+		for (j = i; j > 0 && Distance(ps->origin, eta_mapItems[list[j - 1]].at) > Distance(ps->origin, eta_mapItems[keep].at); j--)
+		{
+			list[j] = list[j - 1];
+		}
+		list[j] = keep;
+	}
+	return count;
+}
