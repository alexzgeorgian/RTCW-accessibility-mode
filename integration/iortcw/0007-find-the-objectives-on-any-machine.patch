+/* Compared letter by letter here, not with the shared helpers, so the
+   one place the objectives hang on is plain to read. */
+static qboolean CG_AccessibilitySameName( const char *a, const char *b ) {
+	int ca, cb;
+
+	if ( !a || !b ) {
+		return qfalse;
+	}
+	do {
+		ca = (unsigned char)*a++;
+		cb = (unsigned char)*b++;
+		if ( ca >= 'A' && ca <= 'Z' ) {
+			ca += 'a' - 'A';
+		}
+		if ( cb >= 'A' && cb <= 'Z' ) {
+			cb += 'a' - 'A';
+		}
+		if ( ca != cb ) {
+			return qfalse;
+		}
+	} while ( ca );
+	return qtrue;
+}
