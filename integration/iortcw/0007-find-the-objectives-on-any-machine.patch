+/* The map's own name: the server's, else the mapname cvar, without a
+   maps/ folder or .bsp ending. */
+static void CG_AccessibilityMapName( void ) {
+	char *p;
+
+	Q_strncpyz( eta.map, Info_ValueForKey( CG_ConfigString( CS_SERVERINFO ), "mapname" ), sizeof( eta.map ) );
+	if ( !eta.map[0] ) {
+		trap_Cvar_VariableStringBuffer( "mapname", eta.map, sizeof( eta.map ) );
+	}
+	p = strrchr( eta.map, '/' );
+	if ( p ) {
+		memmove( eta.map, p + 1, strlen( p + 1 ) + 1 );
+	}
+	p = strrchr( eta.map, '.' );
+	if ( p && CG_AccessibilitySameName( p, ".bsp" ) ) {
+		*p = '\0';
+	}
+}
