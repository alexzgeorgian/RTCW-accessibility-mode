 	eta_scriptTriggerCount = eta_scriptMoverCount = eta_cornerCount = 0;
 	memset(eta_breakModel, 0, sizeof(eta_breakModel));
 	memset(eta_doorOpener, 0, sizeof(eta_doorOpener));
