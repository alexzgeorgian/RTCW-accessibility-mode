diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 4b1a352f..02df450f 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -5559,11 +5559,26 @@ static struct
 } eta_scriptMovers[ETA_MAX_SCRIPT_MOVERS];
 static int eta_scriptMoverCount;
 static qboolean eta_scriptDoor[MAX_MODELS];   /* a script mover opened as a door */
+static int      eta_scriptDoorUser[MAX_MODELS]; /* the invisible trigger F uses to open it */
 
 qboolean CG_AccessibilityScriptDoor(int model)
 {
 	return (qboolean)( model > 0 && model < MAX_MODELS && eta_scriptDoor[model] );
 }
+
+/* Where F is used to open a script door: its trigger's middle. The truck's
+   tailgate is opened from a strip just inside it, not from the tailgate:
+   led to the tailgate itself, past the strip, F there did nothing, and
+   the tester could not get out of the truck. qfalse with none. */
+qboolean CG_AccessibilityScriptDoorUse(int model, vec3_t at)
+{
+	if (!CG_AccessibilityScriptDoor(model) || eta_scriptDoorUser[model] <= 0)
+	{
+		return qfalse;
+	}
+	VectorCopy(cgs.inlineModelMidpoints[eta_scriptDoorUser[model]], at);
+	return qtrue;
+}
 static struct
 {
 	char   targetname[48];
