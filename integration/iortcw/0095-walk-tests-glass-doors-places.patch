+/*
+ * accessibilityNavSweep [max pairs]: for testing the way-finder. From a
+ * place in each area to a place in every other, the way is searched as O
+ * searches it, and each search printed: found, or only to the nearest
+ * square, or not at all; how long the way is against the straight line;
+ * and how long the search took. Printed "ETASWEEP" for the test harness.
+ */
+void CG_AccessibilityNavSweep_f(void)
+{
+	char     arg[16];
+	int      most, points = 0, i, j, pairs = 0, found = 0, partial = 0, failed = 0, slow = 0, detour = 0;
+	vec3_t   at[64];
+	int      area[64];
+
+	trap_Argv(1, arg, sizeof(arg));
+	most = atoi(arg) > 0 ? atoi(arg) : 400;
+	CG_AccessibilityWorldReadNow();
+	while (points < 64 && CG_AccessibilityAreaSweepPoint(points, at[points], &area[points]))
+	{
+		points++;
+	}
+	ETA_RouteLockedDoors();
+	/* "open": every door taken as open, for the way the map itself has. */
+	trap_Argv(2, arg, sizeof(arg));
+	if (!Q_stricmp(arg, "open"))
+	{
+		eta_routeLockedCount = 0;
+	}
+	trap_Argv(3, arg, sizeof(arg));
+	for (i = arg[0] ? atoi(arg) : 0; i < points && pairs < most; i++)
+	{
+		for (j = 0; j < points && pairs < most; j++)
+		{
+			float         start[3], goal[3], length = 0.0f, prev[3], point[3];
+			int           began, ms, k, count;
+			ETA_PathState state;
+
+			if (i == j)
+			{
+				continue;
+			}
+			ETA_RouteStartAt(at[i], start);
+			VectorCopy(at[j], goal);
+			ETA_PathFinder_Begin(start, goal, ETA_ROUTE_CELL, ETA_MARKER_ARRIVE_METERS / ETA_QU_TO_METERS, qfalse);
+			began = trap_Milliseconds();
+			do
+			{
+				state = ETA_PathFinder_Step(ETA_ROUTE_BUDGET_STEP, ETA_RouteMove, NULL);
+			}
+			while (state == ETA_PATH_SEARCHING && trap_Milliseconds() - began < 4000);
+			ms    = trap_Milliseconds() - began;
+			count = ETA_PathFinder_PointCount();
+			for (k = 0; k < count; k++)
+			{
+				ETA_PathFinder_Point(k, point);
+				if (k)
+				{
+					length += Distance(prev, point);
+				}
+				VectorCopy(point, prev);
+			}
+			pairs++;
+			found   += state == ETA_PATH_FOUND;
+			partial += state == ETA_PATH_PARTIAL;
+			failed  += state == ETA_PATH_FAILED || state == ETA_PATH_SEARCHING;
+			slow    += ms > 1000;
+			detour  += state == ETA_PATH_FOUND && length > 2.5f * Distance(at[i], at[j]) + 400.0f;
+			CG_Printf("ETASWEEP %s area %d (%.0f %.0f %.0f) to area %d (%.0f %.0f %.0f) way %.0f line %.0f ms %d gap %.0f\n",
+			          state == ETA_PATH_FOUND ? "found" : state == ETA_PATH_PARTIAL ? "partial"
+			          : state == ETA_PATH_FAILED ? "failed" : "timeout",
+			          area[i], at[i][0], at[i][1], at[i][2], area[j], at[j][0], at[j][1], at[j][2],
+			          length, Distance(at[i], at[j]), ms, count ? Distance(prev, at[j]) : -1.0f);
+		}
+	}
+	CG_Printf("ETASWEEP done %s: %d places, %d searches, %d found, %d partial, %d failed, %d slow, %d long detours\n",
+	          cgs.mapname, points, pairs, found, partial, failed, slow, detour);
+	ETA_RouteForget();
+}
