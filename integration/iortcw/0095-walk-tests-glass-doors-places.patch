+/* For the way-finder's test sweep: one place to stand in each area, just
+   through one of its doors that opens. qfalse past the last area. */
+qboolean CG_AccessibilityAreaSweepPoint(int index, vec3_t out, int *area)
+{
+	int a, i, n = 0;
+
+	for (a = 0; a < eta_areas.count && a < ETA_AREAS_MAX; a++)
+	{
+		for (i = 0; i < eta_areas.exitCount; i++)
+		{
+			const eta_areaExit_t *exit = &eta_areas.exits[i];
+
+			if ((exit->area[0] == a || exit->area[1] == a) && ETA_AreaExitOpens(exit))
+			{
+				break;
+			}
+		}
+		if (i == eta_areas.exitCount)
+		{
+			continue;
+		}
+		if (n++ == index)
+		{
+			VectorCopy(eta_areas.exits[i].side[eta_areas.exits[i].area[0] == a ? 0 : 1], out);
+			*area = a;
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
