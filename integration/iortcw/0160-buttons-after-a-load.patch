+/*
+ * A game loaded - a save, or the last one after dying: what was seen of
+ * the switches, the lifts and the traps before it is of another time.
+ * Kept, a button pressed after the save was taken for pressed, then seen
+ * not, and "the buttons have reset: press all 3 again" was said - the
+ * tester, back from dying, took the puzzle to be lost. Forgotten, without
+ * a word, and each learnt again as it is seen.
+ */
+static void ETA_LoadedForget(void)
+{
+	static int lastStart;
+	int        m, l, g;
+
+	if (lastStart == cgs.levelStartTime)
+	{
+		return;
+	}
+	if (!lastStart)
+	{
+		lastStart = cgs.levelStartTime;
+		return;
+	}
+	lastStart = cgs.levelStartTime;
+	for (m = 0; m < MAX_MODELS; m++)
+	{
+		eta_switchSeen[m]     = qfalse;
+		eta_switchPressed[m]  = qfalse;
+		eta_switchSettling[m] = qfalse;
+	}
+	eta_orderNext       = 1;
+	eta_orderBroken     = qfalse;
+	eta_orderPending[0] = '\0';
+	eta_orderLoaded     = qtrue;
+	for (l = 0; l < eta_liftCount; l++)
+	{
+		eta_lifts[l].announced    = qfalse;
+		eta_lifts[l].riding       = qfalse;
+		eta_lifts[l].everReady    = qfalse;
+		eta_lifts[l].stillSince   = 0;
+		eta_lifts[l].bridgeMoving = qfalse;
+		eta_lifts[l].bridgeOut    = qfalse;
+		eta_lifts[l].wasMoving    = qfalse;
+		eta_lifts[l].stoppedAt    = 0;
+	}
+	for (g = 0; g < eta_trapGroupCount; g++)
+	{
+		eta_trapGroups[g].retractEnd = 0;
+		eta_trapGroups[g].swungEarly = qfalse;
+		eta_trapGroups[g].goPending  = qfalse;
+		eta_trapGroups[g].waiting[0] = '\0';
+	}
+}
