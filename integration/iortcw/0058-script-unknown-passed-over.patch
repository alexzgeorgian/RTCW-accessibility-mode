 #include "ai_cast.h"
 
+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * [Accessibility]: a script naming a weapon or item this game does not
+ * have - a remake's script, from a file left in the main folder that
+ * wins over the game's own - is passed over and reported, not an error
+ * that ends the mission: the tester was put out of the game at escape1's
+ * way out. The cgame says the report.
+ */
+#define ETA_SCRIPT_UNKNOWN( action, name ) do { \
+		G_Printf( S_COLOR_YELLOW "WARNING: AI Scripting: %s %s, unknown, passed over\n", action, name ); \
+		trap_Cvar_Set( "eta_problem", va( "a character's script uses %s, which this game does not have. A file in the main folder that is not the original game's is the likely cause", name ) ); \
+		return qtrue; \
+} while ( 0 )
+#endif
