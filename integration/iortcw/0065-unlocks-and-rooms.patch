diff --git a/SP/code/cgame/cg_accessibility_unlock.c b/SP/code/cgame/cg_accessibility_unlock.c
new file mode 100644
index 00000000..979a8888
--- /dev/null
+++ b/SP/code/cgame/cg_accessibility_unlock.c
@@ -0,0 +1,405 @@
+/*
+ * name:	cg_accessibility_unlock.c
+ *
+ * desc:	[Accessibility]: what unlocks a door that no switch opens - a
+ *			place to walk to, another door to open - found from the map's
+ *			entities and its scripts, for T's list.
+ *
+ *			Only built with FEATURE_ACCESSIBILITY.
+ */
+
+#ifdef FEATURE_ACCESSIBILITY
+
+#include "cg_local.h"
+
+/**
+ * @brief "Spot that unlocks a door", on T's list.
+ *
+ * The tester, in the second level, found a door locked and looked on T's
+ * list for its switch: there was none. Many of the campaign's doors are
+ * not opened by a switch at all. A locked door is unlocked by a
+ * target_lock, fired by an invisible trigger the player walks into, or by
+ * a relay the level's script alerts when the player reaches a place - an
+ * ai_trigger calling one of the player's script events - or when another
+ * door is opened. A door with a name and no lock opens only when fired
+ * the same way. So the chain is followed back from each such door,
+ * through the entities that aim at one another and through the
+ * alertentity and trigger lines of maps/<map>.ai and .script, to the
+ * places the player can reach: those are T's.
+ */
+
+#define ETA_UNLOCK_RECORDS 2048
+#define ETA_UNLOCK_LINES   1024
+#define ETA_UNLOCK_SPOTS   32
+#define ETA_UNLOCK_DEPTH   6
+
+typedef struct
+{
+	char classname[24];
+	int  model;
+	char targetname[48];
+	char target[48];
+	char ainame[32];
+	int  lock;          /* a door's "key" -1 */
+} eta_unlockRecord_t;
+
+/* A script line that sets something going: "alertentity NAME", or
+   "trigger OWNER EVENT". */
+typedef struct
+{
+	char owner[32];
+	char event[48];     /* "spawn", or the name after "trigger" */
+	char verb;          /* 'a' alertentity, 't' trigger */
+	char what[48];      /* what is alerted, or the owner triggered */
+	char whatEvent[48]; /* the event triggered */
+} eta_unlockLine_t;
+
+static eta_unlockRecord_t eta_unlockRecords[ETA_UNLOCK_RECORDS];
+static int                eta_unlockRecordCount;
+static eta_unlockLine_t   eta_unlockLines[ETA_UNLOCK_LINES];
+static int                eta_unlockLineCount;
+
+static struct
+{
+	vec3_t at;
+	char   name[64];
+} eta_unlockSpots[ETA_UNLOCK_SPOTS];
+static int eta_unlockSpotCount;
+
+void CG_AccessibilityUnlockReset(void)
+{
+	eta_unlockRecordCount = eta_unlockLineCount = eta_unlockSpotCount = 0;
+}
+
+/* Each entity the map lays out, from ETA_ReadMapEntities: only those
+   aimed at something or named matter. */
+void CG_AccessibilityUnlockEntity(const char *classname, const char *model, const char *targetname,
+                                  const char *target, const char *ainame, const char *lock)
+{
+	eta_unlockRecord_t *r;
+
+	if (( !targetname[0] && !target[0] ) || eta_unlockRecordCount >= ETA_UNLOCK_RECORDS)
+	{
+		return;
+	}
+	r = &eta_unlockRecords[eta_unlockRecordCount++];
+	Q_strncpyz(r->classname, classname, sizeof(r->classname));
+	r->model = model[0] == '*' ? atoi(model + 1) : 0;
+	Q_strncpyz(r->targetname, targetname, sizeof(r->targetname));
+	Q_strncpyz(r->target, target, sizeof(r->target));
+	Q_strncpyz(r->ainame, ainame, sizeof(r->ainame));
+	r->lock = lock[0] && atoi(lock) == -1;
+}
+
+/* The script's lines that set things going, owner and event kept. A
+   script is a list of owners, each with its events in braces, each with
+   its lines in braces. */
+static void ETA_UnlockReadScript(const char *file)
+{
+	static char  text[65536];
+	fileHandle_t f;
+	int          length, depth = 0;
+	char         owner[32], event[48];
+	char         *p, *line;
+
+	length = trap_FS_FOpenFile(file, &f, FS_READ);
+	if (length <= 0 || !f)
+	{
+		if (f)
+		{
+			trap_FS_FCloseFile(f);
+		}
+		return;
+	}
+	if (length >= (int)sizeof(text))
+	{
+		length = sizeof(text) - 1;
+	}
+	trap_FS_Read(text, length, f);
+	trap_FS_FCloseFile(f);
+	text[length] = '\0';
+
+	owner[0] = event[0] = '\0';
+	for (line = text; line && *line; line = p)
+	{
+		char word[3][64];
+		int  words, k;
+		char *c;
+
+		p = strchr(line, '\n');
+		if (p)
+		{
+			*p++ = '\0';
+		}
+		c = strstr(line, "//");
+		if (c)
+		{
+			*c = '\0';
+		}
+
+		words = 0;
+		for (c = line; *c && words < 3; )
+		{
+			while (*c == ' ' || *c == '\t' || *c == '\r')
+			{
+				c++;
+			}
+			if (!*c)
+			{
+				break;
+			}
+			if (*c == '{' || *c == '}')
+			{
+				depth += *c == '{' ? 1 : -1;
+				depth  = depth < 0 ? 0 : depth;
+				c++;
+				continue;
+			}
+			for (k = 0; *c && *c != ' ' && *c != '\t' && *c != '\r' && *c != '{' && *c != '}' && k < 63; c++)
+			{
+				word[words][k++] = *c;
+			}
+			word[words++][k] = '\0';
+		}
+		if (!words)
+		{
+			continue;
+		}
+
+		/* An owner at the top, an event inside it, its lines inside that.
+		   An event is "spawn", "death" and the like, or "trigger NAME". */
+		if (depth == 0)
+		{
+			Q_strncpyz(owner, word[0], sizeof(owner));
+			event[0] = '\0';
+		}
+		else if (depth == 1)
+		{
+			Q_strncpyz(event, !Q_stricmp(word[0], "trigger") && words > 1 ? word[1] : word[0], sizeof(event));
+		}
+		else if (eta_unlockLineCount < ETA_UNLOCK_LINES)
+		{
+			eta_unlockLine_t *l = &eta_unlockLines[eta_unlockLineCount];
+
+			if (!Q_stricmp(word[0], "alertentity") && words > 1)
+			{
+				l->verb = 'a';
+				Q_strncpyz(l->what, word[1], sizeof(l->what));
+				l->whatEvent[0] = '\0';
+			}
+			else if (!Q_stricmp(word[0], "trigger") && words > 2)
+			{
+				l->verb = 't';
+				Q_strncpyz(l->what, word[1], sizeof(l->what));
+				Q_strncpyz(l->whatEvent, word[2], sizeof(l->whatEvent));
+			}
+			else
+			{
+				continue;
+			}
+			Q_strncpyz(l->owner, owner, sizeof(l->owner));
+			Q_strncpyz(l->event, event, sizeof(l->event));
+			eta_unlockLineCount++;
+		}
+	}
+}
+
+static void ETA_UnlockAddSpot(int model, const char *name)
+{
+	vec3_t   mins, maxs, at;
+	qboolean opens;
+	int      i;
+
+	if (model <= 0 || model >= MAX_MODELS || !cgs.inlineDrawModel[model] || eta_unlockSpotCount >= ETA_UNLOCK_SPOTS)
+	{
+		return;
+	}
+	/* A door turning round its hinge is built round its origin. */
+	if (!CG_AccessibilityDoorBox(model, mins, maxs, &opens))
+	{
+		trap_R_ModelBounds(cgs.inlineDrawModel[model], mins, maxs);
+	}
+	at[0] = ( mins[0] + maxs[0] ) * 0.5f;
+	at[1] = ( mins[1] + maxs[1] ) * 0.5f;
+	/* A trigger stands from the floor up: led to its foot, not its
+	   middle in the air. */
+	at[2] = mins[2] + 24.0f;
+	for (i = 0; i < eta_unlockSpotCount; i++)
+	{
+		if (Distance(eta_unlockSpots[i].at, at) < 64.0f)
+		{
+			return;
+		}
+	}
+	VectorCopy(at, eta_unlockSpots[eta_unlockSpotCount].at);
+	Q_strncpyz(eta_unlockSpots[eta_unlockSpotCount].name, name, sizeof(eta_unlockSpots[0].name));
+	eta_unlockSpotCount++;
+}
+
+static void ETA_UnlockFired(const char *name, int depth);
+
+/* A script event of an owner: where the player sets it going. */
+static void ETA_UnlockEvent(const char *owner, const char *event, int depth)
+{
+	int i;
+
+	if (depth > ETA_UNLOCK_DEPTH || !owner[0] || !event[0])
+	{
+		return;
+	}
+
+	/* The player's own event is called by an ai_trigger for the player,
+	   walked into, or by a script trigger something else fires. */
+	if (!Q_stricmp(owner, "player"))
+	{
+		for (i = 0; i < eta_unlockRecordCount; i++)
+		{
+			const eta_unlockRecord_t *r = &eta_unlockRecords[i];
+
+			if (Q_stricmp(r->target, event))
+			{
+				continue;
+			}
+			if (!Q_stricmp(r->classname, "ai_trigger") && !Q_stricmp(r->ainame, "player"))
+			{
+				ETA_UnlockAddSpot(r->model, "Spot that unlocks a door");
+			}
+			else if (!Q_stricmp(r->classname, "target_script_trigger") && r->targetname[0])
+			{
+				ETA_UnlockFired(r->targetname, depth + 1);
+			}
+		}
+	}
+
+	/* Another owner's event: called by a "trigger OWNER EVENT" line, or,
+	   for its spawn, by the line that alerts it into the level. */
+	for (i = 0; i < eta_unlockLineCount; i++)
+	{
+		const eta_unlockLine_t *l = &eta_unlockLines[i];
+
+		if (( l->verb == 't' && !Q_stricmp(l->what, owner) && !Q_stricmp(l->whatEvent, event) )
+		    || ( l->verb == 'a' && !Q_stricmp(event, "spawn") && !Q_stricmp(l->what, owner) ))
+		{
+			ETA_UnlockEvent(l->owner, l->event, depth + 1);
+		}
+	}
+}
+
+/* Something by name, fired: by what aims at it, or by the script. */
+static void ETA_UnlockFired(const char *name, int depth)
+{
+	int i;
+
+	if (depth > ETA_UNLOCK_DEPTH || !name[0])
+	{
+		return;
+	}
+	for (i = 0; i < eta_unlockRecordCount; i++)
+	{
+		const eta_unlockRecord_t *r = &eta_unlockRecords[i];
+
+		if (Q_stricmp(r->target, name))
+		{
+			continue;
+		}
+		/* Only for the soldiers: they open doors by these. */
+		if (!Q_stricmp(r->classname, "trigger_aidoor"))
+		{
+			continue;
+		}
+		if (r->model && ( !Q_stricmp(r->classname, "trigger_once") || !Q_stricmp(r->classname, "trigger_multiple")
+		                  || ( !Q_stricmp(r->classname, "ai_trigger") && !Q_stricmp(r->ainame, "player") ) ))
+		{
+			ETA_UnlockAddSpot(r->model, "Spot that unlocks a door");
+		}
+		else if (r->model && !Q_stricmpn(r->classname, "func_door", 9))
+		{
+			ETA_UnlockAddSpot(r->model, "Door that, opened, unlocks another");
+		}
+		else if (!r->model && r->targetname[0])
+		{
+			/* A relay, a delay, a script trigger: whatever fires it. */
+			ETA_UnlockFired(r->targetname, depth + 1);
+		}
+		/* A button or an invisible switch is on T's list already. */
+	}
+	for (i = 0; i < eta_unlockLineCount; i++)
+	{
+		const eta_unlockLine_t *l = &eta_unlockLines[i];
+
+		if (l->verb == 'a' && !Q_stricmp(l->what, name))
+		{
+			ETA_UnlockEvent(l->owner, l->event, depth + 1);
+		}
+	}
+}
+
+/* Once the map's entities are read: the places that unlock its doors. */
+void CG_AccessibilityUnlockResolve(void)
+{
+	char base[MAX_QPATH];
+	int  i, j;
+
+	Q_strncpyz(base, cgs.mapname, sizeof(base));
+	COM_StripExtension(base, base, sizeof(base));
+	ETA_UnlockReadScript(va("%s.ai", base));
+	ETA_UnlockReadScript(va("%s.script", base));
+
+	for (i = 0; i < eta_unlockRecordCount; i++)
+	{
+		const eta_unlockRecord_t *door = &eta_unlockRecords[i];
+		qboolean                 player = qfalse, soldiers = qfalse;
+
+		if (Q_stricmpn(door->classname, "func_door", 9) || !door->targetname[0])
+		{
+			continue;
+		}
+
+		/* A door with a name opens only when fired - unless it is the
+		   player's to open, by a switch (on T's list) or as a door. */
+		for (j = 0; j < eta_unlockRecordCount; j++)
+		{
+			const eta_unlockRecord_t *r = &eta_unlockRecords[j];
+
+			if (Q_stricmp(r->target, door->targetname))
+			{
+				continue;
+			}
+			if (!Q_stricmp(r->classname, "func_button") || !Q_stricmp(r->classname, "func_invisible_user"))
+			{
+				player = qtrue;
+			}
+			else if (!Q_stricmp(r->classname, "trigger_aidoor"))
+			{
+				soldiers = qtrue;   /* a door anyone opens, the player too */
+			}
+			else if (!Q_stricmp(r->classname, "target_lock") && r->targetname[0])
+			{
+				ETA_UnlockFired(r->targetname, 1);
+			}
+		}
+		if (!door->lock && !player && !soldiers)
+		{
+			ETA_UnlockFired(door->targetname, 1);
+		}
+	}
+	CG_Printf("eta: %d places unlock doors in %s\n", eta_unlockSpotCount, cgs.mapname);
+}
+
+int CG_AccessibilityUnlockCount(void)
+{
+	return eta_unlockSpotCount;
+}
+
+qboolean CG_AccessibilityUnlockSpot(int index, vec3_t at, char *name, size_t nameSize)
+{
+	if (index < 0 || index >= eta_unlockSpotCount)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_unlockSpots[index].at, at);
+	Q_strncpyz(name, eta_unlockSpots[index].name, nameSize);
+	return qtrue;
+}
+
+#endif
