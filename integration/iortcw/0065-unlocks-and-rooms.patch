 	eta_exitCount = 0;
+	CG_AccessibilityUnlockReset();
 
 	for (;;)
 	{
@@ -3938,6 +3939,8 @@ static void ETA_ReadMapEntities(void)
 			}
 		}
 
+		CG_AccessibilityUnlockEntity(classname, model, targetname, target, ainame, lock);
+
 		/* An item the map places. */
 		if (origin[0] && classname[0] && eta_mapItemCount < ETA_MAP_ITEMS)
