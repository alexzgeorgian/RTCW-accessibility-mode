 void CG_AccessibilityHealth_f( void );
 void CG_AccessibilityAmmo_f( void );
 qboolean CG_AccessibilityDoorBox( int model, vec3_t mins, vec3_t maxs, qboolean *opens );
+void CG_AccessibilityUnlockReset( void );
+void CG_AccessibilityUnlockEntity( const char *classname, const char *model, const char *targetname,
+								   const char *target, const char *ainame, const char *lock );
+void CG_AccessibilityUnlockResolve( void );
