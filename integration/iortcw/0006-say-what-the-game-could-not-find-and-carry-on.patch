diff --git a/SP/code/game/ai_cast_script.c b/SP/code/game/ai_cast_script.c
index d468d1b..32e0403 100644
--- a/SP/code/game/ai_cast_script.c
+++ b/SP/code/game/ai_cast_script.c
@@ -549,8 +549,24 @@ void AICast_ScriptParse( cast_state_t *cs ) {
 
 						if ( !Q_stricmp( action->actionString, "giveweapon" ) ) { // register weapon for client pre-loading
 							gitem_t *weap = BG_FindItem2( token );    // (SA) FIXME: rats, need to fix this for weapon names with spaces: 'mauser rifle'
+#ifdef FEATURE_ACCESSIBILITY
+							/* [Accessibility]: an item not found is passed over
+							   and reported, not a fatal "RegisterItem: NULL": on a
+							   tester's Mac escape1 stopped here as it started,
+							   with the same files Linux plays. The cgame says the
+							   report as the mission begins. */
+							if ( !weap ) {
+								G_Printf( S_COLOR_YELLOW "WARNING: giveweapon: no item called '%s' (%i letters), %i items known\n",
+										  token, (int)strlen( token ), bg_numItems );
+								trap_Cvar_Set( "eta_problem", va( "a character is given %s, %i letters, which the game cannot find among its %i items",
+																   token, (int)strlen( token ), bg_numItems ) );
+							} else {
+								RegisterItem( weap );
+							}
+#else
 //							if(weap)
 							RegisterItem( weap );   // don't be nice, just do it.  if it can't find it, you'll bomb out to the error menu
+#endif
 						}
 //----(SA)	end
 					}
