@@ -67,8 +67,35 @@ typedef struct
 	int             noWayAt;
 	int             goneAt;      /* dropped by someone: the game takes it away then; 0 never */
 	qboolean        ride;        /* the tram, standing near: on the list wherever the player is */
+	qboolean        known;       /* come across: been near it, in sight */
 } eta_thing_t;
 
+/*
+ * T lists only what the player has come across: within 15 meters and in
+ * sight, once. The tester: things T knew from the map, all over the level,
+ * spoiled the story and sent them where they could not go - "what you can
+ * see when you are around it is closer to investigating".
+ */
+#define ETA_THINGS_KNOWN_RANGE 600.0f
+
+static qboolean ETA_ThingInSight(const eta_thing_t *thing)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              eye, at;
+	trace_t             trace;
+
+	if (Distance(ps->origin, thing->point) > ETA_THINGS_KNOWN_RANGE)
+	{
+		return qfalse;
+	}
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+	VectorCopy(thing->point, at);
+	at[2] += 8.0f;
+	CG_Trace(&trace, eye, NULL, NULL, at, ps->clientNum, MASK_SOLID);
+	return (qboolean)( trace.fraction >= 0.99f || Distance(trace.endpos, at) < 40.0f );
+}
