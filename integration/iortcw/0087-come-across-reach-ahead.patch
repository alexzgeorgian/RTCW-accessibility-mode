+/*
+ * Something to use within reach, in front: F uses it, whatever T has
+ * chosen further off. The tester, the tram chosen on T's list, pressed F
+ * at the tram's button and was led to the tram instead: the button could
+ * not be pressed at all.
+ */
+static qboolean ETA_UseReachAhead(void)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	int            count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS), j;
+
+	for (j = 0; j < count; j++)
+	{
+		vec3_t to;
+
+		if (list[j].ladder || list[j].stairs || list[j].ride || list[j].enemy
+		    || list[j].meters > ETA_F_CLOSE_METERS - 0.5f)
+		{
+			continue;
+		}
+		VectorSubtract(list[j].point, cg.predictedPlayerState.origin, to);
+		if (fabsf(AngleSubtract(vectoyaw(to), cg.predictedPlayerState.viewangles[YAW])) < 50.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
