diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
index c857500c..cec2e29f 100644
--- a/SP/code/cgame/cg_accessibility_route.c
+++ b/SP/code/cgame/cg_accessibility_route.c
@@ -519,6 +519,54 @@ void CG_AccessibilityRouteAvoid(const float (*points)[3], int count)
 static float eta_routeBlocked[ETA_ROUTE_BLOCK_MAX][4];   /* x, y, z, radius */
 static int   eta_routeBlockedCount, eta_routeBlockedNext;
 
+/* Behind each tall ladder: under the forest's watchtower, behind its
+   ladder, the way went between the tower's legs, through its cross
+   braces, and the tester - led there again and again by F, to go round
+   to the ladder's front - was held under the tower. The way keeps out
+   of the space behind a ladder four metres or more high, as of a spot
+   it was blocked at. Worked out once a level. */
+#define ETA_LADDER_BACK_MAX 16
+
+static float eta_ladderBack[ETA_LADDER_BACK_MAX][4];
+static int   eta_ladderBackCount = -1, eta_ladderBackLevel;
+
+static void ETA_LadderBacks(void)
+{
+	int l;
+
+	if (eta_ladderBackCount >= 0 && eta_ladderBackLevel == cgs.levelStartTime)
+	{
+		return;
+	}
+	eta_ladderBackLevel = cgs.levelStartTime;
+	eta_ladderBackCount = 0;
+	for (l = 0; l < CG_AccessibilityLadderCount() && eta_ladderBackCount < ETA_LADDER_BACK_MAX; l++)
+	{
+		vec3_t foot, top, lmins, lmaxs;
+		int    thin;
+		float  normal, face;
+
+		if (!CG_AccessibilityLadderEnds(l, foot, top) || top[2] - foot[2] < 4.0f / ETA_QU_TO_METERS
+		    || !CG_AccessibilityMapLadder(l, lmins, lmaxs))
+		{
+			continue;
+		}
+		thin   = ( lmaxs[0] - lmins[0] ) < ( lmaxs[1] - lmins[1] ) ? 0 : 1;
+		normal = foot[thin] > ( lmins[thin] + lmaxs[thin] ) * 0.5f ? 1.0f : -1.0f;
+		face   = normal > 0.0f ? lmaxs[thin] : lmins[thin];
+		eta_ladderBack[eta_ladderBackCount][thin ^ 1] = ( lmins[thin ^ 1] + lmaxs[thin ^ 1] ) * 0.5f;
+		eta_ladderBack[eta_ladderBackCount][thin]     = face - normal * 90.0f;
+		eta_ladderBack[eta_ladderBackCount][2]        = foot[2];
+		eta_ladderBack[eta_ladderBackCount][3]        = 80.0f;
+		eta_ladderBackCount++;
+	}
+	/* None read yet: tried again. */
+	if (!eta_ladderBackCount)
+	{
+		eta_ladderBackCount = -1;
+	}
+}
+
 /* Whether a walk from one point to another goes over a blocked spot - a
    walk that only takes the player further from one they are already at
    is let through, the way out of it. */
