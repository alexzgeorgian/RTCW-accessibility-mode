 static void ETA_AreaLike(int area, char *out, size_t size);
 
+/*
+ * An area's name, as said in place of its number: what kind of place it
+ * is, and what marks it - "the corridor by the middle tram station", "the
+ * room with a ladder up", "the hall with the way out". The tester asked
+ * for real places rather than numbers; the levels name none, so each is
+ * named by what is in it and where it is. Two of the same name keep their
+ * number to tell them apart: "the room with a switch, 4".
+ */
+static void ETA_AreaNameBase(int area, char *out, size_t size)
+{
+	vec3_t      at, mins, maxs, wayOut, foot, top, feature, lead;
+	ETA_Place   place;
+	char        mark[80], station[64];
+	const char *kind;
+	int         i, k;
+	qboolean    tried;
+
+	out[0] = '\0';
+	if (area < 0 || area >= ETA_AREAS_MAX || !ETA_BspAreas_Bounds(area, mins, maxs))
+	{
+		return;
+	}
+	if (eta_areas.hasSpot[area])
+	{
+		VectorCopy(eta_areas.spot[area], at);
+	}
+	else
+	{
+		vec3_t mid;
+
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		if (!ETA_BspAreas_PointIn(area, mid, at))
+		{
+			VectorCopy(mid, at);
+		}
+	}
+
+	/* What kind of place. */
+	CG_AccessibilityPlace(at, &place);
+	kind = ETA_Place_KindName(place.kind);
+	if (!kind || !Q_stricmp(kind, "indoors") || !Q_stricmp(kind, "upper floor"))
+	{
+		kind = "room";
+	}
+	if (!Q_stricmp(kind, "room") && ETA_BspAreas_Floor(area) / ( 39.37f * 39.37f ) < 25.0f)
+	{
+		kind = "small room";
+	}
+
+	/* What marks it, the first of these there is. */
+	mark[0] = '\0';
+	CG_AccessibilityTramStationText(at, station, sizeof(station));
+	if (station[0])
+	{
+		Q_strncpyz(mark, station + 2, sizeof(mark));   /* past ", " */
+	}
+	if (!mark[0] && CG_AccessibilityExitPoint(cg.predictedPlayerState.origin, wayOut) && ETA_AreaOf(wayOut) == area)
+	{
+		Q_strncpyz(mark, "with the way out", sizeof(mark));
+	}
+	for (i = 0; !mark[0] && i < CG_AccessibilityLadderCount(); i++)
+	{
+		if (!CG_AccessibilityLadderEnds(i, foot, top))
+		{
+			continue;
+		}
+		for (k = 0; k < 2 && !mark[0]; k++)
+		{
+			if (ETA_AreaOf(k ? top : foot) == area)
+			{
+				Q_strncpyz(mark, k ? "with a ladder down" : "with a ladder up", sizeof(mark));
+			}
+		}
+	}
+	for (i = 0; !mark[0] && CG_AccessibilityFrontierGet(i, feature, lead, &k, &tried); i++)
+	{
+		if (( k == 6 || k == 7 ) && ETA_AreaOf(feature) == area)
+		{
+			Q_strncpyz(mark, k == 6 ? "with stairs up" : "with stairs down", sizeof(mark));
+		}
+	}
+	if (!mark[0])
+	{
+		int toNew, doors = ETA_AreaDoorsOut(area, &toNew);
+
+		if (doors >= 2)
+		{
+			Com_sprintf(mark, sizeof(mark), "with %d ways out", doors);
+		}
+	}
+	Com_sprintf(out, size, "the %s%s%s", kind, mark[0] ? " " : "", mark);
+}
+
+static void ETA_AreaName(int area, char *out, size_t size)
+{
+	char other[128];
+	int  i;
+
+	ETA_AreaNameBase(area, out, size);
+	if (!out[0])
+	{
+		Com_sprintf(out, size, "area %d", area >= 0 && area < ETA_AREAS_MAX ? eta_areas.number[area] : 0);
+		return;
+	}
+	for (i = 0; i < eta_areas.count && i < ETA_AREAS_MAX; i++)
+	{
+		if (i == area || !eta_areas.number[i])
+		{
+			continue;
+		}
+		ETA_AreaNameBase(i, other, sizeof(other));
+		if (!Q_stricmp(other, out))
+		{
+			Q_strcat(out, size, va(", %d", eta_areas.number[area]));
+			return;
+		}
+	}
+}
+
+/* The same, with a capital: "The corridor ...". */
+static const char *ETA_AreaNameCap(int area)
+{
+	static char name[128];
+
+	ETA_AreaName(area, name, sizeof(name));
+	name[0] = (char)toupper((unsigned char)name[0]);
+	return name;
+}
