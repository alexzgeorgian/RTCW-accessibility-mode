+/*
+ * Items lying side by side are each their own: two packs of ammunition a
+ * hand apart, or a weapon by its clips, were taken for one thing within
+ * half a meter, and the tester found packs T did not have. An item is
+ * the same as another only by its entity, or, for one the map put in and
+ * not yet seen, by its name and where it is.
+ */
+static qboolean ETA_ThingIsItem(int kind)
+{
+	return (qboolean)( kind == ETA_THING_ITEM || kind == ETA_THING_TREASURE );
+}
+
+/* The names up to their first comma: "9mm, inside something to break"
+   is the 9mm K lists once it is out. */
+static qboolean ETA_ThingSameName(const char *a, const char *b)
+{
+	while (*a && *a != ',' && *b && *b != ',')
+	{
+		if (tolower(*(const unsigned char *)a) != tolower(*(const unsigned char *)b))
+		{
+			return qfalse;
+		}
+		a++;
+		b++;
+	}
+	return (qboolean)( ( !*a || *a == ',' ) && ( !*b || *b == ',' ) );
+}
