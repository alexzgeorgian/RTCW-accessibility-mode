diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
index 596584fb..a3c56905 100644
--- a/SP/code/cgame/cg_accessibility_route.c
+++ b/SP/code/cgame/cg_accessibility_route.c
@@ -1043,6 +1043,37 @@ static int ETA_RouteLeap(void *context, const float from[3], float to[3])
 
 	(void)context;
 
+	/* Only across a gap: somewhere between, the floor drops away - no
+	   floor within a step or two below the edge. Tried wherever the next
+	   square was not walkable, it jumped over a candle post, a door's
+	   sill, under the last door of the first catacomb level - the tester
+	   did not know whether all those jumps were needed. Nor through a
+	   door locked shut. */
+	{
+		int   k, n = (int)( sqrtf(( to[0] - from[0] ) * ( to[0] - from[0] ) + ( to[1] - from[1] ) * ( to[1] - from[1] ))
+		                    / 16.0f );
+		qboolean gap = qfalse;
+
+		for (k = 1; k < n && !gap; k++)
+		{
+			float  f = (float)k / (float)n;
+			vec3_t top, bottom;
+
+			VectorSet(top, from[0] + ( to[0] - from[0] ) * f, from[1] + ( to[1] - from[1] ) * f, from[2]);
+			VectorCopy(top, bottom);
+			bottom[2] = from[2] - 24.0f - 40.0f;
+			trap_CM_BoxTrace(&trace, top, bottom, NULL, NULL, 0, MASK_PLAYERSOLID);
+			if (!trace.startsolid && trace.fraction >= 1.0f)
+			{
+				gap = qtrue;
+			}
+		}
+		if (!gap || ETA_RouteThroughLocked(from, to))
+		{
+			return ETA_PATH_NONE;
+		}
+	}
+
 	/* Up as a jump goes, and across at that height. */
 	VectorCopy(from, start);
 	VectorCopy(from, end);
