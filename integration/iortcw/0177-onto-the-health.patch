diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
index 61dc89a8..779b67b8 100644
--- a/SP/code/cgame/cg_accessibility_route.c
+++ b/SP/code/cgame/cg_accessibility_route.c
@@ -47,6 +47,7 @@ typedef struct
 	int column, row, layer;
 	char name[48];     /* the square's name, "C,3", or the objective's */
 	int intoArea;      /* reached on coming into this area, from 1, or 0 */
+	qboolean walkOnto; /* a thing taken by walking onto it: reached on it, not three metres short */
 } eta_marker_t;
 
 static eta_marker_t eta_marker;
@@ -59,6 +60,7 @@ static eta_marker_t eta_marker;
  * reached by walking into it, which the grid decides rather than this.
  */
 #define ETA_MARKER_ARRIVE_METERS 3.0f
+#define ETA_MARKER_ONTO_UNITS    32.0f   /* a thing walked onto: this close, the player touches it, and takes it */
 #define ETA_MARKER_ARRIVE_RISE   56.0f   /* above or below by more than a jump: not there yet */
 
 /**
@@ -1388,7 +1390,8 @@ static void ETA_RoutePlanWith(qboolean jumps)
 
 	ETA_PathFinder_Begin(start, goal, ETA_ROUTE_CELL,
 	                     eta_marker.square ? ETA_MarkerSquareRadius()
-	                                       : ETA_MARKER_ARRIVE_METERS / ETA_QU_TO_METERS,
+	                     : eta_marker.walkOnto ? ETA_MARKER_ONTO_UNITS
+	                                           : ETA_MARKER_ARRIVE_METERS / ETA_QU_TO_METERS,
 	                     eta_marker.square);
 
 	eta_route.planned   = qtrue;
@@ -2659,6 +2662,14 @@ void CG_AccessibilityMarkerFrame(void)
 	else
 	{
 		arrived = (qboolean)(eta_marker.leftIt && distance <= ETA_MARKER_ARRIVE_METERS);
+		if (eta_marker.walkOnto)
+		{
+			vec3_t flat;
+
+			VectorSubtract(eta_marker.origin, cg.predictedPlayerState.origin, flat);
+			flat[2] = 0.0f;
+			arrived = (qboolean)( VectorLength(flat) <= ETA_MARKER_ONTO_UNITS );
+		}
 		/* A way into an area: reached once in it, or right on the spot
 		   just through its doorway. */
 		if (eta_marker.intoArea)
@@ -2804,6 +2815,17 @@ void CG_AccessibilityMarkerSet(const vec3_t origin, const char *name)
 	eta_progress.at = 0;
 }
 
+/* The marker just put down is a thing taken by walking onto it - health,
+   ammo, a weapon, treasure: reached standing on it. In the church the
+   tester was led to a large health pack by a crate and told "Marker
+   reached" three metres short of it, with the crate's corner between;
+   they walked into the crate, and never took it. */
+void CG_AccessibilityMarkerWalkOnto(qboolean walkOnto)
+{
+	eta_marker.walkOnto = walkOnto;
+	ETA_RouteForget();
+}
+
 /* The marker just put down is a way into an area: reached on coming
    into it, not three metres short. */
 void CG_AccessibilityMarkerIntoArea(int area)
