+/* Whether an enemy has seen the player, from the state the game sends
+   with each (entityState_t aiState). */
+static const char *ETA_EnemyAware(int entityNum)
+{
+	if (entityNum < 0 || entityNum >= MAX_GENTITIES)
+	{
+		return "";
+	}
+	switch (cg_entities[entityNum].currentState.aiState)
+	{
+	case AISTATE_RELAXED:
+		return "Has not seen you";
+	case AISTATE_QUERY:
+		return "Heard something, looking round";
+	case AISTATE_ALERT:
+		return "Alert, searching";
+	default:
+		return "Has seen you";
+	}
+}
