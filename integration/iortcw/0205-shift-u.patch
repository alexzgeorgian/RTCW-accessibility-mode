+/*
+ * Shift+U. While a boss is alive - Olaric, Heinrich - the lock on the
+ * boss, past the nearer zombies U takes; out of sight, turned toward
+ * them. With no boss, a step through the enemies in sight, each said
+ * with whether they have seen the player, for U to lock on to. The
+ * tester, in the tomb, could lock only on the nearest; and in the forest
+ * must keep checking which enemies can see them.
+ */
+static void ETA_EnemyShiftU(void)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	vec3_t         boss;
+	int            bossChar, count, i;
+
+	if (!CG_AccessibilityBossAlive(boss, &bossChar))
+	{
+		ETA_EnemyChooseStep(1);
+		return;
+	}
+
+	count = CG_AccessibilityEnemyTargets(list, ETA_AIM_MAX_TARGETS, qtrue);
+	for (i = 0; i < count; i++)
+	{
+		int ent = list[i].entityNum;
+
+		if (ent >= 0 && ent < MAX_GENTITIES && cg_entities[ent].currentState.aiChar == bossChar)
+		{
+			eta_enemyChoose.held      = qtrue;
+			eta_enemyChoose.entityNum = ent;
+			eta_enemyChoose.at        = cg.time;
+			ETA_AimStop();
+			CG_AccessibilityAimLockDown_f();
+			if (eta_aim.mode == ETA_AIM_LOCK)
+			{
+				eta_aim.automatic = qfalse;
+				eta_aim.toggled   = qtrue;
+			}
+			return;
+		}
+	}
+
+	/* Out of sight: turned toward them, faced as they come into sight. */
+	{
+		etaAimTarget_t aim;
+		const char    *who = CG_AccessibilityAiCharName(bossChar);
+		int            meters = (int)(Distance(boss, cg.predictedPlayerState.origin) * ETA_QU_TO_METERS + 0.5f);
+
+		memset(&aim, 0, sizeof(aim));
+		aim.entityNum = -1;
+		VectorCopy(boss, aim.point);
+		aim.point[2] += 20.0f;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(va("%s out of sight, %d meters, %s. Turned toward him. O leads there", who, meters,
+		                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(boss))));
+		ETA_AimStartSnap(&aim, NULL);
+	}
+}
