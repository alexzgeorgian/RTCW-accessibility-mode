+/*
+ * The floor under the player moving: the crypt's, once its two bosses
+ * are dead, tilts, cracks and falls into the room below, the way out.
+ * Nothing said it; the tester would have been dropped without a word.
+ */
+static void ETA_FloorFrame(void)
+{
+	static int saidFor = -1, saidKind, lastStart;
+	const playerState_t *ps = &cg.predictedPlayerState;
+	const entityState_t *es;
+	qboolean             opens;
+	int                  kind, t;
+
+	if (lastStart != cgs.levelStartTime)
+	{
+		lastStart = cgs.levelStartTime;
+		saidFor   = -1;
+		saidKind  = 0;
+	}
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode || ps->groundEntityNum <= 0
+	    || ps->groundEntityNum >= ENTITYNUM_WORLD)
+	{
+		return;
+	}
+	es = &cg_entities[ps->groundEntityNum].currentState;
+	if (es->eType != ET_MOVER || es->modelindex <= 0 || es->modelindex >= MAX_MODELS
+	    || CG_AccessibilityDoorModel(es->modelindex, &opens))
+	{
+		return;
+	}
+	for (t = 0; t < eta_liftCount; t++)
+	{
+		if (eta_lifts[t].mover == es->modelindex || eta_lifts[t].bridge == es->modelindex)
+		{
+			return;   /* carried: said as a lift */
+		}
+	}
+	kind = es->pos.trType != TR_STATIONARY && cg.time < es->pos.trTime + es->pos.trDuration && es->pos.trDelta[2] < -1.0f ? 2
+	       : es->apos.trType != TR_STATIONARY && cg.time < es->apos.trTime + es->apos.trDuration ? 1 : 0;
+	if (kind && ( saidFor != es->number || kind > saidKind ))
+	{
+		saidFor  = es->number;
+		saidKind = kind;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(kind == 2 ? "The floor is falling, and you with it" : "The floor under you is cracking and tilting: it is giving way");
+	}
+}
