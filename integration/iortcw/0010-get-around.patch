+sfxHandle_t CG_AccessibilityLoopSound( eta_loopSoundType_t which ) {
+	if ( (int)which < 0 || (int)which >= (int)ARRAY_LEN( etaLoopSounds ) ) {
+		return 0;
+	}
+	return etaLoopSounds[which];
+}
+
+static int ETA_VolumePercent( const vmCvar_t *cvar ) {
+	return cvar->integer <= 0 ? 0 : cvar->integer >= 100 ? 100 : cvar->integer;
+}
+
+/* The loop's volume, 0 to 255, from its kind's setting. */
+int CG_AccessibilityLoopVolume( eta_loopSoundType_t which ) {
+	const vmCvar_t *cvar;
+
+	switch ( which ) {
+	case ETA_LOOP_DOOR:
+	case ETA_LOOP_DOOR_LOCKED:
+		cvar = &eta_doorVolume;
+		break;
+	case ETA_LOOP_CROSSHAIR_ENEMY:
+	case ETA_LOOP_CROSSHAIR_TEAMMATE:
