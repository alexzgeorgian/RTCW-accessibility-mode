+/**
+ * @brief How long a hint has to stay up before it is worth saying.
+ *
+ * The cue below fires the instant an icon appears, and should: that is
+ * the sighted player's flicker of movement at the edge of the eye. The
+ * words are different. Turning through a supply room puts four or five
+ * hints under the crosshair in under a second, and naming every one of
+ * them is a voice that cannot be listened to. So the sound says "there
+ * is something here" at once and the words follow for whatever the
+ * player is still looking at a quarter of a second later.
+ */
+#define ETA_HINT_SETTLE_MS 250
+
+/**
+ * @brief Says how a construction is coming along, and when it is done.
+ *
+ * The tester finished a construction and said afterwards that they had
+ * known to keep holding the key only because they remembered the bar
+ * filling on screen. The bar was already arriving - the game sends a
+ * constructible's progress as the value beside the cursor icon, which
+ * is the same number the HUD draws - and nothing said it out loud once
+ * the work had started.
+ *
+ * Milestones rather than a running count, for the reason the objective
+ * distance uses them: a number that changes every frame is a voice that
+ * never stops.
+ *
+ * The completion callout was missing from the first attempt at this, on
+ * the reasoning that there was no honest signal for it - and that was
+ * simply wrong. G_ConstructiblePlayerBuild does set the progress back to
+ * zero in the same frame it crosses 250, so a dropped value really is
+ * indistinguishable from a player letting go, and this still refuses to
+ * read anything into that. But it also stamps lastTaskAchievedTime, and
+ * G_CheckForCursorHints then sends HINT_COMPLETED with a value of 255
+ * for the next three quarters of a second. That is what fills the bar to
+ * the top on a sighted player's screen. It is an explicit event from the
+ * engine, addressed to the one player who did the work, and the second
+ * report - "it stops at 75 instead of reaching 100" - was describing
+ * exactly the announcement that event should have produced.
+ *
+ * HINT_COMPLETED covers any finished task, not only building, which is
+ * why it is only spoken when this was already tracking a climb. The
+ * interaction report still ignores it: it holds the previous icon rather
+ * than naming a new thing to interact with, which is a different
+ * question from whether the work finished.
+ */
+/**
+ * @brief How far from the player a construction they are working on can be.
+ *
+ * The trigger a player stands in to build is often wider than the thing
+ * being built, and the construction is a brush whose middle can be some
+ * way off. Sixteen metres covers the ones on the stock maps and is too
+ * short to reach across to another objective.
+ */
+#define ETA_BUILD_SEARCH_RANGE 640.0f
+
+/**
+ * @brief What the game's plainest use icon is on, in words - or "".
+ *
+ * The icon says only that something can be used, and so did the words
+ * for it: the tester, in a tank, heard "Usable" and was left to guess.
+ * The thing under the crosshair is named the way F names things: what
+ * the line of sight hits, or failing that - the use is often a trigger
+ * the client cannot see, wrapped round the thing - the nameable thing
+ * nearest where the line ends, a little way ahead.
+ */
+#define ETA_USABLE_LOOK   160.0f
+#define ETA_USABLE_NEAR   128.0f
+
+
+
+/*
+=====================================================================
+The map's doors and flags, read from its entity list
+=====================================================================
+*/
+
+
+
+
+/**
+ * @brief The map's doors, by their brush models.
+ *
+ * In the campaign the server stamps no door on its entity - the cursor
+ * hint is worked out only for what the player looks at - so which brush
+ * models are doors comes from the map's own entity list, which the
+ * cgame can read. A door's modelindex is the number after the '*' in
+ * its "model" key, the same way the server assigns it.
+ *
+ * -1 not a door; 0 a door; 1 a door set locked in the map ("key" -1).
+ * A door a script unlocks later is not known to be locked: the crosshair
+ * says "Locked door" when it is looked at.
+ */
+static signed char eta_doorLocked[MAX_MODELS];
+
+/* The level's way out: the player's own ai_trigger aimed at "endmap",
+   by its brush model. A map may have more than one. */
+#define ETA_MAX_EXITS 4
+static int eta_exitModels[ETA_MAX_EXITS];
+static int eta_exitCount;
+
+/* A rotating door's "origin" key: its brush model is laid out round
+   that point, so its midpoint alone is not where it stands. */
+static vec3_t eta_doorOrigins[MAX_MODELS];
+
+static void ETA_ReadMapEntities(void)
+{
+	char token[MAX_TOKEN_CHARS];
+	char key[MAX_TOKEN_CHARS];
+	char classname[64], model[16], lock[16], origin[64], target[64], ainame[64];
+	int  i;
+
+	for (i = 0; i < MAX_MODELS; i++)
+	{
+		eta_doorLocked[i] = -1;
+		VectorClear(eta_doorOrigins[i]);
+	}
+	eta_exitCount = 0;
+
+	for (;;)
+	{
+		if (!trap_GetEntityToken(token, sizeof(token)) || token[0] != '{')
+		{
+			break;
+		}
+
+		classname[0] = model[0] = lock[0] = origin[0] = target[0] = ainame[0] = '\0';
+		for (;;)
+		{
+			if (!trap_GetEntityToken(key, sizeof(key)) || key[0] == '}')
+			{
+				break;
+			}
+			if (!trap_GetEntityToken(token, sizeof(token)))
+			{
+				break;
+			}
+			if (!Q_stricmp(key, "classname"))
+			{
+				Q_strncpyz(classname, token, sizeof(classname));
+			}
+			else if (!Q_stricmp(key, "model"))
+			{
+				Q_strncpyz(model, token, sizeof(model));
+			}
+			else if (!Q_stricmp(key, "key"))
+			{
+				Q_strncpyz(lock, token, sizeof(lock));
+			}
+			else if (!Q_stricmp(key, "origin"))
+			{
+				Q_strncpyz(origin, token, sizeof(origin));
+			}
+			else if (!Q_stricmp(key, "target"))
+			{
+				Q_strncpyz(target, token, sizeof(target));
+			}
+			else if (!Q_stricmp(key, "ainame"))
+			{
+				Q_strncpyz(ainame, token, sizeof(ainame));
+			}
+		}
+
+		if (!Q_stricmp(classname, "ai_trigger") && !Q_stricmp(ainame, "player")
+		    && !Q_stricmpn(target, "endmap", 6) && model[0] == '*' && eta_exitCount < ETA_MAX_EXITS)
+		{
+			int index = atoi(model + 1);
+
+			if (index > 0 && index < MAX_MODELS)
+			{
+				eta_exitModels[eta_exitCount++] = index;
+			}
+		}
+
+		if ((!Q_stricmp(classname, "func_door") || !Q_stricmp(classname, "func_door_rotating"))
+		    && model[0] == '*')
+		{
+			int index = atoi(model + 1);
+
+			if (index > 0 && index < MAX_MODELS)
+			{
+				eta_doorLocked[index] = (signed char)(lock[0] && atoi(lock) == -1);
+				if (origin[0])
+				{
+					sscanf(origin, "%f %f %f", &eta_doorOrigins[index][0],
+					       &eta_doorOrigins[index][1], &eta_doorOrigins[index][2]);
+				}
+			}
+		}
+	}
+}
+
+/**
+ * @brief Whether a brush model is a door, and whether it opens.
+ */
+qboolean CG_AccessibilityDoorModel(int modelindex, qboolean *opens)
+{
+	if (modelindex <= 0 || modelindex >= MAX_MODELS || eta_doorLocked[modelindex] < 0)
+	{
+		return qfalse;
+	}
+
+	*opens = (qboolean)!eta_doorLocked[modelindex];
+	return qtrue;
+}
+
+/**
+ * @brief Speaks what the player just picked up.
+ *
+ * A sighted player reads this off the popup feed. Without it, walking
+ * over something gives a sound and nothing else - the tester knew what
+ * they had found only because they still remembered the stock sound
+ * effects, which is not something a new player has.
+ *
+ * The spoken line is built from the engine's own popup text, character
+ * for character, rather than from a table of our own: the two cannot
+ * then drift apart, and it inherits the engine's translations for free.
+ *
+ * Where the pickup changes a number the player tracks, the new total
+ * follows - health for a health pack, loaded and reserve rounds for an
+ * ammo pack. Deliberately the resulting total rather than the amount
+ * gained: how much a pack gives depends on the receiver's class and
+ * skill and is decided on the server, whereas what the player actually
+ * needs to know is whether they are resupplied. It is also the same
+ * number, from the same helper, that the health and ammo keys report, so
+ * there is no second vocabulary to disagree with the first.
+ *
+ * Weapons and objectives get the name alone. A weapon announces its own
+ * ammo when it reaches the player's hands, and "an Objective" is the
+ * whole of what matters about carrying one.
+ *
+ * @param[in] itemNum
+ * @param[in] item
+ */
+
+
+
+/**
+ * @brief What to call each of the engine's footstep types out loud.
+ *
+ * Indexed by the footstep type itself, so the word and the sound cannot
+ * drift apart: these are the same values BG_FootstepForSurface derives
+ * from the surface flags and the same ones cgs.media.footsteps is indexed
+ * by, which is why FOOTSTEP_NORMAL is "Stone" - the engine loads
+ * stone1.wav through stone4.wav for it.
+ *
+ * FOOTSTEP_TOTAL is not in here and never reaches this: it is the
+ * engine's marker for a surface that makes no footstep sound at all, and
+ * a surface a sighted player cannot hear is not one to announce.
+ */
+static const char *const eta_footstepNames[FOOTSTEP_TOTAL] =
+{
+	"Stone",   // FOOTSTEP_NORMAL
+	"Metal",   // FOOTSTEP_METAL
+	"Wood",    // FOOTSTEP_WOOD
+	"Grass",   // FOOTSTEP_GRASS
+	"Gravel",  // FOOTSTEP_GRAVEL
+	"Water",   // FOOTSTEP_SPLASH
+	"Roof",    // FOOTSTEP_ROOF
+	"Snow",    // FOOTSTEP_SNOW
+	"Carpet"   // FOOTSTEP_CARPET
+};
+
+/**
+ * @brief Says what the player is walking on, when it changes.
+ *
+ * A sighted player reads the ground continuously and for free. Without
+ * binoculars or a scoped weapon - which is most classes, most of the time
+ * - the mod had nothing at all to say about the surroundings, and the
+ * ground is the part of them that is always underfoot.
+ *
+ * Driven by the footstep event rather than by a trace of our own, so the
+ * word spoken is the surface the engine just played a footstep sound for.
+ * They cannot disagree, and a map that fools one fools both the same way.
+ *
+ * Only on a change: the ground is news when it becomes different ground.
+ *
+ * @param[in] footstep the engine's footstep type for this step
+ */
+static void ETA_NarrateFooting(int footstep)
+{
+	static int spoken = -1;
+
+	if (!eta_environmentCallouts.integer)
+	{
+		spoken = -1;
+		return;
+	}
+
+	if (footstep < 0 || footstep >= FOOTSTEP_TOTAL)
+	{
+		return;
+	}
+
+	if (footstep == spoken)
+	{
+		return;
+	}
+
+	spoken = footstep;
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakFooting(eta_footstepNames[footstep]);
+	ETA_Speech_EndReport();
+}
+
+
+/**
+ * @brief Feeds real per-frame movement into the accessibility navigation
+ * system's stuck detection (ETA_NavigationSystem_UpdateMovement), which
+ * narrates "You may be stuck" on its own once the player has been
+ * effectively stationary for its own internal threshold.
+ *
+ * Only runs while the player is actually playing and able to move under
+ * their own control - ps->pm_type == PM_NORMAL excludes dead, noclip, and
+ * intermission/freeze states, matching the same "on a playing team" gate
+ * ETA_NarrateObjectiveChange above already uses. Outside that gate
+ * (spectating, dead, between rounds), stuck detection is reset rather than
+ * fed zero movement, so time spent not playing can never itself count as
+ * "stuck", and so a genuine respawn-driven reset (CG_Respawn, below) isn't
+ * immediately re-armed by a stale timer from before death.
+ * @param[in] ps
+ * @param[in] ops
+ */
+static void ETA_NarrateStuckDetection(playerState_t *ps, playerState_t *ops)
+{
+	usercmd_t cmd;
+	int       trying;
+
+	if (ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		ETA_NavigationSystem_ResetStuckDetection();
+		return;
+	}
+
+	/* The player's own movement input. Without it this reported anyone who
+	   stood still for three seconds, which in a firefight is most people
+	   most of the time - hence the announcements that arrived for no
+	   reason. Leaning and jumping are left out: neither is an attempt to
+	   get anywhere, and a player pressed against a wall jumping to break
+	   free is exactly who should still be told. */
+	if (!trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd))
+	{
+		ETA_NavigationSystem_ResetStuckDetection();
+		return;
+	}
+
+	trying = (cmd.forwardmove != 0 || cmd.rightmove != 0);
+
+	if (ETA_NavigationSystem_UpdateMovement(Distance(ps->origin, ops->origin) * ETA_QU_TO_METERS,
+	                                        cg.frametime / 1000.0f, trying))
+	{
+		/* What helps here is where to go, not being told what the player
+		   already knows. Same report the objectives key gives, so a player
+		   who is wedged or lost hears the way out rather than a label for
+		   their predicament. */
+		ETA_Speech_Say("You may be stuck. F3 says what is around you");
+	}
+}
+
+/* The footstep the engine just played for the player, said as footing. */
+void CG_AccessibilityFooting(int footstep)
+{
+	ETA_NarrateFooting(footstep);
+}
+
+/* Stuck: walking and not moving, said with the way to go. */
+void CG_AccessibilityStuckFrame(playerState_t *ps, playerState_t *ops)
+{
+	ETA_NarrateStuckDetection(ps, ops);
+}
+
+/**
+ * @brief The world around the player, every active frame, in the order
+ * the ET: Legacy mode settled on.
+ *
+ * The sounds come first: they do not compete for the one voice and are
+ * not held back by anything. Then the scenery, which stands down while
+ * an answer the player asked for is still being spoken - that is what
+ * held is - and last the warnings worth interrupting anything for.
+ */
+/**
+ * @brief Where the level's way out is: how far, which way, how far up or
+ *        down, as the crow flies - and the marker put on it, whose sound
+ *        leads the way there round the walls (cg_accessibility_route.c).
+ */
+
+static void ETA_WorldRead(void);
+
+static qboolean ETA_ExitPoint(int model, vec3_t out)
+{
+	if (model <= 0 || model >= MAX_MODELS)
+	{
+		return qfalse;
+	}
+	VectorCopy(cgs.inlineModelMidpoints[model], out);
+	return qtrue;
+}
+
+void CG_AccessibilityWayOut(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              point, delta, best;
+	float               bestDistance = 0.0f;
+	char                height[64];
+	int                 i, model = 0, meters;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+	ETA_WorldRead();
+
+	/* Pressed again on the way: which way to turn, and how far. */
+	if (CG_AccessibilityMarkerActive())
+	{
+		CG_AccessibilityMarkerWhere();
+		return;
+	}
+
+	for (i = 0; i < eta_exitCount; i++)
+	{
+		if (ETA_ExitPoint(eta_exitModels[i], point)
+		    && (!model || Distance(ps->origin, point) < bestDistance))
+		{
+			model        = eta_exitModels[i];
+			bestDistance = Distance(ps->origin, point);
+			VectorCopy(point, best);
+		}
+	}
+
+	if (!model)
+	{
+		ETA_Speech_Say("This map has no way out of its own: it ends by what happens in it");
+		return;
+	}
+
+	VectorSubtract(best, ps->origin, delta);
+	meters = (int)(bestDistance * ETA_QU_TO_METERS + 0.5f);
+	ETA_HudNarrator_HeightText(delta[2] * ETA_QU_TO_METERS, height, sizeof(height));
+	ETA_Speech_Say(va("Way out, %d meters, %s, %s%s%s. Follow the marker's sound", meters,
+	                  ETA_HudNarrator_RelativeDirection(AngleNormalize180(vectoyaw(delta) - ps->viewangles[YAW])),
+	                  ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(vectoyaw(delta))),
+	                  height[0] ? ", " : "", height));
+
+	/* The marker goes on it, and its sound leads the way round the walls. */
+	CG_AccessibilityMarkerSet(best, "the way out");
+}
+
+
+/**
+ * @brief Reads what the map file holds about the map: its doors, its
+ *        ladders and the things in its rooms. Once a map, on its first
+ *        frame, when the map and its entity list are loaded.
+ */
+static qboolean eta_worldRead;
+
+void CG_AccessibilityWorldInit(void)
+{
+	eta_worldRead = qfalse;
+	CG_AccessibilityMarkerReset();
+}
+
+static void ETA_WorldRead(void)
+{
+	if (eta_worldRead)
+	{
+		return;
+	}
+	eta_worldRead = qtrue;
+	ETA_ReadMapEntities();
+	CG_AccessibilityLoadLadders();
+	CG_AccessibilityLoadProps();
+
+	{
+		int i, doors = 0;
+
+		for (i = 0; i < MAX_MODELS; i++)
+		{
+			doors += eta_doorLocked[i] >= 0;
+		}
+		CG_Printf("eta: %s has %d doors, %d ladders and %d things in its rooms\n",
+		          cgs.mapname, doors, eta_mapLadderCount, eta_mapPropCount);
+	}
+}
+
+void CG_AccessibilityWorldFrame(qboolean held)
+{
+	ETA_WorldRead();
+
+	ETA_BeaconDoors();
+	ETA_BeaconLadders();
+	CG_AccessibilityMarkerFrame();
+	ETA_BeaconPickups();
+	ETA_BeaconBump();
+
+	ETA_NarrateCrosshair();
+
+	if (!held)
+	{
+		ETA_NarrateObstacleAhead();
+		ETA_NarrateStairsAhead();
+		ETA_NarrateFurniture();
+		ETA_NarrateLadder();
+		CG_AccessibilityMarkerApproach();
+		ETA_NarrateFacing();
+		ETA_NarrateLookAround();
+		/* Most urgent last: a backend that cuts off the line in progress
+		   leaves the hazard spoken rather than the heading. */
+		ETA_NarrateWater();
+		ETA_NarratePlace();
+		ETA_NarrateOpenings();
+	}
+
+	/* Who and what is near. It keeps time while held, and is quiet. */
+	ETA_NarrateAwareness(held);
+
+	/* A drop ahead is worth interrupting an answer for. */
+	ETA_NarrateDropAhead();
+}
+
+/* A body's half-width, as the route probe measures. */
+#define ETA_ROUTE_HALF_WIDTH 16.0f
+
+/**
+ * @brief What kind of place a point is: street, alley, square, building,
+ * balcony or roof (navigation/place_classifier.c reads the measurements).
+ *
+ * Measured the way the route's probe measures, against the map's own
+ * walls and floors: from where the player stands, in each of the eight
+ * compass directions, how far the floor runs at about the same height
+ * before a wall stops a body or the floor drops away; whether the sky is
+ * straight overhead; and whether there is a storey's worth of space under
+ * the floor. A street is a long run between near walls; a balcony a
+ * narrow run in the open with a drop or rooms under it.
+ */
+#define ETA_PLACE_STEP      48.0f    /* between looks along each direction */
+#define ETA_PLACE_LOOK      800.0f   /* how far each direction is followed, 20 m */
+#define ETA_PLACE_SKY       2048.0f  /* how far up to look for the sky */
+#define ETA_PLACE_LEVEL     40.0f    /* a floor this much higher or lower is another level */
+#define ETA_PLACE_DROP_NEAR 112.0f   /* a drop this close is beside the player */
+#define ETA_PLACE_STOREY    96.0f    /* a room under the floor at least this deep */
+
+static void ETA_PlaceProbeAt(const vec3_t origin, ETA_PlaceProbe *probe)
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	trace_t trace;
+	vec3_t  start, end;
+	float   feet = origin[2] - 24.0f;
+	int     d;
+
+	memset(probe, 0, sizeof(*probe));
+
+	/* Sky straight overhead, from eye height. */
+	VectorSet(start, origin[0], origin[1], origin[2] + 16.0f);
+	VectorSet(end, origin[0], origin[1], origin[2] + ETA_PLACE_SKY);
+	trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_SOLID);
+	probe->skyAbove = (trace.fraction >= 1.0f || (trace.surfaceFlags & SURF_SKY)) ? 1 : 0;
+
+	/* A room under the floor: air through the floor's thickness, and a
+	   floor further down a storey below this one. Below the ground there
+	   is no floor to find, only the outside of the map. */
+	{
+		float z;
+
+		for (z = feet - 8.0f; z >= feet - 72.0f; z -= 8.0f)
+		{
+			vec3_t point;
+
+			VectorSet(point, origin[0], origin[1], z);
+			if (!(CG_PointContents(point, -1) & MASK_SOLID))
+			{
+				qboolean drawn;
+
+				/* The sealed space under a map is lined with surfaces
+				   nobody sees; a room under the floor has a ceiling and a
+				   floor that are drawn. On Oasis every street sits on such
+				   a space. */
+				VectorCopy(point, start);
+				VectorSet(end, point[0], point[1], feet + 4.0f);
+				trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_SOLID);
+				drawn = (qboolean)(trace.fraction < 1.0f && !(trace.surfaceFlags & SURF_NODRAW));
+
+				VectorSet(end, point[0], point[1], point[2] - 1024.0f);
+				trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_PLAYERSOLID);
+				if (drawn && !trace.startsolid && trace.fraction < 1.0f && trace.plane.normal[2] >= 0.7f
+				    && !(trace.surfaceFlags & SURF_NODRAW) && feet - trace.endpos[2] >= ETA_PLACE_STOREY)
+				{
+					probe->airBelow = 1;
+				}
+				break;
+			}
+		}
+	}
+
+	/* Along each direction: as far as the floor runs at this level. */
+	for (d = 0; d < ETA_PLACE_DIRECTIONS; d++)
+	{
+		float  bearing = (float)d * 45.0f * (float)M_PI / 180.0f;
+		vec3_t step, here, next, down;
+		float  floor = feet, run = 0.0f;
+
+		VectorSet(step, sinf(bearing) * ETA_PLACE_STEP, cosf(bearing) * ETA_PLACE_STEP, 0.0f);
+		VectorCopy(origin, here);
+
+		while (run + ETA_PLACE_STEP <= ETA_PLACE_LOOK)
+		{
+			VectorAdd(here, step, next);
+
+			/* A body's width, a step up off the floor: what stops it is
+			   a wall. */
+			trap_CM_BoxTrace(&trace, here, next, mins, maxs, 0, MASK_PLAYERSOLID);
+			if (trace.startsolid || trace.fraction < 1.0f)
+			{
+				/* Up to the wall's face: the part of the step the body
+				   got, and the body's own half-width in front of it. */
+				probe->wall[d] = 1;
+				if (!trace.startsolid)
+				{
+					run += trace.fraction * ETA_PLACE_STEP + ETA_ROUTE_HALF_WIDTH;
+				}
+				break;
+			}
+
+			/* The floor there: at about this level, or a drop. */
+			VectorCopy(next, start);
+			start[2] += 18.0f;
+			VectorSet(down, next[0], next[1], floor - 1024.0f);
+			trap_CM_BoxTrace(&trace, start, down, NULL, NULL, 0, MASK_PLAYERSOLID);
+
+			if (trace.startsolid || trace.fraction >= 1.0f || trace.endpos[2] < floor - ETA_PLACE_LEVEL)
+			{
+				float depth = (trace.startsolid || trace.fraction >= 1.0f) ? 1024.0f : floor - trace.endpos[2];
+
+				if (run + ETA_PLACE_STEP <= ETA_PLACE_DROP_NEAR && depth > probe->dropBeside)
+				{
+					probe->dropBeside = depth;
+				}
+				break;
+			}
+
+			if (trace.endpos[2] > floor + ETA_PLACE_LEVEL)
+			{
+				/* Stairs or a ramp up out of this level. */
+				break;
+			}
+
+			floor = trace.endpos[2];
+			VectorSet(here, next[0], next[1], floor + 24.0f);
+			run += ETA_PLACE_STEP;
+		}
+
+		probe->reach[d] = run;
+	}
+}
+
+/**
+ * @brief What kind of place a point is - the probe above, read.
+ */
+void CG_AccessibilityPlace(const vec3_t origin, ETA_Place *out)
+{
+	ETA_PlaceProbe probe;
+
+	ETA_PlaceProbeAt(origin, &probe);
+	*out = ETA_Place_Classify(&probe);
+}
+
+
+#endif
