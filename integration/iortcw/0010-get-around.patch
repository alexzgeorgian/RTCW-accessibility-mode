diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
new file mode 100644
index 0000000..79d552e
--- /dev/null
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -0,0 +1,381 @@
+/*
+ * name:	cg_accessibility_keys.c
+ *
+ * desc:	[Accessibility]: the keys that act - turning a compass point
+ *			at a tap of a turn key, and what is around on a key. Ported
+ *			from the accessibility mode's ET: Legacy cgame, its
+ *			cg_consolecmds.c, by way of its No Quarter one.
+ *
+ *			Only built with FEATURE_ACCESSIBILITY.
+ */
+
+#ifdef FEATURE_ACCESSIBILITY
+
+#include "cg_local.h"
+
+#include "hud/hud_narrator.h"
+#include "speech/speech_manager.h"
+
+/**
+ * @brief Turning with the keys the way the mouse turns.
+ *
+ * A tester put it exactly: with the mouse, turning to the west says
+ * "west" at once; with the keys it took three or four taps before
+ * anything was said. That is the engine's own key speed and nothing
+ * else. A turn key moves the view at cl_yawspeed, 140 degrees a second,
+ * so a quick tap moves it about fifteen degrees - a third of a compass
+ * point - and nothing has changed that is worth a word.
+ *
+ * So a tap now finishes the turn itself: it carries on to the next of
+ * the eight compass points, quickly, stops on it, and says it. Two taps
+ * turn a quarter. Holding the key is untouched - it turns smoothly for
+ * as long as it is held and stops where it is let go, which aiming at
+ * somebody needs - and while it is held each point is named as it is
+ * crossed rather than after the view has settled there.
+ *
+ * Nothing here can write the view angles: that is the client's, and
+ * this is the cgame. What it can do is what a player can - press the
+ * engine's own +left and +right, and the walk key that makes them turn
+ * faster by cl_anglespeedkey - and let go at the right moment. They are
+ * pressed under key numbers no keyboard has, so a player's own keys on
+ * the same buttons are never released by this. cl_anglespeedkey is the
+ * one setting touched, and only while a step runs: it is not saved to
+ * the player's config, and it is put back as soon as the step ends, on
+ * a map change and on shutdown.
+ */
+#define ETA_TURN_KEY_LEFT   "998"
+#define ETA_TURN_KEY_RIGHT  "999"
+#define ETA_TURN_KEY_SPEED  "997"
+
+/* Shorter than this between press and release is a tap. A tap at 140
+   degrees a second covers about 35 degrees in this time, under a
+   compass point, so a tap can never finish past the point it meant. */
+#define ETA_TURN_TAP_MS 250
+
+/* How far past the heading a tap started from the next point must be.
+   Facing 40 degrees short of a point, a tap goes there; facing five
+   degrees short, it goes to the one after - five degrees is already
+   "there" to the ear, and a tap that said the point you were on would
+   sound like a tap that did nothing. */
+#define ETA_TURN_STEP_MARGIN 10.0f
+
+/* The step's speed: cl_yawspeed times this while the walk key is held
+   down by the step. 140 x 5 is 700 degrees a second, so a compass point
+   takes about 65 ms - the length of a flick of the mouse. */
+#define ETA_TURN_FAST_SCALE "5"
+#define ETA_TURN_FAST_FACTOR 5.0f
+
+/* The last few degrees go at the ordinary speed, so the view stops on the
+   point rather than a few degrees past it. */
+#define ETA_TURN_SLOW_DEGREES 12.0f
+
+/* However long a step has been running, it stops here - a view that has
+   not reached its point in this time is not going to. */
+#define ETA_TURN_STEP_LIMIT_MS 1500
+
+typedef struct
+{
+	int      held;          /* -1 left, 1 right, 0 none: a turn key is down */
+	int      pressedAt;
+	float    startYaw;
+	int      passthrough;   /* the setting is off: a plain +left or +right */
+	int      step;          /* -1 left, 1 right, 0 none: a step is running */
+	int      stepStarted;
+	float    target;        /* the yaw it stops at */
+	qboolean fast;
+	char     savedScale[32];
+} eta_turn_t;
+
+static eta_turn_t eta_turn;
+
+static void ETA_TurnKey(int direction, qboolean down)
+{
+	trap_SendConsoleCommand(va("%s%s %s\n", down ? "+" : "-",
+	                           direction < 0 ? "left" : "right",
+	                           direction < 0 ? ETA_TURN_KEY_LEFT : ETA_TURN_KEY_RIGHT));
+}
+
+static void ETA_TurnBoost(qboolean on)
+{
+	if (on && !eta_turn.fast)
+	{
+		trap_Cvar_VariableStringBuffer("cl_anglespeedkey", eta_turn.savedScale,
+		                               sizeof(eta_turn.savedScale));
+		trap_Cvar_Set("cl_anglespeedkey", ETA_TURN_FAST_SCALE);
+		trap_SendConsoleCommand("+speed " ETA_TURN_KEY_SPEED "\n");
+		eta_turn.fast = qtrue;
+	}
+	else if (!on && eta_turn.fast)
+	{
+		trap_SendConsoleCommand("-speed " ETA_TURN_KEY_SPEED "\n");
+		trap_Cvar_Set("cl_anglespeedkey", eta_turn.savedScale[0] ? eta_turn.savedScale : "1.5");
+		eta_turn.fast = qfalse;
+	}
+}
+
+/**
+ * @brief The next of the eight compass points in the direction of turn.
+ *
+ * The points sit at every 45 degrees of yaw. Turning right lowers the
+ * yaw - the engine's own convention, in CL_AdjustAngles - so right goes
+ * down to the next multiple of 45 and left goes up.
+ */
+static float ETA_TurnNextPoint(float yaw, int direction)
+{
+	if (direction > 0)
+	{
+		return 45.0f * floorf((yaw - ETA_TURN_STEP_MARGIN) / 45.0f);
+	}
+
+	return 45.0f * ceilf((yaw + ETA_TURN_STEP_MARGIN) / 45.0f);
+}
+
+/**
+ * @brief Degrees still to turn, positive until the point is reached.
+ */
+static float ETA_TurnRemaining(void)
+{
+	float yaw = cg.predictedPlayerState.viewangles[YAW];
+
+	return eta_turn.step > 0 ? AngleSubtract(yaw, eta_turn.target)
+	                         : AngleSubtract(eta_turn.target, yaw);
+}
+
+static void ETA_TurnStopStep(qboolean arrived)
+{
+	ETA_TurnKey(eta_turn.step, qfalse);
+	ETA_TurnBoost(qfalse);
+	eta_turn.step = 0;
+	ETA_HudNarrator_SetFacingKeyTurn(0);
+
+	if (arrived)
+	{
+		ETA_Facing facing = ETA_HudNarrator_FacingFromYaw(eta_turn.target);
+
+		/* Said here, at once, rather than left to the compass: waiting
+		   for it to settle is exactly the delay the tap exists to
+		   remove. Marked held so the compass does not say it again. */
+		ETA_HudNarrator_SetFacingHeld(facing);
+
+		if (eta_facingCallouts.integer)
+		{
+			ETA_Speech_BeginReport();
+			ETA_HudNarrator_SpeakFacing(facing);
+			ETA_Speech_EndReport();
+		}
+	}
+}
+
+static void CG_AccessibilityTurnDown(int direction)
+{
+	/* A second press of a key already down is a repeat, not a tap. The
+	   engine drops keyboard repeats in play, but a repeat reaching here
+	   would restart the tap timer - so a hold would read as a tap - or
+	   add a compass point to a step nobody asked for. */
+	if (!cg.snap || eta_turn.held == direction || eta_turn.passthrough == direction)
+	{
+		return;
+	}
+
+	if (!eta_turnSteps.integer)
+	{
+		eta_turn.passthrough = direction;
+		ETA_TurnKey(direction, qtrue);
+		return;
+	}
+
+	if (eta_turn.step == direction)
+	{
+		/* Tapped again before the last step finished: one more point.
+		   Two quick taps are a quarter turn, as a flick would be. Held
+		   under half a turn, so which way is "still to go" can never be
+		   mistaken for which way is "already past". */
+		if (ETA_TurnRemaining() + 45.0f < 170.0f)
+		{
+			eta_turn.target = eta_turn.target - 45.0f * (float)direction;
+		}
+		eta_turn.held = direction;
+		return;
+	}
+
+	if (eta_turn.step)
+	{
+		/* The other way: stop where the view is and start from there. */
+		ETA_TurnStopStep(qfalse);
+	}
+
+	/* The compass is told the key is down only once this is known to be
+	   a hold (see CG_AccessibilityTurnFrame): a tap's own few degrees of
+	   travel are not worth a word before it lands. */
+	eta_turn.held      = direction;
+	eta_turn.pressedAt = cg.time;
+	eta_turn.startYaw  = cg.predictedPlayerState.viewangles[YAW];
+	ETA_TurnKey(direction, qtrue);
+}
+
+static void CG_AccessibilityTurnUp(int direction)
+{
+	if (eta_turn.passthrough == direction)
+	{
+		eta_turn.passthrough = 0;
+		ETA_TurnKey(direction, qfalse);
+		return;
+	}
+
+	if (eta_turn.held != direction)
+	{
+		return;
+	}
+
+	eta_turn.held = 0;
+
+	if (eta_turn.step == direction)
+	{
+		/* The step this press extended is still running; it carries on
+		   and releases the key when it arrives. */
+		return;
+	}
+
+	if (cg.time - eta_turn.pressedAt < ETA_TURN_TAP_MS)
+	{
+		/* A tap: keep the key down, and let the frame finish the turn. */
+		eta_turn.step        = direction;
+		eta_turn.stepStarted = cg.time;
+		eta_turn.target      = ETA_TurnNextPoint(eta_turn.startYaw, direction);
+
+		/* A long tap from just short of a point can already have
+		   carried the view past it. Then the next one is meant. */
+		if (ETA_TurnRemaining() < 0.0f)
+		{
+			eta_turn.target = eta_turn.target - 45.0f * (float)direction;
+		}
+
+		if (ETA_TurnRemaining() > ETA_TURN_SLOW_DEGREES)
+		{
+			ETA_TurnBoost(qtrue);
+		}
+		return;
+	}
+
+	/* A hold: it stops where it was let go. */
+	ETA_TurnKey(direction, qfalse);
+	ETA_HudNarrator_SetFacingKeyTurn(0);
+}
+
+/**
+ * @brief Every frame: brings a running step in to land on its point.
+ */
+void CG_AccessibilityTurnFrame(void)
+{
+	float remaining, perFrame;
+
+	/* Held past a tap: a smooth turn, and every point it crosses is
+	   worth naming as it is crossed. */
+	if (eta_turn.held && !eta_turn.step && cg.time - eta_turn.pressedAt >= ETA_TURN_TAP_MS)
+	{
+		ETA_HudNarrator_SetFacingKeyTurn(1);
+	}
+
+	if (!eta_turn.step)
+	{
+		return;
+	}
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL
+	    || cg.time - eta_turn.stepStarted > ETA_TURN_STEP_LIMIT_MS
+	    || cg.time < eta_turn.stepStarted)
+	{
+		ETA_TurnStopStep(qfalse);
+		return;
+	}
+
+	remaining = ETA_TurnRemaining();
+
+	if (eta_turn.fast && remaining <= ETA_TURN_SLOW_DEGREES)
+	{
+		ETA_TurnBoost(qfalse);
+	}
+
+	/* How far the next frame will carry the view. A release sent now
+	   takes effect before the next frame's movement, so letting go once
+	   less than half of that is left lands within half a frame's turn of
+	   the point - under a degree at the ordinary speed. */
+	perFrame = 0.14f * (float)cg.frametime * (eta_turn.fast ? ETA_TURN_FAST_FACTOR : 1.0f);
+
+	if (remaining <= perFrame * 0.5f)
+	{
+		ETA_TurnStopStep(qtrue);
+	}
+}
+
+/**
+ * @brief Whether a tap is still on its way to a compass point.
+ *
+ * The compass stands down meanwhile. The tap says where it lands the
+ * moment it lands, and a compass that named a point on the way would
+ * either say the wrong one or say the right one twice.
+ */
+qboolean CG_AccessibilityTurnBusy(void)
+{
+	return (qboolean)(eta_turn.step
+	                  || (eta_turn.held && cg.time - eta_turn.pressedAt < ETA_TURN_TAP_MS));
+}
+
+/**
+ * @brief Lets go of everything, for a map change or a shutdown.
+ *
+ * A key this pressed stays down in the client until something releases
+ * it, and the client outlives the cgame - left alone, the view would
+ * keep turning into the next map.
+ */
+void CG_AccessibilityTurnShutdown(void)
+{
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+	if (eta_turn.held)
+	{
+		ETA_TurnKey(eta_turn.held, qfalse);
+	}
+	if (eta_turn.passthrough)
+	{
+		ETA_TurnKey(eta_turn.passthrough, qfalse);
+	}
+	ETA_TurnBoost(qfalse);
+	ETA_HudNarrator_SetFacingKeyTurn(0);
+	memset(&eta_turn, 0, sizeof(eta_turn));
+}
+
+void CG_AccessibilityTurnLeftDown_f(void)
+{
+	CG_AccessibilityTurnDown(-1);
+}
+
+void CG_AccessibilityTurnLeftUp_f(void)
+{
+	CG_AccessibilityTurnUp(-1);
+}
+
+void CG_AccessibilityTurnRightDown_f(void)
+{
+	CG_AccessibilityTurnDown(1);
+}
+
+void CG_AccessibilityTurnRightUp_f(void)
+{
+	CG_AccessibilityTurnUp(1);
+}
+
+/* Climbing a ladder with the use key is not ported yet. */
+qboolean CG_AccessibilityClimbing(void)
+{
+	return qfalse;
+}
+
+void CG_AccessibilitySurroundings_f(void)
+{
+	CG_AccessibilitySurroundings();
+}
+
+#endif
diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
new file mode 100644
index 0000000..427c7b4
--- /dev/null
+++ b/SP/code/cgame/cg_accessibility_route.c
@@ -0,0 +1,1679 @@
+/*
+ * name:	cg_accessibility_route.c
+ *
+ * desc:	[Accessibility]: the marker - a place to go - and the way
+ *			there round the walls, heard as a sound to turn toward and
+ *			said as the turns come. Ported from the accessibility mode's
+ *			ET: Legacy cgame (its cg_commandmap.c) by way of its No Quarter
+ *			one, without the command map: in the campaign the marker is the
+ *			level's way out.
+ *
+ *			Only built with FEATURE_ACCESSIBILITY.
+ */
+
+#ifdef FEATURE_ACCESSIBILITY
+
+#include "cg_local.h"
+#include "../client/keycodes.h"
+
+#include "hud/hud_narrator.h"
+#include "navigation/navigation_system.h"
+#include "speech/speech_manager.h"
+
+/**
+ * @brief A place the player chose to go, and the way there.
+ *
+ * The game has nothing like it. A sighted player does not need one: they
+ * look at the far side of the bridge, decide to go there, and go. What
+ * they are using is not the map, it is the ability to pick a destination
+ * of their own and keep it in view. The objective guidance cannot stand
+ * in for that - it only ever points where the map's script says - so
+ * this lets the player put down a destination and then hears them to it.
+ *
+ * Two kinds, from one key. With the command map up and the survey cursor
+ * moved onto a square, the marker goes on that square: anywhere on the
+ * map, in the grid the rest of the team already speaks. With the map
+ * down, it goes where the player is standing, which is how they get back
+ * to a spot - a doorway they found, the corner they were holding - after
+ * a death or a detour.
+ */
+typedef struct
+{
+	qboolean active;
+	qboolean square;   /* a map square rather than a spot */
+	qboolean leftIt;   /* has been far enough away for arriving to mean something */
+	qboolean objective;/* put on the objective, which has a name of its own */
+	vec3_t origin;     /* the spot, or the square's middle */
+	int column, row, layer;
+	char name[48];     /* the square's name, "C,3", or the objective's */
+} eta_marker_t;
+
+static eta_marker_t eta_marker;
+
+/**
+ * @brief How close to a spot counts as having reached it.
+ *
+ * A spot marker is where the player stood, so three metres is "back on
+ * it" without asking them to find the exact footprint. A square is
+ * reached by walking into it, which the grid decides rather than this.
+ */
+#define ETA_MARKER_ARRIVE_METERS 3.0f
+
+/**
+ * @brief How far toward the marker its sound is placed.
+ *
+ * The sound has to point, not to be where the marker is: a marker on the
+ * far side of the map would be far outside the engine's hearing range
+ * and play as silence. So it sits a few metres off in the marker's
+ * direction, where the engine gives it a clear left and right, and only
+ * closes to the marker itself once the player is nearer than this. That
+ * last part is what lets them walk onto it by ear.
+ */
+#define ETA_MARKER_BEACON_DISTANCE 256.0f
+
+/**
+ * @brief Where the player's ears are.
+ */
+/* The campaign has no command map, so the marker is never on one of
+   its squares: these stand in for the square's own, unused. */
+static float ETA_MarkerSquareRadius(void)
+{
+	return 256.0f;
+}
+
+static qboolean ETA_MarkerSquareUnderfoot(void)
+{
+	return qfalse;
+}
+
+static void ETA_MarkerSquareName(char *out, size_t outSize)
+{
+	Q_strncpyz(out, eta_marker.name, outSize);
+}
+
+static void ETA_MarkerEye(vec3_t eye)
+{
+	VectorCopy(cg.predictedPlayerState.origin, eye);
+	eye[2] += cg.predictedPlayerState.viewheight;
+}
+
+
+/**
+ * @brief The walkable way to the marker, around the walls.
+ *
+ * The ping used to sit straight toward the marker, and a tester reported
+ * what that does to someone who cannot see: it leads them into the wall
+ * between them and it, not to the doorway a sighted player would walk
+ * to without thinking. Two things now stand in the way of that.
+ *
+ * The way: the library's search (ETA_PathFinder) looks for a walkable
+ * way to the marker over a grid of half-metre squares, a little every
+ * frame, and the ping points at the furthest point of it that can be
+ * walked to in a straight line. Round a corner, that point moves on.
+ *
+ * The opening: whatever the ping is pointing at, several times a second
+ * the mod checks that the player could actually walk toward it. When a
+ * wall is in the way - because the way is not found yet, or the marker
+ * is too far for the search to reach, or it is a straight line that
+ * clips a corner - the ping moves to the nearest open way out, the one
+ * closest to where it was pointing. So it never points into a wall, from
+ * the moment the marker goes down. The first reported attempt pointed
+ * straight until a search finished, and on a real map, with the marker
+ * across the map behind a long wall, the search could run out of room
+ * first - so it pointed into the wall for good. tests/marker_route_sim
+ * _test.py walks a player to the marker by the ping through scenes like
+ * that one.
+ *
+ * The walk is judged against the map's own brushes alone. A closed door
+ * is a way through - it opens when used - and so is anything else that
+ * moves. The probe stands a step high, so kerbs and stairs are walked
+ * up; it is refused wherever the floor falls away further than a safe
+ * drop, and wherever the floor is lava or slime.
+ *
+ * It is 32 units across, against a player's 36. It was 24, so that a
+ * doorway would be found wherever the squares fell - and on the real
+ * Oasis map that sent the way to the Allied Command Post between a post
+ * and a ramp, through a gap the probe fitted and a player does not. A
+ * walk following the ping stopped there for good, which is what the
+ * tester met. 32 still finds every doorway a player uses: the squares
+ * are 32 apart, so a 64-unit doorway always has one with 16 to spare on
+ * each side.
+ */
+#define ETA_ROUTE_CELL          32.0f
+#define ETA_ROUTE_HALF_WIDTH    16.0f
+#define ETA_ROUTE_SLOPE_LIFT    20.0f   /* a second try, higher, for ramps */
+#define ETA_ROUTE_JUMP_LIFT     24.0f   /* a third, for a ledge to jump onto */
+#define ETA_ROUTE_MAX_DROP      96.0f
+#define ETA_ROUTE_BUDGET_MS     2       /* searching per frame, at most */
+#define ETA_ROUTE_BUDGET_STEP   4       /* squares between looks at the clock */
+#define ETA_ROUTE_REPLAN_MS     5000    /* the world changes: look again */
+#define ETA_ROUTE_RETRY_MS      3000    /* after finding no way at all */
+#define ETA_ROUTE_STRAY         128.0f  /* this far off the way: replan */
+#define ETA_ROUTE_STEER_MS      150
+#define ETA_ROUTE_LOOKAHEAD     16      /* points ahead worth checking */
+#define ETA_ROUTE_CLEAR_AHEAD   320.0f  /* how far toward the ping must be walkable */
+#define ETA_ROUTE_OPENING_REACH 512.0f  /* how far an opening is looked down */
+#define ETA_ROUTE_OPENING_MIN   192.0f  /* how far it must run to count */
+#define ETA_ROUTE_OPENING_STEP  15      /* degrees between the looks */
+#define ETA_ROUTE_ON_WAY        48.0f   /* this near the way's point: on it */
+
+typedef struct
+{
+	qboolean planned;     /* a search has been started for this marker */
+	int      startedAt;
+	qboolean done;        /* the current search has finished */
+	int      doneAt;
+	vec3_t   steer;       /* the point along the way */
+	qboolean steering;    /* steer is from the way, not the straight line */
+	vec3_t   aim;         /* where the ping and the turn words point */
+	qboolean aimSet;
+	int      steeredAt;
+	int      along;       /* the point of the way the player is at */
+	int      side;        /* which way round the last opening was: -1, 1, 0 */
+	int      saidJump;    /* the jump on the way last told of, by its point */
+	qboolean crouched;    /* told to crouch, and not yet to stand */
+	qboolean overEdge;    /* steer is across a jump or up a ladder */
+	qboolean onWay;       /* steer is the way's next point, from on the way */
+	qboolean jumps;       /* this search may jump: there was no way without */
+	qboolean throughMines; /* this search may cross a mine: there was no way round */
+	vec3_t   stairsAt;    /* the foot of the stairs last told of */
+	qboolean saidStairs;
+} eta_route_t;
+
+static eta_route_t eta_route;
+
+/**
+ * @brief Whether a whole player fits through the step, the probe aside.
+ *
+ * The probe that finds the way is narrower than a player, so that a
+ * doorway is found wherever the squares fall. That let the way through
+ * gaps a player does not fit: a walk following the ping on the real
+ * Oasis stopped for good at two of them, and the ping pointed at the
+ * gap the whole time. So each step is tried once more with the player's
+ * own width and standing height, from the middle of the square or a
+ * little to either side of it - a doorway the square's middle is
+ * off-centre in is still found - and the way keeps to wherever it
+ * fitted. The probe is only as tall as a crouching player, and nothing
+ * tells the player to crouch, so a way under something lower than a
+ * standing player is no way.
+ */
+#define ETA_ROUTE_BODY_HALF  18.0f   /* the player's own: -18 to 18 */
+#define ETA_ROUTE_BODY_NUDGE 10.0f
+#define ETA_ROUTE_BODY_TOP   48.0f   /* standing: playerMaxs in g_client.c */
+/* Crouched: the game's crouchMaxZ, standing less the drop from the
+   standing to the crouching view (40 - 16). The tunnels under Oasis are
+   lower than a player standing; the way refused them, and the way out of
+   them was never found. */
+#define ETA_ROUTE_CROUCH_TOP (ETA_ROUTE_BODY_TOP - (40.0f - 16.0f))
+
+static qboolean ETA_RouteRoom(const float from[3], float to[3], float lift, float top)
+{
+	static const vec3_t mins = { -ETA_ROUTE_BODY_HALF, -ETA_ROUTE_BODY_HALF, -24.0f + 18.0f };
+	static const vec3_t snugMins = { -ETA_ROUTE_BODY_HALF + 1.0f, -ETA_ROUTE_BODY_HALF + 1.0f, -24.0f + 18.0f };
+	const vec3_t        maxs     = { ETA_ROUTE_BODY_HALF, ETA_ROUTE_BODY_HALF, top };
+	const vec3_t        snugMaxs = { ETA_ROUTE_BODY_HALF - 1.0f, ETA_ROUTE_BODY_HALF - 1.0f, top };
+	static const float  nudges[5][2] =
+	{
+		{ 0.0f, 0.0f },
+		{ ETA_ROUTE_BODY_NUDGE, 0.0f }, { -ETA_ROUTE_BODY_NUDGE, 0.0f },
+		{ 0.0f, ETA_ROUTE_BODY_NUDGE }, { 0.0f, -ETA_ROUTE_BODY_NUDGE }
+	};
+	trace_t trace;
+	vec3_t  start, end;
+	int     i;
+
+	VectorSet(start, from[0], from[1], from[2] + lift);
+
+	for (i = 0; i < 5; i++)
+	{
+		VectorSet(end, to[0] + nudges[i][0], to[1] + nudges[i][1], from[2] + lift);
+		trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+		/* A player pressed against a wall touches it, and a box the
+		   player's own size set down there touches it too: the way out
+		   of a gap the player is standing in is tried a hair narrower,
+		   and only where they end up has to take their whole width. */
+		if (trace.startsolid)
+		{
+			trap_CM_BoxTrace(&trace, start, end, snugMins, snugMaxs, 0, MASK_PLAYERSOLID);
+			if (!trace.startsolid && trace.fraction >= 1.0f)
+			{
+				trap_CM_BoxTrace(&trace, end, end, mins, maxs, 0, MASK_PLAYERSOLID);
+			}
+			else
+			{
+				continue;
+			}
+		}
+
+		if (!trace.startsolid && trace.fraction >= 1.0f)
+		{
+			to[0] = end[0];
+			to[1] = end[1];
+			return qtrue;
+		}
+	}
+
+	return qfalse;
+}
+
+/**
+ * @brief Can a player walk one square, and at what height do they land.
+ */
+static int ETA_RouteMoveExact(void *context, const float from[3], float to[3])
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	/* The same body lowered a step onto the floor: bottom at the feet, top
+	   no higher than the probe above reached, so a low passage the
+	   sideways check fitted through is not refused on the way down. */
+	static const vec3_t footMins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f };
+	static const vec3_t footMaxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f - 18.0f };
+	static const float lifts[2] = { ETA_ROUTE_SLOPE_LIFT, ETA_ROUTE_JUMP_LIFT };
+	trace_t  trace;
+	vec3_t   start, end, down;
+	float    lift   = 0.0f;
+	qboolean ledge  = qfalse;
+	qboolean crouch = qfalse;
+	int      i;
+
+	(void)context;
+
+	VectorCopy(from, start);
+	VectorSet(end, to[0], to[1], from[2]);
+
+	trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid || trace.fraction < 1.0f)
+	{
+		/* What stopped the step: a slope rises faster than a step over
+		   one square, but its face leans back. A face that stands
+		   straight up is the edge of a ledge, which no amount of walking
+		   gets onto - it is jumped. */
+		/* Anything steeper than the game lets a player walk up - its
+		   MIN_WALK_NORMAL, 0.7 - is a face, not a slope: a rock leaning
+		   back a little was taken for a ramp beside the Axis command
+		   post on Oasis, and the way said to walk up it. */
+		ledge = (qboolean)(!trace.startsolid && trace.plane.normal[2] < 0.7f);
+
+		/* Again a little higher, and then as high as a jump reaches, if
+		   there is headroom to get there. ET's jump lifts the feet about
+		   45 units (JUMP_VELOCITY 270 against gravity 800); the probe's
+		   bottom stands a step above the feet, so a lift of 24 clears a
+		   ledge of 42 - a little short of the most, to leave room. */
+		for (i = 0; i < 2; i++)
+		{
+			lift = lifts[i];
+			VectorCopy(from, start);
+			VectorCopy(from, end);
+			end[2] += lift;
+			trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+			if (trace.startsolid || trace.fraction < 1.0f)
+			{
+				return ETA_PATH_NONE;
+			}
+
+			VectorCopy(end, start);
+			VectorSet(end, to[0], to[1], from[2] + lift);
+			trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+			if (!trace.startsolid && trace.fraction >= 1.0f)
+			{
+				break;
+			}
+		}
+
+		if (i == 2)
+		{
+			return ETA_PATH_NONE;
+		}
+
+		/* Only a jump clears the higher of the two. */
+		if (i == 1)
+		{
+			ledge = qtrue;
+		}
+	}
+
+	/* Room for the player standing; or, on the level, crouched - a jump
+	   wants the headroom a crouch has not got. */
+	if (!ETA_RouteRoom(from, to, lift, ETA_ROUTE_BODY_TOP))
+	{
+		if (ledge || !ETA_RouteRoom(from, to, lift, ETA_ROUTE_CROUCH_TOP))
+		{
+			return ETA_PATH_NONE;
+		}
+		crouch = qtrue;
+	}
+	end[0] = to[0];
+	end[1] = to[1];
+
+	/* Down onto the floor there, from a step up. */
+	VectorCopy(end, start);
+	start[2] += 18.0f;
+	VectorCopy(start, down);
+	down[2] -= 18.0f + lift + ETA_ROUTE_MAX_DROP;
+
+	trap_CM_BoxTrace(&trace, start, down, footMins, footMaxs, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid || trace.allsolid || trace.fraction >= 1.0f
+	    || trace.plane.normal[2] < 0.7f)
+	{
+		return ETA_PATH_NONE;
+	}
+
+	if (CG_PointContents(trace.endpos, -1) & (CONTENTS_LAVA | CONTENTS_SLIME))
+	{
+		return ETA_PATH_NONE;
+	}
+
+	to[2] = trace.endpos[2];
+
+	/* Up onto a ledge, or over something and down the other side: either
+	   way the player has to jump, and is told to. Under a low ceiling,
+	   to crouch. */
+	return ledge ? ETA_PATH_JUMP : crouch ? ETA_PATH_CROUCH : ETA_PATH_WALK;
+}
+
+/**
+ * @brief The landmines the player has been shown: the way keeps clear
+ * of them.
+ *
+ * The tester kept dying to landmines. Only the ones the game shows the
+ * player are here - spotted by a teammate, or seen with the skill to see
+ * them (cg_draw.c sets them each frame) - so the way never steers round
+ * a mine a sighted player could not know of. A mine goes off for a
+ * player 64 units from it (sEntWillTriggerMine), so a square nearer
+ * than that and a little more is no square to step on. Where there is
+ * no way round - a mine in the one doorway - the way goes on through,
+ * and the warning says it is there.
+ */
+#define ETA_ROUTE_AVOID_RADIUS 72.0f
+#define ETA_ROUTE_AVOID_MAX    32   /* the most kept clear of at once */
+
+static float    eta_routeAvoid[ETA_ROUTE_AVOID_MAX][3];
+static int      eta_routeAvoidCount;
+static qboolean eta_routeAvoidNew;   /* a mine not known when the way was planned */
+
+void CG_AccessibilityRouteAvoid(const float (*points)[3], int count)
+{
+	float was[ETA_ROUTE_AVOID_MAX][3];
+	int   wasCount = eta_routeAvoidCount, i, k;
+
+	memcpy(was, eta_routeAvoid, sizeof(was));
+	eta_routeAvoidCount = 0;
+	for (i = 0; i < count && i < ETA_ROUTE_AVOID_MAX; i++)
+	{
+		qboolean known = qfalse;
+
+		eta_routeAvoid[i][0] = points[i][0];
+		eta_routeAvoid[i][1] = points[i][1];
+		eta_routeAvoid[i][2] = points[i][2];
+		eta_routeAvoidCount++;
+
+		for (k = 0; k < wasCount && !known; k++)
+		{
+			known = fabs(was[k][0] - points[i][0]) < 1.0f && fabs(was[k][1] - points[i][1]) < 1.0f
+			        && fabs(was[k][2] - points[i][2]) < 1.0f;
+		}
+		if (!known)
+		{
+			eta_routeAvoidNew = qtrue;
+		}
+	}
+}
+
+static qboolean ETA_RouteAvoided(const float at[3])
+{
+	int i;
+
+	if (eta_route.throughMines)
+	{
+		return qfalse;
+	}
+
+	for (i = 0; i < eta_routeAvoidCount; i++)
+	{
+		float dx = at[0] - eta_routeAvoid[i][0], dy = at[1] - eta_routeAvoid[i][1];
+
+		if (dx * dx + dy * dy < ETA_ROUTE_AVOID_RADIUS * ETA_ROUTE_AVOID_RADIUS
+		    && fabs(at[2] - eta_routeAvoid[i][2]) < 64.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/**
+ * @brief Whether a straight walk goes nearer a mine than the way keeps.
+ *
+ * Every step of the way, and the straight walks that follow it: the way
+ * is followed by walking straight to the furthest point of it that can
+ * be walked to, which cuts its corners - and a corner round a mine, cut,
+ * goes over the mine. A walk that only takes the player further from a
+ * mine they are already near is let through: it is the way out.
+ */
+static qboolean ETA_RouteLineAvoided(const float from[3], const float to[3])
+{
+	float dx = to[0] - from[0], dy = to[1] - from[1];
+	float length2 = dx * dx + dy * dy;
+	int   i;
+
+	if (eta_route.throughMines)
+	{
+		return qfalse;
+	}
+
+	for (i = 0; i < eta_routeAvoidCount; i++)
+	{
+		const float *mine = eta_routeAvoid[i];
+		float       f     = length2 > 0.0f ? ((mine[0] - from[0]) * dx + (mine[1] - from[1]) * dy) / length2 : 0.0f;
+		float       ax, ay, closest, already;
+
+		if (fabs(from[2] - mine[2]) >= 64.0f && fabs(to[2] - mine[2]) >= 64.0f)
+		{
+			continue;
+		}
+
+		f       = f < 0.0f ? 0.0f : f > 1.0f ? 1.0f : f;
+		ax      = from[0] + dx * f - mine[0];
+		ay      = from[1] + dy * f - mine[1];
+		closest = sqrt(ax * ax + ay * ay);
+		already = sqrt((from[0] - mine[0]) * (from[0] - mine[0]) + (from[1] - mine[1]) * (from[1] - mine[1]));
+
+		if (closest < ETA_ROUTE_AVOID_RADIUS && closest < already - 1.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/**
+ * @brief A step to the next square, or to a point a little to either
+ * side of it.
+ *
+ * The squares are laid out from wherever the player stood when the way
+ * was asked for, so a gap narrower than a square is on the way only when
+ * the squares happen to fall inside it. On Oasis the short way to the
+ * Allied command post goes through such a gap, a narrow alley a little
+ * over a body wide: from some places the squares fell in it and the way
+ * went straight there, from others they fell on its walls and the way
+ * went right round through the excavation below. So a step that does not
+ * fit is tried again shifted across the way it goes - a quarter and a
+ * half of a square either side, which no gap a body fits through falls
+ * between - and the way keeps to wherever it fitted. A walk is taken
+ * over a jump wherever one fits.
+ */
+#define ETA_ROUTE_SHIFT 8.0f
+
+static int ETA_RouteMove(void *context, const float from[3], float to[3])
+{
+	static const float shifts[5] = { 0.0f, ETA_ROUTE_SHIFT, -ETA_ROUTE_SHIFT,
+		                             2.0f * ETA_ROUTE_SHIFT, -2.0f * ETA_ROUTE_SHIFT };
+	float dx    = to[0] - from[0], dy = to[1] - from[1];
+	float ax    = dx < 0.0f ? -dx : dx, ay = dy < 0.0f ? -dy : dy;
+	int   across, count, i, found = ETA_PATH_NONE;
+	float jumpTo[3];
+
+	/* Across the step: y for a step east or west, x for one north or
+	   south. A diagonal step is taken as it is. */
+	if (ax > 2.0f * ay)
+	{
+		across = 1;
+	}
+	else if (ay > 2.0f * ax)
+	{
+		across = 0;
+	}
+	else
+	{
+		across = -1;
+	}
+	count = across < 0 ? 1 : 5;
+
+	for (i = 0; i < count; i++)
+	{
+		float tried[3];
+		int   kind;
+
+		VectorCopy(to, tried);
+		if (across >= 0)
+		{
+			tried[across] += shifts[i];
+		}
+
+		if (ETA_RouteLineAvoided(from, tried))
+		{
+			continue;
+		}
+
+		kind = ETA_RouteMoveExact(context, from, tried);
+
+		if (kind == ETA_PATH_WALK)
+		{
+			VectorCopy(tried, to);
+			return kind;
+		}
+
+		/* A crouch is taken over a jump. */
+		if (kind != ETA_PATH_NONE && (found == ETA_PATH_NONE || (kind == ETA_PATH_CROUCH && found == ETA_PATH_JUMP)))
+		{
+			found = kind;
+			VectorCopy(tried, jumpTo);
+		}
+	}
+
+	if (found != ETA_PATH_NONE)
+	{
+		VectorCopy(jumpTo, to);
+	}
+	return found;
+}
+
+/**
+ * @brief How far a player could walk straight from one place toward
+ * another, up to the whole way: the fraction of it that is walkable.
+ */
+static float ETA_RouteWalkable(const vec3_t from, const vec3_t to)
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	trace_t trace;
+	vec3_t  a, b;
+	float   reach, length;
+	int     samples, i;
+
+	VectorCopy(from, a);
+	VectorCopy(to, b);
+
+	/* Somewhere higher up is walked to only up a slope. Looked at from
+	   down here, a slope leans back, and so does nothing else: a face
+	   that stands straight up is a wall, a ledge, or the riser of a
+	   stair too high to take in one, and the line stops there. Without
+	   this the higher end's floor was all that was looked at, and a
+	   floor above, reached by stairs round the side, was "straight
+	   ahead" - through the wall under it. */
+	if (b[2] > a[2] + 18.0f)
+	{
+		vec3_t level;
+
+		VectorSet(level, b[0], b[1], a[2]);
+		trap_CM_BoxTrace(&trace, a, level, mins, maxs, 0, MASK_PLAYERSOLID);
+
+		if (trace.startsolid)
+		{
+			return 0.0f;
+		}
+
+		/* Steeper than the game lets a player walk up - MIN_WALK_NORMAL,
+		   0.7 - is as good as a wall: the face of a rock leans back a
+		   little, and near the Allied camp on Oasis the ping pointed at
+		   one, over the top of it, and held a player against it. */
+		if (trace.fraction < 1.0f && trace.plane.normal[2] < 0.7f)
+		{
+			return trace.fraction;
+		}
+	}
+
+	/* Level with the higher end, so a straight run up a ramp is not cut by
+	   the ramp itself. */
+	a[2] = b[2] = MAX(a[2], b[2]);
+
+	trap_CM_BoxTrace(&trace, a, b, mins, maxs, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid)
+	{
+		return 0.0f;
+	}
+
+	reach  = trace.fraction;
+	length = Distance(from, to) * reach;
+
+	/* Somewhere lower down, more steeply than a stair runs, is not walked
+	   to either: it is a drop off an edge. */
+	if (from[2] - to[2] > ETA_ROUTE_MAX_DROP)
+	{
+		vec3_t flat;
+
+		VectorSubtract(to, from, flat);
+		flat[2] = 0.0f;
+
+		if (from[2] - to[2] > VectorLength(flat))
+		{
+			return 0.0f;
+		}
+	}
+
+	/* And floor all the way: a straight line across a hole the way goes
+	   round is not a way, and nor is one off the side of a stair or the
+	   end of a balcony. Looking only for some floor, however far down,
+	   let the line off a balcony near the Allied Command Post on Oasis
+	   to the floor seven metres under it - the way went down the
+	   stairs, and the ping said to walk off the edge. So from one look
+	   to the next the floor may fall no faster than a stair does, one
+	   unit down for one along, or a step where the looks are close; and
+	   the last look is at the end itself. Sampled every couple of
+	   squares, looking down as far as a safe drop. */
+	samples = (int)(length / (2.0f * ETA_ROUTE_CELL));
+
+	{
+		float lastFloor = from[2] - 24.0f, lastAt = 0.0f;
+
+		for (i = 1; i <= samples + 1; i++)
+		{
+			vec3_t point, below;
+			float  f = reach * (float)i / (float)(samples + 1);
+			float  along;
+
+			point[0] = from[0] + (to[0] - from[0]) * f;
+			point[1] = from[1] + (to[1] - from[1]) * f;
+			point[2] = a[2];
+			VectorCopy(point, below);
+			below[2] -= 24.0f + ETA_ROUTE_MAX_DROP + fabsf(from[2] - to[2]);
+
+			trap_CM_BoxTrace(&trace, point, below, NULL, NULL, 0, MASK_PLAYERSOLID);
+
+			along = length * (float)i / (float)(samples + 1);
+
+			if (trace.fraction >= 1.0f
+			    || trace.endpos[2] < lastFloor - MAX(along - lastAt, 18.0f)
+			    || (CG_PointContents(trace.endpos, -1) & (CONTENTS_LAVA | CONTENTS_SLIME)))
+			{
+				return f - reach / (float)(samples + 1);
+			}
+
+			lastFloor = trace.endpos[2];
+			lastAt    = along;
+		}
+	}
+
+	return reach;
+}
+
+static qboolean ETA_RouteClear(const vec3_t from, const vec3_t to)
+{
+	return (qboolean)(ETA_RouteWalkable(from, to) >= 1.0f && !ETA_RouteLineAvoided(from, to));
+}
+
+/**
+ * @brief The open way out nearest to a direction, when that direction
+ * is walled off.
+ *
+ * Looks round from the direction the ping wants, a step at a time on
+ * either side, and takes the first that runs far enough to walk down.
+ * The side it found last time is looked at first, so walking along a
+ * wall the ping does not swap ends of it from one moment to the next.
+ */
+static qboolean ETA_RouteOpening(const vec3_t here, float wantYaw, int widest, vec3_t out)
+{
+	int step;
+
+	for (step = 1; step * ETA_ROUTE_OPENING_STEP <= widest; step++)
+	{
+		int turn;
+
+		for (turn = 0; turn < 2; turn++)
+		{
+			int    side = (turn == 0) ? (eta_route.side ? eta_route.side : 1) : -(eta_route.side ? eta_route.side : 1);
+			float  yaw  = wantYaw + (float)(side * step * ETA_ROUTE_OPENING_STEP);
+			vec3_t angles, forward, end;
+			float  reach;
+
+			VectorSet(angles, 0.0f, yaw, 0.0f);
+			AngleVectors(angles, forward, NULL, NULL);
+			VectorMA(here, ETA_ROUTE_OPENING_REACH, forward, end);
+
+			reach = ETA_RouteWalkable(here, end) * ETA_ROUTE_OPENING_REACH;
+
+			if (reach >= ETA_ROUTE_OPENING_MIN)
+			{
+				VectorMA(here, MIN(reach, ETA_MARKER_BEACON_DISTANCE), forward, out);
+				eta_route.side = side;
+				return qtrue;
+			}
+
+			if (step * ETA_ROUTE_OPENING_STEP == 180)
+			{
+				break;   /* straight behind: one look is enough */
+			}
+		}
+	}
+
+	return qfalse;
+}
+
+/**
+ * @brief Starts looking for the way from where the player is now.
+ */
+/**
+ * @brief The same question with jumping left out.
+ *
+ * The way is looked for on foot first, and only when there is none is it
+ * looked for again with jumps. A jump the player cannot see the edge of
+ * is a fall waiting to happen, and on the real Oasis the first search -
+ * which counted a jump as two metres more walking - sent the Allied way
+ * up a one-metre ledge with an ordinary step beside it. The search is
+ * built to find a good way quickly, not the very best, and a cost alone
+ * did not keep it off the ledge; leaving jumps out until they are needed
+ * does.
+ */
+static int ETA_RouteMoveOnFoot(void *context, const float from[3], float to[3])
+{
+	int kind = ETA_RouteMove(context, from, to);
+
+	return kind == ETA_PATH_JUMP ? ETA_PATH_NONE : kind;
+}
+
+static void ETA_RoutePlanWith(qboolean jumps)
+{
+	float start[3], goal[3];
+
+	start[0] = cg.predictedPlayerState.origin[0];
+	start[1] = cg.predictedPlayerState.origin[1];
+	start[2] = cg.predictedPlayerState.origin[2];
+	goal[0]  = eta_marker.origin[0];
+	goal[1]  = eta_marker.origin[1];
+	goal[2]  = eta_marker.origin[2];
+
+	ETA_PathFinder_Begin(start, goal, ETA_ROUTE_CELL,
+	                     eta_marker.square ? ETA_MarkerSquareRadius()
+	                                       : ETA_MARKER_ARRIVE_METERS / ETA_QU_TO_METERS,
+	                     eta_marker.square);
+
+	eta_route.planned   = qtrue;
+	eta_route.startedAt = cg.time;
+	eta_route.done      = qfalse;
+	eta_route.along     = 0;
+	eta_route.saidJump  = -1;
+	eta_route.jumps     = jumps;
+
+	eta_route.throughMines = qfalse;
+	eta_routeAvoidNew      = qfalse;
+}
+
+static void ETA_RoutePlan(void)
+{
+	ETA_RoutePlanWith(qfalse);
+}
+
+/**
+ * @brief Forgets the way, so the next frame looks for a new one.
+ */
+static void ETA_RouteForget(void)
+{
+	ETA_PathFinder_Reset();
+	memset(&eta_route, 0, sizeof(eta_route));
+}
+
+/**
+ * @brief ", press space": the key the player jumps with, for the jump
+ * callout. Nothing when jump is on no key.
+ */
+static const char *ETA_RouteKey(const char *binding)
+{
+	/* The campaign's cgame cannot ask the engine for a key's name, so
+	   the keys a stock config binds are named here. */
+	static const struct
+	{
+		int         key;
+		const char *name;
+	} named[] =
+	{
+		{ K_SPACE, "space" }, { K_CTRL, "control" }, { K_SHIFT, "shift" }, { K_ALT, "alt" },
+		{ 'c', "c" }, { 'x', "x" }, { 'z', "z" },
+	};
+	static char text[48];
+	int         key = trap_Key_GetKey(binding);
+	int         i;
+
+	if (key < 0)
+	{
+		return "";
+	}
+	for (i = 0; i < (int)ARRAY_LEN(named); i++)
+	{
+		if (named[i].key == key)
+		{
+			Com_sprintf(text, sizeof(text), ", press %s", named[i].name);
+			return text;
+		}
+	}
+	if (key > ' ' && key < 127)
+	{
+		Com_sprintf(text, sizeof(text), ", press %c", (char)key);
+		return text;
+	}
+	return "";
+}
+
+static const char *ETA_RouteJumpKey(void)
+{
+	return ETA_RouteKey("+moveup");
+}
+
+/**
+ * @brief "Jump up, ahead", once, as the player comes to a jump on the way.
+ *
+ * The way can lead onto a ledge too high to step up, or over something
+ * in the way, and the ping alone cannot say that the next step is a
+ * jump: walking at a ledge just walks into it. So the player is told,
+ * within a couple of metres of the edge, which way the jump is - and
+ * whether it is up onto something or over it and down. A ladder needs
+ * nothing here: the ladder is said as the player reaches it, with F to
+ * climb (cg_draw.c).
+ */
+#define ETA_ROUTE_JUMP_SAY 96.0f
+
+static void ETA_RouteSayJump(int special, int count, const vec3_t here)
+{
+	vec3_t edge, landing, delta;
+
+	if (special >= count || special < 1 || special == eta_route.saidJump
+	    || ETA_PathFinder_PointKind(special) != ETA_PATH_JUMP)
+	{
+		return;
+	}
+
+	ETA_PathFinder_Point(special - 1, edge);
+	ETA_PathFinder_Point(special, landing);
+	VectorSubtract(edge, here, delta);
+	delta[2] = 0.0f;
+
+	if (VectorLength(delta) > ETA_ROUTE_JUMP_SAY)
+	{
+		return;
+	}
+
+	eta_route.saidJump = special;
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s, %s%s", landing[2] > edge[2] + 8.0f ? "Jump up" : "Jump over",
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(landing)),
+	                  ETA_RouteJumpKey()));
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief "Crouch, low ceiling ahead", once, as the way goes under one,
+ * and "Stand up" past it.
+ *
+ * The tunnels under Oasis are lower than a player standing, and a
+ * player who does not crouch walks into the roof at the entrance as if
+ * into a wall. So within a couple of metres of where the way first needs
+ * a crouch, it is said, with the key; and once the way has come out from
+ * under, standing is said too.
+ */
+#define ETA_ROUTE_CROUCH_SAY   96.0f   /* this near where it starts: told */
+#define ETA_ROUTE_CROUCH_AHEAD 4       /* points ahead looked at */
+
+static void ETA_RouteSayCrouch(int nearest, int count, const vec3_t here)
+{
+	int    i, start = -1;
+	vec3_t point;
+
+	for (i = nearest + 1; i < count && i <= nearest + ETA_ROUTE_CROUCH_AHEAD; i++)
+	{
+		if (ETA_PathFinder_PointKind(i) == ETA_PATH_CROUCH)
+		{
+			start = i;
+			break;
+		}
+	}
+
+	if (start < 0)
+	{
+		/* Out from under, and the way on stands up again. */
+		if (eta_route.crouched && ETA_PathFinder_PointKind(nearest) != ETA_PATH_CROUCH)
+		{
+			eta_route.crouched = qfalse;
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say("Stand up, the ceiling is high again");
+			ETA_Speech_EndReport();
+		}
+		return;
+	}
+
+	if (eta_route.crouched)
+	{
+		return;
+	}
+
+	/* Where the low ceiling begins: the point before the first crouch. */
+	ETA_PathFinder_Point(start - 1, point);
+	if (Distance(here, point) > ETA_ROUTE_CROUCH_SAY && ETA_PathFinder_PointKind(nearest) != ETA_PATH_CROUCH)
+	{
+		return;
+	}
+
+	eta_route.crouched = qtrue;
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("Crouch, low ceiling ahead%s", ETA_RouteKey("+movedown")));
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief "Stairs up, ahead left", once, as the player comes to stairs.
+ *
+ * The tester could not get up to the Allied command post on Oasis, and
+ * asked to be told where the stairs are and which way they go, and when
+ * it is not stairs, that it is a jump and which key. The way already
+ * climbs the stairs, square by square, and the ping follows it; but the
+ * ping alone says only which way, not that the next few metres go up a
+ * flight - and a player who does not know it walks into the bottom step
+ * at an angle, or along it. So within a few metres of the foot of a
+ * climb on the way, it is said: stairs, or a ramp, up or down, which way
+ * they go from where the player faces, and how high.
+ */
+#define ETA_ROUTE_STAIRS_SAY    160.0f   /* this near the foot: told, about 4 metres */
+#define ETA_ROUTE_STAIRS_LOOK   12       /* points ahead looked at for a climb, about 10 metres */
+#define ETA_ROUTE_STAIRS_RISE   48.0f    /* this much up or down within four steps: a climb */
+#define ETA_ROUTE_STAIRS_HEIGHT 64.0f    /* and this much in all: worth saying */
+
+static void ETA_RouteSayStairs(int nearest, int special, const vec3_t here)
+{
+	vec3_t a, b, top, delta;
+	int    i, foot = -1, end, risers = 0, slopes = 0;
+	float  climb;
+
+	for (i = nearest; i + 4 < special && i < nearest + ETA_ROUTE_STAIRS_LOOK; i++)
+	{
+		ETA_PathFinder_Point(i, a);
+		ETA_PathFinder_Point(i + 4, b);
+
+		if (fabsf(b[2] - a[2]) >= ETA_ROUTE_STAIRS_RISE)
+		{
+			foot = i;
+			break;
+		}
+	}
+
+	if (foot < 0)
+	{
+		return;
+	}
+
+	/* Up the climb until it levels off or turns back. */
+	ETA_PathFinder_Point(foot, a);
+	climb = 0.0f;
+	for (end = foot + 1; end < special; end++)
+	{
+		float step;
+
+		ETA_PathFinder_Point(end - 1, b);
+		ETA_PathFinder_Point(end, top);
+		step = top[2] - b[2];
+
+		if ((climb > 0.0f && step < -2.0f) || (climb < 0.0f && step > 2.0f))
+		{
+			break;
+		}
+		if (fabsf(step) < 0.5f && end - foot > 4)
+		{
+			/* Level for two squares: the landing. */
+			vec3_t next;
+
+			if (end + 1 >= special)
+			{
+				break;
+			}
+			ETA_PathFinder_Point(end + 1, next);
+			if (fabsf(next[2] - top[2]) < 0.5f)
+			{
+				break;
+			}
+		}
+
+		climb += step;
+		if (fabsf(step) >= 8.0f)
+		{
+			risers++;
+		}
+		else if (fabsf(step) >= 0.5f)
+		{
+			slopes++;
+		}
+	}
+	ETA_PathFinder_Point(end - 1, top);
+
+	if (fabsf(top[2] - a[2]) < ETA_ROUTE_STAIRS_HEIGHT)
+	{
+		return;
+	}
+
+	VectorSubtract(a, here, delta);
+	delta[2] = 0.0f;
+	if (VectorLength(delta) > ETA_ROUTE_STAIRS_SAY)
+	{
+		return;
+	}
+
+	/* The same flight is said once; a new search finds its foot again a
+	   square or two off. */
+	if (eta_route.saidStairs && Distance(eta_route.stairsAt, a) < 128.0f)
+	{
+		return;
+	}
+	eta_route.saidStairs = qtrue;
+	VectorCopy(a, eta_route.stairsAt);
+
+	ETA_PathFinder_Point(MIN(foot + 3, end - 1), b);
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s %s, %s, %d meters", risers >= slopes ? "Stairs" : "Ramp",
+	                  top[2] > a[2] ? "up" : "down",
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(b)),
+	                  (int)(fabsf(top[2] - a[2]) * ETA_QU_TO_METERS + 0.5f)));
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Follows the way found, if there is one: sets eta_route.steer.
+ */
+static void ETA_RouteFollow(ETA_PathState state, const vec3_t here)
+{
+	int    count = ETA_PathFinder_PointCount();
+	int    i, nearest = eta_route.along, best, special;
+	float  nearestDistance = 1.0e9f;
+	vec3_t point;
+
+	if (state != ETA_PATH_FOUND && state != ETA_PATH_PARTIAL)
+	{
+		return;
+	}
+
+	/* On a ladder the player leaves the way upward, a floor's height
+	   from its nearest point: that is the way, not a stray from it, and
+	   a new search from halfway up a ladder starts in mid air. The way
+	   is picked up again at the top. */
+	if (CG_AccessibilityClimbing())
+	{
+		return;
+	}
+
+	if (!eta_route.done)
+	{
+		/* How old the way is counts from when it was found, not from
+		   when the search began: a long search must not be thrown away
+		   the moment it finishes. */
+		eta_route.done   = qtrue;
+		eta_route.doneAt = cg.time;
+	}
+
+	/* Where along the way the player is: the nearest point, from where
+	   they were last time onward. */
+	for (i = eta_route.along; i < count; i++)
+	{
+		float distance;
+
+		ETA_PathFinder_Point(i, point);
+		distance = Distance(here, point);
+
+		if (distance < nearestDistance)
+		{
+			nearestDistance = distance;
+			nearest         = i;
+		}
+	}
+
+	if (nearestDistance > ETA_ROUTE_STRAY
+	    || cg.time - eta_route.doneAt > ETA_ROUTE_REPLAN_MS || cg.time < eta_route.doneAt
+	    || (state == ETA_PATH_PARTIAL && count - nearest < 4))
+	{
+		/* Off the way, or the way is old, or it ran out short of the
+		   marker and the player has got to its end: look again from
+		   here. The old point is kept until the new way is ready. */
+		ETA_RoutePlan();
+		return;
+	}
+
+	eta_route.along = nearest;
+
+	/* The next place the way is not a walk: a jump, or a ladder. Nothing
+	   past it is looked at, however straight the line: a ladder's top is
+	   over the wall it stands against, and a line to it leads into that
+	   wall rather than to the ladder's foot. */
+	special = count;
+	for (i = nearest + 1; i < count; i++)
+	{
+		if (ETA_PathFinder_PointKind(i) != ETA_PATH_WALK && ETA_PathFinder_PointKind(i) != ETA_PATH_CROUCH)
+		{
+			special = i;
+			break;
+		}
+	}
+
+	ETA_RouteSayJump(special, count, here);
+	ETA_RouteSayStairs(nearest, special, here);
+	ETA_RouteSayCrouch(nearest, count, here);
+
+	/* The furthest point a few steps on that can be walked to straight. */
+	best = nearest;
+	for (i = MIN(MIN(count - 1, special - 1), nearest + ETA_ROUTE_LOOKAHEAD); i > nearest; i--)
+	{
+		ETA_PathFinder_Point(i, point);
+
+		if (ETA_RouteClear(here, point))
+		{
+			best = i;
+			break;
+		}
+	}
+
+	eta_route.overEdge = qfalse;
+	eta_route.onWay    = qfalse;
+
+	if (state == ETA_PATH_FOUND && best == count - 1 && special == count)
+	{
+		/* The marker is in a straight line from the end of the way. */
+		eta_route.steering = qfalse;
+		return;
+	}
+
+	/* Off to the side of the way, with not even its nearest point in a
+	   straight line - round the corner of a rock, a step too high: the
+	   way is no longer from here. Near the Allied camp on Oasis the ping
+	   pointed on through a rock to the next point of a way the player
+	   had drifted off, and held them against it until the way was next
+	   looked for. Look for it again now, from where they are. */
+	if (best == nearest && nearestDistance > ETA_ROUTE_ON_WAY)
+	{
+		ETA_PathFinder_Point(nearest, point);
+
+		if (!ETA_RouteClear(here, point))
+		{
+			ETA_RoutePlan();
+			return;
+		}
+	}
+
+	if (best == nearest && best + 1 < count)
+	{
+		/* Nothing ahead is in a straight line - the player is past a
+		   corner the probe cannot see round, or on a stair, whose risers
+		   stop a straight line however short. The next point is still
+		   the way: the search stepped to it, square by square, the way a
+		   player walks. */
+		best++;
+		eta_route.onWay = (qboolean)(nearestDistance <= ETA_ROUTE_ON_WAY);
+	}
+
+	ETA_PathFinder_Point(best, point);
+	VectorCopy(point, eta_route.steer);
+	eta_route.steering = qtrue;
+	eta_route.overEdge = (qboolean)(best == special);
+}
+
+/**
+ * @brief Every frame: a little more searching, and where to point.
+ */
+static void ETA_RouteFrame(void)
+{
+	ETA_PathState state;
+	vec3_t        here, want, delta, angles;
+	float         distance;
+
+	if (!eta_route.planned)
+	{
+		ETA_RoutePlan();
+	}
+
+	/* By the clock, not by a count: a square costs a handful of traces,
+	   and a trace costs more on a detailed map and a slow machine. Two
+	   milliseconds a frame is searched however far that goes. */
+	{
+		int began = trap_Milliseconds();
+
+		do
+		{
+			state = ETA_PathFinder_Step(ETA_ROUTE_BUDGET_STEP,
+			                            eta_route.jumps ? ETA_RouteMove : ETA_RouteMoveOnFoot, NULL);
+		}
+		while (state == ETA_PATH_SEARCHING
+		       && trap_Milliseconds() - began < ETA_ROUTE_BUDGET_MS);
+	}
+
+	/* No way there on foot: look again, letting the way jump. */
+	if (!eta_route.jumps && (state == ETA_PATH_FAILED || state == ETA_PATH_PARTIAL))
+	{
+		ETA_RoutePlanWith(qtrue);
+		state = ETA_PathFinder_State();
+	}
+	/* No way round the mines at all: the way goes through, and the
+	   warning says where they are. */
+	else if (eta_route.jumps && !eta_route.throughMines && eta_routeAvoidCount > 0
+	         && (state == ETA_PATH_FAILED || state == ETA_PATH_PARTIAL))
+	{
+		ETA_RoutePlanWith(qtrue);
+		eta_route.throughMines = qtrue;
+		state                  = ETA_PathFinder_State();
+	}
+	/* A mine come into sight on the way already found: find it again. */
+	else if (eta_routeAvoidNew && !eta_route.throughMines && state != ETA_PATH_SEARCHING)
+	{
+		int count = ETA_PathFinder_PointCount(), i;
+
+		eta_routeAvoidNew = qfalse;
+		for (i = eta_route.along; i < count; i++)
+		{
+			float point[3];
+
+			ETA_PathFinder_Point(i, point);
+			if (ETA_RouteAvoided(point))
+			{
+				ETA_RoutePlanWith(eta_route.jumps);
+				state = ETA_PathFinder_State();
+				break;
+			}
+		}
+	}
+
+	if (state == ETA_PATH_FAILED
+	    && (cg.time - eta_route.startedAt > ETA_ROUTE_RETRY_MS || cg.time < eta_route.startedAt))
+	{
+		ETA_RoutePlan();
+	}
+
+	if (cg.time - eta_route.steeredAt < ETA_ROUTE_STEER_MS && cg.time >= eta_route.steeredAt)
+	{
+		return;
+	}
+	eta_route.steeredAt = cg.time;
+
+	VectorCopy(cg.predictedPlayerState.origin, here);
+
+	ETA_RouteFollow(state, here);
+
+	/* Where the ping wants to be: along the way, or straight at the
+	   marker. */
+	VectorCopy(eta_route.steering ? eta_route.steer : eta_marker.origin, want);
+	VectorSubtract(want, here, delta);
+	delta[2] = 0.0f;
+	distance = VectorLength(delta);
+
+	if (distance < 1.0f)
+	{
+		eta_route.aimSet = qfalse;
+		return;
+	}
+
+	/* Over a ledge, or up a ladder: there is a wall in the way, and
+	   that is the point - it is jumped, or climbed, and the ping says
+	   where. Looking for a way round it would lead away from the only
+	   way up. */
+	/* Or the next step of the way, taken from on it: a stair, a corner.
+	   Looking round for an opening here once sent the ping back down
+	   the stairs the way went up - "the way goes south-west" with the
+	   marker and the way both north-east - and the player turned round
+	   on every flight. */
+	if (eta_route.steering && (eta_route.overEdge || eta_route.onWay))
+	{
+		eta_route.aimSet = qfalse;
+		eta_route.side   = 0;
+		return;
+	}
+
+	/* Can the player walk that way, as far as it matters? Then that is
+	   where the ping goes. */
+	{
+		vec3_t ahead;
+
+		VectorMA(here, MIN(distance, ETA_ROUTE_CLEAR_AHEAD) / distance, delta, ahead);
+		ahead[2] = want[2];
+
+		if (ETA_RouteClear(here, ahead))
+		{
+			eta_route.aimSet = qfalse;
+			eta_route.side   = 0;
+			return;
+		}
+	}
+
+	/* A wall in the way: the nearest open way out instead. */
+	vectoangles(delta, angles);
+	/* Along the way, never further round than square on to it: the way
+	   is known to go on ahead, and an opening found behind the player
+	   turned them right round - "the way goes south-west" with the way
+	   and the marker both north-east. Straight at the marker, before
+	   there is a way, anywhere will do. */
+	eta_route.aimSet = ETA_RouteOpening(here, angles[YAW], eta_route.steering ? 90 : 180, eta_route.aim);
+}
+
+/**
+ * @brief Where the ping and the turn words point: the open way when the
+ * straight way is walled off, along the route when there is one, and
+ * straight at the marker when it is in plain reach.
+ */
+static void ETA_MarkerTarget(vec3_t out)
+{
+	if (eta_route.aimSet)
+	{
+		VectorCopy(eta_route.aim, out);
+	}
+	else if (eta_route.steering)
+	{
+		VectorCopy(eta_route.steer, out);
+	}
+	else
+	{
+		VectorCopy(eta_marker.origin, out);
+	}
+}
+
+/**
+ * @brief The distance to the marker, in metres.
+ *
+ * Flat for a square, which has no height of its own; straight-line for a
+ * spot, which does - a spot on the floor above is not where you are.
+ */
+static int ETA_MarkerDistance(void)
+{
+	vec3_t delta;
+
+	VectorSubtract(eta_marker.origin, cg.predictedPlayerState.origin, delta);
+
+	if (eta_marker.square)
+	{
+		delta[2] = 0.0f;
+	}
+
+	return (int)(VectorLength(delta) * ETA_QU_TO_METERS);
+}
+/**
+ * @brief Which way to turn for the marker, in the words the objective uses.
+ *
+ * The same two parts as the objective's: a turn, and then the two compass
+ * points together, because "turn left" alone never says how far round.
+ */
+static void ETA_MarkerSpeakWay(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              delta, angles, target, straight;
+	float               relativeYaw;
+	char                compass[96];
+
+	/* The turn is toward the way there, the compass point toward the
+	   marker itself: "turn right" to get round the wall, and where the
+	   marker actually lies, so the two together say it is a detour. */
+	ETA_MarkerTarget(target);
+	VectorSubtract(target, ps->origin, delta);
+	delta[2] = 0.0f;
+	vectoangles(delta, angles);
+
+	/* Written the way the objective's is, through the same call, so that
+	   tests/bearing_regression_test.py lifts this chain too and checks it
+	   against the engine's own maths. Both integrations once shipped the
+	   objective's turn mirrored; a new copy is a new chance to. */
+	relativeYaw = AngleSubtract(angles[YAW], ps->viewangles[YAW]);
+
+	if (fabsf(relativeYaw) <= 15.0f)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Marker is ahead");
+	}
+	else if (relativeYaw > 0.0f)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Turn left toward the marker");
+	}
+	else
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Turn right toward the marker");
+	}
+
+	VectorSubtract(eta_marker.origin, ps->origin, straight);
+	straight[2] = 0.0f;
+	vectoangles(straight, straight);
+
+	if (eta_route.steering || eta_route.aimSet)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection(
+			va("The way goes %s",
+			   ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(angles[YAW]))));
+	}
+
+	Com_sprintf(compass, sizeof(compass), "Marker lies %s, you are facing %s",
+	            ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(straight[YAW])),
+	            ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(ps->viewangles[YAW])));
+	ETA_NavigationSystem_AnnounceRouteCorrection(compass);
+}
+/**
+ * @brief Says where the marker is from here.
+ */
+void CG_AccessibilityMarkerWhere(void)
+{
+	ETA_Speech_BeginReport();
+
+	if (!eta_marker.active)
+	{
+		ETA_Speech_Say("No marker set");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	if (eta_marker.square)
+	{
+		char name[32];
+
+		ETA_MarkerSquareName(name, sizeof(name));
+		ETA_Speech_Say(va("Marker on %s", name));
+	}
+	else if (eta_marker.objective)
+	{
+		ETA_Speech_Say(va("Marker on %s", eta_marker.name));
+	}
+
+	ETA_NavigationSystem_AnnounceMarkerDistance(ETA_MarkerDistance());
+	if (!eta_marker.square)
+	{
+		ETA_NavigationSystem_AnnounceMarkerHeight((eta_marker.origin[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS);
+	}
+	ETA_MarkerSpeakWay();
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Takes the marker away.
+ */
+void CG_AccessibilityMarkerClear(void)
+{
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(eta_marker.active ? "Marker removed" : "No marker set");
+	ETA_Speech_EndReport();
+
+	eta_marker.active = qfalse;
+	ETA_RouteForget();
+}
+
+/**
+ * @brief Which of the marker's three sounds to play, by where it is.
+ *
+ * Left and right the game's own stereo already says; in front and
+ * behind it cannot, and a marker behind the player sounded just like one
+ * ahead - with gunfire ahead as well. The tester asked for the marker to
+ * sound different by where it is, so it does: the high ping ahead, a
+ * lower one off to either side, and a low double ping behind - turn
+ * round. A few degrees either side of each change is held, so walking
+ * along the edge between two does not swap them back and forth.
+ */
+#define ETA_MARKER_AHEAD_DEGREES  50.0f
+#define ETA_MARKER_BEHIND_DEGREES 130.0f
+#define ETA_MARKER_HOLD_DEGREES   10.0f
+
+static eta_loopSoundType_t ETA_MarkerSoundFor(const vec3_t direction)
+{
+	static eta_loopSoundType_t playing = ETA_LOOP_MARKER;
+	float                      off;
+	float                      hold;
+
+	off  = fabsf(AngleSubtract(vectoyaw(direction), cg.predictedPlayerState.viewangles[YAW]));
+	hold = ETA_MARKER_HOLD_DEGREES;
+
+	if (playing == ETA_LOOP_MARKER)
+	{
+		playing = off <= ETA_MARKER_AHEAD_DEGREES + hold ? ETA_LOOP_MARKER
+		          : off <= ETA_MARKER_BEHIND_DEGREES ? ETA_LOOP_MARKER_SIDE : ETA_LOOP_MARKER_BEHIND;
+	}
+	else if (playing == ETA_LOOP_MARKER_BEHIND)
+	{
+		playing = off >= ETA_MARKER_BEHIND_DEGREES - hold ? ETA_LOOP_MARKER_BEHIND
+		          : off > ETA_MARKER_AHEAD_DEGREES ? ETA_LOOP_MARKER_SIDE : ETA_LOOP_MARKER;
+	}
+	else
+	{
+		playing = off <= ETA_MARKER_AHEAD_DEGREES - hold ? ETA_LOOP_MARKER
+		          : off >= ETA_MARKER_BEHIND_DEGREES + hold ? ETA_LOOP_MARKER_BEHIND : ETA_LOOP_MARKER_SIDE;
+	}
+
+	return playing;
+}
+
+/**
+ * @brief Every frame: the marker's sound, and arriving at it.
+ *
+ * Neither waits behind a report the player asked for. The sound is not
+ * speech, so it takes nothing from the voice. Arriving is the end of the
+ * walk the marker exists for, and it happens once.
+ */
+void CG_AccessibilityMarkerFrame(void)
+{
+	qboolean arrived;
+	int      distance;
+
+
+	if (!eta_marker.active || !cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	distance = ETA_MarkerDistance();
+
+	/* A spot is put down where the player stands, so they start on it.
+	   Arriving only means something once they have been away. */
+	if (!eta_marker.leftIt && distance > 2.0f * ETA_MARKER_ARRIVE_METERS)
+	{
+		eta_marker.leftIt = qtrue;
+	}
+
+	if (eta_marker.square)
+	{
+		arrived = ETA_MarkerSquareUnderfoot();
+	}
+	else
+	{
+		arrived = (qboolean)(eta_marker.leftIt && distance <= ETA_MARKER_ARRIVE_METERS);
+	}
+
+	if (arrived)
+	{
+		char name[32];
+
+		ETA_Speech_BeginReport();
+
+		if (eta_marker.square)
+		{
+			ETA_MarkerSquareName(name, sizeof(name));
+			ETA_Speech_Say(va("Marker reached, %s", name));
+		}
+		else if (eta_marker.objective)
+		{
+			ETA_Speech_Say(va("Marker reached, %s", eta_marker.name));
+		}
+		else
+		{
+			ETA_Speech_Say("Marker reached");
+		}
+
+		ETA_Speech_EndReport();
+
+		eta_marker.active = qfalse;
+		ETA_RouteForget();
+		return;
+	}
+
+	ETA_RouteFrame();
+
+	if (eta_markerCues.integer)
+	{
+		vec3_t      eye, direction, origin, target;
+		sfxHandle_t sfx;
+
+		ETA_MarkerEye(eye);
+		ETA_MarkerTarget(target);
+		VectorSubtract(target, eye, direction);
+		sfx = CG_AccessibilityLoopSound(ETA_MarkerSoundFor(direction));
+
+		if (sfx)
+		{
+			float length;
+
+			/* A square has no height to point at; the sound stays level
+			   with the player's ears so it only ever says left or right. */
+			if (eta_marker.square)
+			{
+				direction[2] = 0.0f;
+			}
+
+			length = VectorNormalize(direction);
+			VectorMA(eye, MIN(length, ETA_MARKER_BEACON_DISTANCE), direction, origin);
+
+			CG_AccessibilityLoopAt(origin, sfx, CG_AccessibilityLoopVolume(ETA_LOOP_MARKER), 1000.0f);
+		}
+	}
+}
+
+/**
+ * @brief "30 meters to marker" as the player closes on it - the only
+ * distances called on the way, now the objective's are gone.
+ *
+ * Scenery rather than an answer, so it waits behind anything the player
+ * asked for.
+ */
+void CG_AccessibilityMarkerApproach(void)
+{
+	if (!eta_marker.active || !cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	/* Up or down with each distance, as the objective's own callouts
+	   once said it: the closer, the more it matters. A square has no
+	   height of its own. */
+	if (ETA_NavigationSystem_UpdateMarkerApproach(ETA_MarkerDistance()) && !eta_marker.square)
+	{
+		ETA_NavigationSystem_AnnounceMarkerHeight((eta_marker.origin[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS);
+	}
+}
+
+
+/**
+ * @brief Puts the marker on a place with a name of its own: the level's
+ *        way out.
+ */
+void CG_AccessibilityMarkerSet(const vec3_t origin, const char *name)
+{
+	memset(&eta_marker, 0, sizeof(eta_marker));
+	eta_marker.active    = qtrue;
+	eta_marker.objective = qtrue;
+	eta_marker.leftIt    = qtrue;
+	VectorCopy(origin, eta_marker.origin);
+	Q_strncpyz(eta_marker.name, name, sizeof(eta_marker.name));
+	ETA_RouteForget();
+	ETA_NavigationSystem_StartMarkerApproach(ETA_MarkerDistance());
+}
+
+/**
+ * @brief Forgets the marker, for a new map.
+ */
+void CG_AccessibilityMarkerReset(void)
+{
+	memset(&eta_marker, 0, sizeof(eta_marker));
+	ETA_RouteForget();
+}
+
+qboolean CG_AccessibilityMarkerActive(void)
+{
+	return eta_marker.active;
+}
+
+#endif
diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
new file mode 100644
index 0000000..3ebcb53
--- /dev/null
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -0,0 +1,4170 @@
+/*
+ * name:	cg_accessibility_world.c
+ *
+ * desc:	[Accessibility]: the world around the player, said and sounded,
+ *			for players who cannot see the screen. Ported from the
+ *			accessibility mode's ET: Legacy cgame by way of its No Quarter
+ *			one, where each of these was asked for by a tester playing
+ *			without sight: what is ahead and underfoot, drops and water,
+ *			what kind of place, the openings passed, the doors, ladders and
+ *			things to pick up heard where they are, the furniture named,
+ *			who is near, bumping into things, and what is around.
+ *
+ *			Only built with FEATURE_ACCESSIBILITY.
+ */
+
+#ifdef FEATURE_ACCESSIBILITY
+
+#include "cg_local.h"
+
+#include "audio/audio_cue_system.h"
+#include "hud/hud_narrator.h"
+#include "navigation/place_classifier.h"
+#include "map/bsp_ladders.h"
+#include "map/bsp_props.h"
+#include "navigation/navigation_system.h"
+#include "speech/speech_manager.h"
+
+/* No Quarter has no developer print of its own; these are for a developer. */
+#define CG_DPrintf(...) ((void)0)
+
+
+/**
+ * @brief How far ahead the look-ahead probe reaches, in Quake units.
+ *
+ * Binoculars are for looking a long way, so the zoomed range is generous -
+ * about 200 metres. Past that "nothing in range" is the honest answer and
+ * a more distant reading would not help anyone.
+ *
+ * On foot the same question has a much shorter useful answer. Seeing
+ * further is the whole point of the binoculars and the scope, and a
+ * player without either should not be told about a wall fifty metres off
+ * as though they could see it. Two and a half metres is about the point
+ * where a sighted player would notice they are walking into something.
+ */
+#define ETA_LOOK_AHEAD_RANGE 8192.0f
+#define ETA_LOOK_AHEAD_RANGE_ON_FOOT 100.0f
+
+/**
+ * @brief How much of a change is worth speaking again while zoomed.
+ *
+ * Sweeping the view across a wall should not narrate every frame, but
+ * sweeping it off the wall and onto a doorway should say so at once. The
+ * text itself is the test: a different surface, a different material or
+ * a different entity all change it, and the distance is compared
+ * separately so that closing on the same wall still reports.
+ */
+#define ETA_LOOK_AHEAD_MIN_INTERVAL 500
+#define ETA_LOOK_AHEAD_DISTANCE_STEP 5
+
+/*
+ * RTCW keeps one looping sound to an entity, by its number. The marking
+ * sounds belong to no entity of their own - a ladder is not one, and a
+ * door's or an item's number may carry its own sound - so each takes a
+ * slot of its own for the frame, counting down from just under the
+ * world's number, where the campaign's maps never reach.
+ */
+#define ETA_LOOP_SLOT_TOP   ( ENTITYNUM_WORLD - 1 )
+#define ETA_LOOP_SLOTS      48
+
+static int eta_loopSlotFrame = -1;
+static int eta_loopSlotUsed;
+
+void CG_AccessibilityLoopAt(const vec3_t origin, sfxHandle_t sfx, int volume, float range)
+{
+	if (eta_loopSlotFrame != cg.clientFrame)
+	{
+		eta_loopSlotFrame = cg.clientFrame;
+		eta_loopSlotUsed  = 0;
+	}
+	if (!sfx || volume <= 0 || eta_loopSlotUsed >= ETA_LOOP_SLOTS)
+	{
+		return;
+	}
+	trap_S_AddLoopingSound(ETA_LOOP_SLOT_TOP - eta_loopSlotUsed, origin, vec3_origin,
+	                       (int)range, sfx, volume > 255 ? 255 : volume);
+	eta_loopSlotUsed++;
+}
+
+/**
+ * @brief Names the material of a surface, from the engine's own flags.
+ *
+ * These are the flags the engine already uses to pick footstep and
+ * impact sounds, so they are the game's own idea of what a surface is
+ * made of rather than a guess of ours. A surface with none of them set
+ * gets no material word, which is why the caller composes rather than
+ * assuming one is always there.
+ *
+ * @param[in] surfaceFlags
+ * @return the material, or NULL when the engine does not say
+ */
+static const char *ETA_SurfaceMaterial(int surfaceFlags)
+{
+	if (surfaceFlags & SURF_METAL)
+	{
+		return "Metal";
+	}
+	if (surfaceFlags & SURF_WOOD)
+	{
+		return "Wooden";
+	}
+	if (surfaceFlags & SURF_GLASS)
+	{
+		return "Glass";
+	}
+	if (surfaceFlags & SURF_GRASS)
+	{
+		return "Grass";
+	}
+	if (surfaceFlags & SURF_GRAVEL)
+	{
+		return "Gravel";
+	}
+	if (surfaceFlags & SURF_SNOW)
+	{
+		return "Snow";
+	}
+	if (surfaceFlags & SURF_CARPET)
+	{
+		return "Carpet";
+	}
+	if (surfaceFlags & SURF_RUBBLE)
+	{
+		return "Rubble";
+	}
+
+	return NULL;
+}
+
+/**
+ * @brief Describes whatever the player's view runs into.
+ *
+ * The binoculars and the scope are for looking at something specific and
+ * finding out what it is. A sighted player gets that from the picture;
+ * this is the same question answered by a trace along the view, which is
+ * the only honest way to say "what is in front of me" - it reports what
+ * the engine says is there, not what the mod guesses.
+ *
+ * Orientation comes from the impact plane rather than from the surface:
+ * a normal pointing up is ground underfoot, pointing down is a ceiling,
+ * and anything between is a wall. That is what makes "wooden wall" and
+ * "gravel ground" come out right without a table of special cases.
+ *
+ * @param[out] out     description, written only when this returns qtrue
+ * @param[in]  outSize
+ * @param[out] distanceMeters set to -1 where no distance means anything
+ * @param[in]  range   how far to probe, in Quake units
+ * @param[out] outTrace optional, the probe itself, for callers that need
+ *             to know more about the hit than the words describe
+ * @return qtrue when there is something to say
+ */
+/**
+ * @brief Names whatever a finished trace ran into.
+ *
+ * Split out from the view probe below so the obstacle narration can ask
+ * the same question of a different trace. It matters that they share
+ * this: the words for a door, a person and a stone wall should not
+ * depend on which probe found them.
+ *
+ * @param[in]  trace   a completed trace that hit something
+ * @param[out] out     the name
+ * @param[in]  outSize size of out
+ */
+/**
+ * @brief The objective a thing belongs to, when one is close: its name,
+ * or NULL. Most of the map's moving and buildable parts - a wall to blow,
+ * a bridge to build, the clip round a gun nest - are an objective's.
+ */
+#define ETA_OBJECT_OBJECTIVE_UNITS 400.0f   /* about ten metres */
+
+static const char *ETA_ObjectiveNear(const vec3_t point)
+{
+	/* The campaign's objectives have no place on the map to be near. */
+	(void)point;
+	return NULL;
+}
+
+/**
+ * @brief What a thing is from its kind, when it has no name of its own.
+ *
+ * The tester heard "Object" on several maps, again and again: anything
+ * the trace met that was not a player, the map's walls or a thing with a
+ * name was called that. The game knows what most of them are - a gun
+ * nest, a cabinet, a landmine, a construction, somebody's body - and so
+ * they are said as that, with the objective they belong to where there
+ * is one. qfalse for a part of the map that is only there - a barrier, a
+ * gate's frame, the invisible clip round a construction - which the
+ * caller says as the wall or ground it is.
+ */
+static qboolean ETA_EntityKindName(const entityState_t *es, const vec3_t at, char *out, size_t outSize)
+{
+	const char *what = NULL;
+
+	(void)at;
+
+	switch (es->eType)
+	{
+	case ET_MISSILE:
+		switch (es->weapon)
+		{
+		case WP_DYNAMITE:
+			what = "Dynamite";
+			break;
+		case WP_PANZERFAUST:
+			what = "Rocket";
+			break;
+		default:
+			what = "Grenade";
+			break;
+		}
+		break;
+	case ET_MG42:
+		what = "Mounted machine gun";
+		break;
+	case ET_ALARMBOX:
+		what = "Alarm box";
+		break;
+	case ET_FLAMEBARREL:
+		what = "Barrel";
+		break;
+	case ET_FOOTLOCKER:
+		what = "Footlocker";
+		break;
+	case ET_TRAP:
+		what = "Trap";
+		break;
+	case ET_EXPLOSIVE:
+		/* A breakable: a crate, a window, a wall that gives. */
+		what = "Breakable";
+		break;
+	case ET_MOVER:
+		/* A door is named before this; a moving part with a model has
+		   its model's name. What is left is the map itself, moving. */
+		return qfalse;
+	default:
+		return qfalse;
+	}
+
+	Q_strncpyz(out, what, outSize);
+	return qtrue;
+}
+
+/* The surface a trace met, in words: "Wooden wall", "Gravel ground". */
+static void ETA_DescribeSurface(const trace_t *trace, char *out, size_t outSize)
+{
+	const char *material = ETA_SurfaceMaterial(trace->surfaceFlags);
+	const char *kind;
+
+	if (trace->surfaceFlags & SURF_LADDER)
+	{
+		kind = "ladder";
+	}
+	else if (trace->plane.normal[2] > 0.7f)
+	{
+		kind = "ground";
+	}
+	else if (trace->plane.normal[2] < -0.7f)
+	{
+		kind = "ceiling";
+	}
+	else
+	{
+		kind = "wall";
+	}
+
+	if (material)
+	{
+		Com_sprintf(out, outSize, "%s %s", material, kind);
+	}
+	else
+	{
+		/* No material word, so the surface kind carries the sentence
+		   and has to start it. */
+		Com_sprintf(out, outSize, "%c%s", toupper(kind[0]), kind + 1);
+	}
+}
+
+static const char *ETA_PropAt(const vec3_t point);
+
+static void ETA_DescribeTraceHit(const trace_t *trace, char *out, size_t outSize)
+{
+	int entityNum = trace->entityNum;
+
+	if (entityNum < MAX_CLIENTS)
+	{
+		const clientInfo_t *ci = &cgs.clientinfo[entityNum];
+
+		Q_strncpyz(out, ci->infoValid && ci->name[0] ? ci->name : "Player", outSize);
+
+		/* Which side they are on is the first thing that matters about a
+		   person at the end of a scope. */
+		Q_strcat(out, outSize,
+		         ci->team == cgs.clientinfo[cg.clientNum].team ? ", teammate" : ", enemy");
+		return;
+	}
+
+	if (entityNum != ENTITYNUM_WORLD)
+	{
+		const entityState_t *es = &cg_entities[entityNum].currentState;
+		const char          *objective;
+		char                 surface[64];
+
+		/* A named thing is its name - "Truck" at the end of the scope
+		   rather than "Object". */
+		if (CG_AccessibilityObjectName(es, out, outSize))
+		{
+			out[0] = (char)toupper(out[0]);
+			return;
+		}
+
+		if (ETA_EntityKindName(es, trace->endpos, out, outSize))
+		{
+			return;
+		}
+
+		/* The map's own structure, only built so it can move or be
+		   blown or built: said as the wall or ground it is, with the
+		   objective it is part of when there is one close by -
+		   "Old City Wall, wall" - never "Object". */
+		ETA_DescribeSurface(trace, surface, sizeof(surface));
+		objective = ETA_ObjectiveNear(trace->endpos);
+		if (objective)
+		{
+			surface[0] = (char)tolower((unsigned char)surface[0]);
+			Com_sprintf(out, outSize, "%s, %s", objective, surface);
+			out[0] = (char)toupper((unsigned char)out[0]);
+		}
+		else
+		{
+			Q_strncpyz(out, surface, outSize);
+		}
+		return;
+	}
+
+	/* Something in a room the map names - "Crate", "Bookcase" - rather
+	   than the wood it is made of. */
+	{
+		const char *prop = ETA_PropAt(trace->endpos);
+
+		if (prop)
+		{
+			Q_strncpyz(out, prop, outSize);
+			return;
+		}
+	}
+
+	ETA_DescribeSurface(trace, out, outSize);
+}
+
+static qboolean ETA_DescribeLookAhead(char *out, size_t outSize, int *distanceMeters, float range, trace_t *outTrace)
+{
+	trace_t trace;
+	vec3_t  start, end, forward;
+
+	if (!cg.snap)
+	{
+		return qfalse;
+	}
+
+	VectorCopy(cg.refdef.vieworg, start);
+	AngleVectors(cg.refdefViewAngles, forward, NULL, NULL);
+	VectorMA(start, range, forward, end);
+
+	CG_Trace(&trace, start, NULL, NULL, end, cg.snap->ps.clientNum, MASK_SHOT);
+
+	if (outTrace)
+	{
+		*outTrace = trace;
+	}
+
+	if (trace.fraction == 1.0f)
+	{
+		Q_strncpyz(out, "Nothing in range", outSize);
+		*distanceMeters = -1;
+		return qtrue;
+	}
+
+	*distanceMeters = (int)(Distance(start, trace.endpos) * ETA_QU_TO_METERS);
+
+	/* The skybox is not a thing you can walk into, and a distance to it
+	   would be the distance to the edge of the map. */
+	if (trace.surfaceFlags & SURF_SKY)
+	{
+		Q_strncpyz(out, "Open sky", outSize);
+		*distanceMeters = -1;
+		return qtrue;
+	}
+
+	ETA_DescribeTraceHit(&trace, out, outSize);
+
+	return qtrue;
+}
+
+
+/**
+ * @brief How far out the lean has to travel before it counts as leaning.
+ *
+ * `leanf` is an offset in Quake units that eases in and out over about a
+ * fifth of a second, so it spends time near zero on the way to and from
+ * cover. A bare sign test would announce a lean the instant the key went
+ * down and again the instant it came up, several times over during a
+ * quick peek. A couple of units in is far enough to mean it happened.
+ */
+#define ETA_LEAN_THRESHOLD 2.0f
+
+
+/**
+ * @brief The engine's waterlevel for the local player, worked out client side.
+ *
+ * PM_SetWaterLevel computes this every movement frame, but it lives in
+ * pmove_t and never reaches the playerstate, so the cgame cannot simply
+ * read it. What it can do is ask the same question the same way: three
+ * sample points up the player's own bounding box, each tested against
+ * the engine's own MASK_WATER.
+ *
+ * Deliberately a transcription rather than an approximation. The sample
+ * heights below are PM_SetWaterLevel's, not heights that looked about
+ * right, because every word this feature speaks - "deep water" meaning a
+ * jump will swim, "swimming" meaning falling damage is cancelled - is
+ * true only at the levels the movement code itself switches on. A copy
+ * that drifted would still sound authoritative.
+ *
+ * @return 0 dry, 1 feet, 2 waist, 3 submerged
+ */
+static int ETA_WaterLevel(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              point;
+	int                 sample1, sample2;
+
+	point[0] = ps->origin[0];
+	point[1] = ps->origin[1];
+	point[2] = ps->origin[2] + ps->mins[2] + 1;
+
+	if (!(CG_PointContents(point, ps->clientNum) & MASK_WATER))
+	{
+		return 0;
+	}
+
+	sample2 = ps->viewheight - (int)ps->mins[2];
+	sample1 = sample2 / 2;
+
+	point[2] = ps->origin[2] + ps->mins[2] + sample1;
+
+	if (!(CG_PointContents(point, ps->clientNum) & MASK_WATER))
+	{
+		return 1;
+	}
+
+	point[2] = ps->origin[2] + ps->mins[2] + sample2;
+
+	if (!(CG_PointContents(point, ps->clientNum) & MASK_WATER))
+	{
+		return 2;
+	}
+
+	return 3;
+}
+
+/**
+ * @brief How far ahead the ground is probed for a drop, in Quake units.
+ *
+ * About one stride. Far enough that the report arrives before the step
+ * that takes the player over the edge, close enough that it describes
+ * where they are actually about to be rather than the far side of the
+ * room.
+ */
+#define ETA_DROP_PROBE_DISTANCE 56.0f
+
+/**
+ * @brief The engine's own maximum step-up, from STEPSIZE in bg_local.h.
+ *
+ * Anything the player can simply walk down is not a ledge, and a stair
+ * that announced itself as one would make stairs unusable.
+ */
+#define ETA_DROP_STEP_UNITS 18.0f
+
+/**
+ * @brief The shallowest drop worth speaking, in Quake units.
+ *
+ * Comfortably more than a step, so ordinary uneven ground stays quiet.
+ */
+#define ETA_DROP_MIN_UNITS 64.0f
+
+/**
+ * @brief The engine's own falling-damage ladder, from PM_CrashLand.
+ *
+ * PM_CrashLand works out delta from the speed the player lands at and
+ * compares it against a ladder of thresholds: nothing below 38.75, and
+ * EV_FALL_NDIE - death outright - above 77. Those two numbers are the
+ * only judgement in this whole feature that is not ours, which is the
+ * point. ETA_HudNarrator_FallHeightForDelta turns each back into the
+ * height a fall has to start from, using the gravity actually in play,
+ * so a server that changes gravity changes where the warning starts.
+ */
+#define ETA_FALL_DELTA_INJURE 38.75f
+#define ETA_FALL_DELTA_DEADLY 77.0f
+
+/**
+ * @brief How long the same drop stays announced before it is news again.
+ */
+#define ETA_DROP_MIN_INTERVAL 4000
+
+/**
+ * @brief Says when the ground ahead falls away.
+ *
+ * The mod described the wall in front and the ground underfoot and had
+ * nothing to say about the one piece of terrain that kills a player who
+ * is walking in a straight line minding their own business. A sighted
+ * player never walks off a roof by accident; without this, someone
+ * playing by ear has no way not to.
+ *
+ * It probes where the player is *going* when they are moving and where
+ * they are looking when they are standing still. A hazard you are about
+ * to walk into matters more than one you happen to be looking at, and
+ * standing still is when "what is over there" is the question being
+ * asked.
+ *
+ * The bands come from the engine (see ETA_FALL_DELTA_INJURE above), not
+ * from a guess about what looks high.
+ *
+ * Water at the bottom is only ever reported for a drop that was not
+ * dangerous anyway. The engine does cancel falling damage for a player
+ * who lands submerged - but this probe cannot tell deep water from a
+ * puddle on the floor of a deep shaft, and "you can jump, there is water
+ * down there" is the one thing here that must never be said on a guess.
+ */
+static void ETA_NarrateDropAhead(void)
+{
+	static char lastDescription[64];
+	static int  lastTime;
+	char        description[64];
+
+	const playerState_t *ps;
+	trace_t             trace;
+	vec3_t              angles, forward, start, end;
+	float               footZ, drop, injure, deadly, reach, speedSq;
+	ETA_Drop            kind;
+	int                 meters;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	ps = &cg.predictedPlayerState;
+
+	/* Only from solid ground. In the air there is nothing to warn about
+	   that has not already happened, and the drop would be measured from
+	   wherever the player had fallen to by now. */
+	if (ps->groundEntityNum == ENTITYNUM_NONE)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* Already in water: how deep it is is the waterlevel narration's
+	   question, and a probe off the edge of a riverbed is noise. */
+	if (ETA_WaterLevel() > 0)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	speedSq = ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1];
+
+	if (speedSq > 40.0f * 40.0f)
+	{
+		forward[0] = ps->velocity[0];
+		forward[1] = ps->velocity[1];
+		forward[2] = 0.0f;
+		VectorNormalize(forward);
+	}
+	else
+	{
+		/* Flattened: looking down at your boots must not aim the probe
+		   into the floor, and looking up must not aim it at the sky. */
+		angles[PITCH] = 0.0f;
+		angles[YAW]   = cg.refdefViewAngles[YAW];
+		angles[ROLL]  = 0.0f;
+		AngleVectors(angles, forward, NULL, NULL);
+	}
+
+	footZ = ps->origin[2] + ps->mins[2];
+
+	/* Out from the feet, lifted by one step so a kerb does not read as a
+	   wall. */
+	VectorCopy(ps->origin, start);
+	start[2] = footZ + ETA_DROP_STEP_UNITS;
+	VectorMA(start, ETA_DROP_PROBE_DISTANCE, forward, end);
+
+	CG_Trace(&trace, start, NULL, NULL, end, ps->clientNum, MASK_PLAYERSOLID);
+
+	if (trace.fraction < 1.0f)
+	{
+		/* Something solid in the way, so there is nowhere to fall from.
+		   Whatever it is, the obstacle narration has it. */
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	injure = ETA_HudNarrator_FallHeightForDelta(ETA_FALL_DELTA_INJURE, (float)ps->gravity);
+	deadly = ETA_HudNarrator_FallHeightForDelta(ETA_FALL_DELTA_DEADLY, (float)ps->gravity);
+
+	/* Past the fatal height by a clear margin, so "deadly" and "no
+	   bottom at all" can be told apart rather than merged. */
+	reach = deadly * 2.0f + 128.0f;
+
+	VectorCopy(end, start);
+	end[2] -= reach;
+
+	CG_Trace(&trace, start, NULL, NULL, end, ps->clientNum, MASK_PLAYERSOLID);
+
+	if (trace.fraction == 1.0f)
+	{
+		kind   = ETA_DROP_DEADLY;
+		meters = -1;
+	}
+	else
+	{
+		drop = footZ - trace.endpos[2];
+
+		if (drop < ETA_DROP_MIN_UNITS)
+		{
+			lastDescription[0] = '\0';
+			return;
+		}
+
+		meters = (int)(drop * ETA_QU_TO_METERS);
+
+		if (drop >= deadly)
+		{
+			kind = ETA_DROP_DEADLY;
+		}
+		else if (drop >= injure)
+		{
+			kind = ETA_DROP_INJURING;
+		}
+		else
+		{
+			vec3_t sample;
+
+			kind = ETA_DROP_LEDGE;
+
+			/* Only for a drop that could not have hurt anyway: see the
+			   note above on why this never softens a dangerous one. */
+			VectorCopy(trace.endpos, sample);
+			sample[2] += 1.0f;
+
+			if (CG_PointContents(sample, -1) & MASK_WATER)
+			{
+				kind = ETA_DROP_WATER;
+			}
+		}
+	}
+
+	/* The classification and the rounded depth together, so stepping
+	   along an edge does not repeat itself but arriving at a different
+	   edge is announced at once. */
+	Com_sprintf(description, sizeof(description), "%d:%d", (int)kind, meters);
+
+	if (!Q_stricmp(description, lastDescription)
+	    && cg.time - lastTime < ETA_DROP_MIN_INTERVAL)
+	{
+		return;
+	}
+
+	Q_strncpyz(lastDescription, description, sizeof(lastDescription));
+	lastTime = cg.time;
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakDrop(kind, meters);
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Says how deep in water the player is, when it changes.
+ *
+ * Read straight off the engine's own waterlevel, which is what the
+ * movement code itself switches on: at 2 a jump becomes a swim, and at 3
+ * PM_WaterMove is entered and falling damage is cancelled outright. So
+ * "deep water" and "swimming" are not descriptions of how it looks, they
+ * are the levels at which the player's own movement changes under them.
+ *
+ * Predicted rather than the snapshot's, for the same reason the stance
+ * and the facing are: wading in is a local action and a round trip of
+ * lag is long enough to be felt.
+ */
+static void ETA_NarrateWater(void)
+{
+	static int spoken = -1;
+	int        level;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer)
+	{
+		spoken = -1;
+		return;
+	}
+
+	level = ETA_WaterLevel();
+
+	if (level < ETA_WATER_DRY || level > ETA_WATER_SWIMMING)
+	{
+		return;
+	}
+
+	if (level == spoken)
+	{
+		return;
+	}
+
+	/* Nothing to announce about being dry until the player has been wet:
+	   otherwise every spawn opens with "out of the water". */
+	if (spoken < 0)
+	{
+		spoken = level;
+
+		if (level == ETA_WATER_DRY)
+		{
+			return;
+		}
+	}
+
+	spoken = level;
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakWater((ETA_Water)level);
+	ETA_Speech_EndReport();
+}
+
+
+/**
+ * @brief How far up to look for sky, in Quake units.
+ *
+ * Past the tallest indoor space in the stock maps, so a high hall does
+ * not read as open air, and short enough that the trace is cheap.
+ */
+#define ETA_OVERHEAD_PROBE 2048.0f
+
+/**
+ * @brief Whether there is sky directly overhead.
+ *
+ * Only ever reports what it measured. A trace that reaches sky proves
+ * open air; anything else proves only that something is above you, and
+ * that something might be a roof, a bridge, a tunnel or an awning. So
+ * this says "under cover" rather than "indoors" - the stronger word
+ * would be a guess wearing a fact's clothes.
+ *
+ * Worth having in its own right: an airstrike or a mortar round needs
+ * open sky to come through, so this is not scenery, it is whether half
+ * the game's ordnance can reach you.
+ */
+static ETA_Overhead ETA_OverheadState(void)
+{
+	trace_t trace;
+	vec3_t  start, end;
+
+	if (!cg.snap)
+	{
+		return ETA_OVERHEAD_UNKNOWN;
+	}
+
+	VectorCopy(cg.predictedPlayerState.origin, start);
+	start[2] += cg.predictedPlayerState.viewheight;
+
+	VectorCopy(start, end);
+	end[2] += ETA_OVERHEAD_PROBE;
+
+	CG_Trace(&trace, start, NULL, NULL, end, cg.snap->ps.clientNum, MASK_SOLID);
+
+	if (trace.fraction == 1.0f || (trace.surfaceFlags & SURF_SKY))
+	{
+		return ETA_OVERHEAD_OPEN_SKY;
+	}
+
+	return ETA_OVERHEAD_COVERED;
+}
+
+
+/**
+ * @brief Says what kind of place the player has come into: a street and
+ * which way it runs, an alley, a square, a building, a balcony, a roof,
+ * a ledge (navigation/place_classifier.c).
+ *
+ * The tester asked to follow the streets and alleys and tell the parts
+ * of a building apart. Measured a few times a second while the player is
+ * on the ground; what is said is what the last few seconds agree on, so
+ * a doorway or a cart does not make a new street.
+ */
+#define ETA_PLACE_SAMPLE_MS 250
+
+static void ETA_NarratePlace(void)
+{
+	static int nextSample;
+	ETA_Place  place;
+	char       text[96];
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_placeCallouts.integer)
+	{
+		ETA_Place_Reset();
+		return;
+	}
+
+	/* In the air, or on a ladder, the floor underfoot is not a place. */
+	if (cg.predictedPlayerState.groundEntityNum == ENTITYNUM_NONE || CG_AccessibilityClimbing())
+	{
+		return;
+	}
+
+	if (cg.time < nextSample && nextSample - cg.time <= ETA_PLACE_SAMPLE_MS)
+	{
+		return;
+	}
+	nextSample = cg.time + ETA_PLACE_SAMPLE_MS;
+
+	CG_AccessibilityPlace(cg.predictedPlayerState.origin, &place);
+
+	if (ETA_Place_Update(&place, cg.time) && ETA_Place_Spoken(&place))
+	{
+		ETA_Place_Text(&place, text, sizeof(text));
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(text);
+		ETA_Speech_EndReport();
+	}
+}
+
+/**
+ * @brief How far the openings probe looks, and how often.
+ *
+ * Twelve metres: past the eight at which the library calls a side open,
+ * so an open side reads as open rather than as a wall at the edge of the
+ * probe. Ten times a second is enough for a walk and costs four traces.
+ */
+#define ETA_OPENING_PROBE_UNITS (12.0f / ETA_QU_TO_METERS)
+#define ETA_OPENING_SAMPLE_MS   100
+
+/**
+ * @brief Says when a side opens or closes as the player walks.
+ *
+ * A tester could hear a street but not where it began or where it ended,
+ * and asked for the corners by compass point. This measures how far the
+ * way runs to the north, east, south and west, at eye height and against
+ * what the player collides with, and the library decides when a change
+ * is news - held long enough not to be a doorway, and only while moving.
+ *
+ * The way the player is walking and the way behind them are left out:
+ * the wall ahead is the obstacle callout's, and a way opening behind is
+ * the way they came.
+ */
+static void ETA_NarrateOpenings(void)
+{
+	static int lastSample;
+
+	const playerState_t *ps;
+	vec3_t              eye, velocity;
+	int                 meters[ETA_OPENING_DIRECTIONS];
+	int                 opened, closed, d, moving, ignore = 0;
+	float               speedSq;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_openingCallouts.integer)
+	{
+		ETA_HudNarrator_ResetOpenings();
+		return;
+	}
+
+	ps = &cg.predictedPlayerState;
+
+	/* A ladder, water or the air: none of them is walking a street. The
+	   readings pause rather than reset - landing from a jump is not
+	   arriving somewhere new. */
+	if (ps->groundEntityNum == ENTITYNUM_NONE || (ps->pm_flags & PMF_LADDER) || ETA_WaterLevel() > 1)
+	{
+		return;
+	}
+
+	if (cg.time - lastSample < ETA_OPENING_SAMPLE_MS && cg.time >= lastSample)
+	{
+		return;
+	}
+	lastSample = cg.time;
+
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+
+	for (d = 0; d < ETA_OPENING_DIRECTIONS; d++)
+	{
+		trace_t trace;
+		vec3_t  angles, forward, end;
+
+		/* North, east, south, west: compass bearing d * 90, and ET's yaw
+		   puts north at 90 and runs the other way. */
+		VectorSet(angles, 0.0f, 90.0f - 90.0f * (float)d, 0.0f);
+		AngleVectors(angles, forward, NULL, NULL);
+		VectorMA(eye, ETA_OPENING_PROBE_UNITS, forward, end);
+
+		CG_Trace(&trace, eye, NULL, NULL, end, ps->clientNum, MASK_PLAYERSOLID);
+
+		meters[d] = trace.fraction >= 1.0f ? -1
+		            : (int)(trace.fraction * ETA_OPENING_PROBE_UNITS * ETA_QU_TO_METERS);
+	}
+
+	VectorSet(velocity, ps->velocity[0], ps->velocity[1], 0.0f);
+	speedSq = DotProduct(velocity, velocity);
+	moving  = speedSq > 40.0f * 40.0f;
+
+	if (moving)
+	{
+		/* The compass side nearest the way of travel, and its opposite. */
+		int ahead = ((int)(ETA_HudNarrator_BearingFromYaw(vectoyaw(velocity)) / 90.0f + 0.5f)) & 3;
+
+		ignore = (1 << ahead) | (1 << ((ahead + 2) & 3));
+	}
+
+	if (ETA_HudNarrator_UpdateOpenings(meters, moving, cg.time, &opened, &closed))
+	{
+		opened &= ~ignore;
+		closed &= ~ignore;
+
+		if (opened || closed)
+		{
+			ETA_Speech_BeginReport();
+			ETA_HudNarrator_SpeakOpenings(opened, closed);
+			ETA_Speech_EndReport();
+		}
+	}
+}
+
+/**
+ * @brief Speaks where the player is, into an already-open report.
+ *
+ * The status key's job is to answer everything at once, so it does not
+ * wait for the two-second settle the passive announcement uses - being
+ * asked is itself the evidence that the player wants to know now.
+ */
+void CG_AccessibilitySpeakLocation(void)
+{
+	/* The campaign's maps name no places: only whether it is open sky. */
+	ETA_HudNarrator_SpeakOverhead(ETA_OverheadState());
+}
+
+/**
+ * @brief How far a door can be heard, in Quake units. About ten metres.
+ *
+ * Short on purpose. A beacon on every door on the map would be a wall of
+ * creaking; this is meant to answer "what is near me", not "what exists".
+ */
+#define ETA_DOOR_CUE_RANGE 400.0f
+
+/**
+ * @brief Whether a cursor-hint value names a door.
+ *
+ * The server stamps the hint onto the entity itself and it is replicated
+ * to every client, so this is the engine's own classification rather than
+ * a guess from the entity type - which matters, because ET_MOVER also
+ * covers lifts, tank barriers and movable bridges, and calling one of
+ * those a door would send a player to a wall.
+ */
+static qboolean ETA_HintIsDoor(int hint)
+{
+	return (qboolean)(hint == HINT_DOOR || hint == HINT_DOOR_ROTATING
+	                  || hint == HINT_DOOR_LOCKED || hint == HINT_DOOR_ROTATING_LOCKED);
+}
+
+static qboolean ETA_HintIsLockedDoor(int hint)
+{
+	return (qboolean)(hint == HINT_DOOR_LOCKED || hint == HINT_DOOR_ROTATING_LOCKED);
+}
+
+/**
+ * @brief Puts a creak on every door within earshot.
+ *
+ * Speech is an event: miss it and it is gone. A door is not an event, it
+ * is a thing that is still there - so it gets a sound that is still
+ * there too, positioned in the world, which the engine swings around the
+ * player's head as they turn. Turn toward it and it centres. That is
+ * navigation; an announcement is not.
+ *
+ * Locked doors creak differently, and that is the useful half: hearing
+ * that a door will not open saves the walk to it.
+ *
+ * dmgFlags is overloaded - on players it carries damage information, and
+ * on a speaker it is a sound range - so the entity type is checked first.
+ * Reading it off the wrong kind of entity would produce doors that are
+ * not there, silently and only on some maps.
+ */
+static void ETA_BeaconDoors(void)
+{
+	int i;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_doorCues.integer)
+	{
+		return;
+	}
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		entityState_t *es = &cg.snap->entities[i];
+		centity_t     *cent;
+		sfxHandle_t   sfx;
+		vec3_t        origin;
+		qboolean      locked;
+		qboolean      opens;
+
+		if (es->eType != ET_MOVER)
+		{
+			continue;
+		}
+
+		if (ETA_HintIsDoor(es->dmgFlags))
+		{
+			locked = ETA_HintIsLockedDoor(es->dmgFlags);
+		}
+		else if (es->solid == SOLID_BMODEL
+		         && CG_AccessibilityDoorModel(es->modelindex, &opens))
+		{
+			/* A team door: the server leaves these unstamped, so they
+			   come from the map's own list, and "locked" means what it
+			   means in play - this player's team cannot open it. */
+			locked = (qboolean)!opens;
+		}
+		else
+		{
+			continue;
+		}
+
+		cent = &cg_entities[es->number];
+
+		/* A door is a brush model, and a brush model's origin is not
+		   where it is - the engine keeps the real midpoint of each
+		   inline model for exactly this reason, and uses it itself when
+		   positioning a mover's own sounds. */
+		if (es->solid == SOLID_BMODEL && es->modelindex < MAX_MODELS)
+		{
+			VectorAdd(cent->lerpOrigin, cgs.inlineModelMidpoints[es->modelindex], origin);
+		}
+		else
+		{
+			VectorCopy(cent->lerpOrigin, origin);
+		}
+
+		if (Distance(cg.predictedPlayerState.origin, origin) > ETA_DOOR_CUE_RANGE)
+		{
+			continue;
+		}
+
+		sfx = CG_AccessibilityLoopSound(locked ? ETA_LOOP_DOOR_LOCKED : ETA_LOOP_DOOR);
+
+		if (sfx)
+		{
+			CG_AccessibilityLoopAt(origin, sfx, CG_AccessibilityLoopVolume(locked ? ETA_LOOP_DOOR_LOCKED : ETA_LOOP_DOOR),
+			           ETA_DOOR_CUE_RANGE * 2.0f);
+		}
+	}
+}
+
+/**
+ * @brief How far a construction site or a demolition target can be
+ *        heard, in Quake units. About twenty-five metres.
+ *
+ * Further than a door: an objective is what a whole stretch of the map
+ * is about, and the walk toward one starts well before it is in reach.
+ * Still a neighbourhood rather than the map - the objective direction
+ * cue and the map survey answer "where are the objectives at all".
+ */
+#define ETA_SITE_CUE_RANGE 1000.0f
+
+
+
+/**
+ * @brief Every ladder on the map, from the map file.
+ *
+ * A ladder is not an entity, so no snapshot ever says one is there: the
+ * game finds it only by tracing into it from right in front, and so did
+ * the mod. That is enough to climb one, and no help finding it - a
+ * tester at the top of the Oasis tunnels knew there was a ladder down
+ * and nothing about where. The map file lists every brush, and which
+ * of them are ladders, so it is read once as the map loads
+ * (bsp_ladders.c) and the boxes are kept for the sound below and the
+ * command map survey.
+ *
+ * The file is the one the engine has just loaded the collision map
+ * from, read through the same file system - the pak the server named,
+ * so a pure server sees exactly what the game is using.
+ */
+#define ETA_MAP_LADDERS 128
+
+static ETA_BspLadder eta_mapLadders[ETA_MAP_LADDERS];
+static int           eta_mapLadderCount;
+
+typedef struct
+{
+	fileHandle_t handle;
+	int          left;
+} etaMapFile_t;
+
+static int ETA_MapFileRead(void *context, void *buffer, int length)
+{
+	etaMapFile_t *file = (etaMapFile_t *)context;
+
+	if (length > file->left)
+	{
+		length = file->left;
+	}
+	if (length <= 0 || !file->handle)
+	{
+		return 0;
+	}
+
+	trap_FS_Read(buffer, length, file->handle);
+	file->left -= length;
+	return length;
+}
+
+static int ETA_MapFileRestart(void *context)
+{
+	etaMapFile_t *file = (etaMapFile_t *)context;
+
+	if (file->handle)
+	{
+		trap_FS_FCloseFile(file->handle);
+		file->handle = 0;
+	}
+
+	file->left = trap_FS_FOpenFile(cgs.mapname, &file->handle, FS_READ);
+	return file->left > 0 && file->handle;
+}
+
+/**
+ * @brief A floor a player could stand on, looking down from a point.
+ *
+ * The body is the route probe's (cg_commandmap.c), so the height found
+ * is the one the way is searched at: the player's origin, standing.
+ */
+static qboolean ETA_LadderFloor(vec3_t point, float drop)
+{
+	static const vec3_t mins = { -12.0f, -12.0f, -24.0f };
+	static const vec3_t maxs = { 12.0f, 12.0f, 24.0f };
+	trace_t trace;
+	vec3_t  end;
+
+	VectorCopy(point, end);
+	end[2] -= drop;
+	trap_CM_BoxTrace(&trace, point, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid || trace.allsolid || trace.fraction >= 1.0f || trace.plane.normal[2] < 0.7f)
+	{
+		return qfalse;
+	}
+
+	VectorCopy(trace.endpos, point);
+	return qtrue;
+}
+
+/**
+ * @brief Each ladder's foot and top, handed to the way-finder as links.
+ *
+ * The way to somewhere on a floor above can go up a ladder only if the
+ * search knows where the ladder starts and where it lets the player off.
+ * The foot is in front of the climbing face, on the floor near the
+ * ladder's bottom. The top is over the ladder's head, on the floor the
+ * ladder reaches - usually beyond the wall it stands against, sometimes
+ * on its own side, at a hatch. A ladder painted on every face does not
+ * say which face is climbed, so both are tried. A ladder whose foot or
+ * top has no floor - one that ends in mid air - joins nothing.
+ */
+static void ETA_LadderLinks(void)
+{
+	int i, linked = 0;
+
+	ETA_PathFinder_ClearLinks();
+
+	for (i = 0; i < eta_mapLadderCount; i++)
+	{
+		const ETA_BspLadder *ladder = &eta_mapLadders[i];
+		int                 axis    = Q_fabs(ladder->normal[0]) > 0.5f ? 0 : 1;
+		float               half    = (ladder->maxs[axis] - ladder->mins[axis]) * 0.5f;
+		vec3_t              centre;
+		int                 side;
+
+		VectorAdd(ladder->mins, ladder->maxs, centre);
+		VectorScale(centre, 0.5f, centre);
+
+		for (side = 0; side < (ladder->oneFace ? 1 : 2); side++)
+		{
+			float  sign = side ? -1.0f : 1.0f;
+			vec3_t face, foot, top;
+			int    exit;
+			float  reach;
+			qboolean found = qfalse;
+
+			VectorScale(ladder->normal, sign, face);
+
+			VectorMA(centre, half + 16.0f, face, foot);
+			foot[2] = ladder->mins[2] + 24.0f + 8.0f;
+
+			if (!ETA_LadderFloor(foot, 56.0f))
+			{
+				continue;
+			}
+
+			/* Over the head, then on the same side. */
+			for (exit = 0; exit < 2 && !found; exit++)
+			{
+				for (reach = 24.0f; reach <= 56.0f && !found; reach += 16.0f)
+				{
+					VectorMA(centre, (exit ? 1.0f : -1.0f) * (half + reach), face, top);
+					top[2] = ladder->maxs[2] + 24.0f + 8.0f;
+
+					found = (qboolean)(ETA_LadderFloor(top, 48.0f)
+					                   && top[2] >= ladder->maxs[2] - 8.0f
+					                   && top[2] - foot[2] >= 48.0f);
+				}
+			}
+
+			if (found)
+			{
+				ETA_PathFinder_AddLink(foot, top, ETA_PATH_LADDER_UP);
+				ETA_PathFinder_AddLink(top, foot, ETA_PATH_LADDER_DOWN);
+				linked++;
+				break;
+			}
+		}
+	}
+
+	CG_DPrintf("accessibility: %d of %d ladder(s) join two floors for the way-finder\n",
+	           linked, eta_mapLadderCount);
+}
+
+void CG_AccessibilityLoadLadders(void)
+{
+	etaMapFile_t file;
+
+	eta_mapLadderCount = 0;
+	file.handle        = 0;
+
+	if (ETA_MapFileRestart(&file))
+	{
+		eta_mapLadderCount = ETA_BspLadders_Find(ETA_MapFileRead, ETA_MapFileRestart, &file,
+		                                         eta_mapLadders, ETA_MAP_LADDERS);
+	}
+
+	if (file.handle)
+	{
+		trap_FS_FCloseFile(file.handle);
+	}
+
+	CG_DPrintf("accessibility: %d ladder(s) in %s\n", eta_mapLadderCount, cgs.mapname);
+
+	ETA_LadderLinks();
+}
+
+int CG_AccessibilityLadderCount(void)
+{
+	return eta_mapLadderCount;
+}
+
+qboolean CG_AccessibilityMapLadder(int index, vec3_t mins, vec3_t maxs)
+{
+	if (index < 0 || index >= eta_mapLadderCount)
+	{
+		return qfalse;
+	}
+
+	VectorCopy(eta_mapLadders[index].mins, mins);
+	VectorCopy(eta_mapLadders[index].maxs, maxs);
+	return qtrue;
+}
+
+/**
+ * @brief The furniture and the things in a room, read from the map file
+ * while it loads: see map/bsp_props.h.
+ */
+#define ETA_MAP_PROPS 1024
+
+static ETA_BspProp   eta_mapProps[ETA_MAP_PROPS];
+static int           eta_mapPropCount;
+static unsigned char eta_mapPropSaid[ETA_MAP_PROPS];
+
+void CG_AccessibilityLoadProps(void)
+{
+	etaMapFile_t file;
+
+	eta_mapPropCount = 0;
+	memset(eta_mapPropSaid, 0, sizeof(eta_mapPropSaid));
+	file.handle = 0;
+
+	if (ETA_MapFileRestart(&file))
+	{
+		eta_mapPropCount = ETA_BspProps_Find(ETA_MapFileRead, ETA_MapFileRestart, &file,
+		                                     eta_mapProps, ETA_MAP_PROPS);
+	}
+
+	if (file.handle)
+	{
+		trap_FS_FCloseFile(file.handle);
+	}
+
+	CG_DPrintf("accessibility: %d thing(s) in the rooms of %s\n", eta_mapPropCount, cgs.mapname);
+}
+
+/* The thing a point is on, NULL for none: a trace's end on its surface
+   lands at its box, give or take - and walking into it, the player's
+   own box stops half its width short. */
+#define ETA_PROP_ON 20.0f
+
+static const char *ETA_PropAt(const vec3_t point)
+{
+	int i;
+
+	for (i = 0; i < eta_mapPropCount; i++)
+	{
+		const ETA_BspProp *prop = &eta_mapProps[i];
+
+		if (point[0] >= prop->mins[0] - ETA_PROP_ON && point[0] <= prop->maxs[0] + ETA_PROP_ON
+		    && point[1] >= prop->mins[1] - ETA_PROP_ON && point[1] <= prop->maxs[1] + ETA_PROP_ON
+		    && point[2] >= prop->mins[2] - ETA_PROP_ON && point[2] <= prop->maxs[2] + ETA_PROP_ON)
+		{
+			return prop->name;
+		}
+	}
+
+	return NULL;
+}
+
+/**
+ * @brief "Armchair, ahead left" as the player comes up to it.
+ *
+ * The tester asked to hear the table, the chair, the bookcase when
+ * getting close to one. Said once a thing is within about a metre and a
+ * half of the player, on their floor and in sight - a chair in the next
+ * room is not news - and again only after they have walked a few metres
+ * off and come back. A window is said only from inside: walking down a
+ * street, every house front has them. Two of the same side by side, a
+ * pair of chairs, are said once. Scenery, so it waits behind anything
+ * the player asked for.
+ */
+#define ETA_PROP_NEAR   60.0f    /* said within this of its box, about a metre and a half */
+#define ETA_PROP_REARM  160.0f   /* and again once the player has been this far off */
+#define ETA_PROP_EVERY  1200     /* ms between two of them */
+#define ETA_PROP_PAIR   96.0f    /* one of the same this close is said with it */
+
+static float ETA_PropFlatDistance(const ETA_BspProp *prop, const vec3_t at)
+{
+	float dx = at[0] < prop->mins[0] ? prop->mins[0] - at[0] : at[0] > prop->maxs[0] ? at[0] - prop->maxs[0] : 0.0f;
+	float dy = at[1] < prop->mins[1] ? prop->mins[1] - at[1] : at[1] > prop->maxs[1] ? at[1] - prop->maxs[1] : 0.0f;
+
+	return sqrt(dx * dx + dy * dy);
+}
+
+static void ETA_NarrateFurniture(void)
+{
+	static int          lastTime;
+	const playerState_t *ps = &cg.predictedPlayerState;
+	const ETA_BspProp   *prop;
+	vec3_t              eye, closest, center;
+	trace_t             trace;
+	float               feet, head, bestDistance = ETA_PROP_NEAR;
+	int                 i, best = -1, a;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || !eta_furnitureCallouts.integer || eta_mapPropCount <= 0)
+	{
+		return;
+	}
+
+	feet = ps->origin[2] - 24.0f;
+	head = ps->origin[2] + 48.0f;
+
+	for (i = 0; i < eta_mapPropCount; i++)
+	{
+		float distance;
+
+		prop     = &eta_mapProps[i];
+		distance = ETA_PropFlatDistance(prop, ps->origin);
+
+		if (distance > ETA_PROP_REARM || prop->maxs[2] < feet - 8.0f || prop->mins[2] > head + 16.0f)
+		{
+			eta_mapPropSaid[i] = 0;
+			continue;
+		}
+
+		if (!eta_mapPropSaid[i] && distance <= bestDistance)
+		{
+			bestDistance = distance;
+			best         = i;
+		}
+	}
+
+	if (best < 0 || cg.time - lastTime < ETA_PROP_EVERY)
+	{
+		return;
+	}
+
+	prop = &eta_mapProps[best];
+
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+
+	/* From outside, every house front has windows. */
+	if (!Q_stricmp(prop->name, "Window"))
+	{
+		vec3_t up;
+
+		VectorSet(up, eye[0], eye[1], eye[2] + 2048.0f);
+		CG_Trace(&trace, eye, NULL, NULL, up, cg.snap->ps.clientNum, MASK_SOLID);
+		if (trace.fraction >= 1.0f || (trace.surfaceFlags & SURF_SKY))
+		{
+			eta_mapPropSaid[best] = 1;
+			return;
+		}
+	}
+
+	/* In sight: nothing solid between the eyes and the nearest of it. */
+	for (a = 0; a < 3; a++)
+	{
+		closest[a] = eye[a] < prop->mins[a] ? prop->mins[a] : eye[a] > prop->maxs[a] ? prop->maxs[a] : eye[a];
+		center[a]  = (prop->mins[a] + prop->maxs[a]) * 0.5f;
+	}
+	CG_Trace(&trace, eye, NULL, NULL, closest, cg.snap->ps.clientNum, MASK_SOLID);
+	if (trace.fraction < 1.0f && Distance(trace.endpos, closest) > 16.0f)
+	{
+		return;
+	}
+
+	lastTime = cg.time;
+	for (i = 0; i < eta_mapPropCount; i++)
+	{
+		if (i == best || (!Q_stricmp(eta_mapProps[i].name, prop->name)
+		                  && ETA_PropFlatDistance(&eta_mapProps[i], center) <= ETA_PROP_PAIR))
+		{
+			eta_mapPropSaid[i] = 1;
+		}
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s, %s", prop->name,
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(center))));
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief How far a ladder is heard, in Quake units: about fifteen metres.
+ *
+ * Nearer than the objectives, because a ladder is a way through the
+ * building rather than somewhere to go, and there are more of them; and
+ * only the nearest ETA_LADDER_CUES_AT_ONCE play, so a room with a ladder
+ * in each corner does not knock from all four.
+ */
+#define ETA_LADDER_CUE_RANGE    600.0f
+#define ETA_LADDER_CUES_AT_ONCE 2
+
+/**
+ * @brief Knocks from the nearest ladders, placed on the ladder itself.
+ *
+ * Each plays from the point on the ladder nearest the player - level
+ * with them on a ladder up a wall, at the top of one going down a
+ * shaft - so it is where to walk to, and F climbs once there. Like the
+ * doors, a ladder is part of the building and is heard through walls:
+ * it says what is there, and the walk is the player's. Silent while
+ * climbing, when the player is already on it.
+ */
+static void ETA_BeaconLadders(void)
+{
+	vec3_t      points[ETA_LADDER_CUES_AT_ONCE];
+	float       ranges[ETA_LADDER_CUES_AT_ONCE];
+	int         used = 0;
+	int         i, j, k;
+	sfxHandle_t sfx;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_ladderCues.integer
+	    || CG_AccessibilityClimbing())
+	{
+		return;
+	}
+
+	for (i = 0; i < eta_mapLadderCount; i++)
+	{
+		const ETA_BspLadder *ladder = &eta_mapLadders[i];
+		const float         *eye    = cg.predictedPlayerState.origin;
+		vec3_t              point;
+		float               range;
+
+		for (k = 0; k < 3; k++)
+		{
+			point[k] = eye[k] < ladder->mins[k] ? ladder->mins[k]
+			           : eye[k] > ladder->maxs[k] ? ladder->maxs[k] : eye[k];
+		}
+
+		range = Distance(eye, point);
+		if (range > ETA_LADDER_CUE_RANGE)
+		{
+			continue;
+		}
+
+		/* kept nearest first */
+		for (j = used; j > 0 && ranges[j - 1] > range; j--)
+		{
+			if (j < ETA_LADDER_CUES_AT_ONCE)
+			{
+				ranges[j] = ranges[j - 1];
+				VectorCopy(points[j - 1], points[j]);
+			}
+		}
+		if (j < ETA_LADDER_CUES_AT_ONCE)
+		{
+			ranges[j] = range;
+			VectorCopy(point, points[j]);
+			if (used < ETA_LADDER_CUES_AT_ONCE)
+			{
+				used++;
+			}
+		}
+	}
+
+	sfx = used ? CG_AccessibilityLoopSound(ETA_LOOP_LADDER) : 0;
+
+	for (i = 0; sfx && i < used; i++)
+	{
+		CG_AccessibilityLoopAt(points[i], sfx, CG_AccessibilityLoopVolume(ETA_LOOP_LADDER), 800.0f);
+	}
+}
+
+/**
+ * @brief A spoken name from a model's file name.
+ *
+ * A sighted player sees a truck; the game only knows a file called
+ * truck_base.md3. The file names are the map makers' own words for what
+ * they placed, so they are the honest source - a handful of common ones
+ * are turned into the word a person would use, and anything else is read
+ * as its file name without the path, the extension or the underscores.
+ */
+static void ETA_NameFromModelPath(const char *path, char *out, size_t outSize)
+{
+	static const struct
+	{
+		const char *fragment;
+		const char *name;
+	} known[] =
+	{
+		{ "tank_trap",   "tank trap"      },
+		{ "tanktrap",    "tank trap"      },
+		{ "truck",       "truck"          },
+		{ "tank",        "tank"           },
+		{ "health",      "health cabinet" },
+		{ "ammo",        "ammo cabinet"   },
+		{ "hiback",      "high-backed chair" },
+		{ "armchair",    "armchair"       },
+		{ "chair",       "chair"          },
+		{ "stool",       "stool"          },
+		{ "sofa",        "sofa"           },
+		{ "couch",       "sofa"           },
+		{ "bookcase",    "bookcase"       },
+		{ "cabinet",     "cabinet"        },
+		{ "piano",       "piano"          },
+		{ "clock",       "clock"          },
+		{ "phone",       "telephone"      },
+		{ "typewriter",  "typewriter"     },
+		{ "candle",      "candle"         },
+		{ "bottle",      "bottle"         },
+		{ "table",       "table"          },
+		{ "desk",        "desk"           },
+		{ "bench",       "bench"          },
+		{ "bed",         "bed"            },
+		{ "shelf",       "shelf"          },
+		{ "crate",       "crate"          },
+		{ "barrel",      "barrel"         },
+		{ "sandbag",     "sandbags"       },
+		{ "radio",       "radio"          },
+		{ "flag",        "flag"           },
+		{ "boat",        "boat"           },
+		{ "train",       "train"          },
+		{ "gate",        "gate"           },
+		{ "lamp",        "lamp"           },
+	};
+	const char *start = strrchr(path, '/');
+	char       base[MAX_QPATH];
+	size_t     i, length;
+
+	COM_StripExtension(start ? start + 1 : path, base, sizeof(base));
+	Q_strlwr(base);
+
+	for (i = 0; i < sizeof(known) / sizeof(known[0]); i++)
+	{
+		if (strstr(base, known[i].fragment))
+		{
+			Q_strncpyz(out, known[i].name, outSize);
+			return;
+		}
+	}
+
+	for (i = 0; base[i]; i++)
+	{
+		if (base[i] == '_' || base[i] == '-')
+		{
+			base[i] = ' ';
+		}
+	}
+
+	/* "crate2", "wall_03": a number that only tells copies apart. */
+	length = strlen(base);
+	while (length > 0 && (base[length - 1] == ' ' || (base[length - 1] >= '0' && base[length - 1] <= '9')))
+	{
+		base[--length] = '\0';
+	}
+
+	Q_strncpyz(out, base, outSize);
+}
+
+/**
+ * @brief What an entity is, in words - or qfalse when there is no honest name.
+ *
+ * The engine's own classification first where it has one - a pickup's
+ * name, the chair and door hints - and the model file after that. Nothing
+ * is guessed from shape: a thing with no name is left out rather than
+ * called something it might not be.
+ */
+qboolean CG_AccessibilityObjectName(const entityState_t *es, char *out, size_t outSize)
+{
+	int      index;
+	qboolean opens;
+
+	out[0] = '\0';
+
+	switch (es->eType)
+	{
+	case ET_ITEM:
+	{
+		gitem_t *item = (&bg_itemlist[es->modelindex]);
+
+		if (item && item->pickup_name && item->pickup_name[0])
+		{
+			Q_strncpyz(out, item->pickup_name, outSize);
+			return qtrue;
+		}
+		return qfalse;
+	}
+	case ET_MOVER:
+		if (es->dmgFlags == HINT_CHAIR)
+		{
+			Q_strncpyz(out, "chair", outSize);
+			return qtrue;
+		}
+		if (ETA_HintIsDoor(es->dmgFlags)
+		    || (es->solid == SOLID_BMODEL && CG_AccessibilityDoorModel(es->modelindex, &opens)))
+		{
+			Q_strncpyz(out, "door", outSize);
+			return qtrue;
+		}
+		break;
+	case ET_GENERAL:
+	case ET_GAMEMODEL:
+	case ET_PROP:
+		break;
+	default:
+		return qfalse;
+	}
+
+	/* A brush entity draws its model from the second slot; anything else
+	   from the first. */
+	index = (es->solid == SOLID_BMODEL) ? es->modelindex2 : es->modelindex;
+
+	if (index > 0 && index < MAX_MODELS)
+	{
+		const char *path = CG_ConfigString(CS_MODELS + index);
+
+		if (path && path[0] && path[0] != '*')
+		{
+			ETA_NameFromModelPath(path, out, outSize);
+			return (qboolean)(out[0] != '\0');
+		}
+	}
+
+	return qfalse;
+}
+
+/**
+ * @brief How far "what is around me" looks, and what it lists.
+ *
+ * Fifty metres is further than any room and most streets, so a trace
+ * that gets there is an open way rather than a wall. Eight metres is the
+ * line between the two: past it a direction is somewhere you could go.
+ */
+#define ETA_SURROUND_RANGE        2048.0f
+#define ETA_SURROUND_OPEN_METERS  8
+#define ETA_SURROUND_WINDOW_METERS 15
+#define ETA_SURROUND_OBJECT_RANGE 800.0f
+#define ETA_SURROUND_MAX_OBJECTS  6
+
+typedef struct
+{
+	char  name[64];
+	vec3_t origin;
+	float distance;
+	int   entityNum;    /* -1 for a static model */
+} eta_nearby_t;
+
+static void ETA_SurroundAddNearby(eta_nearby_t *list, int *count, int max,
+                                  const char *name, const vec3_t origin, int entityNum)
+{
+	float distance = Distance(cg.predictedPlayerState.origin, origin);
+	int   i, at;
+
+	if (distance > ETA_SURROUND_OBJECT_RANGE)
+	{
+		return;
+	}
+
+	/* Two halves of a double door, a stack of crates: one mention. */
+	for (i = 0; i < *count; i++)
+	{
+		if (!Q_stricmp(list[i].name, name) && Distance(list[i].origin, origin) < 150.0f)
+		{
+			return;
+		}
+	}
+
+	/* Nearest first; the list is short. */
+	for (at = *count; at > 0 && list[at - 1].distance > distance; at--)
+	{
+		if (at < max)
+		{
+			list[at] = list[at - 1];
+		}
+	}
+
+	if (at >= max)
+	{
+		return;
+	}
+
+	Q_strncpyz(list[at].name, name, sizeof(list[at].name));
+	VectorCopy(origin, list[at].origin);
+	list[at].distance  = distance;
+	list[at].entityNum = entityNum;
+
+	if (*count < max)
+	{
+		(*count)++;
+	}
+}
+
+/**
+ * @brief Whether a character is against the player: on a side of its
+ * own that is not the player's and not neutral. The side rides in the
+ * entity's teamNum, as the game set it (AITEAM_NAZI, AITEAM_ALLIES, the
+ * monsters); the player is with the Allies.
+ */
+#define ETA_AITEAM_NEUTRAL 7
+
+static qboolean ETA_SeenAsEnemy(const entityState_t *es)
+{
+	return (qboolean)(es->teamNum != cg.snap->ps.teamNum && es->teamNum != ETA_AITEAM_NEUTRAL);
+}
+
+/* What a character is, by the kind the game made it. */
+static const char *ETA_CharacterKind(const entityState_t *es)
+{
+	switch (es->aiChar)
+	{
+	case AICHAR_SOLDIER:       return "Soldier";
+	case AICHAR_AMERICAN:      return "American";
+	case AICHAR_ZOMBIE:        return "Zombie";
+	case AICHAR_WARZOMBIE:     return "Zombie warrior";
+	case AICHAR_VENOM:         return "Venom soldier";
+	case AICHAR_LOPER:         return "Loper";
+	case AICHAR_ELITEGUARD:    return "Elite guard";
+	case AICHAR_STIMSOLDIER1:
+	case AICHAR_STIMSOLDIER2:
+	case AICHAR_STIMSOLDIER3:  return "Stim soldier";
+	case AICHAR_SUPERSOLDIER:  return "Super soldier";
+	case AICHAR_BLACKGUARD:    return "Black guard";
+	case AICHAR_PROTOSOLDIER:  return "Proto soldier";
+	case AICHAR_FROGMAN:       return "Frogman";
+	case AICHAR_HELGA:         return "Helga";
+	case AICHAR_HEINRICH:      return "Heinrich";
+	case AICHAR_PARTISAN:      return "Partisan";
+	case AICHAR_CIVILIAN:      return "Civilian";
+	default:                   return "Someone";
+	}
+}
+
+/**
+ * @brief Whether nothing solid stands between the eye and a point - the
+ * same test sight makes. Players, bodies and items do not block it.
+ */
+static qboolean ETA_ClearLine(const vec3_t eye, const vec3_t point)
+{
+	trace_t trace;
+
+	CG_Trace(&trace, eye, NULL, NULL, point, cg.snap->ps.clientNum, MASK_SOLID);
+
+	return (qboolean)(trace.fraction >= 1.0f);
+}
+
+/**
+ * @brief Who and what is near the player, as far as they could know it.
+ *
+ * What goes in is held to what a sighted player has:
+ *
+ *   - an enemy only in clear sight - nothing solid in the way of their
+ *     head or body - and only in front, within the view, unless they are
+ *     close enough to hear. Never through a wall; the snapshot carries
+ *     enemies the player cannot see, and this does not use them;
+ *   - teammates and wounded teammates wherever they are, because the
+ *     compass and the command map already show them;
+ *   - an enemy down, and things on the ground, in clear sight;
+ *   - an enemy body with its uniform still on, only to a covert op, the
+ *     one class that can take it.
+ *
+ * Things are listed out to a little past where they stop being news, so
+ * an enemy leaving is heard leaving rather than vanishing.
+ */
+static int ETA_GatherAwareness(ETA_AwareThing *list, int max, qboolean players, qboolean ground)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              eye;
+	float               halfView;
+	int                 i, count = 0;
+
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+
+	halfView = cg.refdef.fov_x * 0.5f + 10.0f;
+
+	for (i = 0; i < cg.snap->numEntities && count < max; i++)
+	{
+		const entityState_t *es   = &cg.snap->entities[i];
+		const centity_t     *cent = &cg_entities[es->number];
+		ETA_AwareThing      thing;
+		vec3_t              delta, low, high;
+		float               meters, reach;
+
+		memset(&thing, 0, sizeof(thing));
+		thing.id = es->number;
+
+		VectorSubtract(cent->lerpOrigin, ps->origin, delta);
+		meters             = VectorLength(delta) * ETA_QU_TO_METERS;
+		thing.meters       = meters;
+		thing.leftOfView  = AngleNormalize180(vectoyaw(delta) - ps->viewangles[YAW]);
+
+		/* Two points on whatever it is: low, and a man's head height. */
+		VectorCopy(cent->lerpOrigin, low);
+		low[2] += 8.0f;
+		VectorCopy(cent->lerpOrigin, high);
+		high[2] += 36.0f;
+
+		if (es->eType == ET_PLAYER && players)
+		{
+			if (es->number == ps->clientNum || !es->aiChar)
+			{
+				continue;
+			}
+
+			if (ETA_SeenAsEnemy(es))
+			{
+				thing.kind = (es->eFlags & EF_DEAD) ? ETA_AWARE_ENEMY_DOWN : ETA_AWARE_ENEMY;
+
+				/* Too far to matter: spare the traces. */
+				if (meters > ETA_HudNarrator_AwareRange(thing.kind) * 2.5f)
+				{
+					continue;
+				}
+
+				if (!ETA_ClearLine(eye, low) && !ETA_ClearLine(eye, high))
+				{
+					continue;
+				}
+
+				if (thing.kind == ETA_AWARE_ENEMY && meters > 10.0f
+				    && fabs(thing.leftOfView) > halfView)
+				{
+					continue;
+				}
+				Q_strncpyz(thing.name, ETA_CharacterKind(es), sizeof(thing.name));
+			}
+			else
+			{
+				/* A friend who has fallen has no medic to wait for here. */
+				if (es->eFlags & EF_DEAD)
+				{
+					continue;
+				}
+				thing.kind = ETA_AWARE_TEAMMATE;
+				Q_strncpyz(thing.name, ETA_CharacterKind(es), sizeof(thing.name));
+			}
+		}
+		else if (es->eType == ET_ITEM && ground && !(es->eFlags & EF_NODRAW))
+		{
+			gitem_t *item = (&bg_itemlist[es->modelindex]);
+
+			if (!item || !item->pickup_name || !item->pickup_name[0]
+			    || meters > ETA_HudNarrator_AwareRange(ETA_AWARE_ITEM) * 2.5f
+			    || !ETA_ClearLine(eye, low))
+			{
+				continue;
+			}
+
+			thing.kind = ETA_AWARE_ITEM;
+			Q_strncpyz(thing.name, item->pickup_name, sizeof(thing.name));
+		}
+		else
+		{
+			continue;
+		}
+
+		reach = ETA_HudNarrator_AwareRange(thing.kind) * 2.5f;
+		if (meters > reach)
+		{
+			continue;
+		}
+
+		list[count++] = thing;
+	}
+
+	return count;
+}
+
+/**
+ * @brief A thud on walking into a wall, a knock on walking into a thing.
+ *
+ * The tester asked for what audio games do: a sound when the way is
+ * shut, so a wall is heard rather than found by the footsteps stopping.
+ * Each frame the player's box is pushed a little the way they are
+ * walking - lifted a step, so a stair is not a wall - and when it stops
+ * against something they are walking into, not sliding along, it
+ * sounds from where they hit: a dull thud for a wall, a hollow knock for
+ * a thing - a door, a crate, a vehicle, a player, or the furniture the
+ * map file names (a window is the wall it is in). Once as they hit, and
+ * again while they keep pushing, ETA_BUMP_REPEAT_MS apart.
+ */
+#define ETA_BUMP_REPEAT_MS 600
+#define ETA_BUMP_PROBE     8.0f    /* how far ahead the box is pushed */
+#define ETA_BUMP_FACING    0.7f    /* walking into it, not along it: within about 45 degrees */
+#define ETA_BUMP_STEP      18.0f   /* the game's own step height (STEPSIZE) */
+
+static void ETA_BeaconBump(void)
+{
+	static int           lastAt;
+	static qboolean      wasBlocked;
+	const playerState_t *ps = &cg.predictedPlayerState;
+	usercmd_t            cmd;
+	vec3_t               angles, forward, right, wish, end, mins, maxs, at;
+	trace_t              trace;
+	const char           *prop;
+	qboolean             object;
+	sfxHandle_t          sfx;
+	int                  volume;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || !eta_bumpCues.integer || ps->groundEntityNum == ENTITYNUM_NONE
+	    || (ps->pm_flags & (PMF_LADDER | PMF_FOLLOW | PMF_LIMBO))
+	    || !trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd) || (!cmd.forwardmove && !cmd.rightmove))
+	{
+		wasBlocked = qfalse;
+		return;
+	}
+
+	VectorSet(angles, 0.0f, ps->viewangles[YAW], 0.0f);
+	AngleVectors(angles, forward, right, NULL);
+	VectorScale(forward, (float)cmd.forwardmove, wish);
+	VectorMA(wish, (float)cmd.rightmove, right, wish);
+	wish[2] = 0.0f;
+	if (VectorNormalize(wish) < 1.0f)
+	{
+		wasBlocked = qfalse;
+		return;
+	}
+
+	VectorSet(mins, -15.0f, -15.0f, -24.0f + ETA_BUMP_STEP);
+	VectorSet(maxs, 15.0f, 15.0f, (ps->pm_flags & PMF_DUCKED) ? 16.0f : 40.0f);
+	VectorMA(ps->origin, ETA_BUMP_PROBE, wish, end);
+	CG_Trace(&trace, ps->origin, mins, maxs, end, ps->clientNum, MASK_PLAYERSOLID);
+
+	if (trace.startsolid || trace.allsolid || trace.fraction >= 1.0f || trace.plane.normal[2] >= 0.7f
+	    || -DotProduct(wish, trace.plane.normal) < ETA_BUMP_FACING)
+	{
+		wasBlocked = qfalse;
+		return;
+	}
+
+	if (wasBlocked && cg.time - lastAt < ETA_BUMP_REPEAT_MS && cg.time >= lastAt)
+	{
+		return;
+	}
+	wasBlocked = qtrue;
+	lastAt     = cg.time;
+
+	/* Where the box touched: its side, the way it was going. */
+	VectorMA(trace.endpos, 16.0f, wish, at);
+	prop   = ETA_PropAt(at);
+	object = (qboolean)(trace.entityNum != ENTITYNUM_WORLD || (prop && Q_stricmp(prop, "Window")));
+
+	sfx    = CG_AccessibilityLoopSound(object ? ETA_LOOP_BUMP_OBJECT : ETA_LOOP_BUMP_WALL);
+	volume = CG_AccessibilityBumpVolume();
+	if (sfx && volume > 0)
+	{
+		/* RTCW gives a one-off sound no volume of its own. */
+		trap_S_StartSound(at, ENTITYNUM_WORLD, CHAN_AUTO, sfx);
+	}
+}
+
+/**
+ * @brief A sound on each health pack, ammo pack and weapon lying close
+ * by, from where it lies.
+ *
+ * The tester asked for these to be heard, to find them and pick them
+ * up: the callout says one is there as the player comes up to it, but
+ * not where to walk to get it. Each kind has its own sound, so which is
+ * which is heard before it is said. Only what a sighted player would
+ * see - in sight, nothing solid in the way - and only the nearest few,
+ * so a floor strewn after a fight does not become a din. A dropped
+ * objective - the gold, the documents - rings the flag's bell: it is
+ * there to be taken, or taken back.
+ *
+ * A health or ammo cabinet plays the same sound as a pack: the tester
+ * found the cabinets silent. One is a solid model with a trigger in
+ * front of it, or the trigger alone on some maps, so a cabinet and its
+ * own trigger are one sound, and the cabinet is in sight when the line
+ * reaches it.
+ */
+#define ETA_PICKUP_CUE_RANGE 400.0f   /* about ten metres */
+#define ETA_PICKUP_CUES      3        /* the nearest this many */
+#define ETA_PICKUP_SAME      96.0f    /* one of a kind this near another is the same thing */
+
+static void ETA_BeaconPickups(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	struct
+	{
+		vec3_t              origin;
+		float               distance;
+		eta_loopSoundType_t which;
+		qboolean            cabinet;
+	} near[ETA_PICKUP_CUES];
+	vec3_t eye;
+	int    count = 0, i;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || !eta_pickupCues.integer)
+	{
+		return;
+	}
+
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		const gitem_t       *item;
+		eta_loopSoundType_t which;
+		vec3_t              origin;
+		float               distance;
+		qboolean            same = qfalse, cabinet = qfalse;
+		int                 at;
+
+		if (es->eFlags & EF_NODRAW)
+		{
+			continue;
+		}
+
+		{
+			if (es->eType != ET_ITEM)
+			{
+				continue;
+			}
+
+			item = (&bg_itemlist[es->modelindex]);
+			if (!item)
+			{
+				continue;
+			}
+
+			if (item->giType == IT_HEALTH || item->giType == IT_ARMOR)
+			{
+				which = ETA_LOOP_HEALTH;
+			}
+			else if (item->giType == IT_AMMO)
+			{
+				which = ETA_LOOP_AMMO;
+			}
+			else if (item->giType == IT_WEAPON || item->giType == IT_TREASURE || item->giType == IT_HOLDABLE
+			         || item->giType == IT_KEY || item->giType == IT_POWERUP)
+			{
+				/* A weapon, or anything else to take: treasure, a key. */
+				which = ETA_LOOP_WEAPON;
+			}
+			else
+			{
+				continue;
+			}
+
+			VectorCopy(cg_entities[es->number].lerpOrigin, origin);
+			origin[2] += 8.0f;
+			distance = Distance(ps->origin, origin);
+
+			if (distance > ETA_PICKUP_CUE_RANGE || !ETA_ClearLine(eye, origin))
+			{
+				continue;
+			}
+		}
+
+		/* A cabinet and its own trigger: one sound, the nearer. */
+		for (at = 0; at < count && !same; at++)
+		{
+			if (cabinet && near[at].cabinet && near[at].which == which
+			    && Distance(near[at].origin, origin) < ETA_PICKUP_SAME)
+			{
+				same = qtrue;
+				if (distance < near[at].distance)
+				{
+					VectorCopy(origin, near[at].origin);
+					near[at].distance = distance;
+				}
+			}
+		}
+		if (same)
+		{
+			continue;
+		}
+
+		/* Nearest first; the furthest drops off the end. */
+		for (at = count; at > 0 && near[at - 1].distance > distance; at--)
+		{
+			if (at < ETA_PICKUP_CUES)
+			{
+				near[at] = near[at - 1];
+			}
+		}
+		if (at < ETA_PICKUP_CUES)
+		{
+			VectorCopy(origin, near[at].origin);
+			near[at].distance = distance;
+			near[at].which    = which;
+			near[at].cabinet  = cabinet;
+			if (count < ETA_PICKUP_CUES)
+			{
+				count++;
+			}
+		}
+	}
+
+	for (i = 0; i < count; i++)
+	{
+		sfxHandle_t sfx = CG_AccessibilityLoopSound(near[i].which);
+
+		if (sfx)
+		{
+			CG_AccessibilityLoopAt(near[i].origin, sfx, CG_AccessibilityLoopVolume(near[i].which), 800.0f);
+		}
+	}
+}
+
+/**
+ * @brief The armed landmines this player can see, by the game's own
+ * rule: ETA_MINE_ENEMY, ETA_MINE_FRIENDLY, or ETA_MINE_NONE.
+ *
+ * The tester kept dying on enemy mines the narrator never named. What a
+ * sighted player sees of a mine is decided in CG_Missile, and this is
+ * that rule, no more: an enemy mine once armed is hidden in the ground,
+ * and shows only once someone on this team has spotted it - the flag a
+ * covert op or a field op's binoculars leaves on it - or, with the
+ * battle sense skill that shows traps, within 256 units. A spectator
+ * sees no armed mine at all. The player's own team's mines are always
+ * shown; a teammate sets one off as surely as an enemy does
+ * (G_LandmineThink checks no team), and with friendly fire on it hurts.
+ */
+#define ETA_MINE_SEEN_CLOSE 256.0f   /* CG_Missile's trap awareness reach */
+
+typedef enum
+{
+	ETA_MINE_NONE = 0,
+	ETA_MINE_ENEMY,
+	ETA_MINE_FRIENDLY
+} eta_mineSeen_t;
+
+
+
+
+/**
+ * @brief How far a point lies from where the player faces, positive to
+ * the left - the engine's yaw sense, which is what the words for a
+ * direction are written against.
+ */
+float CG_AccessibilityLeftOfView(const vec3_t point)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              delta;
+	float               leftOfView;
+
+	VectorSubtract(point, ps->origin, delta);
+	leftOfView = AngleNormalize180(vectoyaw(delta) - ps->viewangles[YAW]);
+
+	return leftOfView;
+}
+
+
+
+
+
+/* What dynamite on the ground is to this player: the team's own not yet
+   armed, to arm, or an enemy's ticking, to defuse. The game lets an
+   engineer work either with pliers; the rest - the team's own ticking,
+   an enemy's never armed - is nothing to do. effect1Time is stamped when
+   the dynamite is armed (G_ArmDynamite), and is what starts its tick. */
+typedef enum
+{
+	ETA_DYNAMITE_NONE,
+	ETA_DYNAMITE_TO_ARM,
+	ETA_DYNAMITE_TO_DEFUSE
+} etaDynamite_t;
+
+
+/* Where to aim at dynamite: a little above where it lies, the middle of
+   the box the pliers reach for. */
+#define ETA_DYNAMITE_AIM_LIFT 6.0f
+
+/**
+ * @brief Flights of stairs near the player, for the F list.
+ *
+ * The tester found the stairs to the Allied command post on Oasis, with
+ * the way's "Stairs up" callout, and could not get onto them: the map
+ * has nothing that says where stairs are, so they were not on the F list
+ * the way the ladders are, and turning to face straight up a flight by
+ * ear is guesswork. So stairs are looked for as the list is made: out
+ * from the player in sixteen directions, a few centimetres at a time,
+ * the floor followed for fourteen metres - and a run of sharp rises a step
+ * high, with flatter footing between them, is a flight. The stairs there
+ * are steps cut in the rock, not neat treads, so the footing need only
+ * be walkable. Sloping ground is not stairs: a dune rises as much, but
+ * evenly, never a step at a time. The same flight seen from several
+ * directions is one, taken along the direction it climbs most steeply -
+ * which is straight up it.
+ */
+#define ETA_STAIRS_STEP      8.0f    /* between the looks along each direction */
+#define ETA_STAIRS_LOOKS     72      /* about fourteen metres: a flight starting ten metres off, whole */
+#define ETA_STAIRS_RISER     6.0f    /* this much up or down in one look: a step */
+#define ETA_STAIRS_LEVEL     2.5f    /* this little: the footing between steps */
+#define ETA_STAIRS_TOO_HIGH  22.0f   /* higher, a ledge or a drop, not a stair */
+#define ETA_STAIRS_RISERS    3       /* this many steps make a flight */
+#define ETA_STAIRS_HEIGHT    48.0f   /* and this high in all */
+#define ETA_STAIRS_WALKABLE  0.7f    /* the game's MIN_WALK_NORMAL */
+#define ETA_STAIRS_SAME      96.0f   /* feet this close: the same flight */
+
+typedef struct
+{
+	vec3_t foot, top;
+	float  rise, slope;
+	int    direction;
+} etaFlight_t;
+
+
+/**
+ * @brief The things close by the player could use, nearest first.
+ *
+ * Within fifteen metres: the objectives the command map shows for this
+ * player - a construction to build, an enemy one to blow up - and the
+ * things the game draws a use icon for: a door, a health or ammo
+ * cabinet, a mounted gun, something on the ground, a wounded teammate,
+ * for an engineer dynamite to arm or defuse, and for a covert op an
+ * enemy body with its uniform on, or an enemy down who will leave one.
+ * Everything but
+ * an objective must be in sight; an objective's own marker sits where
+ * the engine puts it, often inside what it marks.
+ */
+#define ETA_USE_RANGE 600.0f
+
+
+
+
+
+
+/**
+ * @brief "What is around me": the ways out, the walls, and what is there.
+ *
+ * A sighted player walking into a room takes it in at once - the doors,
+ * the window, the truck parked across the street - and a tester who
+ * could hear the truck asked how they were meant to know it was there.
+ * This is that glance, on a key.
+ *
+ * The ways out are eight traces at eye height, one per compass point,
+ * against the same collision the player moves through: a direction that
+ * runs more than a few metres is somewhere to go, and one that stops
+ * short is a wall. A trace that ends on glass is a window. The things
+ * are the named objects close by - the snapshot's own, and the static
+ * models the map placed - nearest first, each with its direction and
+ * distance and whether there is a clear line to it.
+ */
+void CG_AccessibilitySurroundings(void)
+{
+	char         open[256];
+	char         walls[160];
+	char         windows[160];
+	char         blocked[192];
+	eta_nearby_t nearby[ETA_SURROUND_MAX_OBJECTS];
+	ETA_AwareThing players[ETA_AWARE_MAX];
+	char         enemies[192];
+	char         wounded[160];
+	char         teammates[160];
+	int          people;
+	int          count = 0;
+	vec3_t       eye;
+	int          d, i;
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say("Nothing to describe until you are in play");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	VectorCopy(cg.predictedPlayerState.origin, eye);
+	eye[2] += cg.predictedPlayerState.viewheight;
+
+	open[0] = walls[0] = windows[0] = blocked[0] = '\0';
+
+	for (d = 0; d < 8; d++)
+	{
+		trace_t    trace;
+		vec3_t     angles, forward, end;
+		const char *name = ETA_HudNarrator_FacingName((ETA_Facing)d);
+		char       thing[64];
+		int        meters;
+
+		/* Compass bearing d * 45, clockwise from north; ET's yaw puts
+		   north at 90 and runs the other way. */
+		VectorSet(angles, 0.0f, 90.0f - 45.0f * (float)d, 0.0f);
+		AngleVectors(angles, forward, NULL, NULL);
+		VectorMA(eye, ETA_SURROUND_RANGE, forward, end);
+
+		CG_Trace(&trace, eye, NULL, NULL, end, cg.snap->ps.clientNum, MASK_PLAYERSOLID);
+
+		meters = (int)(trace.fraction * ETA_SURROUND_RANGE * ETA_QU_TO_METERS);
+
+		/* What stops the way, when it is a thing rather than the map:
+		   the truck across the street, a door. */
+		thing[0] = '\0';
+		if (trace.fraction < 1.0f && trace.entityNum != ENTITYNUM_WORLD && trace.entityNum < MAX_GENTITIES)
+		{
+			CG_AccessibilityObjectName(&cg_entities[trace.entityNum].currentState, thing, sizeof(thing));
+		}
+
+		if (trace.fraction >= 1.0f)
+		{
+			Q_strcat(open, sizeof(open), va("%s%s, far", open[0] ? ", " : "", name));
+		}
+		else if (meters > ETA_SURROUND_OPEN_METERS)
+		{
+			Q_strcat(open, sizeof(open), va("%s%s %d meters%s%s", open[0] ? ", " : "", name, meters,
+			                                thing[0] ? " to a " : "", thing));
+		}
+		else if (thing[0])
+		{
+			Q_strcat(blocked, sizeof(blocked), va("%s%s to the %s", blocked[0] ? ", " : "", thing, name));
+		}
+		else
+		{
+			Q_strcat(walls, sizeof(walls), va("%s%s", walls[0] ? ", " : "", name));
+		}
+
+		if (trace.fraction < 1.0f && (trace.surfaceFlags & SURF_GLASS)
+		    && meters <= ETA_SURROUND_WINDOW_METERS)
+		{
+			Q_strcat(windows, sizeof(windows), va("%s%s %d meters", windows[0] ? ", " : "", name, meters));
+		}
+	}
+
+	/* The things close by: the snapshot's entities, then the map's
+	   static models. */
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		char                name[64];
+		vec3_t              origin;
+
+		if (!CG_AccessibilityObjectName(es, name, sizeof(name)))
+		{
+			continue;
+		}
+
+		VectorCopy(cg_entities[es->number].lerpOrigin, origin);
+		if (es->solid == SOLID_BMODEL && es->modelindex > 0 && es->modelindex < MAX_MODELS)
+		{
+			VectorAdd(origin, cgs.inlineModelMidpoints[es->modelindex], origin);
+		}
+
+		ETA_SurroundAddNearby(nearby, &count, ETA_SURROUND_MAX_OBJECTS, name, origin, es->number);
+	}
+
+	/* The players: enemies in sight, the wounded and teammates close by -
+	   held to what the automatic callouts are held to, nearest first. */
+	people = ETA_GatherAwareness(players, ETA_AWARE_MAX, qtrue, qfalse);
+	for (i = 1; i < people; i++)
+	{
+		ETA_AwareThing moving = players[i];
+		int            at     = i;
+
+		while (at > 0 && players[at - 1].meters > moving.meters)
+		{
+			players[at] = players[at - 1];
+			at--;
+		}
+		players[at] = moving;
+	}
+
+	enemies[0] = wounded[0] = teammates[0] = '\0';
+	for (i = 0; i < people; i++)
+	{
+		const ETA_AwareThing *who = &players[i];
+		char                 *into;
+		size_t               size;
+
+		if (who->meters > ETA_HudNarrator_AwareRange(who->kind))
+		{
+			continue;
+		}
+
+		switch (who->kind)
+		{
+		case ETA_AWARE_ENEMY:    into = enemies;   size = sizeof(enemies);   break;
+		case ETA_AWARE_WOUNDED:  into = wounded;   size = sizeof(wounded);   break;
+		case ETA_AWARE_TEAMMATE: into = teammates; size = sizeof(teammates); break;
+		default:                 continue;
+		}
+
+		Q_strcat(into, size, va("%s%s%s%s %d meters", into[0] ? ", " : "", who->name,
+		                        who->name[0] ? " " : "",
+		                        ETA_HudNarrator_RelativeDirection(who->leftOfView),
+		                        (int)(who->meters + 0.5f)));
+	}
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_BeginReport();
+
+	/* With the place's name: the tester knew they were indoors and not
+	   where. The map's own name for the place when it has one - "Water
+	   Pump", "Allied Command Post" - and the command map square when it
+	   does not. */
+	/* And what kind of place: "Outdoors, alley, east to west, Water
+	   Pump", "Indoors, upper floor, Allied Command Post". */
+	{
+		const char *place = NULL;   /* the campaign's maps name no places */
+		const char *cover = ETA_OverheadState() == ETA_OVERHEAD_OPEN_SKY ? "Outdoors" : "Indoors";
+		ETA_Place   kind;
+		char        what[128];
+
+		CG_AccessibilityPlace(cg.predictedPlayerState.origin, &kind);
+		ETA_Place_Text(&kind, what, sizeof(what));
+
+		if (!what[0])
+		{
+			Q_strncpyz(what, cover, sizeof(what));
+		}
+		else if (kind.kind != ETA_PLACE_INDOORS && kind.kind != ETA_PLACE_UPPER_FLOOR)
+		{
+			/* "Outdoors, street, ..." - the kind in the middle of the
+			   sentence, so in lower case. */
+			what[0] = (char)tolower((unsigned char)what[0]);
+			Q_strncpyz(what, va("Outdoors, %s", what), sizeof(what));
+		}
+
+		ETA_Speech_Say(place ? va("%s, %s", what, place) : what);
+	}
+
+	if (eta_playerCallouts.integer)
+	{
+		ETA_Speech_Say(enemies[0] ? va("Enemies in sight, %s", enemies) : "No enemies in sight");
+
+		if (wounded[0])
+		{
+			ETA_Speech_Say(va("Wounded, %s", wounded));
+		}
+	}
+
+	ETA_Speech_Say(open[0] ? va("Open to the %s", open) : "No way out further than a few meters");
+
+	if (walls[0])
+	{
+		ETA_Speech_Say(va("Walls close to the %s", walls));
+	}
+
+	if (blocked[0])
+	{
+		ETA_Speech_Say(va("Close by, %s", blocked));
+	}
+
+	if (windows[0])
+	{
+		ETA_Speech_Say(va("Window to the %s", windows));
+	}
+
+	if (count == 0)
+	{
+		ETA_Speech_Say("Nothing named close by");
+	}
+
+	for (i = 0; i < count; i++)
+	{
+		trace_t trace;
+		vec3_t  delta, target;
+		int     meters = (int)(nearby[i].distance * ETA_QU_TO_METERS);
+
+		VectorSubtract(nearby[i].origin, cg.predictedPlayerState.origin, delta);
+
+		/* In sight when nothing solid stands between the eye and it -
+		   the thing itself, being solid, counts as reaching it. Aimed a
+		   little above where it stands: a model's origin is on the
+		   ground, and a line to the floor it sits on is cut by the
+		   floor. */
+		VectorCopy(nearby[i].origin, target);
+		target[2] += 16.0f;
+		CG_Trace(&trace, eye, NULL, NULL, target, cg.snap->ps.clientNum, MASK_SOLID);
+
+		ETA_Speech_Say(va("%s, %d meters %s%s", nearby[i].name, meters,
+		                  ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(vectoyaw(delta))),
+		                  (trace.fraction >= 1.0f
+		                   || (nearby[i].entityNum >= 0 && trace.entityNum == nearby[i].entityNum))
+		                  ? "" : ", out of sight"));
+	}
+
+	if (eta_playerCallouts.integer && teammates[0])
+	{
+		ETA_Speech_Say(va("Friends near, %s", teammates));
+	}
+
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Says, continuously, that the crosshair is on somebody.
+ *
+ * Two different kinds of parity, and they are worth separating.
+ *
+ * The teammate cue mirrors an explicit HUD feature: the stock game draws
+ * a teammate's name under the crosshair so you do not shoot them.
+ *
+ * The enemy cue does not. Cross an enemy in the stock game and the HUD
+ * says nothing at all - the sighted player knows because they can see a
+ * person standing there. So this mirrors what sight gives for free
+ * rather than what the HUD gives, which is a fair thing to restore but
+ * worth being honest about, and is why it has its own switch.
+ *
+ * The line this does not cross: a disguised covert operative reads as a
+ * teammate, because that is what a sighted player sees. The game is
+ * deliberately deceiving them and the cue is deceived with them. The one
+ * exception is the Field Ops skill that reveals disguises, where the
+ * game itself gives the truth - then so does this. The rule is that the
+ * cue says what a sighted player would believe, including when the game
+ * is lying to them.
+ *
+ * It rides the engine's own crosshair trace, so it can never report
+ * through a wall.
+ */
+static void ETA_NarrateCrosshair(void)
+{
+	int         other;
+	qboolean    enemy;
+	sfxHandle_t sfx;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_crosshairCues.integer)
+	{
+		return;
+	}
+
+	if (cg.crosshairClientNum < 0 || cg.crosshairClientNum >= MAX_CLIENTS)
+	{
+		return;
+	}
+
+	/* The engine fades the crosshair name out rather than clearing it, so
+	   the same window decides whether it is still current. */
+	if (cg.time - cg.crosshairClientTime > 1000)
+	{
+		return;
+	}
+
+	other = cg.crosshairClientNum;
+	if (!cg_entities[other].currentValid || !cg_entities[other].currentState.aiChar
+	    || (cg_entities[other].currentState.eFlags & EF_DEAD))
+	{
+		return;
+	}
+
+	enemy = ETA_SeenAsEnemy(&cg_entities[other].currentState);
+
+	sfx = CG_AccessibilityLoopSound(enemy ? ETA_LOOP_CROSSHAIR_ENEMY
+	                                : ETA_LOOP_CROSSHAIR_TEAMMATE);
+
+	if (sfx)
+	{
+		/* At the view origin, so it sits centred: this is about the
+		   crosshair, which is always straight ahead, not about where
+		   the other player is. */
+		CG_AccessibilityLoopAt(cg.refdef.vieworg, sfx,
+		           CG_AccessibilityLoopVolume(enemy ? ETA_LOOP_CROSSHAIR_ENEMY : ETA_LOOP_CROSSHAIR_TEAMMATE), 1000.0f);
+	}
+}
+
+/**
+ * @brief Players and things near you, said as they come and go.
+ *
+ * The decisions - what is news, what goes first, when to wait - are the
+ * library's. This gathers what the player could know, and tells it how
+ * long the voice has been free: the length of whatever was said last,
+ * estimated, counts as still being said, so a pickup on the floor does
+ * not cut a report off halfway. An enemy is the exception, and the
+ * library knows it.
+ *
+ * Called every frame, held or not, so it always knows when something was
+ * last said; while an answer the player asked for is still being
+ * spoken, it says nothing.
+ */
+/* Until when a build is being counted out: its words are the answer to
+   what the player is doing, and nothing else talks over them. */
+static int eta_buildBusyUntil;
+
+#define ETA_BUILD_BUSY_MS 2500
+
+
+static void ETA_NarrateAwareness(qboolean held)
+{
+	static int     lastSerial = -1;
+	static int     lastSpeechAt;
+	ETA_AwareThing list[ETA_AWARE_MAX];
+	char           said[160];
+	const char     *last;
+	int            serial, count, quiet;
+	qboolean       building;
+
+	serial = ETA_Speech_GetSpokenSerial();
+	if (serial != lastSerial || cg.time < lastSpeechAt)
+	{
+		lastSerial   = serial;
+		lastSpeechAt = cg.time;
+	}
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL
+	    || (!eta_playerCallouts.integer && !eta_groundCallouts.integer))
+	{
+		ETA_HudNarrator_ResetAwareness();
+		return;
+	}
+
+	if (held)
+	{
+		return;
+	}
+
+	count = ETA_GatherAwareness(list, ETA_AWARE_MAX, (qboolean)(eta_playerCallouts.integer != 0),
+	                            (qboolean)(eta_groundCallouts.integer != 0));
+
+	last  = ETA_Speech_GetLastMessage();
+	quiet = cg.time - lastSpeechAt - (last ? ETA_Speech_EstimateDurationMs(last) : 0);
+
+	building = (qboolean)(cg.time < eta_buildBusyUntil && eta_buildBusyUntil - cg.time <= ETA_BUILD_BUSY_MS);
+
+	if (ETA_HudNarrator_UpdateAwareness(list, count, cg.time, quiet, building ? 0 : 1,
+	                                    said, sizeof(said)))
+	{
+		ETA_HudNarrator_SpeakAwareness(said);
+	}
+}
+
+static void ETA_NarrateFacing(void)
+{
+	ETA_Facing facing;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_facingCallouts.integer)
+	{
+		ETA_HudNarrator_ResetFacing();
+		return;
+	}
+
+	/* A tap on a turn key says its own point when it lands. */
+	if (CG_AccessibilityTurnBusy())
+	{
+		return;
+	}
+
+	/* Predicted rather than the snapshot's, for the same reason the
+	   stance is: turning is a local action and the snapshot lags it by a
+	   round trip, which on a direction is long enough to be felt. */
+	if (ETA_HudNarrator_UpdateFacing(cg.predictedPlayerState.viewangles[YAW], cg.time, &facing))
+	{
+		ETA_Speech_BeginReport();
+		ETA_HudNarrator_SpeakFacing(facing);
+		ETA_Speech_EndReport();
+	}
+}
+
+
+
+
+
+/**
+ * @brief Says what the player is looking at when they aim up or down.
+ *
+ * The cardinal callout answers "which way am I facing", and it is a yaw
+ * report: it says north and south and says nothing at all about the other
+ * axis. A player who tips the view up gets no acknowledgement that
+ * anything happened, and no way to tell a ceiling a foot above them from
+ * open sky.
+ *
+ * Saying the angle - "forty degrees up" - would be honest and useless.
+ * Forty degrees up is the sky in a field and a ceiling in a cellar, and
+ * the player wants to know which. So the pitch is only the trigger: what
+ * gets spoken is the same trace the binoculars use, along the line the
+ * player is actually looking down, and it comes back with the words that
+ * narration already has - "Open sky", "Concrete ground, 3 meters",
+ * "Wooden ceiling", "Nothing in range".
+ *
+ * It fires when the aim settles into a new band rather than while it is
+ * moving, for the reason the facing callout does: a sweep from the floor
+ * to the sky passes through everything in between, and narrating the
+ * journey buries the destination.
+ */
+static void ETA_NarrateLookAround(void)
+{
+	char description[128];
+	int  distance;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_facingCallouts.integer)
+	{
+		ETA_HudNarrator_ResetLookPitch();
+		return;
+	}
+
+	/* While zoomed, the zoom narration is already answering this question
+	   at the range the player chose, and it re-reads on every change
+	   rather than only when the aim settles. Two voices on one trace. */
+	if (cg.zoomedBinoc || cg.zoomed)
+	{
+		ETA_HudNarrator_ResetLookPitch();
+		return;
+	}
+
+	/* Predicted, like the yaw: the look is a local action and the
+	   snapshot lags it by a round trip. */
+	if (!ETA_HudNarrator_UpdateLookPitch(cg.predictedPlayerState.viewangles[PITCH], cg.time))
+	{
+		return;
+	}
+
+	if (!ETA_DescribeLookAhead(description, sizeof(description), &distance, ETA_LOOK_AHEAD_RANGE, NULL))
+	{
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakLookAhead(description, distance);
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief How long the obstacle ahead stays announced before it is news again.
+ *
+ * Walking into a corner and shuffling along it would otherwise repeat the
+ * same sentence for as long as the corner lasts. Coming off the wall and
+ * back onto it is a real event and is announced at once; standing against
+ * it is not.
+ */
+#define ETA_OBSTACLE_MIN_INTERVAL 3000
+
+/**
+ * @brief Says when the player is about to walk into something.
+ *
+ * The binoculars and the scope answer "what is in front of me" at range,
+ * which is what they are for. A rifleman, an engineer with the pliers
+ * out, a medic - most of the classes, most of the time - has no such key,
+ * and for them the question is smaller and more urgent: is there a wall
+ * right there.
+ *
+ * This is the same probe as the zoomed one, at arm's length, and it
+ * deliberately does nothing while zoomed: that narration is already
+ * answering the same question at the range the player asked for.
+ */
+/**
+ * @brief How far ahead the player's own body is tested for an obstacle.
+ *
+ * Just over a stride. Long enough to arrive slightly before the player
+ * does, short enough that it is describing what is stopping them rather
+ * than what is across the room.
+ */
+#define ETA_OBSTACLE_PROBE_DISTANCE 48.0f
+
+/**
+ * @brief How slowly the player has to be going to count as stopped.
+ *
+ * A metre a second. Above that they are getting somewhere, and whatever
+ * is beside them is not stopping them however close it is.
+ */
+#define ETA_OBSTACLE_STOPPED_SPEED 40.0f
+
+/**
+ * @brief Says what is blocking the way, and only when something is.
+ *
+ * This is the second attempt at the same report, and the first one was
+ * only half a fix.
+ *
+ * It began as a ray from the eye that named whatever it hit. A tester
+ * heard "wall, 0 metres" while walking on perfectly well, and the cure
+ * was to stop asking "what am I looking at" and start asking "what is
+ * stopping me": a trace of the player's own bounding box, lifted by the
+ * engine's step height so stairs pass underneath it.
+ *
+ * That fixed the *shape* of the probe and left its *aim* alone - still
+ * the view yaw. Which means it went on answering "what am I looking
+ * at", just with a fatter instrument. The same tester came back: they
+ * could walk forward many metres and still hear the wall, because
+ * running down a corridor while glancing sideways is the commonest
+ * thing in this game and the probe was pointed wherever the eyes went.
+ *
+ * So the aim comes from the player's own movement keys now, turned into
+ * the world by their view - the direction they are *asking* to go.
+ * Press forward and it probes forward; strafe into a wall and it probes
+ * sideways, at the wall that is actually stopping you.
+ *
+ * And it will not speak at all unless the player is both asking to move
+ * and failing to. That is what "blocked" means, and it is the test the
+ * report should have been making all along: someone covering ground is
+ * not blocked, whatever is beside them.
+ *
+ * The same tester's other finding is answered in ETA_HudNarrator
+ * PassiveHeld: ordering this before the objective callout only settles a
+ * collision inside one frame, and pressing the objectives key puts the
+ * answer on one frame and this on the next.
+ */
+static void ETA_NarrateObstacleAhead(void)
+{
+	static char lastDescription[128];
+	static int  lastTime;
+	char        description[128];
+
+	const playerState_t *ps;
+	usercmd_t           cmd;
+	trace_t             trace;
+	vec3_t              angles, forward, right, wish, start, end, mins, maxs;
+	float               speedSq;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* The zoom narration owns this question while it is up. */
+	if (cg.zoomed || cg.zoomedBinoc)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	ps = &cg.predictedPlayerState;
+
+	/* In the air there is nothing to be blocked from doing. */
+	if (ps->groundEntityNum == ENTITYNUM_NONE)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* Covering ground. Whatever is beside them is not stopping them, and
+	   this is the whole of what the tester reported: metres of walking
+	   with a wall announced the entire way. */
+	speedSq = ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1];
+
+	if (speedSq > ETA_OBSTACLE_STOPPED_SPEED * ETA_OBSTACLE_STOPPED_SPEED)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* Standing still on purpose is not being blocked either. Without
+	   this, anyone who stopped to listen would be told about the nearest
+	   wall for as long as they stood there. */
+	if (!trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd)
+	    || (cmd.forwardmove == 0 && cmd.rightmove == 0))
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* Flattened: looking down at your boots must not aim the probe into
+	   the floor, and looking up must not aim it over the obstacle. */
+	angles[PITCH] = 0.0f;
+	angles[YAW]   = cg.refdefViewAngles[YAW];
+	angles[ROLL]  = 0.0f;
+	AngleVectors(angles, forward, right, NULL);
+
+	/* The direction being asked for, not the one being looked in. This
+	   is the correction: the movement keys say where the player is
+	   trying to go, and that is the only direction anything can be
+	   blocking them in. */
+	VectorScale(forward, (float)cmd.forwardmove, wish);
+	VectorMA(wish, (float)cmd.rightmove, right, wish);
+	wish[2] = 0.0f;
+
+	if (VectorNormalize(wish) < 0.1f)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* The player's own box - so this is crouched when they are crouched
+	   and prone when they are prone - with the base raised by one step.
+	   That lift is what lets a stair riser pass underneath, exactly as
+	   the player's feet do. */
+	VectorCopy(ps->mins, mins);
+	VectorCopy(ps->maxs, maxs);
+	mins[2] += ETA_DROP_STEP_UNITS;
+
+	if (mins[2] >= maxs[2])
+	{
+		/* Prone, or some other posture shorter than a step. Nothing
+		   sensible to sweep, so say nothing rather than guess. */
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	VectorCopy(ps->origin, start);
+	VectorMA(start, ETA_OBSTACLE_PROBE_DISTANCE, wish, end);
+
+	CG_Trace(&trace, start, mins, maxs, end, ps->clientNum, MASK_PLAYERSOLID);
+
+	if (trace.fraction == 1.0f || trace.startsolid)
+	{
+		/* Clear ahead - or already inside something, where a report
+		   would be about geometry rather than about anything the player
+		   can act on. Clearing the memory here is what makes stepping
+		   away and back a fresh announcement. */
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* Ground is not an obstacle even when the box meets it: that is a
+	   slope the player walks up, and what is underfoot is the footstep
+	   narration's job. */
+	if (trace.plane.normal[2] > 0.7f)
+	{
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	ETA_DescribeTraceHit(&trace, description, sizeof(description));
+
+	if (!Q_stricmp(description, lastDescription)
+	    && cg.time - lastTime < ETA_OBSTACLE_MIN_INTERVAL)
+	{
+		return;
+	}
+
+	Q_strncpyz(lastDescription, description, sizeof(lastDescription));
+	lastTime = cg.time;
+
+	ETA_Speech_BeginReport();
+	/* No distance: this only speaks about something the player is up
+	   against, so the number would always be nought. */
+	ETA_HudNarrator_SpeakLookAhead(description, -1);
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief How far ahead the first and second treads are sampled, in
+ *        Quake units.
+ *
+ * The near one is about half a stride: close enough that it describes
+ * the step the player is about to take rather than one across the room.
+ * The far one is a stride, and its only job is to tell a single step
+ * from a flight of them.
+ */
+#define ETA_STAIR_NEAR 28.0f
+#define ETA_STAIR_FAR 56.0f
+
+/**
+ * @brief The smallest change in ground height worth calling a step.
+ *
+ * Below this the ground is simply not level, which is most of this game.
+ */
+#define ETA_STAIR_MIN_RISE 4.0f
+
+/**
+ * @brief How flat a tread has to be, as the cosine of its slope.
+ *
+ * 0.99 is about eight degrees. Stairs in this game are built of flat
+ * brushes, so their treads come back at exactly 1.0; ramps, rubble and
+ * desert do not. Anything short of flat is left unsaid rather than
+ * called a staircase - a player told to expect steps and given a slope
+ * has been sent to look for something that is not there.
+ *
+ * Note this is much stricter than the engine's own MIN_WALK_NORMAL of
+ * 0.7, and deliberately so: that one answers "can this be walked on",
+ * which nearly everything can.
+ */
+#define ETA_STAIR_FLAT 0.99f
+
+/**
+ * @brief How long before the same staircase is worth mentioning again.
+ */
+#define ETA_STAIR_MIN_INTERVAL 3000
+
+/**
+ * @brief The height of the flat ground a short way ahead, relative to a
+ *        reference height.
+ *
+ * A point trace straight down, from one step above the reference to one
+ * step below it. That window is the engine's own step height on purpose:
+ * ground outside it is not somewhere the player can simply walk to, and
+ * is therefore not a step - it is either a wall (the obstacle report's
+ * business) or a drop (the drop warning's).
+ *
+ * @param[in]  ps       the player
+ * @param[in]  forward  flattened direction to sample along
+ * @param[in]  distance how far ahead
+ * @param[in]  fromZ    the height this is measured against
+ * @param[out] rise     signed height difference, on qtrue
+ * @return qtrue when flat ground was found inside the window
+ */
+static qboolean ETA_GroundRiseAhead(const playerState_t *ps, const vec3_t forward,
+                                    float distance, float fromZ, float *rise)
+{
+	trace_t trace;
+	vec3_t  start, end;
+
+	VectorMA(ps->origin, distance, forward, start);
+	start[2] = fromZ + ETA_DROP_STEP_UNITS + 1.0f;
+
+	VectorCopy(start, end);
+	end[2] = fromZ - ETA_DROP_STEP_UNITS - 1.0f;
+
+	CG_Trace(&trace, start, NULL, NULL, end, ps->clientNum, MASK_PLAYERSOLID);
+
+	if (trace.startsolid || trace.allsolid || trace.fraction == 1.0f)
+	{
+		return qfalse;
+	}
+
+	if (trace.plane.normal[2] < ETA_STAIR_FLAT)
+	{
+		return qfalse;
+	}
+
+	*rise = trace.endpos[2] - fromZ;
+
+	return qtrue;
+}
+
+
+/**
+ * @brief "Hans revived": the one watched, back up where they fell.
+ *
+ * A player who is revived gets up where they lay; one who spawns again
+ * appears somewhere else. So back on their feet near where they went
+ * down is a revive, and anywhere else is not said - the play state
+ * says the rest.
+ */
+#define ETA_REVIVED_NEAR 128.0f
+
+
+/**
+ * @brief Says it when the player goes from watching to playing, or back.
+ *
+ * A change has to hold for a moment before it is said: joining a team
+ * passes through a frame or two of states that are not where the player
+ * ends up, and a spectator cycling through players should hear the one
+ * they stop on rather than every one they skipped. It is an event, said
+ * once, so it is not held back by the quiet after a question.
+ */
+#define ETA_PLAY_STATE_SETTLE_MS 400
+
+
+
+
+/**
+ * @brief How near a ladder has to be to be said, and to be climbed with
+ *        the use key: two metres, a couple of steps.
+ */
+#define ETA_LADDER_REACH 80.0f
+
+/* How far below the feet the probes for a ladder down go looking: deep
+   enough to be in the shaft, not so deep a ladder two floors down is
+   taken for this one. */
+#define ETA_LADDER_DROP 64.0f
+
+/* What the player's own movement collides with (cg_predict.c): other
+   players are not part of a ladder, and must not hide one. */
+#define ETA_LADDER_MASK (MASK_PLAYERSOLID & ~CONTENTS_BODY)
+
+/* How often the ladder search runs while nothing is being climbed. */
+#define ETA_LADDER_SEARCH_MS 250
+
+/**
+ * @brief Whether a trace ended on a ladder - the same test the game's
+ *        own movement makes, SURF_LADDER on a wall-like face.
+ */
+static qboolean ETA_LadderHit(const trace_t *tr)
+{
+	return (qboolean)(tr->fraction < 1.0f && !tr->startsolid && !tr->allsolid
+	                  && (tr->surfaceFlags & SURF_LADDER)
+	                  && Q_fabs(tr->plane.normal[2]) < 0.7f);
+}
+
+/**
+ * @brief Moves a found ladder point to the middle of the ladder.
+ *
+ * The search stops at the first ladder face a trace touches, which can be
+ * its very edge - and a climb aimed at the edge walks into the wall
+ * beside the ladder, where the game finds no ladder at all. A tester
+ * heard "Could not get onto the ladder" that way. So the face is felt
+ * along to each side, the way a hand would, and the point put halfway
+ * between where it ends.
+ */
+static void ETA_LadderCentre(etaLadder_t *ladder)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              tangent;
+	float               reach[2] = { 0.0f, 0.0f };
+	int                 side;
+
+	tangent[0] = -ladder->normal[1];
+	tangent[1] = ladder->normal[0];
+	tangent[2] = 0.0f;
+
+	if (VectorNormalize(tangent) < 0.5f)
+	{
+		return;
+	}
+
+	for (side = 0; side < 2; side++)
+	{
+		float step;
+
+		for (step = 4.0f; step <= 64.0f; step += 4.0f)
+		{
+			vec3_t  from, end;
+			trace_t tr;
+
+			VectorMA(ladder->point, 8.0f, ladder->normal, from);
+			VectorMA(from, side ? -step : step, tangent, from);
+			VectorMA(from, -24.0f, ladder->normal, end);
+
+			CG_Trace(&tr, from, NULL, NULL, end, ps->clientNum, ETA_LADDER_MASK);
+
+			if (!ETA_LadderHit(&tr))
+			{
+				break;
+			}
+			reach[side] = step;
+		}
+	}
+
+	VectorMA(ladder->point, 0.5f * (reach[0] - reach[1]), tangent, ladder->point);
+}
+
+/**
+ * @brief The nearest ladder the player could climb from where they stand.
+ *
+ * A ladder in ET is not an entity. It is a face of the map marked
+ * SURF_LADDER - usually an invisible clip brush laid against a wall -
+ * and the game's movement code finds it by tracing straight ahead from
+ * the player (PM_CheckLadderMove). So this finds it the same way, in
+ * every direction rather than only ahead:
+ *
+ * - Up: traces out from chest height in sixteen directions. A ladder
+ *   face there, facing back toward the player, goes up from here.
+ * - Down: with the feet on the ground, points just beyond the player
+ *   and below the floor are tried; where one is open air - a shaft, a
+ *   hatch - traces from it look for a ladder face on either wall. The
+ *   face can be on the far wall, looking back at the player, or on the
+ *   near one, under the player's own edge and looking away; which it is
+ *   decides whether the climb starts by walking forward or backward.
+ *
+ * Everything is the map's own collision, the same traces the game makes,
+ * so a ladder that is said is one the game will let the player climb.
+ */
+qboolean CG_AccessibilityLadderNear(etaLadder_t *out)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	float               best = ETA_LADDER_REACH + 1.0f;
+	trace_t             tr;
+	int                 i, h;
+
+	if (!cg.snap)
+	{
+		return qfalse;
+	}
+
+	memset(out, 0, sizeof(*out));
+
+	for (i = 0; i < 16; i++)
+	{
+		vec3_t dir, from, end;
+		float  yaw = (float)i * 22.5f;
+
+		dir[0] = (float)cos(DEG2RAD(yaw));
+		dir[1] = (float)sin(DEG2RAD(yaw));
+		dir[2] = 0.0f;
+
+		for (h = 0; h < 2; h++)
+		{
+			VectorCopy(ps->origin, from);
+			from[2] += h ? 40.0f : 16.0f;
+			VectorMA(from, ETA_LADDER_REACH, dir, end);
+
+			CG_Trace(&tr, from, NULL, NULL, end, ps->clientNum, ETA_LADDER_MASK);
+
+			/* Facing the player: a ladder seen from behind is the back of
+			   a wall. */
+			if (!ETA_LadderHit(&tr) || DotProduct(dir, tr.plane.normal) > -0.3f)
+			{
+				continue;
+			}
+
+			if (tr.fraction * ETA_LADDER_REACH < best)
+			{
+				best = tr.fraction * ETA_LADDER_REACH;
+				VectorCopy(tr.endpos, out->point);
+				VectorCopy(tr.plane.normal, out->normal);
+				out->goesUp = qtrue;
+				out->behind = qfalse;
+			}
+		}
+	}
+
+	if (best <= ETA_LADDER_REACH)
+	{
+		out->meters = best * ETA_QU_TO_METERS;
+		ETA_LadderCentre(out);
+		return qtrue;
+	}
+
+	/* A ladder down starts from the ground. */
+	if (ps->groundEntityNum == ENTITYNUM_NONE)
+	{
+		return qfalse;
+	}
+
+	for (i = 0; i < 8; i++)
+	{
+		vec3_t dir, probe, above;
+		float  yaw = (float)i * 45.0f;
+		int    step;
+
+		dir[0] = (float)cos(DEG2RAD(yaw));
+		dir[1] = (float)sin(DEG2RAD(yaw));
+		dir[2] = 0.0f;
+
+		for (step = 1; step <= 2; step++)
+		{
+			int side;
+
+			VectorMA(ps->origin, 32.0f * (float)step, dir, probe);
+			probe[2] = ps->origin[2] + ps->mins[2] - ETA_LADDER_DROP;
+
+			/* There has to be a way down to the probe: open from the
+			   player's own floor level all the way to it. */
+			VectorCopy(probe, above);
+			above[2] = ps->origin[2];
+			CG_Trace(&tr, above, NULL, NULL, probe, ps->clientNum, ETA_LADDER_MASK);
+			if (tr.fraction < 1.0f || tr.startsolid)
+			{
+				continue;
+			}
+
+			for (side = 0; side < 2; side++)
+			{
+				vec3_t sideDir, end;
+				float  across;
+
+				VectorScale(dir, side ? -1.0f : 1.0f, sideDir);
+				VectorMA(probe, 64.0f, sideDir, end);
+
+				CG_Trace(&tr, probe, NULL, NULL, end, ps->clientNum, ETA_LADDER_MASK);
+
+				if (!ETA_LadderHit(&tr))
+				{
+					continue;
+				}
+
+				across = (float)sqrt((tr.endpos[0] - ps->origin[0]) * (tr.endpos[0] - ps->origin[0])
+				                     + (tr.endpos[1] - ps->origin[1]) * (tr.endpos[1] - ps->origin[1]));
+
+				if (across < best)
+				{
+					vec3_t fromLadder;
+
+					best = across;
+					VectorCopy(tr.endpos, out->point);
+					VectorCopy(tr.plane.normal, out->normal);
+					out->goesUp = qfalse;
+
+					/* Behind the ladder's face: the player stands over the
+					   wall it is on, and has to step back off the edge. */
+					VectorSubtract(ps->origin, tr.endpos, fromLadder);
+					fromLadder[2] = 0.0f;
+					out->behind   = (qboolean)(DotProduct(fromLadder, tr.plane.normal) < 0.0f);
+				}
+			}
+		}
+	}
+
+	if (best <= ETA_LADDER_REACH)
+	{
+		out->meters = best * ETA_QU_TO_METERS;
+		ETA_LadderCentre(out);
+		return qtrue;
+	}
+
+	return qfalse;
+}
+
+/**
+ * @brief Says where the player's own dynamite came to rest.
+ *
+ * Dynamite is thrown, not placed: it leaves the hand low and rolls, and
+ * all the game says is "Dynamite is set, but NOT armed!" - true, and no
+ * help to a player who cannot see where it went. The tester could not
+ * arm theirs for not knowing where it had fallen. So once it stops, where
+ * it lies is said, once; F then turns to it (CG_AccessibilityUseTargets)
+ * and the pliers' hint says "arm" over it.
+ *
+ * Each throw is told apart by its entity and the time it came to rest,
+ * which the server stamps when it stops (G_BounceMissile).
+ */
+#define ETA_DYNAMITE_REMEMBERED 8
+
+
+/**
+ * @brief Says a ladder once, as the player comes to it.
+ *
+ * Stairs are said as the ground ahead rises; a ladder is not ground,
+ * and nothing about walking past one says it is there - the game only
+ * shows its icon when the crosshair happens to be on it. So the search
+ * runs a few times a second, and a ladder is said when one comes within
+ * two metres and not again until the player has walked away from it.
+ */
+static void ETA_NarrateLadder(void)
+{
+	static int    nextSearch;
+	static vec3_t saidAt;
+	static int    said;
+	etaLadder_t   ladder;
+	int           meters;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer
+	    || (cg.snap->ps.pm_flags & PMF_LADDER) || CG_AccessibilityClimbing())
+	{
+		return;
+	}
+
+	if (cg.time < nextSearch && nextSearch - cg.time <= ETA_LADDER_SEARCH_MS)
+	{
+		return;
+	}
+	nextSearch = cg.time + ETA_LADDER_SEARCH_MS;
+
+	if (!CG_AccessibilityLadderNear(&ladder))
+	{
+		/* Walked away: the next ladder, or this one again, is news. */
+		if (said && Distance(cg.predictedPlayerState.origin, saidAt) > ETA_LADDER_REACH * 2.0f)
+		{
+			said = 0;
+		}
+		return;
+	}
+
+	if (said && Distance(ladder.point, saidAt) < ETA_LADDER_REACH * 2.0f)
+	{
+		return;
+	}
+
+	said = 1;
+	VectorCopy(ladder.point, saidAt);
+
+	meters = (int)(ladder.meters + 0.5f);
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakLadder(ladder.goesUp ? 1 : 0,
+	                            ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(ladder.point)),
+	                            meters);
+	ETA_Speech_EndReport();
+}
+
+
+static void ETA_NarrateStairsAhead(void)
+{
+	static int lastSpoken = -1;
+	static int lastTime;
+
+	const playerState_t *ps;
+	vec3_t               angles, forward;
+	float                footZ, first, second, speedSq;
+	ETA_Stairs           kind;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer)
+	{
+		lastSpoken = -1;
+		return;
+	}
+
+	ps = &cg.predictedPlayerState;
+
+	/* Only from the ground. In the air every reading is about wherever
+	   the player has fallen to by the time it is spoken. */
+	if (ps->groundEntityNum == ENTITYNUM_NONE)
+	{
+		lastSpoken = -1;
+		return;
+	}
+
+	/* A ladder is not a staircase and swimming is not walking; both have
+	   their own narration and neither wants this one talking over it. */
+	if ((ps->pm_flags & PMF_LADDER) || ETA_WaterLevel() > 1)
+	{
+		lastSpoken = -1;
+		return;
+	}
+
+	speedSq = ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1];
+
+	if (speedSq > 40.0f * 40.0f)
+	{
+		forward[0] = ps->velocity[0];
+		forward[1] = ps->velocity[1];
+		forward[2] = 0.0f;
+		VectorNormalize(forward);
+	}
+	else
+	{
+		angles[PITCH] = 0.0f;
+		angles[YAW]   = cg.refdefViewAngles[YAW];
+		angles[ROLL]  = 0.0f;
+		AngleVectors(angles, forward, NULL, NULL);
+	}
+
+	footZ = ps->origin[2] + ps->mins[2];
+
+	if (!ETA_GroundRiseAhead(ps, forward, ETA_STAIR_NEAR, footZ, &first))
+	{
+		lastSpoken = -1;
+		return;
+	}
+
+	if (first > ETA_STAIR_MIN_RISE)
+	{
+		kind = ETA_STAIRS_STEP_UP;
+	}
+	else if (first < -ETA_STAIR_MIN_RISE)
+	{
+		kind = ETA_STAIRS_STEP_DOWN;
+	}
+	else
+	{
+		/* Level ground. Forgetting what was last said here is what lets
+		   walking away from a staircase and back to it be news again. */
+		lastSpoken = -1;
+		return;
+	}
+
+	/* The second tread is measured from the first, not from the player:
+	   three steps up is well past anything a trace from foot height
+	   could see, so measuring both against the feet would report every
+	   staircase as a single step. What is being asked is only whether
+	   the ground carries on the same way, which is true whatever the
+	   run of the steps - and it differs from map to map. */
+	if (ETA_GroundRiseAhead(ps, forward, ETA_STAIR_FAR, footZ + first, &second))
+	{
+		if (kind == ETA_STAIRS_STEP_UP && second > ETA_STAIR_MIN_RISE)
+		{
+			kind = ETA_STAIRS_UP;
+		}
+		else if (kind == ETA_STAIRS_STEP_DOWN && second < -ETA_STAIR_MIN_RISE)
+		{
+			kind = ETA_STAIRS_DOWN;
+		}
+	}
+
+	if ((int)kind == lastSpoken || cg.time - lastTime < ETA_STAIR_MIN_INTERVAL)
+	{
+		return;
+	}
+
+	lastSpoken = (int)kind;
+	lastTime   = cg.time;
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakStairs(kind);
+	ETA_Speech_EndReport();
+}
+
