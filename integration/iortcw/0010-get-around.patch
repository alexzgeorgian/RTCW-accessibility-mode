+		cvar = &eta_bumpVolume;
+		break;
+	default:
+		cvar = &eta_markerVolume;
+		break;
+	}
+	return ( 255 * ETA_VolumePercent( cvar ) ) / 100;
+}
+
+/* The bump's volume, 0 to 127, as a one-off sound is played. */
+int CG_AccessibilityBumpVolume( void ) {
+	return ( 127 * ETA_VolumePercent( &eta_bumpVolume ) ) / 100;
+}
