diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index 8466d7ed..782268b7 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -3327,7 +3327,46 @@ static qboolean ETA_JumpAssistFrame(const usercmd_t *cmd)
 	toward[2] = 0.0f;
 	/* Going toward where the way's jump lands: not stopped at its edge.
 	   The jump is the player's own, with space. */
-	return (qboolean)( fabsf(AngleSubtract(ps->viewangles[YAW], vectoyaw(toward))) <= 35.0f );
+	if (fabsf(AngleSubtract(ps->viewangles[YAW], vectoyaw(toward))) > 35.0f)
+	{
+		return qfalse;
+	}
+
+	/* And when to press it: a short sound, once, where a sighted player
+	   would - at the lip of a gap, or at the square before something to
+	   jump onto or over - early by the time it takes to hear it and
+	   press. The tester asked for it in place of the jump made for
+	   them. */
+	{
+		static vec3_t saidEdge;
+		static int    saidAt;
+		float         speed = sqrtf(ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1]);
+		float         early = 16.0f + speed * 0.20f, rise, walked;
+		vec3_t        flat;
+		qboolean      now, lip;
+		sfxHandle_t   sfx;
+
+		VectorSubtract(edgeAt, ps->origin, flat);
+		flat[2] = 0.0f;
+		now = (qboolean)( VectorLength(flat) < early );
+		if (!now && !up)
+		{
+			walked = ETA_StairsKeepProbe(ps->viewangles[YAW], &rise, &lip);
+			now    = (qboolean)( lip && walked <= early );
+		}
+		if (now && cmd->upmove <= 0
+		    && ( Distance(saidEdge, edgeAt) > 8.0f || cg.time - saidAt > 3000 || cg.time < saidAt ))
+		{
+			VectorCopy(edgeAt, saidEdge);
+			saidAt = cg.time;
+			sfx    = CG_AccessibilityLoopSound(ETA_LOOP_JUMP_NOW);
+			if (sfx && CG_AccessibilityBumpVolume() > 0)
+			{
+				trap_S_StartLocalSound(sfx, CHAN_LOCAL_SOUND);
+			}
+		}
+	}
+	return qtrue;
 }
 
