+/* A ladder a little further than F climbs from: where it is, said, so
+   the player is not left to look for it - by the forest's watchtower,
+   beside the ramp. False when none within ten metres. */
+static qboolean ETA_SayLadderFurther(void)
+{
+	const float *at = cg.predictedPlayerState.origin;
+	vec3_t      foot, top, bestFoot;
+	float       bestFar = 10.0f / ETA_QU_TO_METERS;
+	int         l, meters;
+	qboolean    found = qfalse;
+
+	for (l = 0; l < CG_AccessibilityLadderCount(); l++)
+	{
+		float far;
+
+		if (!CG_AccessibilityLadderEnds(l, foot, top) || top[2] - foot[2] <= 64.0f || foot[2] - at[2] > 128.0f
+		    || at[2] - foot[2] > 80.0f)
+		{
+			continue;
+		}
+		far = sqrtf(( foot[0] - at[0] ) * ( foot[0] - at[0] ) + ( foot[1] - at[1] ) * ( foot[1] - at[1] ));
+		if (far < bestFar)
+		{
+			bestFar = far;
+			VectorCopy(foot, bestFoot);
+			found   = qtrue;
+		}
+	}
+	if (!found)
+	{
+		return qfalse;
+	}
+	meters = (int)( bestFar * ETA_QU_TO_METERS + 0.5f );
+	ETA_Speech_Say(va("Ladder up, %s, %d meters. A little closer, F climbs",
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(bestFoot)), meters));
+	return qtrue;
+}
