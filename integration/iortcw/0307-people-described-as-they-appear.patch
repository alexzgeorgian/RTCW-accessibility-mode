diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 14c7a9c8..7b1738ce 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -12620,6 +12620,56 @@ static const char *ETA_EnemyLooks(int aiChar)
 #define ETA_LOOKS_AFTER_MS 2500   /* after the first sight, so the enemy's own line is heard first */
 #define ETA_LOOKS_METERS   40.0f
 
+/*
+ * In a cutscene, a kind of enemy first seen by the camera: what it looks
+ * like, said as it appears. The tester heard the kinds described in the
+ * level after the cutscene that showed them, and asked for them when
+ * they first appear. The same remembered kinds as in play, so a kind
+ * told here is not told again in the level.
+ */
+void CG_AccessibilityCutsceneEnemiesFrame(void)
+{
+	static vmCvar_t met;
+	static qboolean registered;
+	int             n;
+
+	if (!registered)
+	{
+		trap_Cvar_Register(&met, "eta_enemiesMet", "0", CVAR_ARCHIVE);
+		registered = qtrue;
+	}
+	trap_Cvar_Update(&met);
+	if (!eta_enemyCues.integer || !cg.snap || !cg.cameraMode)
+	{
+		return;
+	}
+	for (n = 0; n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es   = &cg.snap->entities[n];
+		const centity_t     *cent = &cg_entities[es->number];
+		vec3_t              mid, to;
+		float               far;
+
+		if (es->eType != ET_PLAYER || !es->aiChar || es->aiChar >= 31 || ( es->eFlags & EF_DEAD )
+		    || !ETA_EnemyLooks(es->aiChar) || ( met.integer & ( 1 << es->aiChar ) ))
+		{
+			continue;
+		}
+		VectorCopy(cent->lerpOrigin, mid);
+		mid[2] += 24.0f;
+		VectorSubtract(mid, cg.refdef.vieworg, to);
+		far = VectorNormalize(to);
+		if (far * ETA_QU_TO_METERS > ETA_LOOKS_METERS || DotProduct(to, cg.refdef.viewaxis[0]) < 0.6f
+		    || !ETA_ClearLine(cg.refdef.vieworg, mid))
+		{
+			continue;
+		}
+		CG_AccessibilityCutscenePerson(ETA_EnemyLooks(es->aiChar));
+		trap_Cvar_Set("eta_enemiesMet", va("%d", met.integer | ( 1 << es->aiChar )));
+		return;
+	}
+}
+
 static void ETA_EnemyLooksFrame(void)
 {
 	static vmCvar_t met;
@@ -12635,6 +12685,7 @@ static void ETA_EnemyLooksFrame(void)
 		registered = qtrue;
 	}
 	trap_Cvar_Update(&met);
+
 	if (!eta_enemyCues.integer || !cg.snap || cg.cameraMode || ps->pm_type != PM_NORMAL || ps->stats[STAT_HEALTH] <= 0)
 	{
 		pendingKind = 0;
