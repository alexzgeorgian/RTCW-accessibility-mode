+/*
+ * A kind of enemy seen for the first time in a cutscene: what it looks
+ * like, said at the first gap in the talking - not first in the level
+ * after the cutscene that showed it (cg_accessibility_world.c).
+ */
+void CG_AccessibilityCutscenePerson( const char *text ) {
+	if ( !text || !text[0] || eta.numPending >= ETA_PENDING_LINES ) {
+		return;
+	}
+	Q_strncpyz( eta.pending[eta.numPending].text, text, sizeof( eta.pending[eta.numPending].text ) );
