diff --git a/SP/code/cgame/cg_accessibility_things.c b/SP/code/cgame/cg_accessibility_things.c
index 7b403d97..11be6b9a 100644
--- a/SP/code/cgame/cg_accessibility_things.c
+++ b/SP/code/cgame/cg_accessibility_things.c
@@ -288,6 +288,20 @@ static void ETA_ThingsSeed(void)
 		eta_things.things[j].goneAt    = 0;
 		eta_things.count++;
 	}
+
+	/* All the level's secrets found already - a save loaded after
+	   finding them: none is left to find. The tester, after emptying the
+	   church's secret room, still heard it on the list. */
+	if (eta_things.secrets > 0 && eta_things.secrets >= CG_AccessibilitySecretsTotal())
+	{
+		for (i = 0; i < eta_things.count; i++)
+		{
+			if (eta_things.things[i].kind == ETA_THING_SECRET)
+			{
+				eta_things.things[i].done = qtrue;
+			}
+		}
+	}
 }
 
