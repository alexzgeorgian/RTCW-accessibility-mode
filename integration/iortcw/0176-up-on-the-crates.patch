+/* Whether the marker is a place to stand - ground just under it, as
+   under a waypoint or a thing lying somewhere - rather than a switch on a
+   wall, which F reaches from the floor below. */
+static qboolean ETA_MarkerStoodOn(void)
+{
+	trace_t tr;
+	vec3_t  below;
+
+	VectorCopy(eta_marker.origin, below);
+	below[2] -= 40.0f;
+	CG_Trace(&tr, eta_marker.origin, NULL, NULL, below, cg.predictedPlayerState.clientNum, MASK_PLAYERSOLID);
+	return (qboolean)( !tr.startsolid && tr.fraction < 1.0f && tr.plane.normal[2] >= 0.7f );
+}
