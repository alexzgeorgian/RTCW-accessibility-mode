+/**
+ * @brief A running jump across a gap to the square at to: floor there at
+ *        about the height of from, and room for the player all the way
+ *        over at the top of a jump. The tram level's way out crosses a
+ *        two metre gap between two balconies.
+ */
+#define ETA_ROUTE_LEAP_RISE 40.0f   /* the top of a jump, a little short */
+
+static int ETA_RouteLeap(void *context, const float from[3], float to[3])
+{
+	static const vec3_t mins     = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs     = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	static const vec3_t footMins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f };
+	static const vec3_t footMaxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f - 18.0f };
+	trace_t trace;
+	vec3_t  start, end, down;
+
+	(void)context;
+
+	/* Up as a jump goes, and across at that height. */
+	VectorCopy(from, start);
+	VectorCopy(from, end);
+	end[2] += ETA_ROUTE_LEAP_RISE;
+	trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+	if (trace.startsolid || trace.fraction < 1.0f)
+	{
+		return ETA_PATH_NONE;
+	}
+	VectorCopy(end, start);
+	VectorSet(end, to[0], to[1], start[2]);
+	trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+	if (trace.startsolid || trace.fraction < 1.0f)
+	{
+		return ETA_PATH_NONE;
+	}
+
+	/* Floor to land on, no lower than a little below the edge. */
+	VectorCopy(end, start);
+	VectorCopy(end, down);
+	down[2] = from[2] - 48.0f;
+	trap_CM_BoxTrace(&trace, start, down, footMins, footMaxs, 0, MASK_PLAYERSOLID);
+	if (trace.startsolid || trace.allsolid || trace.fraction >= 1.0f || trace.plane.normal[2] < 0.7f
+	    || trace.endpos[2] > from[2] + 8.0f)
+	{
+		return ETA_PATH_NONE;
+	}
+	if (CG_PointContents(trace.endpos, -1) & (CONTENTS_LAVA | CONTENTS_SLIME))
+	{
+		return ETA_PATH_NONE;
+	}
+	to[2] = trace.endpos[2];
+
+	/* Room to stand there. */
+	{
+		float landed[3];
+
+		VectorCopy(to, landed);
+		if (!ETA_RouteRoom(to, landed, 0.0f, ETA_ROUTE_BODY_TOP))
+		{
+			return ETA_PATH_NONE;
+		}
+	}
+	return ETA_PATH_JUMP;
+}
