+/* Whether the top found is reached from the ladder's head, with no wall
+   between: the ladder up from the last tram station has a wall over its
+   head, and the floor found past it was another room's, behind a door
+   only the soldiers open. The player at its top steps off onto the
+   ledge on its own side. */
+static qboolean ETA_LadderTopReached(const vec3_t centre, const vec3_t top)
+{
+	trace_t trace;
+	vec3_t  from, to;
+
+	/* From just off the ladder on that side, at standing height. */
+	vec3_t dir;
+	float  far;
+
+	VectorSubtract(top, centre, dir);
+	dir[2] = 0.0f;
+	far    = VectorNormalize(dir);
+	if (far < 1.0f)
+	{
+		return qtrue;
+	}
+	VectorMA(centre, MIN(far, 12.0f), dir, from);
+	from[2] = top[2] + 16.0f;
+	VectorSet(to, top[0], top[1], top[2] + 16.0f);
+	trap_CM_BoxTrace(&trace, from, to, NULL, NULL, 0, MASK_PLAYERSOLID);
+	if (trace.startsolid)
+	{
+		from[2] = top[2] + 32.0f;
+		to[2]   = top[2] + 32.0f;
+		trap_CM_BoxTrace(&trace, from, to, NULL, NULL, 0, MASK_PLAYERSOLID);
+	}
+	return (qboolean)( !trace.startsolid && trace.fraction >= 1.0f );
+}
+
+/* A ladder's end moved, if it must, to where the way's own body fits:
+   on along the way off the ladder, or to one side. */
+static void ETA_LadderEndClear(vec3_t at, const vec3_t out)
+{
+	/* The player's own width, which the way's room test takes. */
+	static const vec3_t mins = { -18.0f, -18.0f, -24.0f + 18.0f };
+	static const vec3_t maxs = { 18.0f, 18.0f, 24.0f };
+	vec3_t  side, tried;
+	trace_t trace;
+	float   far;
+	int     k;
+
+	trap_CM_BoxTrace(&trace, at, at, mins, maxs, 0, MASK_PLAYERSOLID);
+	if (!trace.startsolid)
+	{
+		return;
+	}
+	VectorSet(side, -out[1], out[0], 0.0f);
+	for (far = 4.0f; far <= 24.0f; far += 4.0f)
+	{
+		for (k = 0; k < 3; k++)
+		{
+			const float *dir = k == 0 ? out : side;
+			float        sign = k == 2 ? -1.0f : 1.0f;
+
+			VectorMA(at, far * sign, dir, tried);
+			trap_CM_BoxTrace(&trace, tried, tried, mins, maxs, 0, MASK_PLAYERSOLID);
+			if (!trace.startsolid)
+			{
+				VectorCopy(tried, at);
+				return;
+			}
+		}
+	}
+}
