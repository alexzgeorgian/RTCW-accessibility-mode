+/**
+ * @brief Where the marker is and what it is called, for the words said
+ * when the player is turned to face the way. qfalse with no marker.
+ */
+qboolean CG_AccessibilityMarkerInfo(vec3_t origin, const char **name)
+{
+	if (!eta_marker.active)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_marker.origin, origin);
+	*name = eta_marker.name;
+	return qtrue;
+}
