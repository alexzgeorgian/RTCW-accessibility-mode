+/**
+ * @brief The way, told while the player walks it.
+ *
+ * With a marker set and the walk key down, a turn of the way is said as
+ * it comes - "Way goes left", "Way goes right", "Way goes back" - once
+ * the way has been off to that side for a moment, and not again until it
+ * changes or a few seconds have gone; the marker's ping says the rest.
+ * Held against something, the way's direction is said, and a door ahead
+ * that opens from a switch elsewhere is said with where the switch is,
+ * and chosen for F. The steering is the player's.
+ */
+#define ETA_WAYCUE_SETTLE_MS 400
+#define ETA_WAYCUE_GAP_MS    1500
+#define ETA_WAYCUE_REPEAT_MS 4000
+
+static struct
+{
+	int    side;      /* where the way is now: 0 ahead, -1 left, 1 right, 2 back */
+	int    sideSince;
+	int    saidSide;
+	int    saidAt;
+	vec3_t stillFrom;
+	int    stillAt;
+	int    switchDoor;
+	int    switchAt;
+} eta_wayCue;
+
+static void ETA_WayCueSwitch(void)
+{
+	vec3_t doorAt, opener;
+	int    door = CG_AccessibilityDoorAheadModel(doorAt);
+
+	if (!door || !CG_AccessibilityDoorOpener(door, doorAt, opener)
+	    || (door == eta_wayCue.switchDoor && cg.time - eta_wayCue.switchAt < 10000 && cg.time >= eta_wayCue.switchAt))
+	{
+		return;
+	}
+
+	eta_wayCue.switchDoor = door;
+	eta_wayCue.switchAt   = cg.time;
+
+	/* A switch out of sight from here is on the door's far side - the
+	   dungeon has one: that door is no way through from this side, and
+	   the way goes round it. */
+	{
+		trace_t trace;
+		vec3_t  eye, toward, seen;
+
+		VectorCopy(cg.predictedPlayerState.origin, eye);
+		eye[2] += cg.predictedPlayerState.viewheight;
+		VectorSubtract(eye, opener, toward);
+		VectorNormalize(toward);
+		VectorMA(opener, 12.0f, toward, seen);
+		CG_Trace(&trace, eye, NULL, NULL, seen, cg.predictedPlayerState.clientNum, MASK_SOLID);
+		if (trace.fraction < 1.0f)
+		{
+			CG_AccessibilityMarkerBlocked(doorAt, 56.0f);
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("This door opens from the other side. Finding another way. O faces it");
+			return;
+		}
+	}
+
+	/* Chosen, as K would choose it: F turns to it. */
+	memset(&eta_choose.target, 0, sizeof(eta_choose.target));
+	eta_choose.target.entityNum = -1;
+	VectorCopy(opener, eta_choose.target.point);
+	Q_strncpyz(eta_choose.target.name, "Switch", sizeof(eta_choose.target.name));
+	eta_choose.held = qtrue;
+	eta_choose.at   = cg.time;
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_AimSay("This door opens with a switch. F turns to it. Switch", opener);
+}
+
+static void ETA_WayCueFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	usercmd_t           cmd;
+	vec3_t              target, delta;
+	float               rel;
+	int                 side;
+
+	if (eta_autoSteer.integer || cg.cameraMode || !cg.snap || ps->pm_type != PM_NORMAL
+	    || !CG_AccessibilityMarkerSteerPoint(target)
+	    || !trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd) || cmd.forwardmove <= 0)
+	{
+		eta_wayCue.side    = 0;
+		eta_wayCue.stillAt = 0;
+		return;
+	}
+
+	VectorSubtract(target, ps->origin, delta);
+	delta[2] = 0.0f;
+	if (VectorLength(delta) < 24.0f)
+	{
+		return;
+	}
+
+	/* Positive is to the left: the engine's own sense. */
+	rel  = AngleNormalize180(vectoyaw(delta) - ps->viewangles[YAW]);
+	side = fabs(rel) < 35.0f ? 0 : fabs(rel) > 125.0f ? 2 : (rel > 0.0f ? -1 : 1);
+
+	if (side != eta_wayCue.side)
+	{
+		eta_wayCue.side      = side;
+		eta_wayCue.sideSince = cg.time;
+	}
+
+	if (!side)
+	{
+		eta_wayCue.saidSide = 0;
+	}
+	else if (cg.time - eta_wayCue.sideSince >= ETA_WAYCUE_SETTLE_MS
+	         && (cg.time - eta_wayCue.saidAt >= ETA_WAYCUE_GAP_MS || cg.time < eta_wayCue.saidAt)
+	         && (side != eta_wayCue.saidSide || cg.time - eta_wayCue.saidAt >= ETA_WAYCUE_REPEAT_MS))
+	{
+		eta_wayCue.saidSide = side;
+		eta_wayCue.saidAt   = cg.time;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(side == 2 ? "Way goes back" : side < 0 ? "Way goes left" : "Way goes right");
+	}
+
+	/* Walking and getting nowhere: which way the way goes from here, and
+	   the switch of a door in the way. */
+	if (!eta_wayCue.stillAt || cg.time < eta_wayCue.stillAt
+	    || Distance(ps->origin, eta_wayCue.stillFrom) > ETA_GUIDE_STUCK_MOVE)
+	{
+		eta_wayCue.stillAt = cg.time;
+		VectorCopy(ps->origin, eta_wayCue.stillFrom);
+	}
+	else if (cg.time - eta_wayCue.stillAt >= ETA_GUIDE_STUCK_MS)
+	{
+		const char *what;
+		qboolean    plain = qfalse;
+		etaLadder_t ladder;
+
+		eta_wayCue.stillAt = cg.time;
+		ETA_WayCueSwitch();
+
+		/* What the way wants here, when it is not a walk: the key for
+		   it. Otherwise the way's direction - and, held against
+		   something the way did not expect, the way round it. */
+		if (eta_wayCue.switchAt == cg.time)
+		{
+			what  = NULL;   /* the switch was just said */
+		}
+		else if (CG_AccessibilityDoorAhead())
+		{
+			what = "Door here: F opens it";
+		}
+		else if (CG_AccessibilityMarkerJumpNow())
+		{
+			what = "Jump here: Space while walking";
+		}
+		else if (CG_AccessibilityMarkerLadderNext() && CG_AccessibilityLadderNear(&ladder) && ladder.meters <= 2.0f)
+		{
+			what = "Ladder here: F climbs";
+		}
+		else if (CG_AccessibilityMarkerCrouchNow())
+		{
+			what = "Low here: crouch with C";
+		}
+		else
+		{
+			vec3_t forward, ahead;
+
+			AngleVectors(ps->viewangles, forward, NULL, NULL);
+			forward[2] = 0.0f;
+			VectorNormalize(forward);
+			VectorMA(ps->origin, 40.0f, forward, ahead);
+			if (fabs(rel) < 35.0f)
+			{
+				/* Facing the way and held still: what is in front is
+				   no way through, whatever the search made of it. */
+				CG_AccessibilityMarkerBlocked(ahead, 32.0f);
+				what = "Blocked. Finding a way round. O faces it";
+			}
+			else
+			{
+				what  = va("Blocked. The way goes %s. O faces it", ETA_HudNarrator_RelativeDirection(rel));
+				plain = qtrue;
+			}
+		}
+
+		if (what && (cg.time - eta_wayCue.saidAt >= ETA_WAYCUE_REPEAT_MS || cg.time < eta_wayCue.saidAt || !plain))
+		{
+			eta_wayCue.saidAt   = cg.time;
+			eta_wayCue.saidSide = side;
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(what);
+		}
+	}
+}
+
+/**
+ * @brief O again: turned to face the way, once, and how far is left.
+ */
+void CG_AccessibilityFaceTheWay(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              target, origin, delta;
+	const char          *name;
+	char                height[48];
+	int                 meters;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || !CG_AccessibilityMarkerSteerPoint(target)
+	    || !CG_AccessibilityMarkerInfo(origin, &name))
+	{
+		return;
+	}
+
+	VectorSubtract(target, ps->origin, delta);
+	delta[2] = 0.0f;
+	if (VectorLength(delta) >= 16.0f)
+	{
+		etaAimTarget_t way;
+
+		memset(&way, 0, sizeof(way));
+		way.entityNum = -1;
+		VectorCopy(target, way.point);
+		way.point[2] = ps->origin[2] + ps->viewheight;
+		ETA_AimStartSnap(&way, NULL);
+	}
+
+	VectorSubtract(origin, ps->origin, delta);
+	meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
+	ETA_HudNarrator_HeightText(delta[2] * ETA_QU_TO_METERS, height, sizeof(height));
+	ETA_HudNarrator_HoldPassive(cg.time);
+	{
+		char what[48];
+
+		Q_strncpyz(what, name, sizeof(what));
+		what[0] = (char)toupper((unsigned char)what[0]);
+		ETA_Speech_Say(va("Facing the way. %s, %d meters%s%s", what, meters < 1 ? 1 : meters,
+		                  height[0] ? ", " : "", height));
+	}
+}
+
 /**
