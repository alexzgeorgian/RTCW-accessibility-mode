+/*
+ * For the explored places' list: the things left outdoors, in no area,
+ * grouped where they lie within 15 metres of each other - the first one's
+ * name, where it lies, and how many. The tester, back through the places
+ * explored with semicolon, did not find the Colt's drop in the forest,
+ * health still lying there: it is in no area. qfalse groups past max.
+ */
+#define ETA_THINGS_OUTDOOR_GROUP 600.0f
+
+int CG_AccessibilityThingsOutdoors(vec3_t *at, char (*what)[48], int *count, int max)
+{
+	int i, g, n = 0;
+
+	ETA_ThingsRecord();
+	for (i = 0; i < eta_things.count; i++)
+	{
+		const eta_thing_t *thing = &eta_things.things[i];
+
+		if (thing->done || thing->pressed || thing->ride || !thing->known
+		    || CG_AccessibilityAreaOf(thing->point) >= 0)
+		{
+			continue;
+		}
+		for (g = 0; g < n; g++)
+		{
+			if (Distance(at[g], thing->point) < ETA_THINGS_OUTDOOR_GROUP)
+			{
+				count[g]++;
+				break;
+			}
+		}
+		if (g == n && n < max)
+		{
+			VectorCopy(thing->point, at[n]);
+			Q_strncpyz(what[n], thing->name, sizeof(what[0]));
+			count[n++] = 1;
+		}
+	}
+	return n;
+}
