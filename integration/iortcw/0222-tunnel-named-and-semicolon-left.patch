+/*
+ * A tunnel on the way (CG_AccessibilityInTunnel): said as the way comes
+ * to it, within 25 metres, and as the player goes in and comes out. The
+ * tester, led to the Snooper rifle through the forest's tunnel, did not
+ * know there was one, nor where it was. Looked at twice a second.
+ */
+#define ETA_ROUTE_TUNNEL_AHEAD 30      /* points of the way looked along, 32 units each */
+#define ETA_ROUTE_TUNNEL_AGAIN 1500.0f /* this far from the last said: another tunnel */
+
+static struct
+{
+	int      lookAt;
+	qboolean in;
+	qboolean said;
+	vec3_t   saidAt;
+} eta_routeTunnel;
+
+static void ETA_RouteTunnel(ETA_PathState state, const vec3_t here)
+{
+	int    count = ETA_PathFinder_PointCount(), i;
+	vec3_t point;
+
+	if (( state != ETA_PATH_FOUND && state != ETA_PATH_PARTIAL ) || cg.time < eta_routeTunnel.lookAt
+	    || cg.time - eta_routeTunnel.lookAt < 500)
+	{
+		if (cg.time < eta_routeTunnel.lookAt)
+		{
+			eta_routeTunnel.lookAt = cg.time;
+		}
+		return;
+	}
+	eta_routeTunnel.lookAt = cg.time;
+
+	if (CG_AccessibilityInTunnel(here))
+	{
+		if (!eta_routeTunnel.in)
+		{
+			eta_routeTunnel.in = qtrue;
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say("In the tunnel");
+			ETA_Speech_EndReport();
+		}
+		return;
+	}
+	if (eta_routeTunnel.in)
+	{
+		eta_routeTunnel.in = qfalse;
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say("Out of the tunnel");
+		ETA_Speech_EndReport();
+		return;
+	}
+	for (i = eta_route.along + 1; i < count && i <= eta_route.along + ETA_ROUTE_TUNNEL_AHEAD; i++)
+	{
+		ETA_PathFinder_Point(i, point);
+		if (!CG_AccessibilityInTunnel(point))
+		{
+			continue;
+		}
+		if (eta_routeTunnel.said && Distance(point, eta_routeTunnel.saidAt) < ETA_ROUTE_TUNNEL_AGAIN)
+		{
+			return;
+		}
+		eta_routeTunnel.said = qtrue;
+		VectorCopy(point, eta_routeTunnel.saidAt);
+		{
+			int meters = (int)( Distance(here, point) * ETA_QU_TO_METERS + 0.5f );
+
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say(va("A tunnel ahead, %d %s: the way goes through it", meters < 1 ? 1 : meters,
+			                  meters == 1 ? "meter" : "meters"));
+			ETA_Speech_EndReport();
+		}
+		return;
+	}
+}
