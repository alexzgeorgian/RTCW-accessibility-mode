+/* Asked for: from the start, or Check for updates. */
+static void UI_AccessibilityUpdateCheck( void ) {
+	if ( UI_AccessibilityBuildNumber( ETA_Update_InstalledVersion() ) <= 0 ) {
+		uiUpdate.state = UI_UPDATE_NONE;
+		ETA_Speech_Say( "A test build made by hand does not check for updates" );
+		return;
+	}
+	if ( !ETA_WindowsUpdate_StartFetch( UI_UPDATE_MANIFEST_URL ) ) {
+		uiUpdate.state = UI_UPDATE_NONE;
+		ETA_Speech_Say( "Could not check for updates" );
+		return;
+	}
+	uiUpdate.state = UI_UPDATE_CHECKING;
+	ETA_Speech_Say( "Checking for updates" );
+}
