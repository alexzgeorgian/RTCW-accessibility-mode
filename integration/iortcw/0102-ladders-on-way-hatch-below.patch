 qboolean CG_AccessibilityLadderNear(etaLadder_t *out)
 {
 	const playerState_t *ps = &cg.predictedPlayerState;
@@ -6634,6 +6694,58 @@ static void ETA_DoorMiddle(int model, const vec3_t entityOrigin, vec3_t out)
  * door with this brush model: qfalse when it is opened by using it - its
  * opener wrapped round the door itself - or there is no other.
  */
+/* A switch on a door itself - a hatch's underside - within reach of the
+   door: there is one, and where. */
+qboolean CG_AccessibilityDoorOwnSwitch(int model, const vec3_t doorAt, vec3_t out)
+{
+	int k;
+
+	for (k = 0; model > 0 && model < MAX_MODELS && k < ETA_DOOR_OPENERS && eta_doorOpeners[model][k]; k++)
+	{
+		const float *at = cgs.inlineModelMidpoints[eta_doorOpeners[model][k]];
+
+		if (Distance(at, doorAt) <= 96.0f)
+		{
+			VectorCopy(at, out);
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/* On a ladder under a hatch shut over it: where to press to open it - a
+   switch on the hatch, within 160 units above the eye. */
+qboolean CG_AccessibilityHatchSwitchAbove(vec3_t out)
+{
+	vec3_t eye;
+	int    model;
+
+	VectorCopy(cg.predictedPlayerState.origin, eye);
+	eye[2] += cg.predictedPlayerState.viewheight;
+	for (model = 1; model < MAX_MODELS; model++)
+	{
+		vec3_t   mins, maxs, mid;
+		qboolean opens;
+
+		if (!CG_AccessibilityDoorBox(model, mins, maxs, &opens) || opens || maxs[2] - mins[2] > 48.0f
+		    || mins[2] < eye[2] - 16.0f || mins[2] > eye[2] + 160.0f
+		    || eye[0] < mins[0] - 48.0f || eye[0] > maxs[0] + 48.0f || eye[1] < mins[1] - 48.0f || eye[1] > maxs[1] + 48.0f)
+		{
+			continue;
+		}
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		if (CG_AccessibilityDoorOwnSwitch(model, mid, out))
+		{
+			return qtrue;
+		}
+		VectorCopy(mid, out);
+		out[2] = mins[2];
+		return qtrue;
+	}
+	return qfalse;
+}
