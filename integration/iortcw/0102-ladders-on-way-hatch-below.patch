+/* The ladder the way takes next: where it gets on, and up or down. */
+qboolean CG_AccessibilityMarkerLadderFrom(vec3_t from, qboolean *up)
+{
+	if (!eta_marker.active || !eta_route.ladderNext)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_route.ladderFrom, from);
+	*up = eta_route.ladderUp;
+	return qtrue;
+}
