diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index acb3486a..aa526498 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -3317,6 +3317,66 @@ static void ETA_LadderCentre(etaLadder_t *ladder)
  * Everything is the map's own collision, the same traces the game makes,
  * so a ladder that is said is one the game will let the player climb.
  */
+/* A ladder of the map's whose foot or top - where the way-finder gets on
+   it - is within reach of the player: its face, at the player's height,
+   for a climb begun a step or two off. qfalse for none. */
+qboolean CG_AccessibilityLadderOnWay(float reach, etaLadder_t *out)
+{
+	const float *me = cg.predictedPlayerState.origin;
+	int          i;
+	vec3_t       wayFrom;
+	qboolean     wayUp, onWay = CG_AccessibilityMarkerLadderFrom(wayFrom, &wayUp);
+
+	for (i = 0; i < eta_mapLadderCount; i++)
+	{
+		const ETA_BspLadder *ladder = &eta_mapLadders[i];
+		qboolean             atFoot;
+		vec3_t               centre, toMe;
+		int                  axis;
+
+		if (!eta_ladderJoins[i])
+		{
+			continue;
+		}
+		atFoot = (qboolean)( Distance(me, eta_ladderFoot[i]) <= reach && fabsf(me[2] - eta_ladderFoot[i][2]) < 48.0f );
+		if (!atFoot && !( Distance(me, eta_ladderTop[i]) <= reach && fabsf(me[2] - eta_ladderTop[i][2]) < 48.0f ))
+		{
+			continue;
+		}
+		/* The one the way takes, when it takes one: the end it gets on
+		   at. Just come up a ladder, its top is near, and the way goes on
+		   up another. */
+		if (onWay)
+		{
+			if (Distance(wayFrom, wayUp ? eta_ladderFoot[i] : eta_ladderTop[i]) > 96.0f)
+			{
+				continue;
+			}
+			atFoot = wayUp;
+		}
+		memset(out, 0, sizeof(*out));
+		VectorAdd(ladder->mins, ladder->maxs, centre);
+		VectorScale(centre, 0.5f, centre);
+		centre[2] = me[2];
+		VectorCopy(ladder->normal, out->normal);
+		VectorSubtract(atFoot ? eta_ladderFoot[i] : eta_ladderTop[i], centre, toMe);
+		toMe[2] = 0.0f;
+		if (DotProduct(toMe, out->normal) < 0.0f)
+		{
+			VectorNegate(out->normal, out->normal);
+		}
+		axis = Q_fabs(ladder->normal[0]) > 0.5f ? 0 : 1;
+		/* The face: the box's side toward the way's square. */
+		centre[axis] = out->normal[axis] > 0.0f ? ladder->maxs[axis] : ladder->mins[axis];
+		VectorCopy(centre, out->point);
+		out->goesUp = atFoot;
+		out->behind = qfalse;
+		out->meters = Distance(me, centre) * ETA_QU_TO_METERS;
+		return qtrue;
+	}
+	return qfalse;
+}
