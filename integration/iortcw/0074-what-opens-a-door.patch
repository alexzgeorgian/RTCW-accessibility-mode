+/* The spot that unlocks a door, the first not yet used: for X, and for T
+   with the things of the door's area. qfalse with none. */
+qboolean CG_AccessibilityUnlockSpotForDoor(int model, vec3_t at, int *index)
+{
+	int i, j;
+
+	for (i = 0; i < eta_unlockSpotCount; i++)
+	{
+		if (eta_unlockSpots[i].door != model || CG_AccessibilityUnlockState(i) == 2
+		    || Q_stricmpn(eta_unlockSpots[i].name, "Spot that unlocks", 17))
+		{
+			continue;
+		}
+		/* One that works first. */
+		for (j = i; j < eta_unlockSpotCount; j++)
+		{
+			if (eta_unlockSpots[j].door == model && CG_AccessibilityUnlockState(j) == 1
+			    && !Q_stricmpn(eta_unlockSpots[j].name, "Spot that unlocks", 17))
+			{
+				i = j;
+				break;
+			}
+		}
+		VectorCopy(eta_unlockSpots[i].at, at);
+		*index = i;
+		return qtrue;
+	}
+	return qfalse;
+}
