 /* Whether a thing at a point is in the area the player is in. */
+static qboolean ETA_AreaExitOpens(const eta_areaExit_t *exit);
+
+/* Whether what opens a door, at a point, is on its far side from an area:
+   well through the door, and not in the area. A switch set in the wall
+   beside the door is on neither side, and counts as this one's. */
+static qboolean ETA_AreaBeyondDoor(const eta_areaExit_t *exit, int area, const vec3_t at)
+{
+	int    mine = exit->area[0] == area ? 0 : 1;
+	vec3_t through, off;
+
+	VectorSubtract(exit->side[1 - mine], exit->side[mine], through);
+	through[2] = 0.0f;
+	if (VectorNormalize(through) < 1.0f)
+	{
+		return qfalse;
+	}
+	VectorSubtract(at, exit->middle, off);
+	off[2] = 0.0f;
+	return (qboolean)( DotProduct(off, through) > 48.0f && ETA_AreaOf(at) != area );
+}
+
+/* Whether a point is the switch that opens a locked door out of an area. */
+static qboolean ETA_AreaDoorSwitch(int area, const vec3_t at)
+{
+	int i;
+
+	for (i = 0; i < eta_areas.exitCount; i++)
+	{
+		const eta_areaExit_t *exit = &eta_areas.exits[i];
+		vec3_t               opener;
+
+		int                  spot;
+
+		if (exit->model <= 0 || ( exit->area[0] != area && exit->area[1] != area ) || ETA_AreaExitOpens(exit))
+		{
+			continue;
+		}
+		/* Not one beyond the door: it is that area's own already. */
+		if (( CG_AccessibilityDoorOpener(exit->model, exit->middle, opener)
+		      || CG_AccessibilityUnlockSpotForDoor(exit->model, opener, &spot) ) && Distance(opener, at) < 48.0f
+		    && !ETA_AreaBeyondDoor(exit, area, opener))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
