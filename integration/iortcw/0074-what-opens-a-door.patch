+		Q_strncpyz(why, bySpot ? CG_AccessibilityUnlockWhy(spot) : "", sizeof(why));
+		ETA_Speech_Say(va("%d of %d, %s%s%s%s, %s, %d %s%s%s. %s", eta_areas.listPos + 1,
+		                  eta_areas.listCount, where,
+		                  !shut ? "" : beyond ? ", locked from this side: what opens it is on the other side, so find another way round"
+		                  : bySwitch ? ", locked, a switch opens it"
+		                  : bySpot ? ", locked, a spot unlocks it"
+		                  : CG_AccessibilityDoorNeverOpens(exit->model) ? ", locked for good"
+		                  : CG_AccessibilityDoorLive(exit->model) == 'S' ? ", opened by a switch or by what happens" : ", locked",
+		                  why[0] ? ". The spot is" : "", why[0] ? why + 1 : "",
