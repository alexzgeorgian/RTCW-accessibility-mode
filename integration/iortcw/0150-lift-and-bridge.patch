+static void ETA_LiftScriptLine(const char *a, const char *b, const char *c, const char *d, void *context)
+{
+	eta_liftSearch_t *search = (eta_liftSearch_t *)context;
+	int               i;
+
+	(void)c;
+	(void)d;
+	if (!Q_stricmp(a, "gotomarker") && b[0])
+	{
+		for (i = 0; i < eta_cornerCount; i++)
+		{
+			if (!Q_stricmp(eta_corners[i].targetname, b))
+			{
+				search->rises = (qboolean)( search->rises || eta_corners[i].at[2] > search->above );
+				break;
+			}
+		}
+	}
+	else if (!Q_stricmp(a, "alertentity") && b[0] && search->alertCount < (int)ARRAY_LEN(search->alerts))
+	{
+		Q_strncpyz(search->alerts[search->alertCount++], b, sizeof(search->alerts[0]));
+	}
+}
