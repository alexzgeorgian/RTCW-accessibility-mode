+/* The lifts, each frame: come down to the floor, riding, the bridge. */
+static void ETA_LiftsFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  l;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode || cg.time - cgs.levelStartTime < 3000)
+	{
+		return;
+	}
+	for (l = 0; l < eta_liftCount; l++)
+	{
+		const entityState_t *lift = NULL, *bridge = NULL;
+		vec3_t               mins, maxs, tmins, tmaxs, at;
+		qboolean             moving, ready;
+		float                top;
+		int                  n, meters;
+
+		for (n = 0; n < cg.snap->numEntities; n++)
+		{
+			const entityState_t *es = &cg.snap->entities[n];
+
+			if (es->eType == ET_MOVER && es->modelindex == eta_lifts[l].mover)
+			{
+				lift = es;
+			}
+			else if (es->eType == ET_MOVER && eta_lifts[l].bridge && es->modelindex == eta_lifts[l].bridge)
+			{
+				bridge = es;
+			}
+		}
+		if (!lift)
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[eta_lifts[l].mover], mins, maxs);
+		trap_R_ModelBounds(cgs.inlineDrawModel[eta_lifts[l].trigger], tmins, tmaxs);
+		top    = cg_entities[lift->number].lerpOrigin[2] + maxs[2];
+		moving = (qboolean)( lift->pos.trType != TR_STATIONARY && cg.time < lift->pos.trTime + lift->pos.trDuration );
+		ready  = (qboolean)( !moving && top >= tmins[2] - 8.0f && top <= tmaxs[2] + 4.0f );
+		VectorAdd(tmins, tmaxs, at);
+		VectorScale(at, 0.5f, at);
+
+		/* Come down to the floor: what to do, and O leads there. */
+		if (ready && !eta_lifts[l].announced && ps->groundEntityNum != lift->number)
+		{
+			meters = (int)( Distance(ps->origin, at) * ETA_QU_TO_METERS + 0.5f );
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(va("A lift has come down level with the floor, %s, %d %s: stand on it, and it lifts you up. "
+			                  "O leads there", ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at)),
+			                  meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters"));
+			CG_AccessibilityChoose(at, "the lift");
+			eta_lifts[l].announced = qtrue;
+		}
+		else if (!ready && !moving && eta_lifts[l].seen && ps->groundEntityNum != lift->number)
+		{
+			eta_lifts[l].announced = qfalse;   /* gone back up: said again when it next comes down */
+		}
+		eta_lifts[l].seen = qtrue;
+
+		/* Riding it. */
+		/* Its moves run on one from another, a moment apart: at the top
+		   only once it has stood still a second. */
+		if (ps->groundEntityNum == lift->number && moving && lift->pos.trDelta[2] > 0.0f && !eta_lifts[l].riding)
+		{
+			eta_lifts[l].riding = qtrue;
+			ETA_Speech_Say(eta_lifts[l].bridge ? "Going up. A bridge comes out as you rise: wait for it" : "Going up");
+		}
+		if (eta_lifts[l].riding && moving)
+		{
+			eta_lifts[l].stillSince = 0;
+		}
+		else if (eta_lifts[l].riding && !eta_lifts[l].stillSince)
+		{
+			eta_lifts[l].stillSince = cg.time;
+		}
+		else if (eta_lifts[l].riding && ( cg.time - eta_lifts[l].stillSince > 1000 || cg.time < eta_lifts[l].stillSince ))
+		{
+			eta_lifts[l].riding = qfalse;
+			if (ps->groundEntityNum == lift->number)
+			{
+				ETA_Speech_Say("At the top");
+			}
+		}
+
+		/* The bridge: out when it comes up to the lift. */
+		if (bridge && Distance(ps->origin, cg_entities[lift->number].lerpOrigin) < 1200.0f)
+		{
+			vec3_t   bmins, bmaxs, lmins, lmaxs, mid;
+			qboolean bmoving = (qboolean)( bridge->pos.trType != TR_STATIONARY
+			                               && cg.time < bridge->pos.trTime + bridge->pos.trDuration );
+			qboolean out;
+			float    gap = 0.0f;
+			int      k;
+
+			trap_R_ModelBounds(cgs.inlineDrawModel[eta_lifts[l].bridge], bmins, bmaxs);
+			VectorAdd(bmins, cg_entities[bridge->number].lerpOrigin, bmins);
+			VectorAdd(bmaxs, cg_entities[bridge->number].lerpOrigin, bmaxs);
+			VectorAdd(mins, cg_entities[lift->number].lerpOrigin, lmins);
+			VectorAdd(maxs, cg_entities[lift->number].lerpOrigin, lmaxs);
+			for (k = 0; k < 2; k++)
+			{
+				gap = MAX(gap, MAX(bmins[k] - lmaxs[k], lmins[k] - bmaxs[k]));
+			}
+			out = (qboolean)( gap < 24.0f );
+			VectorAdd(bmins, bmaxs, mid);
+			VectorScale(mid, 0.5f, mid);
+			if (bmoving && !eta_lifts[l].bridgeMoving)
+			{
+				ETA_Speech_Say(eta_lifts[l].bridgeOut ? "Bridge pulling back"
+				               : va("Bridge sliding out, %s: wait for it",
+				                    ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(mid))));
+			}
+			else if (!bmoving && eta_lifts[l].bridgeMoving && out)
+			{
+				ETA_HudNarrator_HoldPassive(cg.time);
+				ETA_Speech_Say(va("Bridge out, %s: cross now",
+				                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(mid))));
+			}
+			eta_lifts[l].bridgeMoving = bmoving;
+			if (!bmoving)
+			{
+				eta_lifts[l].bridgeOut = out;
+			}
+		}
+	}
+}
