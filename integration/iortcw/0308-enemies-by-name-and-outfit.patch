+/* The outfits told in this level: the same one is not told again in it. */
+static qboolean etaOutfitTold[ARRAY_LEN(etaOutfits)];
+static char     etaOutfitMap[MAX_QPATH];
+
+static void ETA_OutfitLevel(void)
+{
+	if (Q_stricmp(etaOutfitMap, cgs.mapname))
+	{
+		Q_strncpyz(etaOutfitMap, cgs.mapname, sizeof(etaOutfitMap));
+		memset(etaOutfitTold, 0, sizeof(etaOutfitTold));
+	}
+}
+
+/* An outfit not told yet in this level, of a character in sight: "Soldiers
+   here wear a white winter smock". NULL with none. */
+static const char *ETA_OutfitLine(const entityState_t *es, qboolean mark)
+{
+	int        o = ETA_Outfit(es);
+	const char *kind;
+
+	ETA_OutfitLevel();
+	if (o < 0 || etaOutfitTold[o])
+	{
+		return NULL;
+	}
+	if (mark)
+	{
+		etaOutfitTold[o] = qtrue;
+	}
+	kind = ETA_CharacterKind(es);
+	if (!Q_stricmp(kind, "Paratrooper"))
+	{
+		return va("Paratroopers are Black guards, SS men, who drop in by parachute. They are in %s", etaOutfits[o].looks);
+	}
+	return va("%ss here %s %s", kind, !Q_stricmp(etaOutfits[o].model, "blackguard") || !Q_stricmp(etaOutfits[o].model, "eliteguard")
+	          || !Q_stricmp(etaOutfits[o].model, "venom") ? "are in" : "wear", etaOutfits[o].looks);
+}
+
+/* The kind's own sentence for this character: none for the game's
+   officers and mechanics, whose name and outfit say what they are - the
+   test player met a mechanic first and heard "Soldiers are German army
+   men", then what the mechanics wear. */
+static const char *ETA_KindLooks(const entityState_t *es)
+{
+	if (es->aiChar == AICHAR_SOLDIER && Q_stricmp(ETA_CharacterKind(es), "Soldier"))
+	{
+		return NULL;
+	}
+	if (es->aiChar == AICHAR_BLACKGUARD && !Q_stricmp(ETA_CharacterKind(es), "Paratrooper"))
+	{
+		return NULL;   /* said with their outfit: what they are, and that they drop in */
+	}
+	return ETA_EnemyLooks(es->aiChar);
+}
