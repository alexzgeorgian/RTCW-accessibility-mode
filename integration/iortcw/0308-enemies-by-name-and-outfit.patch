+/* The model a character wears, as the game names it ("infantryss",
+   "officerss", "mechanic", "trench"), and its outfit ("assault1"). */
+static const char *ETA_CharacterModel(const entityState_t *es, const char **skin)
+{
+	const clientInfo_t *ci;
+
+	*skin = "";
+	if (es->number < 0 || es->number >= MAX_CLIENTS)
+	{
+		return "";
+	}
+	ci = &cgs.clientinfo[es->number];
+	if (!ci->infoValid)
+	{
+		return "";
+	}
+	*skin = ci->skinName;
+	return ci->modelName;
+}
