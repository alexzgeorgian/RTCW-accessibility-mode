+static int ETA_Outfit(const entityState_t *es)
+{
+	const char *skin;
+	const char *model = ETA_CharacterModel(es, &skin);
+	int        i;
+
+	for (i = 0; model[0] && i < (int)ARRAY_LEN(etaOutfits); i++)
+	{
+		const char *p = etaOutfits[i].skins;
+		int        len = (int)strlen(skin);
+
+		if (Q_stricmp(model, etaOutfits[i].model))
+		{
+			continue;
+		}
+		while (*p)
+		{
+			const char *end = strchr(p, ' ');
+			int        n    = end ? (int)( end - p ) : (int)strlen(p);
+
+			if (n == len && !Q_stricmpn(p, skin, n))
+			{
+				return i;
+			}
+			p += n;
+			while (*p == ' ')
+			{
+				p++;
+			}
+		}
+	}
+	return -1;
+}
