 	trap_AddCommand( "accessibilityFacing" );
 	trap_AddCommand( "accessibilityEnemyLock" );
+	trap_AddCommand( "accessibilityEnemyCallouts" );
 	trap_AddCommand( "accessibilityWaypointPlace" );
 	trap_AddCommand( "accessibilityWaypointNext" );
 	trap_AddCommand( "+accessibilityTurnLeft" );
@@ -711,6 +725,8 @@ qboolean CG_AccessibilityCommand( const char *cmd ) {
 		CG_AccessibilityFacing_f();
 	} else if ( !Q_stricmp( cmd, "accessibilityEnemyLock" ) ) {
 		CG_AccessibilityEnemyLock_f();
+	} else if ( !Q_stricmp( cmd, "accessibilityEnemyCallouts" ) ) {
+		CG_AccessibilityEnemyCallouts_f();
 	} else if ( !Q_stricmp( cmd, "accessibilityWaypointPlace" ) ) {
 		CG_AccessibilityWaypointPlace();
