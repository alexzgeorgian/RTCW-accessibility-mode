@@ -570,6 +570,19 @@ static void CG_AccessibilityObjectives_f( void ) {
 	ETA_Speech_SayLong( text );
 }
 
+/*
+ * M: the enemy callouts off, and on again. The tester asked to be spared
+ * the console, and the mode has no page in the game's menus: a key, said
+ * either way, and kept for the next time (eta_playerCallouts is archived).
+ */
+static void CG_AccessibilityEnemyCallouts_f( void ) {
+	qboolean on = (qboolean)!eta_playerCallouts.integer;
+
+	trap_Cvar_Set( "eta_playerCallouts", on ? "1" : "0" );
+	trap_Cvar_Update( &eta_playerCallouts );
+	CG_AccessibilitySay( on ? "Enemy callouts on" : "Enemy callouts off. M turns them on" );
+}
+
 static void CG_AccessibilityStatus_f( void ) {
 	playerState_t *ps = &cg.snap->ps;
 	char text[1024];
@@ -675,6 +688,7 @@ void CG_AccessibilityInit( void ) {
