diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index 94b97705..fa5c3222 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -2604,9 +2604,33 @@ static void ETA_FaceTheWayNow(void)
 			way.point[2] = ps->origin[2] + ps->viewheight;
 			ETA_AimStartSnap(&way, NULL);
 			ETA_HudNarrator_HoldPassive(cg.time);
-			ETA_Speech_Say(fabsf(AngleSubtract(yaw, vectoyaw(delta))) > 15.0f
-			               ? "Facing the opening nearest the way" : "Facing the way");
-			CG_AccessibilityMarkerWhere();
+
+			/* Short: where it leads and how far, nothing more. The
+			   marker's whole report - the way, where it lies, the facing -
+			   after the turn was more than the tester wanted to hear. */
+			{
+				vec3_t      origin, toward;
+				const char *name;
+				char        what[48], height[48];
+				int         meters;
+
+				if (CG_AccessibilityMarkerInfo(origin, &name))
+				{
+					VectorSubtract(origin, ps->origin, toward);
+					meters = (int)(VectorLength(toward) * ETA_QU_TO_METERS + 0.5f);
+					ETA_HudNarrator_HeightText(toward[2] * ETA_QU_TO_METERS, height, sizeof(height));
+					Q_strncpyz(what, name, sizeof(what));
+					what[0] = (char)toupper((unsigned char)what[0]);
+					ETA_Speech_Say(va("%s. %s, %d meters%s%s",
+					                  fabsf(AngleSubtract(yaw, vectoyaw(delta))) > 15.0f
+					                  ? "Facing the opening nearest the way" : "Facing the way",
+					                  what, meters < 1 ? 1 : meters, height[0] ? ", " : "", height));
+				}
+				else
+				{
+					ETA_Speech_Say("Facing the way");
+				}
+			}
 			return;
 		}
 	}
