+/*
+ * What the player rides: the tram of the first mission's last level. It
+ * moves, so the level's areas and the way have no part of it; the tester
+ * pressed its button and it left without them. F turns to it - "Tram,
+ * walk in" - J says when the player is in it, and its coming and going
+ * are said.
+ */
+#define ETA_MAX_RIDES 4
+
+static struct
+{
+	int model;
+	int state;    /* -1 not yet seen, 0 standing, 1 moving */
+	int playerIn; /* the player in it when last looked at */
+}          eta_rides[ETA_MAX_RIDES];
+static int eta_rideCount;
+
+/* A ride's box as it is now, and whether it is moving. qfalse when it is
+   not in the snapshot. */
+static qboolean ETA_RideBox(int i, vec3_t mins, vec3_t maxs, qboolean *moving)
+{
+	int n;
+
+	for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+	{
+		const entityState_t *es = &cg.snap->entities[n];
+		const centity_t     *cent;
+
+		if (es->eType != ET_MOVER || es->modelindex != eta_rides[i].model)
+		{
+			continue;
+		}
+		cent = &cg_entities[es->number];
+		trap_R_ModelBounds(cgs.inlineDrawModel[eta_rides[i].model], mins, maxs);
+		VectorAdd(mins, cent->lerpOrigin, mins);
+		VectorAdd(maxs, cent->lerpOrigin, maxs);
+		*moving = (qboolean)( es->pos.trType != TR_STATIONARY && es->pos.trDuration != 0 );
+		return qtrue;
+	}
+	return qfalse;
+}
+
+static qboolean ETA_RideHolds(const vec3_t mins, const vec3_t maxs, const vec3_t at)
+{
+	return (qboolean)( at[0] > mins[0] && at[0] < maxs[0] && at[1] > mins[1] && at[1] < maxs[1]
+	                   && at[2] > mins[2] - 8.0f && at[2] < maxs[2] );
+}
+
+/* For J: "You are in the tram, moving". qfalse when not in one. */
+qboolean CG_AccessibilityInRide(char *out, size_t size)
+{
+	vec3_t   mins, maxs;
+	qboolean moving;
+	int      i;
+
+	for (i = 0; i < eta_rideCount; i++)
+	{
+		if (ETA_RideBox(i, mins, maxs, &moving) && ETA_RideHolds(mins, maxs, cg.predictedPlayerState.origin))
+		{
+			Com_sprintf(out, size, moving ? "You are in the tram, moving. Stay inside" : "You are in the tram, standing");
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/* Its coming and going, as it changes. */
+void CG_AccessibilityRideFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              mins, maxs, middle;
+	qboolean            moving;
+	int                 i, in, meters;
+
+	for (i = 0; i < eta_rideCount; i++)
+	{
+		if (!ETA_RideBox(i, mins, maxs, &moving))
+		{
+			eta_rides[i].state = -1;
+			continue;
+		}
+		in        = ETA_RideHolds(mins, maxs, ps->origin) ? 1 : 0;
+		middle[0] = ( mins[0] + maxs[0] ) * 0.5f;
+		middle[1] = ( mins[1] + maxs[1] ) * 0.5f;
+		middle[2] = mins[2] + 40.0f;
+		meters    = (int)( Distance(ps->origin, middle) * ETA_QU_TO_METERS + 0.5f );
+		if (eta_rides[i].state >= 0 && eta_rides[i].state != (int)moving && ps->pm_type == PM_NORMAL)
+		{
+			if (in)
+			{
+				ETA_Speech_Say(moving ? "The tram is moving. Stay inside" : "The tram has stopped");
+			}
+			else if (meters <= 40)
+			{
+				ETA_Speech_Say(moving ? va("The tram is leaving, %d meters, %s", meters,
+				                           ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(middle)))
+				               : va("The tram has arrived, %d meters, %s. F turns you to it", meters,
+				                    ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(middle))));
+			}
+		}
+		else if (eta_rides[i].playerIn != in && eta_rides[i].state >= 0 && ps->pm_type == PM_NORMAL
+		         && ps->stats[STAT_HEALTH] > 0)
+		{
+			ETA_Speech_Say(in ? "In the tram" : "Out of the tram");
+		}
+		eta_rides[i].state    = moving;
+		eta_rides[i].playerIn = in;
+	}
+}
