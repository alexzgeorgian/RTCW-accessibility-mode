+/*
+ * Whether the enemy at a point is one an objective not met yet counts
+ * beaten: the nearest of the server's living, within a few steps of it,
+ * as the list is a moment behind. So he is said in sight from a hundred
+ * metres, not only within the forty enemies are said from: Kugelstadt's
+ * Panzerfaust gunner comes in 56 metres up the street, and must be hit
+ * before he fires on the tank; the tester never heard of him.
+ */
+qboolean CG_AccessibilityEnemyCountedAt(const vec3_t origin)
+{
+	const char *each = CG_ConfigString(CS_ETA_ENEMIES);
+	float      best  = 160.0f;
+	char       found[32] = "";
+	int        o;
+
+	while (each && *each)
+	{
+		int    c;
+		vec3_t there;
+		char   name[32];
+
+		if (sscanf(each, "%d %f %f %f %31[^;]", &c, &there[0], &there[1], &there[2], name) == 5
+		    && Distance(there, origin) < best)
+		{
+			best = Distance(there, origin);
+			Q_strncpyz(found, name, sizeof(found));
+		}
+		each = strchr(each, ';');
+		if (each)
+		{
+			each++;
+		}
+	}
+	for (o = 1; found[0] && o <= 8 && CG_AccessibilityObjectiveText(o)[0]; o++)
+	{
+		if (!CG_AccessibilityObjectiveDone(o) && CG_AccessibilityObjectiveCounts(o, found))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
