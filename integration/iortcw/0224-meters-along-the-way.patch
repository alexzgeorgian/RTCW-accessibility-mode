diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
index 0d6d9792..b566924f 100644
--- a/SP/code/cgame/cg_accessibility_route.c
+++ b/SP/code/cgame/cg_accessibility_route.c
@@ -172,6 +172,7 @@ typedef struct
 	int      startedAt;
 	qboolean done;        /* the current search has finished */
 	qboolean known;       /* a search for this marker has finished: kept while the next looks again */
+	float    leftKept;    /* metres along the way, as last known: said while the next search runs */
 	int      doneAt;
 	vec3_t   steer;       /* the point along the way */
 	int      steerIndex;  /* which of the way's points it is */
@@ -2780,6 +2781,41 @@ static float ETA_MarkerWayLeft(qboolean *byWay)
 	return Distance(ps->origin, eta_marker.origin) * ETA_QU_TO_METERS;
 }
 
+/*
+ * Metres to the marker as they are said: along the way where it is known,
+ * kept through each new search of it, else as the crow flies. The
+ * tester, following the way to the Snooper rifle round by the forest's
+ * edges, heard the metres go up as they walked: the way first leads away
+ * from the rifle, and the straight line grew.
+ */
+int CG_AccessibilityMarkerSaidMeters(qboolean *alongWay)
+{
+	qboolean byWay = qfalse;
+	float    left;
+
+	*alongWay = qfalse;
+	if (!eta_marker.active)
+	{
+		return 0;
+	}
+	if (eta_route.done)
+	{
+		left = ETA_MarkerWayLeft(&byWay);
+		if (byWay)
+		{
+			eta_route.leftKept = left;
+			*alongWay          = qtrue;
+			return (int)( left + 0.5f );
+		}
+	}
+	else if (eta_route.known && eta_route.leftKept > 0.0f)
+	{
+		*alongWay = qtrue;
+		return (int)( eta_route.leftKept + 0.5f );
+	}
+	return ETA_MarkerDistance();
+}
+
