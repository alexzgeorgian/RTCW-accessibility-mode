+/**
+ * @brief The edge guard: stopped at the edge of a drop, not over it.
+ *
+ * The tester, walking down a stair that turns, still went off its open
+ * side: the stair keeper turns the view along the steps, but it turns
+ * as the player walks, and at a run the turn came too late. A sighted
+ * player sees the edge and stops. So, walking forward on the ground,
+ * the way ahead is tried as the game would walk it (ETA_StairsKeepProbe,
+ * a stride at a time, stepping down each riser); where nothing is
+ * underfoot within the distance the player needs to stop, and the drop
+ * there is a real one - off stairs, enough to hurt, as the drop warning
+ * reckons it; on stairs, a fall to the floor below - the walk key is let
+ * go: "Edge. Drop 4 meters. W again goes over". W pressed again there
+ * goes over: the player's own choice. Never with jump held, nor into
+ * water. eta_edgeGuard 0 turns it off.
+ */
+#define ETA_EDGE_STAIRS_DROP 64.0f    /* on stairs: more than a few risers */
+#define ETA_EDGE_STOP_MARGIN 32.0f    /* and this much more than it takes to stop */
+#define ETA_EDGE_STOP_TIME   0.25f    /* seconds to stop, from running */
+#define ETA_EDGE_AGAIN_MS    4000     /* W again within this, here: over */
+#define ETA_EDGE_AGAIN_NEAR  64.0f
+#define ETA_EDGE_SAY_MS      2000
+#define ETA_FALL_DELTA_HURT  38.75f   /* the game's own: a fall that hurts */
+
+static struct
+{
+	int    stoppedAt;
+	vec3_t stoppedFrom;
+	int    saidAt;
+} eta_edge;
+
+static void ETA_EdgeGuardFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	usercmd_t           cmd;
+	trace_t             trace;
+	vec3_t              dir, lip, bottom;
+	float               speed, yaw, rise, walked, drop, hurt, deep;
+	qboolean            edge;
+
+	if (!eta_edgeGuard.integer || cg.cameraMode || !cg.snap || ps->pm_type != PM_NORMAL
+	    || ps->groundEntityNum == ENTITYNUM_NONE || (ps->pm_flags & PMF_LADDER) || CG_AccessibilityClimbing()
+	    || !trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd) || cmd.forwardmove <= 0 || cmd.upmove > 0)
+	{
+		return;
+	}
+
+	/* Stopped here a moment ago, and W pressed again: over, on purpose. */
+	if (eta_edge.stoppedAt && cg.time >= eta_edge.stoppedAt && cg.time - eta_edge.stoppedAt < ETA_EDGE_AGAIN_MS
+	    && Distance(ps->origin, eta_edge.stoppedFrom) < ETA_EDGE_AGAIN_NEAR)
+	{
+		return;
+	}
+
+	speed = sqrtf(ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1]);
+	yaw   = speed > 40.0f ? vectoyaw(ps->velocity) : ps->viewangles[YAW];
+	walked = ETA_StairsKeepProbe(yaw, &rise, &edge);
+	if (!edge || walked > speed * ETA_EDGE_STOP_TIME + ETA_EDGE_STOP_MARGIN)
+	{
+		return;
+	}
+
+	/* How far down it goes, from just past the lip. */
+	VectorSet(dir, cosf(DEG2RAD(yaw)), sinf(DEG2RAD(yaw)), 0.0f);
+	VectorMA(ps->origin, walked + ETA_STAIRS_KEEP_STEP + 16.0f, dir, lip);
+	lip[2] = ps->origin[2] + rise;
+	hurt   = ETA_HudNarrator_FallHeightForDelta(ETA_FALL_DELTA_HURT, (float)ps->gravity);
+	deep   = hurt * 4.0f + 128.0f;
+	VectorCopy(lip, bottom);
+	bottom[2] -= deep;
+	CG_Trace(&trace, lip, NULL, NULL, bottom, ps->clientNum, MASK_PLAYERSOLID | MASK_WATER);
+	drop = trace.fraction >= 1.0f ? deep : lip[2] - trace.endpos[2];
+	if (drop < (CG_AccessibilityOnStairs() ? ETA_EDGE_STAIRS_DROP : hurt)
+	    || (trace.fraction < 1.0f && (trace.contents & MASK_WATER)))
+	{
+		return;
+	}
+
+	/* The walk key let go - every key on it, as typed at the console. */
+	trap_SendConsoleCommand("-forward\n");
+	eta_edge.stoppedAt = cg.time;
+	VectorCopy(ps->origin, eta_edge.stoppedFrom);
+	if (cg.time - eta_edge.saidAt >= ETA_EDGE_SAY_MS || cg.time < eta_edge.saidAt)
+	{
+		int meters = (int)(drop * ETA_QU_TO_METERS + 0.5f);
+
+		eta_edge.saidAt = cg.time;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(trace.fraction >= 1.0f ? "Edge. A long drop. W again goes over"
+		               : va("Edge. Drop %d %s. W again goes over", meters < 1 ? 1 : meters,
+		                    meters == 1 ? "meter" : "meters"));
+	}
+}
