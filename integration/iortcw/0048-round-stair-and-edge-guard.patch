+/* Which side a wall of the flight is close on, walking along a yaw: -1
+   the left, 1 the right, 0 neither, or both. Walking down the round
+   stair by the radio room the tester slid along its outer wall, and
+   halfway down that wall and the steps closed on the player: stuck, in
+   the air, and dropping. The keeper keeps them off it. */
+#define ETA_STAIRS_KEEP_WALL_NEAR 12.0f   /* closer than this: steered off */
+#define ETA_STAIRS_KEEP_WALL_LOOK 64.0f
+#define ETA_STAIRS_KEEP_WALL_TURN 12.0f   /* degrees away, at a time */
+
+static int ETA_StairsKeepWallSide(float yaw)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              mins, maxs, at, side, end;
+	float               near[2];
+	int                 k;
+
+	/* A thin upright post, waist to chest high, at the player's middle:
+	   walls, and not the treads beside the player, which on a round stair
+	   step up within a body's width. How far it goes, less the player's
+	   own half width, is how far their side is from the wall. */
+	VectorSet(mins, -4.0f, -4.0f, 0.0f);
+	VectorSet(maxs, 4.0f, 4.0f, 32.0f);
+	VectorCopy(ps->origin, at);
+
+	/* Square to each side, and half way between that and ahead: the
+	   outer wall of a round stair is met ahead of the player, not beside. */
+	near[0] = near[1] = ETA_STAIRS_KEEP_WALL_LOOK;
+	for (k = 0; k < 4; k++)
+	{
+		trace_t trace;
+		float   turn = (k & 1) ? 45.0f : 90.0f;
+		float   rad  = DEG2RAD(yaw + (k < 2 ? turn : -turn));
+		float   got;
+
+		VectorSet(side, cosf(rad), sinf(rad), 0.0f);
+		VectorMA(at, ETA_STAIRS_KEEP_WALL_LOOK, side, end);
+		CG_Trace(&trace, at, mins, maxs, end, ps->clientNum, MASK_PLAYERSOLID);
+		got = trace.startsolid ? 0.0f : trace.fraction * ETA_STAIRS_KEEP_WALL_LOOK - (ps->maxs[0] - 4.0f);
+		if (got < near[k < 2 ? 0 : 1])
+		{
+			near[k < 2 ? 0 : 1] = got;
+		}
+	}
+
+	if (near[0] < ETA_STAIRS_KEEP_WALL_NEAR && near[1] > near[0] + 4.0f)
+	{
+		return -1;
+	}
+	if (near[1] < ETA_STAIRS_KEEP_WALL_NEAR && near[0] > near[1] + 4.0f)
+	{
+		return 1;
+	}
+	return 0;
+}
