+/*
+ * Where a trap kills: its hurt triggers - those near its movers -
+ * together in one box. The crypt's blade kills along six metres of its
+ * corridor, at a blow, and the tester, told only "Blade swinging", did
+ * not know where that began, and was killed going for the button past
+ * it.
+ */
+static void ETA_TrapZone(int g, const vec3_t *centers)
+{
+	int h, i;
+
+	eta_trapGroups[g].zoneDone = 1;
+	for (h = 0; h < eta_hurtCount; h++)
+	{
+		vec3_t mins, maxs, mid;
+
+		if (eta_hurtModels[h] <= 0 || eta_hurtModels[h] >= MAX_MODELS || !cgs.inlineDrawModel[eta_hurtModels[h]])
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[eta_hurtModels[h]], mins, maxs);
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		for (i = 0; i < eta_trapMoverCount; i++)
+		{
+			if (eta_trapMovers[i].group == g
+			    && ( Distance(mid, centers[i]) < 320.0f || Distance(mid, eta_trapMovers[i].at) < 320.0f ))
+			{
+				break;
+			}
+		}
+		if (i == eta_trapMoverCount)
+		{
+			continue;
+		}
+		if (eta_trapGroups[g].zoneDone == 1)
+		{
+			VectorCopy(mins, eta_trapGroups[g].zoneMins);
+			VectorCopy(maxs, eta_trapGroups[g].zoneMaxs);
+			eta_trapGroups[g].zoneDone = 2;
+		}
+		else
+		{
+			AddPointToBounds(mins, eta_trapGroups[g].zoneMins, eta_trapGroups[g].zoneMaxs);
+			AddPointToBounds(maxs, eta_trapGroups[g].zoneMins, eta_trapGroups[g].zoneMaxs);
+		}
+	}
+}
+
+/* How far the player's body is from a zone, across the floor: 0 in it. */
+static float ETA_ZoneGap(const vec3_t origin, const vec3_t mins, const vec3_t maxs)
+{
+	float dx = MAX(0.0f, MAX(mins[0] - ( origin[0] + 18.0f ), ( origin[0] - 18.0f ) - maxs[0]));
+	float dy = MAX(0.0f, MAX(mins[1] - ( origin[1] + 18.0f ), ( origin[1] - 18.0f ) - maxs[1]));
+
+	return sqrtf(dx * dx + dy * dy);
+}
+
+/* The shortest run out of a zone, of eight ways round from where the
+   player faces: its turn, and how far; qfalse if none. */
+static qboolean ETA_ZoneExit(const vec3_t mins, const vec3_t maxs, float *turnOut, float *runOut)
+{
+	static const vec3_t probeMins = { -15.0f, -15.0f, -6.0f }, probeMaxs = { 15.0f, 15.0f, 24.0f };
+	const playerState_t *ps       = &cg.predictedPlayerState;
+	float                best     = 1.0e9f;
+	int                  way;
+
+	for (way = 0; way < 8; way++)
+	{
+		vec3_t angles = { 0.0f, 0.0f, 0.0f }, forward, at;
+		float  run;
+
+		angles[YAW] = ps->viewangles[YAW] + (float)( way * 45 );
+		AngleVectors(angles, forward, NULL, NULL);
+		for (run = 16.0f; run <= 384.0f && run < best; run += 16.0f)
+		{
+			trace_t trace;
+
+			VectorMA(ps->origin, run, forward, at);
+			trap_CM_BoxTrace(&trace, ps->origin, at, probeMins, probeMaxs, 0, MASK_PLAYERSOLID);
+			if (trace.fraction < 1.0f || trace.startsolid)
+			{
+				break;
+			}
+			if (ETA_ZoneGap(at, mins, maxs) > 0.0f)
+			{
+				best     = run + 16.0f;
+				*turnOut = (float)( way * 45 );
+				break;
+			}
+		}
+	}
+	*runOut = best;
+	return (qboolean)( best < 1.0e8f );
+}
+
+/* The run across a zone the player stands before: to its far side, and
+   a body's width more. */
+static float ETA_ZoneAcross(const vec3_t origin, const vec3_t mins, const vec3_t maxs)
+{
+	float across = 0.0f;
+
+	if (origin[1] > maxs[1])
+	{
+		across = MAX(across, origin[1] - mins[1]);
+	}
+	else if (origin[1] < mins[1])
+	{
+		across = MAX(across, maxs[1] - origin[1]);
+	}
+	if (origin[0] > maxs[0])
+	{
+		across = MAX(across, origin[0] - mins[0]);
+	}
+	else if (origin[0] < mins[0])
+	{
+		across = MAX(across, maxs[0] - origin[0]);
+	}
+	return across + 36.0f;
+}
+
+/* Whether a point is where a trap kills - inside the reach of one whose
+   reach is known, on its floor: for O, which does not stop there. */
+qboolean CG_AccessibilityInTrapReach(const vec3_t origin)
+{
+	int g;
+
+	for (g = 0; g < eta_trapGroupCount; g++)
+	{
+		if (eta_trapGroups[g].zoneDone == 2
+		    && origin[2] > eta_trapGroups[g].zoneMins[2] - 48.0f && origin[2] < eta_trapGroups[g].zoneMaxs[2] + 48.0f
+		    && ETA_ZoneGap(origin, eta_trapGroups[g].zoneMins, eta_trapGroups[g].zoneMaxs) <= 0.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
