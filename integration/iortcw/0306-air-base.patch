+/*
+ * An objective met in parts, each a switch: the air base's "Prep Kobra
+ * for launch" wants the lift raised, the fuel run and the hatch over the
+ * plane cranked open, each at its own lever, in that order for the fuel.
+ * O led to the crank, the tester turned it, and O led to it again and
+ * again. A switch pressed there that set something moving - a lever
+ * swung, a hatch opened - is done with; one that set nothing moving wants
+ * another part first, and is left until another part is done.
+ */
+#define ETA_OBJECTIVE_USE_WATCH_MS 4000
+#define ETA_OBJECTIVE_USE_MOVERS   64
+
+static struct
+{
+	int    place;      /* the place pressed at; -1 none */
+	int    at;
+	int    count;
+	int    entity[ETA_OBJECTIVE_USE_MOVERS];
+	vec3_t pos[ETA_OBJECTIVE_USE_MOVERS];
+	vec3_t angles[ETA_OBJECTIVE_USE_MOVERS];
+} eta_objectiveUse = { -1 };
+
+static qboolean ETA_ObjectivePlaceSkipped(int index)
+{
+	int i;
+
+	if (eta_objectivePlaces[index].used)
+	{
+		return qtrue;
+	}
+	if (!eta_objectivePlaces[index].triedAt)
+	{
+		return qfalse;
+	}
+	/* Tried and nothing moved: left while another part of the same
+	   objective is still to do. */
+	for (i = 0; i < eta_objectivePlaceCount; i++)
+	{
+		if (i != index && eta_objectivePlaces[i].objective == eta_objectivePlaces[index].objective
+		    && !eta_objectivePlaces[i].used && !eta_objectivePlaces[i].triedAt)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+static qboolean ETA_ObjectiveMoverState(int n, vec3_t pos, vec3_t angles)
+{
+	const centity_t *cent = &cg_entities[n];
+
+	if (!cent->currentValid || cent->currentState.eType != ET_MOVER)
+	{
+		return qfalse;
+	}
+	BG_EvaluateTrajectory(&cent->currentState.pos, cg.time, pos);
+	BG_EvaluateTrajectory(&cent->currentState.apos, cg.time, angles);
+	return qtrue;
+}
+
+/* Whether an objective's place there is a switch, pressed from in reach
+   of it rather than walked onto. */
+qboolean CG_AccessibilityObjectiveSwitchAt(const vec3_t point)
+{
+	int i;
+
+	for (i = 0; i < eta_objectivePlaceCount; i++)
+	{
+		if (eta_objectivePlaces[i].isSwitch && Distance(eta_objectivePlaces[i].at, point) < 32.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/* F pressed on something, where: an objective's switch there is watched. */
+void CG_AccessibilityObjectiveSwitchPressed(const vec3_t point)
+{
+	int i, best = -1;
+
+	for (i = 0; i < eta_objectivePlaceCount; i++)
+	{
+		if (eta_objectivePlaces[i].pickup || eta_objectivePlaces[i].used
+		    || CG_AccessibilityObjectiveDone(eta_objectivePlaces[i].objective)
+		    || Distance(eta_objectivePlaces[i].at, point) > 96.0f)
+		{
+			continue;
+		}
+		if (best < 0 || Distance(eta_objectivePlaces[i].at, point) < Distance(eta_objectivePlaces[best].at, point))
+		{
+			best = i;
+		}
+	}
+	eta_objectiveUse.place = best;
+	eta_objectiveUse.count = 0;
+	if (best < 0 || !cg.snap)
+	{
+		return;
+	}
+	eta_objectiveUse.at = cg.time;
+	for (i = 0; i < cg.snap->numEntities && eta_objectiveUse.count < ETA_OBJECTIVE_USE_MOVERS; i++)
+	{
+		int                  n  = cg.snap->entities[i].number;
+		const entityState_t *es = &cg_entities[n].currentState;
+
+		/* Only what stood still, near: the hatch the crank opens was
+		   still opening when the next lever was pressed. */
+		if (ETA_ObjectiveMoverState(n, eta_objectiveUse.pos[eta_objectiveUse.count], eta_objectiveUse.angles[eta_objectiveUse.count])
+		    && es->pos.trType == TR_STATIONARY && es->apos.trType == TR_STATIONARY
+		    && Distance(eta_objectiveUse.pos[eta_objectiveUse.count], point) < 512.0f)
+		{
+			eta_objectiveUse.entity[eta_objectiveUse.count++] = n;
+		}
+	}
+}
+
