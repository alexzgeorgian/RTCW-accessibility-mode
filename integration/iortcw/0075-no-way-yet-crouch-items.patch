+/*
+ * C crouches and C again stands, rather than crouching only while held:
+ * the tester, with one hand on the keys that move and one on those that
+ * say, could not hold it. Its own key number in the game's +movedown, so
+ * the walk guide's crouch and a held key of the player's own still work
+ * beside it. Whether the player is crouched or standing is said as it
+ * changes (ETA_CrouchFrame), whatever made it: this key, the walk guide
+ * under a low ceiling, or a ceiling too low to stand up under yet.
+ */
+#define ETA_CROUCH_KEY "991"
+
+static qboolean eta_crouchOn;
+static int      eta_crouchSaid = -1;   /* 1 crouched, 0 standing, as last said */
+static int      eta_crouchStandAt;     /* when C let go, to say if a ceiling keeps the player down */
+
+void CG_AccessibilityCrouch_f(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	eta_crouchOn = (qboolean)!eta_crouchOn;
+	trap_SendConsoleCommand(va("%smovedown " ETA_CROUCH_KEY "\n", eta_crouchOn ? "+" : "-"));
+	eta_crouchStandAt = eta_crouchOn ? 0 : cg.time;
+}
+
+static void ETA_CrouchFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 now;
+
+	if (ps->pm_type != PM_NORMAL || ps->stats[STAT_HEALTH] <= 0)
+	{
+		/* Dead or in a cutscene: the toggle let go, said fresh after. */
+		if (eta_crouchOn)
+		{
+			eta_crouchOn = qfalse;
+			trap_SendConsoleCommand("-movedown " ETA_CROUCH_KEY "\n");
+		}
+		eta_crouchSaid = -1;
+		return;
+	}
+	now = ( ps->pm_flags & PMF_DUCKED ) ? 1 : 0;
+	if (eta_crouchSaid < 0)
+	{
+		eta_crouchSaid = now;
+		return;
+	}
+	if (now != eta_crouchSaid)
+	{
+		eta_crouchSaid    = now;
+		eta_crouchStandAt = 0;
+		ETA_Speech_Say(now ? "Crouched" : "Standing");
+	}
+	/* Let go, and still down a moment later: a ceiling too low to stand
+	   under. Said once; "Standing" follows when there is room. */
+	else if (now && eta_crouchStandAt && ( cg.time - eta_crouchStandAt > 400 || cg.time < eta_crouchStandAt ))
+	{
+		eta_crouchStandAt = 0;
+		ETA_Speech_Say("Too low to stand here. You stand up once there is room");
+	}
+}
