 	return (qboolean)(eta_marker.active && eta_route.done);
 }
 
+/*
+ * Whether the marker cannot be reached from here at all now: the search,
+ * jumps let in too, tried every square there is to reach and none was
+ * it. A locked door is in between, or a part of the level not open yet.
+ * The tester, led on from the wine cellar toward the way out beyond the
+ * locked doors, was turned into the wall nearest it, again and again.
+ */
+qboolean CG_AccessibilityMarkerUnreachable(void)
+{
+	return (qboolean)(eta_marker.active && eta_route.done && eta_route.jumps
+	                  && ETA_PathFinder_State() == ETA_PATH_PARTIAL && ETA_PathFinder_AllTried());
+}
