+int CG_AccessibilityDoorShutNow(int door)
+{
+	int j;
+
+	if (door <= 0 || door >= MAX_MODELS)
+	{
+		return -1;
+	}
+	for (j = 0; cg.snap && j < cg.snap->numEntities; j++)
+	{
+		const entityState_t *es = &cg.snap->entities[j];
+
+		if (es->eType == ET_MOVER && es->modelindex == door)
+		{
+			return (es->pos.trType == TR_STATIONARY && es->apos.trType == TR_STATIONARY
+			        && VectorLength(es->apos.trBase) < 1.0f
+			        && Distance(es->pos.trBase, eta_doorOrigins[door]) < 1.0f) ? 1 : 0;
+		}
+	}
+	return -1;
