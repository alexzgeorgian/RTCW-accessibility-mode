+/* Whether a point lies on a door lying flat - a hatch - as the map has
+   it, shut. */
+static qboolean ETA_LadderTopOnHatch(const vec3_t at)
+{
+	int model;
+
+	for (model = 1; model < MAX_MODELS; model++)
+	{
+		vec3_t   mins, maxs;
+		qboolean opens;
+
+		if (CG_AccessibilityDoorBox(model, mins, maxs, &opens) && maxs[2] - mins[2] <= 48.0f
+		    && maxs[0] - mins[0] >= 48.0f && maxs[1] - mins[1] >= 48.0f
+		    && at[0] > mins[0] && at[0] < maxs[0] && at[1] > mins[1] && at[1] < maxs[1]
+		    && fabsf(at[2] - ( mins[2] + maxs[2] ) * 0.5f) < 64.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
