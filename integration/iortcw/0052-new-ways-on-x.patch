+/* Whether a way not yet tried starts in the area, and is not one of its
+   doors out, which the list has already. */
+static qboolean ETA_AreaNewWayHere(int area, const vec3_t feature, const vec3_t lead)
+{
+	int there = ETA_AreaOf(lead), i;
+
+	if (there >= 0 ? there != area : ETA_AreaOf(feature) != area)
+	{
+		return qfalse;
+	}
+	for (i = 0; i < eta_areas.exitCount; i++)
+	{
+		const eta_areaExit_t *exit = &eta_areas.exits[i];
+
+		if ((exit->area[0] == area || exit->area[1] == area) && Distance(exit->middle, feature) < 128.0f)
+		{
+			return qfalse;
+		}
+	}
+	return qtrue;
+}
+
+/* Where an entry on X's list is, for its distance. */
+static qboolean ETA_AreaEntryAt(int entry, vec3_t at)
+{
+	vec3_t      lead;
+	const char *word;
+
+	if (entry >= 0)
+	{
+		VectorCopy(eta_areas.exits[entry].middle, at);
+		return qtrue;
+	}
+	return CG_AccessibilityNewWayAt(-1 - entry, at, lead, &word);
