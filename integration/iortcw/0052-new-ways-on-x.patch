+/* For X: the ways found and never tried - where each starts, where O
+   would lead, past its start, and what it is. qfalse for one tried. */
+int CG_AccessibilityNewWayCount(void)
+{
+	return eta_frontier.count;
+}
+
+qboolean CG_AccessibilityNewWayAt(int index, vec3_t feature, vec3_t lead, const char **word)
+{
+	if (index < 0 || index >= eta_frontier.count || eta_frontier.ways[index].tried)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_frontier.ways[index].feature, feature);
+	VectorCopy(eta_frontier.ways[index].lead, lead);
+	*word = eta_wayWords[eta_frontier.ways[index].kind];
+	return qtrue;
+}
+
