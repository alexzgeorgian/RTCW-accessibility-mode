+/*
+ * A zombie warrior come near: it swings a blade, and comes on fast. The
+ * crypt's two are let out at the crossroads once the zombies there are
+ * dead, and reached the tester at the blade's corridor out of sight,
+ * named only by the blow. Said once each, the first time one is within
+ * reach of a few seconds' run on the player's floor - seen or not.
+ */
+#define ETA_WARRIOR_NEAR 25.0f   /* meters */
+
+static void ETA_WarriorFrame(void)
+{
+	static qboolean warned[MAX_GENTITIES];
+	static int      lastTime, lastStart;
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  i, best = -1;
+	float                bestDistance = ETA_WARRIOR_NEAR / ETA_QU_TO_METERS;
+
+	if (cg.time < lastTime || cgs.levelStartTime != lastStart)
+	{
+		memset(warned, 0, sizeof(warned));   /* a new map, or a game loaded */
+	}
+	lastTime  = cg.time;
+	lastStart = cgs.levelStartTime;
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		return;
+	}
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		float                distance;
+
+		if (es->eType != ET_PLAYER || es->aiChar != AICHAR_WARZOMBIE || (es->eFlags & EF_DEAD)
+		    || es->number < 0 || es->number >= MAX_GENTITIES || warned[es->number] || !ETA_SeenAsEnemy(es))
+		{
+			continue;
+		}
+		distance = Distance(cg_entities[es->number].lerpOrigin, ps->origin);
+		if (distance < bestDistance && fabsf(cg_entities[es->number].lerpOrigin[2] - ps->origin[2]) < 160.0f)
+		{
+			bestDistance = distance;
+			best         = es->number;
+		}
+	}
+	if (best >= 0)
+	{
+		int meters = (int)( bestDistance * ETA_QU_TO_METERS + 0.5f );
+
+		warned[best] = qtrue;
+		ETA_Speech_Say(va("Zombie warrior with a blade, %s, %d %s. U locks on to it",
+		                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(cg_entities[best].lerpOrigin)),
+		                  meters < 1 ? 1 : meters, meters <= 1 ? "meter" : "meters"));
+	}
+}
+
 void CG_AccessibilityWorldFrame(qboolean held)
 {
 	ETA_CrushFrame();
 	ETA_SwitchNoticeFrame();
 	ETA_LiftsFrame();
+	ETA_WarriorFrame();
 	ETA_OrderFrame();
 	ETA_TrapsFrame();
 	ETA_WorldRead();
