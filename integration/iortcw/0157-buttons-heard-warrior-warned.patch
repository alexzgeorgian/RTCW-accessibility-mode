 /* Whether a point is where a trap kills - inside the reach of one whose
    reach is known, on its floor: for O, which does not stop there. */
+/*
+ * A key's answer being heard out: T's line on a puzzle button runs five
+ * seconds and more, and a trap's "swinging" or "back up" every few
+ * seconds cut it off on the Mac before the button was named - the
+ * tester heard no buttons on T in the blade's corridor. While it lasts,
+ * a trap's coming and going waits, unless the player is in its reach or
+ * walking into it; it is said once the answer is over, as it stands then.
+ */
+static int eta_answerUntil;
+
+void CG_AccessibilityAnswerSaid(int length)
+{
+	int ms = 1500 + length * 45;
+
+	eta_answerUntil = cg.time + ( ms > 9000 ? 9000 : ms );
+}
+
+static qboolean ETA_AnswerHeard(void)
+{
+	return (qboolean)( cg.time < eta_answerUntil && cg.time + 9000 >= eta_answerUntil );
+}
+
+/* A trap's coming or going: said, or kept till the answer is over - the
+   latest only, so what is said then is how it stands then. */
+static void ETA_TrapCycleSay(int g, qboolean quiet, const char *text)
+{
+	if (quiet)
+	{
+		Q_strncpyz(eta_trapGroups[g].waiting, text, sizeof(eta_trapGroups[g].waiting));
+		return;
+	}
+	eta_trapGroups[g].waiting[0] = '\0';
+	ETA_Speech_Say(text);
+}
