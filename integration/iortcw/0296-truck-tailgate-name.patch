diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 02df450f..7070a358 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -5566,6 +5566,38 @@ qboolean CG_AccessibilityScriptDoor(int model)
 	return (qboolean)( model > 0 && model < MAX_MODELS && eta_scriptDoor[model] );
 }
 
+static qboolean eta_scriptDoorTruck[MAX_MODELS]; /* a truck's tailgate */
+
+/* A script door's own name: the truck's tailgate, by its script's name -
+   the tester, told of "a shut door", asked for it to be called what it
+   is. NULL for any other. */
+const char *CG_AccessibilityScriptDoorName(int model)
+{
+	return CG_AccessibilityScriptDoor(model) && eta_scriptDoorTruck[model] ? "the truck's tailgate" : NULL;
+}
+
+/* The tailgate's trigger in view, for the crosshair: its name, or NULL. */
+const char *CG_AccessibilityScriptDoorAhead(void)
+{
+	vec3_t forward, to;
+	int    m;
+
+	AngleVectors(cg.refdefViewAngles, forward, NULL, NULL);
+	for (m = 1; m < MAX_MODELS; m++)
+	{
+		if (!eta_scriptDoorTruck[m] || eta_scriptDoorUser[m] <= 0)
+		{
+			continue;
+		}
+		VectorSubtract(cgs.inlineModelMidpoints[eta_scriptDoorUser[m]], cg.refdef.vieworg, to);
+		if (VectorNormalize(to) < 200.0f && DotProduct(to, forward) > 0.7f)
+		{
+			return "Truck's tailgate";
+		}
+	}
+	return NULL;
+}
+
