 	return found;
 }
 
+/*
+ * Nothing left to explore and the way out not open: a door come to,
+ * seen shut, that a switch opens - the level's next step. The tester, in
+ * the second catacomb level, had explored every area; O and X said there
+ * was nothing new, and the door on was shut, its switch 40 meters off and
+ * up high. Of such doors, the nearest the player; where its switch is
+ * pressed from, and the switch, and how far the door is.
+ */
+qboolean CG_AccessibilitySeenDoorSwitch(vec3_t out, vec3_t aim, float *doorFar)
+{
+	const float *here = cg.predictedPlayerState.origin;
+	int         model;
+	float       bestFar = 1.0e9f;
+	qboolean    found   = qfalse;
+
+	for (model = 1; model < MAX_MODELS; model++)
+	{
+		vec3_t   mins, maxs, mid, at;
+		qboolean opens;
+		int      shut;
+		float    far;
+
+		if (!eta_doorOpener[model] || !CG_AccessibilityDoorBox(model, mins, maxs, &opens))
+		{
+			continue;
+		}
+		shut = CG_AccessibilityDoorShutNow(model);
+		if (shut == 0 || ( shut < 0 && eta_doorSeen[model] != 2 ))
+		{
+			continue;
+		}
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		far = Distance(mid, here);
+		if (far >= bestFar || !CG_AccessibilityDoorOpener(model, mid, at))
+		{
+			continue;
+		}
+		bestFar = far;
+		*doorFar = far;
+		VectorCopy(at, aim);
+		if (!CG_AccessibilitySwitchStand(at, out))
+		{
+			VectorCopy(at, out);
+		}
+		found = qtrue;
+	}
+	return found;
+}
