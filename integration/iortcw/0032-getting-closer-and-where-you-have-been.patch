+/**
+ * @brief Getting closer, or not: said every so often on the way.
+ *
+ * The tester asked how they were to know they were going the right way,
+ * and not round in circles. So every ETA_PROGRESS_MS of walking toward
+ * the marker, how far is left is compared with before - along the way
+ * round the walls where it is known, else as the crow flies: "Getting
+ * closer, 40 meters", "Getting further, 52 meters", or, walked a good way
+ * for nothing, "Not getting closer, 45 meters". Standing still says
+ * nothing.
+ */
+#define ETA_PROGRESS_MS     12000
+#define ETA_PROGRESS_WALKED 6.0f    /* metres walked for a reading to count */
+#define ETA_PROGRESS_CHANGE 2.0f    /* metres closer or further that are news */
+
+static struct
+{
+	int    at;
+	float  left;      /* metres left, then */
+	float  walked;    /* metres walked since */
+	vec3_t last;
+	qboolean byWay;   /* left was along the way, not as the crow flies */
+} eta_progress;
+
+/* Metres left to the marker: along the way, where the way is known. */
+static float ETA_MarkerWayLeft(qboolean *byWay)
+{
+	const playerState_t *ps    = &cg.predictedPlayerState;
+	int                 count = ETA_PathFinder_PointCount();
+
+	*byWay = (qboolean)(eta_route.done && eta_route.along >= 0 && eta_route.along < count);
+	if (*byWay)
+	{
+		vec3_t a, b;
+		float  units;
+		int    i;
+
+		ETA_PathFinder_Point(eta_route.along, a);
+		units = Distance(ps->origin, a);
+		for (i = eta_route.along + 1; i < count; i++)
+		{
+			ETA_PathFinder_Point(i, b);
+			units += Distance(a, b);
+			VectorCopy(b, a);
+		}
+		units += Distance(a, eta_marker.origin);
+		return units * ETA_QU_TO_METERS;
+	}
+
+	return Distance(ps->origin, eta_marker.origin) * ETA_QU_TO_METERS;
+}
+
+static void ETA_MarkerProgressFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	float               step;
+
+	if (ps->groundEntityNum == ENTITYNUM_NONE || CG_AccessibilityClimbing())
+	{
+		VectorCopy(ps->origin, eta_progress.last);
+		return;
+	}
+
+	if (!eta_progress.at || cg.time < eta_progress.at)
+	{
+		eta_progress.at     = cg.time;
+		eta_progress.left   = ETA_MarkerWayLeft(&eta_progress.byWay);
+		eta_progress.walked = 0.0f;
+		VectorCopy(ps->origin, eta_progress.last);
+		return;
+	}
+
+	/* A jump of the view - a load, a teleport - is not walking. */
+	step = Distance(ps->origin, eta_progress.last) * ETA_QU_TO_METERS;
+	if (step < 3.0f)
+	{
+		eta_progress.walked += step;
+	}
+	VectorCopy(ps->origin, eta_progress.last);
+
+	if (cg.time - eta_progress.at < ETA_PROGRESS_MS)
+	{
+		return;
+	}
+
+	if (eta_progress.walked >= ETA_PROGRESS_WALKED)
+	{
+		qboolean byWay;
+		float    left   = ETA_MarkerWayLeft(&byWay);
+		float    change = eta_progress.left - left;
+		int      meters = (int)(left + 0.5f);
+
+		/* The way found since the last reading: the straight line and the
+		   way round the walls are not to be compared - "Getting further"
+		   was said when the way, longer than the line, was first known. */
+		if (byWay != eta_progress.byWay)
+		{
+			eta_progress.byWay  = byWay;
+			eta_progress.left   = left;
+			eta_progress.at     = cg.time;
+			eta_progress.walked = 0.0f;
+			return;
+		}
+
+		/* No number: along the way round the walls it is not the one the
+		   distance callouts say, as the crow flies, and two numbers that
+		   disagree are worse than none. */
+		(void)meters;
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(change >= ETA_PROGRESS_CHANGE ? "Getting closer"
+		               : change <= -ETA_PROGRESS_CHANGE ? "Getting further" : "Not getting closer");
+		ETA_Speech_EndReport();
+		eta_progress.left = left;
+	}
+	else
+	{
+		eta_progress.left = ETA_MarkerWayLeft(&eta_progress.byWay);
+	}
+
+	eta_progress.at     = cg.time;
+	eta_progress.walked = 0.0f;
+}
