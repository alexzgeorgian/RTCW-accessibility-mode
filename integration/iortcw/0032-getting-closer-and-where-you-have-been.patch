+/**
+ * @brief Where the player has been: "You were here 3 minutes ago", and
+ * "Back at waypoint 2, by the button".
+ *
+ * The tester asked how to tell going round in circles from getting
+ * somewhere. So a trail is kept - a point every couple of seconds, where
+ * the player has walked a metre or more since the last - and walking
+ * back onto a part of it a minute old or more is said, with how long
+ * ago; not again for half a minute, nor until the player has walked on.
+ * Coming back to one of the waypoints is said by its name, once until
+ * they leave it.
+ */
+
+static qboolean ETA_TrailClose(const vec3_t a, const vec3_t b, float near)
+{
+	float dx = a[0] - b[0], dy = a[1] - b[1];
+
+	return (qboolean)(dx * dx + dy * dy < near * near && fabsf(a[2] - b[2]) < 40.0f);
+}
+
+static void ETA_TrailFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 i, newest;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || ps->groundEntityNum == ENTITYNUM_NONE)
+	{
+		return;
+	}
+
+	/* A point on the trail. */
+	newest = (eta_trail.head + ETA_TRAIL_MAX - 1) % ETA_TRAIL_MAX;
+	if ((cg.time - eta_trail.lastAt >= ETA_TRAIL_EVERY || cg.time < eta_trail.lastAt)
+	    && (!eta_trail.count || Distance(ps->origin, eta_trail.at[newest]) >= ETA_TRAIL_STEP))
+	{
+		VectorCopy(ps->origin, eta_trail.at[eta_trail.head]);
+		eta_trail.time[eta_trail.head] = cg.time;
+		eta_trail.head                 = (eta_trail.head + 1) % ETA_TRAIL_MAX;
+		if (eta_trail.count < ETA_TRAIL_MAX)
+		{
+			eta_trail.count++;
+		}
+		eta_trail.lastAt = cg.time;
+	}
+
+	if (cg.time - eta_trail.lookAt < 500 && cg.time >= eta_trail.lookAt)
+	{
+		return;
+	}
+	eta_trail.lookAt = cg.time;
+
+	/* Back at a waypoint: by its name. */
+	{
+		int at = 0;
+
+		for (i = 0; i < eta_waypointCount; i++)
+		{
+			if (ETA_TrailClose(ps->origin, eta_waypoints[i], ETA_WAYPOINT_AT))
+			{
+				at = i + 1;
+				break;
+			}
+		}
+		if (at && at != eta_trail.waypointAt)
+		{
+			eta_trail.waypointAt = at;
+			eta_trail.saidAt     = cg.time;
+			VectorCopy(ps->origin, eta_trail.saidFrom);
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say(eta_waypointNames[at - 1][0]
+			               ? va("Back at waypoint %d, %s", at, eta_waypointNames[at - 1])
+			               : va("Back at waypoint %d", at));
+			ETA_Speech_EndReport();
+			return;
+		}
+		if (!at)
+		{
+			eta_trail.waypointAt = 0;
+		}
+		else
+		{
+			return;
+		}
+	}
+
+	if (eta_trail.saidAt && cg.time >= eta_trail.saidAt
+	    && (cg.time - eta_trail.saidAt < ETA_TRAIL_QUIET || Distance(ps->origin, eta_trail.saidFrom) < ETA_TRAIL_ON))
+	{
+		return;
+	}
+
+	/* Back on the trail: the latest old point here, for how long ago. */
+	{
+		int ago = -1;
+
+		for (i = 0; i < eta_trail.count; i++)
+		{
+			int k = (eta_trail.head + ETA_TRAIL_MAX - 1 - i) % ETA_TRAIL_MAX;
+
+			if (cg.time - eta_trail.time[k] < ETA_TRAIL_OLD || cg.time < eta_trail.time[k])
+			{
+				continue;
+			}
+			if (ETA_TrailClose(ps->origin, eta_trail.at[k], ETA_TRAIL_NEAR))
+			{
+				ago = (cg.time - eta_trail.time[k]) / 60000;
+				break;
+			}
+		}
+
+		if (ago >= 0)
+		{
+			eta_trail.saidAt = cg.time;
+			VectorCopy(ps->origin, eta_trail.saidFrom);
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say(ago <= 1 ? "You were here a minute ago" : va("You were here %d minutes ago", ago));
+			ETA_Speech_EndReport();
+		}
+	}
+}
