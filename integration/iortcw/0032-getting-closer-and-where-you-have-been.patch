+#define ETA_TRAIL_STEP    48.0f     /* units walked since the last point */
+#define ETA_TRAIL_NEAR    64.0f     /* this near an old point: been here */
+#define ETA_TRAIL_OLD     60000     /* a point at least this old */
+#define ETA_TRAIL_QUIET   30000     /* between two of them */
+#define ETA_TRAIL_ON      600.0f    /* and walked this far since the last */
+#define ETA_WAYPOINT_AT   96.0f     /* this near a waypoint: back at it */
