@@ -8314,6 +8314,188 @@ static void ETA_MarkerSetByO(const vec3_t point, const char *name)
 	Q_strncpyz(eta_oName, name, sizeof(eta_oName));
 }
 
+/*
+ * The level's trail: the player's own script triggers, numbered in the
+ * order the level means them to be walked into - "action11", "action12"
+ * and on - between one objective and the next. In the rocket base, after
+ * the abort, the way to the exit goes down from the control room, past
+ * the soldiers, through the front doors and over the hanging bridge,
+ * every step of it one of these, and O, aiming straight at the exit,
+ * found no way and went from door to door. O leads by them now, one at a
+ * time: from the last objective met, or the last of them walked into, on
+ * to the next objective.
+ */
+/* Its number, times 8, and a letter after it one more each: "action18",
+   "action18a", "action18b" - the rocket base's front door, then each end
+   of its hanging bridge - in that order. */
+static int ETA_StepOrder(const char *event)
+{
+	const char *c;
+
+	if (Q_stricmpn(event, "action", 6) || !isdigit((unsigned char)event[6]))
+	{
+		return -1;
+	}
+	for (c = event + 6; isdigit((unsigned char)*c); c++)
+	{
+	}
+	return atoi(event + 6) * 8 + ( *c >= 'a' && *c <= 'g' ? *c - 'a' + 1 : 0 );
+}
+
+static int eta_stepPassedMax = -1;   /* the furthest walked into, this level */
+static int eta_stepLed = -1;         /* the one O last led to */
+static int eta_stepGaveUp;           /* the objective the trail was given up for, from another floor */
+static int eta_stepStart;
+
+static void ETA_StepBox(int i, vec3_t mins, vec3_t maxs)
+{
+	trap_R_ModelBounds(cgs.inlineDrawModel[eta_playerTriggers[i].model], mins, maxs);
+}
+
+static qboolean ETA_StepUsable(int i)
+{
+	return (qboolean)( eta_playerTriggers[i].model > 0 && eta_playerTriggers[i].model < MAX_MODELS
+	                   && cgs.inlineDrawModel[eta_playerTriggers[i].model]
+	                   && ETA_StepOrder(eta_playerTriggers[i].event) >= 0 );
+}
+
+/* Kept in a cvar by map, so a save loaded again keeps how far it went. */
+static void ETA_StepFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	char                 kept[MAX_QPATH + 16], map[MAX_QPATH];
+	int                  i;
+
+	trap_Cvar_VariableStringBuffer("mapname", map, sizeof(map));
+	if (eta_stepStart != cgs.levelStartTime)
+	{
+		char *space;
+
+		eta_stepStart     = cgs.levelStartTime;
+		eta_stepPassedMax = -1;
+		eta_stepGaveUp    = 0;
+		trap_Cvar_VariableStringBuffer("eta_stepsWalked", kept, sizeof(kept));
+		space = strrchr(kept, ':');
+		if (space && !Q_stricmpn(kept, map, (int)( space - kept )) && (int)strlen(map) == (int)( space - kept ))
+		{
+			eta_stepPassedMax = atoi(space + 1);
+		}
+	}
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	for (i = 0; i < eta_playerTriggerCount; i++)
+	{
+		vec3_t mins, maxs;
+		int    order, a;
+
+		if (!ETA_StepUsable(i) || ( order = ETA_StepOrder(eta_playerTriggers[i].event) ) <= eta_stepPassedMax)
+		{
+			continue;
+		}
+		ETA_StepBox(i, mins, maxs);
+		for (a = 0; a < 3; a++)
+		{
+			if (ps->origin[a] + ( a == 2 ? 32.0f : 16.0f ) < mins[a] || ps->origin[a] - ( a == 2 ? 24.0f : 16.0f ) > maxs[a])
+			{
+				break;
+			}
+		}
+		if (a == 3)
+		{
+			eta_stepPassedMax = order;
+			eta_stepGaveUp    = 0;
+			trap_Cvar_Set("eta_stepsWalked", va("%s:%d", map, order));
+		}
+	}
+}
+
+/* The next step of the trail to the objective, where it is: qfalse with
+   none - the objective not met at a numbered trigger, or nothing left
+   between. */
+static qboolean ETA_StepNext(int objective, vec3_t out)
+{
+	int   i, target = -1, floor = eta_stepPassedMax, next = -1;
+	float best = 0.0f;
+
+	for (i = 0; i < eta_playerTriggerCount; i++)
+	{
+		int o, met;
+
+		if (!ETA_StepUsable(i))
+		{
+			continue;
+		}
+		o   = ETA_StepOrder(eta_playerTriggers[i].event);
+		met = CG_AccessibilityObjectiveOfEvent(eta_playerTriggers[i].event);
+		if (met == objective && ( target < 0 || o < target ))
+		{
+			target = o;
+		}
+		if (met > 0 && met != objective && CG_AccessibilityObjectiveDone(met) && o > floor)
+		{
+			floor = o;
+		}
+	}
+	if (target < 0 || floor < 0 || eta_stepGaveUp == objective)
+	{
+		return qfalse;   /* none before the first objective: the start is led as it was */
+	}
+	for (i = 0; i < eta_playerTriggerCount; i++)
+	{
+		vec3_t mins, maxs, mid;
+		int    o;
+
+		if (!ETA_StepUsable(i))
+		{
+			continue;
+		}
+		o = ETA_StepOrder(eta_playerTriggers[i].event);
+		if (o <= floor || o >= target || ( next >= 0 && o > next ))
+		{
+			continue;
+		}
+		ETA_StepBox(i, mins, maxs);
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		mid[2] = mins[2] + 32.0f < maxs[2] ? mins[2] + 32.0f : mid[2];
+		if (next < 0 || o < next || Distance(mid, cg.predictedPlayerState.origin) < best)
+		{
+			next = o;
+			best = Distance(mid, cg.predictedPlayerState.origin);
+			VectorCopy(mid, out);
+		}
+	}
+	eta_stepLed = next;
+	return (qboolean)( next >= 0 );
+}
+
+/* No way to the step O led to, and it on another floor: the trail is let
+   go of, for the objective itself. Over the rocket base's hanging bridge,
+   which falls under the player into the train tunnel, the bridge's far
+   end was twelve metres up with no way there; the way on from the tunnel
+   is up the first lift, which O finds for the objective. Until the
+   objective is met, or a step further on is walked into. */
+void CG_AccessibilityStepGiveUp(void)
+{
+	vec3_t place;
+	int    objective = 0;
+
+	if (CG_AccessibilityObjectiveInOrder(cg.predictedPlayerState.origin, place, &objective))
+	{
+		eta_stepGaveUp = objective;
+	}
+}
+
+/* The step O led to walked into: the marker on it is reached only then.
+   Beside it, behind the rocket base's moving door, "Marker reached" was
+   said, and O led to the same step, over and over. */
+qboolean CG_AccessibilityStepLedPassed(void)
+{
+	return (qboolean)( eta_stepLed < 0 || eta_stepPassedMax >= eta_stepLed );
+}
