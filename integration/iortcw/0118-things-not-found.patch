+static void ETA_AreaName(int area, char *out, size_t size);
+
+/* O, the way out shut: into the nearest room with things not yet come
+   across, if there is one - to its middle, not to the things. */
+qboolean CG_AccessibilityAreasLeadUnfound(void)
+{
+	vec3_t thing, mins, maxs, mid, at;
+	char   name[128];
+	int    here = CG_AccessibilityAreaHere(), area, n;
+
+	if (!eta_areas.loaded || !CG_AccessibilityThingsUnfoundNearest(here, thing))
+	{
+		return qfalse;
+	}
+	area = ETA_AreaOf(thing);
+	if (area < 0 || !ETA_BspAreas_Bounds(area, mins, maxs))
+	{
+		return qfalse;
+	}
+	VectorAdd(mins, maxs, mid);
+	VectorScale(mid, 0.5f, mid);
+	if (eta_areas.hasSpot[area])
+	{
+		VectorCopy(eta_areas.spot[area], at);
+	}
+	else if (!ETA_BspAreas_PointIn(area, mid, at))
+	{
+		VectorCopy(thing, at);
+	}
+	n = CG_AccessibilityThingsUnfound(area);
+	ETA_AreaName(area, name, sizeof(name));
+	ETA_Speech_Say(va("On to %s: %d %s not found yet there", name, n, n == 1 ? "thing" : "things"));
+	CG_AccessibilityChoose(at, name);
+	return qtrue;
+}
