+/**
+ * @brief The walk guide: led along the way to the marker while walking.
+ *
+ * The tester, in the first mission's dungeon, heard where the walls and
+ * the openings were and still could not get out: knowing the way goes
+ * "ahead left" is not the same as keeping to it round three corners and
+ * through two doors, and they got lost between the walls. So with a
+ * marker set - O puts it on the way out - and the walk key held, the view
+ * is turned for them along the way, the way the ping goes, while they
+ * walk: the player keeps W down and is led there. A closed door on the
+ * way is opened with the use key as they reach it. Held against
+ * something the way did not expect, the way is looked for again.
+ *
+ * It only ever steers while the player walks forward, so stopping gives
+ * the view back; a turn by hand takes it back too, for ETA_AIM_MANUAL_MS,
+ * the way it does from the enemy lock; and the lock, F and a climb all
+ * come first. eta_walkGuide 0 turns it off.
+ */
+#define ETA_GUIDE_TOLERANCE  4.0f    /* degrees off the way that need no turn */
+#define ETA_GUIDE_STUCK_MS   1200    /* this long walking without getting anywhere: stuck */
+#define ETA_GUIDE_STUCK_MOVE 16.0f
+#define ETA_GUIDE_DOOR_MS    1500    /* between presses of use at a door */
+
+static struct
+{
+	qboolean active;      /* the guide holds the turn keys */
+	vec3_t   checkFrom;   /* where the player was at the last stuck check */
+	int      checkAt;
+	int      doorAt;      /* use last pressed at a door */
+	int      replanAt;
+	qboolean detour;      /* gone to the switch that opens the door ahead */
+	vec3_t   detourTo;
+	int      detourAt;
+	int      detourDoor;  /* the door's brush model */
+	int      detourDoneDoor;
+	int      detourDoneAt;
+	vec3_t   detourDoorAt;
+	float    detourBest;  /* the nearest the switch has been come */
+	int      detourBestAt;
+} eta_guide;
+
+/* How near the switch the use key reaches it from the eyes: a little
+   inside the game's own CH_ACTIVATE_DIST. */
+#define ETA_GUIDE_SWITCH_REACH 88.0f
+#define ETA_GUIDE_DETOUR_MS    15000
+
+static void ETA_GuideRelease(void)
+{
+	if (eta_guide.active)
+	{
+		ETA_AimKeys(0, 0);
+		ETA_TurnBoost(qfalse);
+		eta_guide.active = qfalse;
+	}
+	eta_guide.checkAt = 0;
+}
+
+static void ETA_GuideFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	usercmd_t           cmd;
+	vec3_t              target, delta, wanted;
+
+	if (!eta_walkGuide.integer || cg.cameraMode || !cg.snap || ps->pm_type != PM_NORMAL
+	    || eta_turn.step || eta_turn.held
+	    || (cg.time < eta_aim.manualUntil && eta_aim.manualUntil - cg.time <= ETA_AIM_MANUAL_MS)
+	    || !CG_AccessibilityMarkerSteerPoint(target))
+	{
+		ETA_GuideRelease();
+		return;
+	}
+
+	/* Only while walking forward: stopping gives the view back. */
+	if (!trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd) || cmd.forwardmove <= 0)
+	{
+		ETA_GuideRelease();
+		return;
+	}
+
+	/* A door the way goes through that opens from a button or a lever
+	   elsewhere - the dungeon's gates open from a button on the wall
+	   beside them, and pressing use at the gate does nothing: the guide
+	   held the tester's view on the gate, pressing, and they never got
+	   through. So to the switch first, which is pressed, and then on. */
+	if (!eta_guide.detour)
+	{
+		vec3_t doorAt, opener;
+		int    door = CG_AccessibilityDoorAheadModel(doorAt);
+
+		if (door && CG_AccessibilityDoorOpener(door, doorAt, opener)
+		    && (door != eta_guide.detourDoneDoor || cg.time - eta_guide.detourDoneAt > 10000
+		        || cg.time < eta_guide.detourDoneAt))
+		{
+			eta_guide.detour       = qtrue;
+			eta_guide.detourAt     = cg.time;
+			eta_guide.detourDoor   = door;
+			eta_guide.detourBest   = 1.0e9f;
+			eta_guide.detourBestAt = cg.time;
+			VectorCopy(opener, eta_guide.detourTo);
+			VectorCopy(doorAt, eta_guide.detourDoorAt);
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_AimSay("The door opens with a switch. Going to it", opener);
+		}
+	}
+
+	if (eta_guide.detour)
+	{
+		vec3_t eye;
+
+		VectorCopy(ps->origin, eye);
+		eye[2] += ps->viewheight;
+
+		if (Distance(eye, eta_guide.detourTo) < eta_guide.detourBest - 16.0f)
+		{
+			eta_guide.detourBest   = Distance(eye, eta_guide.detourTo);
+			eta_guide.detourBestAt = cg.time;
+		}
+
+		/* No nearer for a while: the switch is out of reach from this
+		   side - the dungeon has a door whose button is behind it. That
+		   door is no way through from here; the way is looked for round
+		   it. */
+		if (cg.time - eta_guide.detourAt > ETA_GUIDE_DETOUR_MS || cg.time < eta_guide.detourAt
+		    || cg.time - eta_guide.detourBestAt > 2000)
+		{
+			eta_guide.detour         = qfalse;
+			eta_guide.detourDoneDoor = eta_guide.detourDoor;
+			eta_guide.detourDoneAt   = cg.time;
+			CG_AccessibilityMarkerBlocked(eta_guide.detourDoorAt, 56.0f);
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("Its switch is out of reach from this side. Finding another way");
+		}
+		else
+		{
+
+			if (Distance(eye, eta_guide.detourTo) <= ETA_GUIDE_SWITCH_REACH)
+			{
+				etaAimTarget_t sw;
+
+				/* There: turned to it, and use pressed on it, as F does. */
+				memset(&sw, 0, sizeof(sw));
+				sw.entityNum = -1;
+				VectorCopy(eta_guide.detourTo, sw.point);
+				Q_strncpyz(sw.name, "Switch", sizeof(sw.name));
+				eta_guide.detour         = qfalse;
+				eta_guide.detourDoneDoor = eta_guide.detourDoor;
+				eta_guide.detourDoneAt   = cg.time;
+				ETA_GuideRelease();
+				ETA_AimStartSnap(&sw, "Switch");
+				eta_use.pending = qtrue;
+				return;
+			}
+
+			VectorCopy(eta_guide.detourTo, target);
+		}
+	}
+
+	VectorSubtract(target, ps->origin, delta);
+	delta[2] = 0.0f;
+	if (VectorLength(delta) < 8.0f)
+	{
+		ETA_GuideRelease();
+		return;
+	}
+
+	wanted[YAW]   = vectoyaw(delta);
+	wanted[PITCH] = ps->viewangles[PITCH] > 30.0f || ps->viewangles[PITCH] < -30.0f ? 0.0f : ps->viewangles[PITCH];
+	wanted[ROLL]  = 0.0f;
+	ETA_AimSteerAngles(wanted, ETA_GUIDE_TOLERANCE);
+	eta_guide.active = qtrue;
+
+	/* A closed door the way goes through: opened as it is reached. */
+	if (!eta_guide.detour && CG_AccessibilityDoorAhead()
+	    && (cg.time - eta_guide.doorAt > ETA_GUIDE_DOOR_MS || cg.time < eta_guide.doorAt))
+	{
+		eta_guide.doorAt = cg.time;
+		ETA_UseKey(qtrue);
+		if (!eta_use.held)
+		{
+			eta_use.releaseAt = cg.time + 150;
+		}
+	}
+
+	/* Walking and getting nowhere: the way is looked for again - but
+	   not on the way to a switch, where walking up to a wall is the
+	   point. */
+	if (eta_guide.detour)
+	{
+		eta_guide.checkAt = 0;
+		return;
+	}
+	if (!eta_guide.checkAt || cg.time < eta_guide.checkAt)
+	{
+		eta_guide.checkAt = cg.time;
+		VectorCopy(ps->origin, eta_guide.checkFrom);
+	}
+	else if (cg.time - eta_guide.checkAt >= ETA_GUIDE_STUCK_MS)
+	{
+		if (Distance(ps->origin, eta_guide.checkFrom) < ETA_GUIDE_STUCK_MOVE)
+		{
+			vec3_t forward, ahead;
+
+			/* What stopped them, a step ahead, is kept clear of from
+			   now on, and the way looked for round it. */
+			AngleVectors(ps->viewangles, forward, NULL, NULL);
+			forward[2] = 0.0f;
+			VectorNormalize(forward);
+			VectorMA(ps->origin, 40.0f, forward, ahead);
+			CG_AccessibilityMarkerBlocked(ahead, 32.0f);
+
+			if (cg.time - eta_guide.replanAt > 5000 || cg.time < eta_guide.replanAt)
+			{
+				eta_guide.replanAt = cg.time;
+				ETA_HudNarrator_HoldPassive(cg.time);
+				ETA_Speech_Say("Something in the way. Finding a way round");
+			}
+		}
+		eta_guide.checkAt = cg.time;
+		VectorCopy(ps->origin, eta_guide.checkFrom);
+	}
+}
