+/**
+ * @brief Spots the walk guide found the player could not get past.
+ *
+ * The search tries each step with the player's own box, and still a low
+ * block in the first mission's dungeon - a stone pedestal with chains -
+ * let the way through, and the walk guide held the tester against it.
+ * Wherever the guide finds the player walking and getting nowhere, the
+ * spot just ahead is kept here, and the way is looked for round it. Kept
+ * until the map changes: what stood in the way still does.
+ */
+#define ETA_ROUTE_BLOCK_MAX    16
+
+static float eta_routeBlocked[ETA_ROUTE_BLOCK_MAX][4];   /* x, y, z, radius */
+static int   eta_routeBlockedCount, eta_routeBlockedNext;
+
+/* Whether a walk from one point to another goes over a blocked spot - a
+   walk that only takes the player further from one they are already at
+   is let through, the way out of it. */
+static qboolean ETA_RouteBlockedNear(const float from[3], const float to[3])
+{
+	float dx = to[0] - from[0], dy = to[1] - from[1];
+	float length2 = dx * dx + dy * dy;
+	int   i;
+
+	for (i = 0; i < eta_routeBlockedCount; i++)
+	{
+		const float *spot = eta_routeBlocked[i];
+		float       f     = length2 > 0.0f ? ((spot[0] - from[0]) * dx + (spot[1] - from[1]) * dy) / length2 : 0.0f;
+		float       ax, ay, closest, already;
+
+		if (fabs(from[2] - spot[2]) >= 64.0f && fabs(to[2] - spot[2]) >= 64.0f)
+		{
+			continue;
+		}
+
+		f       = f < 0.0f ? 0.0f : f > 1.0f ? 1.0f : f;
+		ax      = from[0] + dx * f - spot[0];
+		ay      = from[1] + dy * f - spot[1];
+		closest = sqrt(ax * ax + ay * ay);
+		already = sqrt((from[0] - spot[0]) * (from[0] - spot[0]) + (from[1] - spot[1]) * (from[1] - spot[1]));
+
+		if (closest < spot[3] && closest < already - 1.0f)
+		{
+			return qtrue;
+		}
+		if (length2 <= 0.0f && already < spot[3])
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
 static qboolean ETA_RouteAvoided(const float at[3])
 {
 	int i;
 
+	if (ETA_RouteBlockedNear(at, at))
+	{
+		return qtrue;
+	}
+
 	if (eta_route.throughMines)
 	{
 		return qfalse;
@@ -461,6 +519,11 @@ static qboolean ETA_RouteLineAvoided(const float from[3], const float to[3])
 	float length2 = dx * dx + dy * dy;
 	int   i;
 
+	if (ETA_RouteBlockedNear(from, to))
+	{
+		return qtrue;
+	}
+
 	if (eta_route.throughMines)
 	{
 		return qfalse;
@@ -1669,6 +1732,51 @@ void CG_AccessibilityMarkerReset(void)
 {
 	memset(&eta_marker, 0, sizeof(eta_marker));
 	ETA_RouteForget();
+	eta_routeBlockedCount = eta_routeBlockedNext = 0;
+}
+
+/**
+ * @brief Where the way to the marker goes from here, for the walk guide
+ * (cg_accessibility_keys.c): the point the ping is on. qfalse with no
+ * marker.
+ */
+qboolean CG_AccessibilityMarkerSteerPoint(vec3_t out)
+{
+	if (!eta_marker.active)
+	{
+		return qfalse;
+	}
+
+	ETA_MarkerTarget(out);
+	return qtrue;
+}
+
+/**
+ * @brief The way looked for again from here: the walk guide found the
+ * player held against something the way did not expect.
+ */
+void CG_AccessibilityMarkerReplan(void)
+{
+	if (eta_marker.active)
+	{
+		ETA_RoutePlan();
+	}
+}
+
+/**
+ * @brief A spot the player could not get past: kept clear of from now on,
+ * and the way looked for again round it.
+ */
+void CG_AccessibilityMarkerBlocked(const vec3_t at, float radius)
+{
+	VectorCopy(at, eta_routeBlocked[eta_routeBlockedNext]);
+	eta_routeBlocked[eta_routeBlockedNext][3] = radius;
+	eta_routeBlockedNext = (eta_routeBlockedNext + 1) % ETA_ROUTE_BLOCK_MAX;
+	if (eta_routeBlockedCount < ETA_ROUTE_BLOCK_MAX)
+	{
+		eta_routeBlockedCount++;
+	}
+	CG_AccessibilityMarkerReplan();
 }
 
