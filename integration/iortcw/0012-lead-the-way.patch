+/**
+ * @brief A door right in front of the player, for the walk guide to open:
+ * a door the server sends, which the view's line meets, or one the map
+ * opens through an invisible trigger, standing just ahead. qfalse when
+ * there is none, or it is locked.
+ */
+/* Where a door stands: its brush's middle, round its origin for one
+   that swings. */
+static void ETA_DoorMiddle(int model, const vec3_t entityOrigin, vec3_t out)
+{
+	VectorAdd(entityOrigin, cgs.inlineModelMidpoints[model], out);
+}
+
+/**
+ * @brief The button or switch that opens a door from elsewhere, for the
+ * door with this brush model: qfalse when it is opened by using it - its
+ * opener wrapped round the door itself - or there is no other.
+ */
+qboolean CG_AccessibilityDoorOpener(int model, const vec3_t doorAt, vec3_t out)
+{
+	int opener;
+
+	if (model <= 0 || model >= MAX_MODELS || !(opener = eta_doorOpener[model]))
+	{
+		return qfalse;
+	}
+
+	VectorCopy(cgs.inlineModelMidpoints[opener], out);
+
+	return (qboolean)(Distance(out, doorAt) > 64.0f);
+}
+
+/**
+ * @brief The door the player is walking into, if it is one the server
+ * sends: its brush model and where it stands. 0 for none.
+ */
+int CG_AccessibilityDoorAheadModel(vec3_t doorAt)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              eye, forward, end;
+	trace_t             trace;
+	char                name[64];
+	const entityState_t *es;
+
+	ETA_AimEye(eye);
+	AngleVectors(ps->viewangles, forward, NULL, NULL);
+	forward[2] = 0.0f;
+	VectorNormalize(forward);
+	VectorMA(eye, 64.0f, forward, end);
+
+	CG_Trace(&trace, eye, NULL, NULL, end, ps->clientNum, MASK_SOLID);
+
+	if (trace.fraction >= 1.0f || trace.entityNum < 0 || trace.entityNum >= ENTITYNUM_WORLD)
+	{
+		return 0;
+	}
+
+	es = &cg_entities[trace.entityNum].currentState;
+	if (es->eType != ET_MOVER || es->solid != SOLID_BMODEL || es->modelindex <= 0 || es->modelindex >= MAX_MODELS
+	    || !CG_AccessibilityObjectName(es, name, sizeof(name)) || Q_stricmp(name, "door"))
+	{
+		return 0;
+	}
+
+	ETA_DoorMiddle(es->modelindex, cg_entities[trace.entityNum].lerpOrigin, doorAt);
+	return es->modelindex;
+}
+
+qboolean CG_AccessibilityDoorAhead(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              eye, forward, end, flat;
+	trace_t             trace;
+	int                 i;
+
+	ETA_AimEye(eye);
+	AngleVectors(ps->viewangles, forward, NULL, NULL);
+	VectorCopy(forward, flat);
+	flat[2] = 0.0f;
+	VectorNormalize(flat);
+	VectorMA(eye, 64.0f, flat, end);
+
+	CG_Trace(&trace, eye, NULL, NULL, end, ps->clientNum, MASK_SOLID);
+
+	if (trace.fraction < 1.0f && trace.entityNum >= 0 && trace.entityNum < ENTITYNUM_WORLD)
+	{
+		const entityState_t *es = &cg_entities[trace.entityNum].currentState;
+		char                name[64];
+		qboolean            opens = qtrue;
+
+		if (es->eType == ET_MOVER && CG_AccessibilityObjectName(es, name, sizeof(name))
+		    && !Q_stricmp(name, "door"))
+		{
+			return (qboolean)!(CG_AccessibilityDoorModel(es->modelindex, &opens) && !opens);
+		}
+	}
+
+	for (i = 0; i < eta_userCount; i++)
+	{
+		vec3_t to;
+
+		if (Q_stricmp(eta_users[i].name, "Door"))
+		{
+			continue;
+		}
+		VectorSubtract(cgs.inlineModelMidpoints[eta_users[i].model], eye, to);
+		to[2] = 0.0f;
+		if (VectorLength(to) < 80.0f && DotProduct(to, flat) > 0.7f * VectorLength(to))
+		{
+			return qtrue;
+		}
+	}
+
+	return qfalse;
+}
+
 #endif
