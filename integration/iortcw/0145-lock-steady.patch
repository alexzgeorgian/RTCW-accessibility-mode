+#define ETA_AIM_PULSE_RIGHT "988"
+#define ETA_AIM_PULSE_UP    "987"
+#define ETA_AIM_PULSE_DOWN  "986"
+#define ETA_AIM_KEY_STEADY  "985"
 #define ETA_AIM_SNAP_MS     1500
 #define ETA_AIM_LOST_MS     400
 #define ETA_AIM_MAX_TARGETS 16
@@ -235,6 +240,8 @@ typedef struct
 	int           started;
 	int           yaw;          /* the turn key held: -1 left, 1 right */
