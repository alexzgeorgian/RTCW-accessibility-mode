 	pitchError = AngleSubtract(wanted[PITCH], ps->viewangles[PITCH]);
 	worst      = MAX(fabs(yawError), fabs(pitchError));
 
-	ETA_TurnBoost((qboolean)(worst > ETA_TURN_SLOW_DEGREES));
+	/* Fast only while a whole frame of it falls short of the point. Below
+	   about 47 frames a second a fast frame turned further than the lock
+	   lets go at, so the keys stopped while it stayed fast: the lock stood
+	   12 to 23 degrees off the enemy, said "Locked", and the tester's
+	   shots missed. */
+	ETA_TurnBoost((qboolean)(worst > MAX(ETA_TURN_SLOW_DEGREES,
+	                                     0.14f * (float)cg.frametime * ETA_TURN_FAST_FACTOR)));
+
+	/*
+	 * The lock, the last of the way: a nudge measured to the degree, not
+	 * a key held a frame at a time. Held, the key turns as far as a frame
+	 * lets it, and the lock let go within half that - two or three
+	 * degrees on a slower computer, beside an enemy ten metres off: the
+	 * tester heard "Locked" and their shots went wide. The engine counts
+	 * how long a key was down from the times given with it (IN_KeyUp), so
+	 * a press and a release a few milliseconds apart turn exactly so far.
+	 * One at a time, a frame or two apart, as each takes a frame to show.
+	 */
+	if (eta_aim.mode == ETA_AIM_LOCK && !eta_turn.fast)
+	{
+		char  buf[32];
+		float yawRate, pitchRate, frameMs = cg.frametime > 0 ? (float)cg.frametime : 16.0f;
+		int   yawMs = 0, pitchMs = 0;
+
+		trap_Cvar_VariableStringBuffer("cl_yawspeed", buf, sizeof(buf));
+		yawRate = ( atof(buf) > 1.0f ? atof(buf) : 140.0f ) * 0.001f;
+		trap_Cvar_VariableStringBuffer("cl_pitchspeed", buf, sizeof(buf));
+		pitchRate = ( atof(buf) > 1.0f ? atof(buf) : 140.0f ) * 0.001f;
+
+		if (fabs(yawError) <= yawRate * frameMs && fabs(pitchError) <= pitchRate * frameMs)
+		{
+			ETA_AimKeys(0, 0);
+			if (fabs(yawError) > 0.25f)
+			{
+				yawMs = (int)( fabs(yawError) / yawRate + 0.5f );
+			}
+			if (fabs(pitchError) > 0.25f)
+			{
+				pitchMs = (int)( fabs(pitchError) / pitchRate + 0.5f );
+			}
+			if (( yawMs || pitchMs ) && ( cg.time - eta_aim.pulseAt >= (int)( 2.0f * frameMs ) || cg.time < eta_aim.pulseAt ))
+			{
+				eta_aim.pulseAt = cg.time;
+				if (yawMs)
+				{
+					const char *key = yawError > 0.0f ? ETA_AIM_PULSE_LEFT : ETA_AIM_PULSE_RIGHT;
+					const char *dir = yawError > 0.0f ? "left" : "right";
+
+					trap_SendConsoleCommand(va("+%s %s 1000\n-%s %s %d\n", dir, key, dir, key, 1000 + yawMs));
+				}
+				if (pitchMs)
+				{
+					const char *key = pitchError > 0.0f ? ETA_AIM_PULSE_DOWN : ETA_AIM_PULSE_UP;
+					const char *dir = pitchError > 0.0f ? "lookdown" : "lookup";
+
+					trap_SendConsoleCommand(va("+%s %s 1000\n-%s %s %d\n", dir, key, dir, key, 1000 + pitchMs));
+				}
+			}
+			return (qboolean)( !yawMs && !pitchMs );
+		}
+	}
 
 	/* Let go within half a frame's turn of the point, as the tap does. */
 	perFrame = 0.14f * (float)cg.frametime * (eta_turn.fast ? ETA_TURN_FAST_FACTOR : 1.0f);
@@ -4550,6 +4617,29 @@ static void ETA_EnemyCueFrame(void)
 
 void CG_AccessibilityAimFrame(void)
 {
+	/* The lock pressed for with U turns the player as a sighted player
