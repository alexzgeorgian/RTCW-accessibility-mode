+		                                   && cg.predictedPlayerState.pm_type == PM_NORMAL );
+
+		if (!released)
+		{
+			released = qtrue;
+			trap_SendConsoleCommand("-wbutton6 " ETA_AIM_KEY_STEADY "\n");
+			eta_aim.steady = qfalse;
+		}
+		if (want != eta_aim.steady)
+		{
+			trap_SendConsoleCommand(va("%swbutton6 %s\n", want ? "+" : "-", ETA_AIM_KEY_STEADY));
+			eta_aim.steady = want;
+		}
+	}
+
 	if (cg.snap && cg.snap->ps.pm_type == PM_NORMAL)
 	{
 		ETA_HitFrame();
