+			float  along = 0.0f, prev[3];
+			vec3_t at;
+
 			saidAt = cg.time;
-			ETA_Speech_Say("The way goes through something to break. Break it to get through: T lists it");
+			/* Where along the way: "T lists it" sent the test player to
+			   T, which, in another area, said nothing was left there. The
+			   first point of the way inside a thing to break. */
+			VectorCopy(cg.predictedPlayerState.origin, prev);
+			for (i = eta_route.along; i < count && where < 0; i++)
+			{
+				float point[3];
+
+				ETA_PathFinder_Point(i, point);
+				along += Distance(prev, point);
+				VectorCopy(point, prev);
+				for (n = 0; cg.snap && n < cg.snap->numEntities; n++)
+				{
+					const entityState_t *es = &cg.snap->entities[n];
+					vec3_t               mins, maxs;
+
+					if (es->eType != ET_EXPLOSIVE || es->modelindex <= 0 || es->modelindex >= cgs.numInlineModels
+					    || !cgs.inlineDrawModel[es->modelindex] || !es->solid)
+					{
+						continue;
+					}
+					trap_R_ModelBounds(cgs.inlineDrawModel[es->modelindex], mins, maxs);
+					VectorAdd(mins, cg_entities[es->number].lerpOrigin, mins);
+					VectorAdd(maxs, cg_entities[es->number].lerpOrigin, maxs);
+					if (point[0] > mins[0] - 24.0f && point[0] < maxs[0] + 24.0f && point[1] > mins[1] - 24.0f
+					    && point[1] < maxs[1] + 24.0f && point[2] > mins[2] - 48.0f && point[2] < maxs[2] + 48.0f)
+					{
+						where = n;
+						VectorAdd(mins, maxs, at);
+						VectorScale(at, 0.5f, at);
+						break;
+					}
+				}
+			}
+			if (where >= 0)
+			{
+				int meters = (int)( along * ETA_QU_TO_METERS + 0.5f );
+
+				ETA_Speech_Say(va("The way goes through something to break, %d %s on along it, %s. Once there, T lists it "
+				                  "and F turns you to it", meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters",
+				                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at))));
+			}
+			else
+			{
+				ETA_Speech_Say("The way goes through something to break, further on. Once there, T lists it");
+			}
 		}
 	}
 
@@ -3053,6 +3102,16 @@ void CG_AccessibilityMarkerFrame(void)
