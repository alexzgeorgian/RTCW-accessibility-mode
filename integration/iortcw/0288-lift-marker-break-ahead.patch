+		vec3_t flat;
+
+		VectorSubtract(eta_marker.origin, cg.predictedPlayerState.origin, flat);
+		flat[2] = 0.0f;
+		arrived = (qboolean)( VectorLength(flat) <= 40.0f );
+	}
+
 	/* A lift's call button, the train's lever: reached within F's reach.
 	   The test player, told "Marker reached" three metres off, heard F
 	   say it was too far, again and again. */
@@ -3142,6 +3201,10 @@ void CG_AccessibilityMarkerFrame(void)
 			/* It shuts two seconds after it opens: through at once. */
 			ETA_Speech_Say(va("Marker reached, %s. F opens it, then walk straight in", eta_marker.name));
 		}
+		else if (!Q_stricmp(eta_marker.name, "the inside of the lift"))
+		{
+			ETA_Speech_Say("Marker reached, in the lift. T finds its lever; F on it sends the lift");
+		}
 		else if (!Q_stricmp(eta_marker.name, "the lift's call button"))
 		{
 			ETA_Speech_Say("Marker reached, the lift's call button. F calls the lift; once it is here, step in, "
