+/* The jump just ahead on the way, if there is one: where it lands, and
+   whether it is up onto something. For O, which faces the player across
+   it. */
+qboolean CG_AccessibilityMarkerJumpAhead(vec3_t landingOut, qboolean *up)
+{
+	int    count = ETA_PathFinder_PointCount(), i, last;
+	vec3_t edge, landing, delta;
+
+	if (!eta_marker.active || !eta_route.done || !eta_route.steering)
+	{
+		return qfalse;
+	}
+	last = eta_route.steerIndex + 3 < count ? eta_route.steerIndex + 3 : count - 1;
+	for (i = eta_route.steerIndex > 1 ? eta_route.steerIndex : 1; i <= last; i++)
+	{
+		if (ETA_PathFinder_PointKind(i) != ETA_PATH_JUMP)
+		{
+			continue;
+		}
+		ETA_PathFinder_Point(i - 1, edge);
+		ETA_PathFinder_Point(i, landing);
+		VectorSubtract(edge, cg.predictedPlayerState.origin, delta);
+		delta[2] = 0.0f;
+		if (VectorLength(delta) > 128.0f)
+		{
+			return qfalse;
+		}
+		VectorCopy(landing, landingOut);
+		*up = (qboolean)( landing[2] > edge[2] + 8.0f );
+		return qtrue;
+	}
+	return qfalse;
+}
