+/* A key's name alone, "space", "w": or what it does, when on no key
+   the stock names know. */
+static const char *ETA_RouteKeyName(const char *binding, const char *otherwise)
+{
+	static char names[2][24];
+	static int  which;
+	const char *said = ETA_RouteKey(binding);
+
+	which = !which;
+	if (!Q_strncmp(said, ", press ", 8))
+	{
+		Q_strncpyz(names[which], said + 8, sizeof(names[0]));
+	}
+	else
+	{
+		Q_strncpyz(names[which], otherwise, sizeof(names[0]));
+	}
+	return names[which];
+}
