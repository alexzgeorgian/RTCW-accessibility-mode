diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index 5c48aa23..d21e4fb2 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -3978,6 +3978,248 @@ void CG_AccessibilityFaceTheWay(void)
 
 /* Every frame: a face asked for before the way was known, done once it
    is - or given up on. */
+/*
+ * "Cross for me" (/ by default). The crypt's swinging blade killed the
+ * tester again and again going for the button past it: judging the safe
+ * moment, and running dead straight through, take eyes. The blade, its
+ * timing and its danger stay as the game made them; this only waits for
+ * the safe moment and runs the player straight across, then stops. F is
+ * still the player's. Any move of their own stops it.
+ */
+static struct
+{
+	int      stage;        /* 0 off, 1 waiting, 2 facing, 3 running */
+	vec3_t   target;       /* where the run ends */
+	char     goalName[48]; /* what O leads to beyond it, if anything */
+	qboolean haveGoal;
+	qboolean sawUnsafe;    /* the trap seen not safe since waiting began */
+	int      stageAt;
+	vec3_t   lastPos;
+	int      lastMoveAt;
+	char     kind[16];
+} eta_cross;
+
+static void ETA_CrossStop(const char *say)
+{
+	if (eta_cross.stage == 3)
+	{
+		trap_SendConsoleCommand("-forward\n");
+	}
+	eta_cross.stage = 0;
+	if (say)
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(say);
+	}
+}
+
+void CG_AccessibilityCrossTrap(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t               mins, maxs, mid, dir, goal;
+	float                margin, gap, across;
+	qboolean             safe, everMoved;
+	const char          *goalName = NULL;
+
+	if (eta_cross.stage)
+	{
+		ETA_CrossStop("Crossing stopped");
+		return;
+	}
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	if (!CG_AccessibilityTrapNear(mins, maxs, &margin, &gap, &safe, &everMoved, eta_cross.kind, sizeof(eta_cross.kind)))
+	{
+		ETA_Speech_Say("No trap to cross here. It works within 12 meters of a blade or the saws");
+		return;
+	}
+
+	/* Across: from here, through the middle of its reach, to its far
+	   side and a little more - or to what O leads to, if that lies
+	   beyond it, close by. */
+	VectorAdd(mins, maxs, mid);
+	VectorScale(mid, 0.5f, mid);
+	VectorSubtract(mid, ps->origin, dir);
+	dir[2] = 0.0f;
+	if (VectorNormalize(dir) < 1.0f)
+	{
+		return;
+	}
+	/* Along the narrow way through it: the longer side of its box. */
+	if (maxs[0] - mins[0] > maxs[1] - mins[1])
+	{
+		dir[1] = 0.0f;
+	}
+	else
+	{
+		dir[0] = 0.0f;
+	}
+	VectorNormalize(dir);
+	{
+		float far = 0.0f;
+		int   k;
+
+		for (k = 0; k < 2; k++)
+		{
+			if (dir[k] > 0.5f)
+			{
+				far = maxs[k] - ps->origin[k];
+			}
+			else if (dir[k] < -0.5f)
+			{
+				far = ps->origin[k] - mins[k];
+			}
+		}
+		across = far + 18.0f + margin + 32.0f;
+	}
+	VectorMA(ps->origin, across, dir, eta_cross.target);
+	eta_cross.haveGoal = qfalse;
+	if (CG_AccessibilityMarkerInfo(goal, &goalName))
+	{
+		vec3_t toGoal;
+		float  along;
+
+		VectorSubtract(goal, ps->origin, toGoal);
+		toGoal[2] = 0.0f;
+		along = DotProduct(toGoal, dir);
+		/* Beyond its reach, and not far past: run on to it, stopping a
+		   body's width short. */
+		if (along > across - 40.0f && along < across + 320.0f
+		    && VectorLength(toGoal) - along < 96.0f)
+		{
+			VectorMA(ps->origin, along - 40.0f, dir, eta_cross.target);
+			eta_cross.haveGoal = qtrue;
+			Q_strncpyz(eta_cross.goalName, goalName ? goalName : "it", sizeof(eta_cross.goalName));
+		}
+	}
+	eta_cross.target[2] = ps->origin[2];
+	eta_cross.sawUnsafe = (qboolean)!safe;
+	eta_cross.stageAt   = cg.time;
+	/* Never moved yet, and at rest: no swing to wait for. Otherwise the
+	   next safe moment, from its start, so the whole of it is the run's. */
+	eta_cross.stage = 1;
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(va("Crossing. Waiting for the %s: stay still. Any move of yours stops it", eta_cross.kind));
+	if (safe && !everMoved)
+	{
+		eta_cross.sawUnsafe = qtrue;
+	}
+}
+
+static void ETA_CrossFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	usercmd_t            cmd;
+	vec3_t               mins, maxs;
+	float                margin, gap;
+	qboolean             safe, everMoved;
+	char                 kind[16];
+
+	if (!eta_cross.stage)
+	{
+		return;
+	}
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		ETA_CrossStop(NULL);
+		return;
+	}
+	/* The player's own move stops it: back, aside, a jump - or, while
+	   waiting, forward too. */
+	trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd);
+	if (cmd.rightmove || cmd.upmove > 0 || cmd.forwardmove < 0 || ( eta_cross.stage == 1 && cmd.forwardmove > 0 ))
+	{
+		ETA_CrossStop("Crossing stopped");
+		return;
+	}
+	if (!CG_AccessibilityTrapNear(mins, maxs, &margin, &gap, &safe, &everMoved, kind, sizeof(kind)))
+	{
+		ETA_CrossStop(NULL);
+		return;
+	}
+
+	if (eta_cross.stage == 1)
+	{
+		if (!safe)
+		{
+			eta_cross.sawUnsafe = qtrue;
+		}
+		else if (eta_cross.sawUnsafe)
+		{
+			etaAimTarget_t aim;
+
+			memset(&aim, 0, sizeof(aim));
+			aim.entityNum = -1;
+			VectorCopy(eta_cross.target, aim.point);
+			aim.point[2] += cg.predictedPlayerState.viewheight - 8.0f;
+			ETA_AimStartSnap(&aim, NULL);
+			eta_cross.stage   = 2;
+			eta_cross.stageAt = cg.time;
+			ETA_Speech_Say("Now");
+		}
+		else if (cg.time - eta_cross.stageAt > 30000)
+		{
+			ETA_CrossStop("Crossing stopped: the trap did not come to rest");
+		}
+		return;
+	}
+
+	if (eta_cross.stage == 2)
+	{
+		vec3_t to;
+		float  off;
+
+		VectorSubtract(eta_cross.target, ps->origin, to);
+		off = fabsf(AngleNormalize180(vectoyaw(to) - ps->viewangles[YAW]));
+		if (off < 6.0f || cg.time - eta_cross.stageAt > 600)
+		{
+			trap_SendConsoleCommand("+forward\n");
+			eta_cross.stage      = 3;
+			eta_cross.stageAt    = cg.time;
+			eta_cross.lastMoveAt = cg.time;
+			VectorCopy(ps->origin, eta_cross.lastPos);
+		}
+		return;
+	}
+
+	/* Running: there, past it, held up, or too long. */
+	{
+		vec3_t to, flat;
+		float  left;
+
+		VectorSubtract(eta_cross.target, ps->origin, to);
+		to[2] = 0.0f;
+		left  = VectorLength(to);
+		VectorSubtract(ps->origin, eta_cross.lastPos, flat);
+		flat[2] = 0.0f;
+		if (VectorLength(flat) > 8.0f)
+		{
+			eta_cross.lastMoveAt = cg.time;
+			VectorCopy(ps->origin, eta_cross.lastPos);
+		}
+		if (left < 24.0f || DotProduct(to, ps->velocity) < 0.0f && cg.time - eta_cross.stageAt > 300)
+		{
+			char said[160];
+
+			if (eta_cross.haveGoal)
+			{
+				Com_sprintf(said, sizeof(said), "Across. %s, ahead: F uses it", eta_cross.goalName);
+			}
+			else
+			{
+				Q_strncpyz(said, "Across", sizeof(said));
+			}
+			ETA_CrossStop(said);
+		}
+		else if (cg.time - eta_cross.lastMoveAt > 700 || cg.time - eta_cross.stageAt > 5000)
+		{
+			ETA_CrossStop("Crossing stopped: something is in the way");
+		}
+	}
+}
+
