+/*
+ * For the crossing key: the nearest trap whose reach is known, on the
+ * player's floor and close by - its reach, the margin kept from it, how
+ * far the player's body is from it, whether it is safe now, whether it
+ * has ever moved, and its kind. qfalse if none within 12 metres.
+ */
+qboolean CG_AccessibilityTrapNear(vec3_t mins, vec3_t maxs, float *margin, float *gapOut, qboolean *safe,
+                                  qboolean *everMoved, char *kind, size_t kindSize)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                  g, best = -1, i;
+	float                bestGap = 480.0f;
+
+	for (g = 0; g < eta_trapGroupCount; g++)
+	{
+		float gap;
+
+		if (eta_trapGroups[g].zoneDone != 2
+		    || ps->origin[2] < eta_trapGroups[g].zoneMins[2] - 48.0f || ps->origin[2] > eta_trapGroups[g].zoneMaxs[2] + 48.0f)
+		{
+			continue;
+		}
+		gap = ETA_ZoneGap(ps->origin, eta_trapGroups[g].zoneMins, eta_trapGroups[g].zoneMaxs);
+		if (gap < bestGap)
+		{
+			bestGap = gap;
+			best    = g;
+		}
+	}
+	if (best < 0)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_trapGroups[best].zoneMins, mins);
+	VectorCopy(eta_trapGroups[best].zoneMaxs, maxs);
+	*margin    = ETA_TrapMargin(best);
+	*gapOut    = bestGap;
+	*safe      = (qboolean)( eta_trapGroups[best].state == ETA_TRAP_REST );
+	*everMoved = eta_trapGroups[best].everFast;
+	Q_strncpyz(kind, "trap", kindSize);
+	for (i = 0; i < eta_trapMoverCount; i++)
+	{
+		if (eta_trapMovers[i].group == best)
+		{
+			Q_strncpyz(kind, eta_trapMovers[i].kind, kindSize);
+			break;
+		}
+	}
+	return qtrue;
+}
