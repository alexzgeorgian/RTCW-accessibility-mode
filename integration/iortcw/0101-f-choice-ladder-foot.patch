diff --git a/SP/code/cgame/cg_accessibility_route.c b/SP/code/cgame/cg_accessibility_route.c
index caea9a8e..895582e8 100644
--- a/SP/code/cgame/cg_accessibility_route.c
+++ b/SP/code/cgame/cg_accessibility_route.c
@@ -1093,6 +1093,41 @@ void CG_AccessibilityNavSweep_f(void)
 	trap_Argv(1, arg, sizeof(arg));
 	most = atoi(arg) > 0 ? atoi(arg) : 400;
 	CG_AccessibilityWorldReadNow();
+	/* "route x y z x y z": one search, its state and its points. */
+	if (!Q_stricmp(arg, "route"))
+	{
+		float         start[3], goal[3], from[3], point[3];
+		char          num[16];
+		int           k, began, count;
+		ETA_PathState state;
+
+		for (k = 0; k < 3; k++)
+		{
+			trap_Argv(2 + k, num, sizeof(num));
+			from[k] = (float)atof(num);
+			trap_Argv(5 + k, num, sizeof(num));
+			goal[k] = (float)atof(num);
+		}
+		ETA_RouteLockedDoors();
+		ETA_RouteStartAt(from, start);
+		ETA_PathFinder_Begin(start, goal, ETA_ROUTE_CELL, ETA_MARKER_ARRIVE_METERS / ETA_QU_TO_METERS, qfalse);
+		began = trap_Milliseconds();
+		do
+		{
+			state = ETA_PathFinder_Step(ETA_ROUTE_BUDGET_STEP, ETA_RouteMove, NULL);
+		}
+		while (state == ETA_PATH_SEARCHING && trap_Milliseconds() - began < 4000);
+		count = ETA_PathFinder_PointCount();
+		CG_Printf("ETASWEEP route state %d start %.0f %.0f %.0f points %d locked %d breakables %d alltried %d\n", state,
+		          start[0], start[1], start[2], count, eta_routeLockedCount, eta_routeBreakables, ETA_PathFinder_AllTried());
+		for (k = 0; k < count; k++)
+		{
+			ETA_PathFinder_Point(k, point);
+			CG_Printf("ETASWEEP point %d kind %d %.0f %.0f %.0f\n", k, ETA_PathFinder_PointKind(k), point[0], point[1], point[2]);
+		}
+		ETA_RouteForget();
+		return;
+	}
 	if (!Q_stricmp(arg, "areas"))
 	{
 		CG_AccessibilityAreasDump();
