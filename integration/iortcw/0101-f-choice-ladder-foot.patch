+			if (ahead && CG_AccessibilityThingChoice(chosenAt, chosenName, sizeof(chosenName), &chosenPending)
+			    && Q_stricmpn(chosenName, "Tram,", 5) && Q_stricmpn(chosenName, "the tram", 8))
