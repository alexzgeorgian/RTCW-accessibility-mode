+/* Said with "Locked": an enemy nearer than the one taken, out of sight.
+   The tester, by the forest's watchtower, its guard above them through
+   the tower's floor, locked on and was turned to a soldier fifty metres
+   off, and took the lock for wrong: it takes the nearest it can see. */
+static char eta_lockNearer[128];
+
+static void ETA_LockNearerNote(void)
+{
+	const float *me = cg.predictedPlayerState.origin;
+	float       taken, best;
+	int         i, nearest = -1;
+
+	eta_lockNearer[0] = '\0';
+	if (!cg.snap || eta_aim.entityNum < 0 || eta_aim.entityNum >= MAX_GENTITIES)
+	{
+		return;
+	}
+	taken = Distance(cg_entities[eta_aim.entityNum].lerpOrigin, me);
+	best  = taken - 3.0f / ETA_QU_TO_METERS;
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es   = &cg.snap->entities[i];
+		const centity_t     *cent = &cg_entities[es->number];
+		float               far;
+
+		if (es->number == eta_aim.entityNum || es->number == cg.snap->ps.clientNum || es->eType != ET_PLAYER
+		    || !es->aiChar || (es->eFlags & EF_DEAD) || es->teamNum == cg.snap->ps.teamNum)
+		{
+			continue;
+		}
+		far = Distance(cent->lerpOrigin, me);
+		if (far < best)
+		{
+			best    = far;
+			nearest = es->number;
+		}
+	}
+	if (nearest >= 0)
+	{
+		const centity_t *cent   = &cg_entities[nearest];
+		float           up      = ( cent->lerpOrigin[2] - me[2] ) * ETA_QU_TO_METERS;
+		int             meters  = (int)( best * ETA_QU_TO_METERS + 0.5f );
+		int             rise    = (int)( fabsf(up) + 0.5f );
+
+		Com_sprintf(eta_lockNearer, sizeof(eta_lockNearer), "A nearer one out of sight: %s, %s, %d meters%s",
+		            CG_AccessibilityCharacterName(nearest),
+		            ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(cent->lerpOrigin)), meters,
+		            rise < 2 ? "" : va(", %d meters %s you", rise, up > 0 ? "above" : "below"));
+	}
+}
+
 /**
