+/* What T chose, for F - but not a quiet alarm box: F would press it,
+   and it would ring. T still turns to it and says it. */
+static qboolean ETA_FThingChoice(vec3_t at, char *name, int size, qboolean *pending)
+{
+	if (!CG_AccessibilityThingChoice(at, name, size, pending))
+	{
+		return qfalse;
+	}
+	return (qboolean)( Q_stricmpn(name, "alarm box", 9) || Q_stristr(name, "ringing") );
