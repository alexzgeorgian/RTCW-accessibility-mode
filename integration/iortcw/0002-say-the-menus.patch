+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * [Accessibility]: what the menus say beyond the controls themselves.
+ * Ported from the mod's No Quarter menus, and written for the campaign.
+ */
+
+/* Said over whatever was being said: where the player is, or an answer. */
+static void UI_AccessibilitySay( const char *text ) {
+	ETA_MenuNarrator_OnConfirmDialogShown( text );
+}
+
+/*
+ * The campaign's maps, by the names its own pages give them: the mission
+ * and the part, as the briefing heads them. A map not listed is said by
+ * its file name.
+ */
+static const struct {
+	const char *map;
+	const char *name;
+} eta_maps[] = {
+	{ "escape1",   "Mission 1, Ominous Rumors. Escape" },
+	{ "escape2",   "Mission 1, Ominous Rumors. Castle Keep" },
+	{ "tram",      "Mission 1, Ominous Rumors. Tram Ride" },
+	{ "village1",  "Mission 2, Dark Secret. Village" },
+	{ "crypt1",    "Mission 2, Dark Secret. Catacombs" },
+	{ "crypt2",    "Mission 2, Dark Secret. Crypt" },
+	{ "church",    "Mission 2, Dark Secret. Defiled Church" },
+	{ "boss1",     "Mission 2, Dark Secret. Tomb" },
+	{ "forest",    "Mission 3, Weapons of Vengeance. Forest Compound" },
+	{ "rocket",    "Mission 3, Weapons of Vengeance. Rocket Base" },
+	{ "baseout",   "Mission 3, Weapons of Vengeance. Radar Installation" },
+	{ "assault",   "Mission 3, Weapons of Vengeance. Air Base Assault" },
+	{ "sfm",       "Mission 4, Deadly Designs. Kugelstadt" },
+	{ "factory",   "Mission 4, Deadly Designs. The Bombed Factory" },
+	{ "trainyard", "Mission 4, Deadly Designs. The Trainyards" },
+	{ "swf",       "Mission 4, Deadly Designs. Secret Weapons Facility" },
+	{ "norway",    "Mission 5, Deathshead's Playground. Ice Station Norway" },
+	{ "xlabs",     "Mission 5, Deathshead's Playground. X-Labs" },
+	{ "boss2",     "Mission 5, Deathshead's Playground. Super Soldier" },
+	{ "dam",       "Mission 6, Return Engagement. Bramburg Dam" },
+	{ "village2",  "Mission 6, Return Engagement. Paderborn Village" },
+	{ "chateau",   "Mission 6, Return Engagement. Chateau Schufstaffel" },
+	{ "dark",      "Mission 6, Return Engagement. Unhallowed Ground" },
+	{ "dig",       "Mission 7, Operation Resurrection. The Dig" },
+	{ "castle",    "Mission 7, Operation Resurrection. Return to Castle Wolfenstein" },
+	{ "end",       "Mission 7, Operation Resurrection. Heinrich" },
+};
+
+static const char *UI_AccessibilityMapName( const char *map ) {
+	int i;
+
+	for ( i = 0; i < (int)( sizeof( eta_maps ) / sizeof( eta_maps[0] ) ); i++ ) {
+		if ( !Q_stricmp( map, eta_maps[i].map ) ) {
+			return eta_maps[i].name;
+		}
+	}
+	return map;
+}
+
+/*
+ * The menus by what they are, said as each opens: on screen the title
+ * is a picture, and a menu that opened in silence left the player not
+ * knowing the key had done anything.
+ */
+static const struct {
+	const char *menu;
+	const char *name;
+	qboolean    read;       /* a page of reading: its words said too */
+} eta_menus[] = {
+	{ "main",                   "Main menu",                      qfalse },
+	{ "play_menu",              "New game. Choose a skill level", qfalse },
+	{ "load_menu",              "Load game",                      qfalse },
+	{ "ingame_load",            "Load game",                      qfalse },
+	{ "ingame_save",            "Save game",                      qfalse },
+	{ "setup_menu",             "Options",                        qfalse },
+	{ "options_menu",           "Game options",                   qfalse },
+	{ "ingame_options",         "Game options",                   qfalse },
+	{ "control_menu",           "Controls",                       qfalse },
+	{ "ingame_controls",        "Controls",                       qfalse },
+	{ "system_menu",            "System",                         qfalse },
+	{ "ingame_system",          "System",                         qfalse },
+	{ "mods_menu",              "Mods",                           qfalse },
+	{ "ingame",                 "Game paused. In-game menu",      qfalse },
+	{ "ingame_leave",           "Leave the game",                 qfalse },
+	{ "credit",                 "Credits",                        qtrue  },
+	{ "quitCredit",             "Credits",                        qtrue  },
+	{ "notebook",               "Notebook",                       qtrue  },
+	{ "clipboard",              "Clipboard",                      qtrue  },
+	{ "hbook1",                 "Book",                           qtrue  },
+	{ "hbook2",                 "Book",                           qtrue  },
+	{ "hbook3",                 "Book",                           qtrue  },
+	{ "default_menu",           "Reset to defaults",              qfalse },
+	{ "resetscore_menu",        "Reset the high scores",          qfalse },
+	{ "cdkey_menu",             "CD key",                         qfalse },
+};
+
+/*
+ * The mission's orders, before it starts. The screen waits on a click
+ * on an arrow that only appears under the pointer, so the keyboard could
+ * never start the mission: Enter does it now, and the page says so.
+ */
+static void UI_AccessibilityPregame( menuDef_t *menu ) {
+	char text[4096];
+	char map[MAX_QPATH];
+
+	trap_Cvar_VariableStringBuffer( "mapname", map, sizeof( map ) );
+	if ( !Q_stricmpn( map, "cutscene", 8 ) ) {
+		/* The story between missions, played in the game itself. Once
+		   it runs, the game takes every key but the three that skip it. */
+		UI_AccessibilitySay( "Cutscene. Press Enter to watch it. Escape, Space or Enter skips it once it plays" );
+		return;
+	}
+	UI_AccessibilitySay( va( "%s. Briefing", UI_AccessibilityMapName( map ) ) );
+	if ( ETA_MenuScreenText( menu, text, sizeof( text ) ) ) {
+		ETA_Speech_SayLong( text );
+	}
+	ETA_Speech_Say( "Press Enter to begin the mission. F7 reads this again" );
+}
+
+static void UI_AccessibilityMenuOpened( menuDef_t *menu ) {
+	char text[4096];
+	const char *name = menu->window.name;
+	int i;
+
+	if ( !name ) {
+		return;
+	}
+
+	if ( !Q_stricmp( name, "pregame" ) ) {
+		UI_AccessibilityPregame( menu );
+		return;
+	}
+
+	/* Shown while the mission loads, and the same words come again on
+	   the page after it; the game is too busy loading to speak. */
+	if ( !Q_stricmp( name, "briefing" ) ) {
+		return;
+	}
+
+	if ( menu->window.flags & WINDOW_POPUP ) {
+		/* A popup is a question or a message: all of it is said. */
+		if ( ETA_MenuScreenText( menu, text, sizeof( text ) ) ) {
+			UI_AccessibilitySay( text );
+		}
+		return;
+	}
+
+	for ( i = 0; i < (int)( sizeof( eta_menus ) / sizeof( eta_menus[0] ) ); i++ ) {
+		if ( !Q_stricmp( name, eta_menus[i].menu ) ) {
+			UI_AccessibilitySay( eta_menus[i].name );
+			if ( eta_menus[i].read && ETA_MenuScreenText( menu, text, sizeof( text ) ) ) {
+				ETA_Speech_SayLong( text );
+			}
+			return;
+		}
+	}
+}
+
+/* The read key: everything the screen on top shows in words. */
+static void UI_AccessibilityReadScreen( void ) {
+	char text[4096];
+	menuDef_t *menu = Menu_GetFocused();
+
+	if ( !menu ) {
+		return;
+	}
+	if ( !ETA_MenuScreenText( menu, text, sizeof( text ) ) ) {
+		UI_AccessibilitySay( "Nothing to read here" );
+		return;
+	}
+	ETA_Speech_Stop();
+	ETA_Speech_SayLong( text );
+}
+
+/*
+ * A saved game, as said when the list is on it: its name, the mission it
+ * was saved in, and when.
+ */
+static const char *UI_AccessibilityFeederRow( int feederID, int index ) {
+	static char row[512];
+	savegameInfo *save;
+
+	if ( feederID != FEEDER_SAVEGAMES || index < 0 || index >= uiInfo.savegameCount ) {
+		return NULL;
+	}
+
+	save = &uiInfo.savegameList[uiInfo.savegameStatus.displaySavegames[index]];
+	Com_sprintf( row, sizeof( row ), "%s, %s, %s %s",
+				 save->savegameName && save->savegameName[0] ? save->savegameName : "unnamed",
+				 save->mapName ? UI_AccessibilityMapName( save->mapName ) : "unknown mission",
+				 save->date ? save->date : "", save->time ? save->time : "" );
+	return row;
+}
+
+/*
+ * The keys the accessibility commands need, offered once if the player
+ * has not already spoken for them. A key already bound is left alone, and
+ * eta_bindsInstalled, archived, records the newest generation offered, so
+ * a key deliberately unbound does not come back - while keys added by a
+ * later version are still offered.
+ *
+ * F6, F7 and F8 are free in the stock default.cfg, which binds F4, F5,
+ * F9 and F11.
+ */
+void UI_AccessibilityInstallBinds( void ) {
+	static const struct {
+		int key;
+		const char  *command;
+		int generation;
+	} binds[] = {
+		{ K_F6, "accessibilityRepeat",     1 },
+		{ K_F7, "accessibilityReadScreen", 1 },
+		{ K_F8, "accessibilityStopSpeech", 1 },
+	};
+
+	vmCvar_t installed;
+	int i;
+	int newest = 0;
+
+	trap_Cvar_Register( &installed, "eta_bindsInstalled", "0", CVAR_ARCHIVE );
+
+	for ( i = 0; i < (int)( sizeof( binds ) / sizeof( binds[0] ) ); i++ ) {
+		char current[MAX_STRING_CHARS];
+
+		if ( binds[i].generation > newest ) {
+			newest = binds[i].generation;
+		}
+
+		if ( binds[i].generation <= installed.integer ) {
+			continue;
+		}
+
+		current[0] = '\0';
+		trap_Key_GetBindingBuf( binds[i].key, current, sizeof( current ) );
+
+		if ( current[0] == '\0' ) {
+			trap_Key_SetBinding( binds[i].key, binds[i].command );
+		}
+	}
+
+	if ( newest > installed.integer ) {
+		trap_Cvar_Set( "eta_bindsInstalled", va( "%i", newest ) );
+	}
+
+	/* The controls page keeps its own copy of which key each command is
+	   on, read at start-up. Left stale, the first key changed there would
+	   write that copy back over what was just installed. */
+	Controls_GetConfig();
+}
+
+/*
+ * The mod's own keys, while a menu has the keyboard. The menus take
+ * every key and run no binds, so F6 and the rest only reach the commands
+ * through here. The key's own bind decides, so a player who moved them
+ * keeps their keys.
+ */
+static qboolean UI_AccessibilityKey( int key ) {
+	char bind[MAX_STRING_CHARS];
+
+	if ( g_waitingForKey || g_editingField ) {
+		return qfalse;
+	}
+
+	bind[0] = '\0';
+	trap_Key_GetBindingBuf( key, bind, sizeof( bind ) );
+	if ( !bind[0] ) {
+		return qfalse;
+	}
+
+	return UI_AccessibilityCommand( bind );
+}
+
+/* The accessibility commands the ui answers, by name; qtrue if it did. */
+qboolean UI_AccessibilityCommand( const char *cmd ) {
+	/* Reached two ways. Before a game there is no cgame, so the name the
+	   player bound comes here. In a game the cgame is asked first and
+	   hands it over under the "...Menu" name when a menu is open. */
+	if ( !Q_stricmp( cmd, "accessibilityRepeat" ) || !Q_stricmp( cmd, "accessibilityRepeatMenu" ) ) {
+		ETA_MenuNarrator_RepeatCurrentItem();
+		return qtrue;
+	}
+	if ( !Q_stricmp( cmd, "accessibilityStopSpeech" ) || !Q_stricmp( cmd, "accessibilityStopSpeechMenu" ) ) {
+		ETA_MenuNarrator_Stop();
+		return qtrue;
+	}
+	if ( !Q_stricmp( cmd, "accessibilityReadScreen" ) || !Q_stricmp( cmd, "accessibilityReadScreenMenu" ) ) {
+		UI_AccessibilityReadScreen();
+		return qtrue;
+	}
+	/* Not a key a player binds: how resetting the controls puts the
+	   mod's keys back, queued behind the config that took them away. */
+	if ( !Q_stricmp( cmd, "accessibilityInstallBinds" ) ) {
+		UI_AccessibilityInstallBinds();
+		return qtrue;
+	}
+	return qfalse;
+}
+
+/*
+ * Says when the console opens or closes over the menus. A tester opened
+ * it by mistake and never knew. Only before a game: in one, the cgame's
+ * own speech covers it.
+ */
+static void UI_AccessibilityConsoleFrame( void ) {
+	static qboolean wasOpen;
+	uiClientState_t cstate;
+	qboolean open = ( trap_Key_GetCatcher() & KEYCATCH_CONSOLE ) ? qtrue : qfalse;
+
+	trap_GetClientState( &cstate );
+	if ( cstate.connState == CA_ACTIVE ) {
+		wasOpen = open;
+		return;
+	}
+
+	if ( open == wasOpen ) {
+		return;
+	}
+	wasOpen = open;
+
+	UI_AccessibilitySay( open ? "Console open. The same key closes it" : "Console closed" );
+}
+#endif
