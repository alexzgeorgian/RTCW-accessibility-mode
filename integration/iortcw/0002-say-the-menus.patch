+/*
+ * How far one arrow-key press moves a slider: twenty presses end to end,
+ * snapped to a step of 1, 2 or 5, so every value said is one a person
+ * would choose - 0.05 for a volume, a whole 1 for a sensitivity.
+ */
+static float ETA_SliderStep( float minVal, float maxVal ) {
+	float range = maxVal - minVal;
+	float magnitude = 1.0f;
+	float raw;
+	int guard;
+
+	if ( !( range > 0.0f ) ) {
+		return 0.0f;
+	}
+
+	raw = range / 20.0f;
+
+	for ( guard = 0; raw >= 10.0f && guard < 64; guard++ ) {
+		raw /= 10.0f;
+		magnitude *= 10.0f;
+	}
+
+	for ( guard = 0; raw < 1.0f && guard < 64; guard++ ) {
+		raw *= 10.0f;
+		magnitude /= 10.0f;
+	}
+
+	if ( raw < 1.5f ) {
+		raw = 1.0f;
+	} else if ( raw < 3.5f ) {
+		raw = 2.0f;
+	} else if ( raw < 7.5f ) {
+		raw = 5.0f;
+	} else {
+		raw = 10.0f;
+	}
+
+	return raw * magnitude;
+}
+
+/* One arrow-key press. Snaps to the nearest step first, so a slider the
+   mouse left at 0.3712 moves along steps the player can predict. */
+static float ETA_SliderNudge( editFieldDef_t *editDef, float current, int direction ) {
+	float step = ETA_SliderStep( editDef->minVal, editDef->maxVal );
+	float rung;
+
+	if ( step <= 0.0f ) {
+		return current;
+	}
+
+	rung = (float)floor( (double)( ( current - editDef->minVal ) / step ) + 0.5 );
+	return editDef->minVal + ( rung + (float)direction ) * step;
+}
+#endif
