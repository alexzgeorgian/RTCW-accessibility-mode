+#define ETA_CHOOSE_STRAY 1000.0f   /* off the list, still turned to this near */
+
+/* Where the chosen thing is now, though it is off the list - out of
+   sight from where the player has walked to, round a door frame or a
+   corner: an entity where the game still has it, anything else where it
+   was. qfalse when it is gone, or too far to be the one meant. */
+static qboolean ETA_ChooseWhere(const etaAimTarget_t *target, vec3_t point)
+{
+	if (target->entityNum >= 0 && target->entityNum < MAX_GENTITIES)
+	{
+		const centity_t     *cent = &cg_entities[target->entityNum];
+		const entityState_t *es   = &cent->currentState;
+
+		if (!cent->currentValid || (es->eFlags & EF_NODRAW))
+		{
+			return qfalse;
+		}
+		VectorCopy(cent->lerpOrigin, point);
+		if (es->solid == SOLID_BMODEL && es->modelindex > 0 && es->modelindex < MAX_MODELS
+		    && es->eType != ET_ITEM)
+		{
+			VectorAdd(point, cgs.inlineModelMidpoints[es->modelindex], point);
+		}
+		else if (es->eType == ET_ITEM)
+		{
+			point[2] += 8.0f;
+		}
+	}
+	else
+	{
+		VectorCopy(target->point, point);
+	}
+
+	return (qboolean)(Distance(cg.predictedPlayerState.origin, point) <= ETA_CHOOSE_STRAY);
+}
+
+/* The chosen one: F's answer before anything else.
+   ETA_CHOOSE_NONE when nothing is chosen; ETA_CHOOSE_FOUND with its
+   place on the list; ETA_CHOOSE_DONE when F has been answered without
+   the list - turned to it out of sight, or told it is gone. Never the
+   nearest thing instead: the tester chose with K, pressed F, and was
+   turned to something else close by, because what they chose had gone
+   out of sight as they walked. */
+#define ETA_CHOOSE_NONE  0
+#define ETA_CHOOSE_FOUND 1
+#define ETA_CHOOSE_DONE  2
+
+static int ETA_ChooseTake(const etaAimTarget_t *list, int count, int *index)
 {
+	vec3_t point;
+
 	if (!eta_choose.held || cg.time < eta_choose.at || cg.time - eta_choose.at >= ETA_CHOOSE_HOLD_MS)
 	{
 		eta_choose.held = qfalse;
-		return qfalse;
+		return ETA_CHOOSE_NONE;
 	}
 
 	eta_choose.held = qfalse;
 	*index          = ETA_ChooseFind(list, count, &eta_choose.target);
 
-	if (*index < 0)
+	if (*index >= 0)
 	{
-		ETA_Speech_Say(va("%s is no longer close by", eta_choose.target.name));
-		return qfalse;
+		return ETA_CHOOSE_FOUND;
 	}
 
-	return qtrue;
+	if (ETA_ChooseWhere(&eta_choose.target, point))
+	{
+		etaAimTarget_t there = eta_choose.target;
+
+		VectorCopy(point, there.point);
+		there.meters = Distance(cg.predictedPlayerState.origin, point) * ETA_QU_TO_METERS;
+		ETA_AimStartSnap(&there, va("%s, out of sight from here", there.name));
+		eta_choose.held = qtrue;
+		eta_choose.at   = cg.time;
+		return ETA_CHOOSE_DONE;
+	}
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(va("%s is no longer close by. K chooses again", eta_choose.target.name));
+	return ETA_CHOOSE_DONE;
 }
 
