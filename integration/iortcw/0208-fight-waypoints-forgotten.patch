@@ -8342,6 +8342,44 @@ static void ETA_OrderReset(qboolean say)
  * tester, back from dying, took the puzzle to be lost. Forgotten, without
  * a word, and each learnt again as it is seen.
  */
+/* The waypoints kept by themselves where a fight began: a game loaded,
+   those fights are undone. The tester, back from dying, still had them
+   on K for fights that had not happened. The player's own, and the
+   waypoint on top, stay: the places are there still. */
+static void ETA_WaypointsForgetFights(void)
+{
+	vec3_t at[ETA_MAX_WAYPOINTS];
+	char   names[ETA_MAX_WAYPOINTS][48];
+	int    kept = 0, i, first;
+
+	first = eta_waypointCount < ETA_MAX_WAYPOINTS ? 0 : eta_waypointNext;
+	for (i = 0; i < eta_waypointCount; i++)
+	{
+		int k = (first + i) % ETA_MAX_WAYPOINTS;
+
+		if (!Q_stricmp(eta_waypointNames[k], "where the fight began"))
+		{
+			continue;
+		}
+		VectorCopy(eta_waypoints[k], at[kept]);
+		Q_strncpyz(names[kept], eta_waypointNames[k], sizeof(names[0]));
+		kept++;
+	}
+	if (kept == eta_waypointCount)
+	{
+		return;
+	}
+	for (i = 0; i < kept; i++)
+	{
+		VectorCopy(at[i], eta_waypoints[i]);
+		Q_strncpyz(eta_waypointNames[i], names[i], sizeof(eta_waypointNames[0]));
+	}
+	eta_waypointCount    = kept;
+	eta_waypointNext     = kept % ETA_MAX_WAYPOINTS;
+	eta_destination      = -1;
+	eta_trail.waypointAt = 0;
+}
