+/*
+ * What an area is like, as the level gives no names to its places: the
+ * tester asked where they were, beyond an area's number and coordinates.
+ * How big - by the floor the bots' file has to stand on - and how high up
+ * in the level the player is, between the lowest floor of all the areas
+ * and the highest. "a large room, high up in the level". Empty when not
+ * known.
+ */
+static void ETA_AreaLike(int area, char *out, size_t size)
+{
+	float        low = 0.0f, high = 0.0f;
+	qboolean     any = qfalse;
+	vec3_t       mins, maxs;
+	float        floor = ETA_BspAreas_Floor(area) / ( 39.37f * 39.37f ), rise;
+	const char  *big, *where;
+	int          i;
+
+	out[0] = '\0';
+	if (floor <= 0.0f || !ETA_BspAreas_Bounds(area, mins, maxs))
+	{
+		return;
+	}
+	for (i = 0; i < eta_areas.count; i++)
+	{
+		vec3_t a, b;
+
+		if (ETA_BspAreas_Floor(i) > 0.0f && ETA_BspAreas_Bounds(i, a, b))
+		{
+			low  = !any || a[2] < low ? a[2] : low;
+			high = !any || a[2] > high ? a[2] : high;
+			any  = qtrue;
+		}
+	}
+	big = floor < 25.0f ? "a small room" : floor < 100.0f ? "a room" : floor < 300.0f ? "a large room"
+	      : "a very large space";
+	/* Where the player stands, not the area's lowest floor: a courtyard
+	   runs from its cellar doors up to its walls. */
+	rise  = high - low > 128.0f ? ( cg.predictedPlayerState.origin[2] - 24.0f - low ) / ( high - low ) : 0.5f;
+	where = high - low <= 128.0f ? "" : rise < 0.34f ? ", low down in the level"
+	        : rise < 0.67f ? ", halfway up the level" : ", high up in the level";
+	Com_sprintf(out, size, "%s%s", big, where);
+}
+
