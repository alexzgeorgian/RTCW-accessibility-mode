-	Com_sprintf(out, size, "In area %d, of %d explored. %s", eta_areas.number[area], eta_areas.numbered, doors);
+	ETA_AreaLike(area, like, sizeof(like));
+	Com_sprintf(out, size, "In area %d%s%s, of %d explored. %s", eta_areas.number[area], like[0] ? ", " : "", like,
