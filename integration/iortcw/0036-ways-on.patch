+qboolean CG_AccessibilityExitPoint(const vec3_t from, vec3_t out)
+{
+	vec3_t point;
+	float  bestDistance = 0.0f;
+	int    i, found = 0;
+
+	ETA_WorldRead();
+	for (i = 0; i < eta_exitCount; i++)
+	{
+		if (ETA_ExitPoint(eta_exitModels[i], point) && (!found || Distance(from, point) < bestDistance))
+		{
+			found        = 1;
+			bestDistance = Distance(from, point);
+			VectorCopy(point, out);
+		}
+	}
+	return (qboolean)found;
+}
+
+float CG_AccessibilityWayOutFar(const vec3_t from, const vec3_t exitPoint)
+{
+	return ETA_WayOutFar(from, exitPoint);
