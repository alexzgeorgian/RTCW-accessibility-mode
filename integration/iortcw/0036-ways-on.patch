+/* The trail's points, newest first: the time of point 'index', or -1
+   past the oldest. */
+int CG_AccessibilityTrailPoint(int index, vec3_t out)
+{
+	int k;
+
+	if (index < 0 || index >= eta_trail.count)
+	{
+		return -1;
+	}
+	k = (eta_trail.head + ETA_TRAIL_MAX - 1 - index) % ETA_TRAIL_MAX;
+	VectorCopy(eta_trail.at[k], out);
+	return eta_trail.time[k];
+}
