@@ -2551,6 +2551,28 @@ static int ETA_LadderPlaces(int n)
 		}
 		high = (int)(( top[2] - foot[2] ) * ETA_QU_TO_METERS + 0.5f);
 		VectorCopy(foot, eta_backOutAt[n]);
+		/* A couple of steps out in front of it, not its foot: the way led
+		   to the foot of the forest's watchtower's ladder ended under the
+		   tower, behind the ladder - the last stretch to the foot was
+		   taken as clear through it - and the tester had to search for it.
+		   Out in front, the way goes round. As far as is clear. */
+		{
+			vec3_t  lmins, lmaxs, out, pmins = { -15.0f, -15.0f, -8.0f }, pmaxs = { 15.0f, 15.0f, 32.0f };
+			int     thin;
+			trace_t tr;
+
+			if (CG_AccessibilityMapLadder(l, lmins, lmaxs))
+			{
+				thin = ( lmaxs[0] - lmins[0] ) < ( lmaxs[1] - lmins[1] ) ? 0 : 1;
+				VectorCopy(foot, out);
+				out[thin] += ( foot[thin] > ( lmins[thin] + lmaxs[thin] ) * 0.5f ? 1.0f : -1.0f ) * 72.0f;
+				CG_Trace(&tr, foot, pmins, pmaxs, out, cg.snap->ps.clientNum, MASK_PLAYERSOLID);
+				if (!tr.startsolid)
+				{
+					VectorCopy(tr.endpos, eta_backOutAt[n]);
+				}
+			}
+		}
 		Com_sprintf(eta_backOutWhat[n], sizeof(eta_backOutWhat[n]), "the ladder up, %d meters high%s", high,
 		            soldier ? ", soldier up top" : "");
 		eta_backOutCount[n] = -1;
diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
