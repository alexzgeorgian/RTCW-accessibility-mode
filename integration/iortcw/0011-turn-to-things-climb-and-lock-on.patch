+/* Where the use key's line ends now: along the view, as far as the point. */
+static void ETA_UseLineEnd(const vec3_t eye, const vec3_t point, vec3_t end)
+{
+	vec3_t forward;
+
+	AngleVectors(cg.predictedPlayerState.viewangles, forward, NULL, NULL);
+	VectorMA(eye, Distance(eye, point), forward, end);
+}
