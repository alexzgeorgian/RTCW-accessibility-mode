 }
 
+/**
+ * @brief Aiming with a key: at the nearest thing to use, and at an enemy.
+ *
+ * A tester asked for both - a quick way to turn to the thing in front of
+ * them they can use, and a lock that keeps the sights on an enemy - after
+ * a match in which they barely brought one enemy down. The view is turned
+ * the only way this module can turn it: by holding the engine's own turn
+ * and look keys, fast while far off and at the ordinary speed for the
+ * last few degrees, and letting go on the target - the tap turn's way.
+ *
+ *   - The use key, F: see CG_AccessibilityActivateDown_f. It once had a
+ *     key of its own beside it, DEL, for turning to things further off;
+ *     the tester asked for one key, and F now does both.
+ *   - "Lock on to an enemy", held: the nearest enemy in sight is said and
+ *     followed for as long as the key is down. Lose them and the next one
+ *     in sight is taken; when there is none, "Lock lost". In Enemy
+ *     Territory it ran only in a game the player hosted, being aim
+ *     assistance against other people; the campaign has only the game's
+ *     own soldiers to fight, so here it always may.
+ *   - The lock by itself (eta_autoLock): the tester found holding a key
+ *     too slow - by the time it was down the enemy had the first shot. So
+ *     an enemy coming into sight within ETA_AIM_AUTO_METERS is locked on
+ *     to without a key, silently - the callout has already said where
+ *     they are, and the crosshair tick says the sights are on them. A turn
+ *     key, a snap or a cutscene stand it down, and a turn by hand keeps
+ *     it off for ETA_AIM_MANUAL_MS.
+ *   - Things to use are turned to only when F is pressed. They were once
+ *     turned to by themselves, on stopping beside one; in matches that
+ *     swung the view away from where the tester was looking, and they
+ *     asked for it gone - F is enough.
+ *
+ * Pitch moves too: the keys look up and down as well as turn. The two
+ * key numbers for looking are the turn keys' neighbours, so the player's
+ * own arrow keys on the same buttons are never let go by this.
+ */
+#define ETA_AIM_KEY_UP      "996"
+#define ETA_AIM_KEY_DOWN    "995"
+#define ETA_AIM_SNAP_MS     1500
+#define ETA_AIM_CYCLE_MS    4000
+#define ETA_AIM_LOST_MS     400
+#define ETA_AIM_MAX_TARGETS 16
+#define ETA_AIM_MANUAL_MS   2000
+#define ETA_AIM_AUTO_METERS 40.0f
+#define ETA_USE_KEY         "994"
+#define ETA_USE_REACH_METERS 2.5f
+/* The game's use reaches CH_ACTIVATE_DIST from the eyes, and a thing on
+   the floor is far below them: a weapon two and a half metres off along
+   the ground is out of its reach, and F pressed at it did nothing. So a
+   thing on the ground is in reach by the eyes, a little inside the
+   game's own reach. */
+#define ETA_USE_EYE_REACH    88.0f
+
+typedef enum
+{
+	ETA_AIM_NONE,
+	ETA_AIM_SNAP,
+	ETA_AIM_LOCK,
+	ETA_AIM_FOLLOW   /* kept on a chosen thing while the player walks to it */
+} eta_aimMode_t;
+
+typedef struct
+{
+	eta_aimMode_t mode;
+	int           entityNum;    /* -1: none yet, or a fixed point */
+	vec3_t        point;
+	int           started;
+	int           yaw;          /* the turn key held: -1 left, 1 right */
+	int           pitch;        /* the look key held: -1 up, 1 down */
+	int           lostSince;
+	qboolean      saidLost;
+	int           cycleIndex;
+	int           cycleAt;
+	qboolean      automatic;    /* the lock or the snap took this by itself */
+	int           manualUntil;  /* no lock by itself before this */
+	int           nextSearch;
+	float         lift;         /* raised this much over the point, to clear what lies in the way */
+	vec3_t        itemAim;      /* where on a thing on the ground, from its origin */
+	int           itemTry;      /* the last of ETA_UseItemAims tried, -1 none */
+	etaAimTarget_t follow;      /* the chosen thing being walked to */
+	qboolean      saidReach;
+	int           refreshAt;
+} eta_aim_t;
+
+static eta_aim_t eta_aim;
+
+/* The use key, pressed on the player's behalf. */
+static struct
+{
+	qboolean pressed;   /* +activate is down under ETA_USE_KEY */
+	qboolean pending;   /* use it on arriving */
+	qboolean held;      /* the player's key is still down */
+	int      releaseAt;
+} eta_use;
+
+static void ETA_UseKey(qboolean down)
+{
+	if (down == eta_use.pressed)
+	{
+		return;
+	}
+
+	trap_SendConsoleCommand(va("%sactivate %s\n", down ? "+" : "-", ETA_USE_KEY));
+	eta_use.pressed   = down;
+	eta_use.releaseAt = 0;
+}
+
+static void ETA_AimKeys(int yaw, int pitch)
+{
+	if (yaw != eta_aim.yaw)
+	{
+		if (eta_aim.yaw)
+		{
+			ETA_TurnKey(eta_aim.yaw, qfalse);
+		}
+		if (yaw)
+		{
+			ETA_TurnKey(yaw, qtrue);
+		}
+		eta_aim.yaw = yaw;
+	}
+
+	if (pitch != eta_aim.pitch)
+	{
+		if (eta_aim.pitch)
+		{
+			trap_SendConsoleCommand(va("-%s %s\n", eta_aim.pitch < 0 ? "lookup" : "lookdown",
+			                           eta_aim.pitch < 0 ? ETA_AIM_KEY_UP : ETA_AIM_KEY_DOWN));
+		}
+		if (pitch)
+		{
+			trap_SendConsoleCommand(va("+%s %s\n", pitch < 0 ? "lookup" : "lookdown",
+			                           pitch < 0 ? ETA_AIM_KEY_UP : ETA_AIM_KEY_DOWN));
+		}
+		eta_aim.pitch = pitch;
+	}
+}
+
+static void ETA_AimStop(void)
+{
+	ETA_AimKeys(0, 0);
+	ETA_TurnBoost(qfalse);
+	eta_aim.mode      = ETA_AIM_NONE;
+	eta_aim.automatic = qfalse;
+	eta_use.pending   = qfalse;
+}
+
+/**
+ * @brief One frame of steering toward a point. qtrue once on it.
+ *
+ * Turning right lowers the yaw and looking down raises the pitch - the
+ * engine's own sense, in CL_AdjustAngles - so a target at a higher yaw
+ * is to the left, and one at a higher pitch is below.
+ */
+static qboolean ETA_AimSteerAngles(const vec3_t wanted, float tolerance)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	float               yawError, pitchError, worst, perFrame, deadzone;
+	int                 yaw = 0, pitch = 0;
+
+	yawError   = AngleSubtract(wanted[YAW], ps->viewangles[YAW]);
+	pitchError = AngleSubtract(wanted[PITCH], ps->viewangles[PITCH]);
+	worst      = MAX(fabs(yawError), fabs(pitchError));
+
+	ETA_TurnBoost((qboolean)(worst > ETA_TURN_SLOW_DEGREES));
+
+	/* Let go within half a frame's turn of the point, as the tap does. */
+	perFrame = 0.14f * (float)cg.frametime * (eta_turn.fast ? ETA_TURN_FAST_FACTOR : 1.0f);
+	deadzone = MAX(tolerance, perFrame * 0.5f);
+
+	if (fabs(yawError) > deadzone)
+	{
+		yaw = yawError > 0.0f ? -1 : 1;
+	}
+	if (fabs(pitchError) > deadzone)
+	{
+		pitch = pitchError > 0.0f ? 1 : -1;
+	}
+
+	ETA_AimKeys(yaw, pitch);
+
+	return (qboolean)(!yaw && !pitch);
+}
+
+static qboolean ETA_AimSteer(const vec3_t point, float tolerance)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              eye, delta, wanted;
+
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+	VectorSubtract(point, eye, delta);
+	vectoangles(delta, wanted);
+
+	return ETA_AimSteerAngles(wanted, tolerance);
+}
+
+/**
+ * @brief Climbing a ladder with the use key.
+ *
+ * A ladder in ET is climbed with the view and the walk keys together:
+ * facing it and walking forward climbs it while the view is level or
+ * up, and climbs down while the view is well down; walking backward
+ * reverses either (PM_LadderMove). Getting on from the top means
+ * walking off the edge toward the ladder and catching it on the way
+ * down - the game grabs a ladder within 48 units ahead of a falling
+ * player. None of that can be done by ear without a lot of falling.
+ *
+ * So the use key does it, with keys pressed for the player as the
+ * turning does, and the game's own movement doing the climbing:
+ *
+ *   - up: face the ladder, view a little up, walk forward; off the top,
+ *     a few more steps onto the ledge;
+ *   - down, ladder on the far side of the hole: face it, look well
+ *     down, walk forward off the edge onto it, and on down;
+ *   - down, ladder on the wall under the player's own edge: face that
+ *     wall, view level, walk backward off the edge onto it, and on down.
+ *
+ * It stops at the top or the bottom, says so, and gives the keys back.
+ * The player turning by hand, the use key again, the map, death, or a
+ * climb that never got onto the ladder all stop it too - after five
+ * seconds, not three: a tester's walk from two metres off sometimes
+ * needed more.
+ */
+#define ETA_CLIMB_KEY_FORWARD "993"
+#define ETA_CLIMB_KEY_BACK    "992"
+#define ETA_CLIMB_GRAB_MS     5000
+#define ETA_CLIMB_LIMIT_MS    20000
+#define ETA_CLIMB_STEP_OFF_MS 400
+#define ETA_CLIMB_FACING      20.0f
+
+typedef struct
+{
+	qboolean active;
+	qboolean goesUp;
+	qboolean behind;
+	vec3_t   point;
+	vec3_t   normal;
+	int      started;
+	int      move;      /* the walk key held: 1 forward, -1 back */
+	qboolean latched;   /* has been on the ladder */
+	int      offSince;  /* off the top of it, since */
+	float    startZ;
+} eta_climb_t;
+
+static eta_climb_t eta_climb;
+
+qboolean CG_AccessibilityClimbing(void)
+{
+	return eta_climb.active;
+}
+
+static void ETA_ClimbMove(int move)
+{
+	if (move == eta_climb.move)
+	{
+		return;
+	}
+
+	if (eta_climb.move)
+	{
+		trap_SendConsoleCommand(va("-%s %s\n", eta_climb.move > 0 ? "forward" : "back",
+		                           eta_climb.move > 0 ? ETA_CLIMB_KEY_FORWARD : ETA_CLIMB_KEY_BACK));
+	}
+	if (move)
+	{
+		trap_SendConsoleCommand(va("+%s %s\n", move > 0 ? "forward" : "back",
+		                           move > 0 ? ETA_CLIMB_KEY_FORWARD : ETA_CLIMB_KEY_BACK));
+	}
+
+	eta_climb.move = move;
+}
+
+static void ETA_ClimbStop(const char *say)
+{
+	if (!eta_climb.active)
+	{
+		return;
+	}
+
+	ETA_ClimbMove(0);
+	ETA_AimKeys(0, 0);
+	ETA_TurnBoost(qfalse);
+	eta_climb.active = qfalse;
+
+	if (say)
+	{
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(say);
+		ETA_Speech_EndReport();
+	}
+}
+
+static void ETA_ClimbStart(const etaLadder_t *ladder)
+{
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+	ETA_AimStop();
+
+	memset(&eta_climb, 0, sizeof(eta_climb));
+	eta_climb.active  = qtrue;
+	eta_climb.goesUp  = ladder->goesUp;
+	eta_climb.behind  = ladder->behind;
+	eta_climb.started = cg.time;
+	eta_climb.startZ  = cg.predictedPlayerState.origin[2];
+	VectorCopy(ladder->point, eta_climb.point);
+	VectorCopy(ladder->normal, eta_climb.normal);
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(ladder->goesUp ? "Climbing up" : "Climbing down");
+	ETA_Speech_EndReport();
+}
+
+static void ETA_ClimbFrame(void)
+{
+	const playerState_t *ps       = &cg.predictedPlayerState;
+	qboolean            onLadder  = (qboolean)((ps->pm_flags & PMF_LADDER) != 0);
+	qboolean            onGround  = (qboolean)(ps->groundEntityNum != ENTITYNUM_NONE);
+	vec3_t              wanted, toLadder;
+	float               yawError;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		ETA_ClimbStop(NULL);
+		return;
+	}
+
+	if (cg.time < eta_climb.started || cg.time - eta_climb.started > ETA_CLIMB_LIMIT_MS)
+	{
+		ETA_ClimbStop("Climb stopped");
+		return;
+	}
+
+	if (onLadder)
+	{
+		eta_climb.latched = qtrue;
+	}
+
+	if (!eta_climb.latched && cg.time - eta_climb.started > ETA_CLIMB_GRAB_MS)
+	{
+		ETA_ClimbStop("Could not get onto the ladder");
+		return;
+	}
+
+	/* Arrived. */
+	if (eta_climb.latched)
+	{
+		if (eta_climb.goesUp)
+		{
+			if (!onLadder)
+			{
+				if (!eta_climb.offSince)
+				{
+					eta_climb.offSince = cg.time;
+				}
+
+				if (onGround && ps->origin[2] < eta_climb.startZ + 16.0f)
+				{
+					/* Back where it started: let go of the ladder, or
+					   never got up it. */
+					ETA_ClimbStop("Off the ladder");
+					return;
+				}
+
+				if (onGround && cg.time - eta_climb.offSince > ETA_CLIMB_STEP_OFF_MS)
+				{
+					ETA_ClimbStop("Top of the ladder");
+					return;
+				}
+			}
+			else
+			{
+				eta_climb.offSince = 0;
+			}
+		}
+		else if (onGround && ps->origin[2] < eta_climb.startZ - 32.0f)
+		{
+			ETA_ClimbStop("Bottom of the ladder");
+			return;
+		}
+	}
+
+	/* Facing: at the ladder's face once on it, or from behind its wall;
+	   on the way to a ladder ahead, at the spot where it was found. */
+	if (eta_climb.latched || eta_climb.behind)
+	{
+		VectorScale(eta_climb.normal, -1.0f, toLadder);
+	}
+	else
+	{
+		VectorSubtract(eta_climb.point, ps->origin, toLadder);
+	}
+	toLadder[2] = 0.0f;
+
+	wanted[YAW]  = vectoyaw(toLadder);
+	wanted[ROLL] = 0.0f;
+
+	if (eta_climb.goesUp)
+	{
+		wanted[PITCH] = -10.0f;     /* a little up: climbs */
+	}
+	else if (eta_climb.behind)
+	{
+		wanted[PITCH] = 0.0f;       /* level, walking backward: climbs down */
+	}
+	else
+	{
+		wanted[PITCH] = 70.0f;      /* well down, walking forward: climbs down */
+	}
+
+	ETA_AimSteerAngles(wanted, 2.0f);
+
+	/* Walk only once facing about the right way, so the first step is
+	   never off a ledge in some other direction. */
+	yawError = AngleSubtract(wanted[YAW], ps->viewangles[YAW]);
+
+	if (Q_fabs(yawError) < ETA_CLIMB_FACING || eta_climb.latched)
+	{
+		ETA_ClimbMove(eta_climb.behind ? -1 : 1);
+	}
+	else
+	{
+		ETA_ClimbMove(0);
+	}
+}
+
+static void ETA_AimSay(const char *what, const vec3_t point)
+{
+	int  meters = (int)(Distance(cg.predictedPlayerState.origin, point) * ETA_QU_TO_METERS + 0.5f);
+	char height[48];
+
+	/* Up or down as well as which way: a thing on the floor above is
+	   "ahead" too, and walking at it finds the wall below it. */
+	ETA_HudNarrator_HeightText((point[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS,
+	                           height, sizeof(height));
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s, %s, %d meter%s%s%s", what,
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(point)),
+	                  meters < 1 ? 1 : meters, meters == 1 ? "" : "s",
+	                  height[0] ? ", " : "", height));
+	ETA_Speech_EndReport();
+}
+
+/* An enemy for the lock: the nearest in sight, within maxMeters when it
+   is above zero. qfalse when there is none. */
+static qboolean ETA_AimAcquire(float maxMeters)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+
+	if (CG_AccessibilityEnemyTargets(list, ETA_AIM_MAX_TARGETS) <= 0
+	    || (maxMeters > 0.0f && list[0].meters > maxMeters))
+	{
+		return qfalse;
+	}
+
+	eta_aim.entityNum = list[0].entityNum;
+	VectorCopy(list[0].point, eta_aim.point);
+	eta_aim.lostSince = 0;
+	eta_aim.saidLost  = qfalse;
+	return qtrue;
+}
+
+/* Turns to a thing to use and says what it is - or, with no label,
+   quietly, leaving the game's own use icon to name it. */
+static void ETA_AimStartSnap(const etaAimTarget_t *target, const char *label)
+{
+	/* A tap turn still running would fight this for the same keys. */
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+
+	ETA_AimStop();
+	eta_aim.mode      = ETA_AIM_SNAP;
+	eta_aim.entityNum = target->entityNum;
+	eta_aim.started   = cg.time;
+	eta_aim.lift      = 0.0f;
+	eta_aim.itemTry   = -1;
+	VectorSet(eta_aim.itemAim, 0.0f, 0.0f, 8.0f);
+	VectorCopy(target->point, eta_aim.point);
+
+	if (label)
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_AimSay(label, target->point);
+	}
+}
+
+/**
+ * @brief Choosing what F turns to, with the bracket keys.
+ *
+ * The tester could not get to the dynamite spot on Oasis's Old City
+ * wall: there were several things to use close together, and F took
+ * whichever was nearest, or whatever the crosshair was already on. So ]
+ * steps through the things to use from nearest to furthest, and [ back,
+ * each said - name, direction, distance, "2 of 4" - without turning the
+ * view. F then turns to the one chosen, and uses it in reach, whatever is
+ * under the crosshair.
+ *
+ * The choice stays until it is used. It was let go as soon as F turned
+ * to it, and the tester, turned to a gun out of reach, walked up to it,
+ * pressed F again - and was turned to whatever was nearest. Now it is
+ * kept while the player walks there, each F turning to it again, and let
+ * go once use is pressed on it, once it is no longer on the list, or
+ * half a minute after the last F or bracket. A ladder or stairs, which
+ * F climbs or walks rather than uses, and a thing that is never pressed
+ * at, are let go once turned to, as before.
+ */
+#define ETA_CHOOSE_HOLD_MS 30000
+
+static struct
+{
+	qboolean       held;
+	int            at;          /* when it was chosen */
+	etaAimTarget_t target;
+} eta_choose;
+
+/* Where a target is on the list now: by its entity, or for a ladder,
+   which has none, by where it stands. -1 when it is gone. */
+static int ETA_ChooseFind(const etaAimTarget_t *list, int count, const etaAimTarget_t *want)
+{
+	int i;
+
+	for (i = 0; i < count; i++)
+	{
+		if (want->entityNum >= 0 ? list[i].entityNum == want->entityNum
+		    : (list[i].entityNum < 0 && list[i].ladder == want->ladder
+		       && Distance(list[i].point, want->point) < 48.0f))
+		{
+			return i;
+		}
+	}
+
+	return -1;
+}
+
+static void ETA_ChooseStep(int step)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	int            count, index;
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	/* Choosing again lets go of the one being walked to. */
+	if (eta_aim.mode == ETA_AIM_FOLLOW)
+	{
+		ETA_AimStop();
+	}
+
+	count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+
+	if (count <= 0)
+	{
+		eta_choose.held = qfalse;
+		ETA_Speech_Say("Nothing to use close by");
+		return;
+	}
+
+	index = (eta_choose.held && cg.time >= eta_choose.at && cg.time - eta_choose.at < ETA_CHOOSE_HOLD_MS)
+	        ? ETA_ChooseFind(list, count, &eta_choose.target) : -1;
+
+	if (index < 0)
+	{
+		/* A fresh choice starts at the nearest, or from the far end
+		   going back. */
+		index = step > 0 ? 0 : count - 1;
+	}
+	else
+	{
+		index = (index + step + count) % count;
+	}
+
+	eta_choose.held   = qtrue;
+	eta_choose.at     = cg.time;
+	eta_choose.target = list[index];
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_AimSay(va("%s, %d of %d", list[index].name, index + 1, count), list[index].point);
+}
+
+void CG_AccessibilityUseNext_f(void)
+{
+	ETA_ChooseStep(1);
+}
+
+void CG_AccessibilityUsePrev_f(void)
+{
+	ETA_ChooseStep(-1);
+}
+
+/**
+ * @brief Turns to a flight of stairs: to its foot from further off, and
+ * standing at the foot, straight up or down the flight - so walking
+ * forward climbs it. Nothing is pressed: stairs are walked.
+ */
+#define ETA_STAIRS_AT_FOOT_METERS 1.5f
+
+static void ETA_StairsTurn(const etaAimTarget_t *target, const char *place)
+{
+	if (target->meters <= ETA_STAIRS_AT_FOOT_METERS)
+	{
+		etaAimTarget_t up = *target;
+
+		VectorCopy(target->along, up.point);
+		ETA_AimStartSnap(&up, NULL);
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(va("Facing %s the stairs. Walk forward",
+		                  target->along[2] > target->point[2] ? "up" : "down"));
+		return;
+	}
+
+	ETA_AimStartSnap(target, place ? va("%s, %s", target->name, place) : target->name);
+}
+
+/* The chosen one, if there still is one: F's answer before anything
+   else. qfalse when nothing is chosen, or it is gone. */
+static qboolean ETA_ChooseTake(const etaAimTarget_t *list, int count, int *index)
+{
+	if (!eta_choose.held || cg.time < eta_choose.at || cg.time - eta_choose.at >= ETA_CHOOSE_HOLD_MS)
+	{
+		eta_choose.held = qfalse;
+		return qfalse;
+	}
+
+	eta_choose.held = qfalse;
+	*index          = ETA_ChooseFind(list, count, &eta_choose.target);
+
+	if (*index < 0)
+	{
+		ETA_Speech_Say(va("%s is no longer close by", eta_choose.target.name));
+		return qfalse;
+	}
+
+	return qtrue;
+}
+
+/* Whether use, pressed now, reaches a thing on the list: a thing on the
+   ground by the eyes (ETA_USE_EYE_REACH), anything else as it was. */
+static qboolean ETA_UseInReach(const etaAimTarget_t *target)
+{
+	vec3_t eye;
+
+	if (target->entityNum >= 0 && target->entityNum < MAX_GENTITIES
+	    && cg_entities[target->entityNum].currentState.eType == ET_ITEM)
+	{
+		VectorCopy(cg.predictedPlayerState.origin, eye);
+		eye[2] += cg.predictedPlayerState.viewheight;
+		return (qboolean)(Distance(eye, target->point) <= ETA_USE_EYE_REACH);
+	}
+
+	return (qboolean)(target->meters <= ETA_USE_REACH_METERS);
+}
+
+/**
+ * @brief Kept facing the thing F turned to while walking to it.
+ *
+ * The tester chose a weapon a few metres off, F turned them to it, and
+ * walking there the view drifted off it: they arrived facing elsewhere,
+ * and could not pick it up. So F, on a thing out of reach, turns to it
+ * and stays on it - the view following it as the player walks, the way
+ * the enemy lock follows an enemy - and says once it is in reach, when F
+ * uses it. It lets go when F uses it, a turn key is pressed, another is
+ * chosen, or it is out of sight for a moment; a choice is kept all the
+ * while. At first only a thing chosen with the bracket keys was
+ * followed; the tester then found F by itself said nothing on reaching
+ * the nearest thing, so that is followed too.
+ */
+#define ETA_FOLLOW_REFRESH_MS 250
+#define ETA_FOLLOW_LOST_MS    1000
+
+static void ETA_AimStartFollow(const etaAimTarget_t *target, const char *label)
+{
+	ETA_AimStartSnap(target, label ? label : target->name);
+	eta_aim.mode      = ETA_AIM_FOLLOW;
+	eta_aim.follow    = *target;
+	eta_aim.saidReach = qfalse;
+	eta_aim.refreshAt = cg.time + ETA_FOLLOW_REFRESH_MS;
+	eta_aim.lostSince = 0;
+}
+
+/* Whether a thing on the ground being walked to has gone because the
+   player picked it up: gone from the snapshot, or hidden, while the
+   player stands where it lay. */
+static qboolean ETA_FollowPickedUp(const etaAimTarget_t *target)
+{
+	const centity_t *cent;
+
+	if (target->entityNum < 0 || target->entityNum >= MAX_GENTITIES)
+	{
+		return qfalse;
+	}
+
+	cent = &cg_entities[target->entityNum];
+
+	if (cent->currentValid && cent->currentState.eType == ET_ITEM && !(cent->currentState.eFlags & EF_NODRAW))
+	{
+		return qfalse;
+	}
+
+	return (qboolean)(Distance(cg.predictedPlayerState.origin, target->point) < 96.0f);
+}
+
+static void ETA_FollowFrame(void)
+{
+	etaAimTarget_t *target = &eta_aim.follow;
+
+	if (cg.time >= eta_aim.refreshAt || eta_aim.refreshAt - cg.time > ETA_FOLLOW_REFRESH_MS)
+	{
+		etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+		int            count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+		int            index = ETA_ChooseFind(list, count, target);
+
+		eta_aim.refreshAt = cg.time + ETA_FOLLOW_REFRESH_MS;
+
+		if (index < 0)
+		{
+			/* Walked onto and picked up - the game picks a thing up by
+			   itself as the player steps on it, and its pickup is said:
+			   nothing more to say, and nothing left to face. */
+			if (ETA_FollowPickedUp(target))
+			{
+				ETA_AimStop();
+				return;
+			}
+
+			if (!eta_aim.lostSince)
+			{
+				eta_aim.lostSince = cg.time;
+			}
+			if (cg.time - eta_aim.lostSince >= ETA_FOLLOW_LOST_MS || cg.time < eta_aim.lostSince)
+			{
+				ETA_AimStop();
+				ETA_HudNarrator_HoldPassive(cg.time);
+				ETA_Speech_Say(va("%s is out of sight. F turns to it again", target->name));
+				return;
+			}
+		}
+		else
+		{
+			eta_aim.lostSince = 0;
+			*target           = list[index];
+			VectorCopy(target->point, eta_aim.point);
+
+			/* Walked to, it stays chosen however long the walk. */
+			if (eta_choose.held && ETA_ChooseFind(target, 1, &eta_choose.target) == 0)
+			{
+				eta_choose.at = cg.time;
+			}
+
+			if (!eta_aim.saidReach && ETA_UseInReach(target))
+			{
+				eta_aim.saidReach = qtrue;
+				ETA_HudNarrator_HoldPassive(cg.time);
+				ETA_Speech_Say(va("%s, in reach, F to use", target->name));
+			}
+		}
+	}
+
+	ETA_AimSteer(eta_aim.point, 1.0f);
+}
+
+/**
+ * @brief The use key, and the one key for everything to use.
+ *
+ * The tester had two keys for one job - DEL to turn to things, F to use
+ * them - and asked for one. So F does all of it:
+ *
+ *   - something already under the crosshair that the game offers to use
+ *     (the use icon is showing) is used at once, as the plain key would;
+ *   - otherwise, the nearest thing to use is turned to and named, with its
+ *     direction and distance. Within reach, it is used on arrival - unless
+ *     it is a door that will not open for this player. Further off, the
+ *     walk is the player's;
+ *   - pressed again within a few seconds, with still nothing under the
+ *     crosshair, the next one along;
+ *   - with nothing close by at all, the key does what it always did.
+ */
+/* Whether the game's icon under the crosshair is something use does
+   something with. */
+static qboolean ETA_HintUsable(int hint)
+{
+	switch (hint)
+	{
+	case HINT_NONE:
+	case HINT_FORCENONE:
+	case HINT_PLAYER:
+	case HINT_NOACTIVATE:
+	case HINT_DOOR_LOCKED:
+	case HINT_DOOR_ROTATING_LOCKED:
+	case HINT_BREAKABLE:
+	case HINT_BREAKABLE_DYNAMITE:
+	case HINT_KNIFE:
+	case HINT_LADDER:
+	case HINT_WATER:
+	case HINT_CAUTION:
+	case HINT_DANGER:
+	case HINT_SECRET:
+	case HINT_NOEXIT:
+	case HINT_NOEXIT_FAR:
+	case HINT_PLYR_FRIEND:
+	case HINT_PLYR_NEUTRAL:
+	case HINT_PLYR_ENEMY:
+	case HINT_PLYR_UNKNOWN:
+	case HINT_BAD_USER:
+		return qfalse;
+	default:
+		return qtrue;
+	}
+}
+
+void CG_AccessibilityActivateDown_f(void)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	qboolean       hint;
+	int            count, index = 0;
+
+	if (eta_use.held)
+	{
+		return;
+	}
+
+	eta_use.held = qtrue;
+
+	/* The game's ladder icon is not something the use key does anything
+	   with, so it is not a hint here: the key climbs the ladder. Nor is
+	   the icon for anything else use does nothing with - a thing to shoot
+	   or to knife, water, a door locked to this player, a use already
+	   done: the tester, facing one, found F did nothing at all, not even
+	   turn to the thing beside it. F turns to the nearest thing instead. */
+	hint = (qboolean)(ETA_HintUsable(cg.cursorHintIcon)
+	                  && cg.cursorHintTime != 0 && cg.cursorHintFade > 0
+	                  && cg.time - cg.cursorHintTime < cg.cursorHintFade);
+
+	/* Pressed while climbing: stop. */
+	if (eta_climb.active)
+	{
+		ETA_ClimbStop("Climb stopped");
+		return;
+	}
+
+	/* Something chosen with the bracket keys comes before anything
+	   else - before what the crosshair is on, and before a ladder in
+	   reach. */
+	if (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL && eta_choose.held)
+	{
+		count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+
+		if (ETA_ChooseTake(list, count, &index))
+		{
+			/* Turned to and said; used on arrival when in reach - but a
+			   ladder is climbed with F once there, and a locked door is
+			   never pressed at. */
+			if (list[index].stairs)
+			{
+				ETA_StairsTurn(&list[index], NULL);
+			}
+			else
+			{
+				qboolean reach = ETA_UseInReach(&list[index]);
+
+				/* Out of reach: turned to, and kept facing it while the
+				   player walks there. */
+				if (!list[index].ladder && !list[index].locked && !reach)
+				{
+					ETA_AimStartFollow(&list[index], NULL);
+				}
+				else
+				{
+					ETA_AimStartSnap(&list[index], list[index].name);
+					eta_use.pending = (qboolean)(!list[index].ladder && !list[index].locked && reach);
+				}
+
+				/* Kept until it is used: walked up to, F turns to it
+				   again, not to whatever is nearest by then. */
+				if (!list[index].ladder && !list[index].locked)
+				{
+					eta_choose.held   = qtrue;
+					eta_choose.at     = cg.time;
+					eta_choose.target = list[index];
+				}
+			}
+			eta_aim.cycleIndex = index;
+			eta_aim.cycleAt    = cg.time;
+			return;
+		}
+	}
+
+	count = (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL && !hint)
+	        ? CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS) : 0;
+
+	/* A ladder within reach, nearer than anything else to use: climb it.
+	   The ladders on the list are the same ladders seen from further
+	   off, so it is weighed against the nearest thing that is not one. */
+	if (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL && !hint)
+	{
+		etaLadder_t ladder;
+		int         other;
+
+		for (other = 0; other < count && list[other].ladder; other++)
+		{
+		}
+
+		if (CG_AccessibilityLadderNear(&ladder) && (other >= count || ladder.meters < list[other].meters))
+		{
+			ETA_ClimbStart(&ladder);
+			return;
+		}
+	}
+
+	if (hint || count <= 0)
+	{
+		/* Used: what was walked to has done its job. */
+		if (eta_aim.mode == ETA_AIM_FOLLOW)
+		{
+			ETA_AimStop();
+		}
+		/* Nothing to turn to: said, never silence - the tester could not
+		   tell F finding nothing from F not working. Use is still
+		   pressed, as the plain key would. */
+		if (!hint && cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL)
+		{
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("Nothing to use within 15 meters");
+		}
+		ETA_UseKey(qtrue);
+		return;
+	}
+
+	/* Walked up to what F turned to: F uses it, rather than moving on
+	   to the next one along. */
+	if (eta_aim.mode == ETA_AIM_FOLLOW && ETA_UseInReach(&eta_aim.follow))
+	{
+		int j = ETA_ChooseFind(list, count, &eta_aim.follow);
+
+		if (j >= 0 && !list[j].ladder && !list[j].stairs)
+		{
+			ETA_AimStartSnap(&list[j], list[j].name);
+			eta_use.pending    = (qboolean)!list[j].locked;
+			eta_aim.cycleIndex = j;
+			eta_aim.cycleAt    = cg.time;
+			return;
+		}
+	}
+
+	/* Pressed again soon after: the next one along. */
+	if (eta_aim.cycleAt && cg.time >= eta_aim.cycleAt && cg.time - eta_aim.cycleAt < ETA_AIM_CYCLE_MS)
+	{
+		index = (eta_aim.cycleIndex + 1) % count;
+	}
+	else if (list[0].stairs)
+	{
+		/* Stairs underfoot do not stand in the way of something to use
+		   within reach: that is what F was pressed for. */
+		int j;
+
+		for (j = 1; j < count; j++)
+		{
+			if (!list[j].stairs && list[j].meters <= ETA_USE_REACH_METERS)
+			{
+				index = j;
+				break;
+			}
+		}
+	}
+
+	eta_aim.cycleIndex = index;
+	eta_aim.cycleAt    = cg.time;
+
+	/* Stairs: turned to their foot, and from there up or down them. */
+	if (list[index].stairs)
+	{
+		ETA_StairsTurn(&list[index], count > 1 ? va("%d of %d", index + 1, count) : NULL);
+		return;
+	}
+
+	/* A ladder is turned to and said, always: pressing use at it does
+	   nothing, and F climbs it once the player is there. */
+	if (list[index].ladder)
+	{
+		ETA_AimStartSnap(&list[index],
+		                 count > 1 ? va("%s, %d of %d", list[index].name, index + 1, count) : list[index].name);
+		return;
+	}
+
+	/* Within reach: turned to, said, and used on arrival. It was used
+	   quietly, leaving the game's own icon to name it - and a door that
+	   would not open said nothing at all, so the tester heard F pass the
+	   doors by. Now it is always said, and a door that will not open is
+	   not pressed at. */
+	if (ETA_UseInReach(&list[index]))
+	{
+		ETA_AimStartSnap(&list[index], list[index].name);
+		eta_use.pending = (qboolean)!list[index].locked;
+		return;
+	}
+
+	/* Further off: turned to, said, and kept facing while the player
+	   walks there, "in reach" said on arrival - but a door that will not
+	   open is only turned to. */
+	if (!list[index].locked)
+	{
+		ETA_AimStartFollow(&list[index],
+		                   count > 1 ? va("%s, %d of %d", list[index].name, index + 1, count) : NULL);
+		return;
+	}
+
+	ETA_AimStartSnap(&list[index],
+	                 count > 1 ? va("%s, %d of %d", list[index].name, index + 1, count) : list[index].name);
+}
+
+void CG_AccessibilityActivateUp_f(void)
+{
+	eta_use.held = qfalse;
+
+	/* Pressed for the player: let go with them, unless it is still to be
+	   pressed on arrival, which lets go by itself a moment later. */
+	if (eta_use.pressed && !eta_use.pending)
+	{
+		ETA_UseKey(qfalse);
+	}
+}
+
+void CG_AccessibilityAimLockDown_f(void)
+{
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	if (eta_aim.mode == ETA_AIM_LOCK)
+	{
+		/* Already on one by itself: the key makes it the player's. */
+		if (eta_aim.automatic)
+		{
+			eta_aim.automatic = qfalse;
+			ETA_AimSay("Locked, enemy", eta_aim.point);
+		}
+		return;
+	}
+
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+
+	ETA_AimStop();
+	eta_aim.mode    = ETA_AIM_LOCK;
+	eta_aim.started = cg.time;
+
+	if (ETA_AimAcquire(0.0f))
+	{
+		ETA_AimSay("Locked, enemy", eta_aim.point);
+	}
+	else
+	{
+		eta_aim.entityNum = -1;
+		eta_aim.saidLost  = qtrue;
+		ETA_Speech_Say("No enemy in sight");
+	}
+}
+
+void CG_AccessibilityAimLockUp_f(void)
+{
+	if (eta_aim.mode == ETA_AIM_LOCK && !eta_aim.automatic)
+	{
+		ETA_AimStop();
+	}
+}
+
+/**
+ * @brief The lock by itself: an enemy in sight, where the lock may run.
+ */
+static void ETA_AutoLock(void)
+{
+	if (!eta_autoLock.integer || cg.cameraMode || eta_turn.step || eta_turn.held)
+	{
+		return;
+	}
+
+	/* A turn by hand keeps it off a moment, so the player can look away. */
+	if (cg.time < eta_aim.manualUntil && eta_aim.manualUntil - cg.time <= ETA_AIM_MANUAL_MS)
+	{
+		return;
+	}
+
+	/* Ten looks a second is plenty, and spares the traces. */
+	if (cg.time < eta_aim.nextSearch && eta_aim.nextSearch - cg.time <= 100)
+	{
+		return;
+	}
+	eta_aim.nextSearch = cg.time + 100;
+
+	if (!ETA_AimAcquire(ETA_AIM_AUTO_METERS))
+	{
+		return;
+	}
+
+	eta_aim.mode      = ETA_AIM_LOCK;
+	eta_aim.automatic = qtrue;
+	eta_aim.started   = cg.time;
+}
+
+/**
+ * @brief Every frame: steers a running aim onto its target.
+ */
+/**
+ * @brief What lies on the ground across the use key's line, short of
+ * what the player was turned to: the entity, or -1 for nothing.
+ *
+ * The tester chose the mounted gun, and F picked up an enemy's weapon
+ * lying by it. The game's use takes the first thing its line from the
+ * eyes meets (Cmd_Activate_f), and a weapon or a pack on the ground is
+ * one - picked up, a weapon in place of the player's own. The cgame's
+ * own traces pass through them, so each is tested here by the box the
+ * game gives it (g_items.c), along the line the view is on now.
+ */
+#define ETA_USE_LIFT_MAX  24.0f   /* the most the aim is raised to clear one */
+#define ETA_USE_LIFT_STEP 8.0f
+
+/* Where on a thing on the ground F may aim, from its origin, inside the
+   box the game gives it (ITEM_RADIUS round, twice that high): low, high,
+   and to each side, then the corners. */
+#define ETA_USE_ITEM_AIMS 10
+static const vec3_t eta_useItemAims[ETA_USE_ITEM_AIMS] =
+{
+	{ 0, 0, 4 }, { 0, 0, 16 }, { 6, 0, 8 }, { -6, 0, 8 }, { 0, 6, 8 }, { 0, -6, 8 },
+	{ 6, 6, 4 }, { -6, -6, 4 }, { 6, -6, 4 }, { -6, 6, 4 }
+};
+
+static int ETA_UseLineBlocked(const vec3_t eye, const vec3_t end, int target)
+{
+	vec3_t dir;
+	float  length = Distance(eye, end);
+	int    i, a;
+
+	if (!cg.snap || length < 1.0f)
+	{
+		return -1;
+	}
+	VectorSubtract(end, eye, dir);
+	VectorScale(dir, 1.0f / length, dir);
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		const vec_t         *at = cg_entities[es->number].lerpOrigin;
+		float               enter = 0.0f, leave = length;
+		qboolean            hit = qtrue;
+
+		if (es->eType != ET_ITEM || es->number == target || (es->eFlags & EF_NODRAW))
+		{
+			continue;
+		}
+
+		/* Both of the game's item boxes in one: from a radius below the
+		   origin to two above. */
+		for (a = 0; a < 3 && hit; a++)
+		{
+			float lo = at[a] - ITEM_RADIUS, hi = at[a] + (a == 2 ? 2.0f * ITEM_RADIUS : ITEM_RADIUS);
+
+			if (fabs(dir[a]) < 0.0001f)
+			{
+				hit = (qboolean)(eye[a] >= lo && eye[a] <= hi);
+			}
+			else
+			{
+				float t0 = (lo - eye[a]) / dir[a], t1 = (hi - eye[a]) / dir[a];
+
+				if (t0 > t1)
+				{
+					float swap = t0;
+
+					t0 = t1;
+					t1 = swap;
+				}
+				enter = MAX(enter, t0);
+				leave = MIN(leave, t1);
+				hit   = (qboolean)(enter <= leave);
+			}
+		}
+
+		/* Met before the point itself, by more than a hand's width. */
+		if (hit && enter < length - 4.0f)
+		{
+			return es->number;
+		}
+	}
+
+	return -1;
+}
