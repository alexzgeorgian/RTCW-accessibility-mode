+void CG_AccessibilityAimFrame(void)
+{
+	/* A climb has the keys to itself. */
+	if (eta_climb.active)
+	{
+		ETA_ClimbFrame();
+		return;
+	}
+
+	/* A use pressed on arrival lets go a moment later, if the player's
+	   own key already has. */
+	if (eta_use.pressed && !eta_use.held && eta_use.releaseAt
+	    && (cg.time >= eta_use.releaseAt || eta_use.releaseAt - cg.time > 1000))
+	{
+		ETA_UseKey(qfalse);
+	}
+
+	if (eta_aim.mode == ETA_AIM_NONE)
+	{
+		if (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL)
+		{
+			ETA_AutoLock();
+		}
+		if (eta_aim.mode == ETA_AIM_NONE)
+		{
+			return;
+		}
+	}
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL || cg.time < eta_aim.started
+	    || cg.cameraMode)
+	{
+		ETA_AimStop();
+		return;
+	}
+
+	/* A lock taken by itself stands down for the map and for a build. */
+	if (eta_aim.automatic && !eta_autoLock.integer)
+	{
+		ETA_AimStop();
+		return;
+	}
+
+	if (eta_aim.mode == ETA_AIM_FOLLOW)
+	{
+		ETA_FollowFrame();
+		return;
+	}
+
+	if (eta_aim.mode == ETA_AIM_SNAP)
+	{
+		qboolean item = (qboolean)(eta_aim.entityNum >= 0 && eta_aim.entityNum < MAX_GENTITIES
+		                           && cg_entities[eta_aim.entityNum].currentValid
+		                           && cg_entities[eta_aim.entityNum].currentState.eType == ET_ITEM);
+
+		/* Something on the ground can move - knocked, or dropped; follow it. */
+		if (item)
+		{
+			VectorAdd(cg_entities[eta_aim.entityNum].lerpOrigin, eta_aim.itemAim, eta_aim.point);
+		}
+
+		if (ETA_AimSteer(eta_aim.point, 2.0f) || cg.time - eta_aim.started > ETA_AIM_SNAP_MS)
+		{
+			qboolean use  = eta_use.pending;
+			int      body = eta_aim.entityNum;
+
+			/* Something on the ground across the line would be what is
+			   used: aim a little higher over it, and failing that, say
+			   so rather than pick it up. */
+			if (use)
+			{
+				vec3_t eye, end;
+				int    blocker;
+
+				VectorCopy(cg.predictedPlayerState.origin, eye);
+				eye[2] += cg.predictedPlayerState.viewheight;
+				ETA_UseLineEnd(eye, eta_aim.point, end);
+				blocker = ETA_UseLineBlocked(eye, end, body);
+
+				/* A thing on the ground beside another: aimed at a part of
+				   it nothing else covers. Aiming over the other, as for
+				   anything else, passes over a weapon on the floor too. */
+				if (blocker >= 0 && item)
+				{
+					int k;
+
+					for (k = eta_aim.itemTry + 1; k < ETA_USE_ITEM_AIMS; k++)
+					{
+						vec3_t at;
+
+						VectorAdd(cg_entities[body].lerpOrigin, eta_useItemAims[k], at);
+						if (ETA_UseLineBlocked(eye, at, body) < 0)
+						{
+							VectorCopy(eta_useItemAims[k], eta_aim.itemAim);
+							VectorCopy(at, eta_aim.point);
+							eta_aim.itemTry = k;
+							eta_aim.started = cg.time;
+							return;
+						}
+					}
+				}
+				else if (blocker >= 0)
+				{
+					float lift;
+
+					for (lift = eta_aim.lift + ETA_USE_LIFT_STEP; lift <= ETA_USE_LIFT_MAX; lift += ETA_USE_LIFT_STEP)
+					{
+						vec3_t higher;
+
+						VectorCopy(eta_aim.point, higher);
+						higher[2] += lift - eta_aim.lift;
+						if (ETA_UseLineBlocked(eye, higher, body) < 0)
+						{
+							VectorCopy(higher, eta_aim.point);
+							eta_aim.lift    = lift;
+							eta_aim.started = cg.time;
+							return;
+						}
+					}
+				}
+
+				if (blocker >= 0)
+				{
+					{
+						char name[64];
+
+						if (!CG_AccessibilityObjectName(&cg_entities[blocker].currentState, name, sizeof(name)))
+						{
+							Q_strncpyz(name, "something", sizeof(name));
+						}
+						ETA_AimStop();
+						ETA_HudNarrator_HoldPassive(cg.time);
+						ETA_Speech_Say(va("Not used: %s on the ground is in the way, and would be picked up. "
+						                  "Step to one side, then F", name));
+					}
+					return;
+				}
+			}
+
+			ETA_AimStop();
+
+			/* Used: what was chosen has done its job. */
+			if (use && eta_choose.held && eta_choose.target.entityNum >= 0 && eta_choose.target.entityNum == body)
+			{
+				eta_choose.held = qfalse;
+			}
+
+			if (use)
+			{
+				ETA_UseKey(qtrue);
+				if (!eta_use.held)
+				{
+					eta_use.releaseAt = cg.time + 150;
+				}
+			}
+		}
+		return;
+	}
+
+	/* The lock, while held. */
+	if (eta_aim.entityNum >= 0 && CG_AccessibilityEnemyAimPoint(eta_aim.entityNum, eta_aim.point))
+	{
+		eta_aim.lostSince = 0;
+		ETA_AimSteer(eta_aim.point, 1.0f);
+		return;
+	}
+
+	/* Gone - down, behind a wall, out of view: hold still a moment, then
+	   take the next one in sight, or say it is over. */
+	ETA_AimKeys(0, 0);
+	ETA_TurnBoost(qfalse);
+
+	if (!eta_aim.lostSince)
+	{
+		eta_aim.lostSince = cg.time;
+	}
+
+	if (cg.time - eta_aim.lostSince < ETA_AIM_LOST_MS && eta_aim.entityNum >= 0)
+	{
+		return;
+	}
+
+	if (eta_aim.automatic)
+	{
+		/* By itself, it moves on or lets go without a word: the callouts
+		   already say who comes and goes. */
+		if (!ETA_AimAcquire(ETA_AIM_AUTO_METERS))
+		{
+			ETA_AimStop();
+		}
+		return;
+	}
+
+	if (ETA_AimAcquire(0.0f))
+	{
+		ETA_AimSay("Locked, enemy", eta_aim.point);
+		return;
+	}
+
+	eta_aim.entityNum = -1;
+
+	if (!eta_aim.saidLost)
+	{
+		eta_aim.saidLost = qtrue;
+		ETA_Speech_Say("Lock lost");
+	}
+}
