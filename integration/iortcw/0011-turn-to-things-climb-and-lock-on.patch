+/* Nearest first; the list is short. */
+static void ETA_AimInsert(etaAimTarget_t *list, int *count, int max, const etaAimTarget_t *add)
+{
+	int at, i;
+
+	/* Two halves of a door, a button and its trigger: one. */
+	for (i = 0; i < *count; i++)
+	{
+		if (!Q_stricmp(list[i].name, add->name) && Distance(list[i].point, add->point) < 128.0f)
+		{
+			return;
+		}
+	}
+
+	/* Full: the farthest goes, if this is nearer. */
+	if (*count >= max && max > 0)
+	{
+		if (add->meters >= list[*count - 1].meters)
+		{
+			return;
+		}
+		(*count)--;
+	}
+
+	for (at = *count; at > 0 && list[at - 1].meters > add->meters; at--)
+	{
+		list[at] = list[at - 1];
+	}
+
+	list[at] = *add;
+	(*count)++;
+}
+
+/* Where to aim at a character: the middle of the body as it stands or
+   crouches. */
+static void ETA_PlayerAimPoint(const centity_t *cent, vec3_t out)
+{
+	VectorCopy(cent->lerpOrigin, out);
+	out[2] += (cent->currentState.eFlags & EF_CROUCHING) ? 6.0f : 20.0f;
+}
+
+/**
+ * @brief Flights of stairs near the player, for the F list.
+ *
+ *
+ * The tester found the stairs to the Allied command post on Oasis, with
+ * the way's "Stairs up" callout, and could not get onto them: the map
+ * has nothing that says where stairs are, so they were not on the F list
+ * the way the ladders are, and turning to face straight up a flight by
+ * ear is guesswork. So stairs are looked for as the list is made: out
+ * from the player in sixteen directions, a few centimetres at a time,
+ * the floor followed for fourteen metres - and a run of sharp rises a step
+ * high, with flatter footing between them, is a flight. The stairs there
+ * are steps cut in the rock, not neat treads, so the footing need only
+ * be walkable. Sloping ground is not stairs: a dune rises as much, but
+ * evenly, never a step at a time. The same flight seen from several
+ * directions is one, taken along the direction it climbs most steeply -
+ * which is straight up it.
+ */
+#define ETA_STAIRS_STEP      8.0f    /* between the looks along each direction */
+#define ETA_STAIRS_LOOKS     72      /* about fourteen metres: a flight starting ten metres off, whole */
+#define ETA_STAIRS_RISER     6.0f    /* this much up or down in one look: a step */
+#define ETA_STAIRS_LEVEL     2.5f    /* this little: the footing between steps */
+#define ETA_STAIRS_TOO_HIGH  22.0f   /* higher, a ledge or a drop, not a stair */
+#define ETA_STAIRS_RISERS    3       /* this many steps make a flight */
+#define ETA_STAIRS_HEIGHT    48.0f   /* and this high in all */
+#define ETA_STAIRS_WALKABLE  0.7f    /* the game's MIN_WALK_NORMAL */
+#define ETA_STAIRS_SAME      96.0f   /* feet this close: the same flight */
+
+typedef struct
+{
+	vec3_t foot, top;
+	float  rise, slope;
+	int    direction;
+} etaFlight_t;
+
+static int ETA_StairsNear(const vec3_t origin, etaAimTarget_t *out, int max)
+{
+	static const vec3_t mins = { -8.0f, -8.0f, 0.0f };
+	static const vec3_t maxs = { 8.0f, 8.0f, 8.0f };
+	etaFlight_t         flights[16];
+	int                 count = 0, d, i, made = 0;
+
+	for (d = 0; d < 16; d++)
+	{
+		float  bearing = (float)d * 22.5f * (float)M_PI / 180.0f;
+		float  dx = sinf(bearing), dy = cosf(bearing);
+		float  z = origin[2] - 24.0f, rise = 0.0f, level = 0.0f;
+		int    s, risers = 0, footings = 0, sign = 0;
+		vec3_t prev, foot, top;
+
+		VectorSet(prev, origin[0], origin[1], z);
+		VectorCopy(prev, foot);
+		VectorCopy(prev, top);
+
+		for (s = 1; s <= ETA_STAIRS_LOOKS; s++)
+		{
+			trace_t trace;
+			vec3_t  start, end, here;
+			float   dz;
+			int     now;
+
+			VectorSet(start, origin[0] + dx * ETA_STAIRS_STEP * s, origin[1] + dy * ETA_STAIRS_STEP * s,
+			          z + ETA_STAIRS_TOO_HIGH + 2.0f);
+			VectorSet(end, start[0], start[1], z - ETA_STAIRS_TOO_HIGH - 2.0f);
+			trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+			if (trace.startsolid || trace.allsolid || trace.fraction >= 1.0f
+			    || trace.plane.normal[2] < ETA_STAIRS_WALKABLE)
+			{
+				break;   /* a wall, a drop, or ground too steep to stand on */
+			}
+
+			VectorCopy(trace.endpos, here);
+			dz  = here[2] - z;
+			now = dz > 0.0f ? 1 : -1;
+
+			if (fabsf(dz) >= ETA_STAIRS_RISER)
+			{
+				/* A step. One the other way ends the flight. */
+				if (risers && now != sign)
+				{
+					break;
+				}
+				if (!risers)
+				{
+					VectorCopy(prev, foot);
+					sign     = now;
+					rise     = 0.0f;
+					footings = 0;
+				}
+				rise += dz;
+				risers++;
+				level = 0.0f;
+				VectorCopy(here, top);
+			}
+			else if (risers)
+			{
+				/* Between steps: footing, or the slope of the rock. */
+				if (fabsf(dz) < ETA_STAIRS_LEVEL)
+				{
+					footings++;
+				}
+				if (dz * (float)sign < -ETA_STAIRS_LEVEL)
+				{
+					break;   /* going back the other way */
+				}
+				rise  += dz;
+				level += ETA_STAIRS_STEP;
+				if (level > 64.0f)
+				{
+					break;   /* the landing at the top */
+				}
+				VectorCopy(here, top);
+			}
+
+			VectorCopy(here, prev);
+			z = here[2];
+		}
+
+		if (risers >= ETA_STAIRS_RISERS && footings >= 2 && fabsf(rise) >= ETA_STAIRS_HEIGHT && count < 16)
+		{
+			etaFlight_t *f = &flights[count++];
+			float        run;
+
+			VectorCopy(foot, f->foot);
+			VectorCopy(top, f->top);
+			f->rise      = rise;
+			f->direction = d;
+			run          = sqrtf((top[0] - foot[0]) * (top[0] - foot[0]) + (top[1] - foot[1]) * (top[1] - foot[1]));
+			f->slope     = fabsf(rise) / (run > 1.0f ? run : 1.0f);
+		}
+	}
+
+	/* One flight seen from several directions: the steepest look is the
+	   one straight up it. */
+	for (i = 0; i < count && made < max; i++)
+	{
+		etaFlight_t    *f = &flights[i];
+		etaAimTarget_t *t;
+		int             j, best = i;
+		vec3_t          axis;
+
+		if (f->direction < 0)
+		{
+			continue;
+		}
+		for (j = i + 1; j < count; j++)
+		{
+			if (flights[j].direction >= 0 && (flights[j].rise > 0.0f) == (f->rise > 0.0f)
+			    && Distance(flights[j].foot, f->foot) < ETA_STAIRS_SAME)
+			{
+				if (flights[j].slope > flights[best].slope)
+				{
+					flights[best].direction = -1;
+					best                    = j;
+				}
+				else
+				{
+					flights[j].direction = -1;
+				}
+			}
+		}
+		if (best != i)
+		{
+			f->direction = -1;
+		}
+		f = &flights[best];
+		if (f->direction < 0)
+		{
+			continue;
+		}
+
+		t = &out[made++];
+		memset(t, 0, sizeof(*t));
+		t->entityNum = -1;
+		t->stairs    = qtrue;
+		VectorCopy(f->foot, t->point);
+		t->point[2] += 24.0f + 40.0f;   /* a standing player's eyes over the foot */
+		VectorSubtract(f->top, f->foot, axis);
+		axis[2] = 0.0f;
+		VectorNormalize(axis);
+		VectorMA(t->point, 256.0f, axis, t->along);
+		t->along[2] = t->point[2] + (f->rise > 0.0f ? 64.0f : -64.0f);
+		{
+			int meters = (int)(fabsf(f->rise) * ETA_QU_TO_METERS + 0.5f);
+
+			Q_strncpyz(t->name, va("Stairs %s, %d %s", f->rise > 0.0f ? "up" : "down",
+			                       meters < 1 ? 1 : meters, meters <= 1 ? "meter" : "meters"), sizeof(t->name));
+		}
+		t->meters = Distance(origin, t->point) * ETA_QU_TO_METERS;
+		f->direction = -1;
+	}
+
+	return made;
+}
+
+
+/**
+ * @brief The things close by the player could use, nearest first.
+ *
+ * Within fifteen metres and in sight: a door, a button, a switch the map
+ * hides in an invisible trigger (read from the map's entity list, by
+ * what it works - see ETA_ReadMapEntities), a mounted gun, something on
+ * the ground, and the map's ladders and flights of stairs.
+ */
+#define ETA_USE_RANGE 600.0f
+
+int CG_AccessibilityUseTargets(etaAimTarget_t *list, int max)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              eye;
+	int                 count = 0, i;
+
+	if (!cg.snap || max <= 0)
+	{
+		return 0;
+	}
+
+	ETA_AimEye(eye);
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es   = &cg.snap->entities[i];
+		const centity_t     *cent = &cg_entities[es->number];
+		etaAimTarget_t      target;
+
+		memset(&target, 0, sizeof(target));
+		target.entityNum = es->number;
+		VectorCopy(cent->lerpOrigin, target.point);
+
+		switch (es->eType)
+		{
+		case ET_MG42:
+			Q_strncpyz(target.name, "Mounted machine gun", sizeof(target.name));
+			break;
+		case ET_MOVER:
+			if (es->solid == SOLID_BMODEL && es->modelindex > 0 && es->modelindex < MAX_MODELS
+			    && eta_buttonModel[es->modelindex])
+			{
+				Q_strncpyz(target.name, "Button", sizeof(target.name));
+				break;
+			}
+			/* fall through: a door */
+		case ET_ITEM:
+			if (!CG_AccessibilityObjectName(es, target.name, sizeof(target.name))
+			    || (es->eType == ET_MOVER && Q_stricmp(target.name, "door")))
+			{
+				continue;
+			}
+			target.name[0] = (char)toupper((unsigned char)target.name[0]);
+			if (es->eType == ET_MOVER)
+			{
+				qboolean opens = qtrue;
+
+				target.locked = (qboolean)(CG_AccessibilityDoorModel(es->modelindex, &opens) && !opens);
+				if (target.locked)
+				{
+					Q_strncpyz(target.name, "Locked door", sizeof(target.name));
+				}
+			}
+			if (es->eType == ET_ITEM)
+			{
+				target.point[2] += 8.0f;
+			}
+			break;
+		default:
+			continue;
+		}
+
+		/* A brush - a door, a button - draws round its middle. A rotating
+		   door's brush is laid out round its origin. */
+		if (es->solid == SOLID_BMODEL && es->modelindex > 0 && es->modelindex < MAX_MODELS
+		    && es->eType != ET_ITEM)
+		{
+			VectorAdd(target.point, cgs.inlineModelMidpoints[es->modelindex], target.point);
+		}
+
+		if (Distance(ps->origin, target.point) > ETA_USE_RANGE
+		    || !ETA_SeesPoint(eye, target.point, es->number))
+		{
+			continue;
+		}
+
+		target.meters = Distance(ps->origin, target.point) * ETA_QU_TO_METERS;
+		ETA_AimInsert(list, &count, max, &target);
+	}
+
+	/* The switches and levers the map hides in an invisible trigger,
+	   which the server never sends: from the map's own list. Aimed a
+	   little short of the trigger's middle, where the thing it wraps is
+	   usually drawn. */
+	for (i = 0; i < eta_userCount; i++)
+	{
+		etaAimTarget_t target;
+		vec3_t         toward, seen;
+
+		memset(&target, 0, sizeof(target));
+		target.entityNum = -1;
+		VectorCopy(cgs.inlineModelMidpoints[eta_users[i].model], target.point);
+
+		if (Distance(ps->origin, target.point) > ETA_USE_RANGE)
+		{
+			continue;
+		}
+
+		VectorSubtract(eye, target.point, toward);
+		VectorNormalize(toward);
+		VectorMA(target.point, 12.0f, toward, seen);
+		if (!ETA_SeesPoint(eye, seen, -1))
+		{
+			continue;
+		}
+
+		Q_strncpyz(target.name, eta_users[i].name, sizeof(target.name));
+		target.meters = Distance(ps->origin, target.point) * ETA_QU_TO_METERS;
+		ETA_AimInsert(list, &count, max, &target);
+	}
+
+	/* The map's ladders: turned to like anything else to use, so a
+	   ladder heard humming can be found with F - and once there, F climbs
+	   it. Aimed at the middle of the ladder, level with the player, and
+	   only one in sight: turning to a ladder behind a wall would turn the
+	   player to the wall. */
+	for (i = 0; i < eta_mapLadderCount; i++)
+	{
+		const ETA_BspLadder *ladder = &eta_mapLadders[i];
+		etaAimTarget_t      target;
+		vec3_t              toward, seen;
+		qboolean            up, down;
+
+		memset(&target, 0, sizeof(target));
+		target.entityNum = -1;
+		target.ladder    = qtrue;
+		target.point[0]  = (ladder->mins[0] + ladder->maxs[0]) * 0.5f;
+		target.point[1]  = (ladder->mins[1] + ladder->maxs[1]) * 0.5f;
+		target.point[2]  = ps->origin[2] < ladder->mins[2] ? ladder->mins[2]
+		                   : ps->origin[2] > ladder->maxs[2] ? ladder->maxs[2] : ps->origin[2];
+
+		if (Distance(ps->origin, target.point) > ETA_USE_RANGE)
+		{
+			continue;
+		}
+
+		VectorSubtract(eye, target.point, toward);
+		VectorNormalize(toward);
+		VectorMA(target.point, 8.0f, toward, seen);
+		if (!ETA_SeesPoint(eye, seen, -1))
+		{
+			continue;
+		}
+
+		up   = (qboolean)(ladder->maxs[2] > ps->origin[2] + 32.0f);
+		down = (qboolean)(ladder->mins[2] < ps->origin[2] - 64.0f);
+		Q_strncpyz(target.name, up && !down ? "Ladder up" : down && !up ? "Ladder down" : "Ladder",
+		           sizeof(target.name));
+		target.meters = Distance(ps->origin, target.point) * ETA_QU_TO_METERS;
+
+		ETA_AimInsert(list, &count, max, &target);
+	}
+
+	/* And the flights of stairs close by, which the map does not list. */
+	{
+		etaAimTarget_t flights[4];
+		int            n = ETA_StairsNear(ps->origin, flights, 4);
+
+		for (i = 0; i < n; i++)
+		{
+			ETA_AimInsert(list, &count, max, &flights[i]);
+		}
+	}
+
+	return count;
+}
+
+/* Whether an enemy may be aimed at: the rules the callouts keep - in
+   clear sight, and in view unless close enough to hear. */
+static qboolean ETA_EnemyAimable(const centity_t *cent, const vec3_t eye, vec3_t aim)
+{
+	const entityState_t *es = &cent->currentState;
+	vec3_t              head;
+	float               meters, halfView;
+
+	if (es->eType != ET_PLAYER || (es->eFlags & EF_DEAD) || es->number == cg.snap->ps.clientNum
+	    || !ETA_SeenAsEnemy(es))
+	{
+		return qfalse;
+	}
+
+	ETA_PlayerAimPoint(cent, aim);
+	VectorCopy(cent->lerpOrigin, head);
+	head[2] += 36.0f;
+
+	if (!ETA_ClearLine(eye, aim) && !ETA_ClearLine(eye, head))
+	{
+		return qfalse;
+	}
+
+	meters   = Distance(cg.predictedPlayerState.origin, cent->lerpOrigin) * ETA_QU_TO_METERS;
+	halfView = cg.refdef.fov_x * 0.5f + 10.0f;
+
+	if (meters > 10.0f && fabs(CG_AccessibilityLeftOfView(cent->lerpOrigin)) > halfView)
+	{
+		return qfalse;
+	}
+
+	return qtrue;
+}
+
+int CG_AccessibilityEnemyTargets(etaAimTarget_t *list, int max)
+{
+	vec3_t eye;
+	int    count = 0, i;
+
+	if (!cg.snap || max <= 0)
+	{
+		return 0;
+	}
+
+	ETA_AimEye(eye);
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		etaAimTarget_t      target;
+
+		memset(&target, 0, sizeof(target));
+
+		if (!ETA_EnemyAimable(&cg_entities[es->number], eye, target.point))
+		{
+			continue;
+		}
+
+		target.entityNum = es->number;
+		target.meters    = Distance(cg.predictedPlayerState.origin, cg_entities[es->number].lerpOrigin)
+		                   * ETA_QU_TO_METERS;
+		/* Each its own entry, even with one name: two enemies are two. */
+		Q_strncpyz(target.name, va("Enemy %d", es->number), sizeof(target.name));
+		ETA_AimInsert(list, &count, max, &target);
+	}
+
+	return count;
+}
+
+qboolean CG_AccessibilityEnemyAimPoint(int entityNum, vec3_t out)
+{
+	vec3_t eye;
+	int    i;
+
+	if (!cg.snap || entityNum < 0 || entityNum >= MAX_GENTITIES)
+	{
+		return qfalse;
+	}
+
+	/* Still in this snapshot: an enemy the server stopped sending is one
+	   the player has no business tracking. */
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		if (cg.snap->entities[i].number == entityNum)
+		{
+			break;
+		}
+	}
+
+	if (i == cg.snap->numEntities)
+	{
+		return qfalse;
+	}
+
+	ETA_AimEye(eye);
+
+	return ETA_EnemyAimable(&cg_entities[entityNum], eye, out);
+}
+
 #endif
