+/* A switch or a button by what it works, as BROK the InvestiGator says
+   what each thing in a scene is for: "Button for a door behind left 8
+   meters" - so once it is pressed, the player knows where to go. */
+static void ETA_SwitchName(const char *kind, int model, char *out, size_t outSize)
+{
+	int    door = (model > 0 && model < MAX_MODELS) ? eta_opensDoor[model] : 0;
+	vec3_t at;
+	int    meters, i;
+
+	Q_strncpyz(out, kind, outSize);
+	if (door <= 0 || door >= MAX_MODELS)
+	{
+		return;
+	}
+
+	/* Where the door stands now: the mover the server sends for it, or
+	   the map's own place for it. */
+	VectorCopy(cgs.inlineModelMidpoints[door], at);
+	for (i = 0; cg.snap && i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+
+		if (es->eType == ET_MOVER && es->modelindex == door)
+		{
+			VectorAdd(cg_entities[es->number].lerpOrigin, cgs.inlineModelMidpoints[door], at);
+			break;
+		}
+	}
+
+	meters = (int)(Distance(cg.predictedPlayerState.origin, at) * ETA_QU_TO_METERS + 0.5f);
+	Q_strcat(out, outSize, va(" for a door %s %d %s",
+	                          ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at)),
+	                          meters < 1 ? 1 : meters, meters <= 1 ? "meter" : "meters"));
+}
