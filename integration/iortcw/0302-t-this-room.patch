diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 4161fbea..f53b1af2 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -4912,6 +4912,33 @@ static const char *ETA_UserName(int i)
 	if (( !Q_stricmp(eta_users[i].name, "Button") || !Q_stricmp(eta_users[i].name, "Switch") )
 	    && ( objective = CG_AccessibilityObjectiveOfEvent(eta_users[i].target) ) > 0)
 	{
+		/* Named by what the map calls what it sets off, when that is
+		   words: the rocket base's "abort_launch" is the "Abort launch
+		   button" - the tester found "Button, objective 2" no name. */
+		char words[48];
+		int  k, letters = 0;
+
+		Q_strncpyz(words, eta_users[i].target, sizeof(words));
+		for (k = 0; words[k]; k++)
+		{
+			if (words[k] == '_')
+			{
+				words[k] = ' ';
+			}
+			else if (isalpha((unsigned char)words[k]))
+			{
+				letters++;
+			}
+			else if (words[k] != ' ')
+			{
+				letters = -1000;   /* a number in it: "t517", "button2" */
+			}
+		}
+		if (letters >= 4 && strchr(words, ' ') && Q_stricmpn(words, "button", 6))
+		{
+			words[0] = (char)toupper((unsigned char)words[0]);
+			return va("%s button, objective %d", words, objective);
+		}
 		return va("Button, objective %d", objective);
 	}
 	return eta_users[i].name;
