@@ -879,6 +879,43 @@ static qboolean ETA_AreaLadderEnd(int entry, vec3_t at, vec3_t to)
 	return qtrue;
 }
 
+/* A door shut over a ladder - a hatch at its top, or at its foot: its
+   model, or 0. Below the tram's middle station a hatch closes the last
+   ladder down to the power, and a switch by the ladder above opens it;
+   X said "F climbs it" with the hatch shut. */
+static int ETA_AreaLadderHatch(int entry)
+{
+	vec3_t foot, top, mins, maxs;
+	int    model;
+
+	if (!CG_AccessibilityLadderEnds(ETA_AREA_LADDER_OF(entry), foot, top))
+	{
+		return 0;
+	}
+	for (model = 1; model < MAX_MODELS; model++)
+	{
+		qboolean opens;
+		int      k;
+
+		if (!CG_AccessibilityDoorBox(model, mins, maxs, &opens) || opens)
+		{
+			continue;
+		}
+		for (k = 0; k < 2; k++)
+		{
+			const float *end = k ? top : foot;
+
+			if (end[0] > mins[0] - 48.0f && end[0] < maxs[0] + 48.0f && end[1] > mins[1] - 48.0f
+			    && end[1] < maxs[1] + 48.0f && maxs[2] > MIN(foot[2], top[2]) - 8.0f
+			    && mins[2] < MAX(foot[2], top[2]) + 8.0f && fabsf(end[2] - ( mins[2] + maxs[2] ) * 0.5f) < 72.0f)
+			{
+				return model;
+			}
+		}
+	}
+	return 0;
+}
+
 /* Whether a ladder's end is in the area, or by the player when the
    areas do not reach it. */
 static qboolean ETA_AreaLadderHere(int area, const vec3_t at)
@@ -1192,6 +1229,37 @@ void CG_AccessibilityAreaExits(void)
 		meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
 		meters = meters < 1 ? 1 : meters;
 		ETA_HudNarrator_HeightText(delta[2] * ETA_QU_TO_METERS, height, sizeof(height));
+		{
+			int    hatch = ETA_AreaLadderHatch(entry);
+			vec3_t hmins, hmaxs, hmid, opener;
+			qboolean hopens;
+
+			if (hatch && CG_AccessibilityDoorBox(hatch, hmins, hmaxs, &hopens))
+			{
+				qboolean bySwitch;
+
+				VectorAdd(hmins, hmaxs, hmid);
+				VectorScale(hmid, 0.5f, hmid);
+				bySwitch = CG_AccessibilityDoorOpener(hatch, hmid, opener);
+				ETA_Speech_Say(va("%d of %d, ladder %s%s%s, %s, %d %s%s%s, a hatch shut over it%s. %s", eta_areas.listPos + 1,
+				                  eta_areas.listCount, ETA_AREA_LADDER_TOP(entry) ? "down" : "up", where[0] ? " " : "", where,
+				                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at)), meters,
+				                  meters == 1 ? "meter" : "meters", height[0] ? ", " : "", height,
+				                  bySwitch ? ": a switch opens it" : ", opened by what happens",
+				                  bySwitch ? "O leads to the switch, then F presses it" : "O leads there"));
+				ETA_Speech_EndReport();
+				if (bySwitch)
+				{
+					CG_AccessibilityChoose(opener, "the switch that opens the hatch");
+					CG_AccessibilityChosenIsThing();   /* F presses it there, not the ladder by it */
+				}
+				else
+				{
+					CG_AccessibilityChoose(at, ETA_AREA_LADDER_TOP(entry) ? "the ladder down" : "the ladder up");
+				}
+				return;
+			}
+		}
 		ETA_Speech_Say(va("%d of %d, ladder %s%s%s, %s, %d %s%s%s. %s", eta_areas.listPos + 1, eta_areas.listCount,
 		                  ETA_AREA_LADDER_TOP(entry) ? "down" : "up", where[0] ? " " : "", where,
 		                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(at)), meters,
@@ -1282,6 +1350,10 @@ void CG_AccessibilityAreaExits(void)
 		if (bySwitch || bySpot)
 		{
 			CG_AccessibilityChoose(opener, bySwitch ? "the switch that opens the door" : "the spot that unlocks the door");
+			if (bySwitch)
+			{
+				CG_AccessibilityChosenIsThing();
+			}
 			return;
 		}
 	}
