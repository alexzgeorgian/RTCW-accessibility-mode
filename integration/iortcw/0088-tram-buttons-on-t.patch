 }          eta_rides[ETA_MAX_RIDES];
 static int eta_rideCount;
 
+/* The corners of a tram's way, and the switches by them: its buttons, at
+   each station, which call it and send it on. */
+#define ETA_MAX_TRAM_CORNERS 64
+static vec3_t eta_tramCorners[ETA_MAX_TRAM_CORNERS];
+static int    eta_tramCornerCount;
+
+static qboolean ETA_ByTramWay(const vec3_t at)
+{
+	int i;
+
+	for (i = 0; i < eta_tramCornerCount; i++)
+	{
+		float dx = at[0] - eta_tramCorners[i][0], dy = at[1] - eta_tramCorners[i][1];
+
+		if (dx * dx + dy * dy < 256.0f * 256.0f && fabsf(at[2] - eta_tramCorners[i][2]) < 400.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
 /* A ride's box as it is now, and whether it is moving. qfalse when it is
