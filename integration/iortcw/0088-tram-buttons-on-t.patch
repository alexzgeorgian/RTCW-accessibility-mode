+			sscanf(origin, "%f %f %f", &eta_tramCorners[eta_tramCornerCount][0],
+			       &eta_tramCorners[eta_tramCornerCount][1], &eta_tramCorners[eta_tramCornerCount][2]);
+			eta_tramCornerCount++;
