+/* Walked on past the turn just said: said so, once, rather than "Way
+   goes back" - the tester, and the test player, went on, were sent back,
+   went past again the other way, and went round in circles. O turns the
+   player to the way from where they are. */
+static qboolean ETA_WayCuePast(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              forward, toCorner;
+	float               far;
+
+	if (!eta_wayCue.turnPending)
+	{
+		return qfalse;
+	}
+	if (cg.time - eta_wayCue.turnAt > 6000 || cg.time < eta_wayCue.turnAt)
+	{
+		eta_wayCue.turnPending = qfalse;
+		return qfalse;
+	}
+	VectorSubtract(eta_wayCue.turnCorner, ps->origin, toCorner);
+	toCorner[2] = 0.0f;
+	far         = VectorLength(toCorner);
+	AngleVectors(ps->viewangles, forward, NULL, NULL);
+	forward[2] = 0.0f;
+	VectorNormalize(forward);
+	/* Turned at the corner, as told: the corner is behind them too, but
+	   they face another way. Past it only going on the way they were. */
+	if (fabsf(AngleNormalize180(ps->viewangles[YAW] - eta_wayCue.turnHeading)) > 40.0f)
+	{
+		eta_wayCue.turnPending = qfalse;
+		return qfalse;
+	}
+	if (far < 88.0f || DotProduct(forward, toCorner) > 0.0f)
+	{
+		return qfalse;   /* not there yet */
+	}
+	eta_wayCue.turnPending = qfalse;
+	if (far > 320.0f)
+	{
+		return qfalse;   /* gone a long way on: the way has been found again */
+	}
+	eta_wayCue.saidAt   = cg.time;
+	eta_wayCue.saidSide = 2;
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(va("Past the turn, %d %s back. O turns you to the way",
+	                  (int)( far * ETA_QU_TO_METERS + 0.5f ) < 1 ? 1 : (int)( far * ETA_QU_TO_METERS + 0.5f ),
+	                  (int)( far * ETA_QU_TO_METERS + 0.5f ) <= 1 ? "meter" : "meters"));
+	return qtrue;
+}
