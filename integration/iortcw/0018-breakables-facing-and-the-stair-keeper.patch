+/**
+ * @brief The stair keeper: up and round a bending flight with W alone.
+ *
+ * A straight flight is walked like a ramp: W, and the game steps up each
+ * riser. A flight that bends - the stairs of a tower, a stair that turns
+ * at a landing - a sighted player follows with the mouse, turning as the
+ * steps turn. The tester, with only W, walked into the outer wall at
+ * every turn of it, and once off the open side.
+ *
+ * So, on stairs and with the walk key down, the way ahead is tried as the
+ * game would walk it - a stride at a time, up each riser and down onto
+ * the next - straight on and then a little either side. Straight on going
+ * on up (or down) the flight, nothing is done. Straight on into the wall,
+ * or off an edge, the view is turned the least way that keeps on the
+ * steps, and "Stairs bend left" said at the bend. Nothing either side -
+ * the top, the foot, a real wall - and it lets go.
+ *
+ * Only on stairs - the player rose or fell a step's worth or more in the
+ * last moment, walking - and never while the player turns, strafes, or
+ * anything else has the turn keys. eta_stairKeeper 0 turns it off.
+ */
+#define ETA_STAIRS_KEEP_STEP     16.0f   /* the probe's stride */
+#define ETA_STAIRS_KEEP_STEPUP   18.0f   /* the game's STEPSIZE: a riser stepped */
+#define ETA_STAIRS_KEEP_STRIDES  8       /* this many: about three metres */
+#define ETA_STAIRS_KEEP_CLEAR    56.0f   /* this far walked on, the way is open */
+#define ETA_STAIRS_KEEP_DROP     40.0f   /* lower than this in one stride: an edge */
+#define ETA_STAIRS_KEEP_WIDEST   110     /* degrees either side tried: past a square corner */
+#define ETA_STAIRS_KEEP_EVERY    100     /* ms between looks */
+#define ETA_STAIRS_KEEP_RISE     14.0f   /* this much up or down... */
+#define ETA_STAIRS_KEEP_OVER     700     /* ...over this long, walking: on stairs */
+#define ETA_STAIRS_KEEP_HOLD     1500    /* and still on them this long after */
+#define ETA_STAIRS_KEEP_SAMPLES  12
+#define ETA_STAIRS_KEEP_SAY_MS   2500    /* a bend said no oftener */
+#define ETA_STAIRS_KEEP_LANDING  600     /* this long with no step: off the steps */
+
+static struct
+{
+	vec3_t   at[ETA_STAIRS_KEEP_SAMPLES];  /* where the player was, every ETA_STAIRS_KEEP_EVERY */
+	int      atTime[ETA_STAIRS_KEEP_SAMPLES];
+	int      head;
+	int      sense;     /* 1 going up, -1 going down, 0 not on stairs */
+	int      until;     /* on stairs till then */
+	int      stepAt;    /* last stepped up or down */
+	int      lookAt;
+	qboolean active;    /* holds the turn keys */
+	qboolean turning;
+	float    yaw;       /* turning to this */
+	int      side;      /* the way the flight last bent: -1 left, 1 right */
+	int      saidAt;    /* "Stairs bend left" last said */
+} eta_stairKeep;
+
+/* How far along a yaw the player walks, a stride at a time as the game
+   steps them, before a wall or an edge; and how far up or down that is. */
+static float ETA_StairsKeepProbe(float yaw, float *rise, qboolean *edge)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              mins, maxs, at, dir;
+	float               walked = 0.0f, rad = DEG2RAD(yaw);
+	int                 s;
+
+	VectorCopy(ps->mins, mins);
+	VectorCopy(ps->maxs, maxs);
+	mins[0] += 2.0f;
+	mins[1] += 2.0f;
+	maxs[0] -= 2.0f;
+	maxs[1] -= 2.0f;
+	VectorSet(dir, cosf(rad), sinf(rad), 0.0f);
+	VectorCopy(ps->origin, at);
+	*edge = qfalse;
+
+	for (s = 0; s < ETA_STAIRS_KEEP_STRIDES; s++)
+	{
+		trace_t trace;
+		vec3_t  up, ahead, down;
+
+		VectorCopy(at, up);
+		up[2] += ETA_STAIRS_KEEP_STEPUP;
+		CG_Trace(&trace, at, mins, maxs, up, ps->clientNum, MASK_PLAYERSOLID);
+		VectorCopy(trace.endpos, up);
+
+		VectorMA(up, ETA_STAIRS_KEEP_STEP, dir, ahead);
+		CG_Trace(&trace, up, mins, maxs, ahead, ps->clientNum, MASK_PLAYERSOLID);
+		if (trace.startsolid || trace.allsolid)
+		{
+			break;
+		}
+		walked += trace.fraction * ETA_STAIRS_KEEP_STEP;
+		VectorCopy(trace.endpos, ahead);
+		if (trace.fraction < 1.0f)
+		{
+			break;   /* a wall, or a riser too high to step */
+		}
+
+		VectorCopy(ahead, down);
+		down[2] -= ETA_STAIRS_KEEP_STEPUP + ETA_STAIRS_KEEP_DROP;
+		CG_Trace(&trace, ahead, mins, maxs, down, ps->clientNum, MASK_PLAYERSOLID);
+		if (trace.fraction >= 1.0f || trace.plane.normal[2] < 0.7f)
+		{
+			*edge = qtrue;   /* nothing to stand on: the open side */
+			break;
+		}
+		VectorCopy(trace.endpos, at);
+	}
+
+	*rise = at[2] - ps->origin[2];
+	return walked;
+}
+
+/* Whether a yaw keeps the player on the flight: no wall, no edge, and
+   not back the way they came. Once a moment has gone with no step - a
+   landing, the foot, the top - only toward more steps up (or down)
+   within the probe's three metres: across a landing to the next flight,
+   but not along the flat floor beyond the foot or the top, which is the
+   player's to steer. */
+static qboolean ETA_StairsKeepOpen(float yaw)
+{
+	float    rise, along;
+	qboolean edge;
+	float    walked = ETA_StairsKeepProbe(yaw, &rise, &edge);
+
+	along = rise * (float)eta_stairKeep.sense;
+	if (edge || walked < ETA_STAIRS_KEEP_CLEAR || along <= -4.0f)
+	{
+		return qfalse;
+	}
+	return (qboolean)(cg.time - eta_stairKeep.stepAt < ETA_STAIRS_KEEP_LANDING || cg.time < eta_stairKeep.stepAt
+	                  || along >= 8.0f);
+}
+
+static void ETA_StairsKeepRelease(void)
+{
+	if (eta_stairKeep.active)
+	{
+		ETA_AimKeys(0, 0);
+		ETA_TurnBoost(qfalse);
+		eta_stairKeep.active = qfalse;
+	}
+	eta_stairKeep.turning = qfalse;
+}
+
+/* 1 going up stairs, -1 going down, 0 not on them. */
+int CG_AccessibilityOnStairs(void)
+{
+	return cg.time < eta_stairKeep.until ? eta_stairKeep.sense : 0;
+}
+
+static void ETA_StairsKeepFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	usercmd_t           cmd;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		ETA_StairsKeepRelease();
+		eta_stairKeep.sense = 0;
+		return;
+	}
+
+	/* Where the player has been: rising or falling a step's worth while
+	   walking is being on stairs. */
+	if (cg.time - eta_stairKeep.atTime[eta_stairKeep.head] >= ETA_STAIRS_KEEP_EVERY
+	    || cg.time < eta_stairKeep.atTime[eta_stairKeep.head])
+	{
+		int i, then = -1;
+
+		{
+			const float *last = eta_stairKeep.at[eta_stairKeep.head];
+
+			if (eta_stairKeep.atTime[eta_stairKeep.head] && ps->groundEntityNum != ENTITYNUM_NONE
+			    && fabsf(ps->origin[2] - last[2]) >= 4.0f)
+			{
+				eta_stairKeep.stepAt = cg.time;
+			}
+		}
+		eta_stairKeep.head = (eta_stairKeep.head + 1) % ETA_STAIRS_KEEP_SAMPLES;
+		VectorCopy(ps->origin, eta_stairKeep.at[eta_stairKeep.head]);
+		eta_stairKeep.atTime[eta_stairKeep.head] = cg.time;
+
+		for (i = 1; i < ETA_STAIRS_KEEP_SAMPLES; i++)
+		{
+			int k = (eta_stairKeep.head - i + ETA_STAIRS_KEEP_SAMPLES) % ETA_STAIRS_KEEP_SAMPLES;
+
+			if (eta_stairKeep.atTime[k] && cg.time - eta_stairKeep.atTime[k] >= ETA_STAIRS_KEEP_OVER
+			    && cg.time >= eta_stairKeep.atTime[k])
+			{
+				then = k;
+				break;
+			}
+		}
+
+		if (then >= 0 && ps->groundEntityNum != ENTITYNUM_NONE)
+		{
+			const float *from = eta_stairKeep.at[then];
+			float       dz    = ps->origin[2] - from[2];
+			float       dx    = ps->origin[0] - from[0], dy = ps->origin[1] - from[1];
+			float       along = sqrtf(dx * dx + dy * dy);
+
+			/* A step's worth up or down, and walked rather than fallen:
+			   more along than down. */
+			if (fabsf(dz) >= ETA_STAIRS_KEEP_RISE && along >= 24.0f && along >= fabsf(dz) * 0.8f)
+			{
+				eta_stairKeep.sense = dz > 0.0f ? 1 : -1;
+				eta_stairKeep.until = cg.time + ETA_STAIRS_KEEP_HOLD;
+			}
+		}
+	}
+
+	if (!eta_stairKeeper.integer || CG_AccessibilityOnStairs() == 0
+	    || ps->groundEntityNum == ENTITYNUM_NONE || eta_turn.step || eta_turn.held
+	    || (cg.time < eta_aim.manualUntil && eta_aim.manualUntil - cg.time <= ETA_AIM_MANUAL_MS))
+	{
+		ETA_StairsKeepRelease();
+		return;
+	}
+
+	/* Only walking forward, and not sidestepping: that is the player's
+	   own steering. */
+	if (!trap_GetUserCmd(trap_GetCurrentCmdNumber(), &cmd) || cmd.forwardmove <= 0 || cmd.rightmove)
+	{
+		ETA_StairsKeepRelease();
+		return;
+	}
+
+	if (cg.time - eta_stairKeep.lookAt >= ETA_STAIRS_KEEP_EVERY || cg.time < eta_stairKeep.lookAt)
+	{
+		float yaw = ps->viewangles[YAW];
+		int   off, found = 0;
+
+		eta_stairKeep.lookAt = cg.time;
+
+		if (ETA_StairsKeepOpen(yaw))
+		{
+			ETA_StairsKeepRelease();
+			return;
+		}
+
+		/* The least turn that keeps on the steps; the way the flight
+		   bent last first, as a turning stair keeps on bending one way. */
+		for (off = 10; off <= ETA_STAIRS_KEEP_WIDEST && !found; off += 10)
+		{
+			int first = eta_stairKeep.side ? eta_stairKeep.side : -1, k;
+
+			for (k = 0; k < 2 && !found; k++)
+			{
+				int side = k ? -first : first;
+
+				/* Left is a higher yaw. */
+				if (ETA_StairsKeepOpen(yaw - (float)(side * off)))
+				{
+					found              = side;
+					eta_stairKeep.yaw  = AngleNormalize360(yaw - (float)(side * off));
+					eta_stairKeep.side = side;
+				}
+			}
+		}
+
+		if (!found)
+		{
+			/* The top, the foot, or a wall: the player's again. */
+			ETA_StairsKeepRelease();
+			return;
+		}
+
+		/* Said at each bend: the turns of a tower stair are a way to count
+		   how high the player has come. */
+		if (!eta_stairKeep.turning
+		    && (cg.time - eta_stairKeep.saidAt > ETA_STAIRS_KEEP_SAY_MS || cg.time < eta_stairKeep.saidAt))
+		{
+			eta_stairKeep.saidAt = cg.time;
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say(found < 0 ? "Stairs bend left" : "Stairs bend right");
+		}
+		eta_stairKeep.turning = qtrue;
+	}
+
+	if (eta_stairKeep.turning)
+	{
+		vec3_t wanted;
+
+		VectorSet(wanted, ps->viewangles[PITCH], eta_stairKeep.yaw, 0.0f);
+		eta_stairKeep.active = qtrue;
+		if (ETA_AimSteerAngles(wanted, ETA_GUIDE_TOLERANCE))
+		{
+			ETA_StairsKeepRelease();
+		}
+	}
+}
