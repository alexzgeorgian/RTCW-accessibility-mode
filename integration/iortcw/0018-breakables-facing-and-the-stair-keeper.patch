+/**
+ * @brief Says which way the player faces, and what is straight ahead.
+ *
+ * A sighted player glances at the screen; the tester asked for a key to
+ * do the same. The compass point, whether the view is tipped up or down,
+ * whether the player is on stairs, and what the crosshair is on with how
+ * far, in one line: "Facing north-east, looking down. Ahead, stone
+ * floor, 4 meters."
+ */
+void CG_AccessibilityFacing_f(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	char                ahead[128], line[256];
+	const char          *tilt = "";
+	int                 meters;
+
+	ETA_Speech_BeginReport();
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		ETA_Speech_Say("Nothing to describe until you are in play");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	/* The game's pitch is down-positive. */
+	if (ps->viewangles[PITCH] < -45.0f)
+	{
+		tilt = ", looking right up";
+	}
+	else if (ps->viewangles[PITCH] < -12.0f)
+	{
+		tilt = ", looking up";
+	}
+	else if (ps->viewangles[PITCH] > 45.0f)
+	{
+		tilt = ", looking right down";
+	}
+	else if (ps->viewangles[PITCH] > 12.0f)
+	{
+		tilt = ", looking down";
+	}
+
+	Com_sprintf(line, sizeof(line), "Facing %s%s",
+	            ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(ps->viewangles[YAW])), tilt);
+
+	if (CG_AccessibilityOnStairs())
+	{
+		Q_strcat(line, sizeof(line), CG_AccessibilityOnStairs() > 0 ? ", on stairs going up" : ", on stairs going down");
+	}
+
+	if (ETA_DescribeLookAhead(ahead, sizeof(ahead), &meters, ETA_LOOK_AHEAD_RANGE, NULL))
+	{
+		ahead[0] = (char)tolower((unsigned char)ahead[0]);
+		if (meters >= 0)
+		{
+			Q_strcat(line, sizeof(line), va(". Ahead, %s, %d %s", ahead, meters < 1 ? 1 : meters,
+			                                meters <= 1 ? "meter" : "meters"));
+		}
+		else
+		{
+			Q_strcat(line, sizeof(line), va(". Ahead, %s", ahead));
+		}
+	}
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_Say(line);
+	ETA_Speech_EndReport();
+}
