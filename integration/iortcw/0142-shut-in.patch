+qboolean CG_AccessibilityWayOutSwitch(const vec3_t wayOut, vec3_t out, vec3_t aim)
 {
 	int   model, best = 0;
 	float bestFar = ETA_WAYOUT_DOOR_NEAR;
@@ -7504,6 +7568,7 @@ qboolean CG_AccessibilityWayOutSwitch(const vec3_t wayOut, vec3_t out)
