@@ -7455,6 +7467,58 @@ qboolean CG_AccessibilitySwitchStand(const vec3_t at, vec3_t out)
 	return found;
 }
 
+/*
+ * Shut in: a door close by, shut, that a switch close by opens - the way
+ * out of here before the way out of the level. The tester found the
+ * first catacomb level's secret room, its door shut behind them, and O
+ * said all was explored; the button that opens it from inside is in the
+ * room. Of such doors within 12 meters, the nearest; its switch within
+ * 16 meters, where it is pressed from.
+ */
+#define ETA_SHUT_IN_DOOR_NEAR   480.0f
+#define ETA_SHUT_IN_SWITCH_NEAR 640.0f
+
+qboolean CG_AccessibilityShutInSwitch(vec3_t out, vec3_t aim)
+{
+	const float *here = cg.predictedPlayerState.origin;
+	int         model;
+	float       bestFar = ETA_SHUT_IN_DOOR_NEAR;
+	qboolean    found   = qfalse;
+
+	for (model = 1; model < MAX_MODELS; model++)
+	{
+		vec3_t   mins, maxs, mid, at;
+		qboolean opens;
+		float    far;
+		int      shut;
+
+		if (!eta_doorOpener[model] || !CG_AccessibilityDoorBox(model, mins, maxs, &opens))
+		{
+			continue;
+		}
+		shut = CG_AccessibilityDoorShutNow(model);
+		if (shut == 0 || ( shut < 0 && eta_doorSeen[model] != 2 ))
+		{
+			continue;
+		}
+		VectorAdd(mins, maxs, mid);
+		VectorScale(mid, 0.5f, mid);
+		far = Distance(mid, here);
+		if (far >= bestFar || !CG_AccessibilityDoorOpener(model, mid, at) || Distance(at, here) > ETA_SHUT_IN_SWITCH_NEAR)
+		{
+			continue;
+		}
+		bestFar = far;
+		VectorCopy(at, aim);
+		if (!CG_AccessibilitySwitchStand(at, out))
+		{
+			VectorCopy(at, out);
+		}
+		found = qtrue;
+	}
+	return found;
+}
+
 /*
  * The way out shut behind a door only a switch opens: that switch. The
  * tester found the journal in the first catacomb level and was told to
@@ -7469,7 +7533,7 @@ qboolean CG_AccessibilitySwitchStand(const vec3_t at, vec3_t out)
  */
 #define ETA_WAYOUT_DOOR_NEAR 1200.0f
 
