+/* A door's lock as the game has it now (g_main.c): 'L' locked, 'S' opened
+   only by a switch or the story, 'd' opens or stands open; 0 not known. */
+char CG_AccessibilityDoorLive(int model)
+{
+	const char *state = CG_ConfigString(CS_ETA_TRIGGERS);
+	char       c;
+
+	if (model <= 0 || model >= MAX_MODELS || state[0] != '!' || model >= (int)strlen(state))
+	{
+		return 0;
+	}
+	c = state[model];
+	return c == 'L' || c == 'S' || c == 'd' ? c : 0;
+}
