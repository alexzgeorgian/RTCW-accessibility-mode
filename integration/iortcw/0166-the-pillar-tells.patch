+/* For T: a lift down and waiting to be stood on, where; qfalse none. */
+qboolean CG_AccessibilityLiftWaiting(vec3_t at)
+{
+	int l;
+
+	for (l = 0; l < eta_liftCount; l++)
+	{
+		vec3_t tmins, tmaxs;
+
+		if (!eta_lifts[l].announced || !eta_lifts[l].trigger || !cgs.inlineDrawModel[eta_lifts[l].trigger])
+		{
+			continue;
+		}
+		trap_R_ModelBounds(cgs.inlineDrawModel[eta_lifts[l].trigger], tmins, tmaxs);
+		VectorAdd(tmins, tmaxs, at);
+		VectorScale(at, 0.5f, at);
+		return qtrue;
+	}
+	return qfalse;
+}
