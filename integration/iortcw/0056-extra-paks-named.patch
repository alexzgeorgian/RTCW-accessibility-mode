+/*
+ * Game files that are not the game's own, said once in the menus. The
+ * tester heard the weapons reload, the footsteps and the menu as another
+ * version of the game has them - a pk3 from a remake, left in the main
+ * folder, whose sounds and menus win over the original's - and could not
+ * look through the folder to find it. The game's own campaign files, the
+ * multiplayer ones beside them and the mode's own are passed over;
+ * anything else is named, with where to move it from.
+ */
+static void UI_AccessibilityExtraPaksFrame( int realtime ) {
+	static qboolean said;
+	static const char *const own[] = {
+		"pak0.pk3", "sp_pak1.pk3", "sp_pak2.pk3", "sp_pak3.pk3", "sp_pak4.pk3", "sp_zaccessibility.pk3"
+	};
+	char list[8192], extra[512];
+	char *name;
+	int  count, i, j, found = 0;
+
+	if ( said || realtime < 9000 ) {
+		return;
+	}
+	said = qtrue;
+
+	count    = trap_FS_GetFileList( "", "pk3", list, sizeof( list ) );
+	extra[0] = '\0';
+	for ( i = 0, name = list; i < count && *name; i++, name += strlen( name ) + 1 ) {
+		const char *base = strrchr( name, '/' ) ? strrchr( name, '/' ) + 1 : name;
+
+		for ( j = 0; j < (int)ARRAY_LEN( own ); j++ ) {
+			if ( !Q_stricmp( base, own[j] ) ) {
+				break;
+			}
+		}
+		if ( j < (int)ARRAY_LEN( own ) || !Q_stricmpn( base, "mp_", 3 ) ) {
+			continue;
+		}
+		Q_strcat( extra, sizeof( extra ), va( "%s%s", found ? ", " : "", base ) );
+		found++;
+	}
+	if ( !found ) {
+		return;
+	}
+#ifdef __APPLE__
+	ETA_Speech_SayLong( va( "Your game's main folder has %s that %s not the original game's: %s. %s can change the game's "
+							"sounds, music and menus. To have the original game, move %s out of the main folder: in "
+							"your home folder, Library, Application Support, RTCW, main, or the main folder beside "
+							"the game", found == 1 ? "a file" : "files", found == 1 ? "is" : "are", extra,
+							found == 1 ? "It" : "They", found == 1 ? "it" : "them" ) );
+#else
+	ETA_Speech_SayLong( va( "Your game's main folder has %s that %s not the original game's: %s. %s can change the game's "
+							"sounds, music and menus. To have the original game, move %s out of the main folder beside "
+							"the game", found == 1 ? "a file" : "files", found == 1 ? "is" : "are", extra,
+							found == 1 ? "It" : "They", found == 1 ? "it" : "them" ) );
+#endif
+}
