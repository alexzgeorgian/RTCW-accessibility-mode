+/* For F: the thing chosen with T or Y - not yet gone to with O
+   (pending), or the one O last led to. */
+qboolean CG_AccessibilityThingChoice(vec3_t out, char *name, size_t nameSize, qboolean *pending)
+{
+	if (eta_chosenSet && eta_chosenThing)
+	{
+		VectorCopy(eta_chosenPoint, out);
+		Q_strncpyz(name, eta_chosenName, nameSize);
+		*pending = qtrue;
+		return qtrue;
+	}
+	*pending = qfalse;
+	return CG_AccessibilityLedTo(out, name, nameSize);
+}
+
+/* The thing O led to is done: F no longer turns to it. */
+void CG_AccessibilityLedClear(void)
+{
+	eta_ledSet = qfalse;
+}
+
 /* Backspace: the choice let go of, with the marker. */
