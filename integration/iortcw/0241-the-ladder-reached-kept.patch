+/* The foot of the last ladder the marker was reached at, kept once the
+   marker is gone: a step or two off it after "Marker reached", F turned
+   the tester to the ramp beside the forest's watchtower, the ladder out
+   of its own reach. Kept until another marker is on. */
+qboolean CG_AccessibilityLadderReached(vec3_t foot)
+{
+	if (!eta_ladderReachedAt || eta_marker.active)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_ladderReachedFoot, foot);
+	return qtrue;
+}
