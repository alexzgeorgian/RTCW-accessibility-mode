+/* Turned toward a point, at eye height: the back of the truck's
+   marker, reached, turns the player up its ramp. */
+void CG_AccessibilityFacePoint(const vec3_t point)
+{
+	etaAimTarget_t aim;
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	memset(&aim, 0, sizeof(aim));
+	aim.entityNum = -1;
+	VectorCopy(point, aim.point);
+	aim.point[2] = cg.predictedPlayerState.origin[2] + cg.predictedPlayerState.viewheight;
+	ETA_AimStartSnap(&aim, NULL);
+}
