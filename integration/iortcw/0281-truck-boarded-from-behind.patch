+/*
+ * A way out boarded from one side only: the forest's supply truck,
+ * parked in the compound, is stowed away in from behind, up its ramp.
+ * O put the marker on the way out in the truck's bed, and said "Marker
+ * reached" two metres from it - beside the truck, through its side: the
+ * tester stood there and could not get in. O now leads to the back of
+ * it first, and turns the player up the ramp.
+ */
+typedef struct
+{
+	const char *map;
+	float       behind[3];    /* where to stand: at the foot of the ramp */
+	float       inside[3];    /* in the back of it */
+} etaBoarding_t;
+
+static const etaBoarding_t eta_boardings[] =
+{
+	{ "forest", { -5120.0f, 40.0f, 232.0f }, { -5120.0f, -144.0f, 240.0f } },
+};
+
+static const etaBoarding_t *ETA_BoardingNear(const vec3_t point)
+{
+	char base[MAX_QPATH];
+	int  i;
+
+	COM_StripExtension(COM_SkipPath(cgs.mapname), base, sizeof(base));
+	for (i = 0; i < (int)ARRAY_LEN(eta_boardings); i++)
+	{
+		vec3_t in;
+
+		VectorCopy(eta_boardings[i].inside, in);
+		if (!Q_stricmp(eta_boardings[i].map, base) && Distance(point, in) < 192.0f)
+		{
+			return &eta_boardings[i];
+		}
+	}
+	return NULL;
+}
+
+/* The inside of what is boarded from the back, near point: for the
+   marker's arrival at its back, which turns the player toward it. */
+qboolean CG_AccessibilityBoardingInside(const vec3_t point, vec3_t inside)
+{
+	const etaBoarding_t *b = ETA_BoardingNear(point);
+
+	if (!b)
+	{
+		return qfalse;
+	}
+	VectorCopy(b->inside, inside);
+	return qtrue;
+}
