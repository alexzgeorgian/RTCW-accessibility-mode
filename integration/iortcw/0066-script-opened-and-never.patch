@@ -66,9 +66,36 @@ static struct
 } eta_unlockSpots[ETA_UNLOCK_SPOTS];
 static int eta_unlockSpotCount;
 
+/* The locked doors nothing ever unlocks: scenery, said as locked for
+   good, so the player does not go looking for what opens them. */
+static qboolean eta_unlockNever[MAX_MODELS];
+
 void CG_AccessibilityUnlockReset(void)
 {
 	eta_unlockRecordCount = eta_unlockLineCount = eta_unlockSpotCount = 0;
+	memset(eta_unlockNever, 0, sizeof(eta_unlockNever));
+}
+
+/* Whether a name is aimed at by any entity, or alerted by the script. */
+static qboolean ETA_UnlockNamed(const char *name)
+{
+	int i;
+
+	for (i = 0; i < eta_unlockRecordCount; i++)
+	{
+		if (!Q_stricmp(eta_unlockRecords[i].target, name))
+		{
+			return qtrue;
+		}
+	}
+	for (i = 0; i < eta_unlockLineCount; i++)
+	{
+		if (eta_unlockLines[i].verb == 'a' && !Q_stricmp(eta_unlockLines[i].what, name))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
 }
 
