+static const etaLandmark_t *ETA_LandmarkAt(const vec3_t at)
+{
+	const char *map = cgs.mapname;
+	int        i;
+
+	if (!Q_strncmp(map, "maps/", 5))
+	{
+		map += 5;
+	}
+	for (i = 0; i < (int)ARRAY_LEN(eta_landmarks); i++)
+	{
+		const etaLandmark_t *l = &eta_landmarks[i];
+
+		if (!Q_stricmpn(map, l->map, strlen(l->map)) && map[strlen(l->map)] == '.'
+		    && at[0] >= l->mins[0] && at[0] <= l->maxs[0] && at[1] >= l->mins[1] && at[1] <= l->maxs[1]
+		    && at[2] >= l->mins[2] && at[2] <= l->maxs[2])
+		{
+			return l;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * On a perch - the church's rail, a hand wide over a drop that kills -
+ * W only the ways that are safe. Walked along the rail the edge guard
+ * saw rail ahead and let them go, and the tester, going along it to the
+ * breakable wood T named, fell to their death.
+ */
+static qboolean ETA_PerchGuard(const usercmd_t *cmd)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	const etaLandmark_t *l;
+	static int          saidAt;
+	float               moveYaw;
+	int                 k;
+
+	if (( !cmd->forwardmove && !cmd->rightmove ) || cmd->upmove > 0 || ps->groundEntityNum == ENTITYNUM_NONE
+	    || !( l = ETA_LandmarkAt(ps->origin) ) || !l->safeWays)
+	{
+		return qfalse;
+	}
+	moveYaw = ps->viewangles[YAW] + RAD2DEG(atan2f(-(float)cmd->rightmove, (float)cmd->forwardmove));
+	for (k = 0; k < l->safeWays; k++)
+	{
+		if (fabsf(AngleSubtract(moveYaw, l->safeYaw[k])) <= 50.0f)
+		{
+			return qfalse;
+		}
+	}
+	trap_SendConsoleCommand("-forward\n-back\n-moveleft\n-moveright\n");
+	if (cg.time - saidAt > 2500 || cg.time < saidAt)
+	{
+		saidAt = cg.time;
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say("Stopped: on the rail that way is the drop. Safe: north, the hop up onto the wall; or east, back "
+		               "onto the landing");
+	}
+	return qtrue;
+}
+
