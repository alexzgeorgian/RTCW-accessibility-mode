diff --git a/SP/code/cgame/cg_accessibility_keys.c b/SP/code/cgame/cg_accessibility_keys.c
index 58cc003e..5d64fd2e 100644
--- a/SP/code/cgame/cg_accessibility_keys.c
+++ b/SP/code/cgame/cg_accessibility_keys.c
@@ -828,6 +828,10 @@ static void ETA_AimStartSnap(const etaAimTarget_t *target, const char *label)
  */
 #define ETA_CHOOSE_HOLD_MS 30000
 
+/* Something new chosen with T, Y, X, L or K: what F was kept on is let
+   go of, so F does not turn back to it (cg_accessibility_world.c). */
+void CG_AccessibilityUseChoiceClear(void);
+
 static struct
 {
 	qboolean       held;
@@ -836,6 +840,11 @@ static struct
 	etaAimTarget_t target;
 } eta_choose;
 
+void CG_AccessibilityUseChoiceClear(void)
+{
+	eta_choose.held = qfalse;
+}
+
 /* Where a target is on the list now: by its entity, or for a ladder,
    which has none, by where it stands. -1 when it is gone. */
 static int ETA_ChooseFind(const etaAimTarget_t *list, int count, const etaAimTarget_t *want)
@@ -1202,6 +1211,7 @@ static void ETA_FollowFrame(void)
  */
 /* How near the nearest thing must be for F alone to turn to it. */
 #define ETA_F_CLOSE_METERS 4.0f
+#define ETA_F_LED_NEAR     40.0f   /* a thing to use this near where O led: the one led to */
 
 /* Whether the game's icon under the crosshair is something use does
    something with. */
@@ -1288,6 +1298,77 @@ void CG_AccessibilityActivateDown_f(void)
 		}
 	}
 
+	/* Led to a thing with T and O, and come to it: F turns to that
+	   thing, not to whatever F was last kept on. The tester, choosing a
+	   switch with T and walking there with O, pressed F and was turned
+	   to the thing F had been on before. */
+	if (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL)
+	{
+		vec3_t marker;
+		char   ledName[64];
+
+		if (CG_AccessibilityLedTo(marker, ledName, sizeof(ledName)))
+		{
+			int   j, best = -1;
+			float bestFar = ETA_F_LED_NEAR;
+
+			count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+			for (j = 0; j < count; j++)
+			{
+				float far = Distance(list[j].point, marker);
+
+				if (!list[j].stairs && list[j].meters <= ETA_F_CLOSE_METERS && far < bestFar)
+				{
+					best    = j;
+					bestFar = far;
+				}
+			}
+			if (best >= 0)
+			{
+				eta_choose.held     = qtrue;
+				eta_choose.byPlayer = qfalse;
+				eta_choose.at       = cg.time;
+				eta_choose.target   = list[best];
+			}
+			else
+			{
+				/* Not among the things F finds round about - a switch
+				   the map hides in an invisible trigger, which T knows
+				   from the map: aimed at where it is, and used there. */
+				etaAimTarget_t led;
+				vec3_t         eye;
+				trace_t        trace;
+
+				VectorCopy(cg.predictedPlayerState.origin, eye);
+				eye[2] += cg.predictedPlayerState.viewheight;
+				memset(&led, 0, sizeof(led));
+				led.entityNum = -1;
+				VectorCopy(marker, led.point);
+				led.meters = Distance(eye, marker) * ETA_QU_TO_METERS;
+				Q_strncpyz(led.name, ledName, sizeof(led.name));
+				led.name[0] = (char)toupper((unsigned char)led.name[0]);
+				CG_Trace(&trace, eye, NULL, NULL, marker, cg.predictedPlayerState.clientNum, MASK_SOLID);
+				if (led.meters <= ETA_F_CLOSE_METERS && (trace.fraction >= 0.95f || trace.entityNum != ENTITYNUM_WORLD))
+				{
+					eta_aim.cycleAt = cg.time;
+					if (led.meters <= ETA_USE_REACH_METERS)
+					{
+						ETA_AimStartSnap(&led, led.name);
+						eta_use.pending = qtrue;
+					}
+					else
+					{
+						/* Not kept facing as F keeps a thing it sees: a
+						   trigger in a wall is never in sight. */
+						ETA_AimStartSnap(&led, led.name);
+						ETA_Speech_Say("A step closer, and F uses it");
+					}
+					return;
+				}
+			}
+		}
+	}
+
 	/* Something chosen with the bracket keys comes before anything
 	   else - before what the crosshair is on, and before a ladder in
 	   reach. */
