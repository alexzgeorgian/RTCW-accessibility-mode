diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 640b5494..d6a04a0a 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -4420,10 +4420,40 @@ static int      eta_chosenAt;
 static vec3_t   eta_chosenPoint;
 static char     eta_chosenName[64];
 
+/* Where O last led to something chosen, for F: the marker goes when it
+   is reached, and F, pressed there, turns to the thing led to. */
+static qboolean eta_ledSet;
+static int      eta_ledAt;
+static vec3_t   eta_ledPoint;
+
+#define ETA_LED_MS 120000
+
+/* A thing T or Y chose: F turns to it there. Not a door X chose, whose
+   point is in the room beyond. */
+static qboolean eta_chosenThing, eta_ledThing;
+static char     eta_ledName[64];
+
+void CG_AccessibilityChosenIsThing(void)
+{
+	eta_chosenThing = qtrue;
+}
+
+qboolean CG_AccessibilityLedTo(vec3_t out, char *name, size_t nameSize)
+{
+	if (!eta_ledSet || !eta_ledThing || cg.time < eta_ledAt || cg.time - eta_ledAt >= ETA_LED_MS)
+	{
+		return qfalse;
+	}
+	VectorCopy(eta_ledPoint, out);
+	Q_strncpyz(name, eta_ledName, nameSize);
+	return qtrue;
+}
+
 /* Backspace: the choice let go of, with the marker. */
 void CG_AccessibilityChosenClear(void)
 {
 	eta_chosenSet = qfalse;
+	eta_ledSet    = qfalse;
 }
 
 /* Where O last led: the marker is O's own while it is still there. The
@@ -4477,6 +4507,11 @@ void CG_AccessibilityWayOut(void)
 	if (eta_chosenSet)
 	{
 		eta_chosenSet = qfalse;
+		eta_ledSet    = qtrue;
+		eta_ledThing  = eta_chosenThing;
+		eta_ledAt     = cg.time;
+		VectorCopy(eta_chosenPoint, eta_ledPoint);
+		Q_strncpyz(eta_ledName, eta_chosenName, sizeof(eta_ledName));
 		ETA_MarkerSetByO(eta_chosenPoint, eta_chosenName);
 		CG_AccessibilityFaceTheWay();
 		return;
@@ -4730,6 +4765,8 @@ static void ETA_DestinationStep(int step)
 		return;
 	}
 	ETA_WorldRead();
+	eta_chosenThing = qfalse;
+	CG_AccessibilityUseChoiceClear();
 
 	for (i = 0; i < eta_exitCount; i++)
 	{
@@ -4931,6 +4968,8 @@ qboolean CG_AccessibilityMapThing(int index, vec3_t at, char *name, size_t nameS
    for O. */
 void CG_AccessibilityChoose(const vec3_t point, const char *name)
 {
+	eta_chosenThing = qfalse;
+	CG_AccessibilityUseChoiceClear();
 	VectorCopy(point, eta_chosenPoint);
 	Q_strncpyz(eta_chosenName, name, sizeof(eta_chosenName));
 	eta_chosenSet = qtrue;
