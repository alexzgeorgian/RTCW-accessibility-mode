+static int eta_leverLiftUsedAt[ETA_LEVER_LIFTS];
+
+/*
+ * The way on by a lift or a ride, when there is no way on foot: the way
+ * to the next objective is worked out over the floors alone, and the
+ * rocket base's goes down a lift, along by the train, and up another -
+ * O said "no way" from the start. The nearest one the player has not
+ * just been carried by, at the player's own level: a lift by its shaft,
+ * the train by its lever.
+ */
+qboolean CG_AccessibilityConnectorNearest(vec3_t out, char *name, size_t size, qboolean *isLift)
+{
+	const float *me = cg.predictedPlayerState.origin;
+	float        best = 0.0f;
+	int          i, found = 0;
+
+	for (i = 0; i < eta_leverLiftCount; i++)
+	{
+		vec3_t at;
+
+		if (eta_leverLiftUsedAt[i] && cg.time >= eta_leverLiftUsedAt[i] && cg.time - eta_leverLiftUsedAt[i] < 180000)
+		{
+			continue;
+		}
+		/* By its call button at the player's own level: the shaft's
+		   middle at the player's height may be in the wall between two
+		   floors, and the way there was "no way". */
+		{
+			int k;
+
+			for (k = 0; k < eta_userCount; k++)
+			{
+				const float *b = cgs.inlineModelMidpoints[eta_users[k].model];
+
+				if (Q_stricmpn(eta_users[k].name, "Lift call button", 16) || fabsf(b[2] - me[2]) > 160.0f
+				    || b[0] < eta_leverLift[i].mins[0] - 200.0f || b[0] > eta_leverLift[i].maxs[0] + 200.0f
+				    || b[1] < eta_leverLift[i].mins[1] - 200.0f || b[1] > eta_leverLift[i].maxs[1] + 200.0f)
+				{
+					continue;
+				}
+				VectorCopy(b, at);
+				if (!found || Distance(at, me) < best)
+				{
+					found = 1;
+					best  = Distance(at, me);
+					VectorCopy(at, out);
+					Q_strncpyz(name, "the lift's call button", size);
+					*isLift = qtrue;
+				}
+			}
+		}
+	}
+	for (i = 0; i < eta_rideCount; i++)
+	{
+		int k;
+
+		if (!eta_rides[i].train
+		    || ( eta_rideUsedAt[i] && cg.time >= eta_rideUsedAt[i] && cg.time - eta_rideUsedAt[i] < 180000 ))
+		{
+			continue;
+		}
+		for (k = 0; k < eta_userCount; k++)
+		{
+			const float *at = cgs.inlineModelMidpoints[eta_users[k].model];
+
+			if (Q_stricmpn(eta_users[k].name, "Train lever", 11) || fabsf(at[2] - me[2]) > 128.0f)
+			{
+				continue;
+			}
+			if (!found || Distance(at, me) < best)
+			{
+				found = 1;
+				best  = Distance(at, me);
+				VectorCopy(at, out);
+				Q_strncpyz(name, "the train's lever", size);
+				*isLift = qfalse;
+			}
+		}
+	}
+	return (qboolean)found;
+}
