+/*
+ * The next objective in the notebook's order that has a place, before the
+ * way out: the lowest-numbered one not met, the nearest of its places.
+ * O led straight to the way out, whatever the script still wanted: in the
+ * rocket base, at the start, "Way out, 16 meters" - the exit right by the
+ * truck, shut until the rocket's launch is stopped far off. The tester
+ * felt the way out did not follow the script anywhere in the game. A
+ * place that meets two at once, which ends the level - the forest's
+ * truck - still comes last.
+ */
+qboolean CG_AccessibilityObjectiveInOrder(const vec3_t from, vec3_t out, int *objective)
+{
+	float    best = 0.0f;
+	int      i, found = 0, bestObjective = 0;
+	qboolean bestLast = qfalse;
+
+	for (i = 0; i < eta_objectivePlaceCount; i++)
+	{
+		int      o = eta_objectivePlaces[i].objective;
+		qboolean last;
+		float    far;
+
+		if (o <= 0 || CG_AccessibilityObjectiveDone(o))
+		{
+			continue;
+		}
+		last = ETA_ObjectivePlaceShared(i);
+		far  = Distance(from, eta_objectivePlaces[i].at);
+		if (found)
+		{
+			if (last != bestLast)
+			{
+				if (last)
+				{
+					continue;
+				}
+			}
+			else if (o > bestObjective || ( o == bestObjective && far >= best ))
+			{
+				continue;
+			}
+		}
+		found         = 1;
+		bestLast      = last;
+		bestObjective = o;
+		best          = far;
+		VectorCopy(eta_objectivePlaces[i].at, out);
+		*objective = o;
+	}
+	return (qboolean)found;
+}
