+/* A ladder of the map whose foot is within F's few steps, at the
+   player's own level: the one nearest `near` (the marker's foot) or, with
+   none, the player. Climbed: walked to its foot, and up. False when none. */
+static qboolean ETA_ClimbMapLadder(const vec3_t near)
+{
+	const float *at  = cg.predictedPlayerState.origin;
+	int         l, best = -1;
+	float       bestFar = ETA_F_CLOSE_METERS / ETA_QU_TO_METERS;
+	vec3_t      foot, top, lmins, lmaxs;
+	etaLadder_t ladder;
+	int         thin;
+
+	for (l = 0; l < CG_AccessibilityLadderCount(); l++)
+	{
+		float far;
+
+		if (!CG_AccessibilityLadderEnds(l, foot, top) || top[2] - foot[2] <= 64.0f
+		    || fabsf(foot[2] - at[2]) > 80.0f)
+		{
+			continue;
+		}
+		if (near && Distance(foot, near) > 64.0f)
+		{
+			continue;
+		}
+		far = sqrtf(( foot[0] - at[0] ) * ( foot[0] - at[0] ) + ( foot[1] - at[1] ) * ( foot[1] - at[1] ));
+		if (far <= bestFar)
+		{
+			bestFar = far;
+			best    = l;
+		}
+	}
+	if (best < 0 || !CG_AccessibilityLadderEnds(best, foot, top) || !CG_AccessibilityMapLadder(best, lmins, lmaxs))
+	{
+		return qfalse;
+	}
+	memset(&ladder, 0, sizeof(ladder));
+	thin = ( lmaxs[0] - lmins[0] ) < ( lmaxs[1] - lmins[1] ) ? 0 : 1;
+	ladder.point[0]     = ( lmins[0] + lmaxs[0] ) * 0.5f;
+	ladder.point[1]     = ( lmins[1] + lmaxs[1] ) * 0.5f;
+	ladder.point[2]     = at[2] + 16.0f;
+	ladder.normal[thin] = foot[thin] > ladder.point[thin] ? 1.0f : -1.0f;
+	ladder.point[thin]  = ladder.normal[thin] > 0.0f ? lmaxs[thin] : lmins[thin];
+	ladder.goesUp       = qtrue;
+	ladder.hasStand     = qtrue;
+	VectorCopy(foot, ladder.stand);
+	ladder.meters = Distance(foot, at) * ETA_QU_TO_METERS;
+	ETA_ClimbStart(&ladder);
+	return qtrue;
+}
