+					float a = ( eta_routeLocked[i].mins[k] - from[k] ) / d, b = ( eta_routeLocked[i].maxs[k] - from[k] ) / d;
+
+					if (a > b)
+					{
+						float t = a; a = b; b = t;
+					}
