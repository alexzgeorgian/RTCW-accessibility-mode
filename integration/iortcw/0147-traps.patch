+			float t0 = 0.0f, t1 = 1.0f;
+
+			for (k = 0; k < 2; k++)
+			{
+				float d = to[k] - from[k];
+
+				if (fabsf(d) < 0.001f)
+				{
+					if (from[k] < eta_routeLocked[i].mins[k] || from[k] > eta_routeLocked[i].maxs[k])
+					{
+						break;
