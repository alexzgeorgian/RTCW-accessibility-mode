+			}
+			continue;
+		}
 		trap_CM_TransformedBoxTrace(&trace, from, to, mins, maxs, eta_routeLocked[i].clip, MASK_PLAYERSOLID,
 		                            eta_routeLocked[i].origin, vec3_origin);
 		if (trace.startsolid || trace.fraction < 1.0f)
