 /* Whether a walk from one point to another goes into a door locked shut. */
+/* A plate this near: the squares about it are fitted to the strips
+   beside it. */
+static qboolean ETA_RouteNearPlate(const float at[3])
+{
+	int i;
+
+	for (i = 0; i < eta_routeLockedCount; i++)
+	{
+		if (eta_routeLocked[i].clip < 0
+		    && at[0] > eta_routeLocked[i].mins[0] - 64.0f && at[0] < eta_routeLocked[i].maxs[0] + 64.0f
+		    && at[1] > eta_routeLocked[i].mins[1] - 64.0f && at[1] < eta_routeLocked[i].maxs[1] + 64.0f
+		    && at[2] > eta_routeLocked[i].mins[2] - 32.0f && at[2] < eta_routeLocked[i].maxs[2] + 32.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
