+/*
+ * An item of the mode's own put into one of the game's menus, under its
+ * own name, after the item it follows: "item" in the tabs file, where
+ * "tab" is the Accessibility button. Read again when the menus are, it is
+ * not put in twice.
+ *
+ * The Load menu's two categories, "Saved games" and "Autosaves", are
+ * these: the tester found the Load menu not set out in categories as
+ * Options is, with the autosaves behind a switch with no words on it.
+ */
+static void UI_AccessibilityAddItem( menuDef_t *menu, const char *after, int handle ) {
+	itemDef_t *added;
+	int i, at = -1;
+
+	if ( !MenuParse_itemDef( (itemDef_t*)menu, handle ) || menu->itemCount <= 0 ) {
+		return;
+	}
+	added = menu->items[menu->itemCount - 1];
+	for ( i = 0; i < menu->itemCount - 1; i++ ) {
+		if ( added->window.name && menu->items[i]->window.name
+			 && !Q_stricmp( menu->items[i]->window.name, added->window.name ) ) {
+			menu->itemCount--;
+			return;
+		}
+	}
+	Item_UpdatePosition( added );
+	for ( i = 0; i < menu->itemCount - 1; i++ ) {
+		if ( menu->items[i]->window.name && !Q_stricmp( menu->items[i]->window.name, after ) ) {
+			at = i + 1;
+		}
+		/* The game's switch with no words on it: the categories do
+		   what it did, and the arrows pass it by. */
+		if ( menu->items[i]->window.name && !Q_stricmp( menu->items[i]->window.name, "autosave" )
+			 && menu->items[i]->type == ITEM_TYPE_MULTI ) {
+			menu->items[i]->window.flags |= WINDOW_DECORATION;
+		}
+	}
+	if ( at >= 0 ) {
+		for ( i = menu->itemCount - 1; i > at; i-- ) {
+			menu->items[i] = menu->items[i - 1];
+		}
+		menu->items[at] = added;
+	}
+}
+
+/* Which saves the Load menu shows, and how many: said as a category is
+   chosen, and as the menu opens. */
+static const char *UI_AccessibilitySavesText( void ) {
+	int n = uiInfo.savegameCount;
+
+	return va( "%s, %s", trap_Cvar_VariableValue( "ui_savegameListAutosave" ) ? "Autosaves" : "Saved games",
+			   n == 0 ? "none" : n == 1 ? "1 save" : va( "%d saves", n ) );
+}
