+/*
+ * The level's things to take or press, as the map lays them out, for T
+ * (cg_accessibility_things.c): its items, then its switches and buttons -
+ * not the triggers that are a door's own handle. qfalse past the last.
+ */
+qboolean CG_AccessibilityMapThing(int index, vec3_t at, char *name, size_t nameSize, qboolean *item)
+{
+	int i;
+
+	ETA_WorldRead();
+	if (index < eta_mapItemCount)
+	{
+		gitem_t *it = &bg_itemlist[eta_mapItems[index].item];
+		int      n  = eta_mapItems[index].item;
+
+		VectorCopy(eta_mapItems[index].at, at);
+		Q_strncpyz(name, cgs.itemPrintNames[n][0] ? cgs.itemPrintNames[n] : it->pickup_name ? it->pickup_name : "Item",
+		           nameSize);
+		*item = qtrue;
+		return qtrue;
+	}
+	index -= eta_mapItemCount;
+	if (index < eta_userCount)
+	{
+		VectorCopy(cgs.inlineModelMidpoints[eta_users[index].model], at);
+		Q_strncpyz(name, Q_stricmp(eta_users[index].name, "Door") ? eta_users[index].name : "", nameSize);
+		if (name[0] && eta_opensDoor[eta_users[index].model])
+		{
+			Q_strcat(name, nameSize, " for a door");
+		}
+		*item = qfalse;
+		return qtrue;
+	}
+	index -= eta_userCount;
+	for (i = 1; i < MAX_MODELS; i++)
+	{
+		if (eta_buttonModel[i] && index-- == 0)
+		{
+			VectorCopy(cgs.inlineModelMidpoints[i], at);
+			Q_strncpyz(name, eta_opensDoor[i] ? "Button for a door" : "Button", nameSize);
+			*item = qfalse;
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
