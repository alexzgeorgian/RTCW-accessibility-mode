+/*
+ * The things the map lays out, put in as the level starts - its items,
+ * switches and buttons - so T knows them before they are in sight: the
+ * tester, drawn away by a fight, never came near the lever at the end of
+ * the first level, and T had never heard of it. A sighted player sees a
+ * lever on a wall in passing; this is that glance, for the whole level.
+ */
+static void ETA_ThingsSeed(void)
+{
+	char     name[64];
+	vec3_t   at;
+	qboolean item;
+	int      i, j;
+
+	eta_things.seeded = qtrue;
+	for (i = 0; eta_things.count < ETA_THINGS_MAX && CG_AccessibilityMapThing(i, at, name, sizeof(name), &item); i++)
+	{
+		if (!name[0])
+		{
+			continue;
+		}
+		for (j = 0; j < eta_things.count; j++)
+		{
+			if (ETA_ThingNear(eta_things.things[j].point, at, ETA_THINGS_SAME))
+			{
+				break;
+			}
+		}
+		if (j < eta_things.count)
+		{
+			continue;
+		}
+		VectorCopy(at, eta_things.things[j].point);
+		if (item)
+		{
+			eta_things.things[j].point[2] += 8.0f;
+		}
+		eta_things.things[j].entityNum = -1;
+		Q_strncpyz(eta_things.things[j].name, name, sizeof(eta_things.things[j].name));
+		eta_things.things[j].kind = item ? ETA_THING_ITEM : ETA_THING_SWITCH;
+		eta_things.things[j].done = qfalse;
+		eta_things.count++;
+	}
+}
