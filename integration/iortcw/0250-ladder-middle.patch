+			    && ladder->point[1] > lmins[1] - 48.0f && ladder->point[1] < lmaxs[1] + 48.0f)
+			{
+				int thin = ( lmaxs[0] - lmins[0] ) < ( lmaxs[1] - lmins[1] ) ? 0 : 1;
+
+				eta_climb.hasMiddle = qtrue;
+				eta_climb.sideAxis  = thin ^ 1;
+				eta_climb.middle    = ( lmins[thin ^ 1] + lmaxs[thin ^ 1] ) * 0.5f;
+				break;
+			}
+		}
