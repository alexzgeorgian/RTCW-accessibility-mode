+/* Stepping sideways on the ladder, back to its middle. */
+#define ETA_CLIMB_KEY_LEFT  "979"
+#define ETA_CLIMB_KEY_RIGHT "978"
+
+static void ETA_ClimbStrafe(int dir)
+{
+	if (dir == eta_climb.strafe)
+	{
+		return;
+	}
+	if (eta_climb.strafe)
+	{
+		trap_SendConsoleCommand(va("-%s %s\n", eta_climb.strafe > 0 ? "moveright" : "moveleft",
+		                           eta_climb.strafe > 0 ? ETA_CLIMB_KEY_RIGHT : ETA_CLIMB_KEY_LEFT));
+	}
+	if (dir)
+	{
+		trap_SendConsoleCommand(va("+%s %s\n", dir > 0 ? "moveright" : "moveleft",
+		                           dir > 0 ? ETA_CLIMB_KEY_RIGHT : ETA_CLIMB_KEY_LEFT));
+	}
+	eta_climb.strafe = dir;
+}
