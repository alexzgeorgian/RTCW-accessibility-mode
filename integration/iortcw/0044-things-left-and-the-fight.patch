diff --git a/SP/code/cgame/cg_accessibility_things.c b/SP/code/cgame/cg_accessibility_things.c
new file mode 100644
index 00000000..20192588
--- /dev/null
+++ b/SP/code/cgame/cg_accessibility_things.c
@@ -0,0 +1,433 @@
+/*
+ * name:	cg_accessibility_things.c
+ *
+ * desc:	[Accessibility]: the things a level has to pick up, press or
+ *			break, remembered from the moment they are first in reach,
+ *			and the way back to where a fight began.
+ *
+ *			Only built with FEATURE_ACCESSIBILITY.
+ */
+
+#ifdef FEATURE_ACCESSIBILITY
+
+#include "cg_local.h"
+
+#include "hud/hud_narrator.h"
+#include "speech/speech_manager.h"
+
+/**
+ * @brief "4 things left: 2 items, 1 switch, 1 to break. Nearest: Health,
+ * behind, 8 meters."
+ *
+ * The tester wanted every item and everything to use, and lost them: a
+ * fight took them away from a room, and nothing remembered what was left
+ * in it. K and J say only what is near now. So everything K and J have
+ * had on their list - the things on the ground, the buttons and switches,
+ * the things to break - is kept for the whole level, until it is picked
+ * up, pressed or broken. T leads, by the ping and the walk guide, to the
+ * nearest one left; T again within a few seconds, to the next nearest.
+ *
+ * And when a fight is over - no enemy in sight for a few seconds, after
+ * one was - O leads back to where the player was when it began.
+ */
+
+#define ETA_THINGS_MAX       160
+#define ETA_THINGS_LOOK_MS   500     /* the list looked at this often */
+#define ETA_THINGS_SAME      48.0f   /* this near another: the same thing */
+#define ETA_THINGS_GONE      600.0f  /* this near, and not there: taken */
+#define ETA_THINGS_PICK_MS   8000    /* T again this soon: the next one */
+#define ETA_FIGHT_QUIET_MS   6000    /* no enemy in sight this long: over */
+#define ETA_FIGHT_CALM_MS    10000   /* and before it, this long: a new one */
+#define ETA_FIGHT_AWAY       160.0f  /* only said when this far from its start */
+
+typedef enum
+{
+	ETA_THING_ITEM,
+	ETA_THING_SWITCH,
+	ETA_THING_BREAKABLE
+} eta_thingKind_t;
+
+typedef struct
+{
+	vec3_t          point;
+	int             entityNum;   /* or -1, for a switch the map hides */
+	char            name[64];
+	eta_thingKind_t kind;
+	qboolean        done;
+} eta_thing_t;
+
+static struct
+{
+	eta_thing_t things[ETA_THINGS_MAX];
+	int         count;
+	int         lookedAt;
+	int         target;     /* the one T leads to, or -1 */
+	int         pickedAt;
+	int         picks;
+
+	/* The fight. */
+	qboolean    fighting;
+	int         lastEnemyAt;
+	vec3_t      fightFrom;
+} eta_things;
+
+static qboolean ETA_ThingNear(const vec3_t a, const vec3_t b, float near)
+{
+	float dx = a[0] - b[0], dy = a[1] - b[1];
+
+	return (qboolean)(dx * dx + dy * dy < near * near && fabsf(a[2] - b[2]) < 64.0f);
+}
+
+/* What a thing on K and J's list is, or -1 for one this does not keep: a
+   door or a doorway (V's ways), a ladder or stairs, a mounted gun. */
+static int ETA_ThingKind(const etaAimTarget_t *target)
+{
+	if (target->ladder || target->stairs || target->enemy)
+	{
+		return -1;
+	}
+	if (target->entityNum >= 0 && target->entityNum < MAX_GENTITIES)
+	{
+		const entityState_t *es = &cg_entities[target->entityNum].currentState;
+
+		switch (es->eType)
+		{
+		case ET_ITEM:
+			return ETA_THING_ITEM;
+		case ET_EXPLOSIVE:
+			return ETA_THING_BREAKABLE;
+		case ET_MOVER:
+			/* A door is a way; a button is a switch. */
+			return Q_stristr(target->name, "door") && !Q_stristr(target->name, "for a door") ? -1 : ETA_THING_SWITCH;
+		default:
+			return -1;
+		}
+	}
+	/* Known only by where it is: a switch in an invisible trigger, but
+	   not a door opened by one. */
+	return Q_stricmp(target->name, "Door") ? ETA_THING_SWITCH : -1;
+}
+
+/* What is on K and J's list now, into the level's list. */
+static void ETA_ThingsRecord(void)
+{
+	etaAimTarget_t list[32];
+	int            count = CG_AccessibilityUseTargets(list, ARRAY_LEN(list)), i, j;
+
+	for (i = 0; i < count; i++)
+	{
+		int kind = ETA_ThingKind(&list[i]);
+
+		if (kind < 0)
+		{
+			continue;
+		}
+		for (j = 0; j < eta_things.count; j++)
+		{
+			eta_thing_t *thing = &eta_things.things[j];
+
+			if (( list[i].entityNum >= 0 && thing->entityNum == list[i].entityNum
+			      && ETA_ThingNear(thing->point, list[i].point, ETA_THINGS_SAME * 2.0f) )
+			    || ETA_ThingNear(thing->point, list[i].point, ETA_THINGS_SAME))
+			{
+				break;
+			}
+		}
+		if (j < eta_things.count || eta_things.count >= ETA_THINGS_MAX)
+		{
+			continue;
+		}
+		VectorCopy(list[i].point, eta_things.things[j].point);
+		eta_things.things[j].entityNum = list[i].entityNum;
+		Q_strncpyz(eta_things.things[j].name, list[i].name, sizeof(eta_things.things[j].name));
+		/* "Button for a door ahead right 4 meters": where the door was
+		   from here, which is wrong once the player has moved. */
+		{
+			char *at = (char *)Q_stristr(eta_things.things[j].name, " for a door");
+
+			if (at)
+			{
+				at[strlen(" for a door")] = '\0';
+			}
+		}
+		eta_things.things[j].kind = (eta_thingKind_t)kind;
+		eta_things.things[j].done = qfalse;
+		eta_things.count++;
+	}
+}
+
+/* Whether the server still sends a thing, where it was: an item picked
+   up, or a crate broken, is gone. */
+static qboolean ETA_ThingStillThere(const eta_thing_t *thing)
+{
+	int i;
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+
+		if (es->number == thing->entityNum)
+		{
+			if (es->eType == ET_ITEM)
+			{
+				return (qboolean)!( es->eFlags & EF_NODRAW );
+			}
+			return (qboolean)( es->eType == ET_EXPLOSIVE || es->eType == ET_MOVER );
+		}
+	}
+	return qfalse;
+}
+
+static void ETA_ThingsCount(int counts[3], int *left)
+{
+	int i;
+
+	counts[0] = counts[1] = counts[2] = *left = 0;
+	for (i = 0; i < eta_things.count; i++)
+	{
+		if (!eta_things.things[i].done)
+		{
+			counts[eta_things.things[i].kind]++;
+			( *left )++;
+		}
+	}
+}
+
+/* "4 things left: 2 items, 1 switch, 1 to break". */
+static void ETA_ThingsProgress(char *out, size_t size)
+{
+	int counts[3], left;
+
+	ETA_ThingsCount(counts, &left);
+	if (!left)
+	{
+		Q_strncpyz(out, "No things left", size);
+		return;
+	}
+	Com_sprintf(out, size, "%d %s left:", left, left == 1 ? "thing" : "things");
+	if (counts[ETA_THING_ITEM])
+	{
+		Q_strcat(out, size, va(" %d %s,", counts[ETA_THING_ITEM], counts[ETA_THING_ITEM] == 1 ? "item" : "items"));
+	}
+	if (counts[ETA_THING_SWITCH])
+	{
+		Q_strcat(out, size, va(" %d %s,", counts[ETA_THING_SWITCH], counts[ETA_THING_SWITCH] == 1 ? "switch" : "switches"));
+	}
+	if (counts[ETA_THING_BREAKABLE])
+	{
+		Q_strcat(out, size, va(" %d to break,", counts[ETA_THING_BREAKABLE]));
+	}
+	out[strlen(out) - 1] = '\0';
+}
+
+/* For F1. */
+void CG_AccessibilityThingsProgress(char *out, size_t size)
+{
+	ETA_ThingsProgress(out, size);
+}
+
+/* F pressed a switch: it is done. From cg_accessibility_keys.c. */
+void CG_AccessibilityThingUsed(int entityNum, const vec3_t point)
+{
+	int i;
+
+	for (i = 0; i < eta_things.count; i++)
+	{
+		eta_thing_t *thing = &eta_things.things[i];
+
+		if (thing->kind == ETA_THING_SWITCH && !thing->done
+		    && ( ( entityNum >= 0 && thing->entityNum == entityNum ) || ETA_ThingNear(thing->point, point, 64.0f) ))
+		{
+			thing->done = qtrue;
+		}
+	}
+}
+
+/* T: to the nearest thing left. */
+void CG_AccessibilityThingsNext(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 order[ETA_THINGS_MAX];
+	int                 count = 0, i, j, meters;
+	char                progress[160], name[80];
+	eta_thing_t         *thing;
+	vec3_t              delta;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL)
+	{
+		return;
+	}
+	ETA_ThingsRecord();
+
+	for (i = 0; i < eta_things.count; i++)
+	{
+		if (!eta_things.things[i].done)
+		{
+			order[count++] = i;
+		}
+	}
+	if (!count)
+	{
+		ETA_Speech_Say(eta_things.count ? "Everything found has been taken or used. V finds new ways"
+		               : "Nothing found yet to take or use. V finds new ways");
+		eta_things.target = -1;
+		return;
+	}
+
+	/* Nearest first, a floor counting double. */
+	for (i = 0; i < count; i++)
+	{
+		for (j = i + 1; j < count; j++)
+		{
+			const float *a = eta_things.things[order[i]].point, *b = eta_things.things[order[j]].point;
+			float       fa = Distance(ps->origin, a) + fabsf(a[2] - ps->origin[2]);
+			float       fb = Distance(ps->origin, b) + fabsf(b[2] - ps->origin[2]);
+
+			if (fb < fa)
+			{
+				int t = order[i];
+
+				order[i] = order[j];
+				order[j] = t;
+			}
+		}
+	}
+
+	if (cg.time >= eta_things.pickedAt && cg.time - eta_things.pickedAt < ETA_THINGS_PICK_MS)
+	{
+		eta_things.picks++;
+	}
+	else
+	{
+		eta_things.picks = 0;
+	}
+	eta_things.target   = order[eta_things.picks % count];
+	eta_things.pickedAt = cg.time;
+	thing               = &eta_things.things[eta_things.target];
+
+	VectorSubtract(thing->point, ps->origin, delta);
+	meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
+	meters = meters < 1 ? 1 : meters;
+	ETA_ThingsProgress(progress, sizeof(progress));
+
+	/* Close enough to reach: no ping, only what to do with it. */
+	if (meters <= 4)
+	{
+		static const char *const what[3] = { "Walk onto it", "F uses it", "F turns you to it, to break it" };
+
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(va("%s. %s: %s, %s, %d %s. %s", progress, eta_things.picks ? "Next" : "Nearest", thing->name,
+		                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(thing->point)), meters,
+		                  meters == 1 ? "meter" : "meters", what[thing->kind]));
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s. %s: %s, %s, %d %s. Follow the ping", progress, eta_things.picks ? "Next" : "Nearest",
+	                  thing->name, ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(thing->point)),
+	                  meters, meters == 1 ? "meter" : "meters"));
+	ETA_Speech_EndReport();
+
+	Q_strncpyz(name, thing->name, sizeof(name));
+	name[0] = (char)tolower((unsigned char)name[0]);
+	CG_AccessibilityMarkerSet(thing->point, name);
+}
+
+/* Each frame: what is in reach, what is gone, and the fight. */
+void CG_AccessibilityThingsFrame(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 i;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cg.cameraMode)
+	{
+		return;
+	}
+
+	if (cg.time - eta_things.lookedAt >= ETA_THINGS_LOOK_MS || cg.time < eta_things.lookedAt)
+	{
+		eta_things.lookedAt = cg.time;
+		ETA_ThingsRecord();
+
+		/* Gone, seen gone: taken or broken. A switch is done once F has
+		   pressed it (CG_AccessibilityThingUsed). */
+		for (i = 0; i < eta_things.count; i++)
+		{
+			eta_thing_t *thing = &eta_things.things[i];
+
+			if (thing->done || thing->kind == ETA_THING_SWITCH || thing->entityNum < 0
+			    || !ETA_ThingNear(ps->origin, thing->point, ETA_THINGS_GONE) || ETA_ThingStillThere(thing))
+			{
+				continue;
+			}
+			/* Not sent can also be out of sight, through a wall: only gone
+			   when its place is in plain view. */
+			{
+				trace_t trace;
+				vec3_t  eye;
+
+				VectorCopy(ps->origin, eye);
+				eye[2] += ps->viewheight;
+				trap_CM_BoxTrace(&trace, eye, thing->point, vec3_origin, vec3_origin, 0, MASK_SOLID);
+				if (trace.fraction < 0.97f)
+				{
+					continue;
+				}
+			}
+			thing->done = qtrue;
+		}
+
+		/* The one T led to, done. */
+		if (eta_things.target >= 0 && eta_things.target < eta_things.count && eta_things.things[eta_things.target].done)
+		{
+			char progress[160];
+
+			eta_things.target = -1;
+			int counts[3], left;
+
+			ETA_ThingsCount(counts, &left);
+			ETA_ThingsProgress(progress, sizeof(progress));
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say(left ? va("Done. %s. T leads to the next", progress)
+			               : "Done. Nothing else found to take or use");
+			ETA_Speech_EndReport();
+		}
+
+		/* The fight: begun when an enemy comes into sight after a calm,
+		   over when none has been in sight for a few seconds. */
+		{
+			etaAimTarget_t enemies[4];
+
+			if (CG_AccessibilityEnemyTargets(enemies, ARRAY_LEN(enemies), qtrue) > 0)
+			{
+				if (!eta_things.fighting
+				    && ( !eta_things.lastEnemyAt || cg.time - eta_things.lastEnemyAt >= ETA_FIGHT_CALM_MS ))
+				{
+					eta_things.fighting = qtrue;
+					VectorCopy(ps->origin, eta_things.fightFrom);
+				}
+				eta_things.lastEnemyAt = cg.time;
+			}
+			else if (eta_things.fighting && cg.time - eta_things.lastEnemyAt >= ETA_FIGHT_QUIET_MS)
+			{
+				eta_things.fighting = qfalse;
+				if (!ETA_ThingNear(ps->origin, eta_things.fightFrom, ETA_FIGHT_AWAY))
+				{
+					CG_AccessibilityChoose(eta_things.fightFrom, "where the fight began");
+					ETA_Speech_BeginReport();
+					ETA_Speech_Say("Fight over. O leads back to where it began");
+					ETA_Speech_EndReport();
+				}
+			}
+		}
+	}
+}
+
+void CG_AccessibilityThingsReset(void)
+{
+	memset(&eta_things, 0, sizeof(eta_things));
+	eta_things.target = -1;
+}
+
+#endif
