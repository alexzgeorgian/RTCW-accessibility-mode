 	}
 	else
 	{
@@ -2615,6 +2667,10 @@ void CG_AccessibilityAreasBack(void)
 	{
 		Com_sprintf(things, sizeof(things), ", %d %s left", left, left == 1 ? "thing" : "things");
 	}
+	else if (area < 0 && eta_backOutCount[-1 - area] < 0)
