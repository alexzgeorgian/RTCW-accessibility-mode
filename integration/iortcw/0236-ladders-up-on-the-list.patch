+		{
+			ladders += eta_areas.back[i] < 0 && eta_backOutCount[-1 - eta_areas.back[i]] < 0;
+		}
+		places = eta_areas.backCount - ladders;
+		ETA_Speech_Say(va("%s%s", withThings ? va("%d other %s explored, %d with things left", places,
+		                                          places == 1 ? "place" : "places", withThings)
+		                  : va("%d other %s explored, nothing left in them", places, places == 1 ? "place" : "places"),
+		                  ladders ? va(", and %d %s up", ladders, ladders == 1 ? "ladder" : "ladders") : ""));
 	}
-	if (area < 0)
