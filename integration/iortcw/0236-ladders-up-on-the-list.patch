-#define ETA_BACK_OUTDOORS 16
+#define ETA_BACK_OUTDOORS 32
 
 static vec3_t eta_backOutAt[ETA_BACK_OUTDOORS];
 static char   eta_backOutWhat[ETA_BACK_OUTDOORS][48];
 static int    eta_backOutCount[ETA_BACK_OUTDOORS];
+
+/*
+ * The ladders up, outdoors, on semicolon's list after the places: "the
+ * ladder up, 10 meters high, a soldier at the top", and O leads to its
+ * foot. The tester, in the forest, had once climbed to the north
+ * watchtower's guard, and could not find the way there again: O leads to
+ * the rifle by the tunnel, and a slope named in words cannot be walked
+ * blind. A sighted player sees the towers from afar. Counted -1, so
+ * among the places with nothing left, said with no count of things.
+ */
+static int ETA_LadderPlaces(int n)
+{
+	int l, ladders = CG_AccessibilityLadderCount();
+
+	if (!ETA_OutdoorMap())
+	{
+		return n;
+	}
+	for (l = 0; l < ladders && n < ETA_BACK_OUTDOORS; l++)
+	{
+		vec3_t   foot, top;
+		int      high, i;
+		qboolean soldier = qfalse;
+
+		if (!CG_AccessibilityLadderEnds(l, foot, top) || top[2] - foot[2] < 4.0f / ETA_QU_TO_METERS)
+		{
+			continue;
+		}
+		for (i = 0; i < MAX_CLIENTS; i++)
+		{
+			const centity_t *cent = &cg_entities[i];
+
+			if (cent->currentValid && i != cg.snap->ps.clientNum && cent->currentState.aiChar
+			    && !(cent->currentState.eFlags & EF_DEAD) && cent->currentState.teamNum != cg.snap->ps.teamNum
+			    && fabsf(cent->lerpOrigin[2] - top[2]) < 160.0f
+			    && ( cent->lerpOrigin[0] - top[0] ) * ( cent->lerpOrigin[0] - top[0] )
+			       + ( cent->lerpOrigin[1] - top[1] ) * ( cent->lerpOrigin[1] - top[1] ) < 320.0f * 320.0f)
+			{
+				soldier = qtrue;
+			}
+		}
+		high = (int)(( top[2] - foot[2] ) * ETA_QU_TO_METERS + 0.5f);
+		VectorCopy(foot, eta_backOutAt[n]);
+		Com_sprintf(eta_backOutWhat[n], sizeof(eta_backOutWhat[n]), "the ladder up, %d meters high%s", high,
+		            soldier ? ", soldier up top" : "");
+		eta_backOutCount[n] = -1;
+		n++;
+	}
+	return n;
+}
 void CG_AccessibilityAreasBack(void)
 {
 	const playerState_t *ps = &cg.predictedPlayerState;
