index e2b3a8d8..3957161a 100644
--- a/SP/code/cgame/cg_accessibility_areas.c
+++ b/SP/code/cgame/cg_accessibility_areas.c
@@ -1518,6 +1518,34 @@ static void ETA_AreaLike(int area, char *out, size_t size)
  */
 #define ETA_TUNNEL_ROOF 320.0f
 
+/* The map's tunnels, for the way-finder (cg_accessibility_route.c): each
+   area named a tunnel with a floor worth walking - not the slivers
+   between a doorway's posts - its box. */
+int CG_AccessibilityTunnelBoxes(vec3_t *mins, vec3_t *maxs, int max)
+{
+	int a, count = 0;
+
+	if (!ETA_OutdoorMap())
+	{
+		return 0;
+	}
+	for (a = 0; a < eta_areas.count && a < ETA_AREAS_MAX && count < max; a++)
+	{
+		char name[128];
+
+		if (ETA_BspAreas_Floor(a) / ( 39.37f * 39.37f ) < 20.0f || !ETA_BspAreas_Bounds(a, mins[count], maxs[count]))
+		{
+			continue;
+		}
+		ETA_AreaName(a, name, sizeof(name));
+		if (!Q_stricmpn(name, "the tunnel", 10))
+		{
+			count++;
+		}
+	}
+	return count;
+}
