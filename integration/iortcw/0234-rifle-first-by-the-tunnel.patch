+/* The nearest place where something an objective needs is picked up,
+   not met yet. The forest's way out is the supply truck in the compound,
+   and O led there - past the tunnel the tester remembered, by which the
+   Snooper rifle is reached, and which leaving without fails the level.
+   The rifle comes before the way out. */
+qboolean CG_AccessibilityObjectivePickupPlace(const vec3_t from, vec3_t out, int *objective)
+{
+	float best = 0.0f;
+	int   i, found = 0;
+
+	for (i = 0; i < eta_objectivePlaceCount; i++)
+	{
+		if (!eta_objectivePlaces[i].pickup || CG_AccessibilityObjectiveDone(eta_objectivePlaces[i].objective))
+		{
+			continue;
+		}
+		if (!found || Distance(from, eta_objectivePlaces[i].at) < best)
+		{
+			best = Distance(from, eta_objectivePlaces[i].at);
+			VectorCopy(eta_objectivePlaces[i].at, out);
+			*objective = eta_objectivePlaces[i].objective;
+			found      = 1;
+		}
+	}
+	return (qboolean)found;
+}
