+/*
+ * A tunnel on the way to a place: the foot of the ladder up inside one,
+ * when going by it is not much further than going straight there (half
+ * as far again, as the crow flies), and the player has not been through
+ * it yet - been to its ladder, or nearer the place than it is.
+ */
+#define ETA_TUNNEL_VIA_RATIO 1.5f
+
+static qboolean eta_tunnelViaDone[16];
+
+static qboolean ETA_TunnelOnTheWay(const vec3_t from, const vec3_t place, vec3_t via)
+{
+	vec3_t   mins[8], maxs[8];
+	int      boxes = CG_AccessibilityTunnelBoxes(mins, maxs, 8), b, l, ladders = CG_AccessibilityLadderCount();
+	float    best = 0.0f, direct = Distance(from, place);
+	qboolean found = qfalse;
+
+	for (l = 0; l < ladders && l < 16; l++)
+	{
+		vec3_t foot, top;
+
+		if (!CG_AccessibilityLadderEnds(l, foot, top) || top[2] < foot[2])
+		{
+			continue;
+		}
+		if (Distance(from, foot) < 128.0f)
+		{
+			eta_tunnelViaDone[l] = qtrue;
+		}
+		if (eta_tunnelViaDone[l] || Distance(foot, place) >= direct)
+		{
+			continue;
+		}
+		for (b = 0; b < boxes; b++)
+		{
+			float by;
+
+			if (foot[0] < mins[b][0] - 32.0f || foot[0] > maxs[b][0] + 32.0f || foot[1] < mins[b][1] - 32.0f
+			    || foot[1] > maxs[b][1] + 32.0f || foot[2] < mins[b][2] - 32.0f || foot[2] > maxs[b][2] + 64.0f)
+			{
+				continue;
+			}
+			by = Distance(from, foot) + Distance(foot, place);
+			if (by <= direct * ETA_TUNNEL_VIA_RATIO && ( !found || by < best ))
+			{
+				best  = by;
+				found = qtrue;
+				VectorCopy(foot, via);
+			}
+		}
+	}
+	return found;
+}
