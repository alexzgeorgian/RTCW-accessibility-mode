+/* The ways between the bots' rooms with no door - a doorway, an arch, a
+   narrow passage - as exits with no model, led to the middle of the
+   nearest piece of the room beyond. */
+static void ETA_AreasOpenings(void)
+{
+	int i, k, f, b;
+
+	for (i = 0; i < ETA_BspAreas_PortalCount() && eta_areas.exitCount < ETA_AREA_EXITS_MAX; i++)
+	{
+		eta_areaExit_t *exit;
+		vec3_t         at;
+
+		if (!ETA_BspAreas_Portal(i, at, &f, &b) || f >= ETA_AREAS_MAX || b >= ETA_AREAS_MAX)
+		{
+			continue;
+		}
+		/* A door's own: its door is on the list. Another for the same two
+		   rooms close by: the same way. */
+		for (k = 0; k < eta_areas.exitCount; k++)
+		{
+			const eta_areaExit_t *other = &eta_areas.exits[k];
+
+			if (Distance(other->middle, at) < ( other->model ? 128.0f : 96.0f )
+			    && ( other->model || ( ( other->area[0] == f && other->area[1] == b ) || ( other->area[0] == b && other->area[1] == f ) ) ))
+			{
+				break;
+			}
+		}
+		if (k < eta_areas.exitCount)
+		{
+			continue;
+		}
+		exit          = &eta_areas.exits[eta_areas.exitCount];
+		exit->model   = 0;
+		exit->opens   = qtrue;
+		exit->area[0] = f;
+		exit->area[1] = b;
+		VectorCopy(at, exit->middle);
+		if (!ETA_BspAreas_PointIn(f, at, exit->side[0]) || !ETA_BspAreas_PointIn(b, at, exit->side[1]))
+		{
+			continue;
+		}
+		eta_areas.exitCount++;
+	}
+}
