 	ETA_ExploredLoad();
-	CG_Printf("eta: %s has %d areas, %d doors between them\n", cgs.mapname, count, eta_areas.exitCount);
+	CG_Printf("eta: %s has %d areas%s, %d ways between them\n", cgs.mapname, count, bots ? " from its bots' file" : "",
