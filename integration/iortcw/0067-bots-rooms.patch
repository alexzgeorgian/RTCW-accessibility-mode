diff --git a/SP/code/cgame/cg_accessibility_world.c b/SP/code/cgame/cg_accessibility_world.c
index 071265a8..ae2d3650 100644
--- a/SP/code/cgame/cg_accessibility_world.c
+++ b/SP/code/cgame/cg_accessibility_world.c
@@ -1382,7 +1382,33 @@ static void ETA_LoadAreas(void)
 	{
 		trap_FS_FCloseFile(file.handle);
 	}
-	CG_AccessibilityAreasLoaded(count);
+
+	/* The rooms of the soldiers' own way-finding, where the level has
+	   its file: cut at every door and doorway. */
+	{
+		etaMapFile_t bots;
+		char         name[MAX_QPATH];
+		int          rooms = 0;
+
+		COM_StripExtension(cgs.mapname, name, sizeof(name));
+		Q_strcat(name, sizeof(name), "_b0.aas");
+		bots.handle = 0;
+		bots.left   = trap_FS_FOpenFile(name, &bots.handle, FS_READ);
+		if (bots.left > 0 && bots.handle)
+		{
+			rooms = ETA_BspAreas_LoadAas(ETA_MapFileRead, ETA_MapFileRestart, &bots);
+		}
+		if (bots.handle)
+		{
+			trap_FS_FCloseFile(bots.handle);
+		}
+		if (rooms > 1)
+		{
+			CG_AccessibilityAreasLoaded(rooms, qtrue);
+			return;
+		}
+	}
+	CG_AccessibilityAreasLoaded(count, qfalse);
 }
 
