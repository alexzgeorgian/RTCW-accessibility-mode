 /* The lowest in the order not pressed: 0 when all are. */
+/* Not seen since a game was loaded: pressed or not, not known. */
+static qboolean ETA_SwitchUnknown(int m)
+{
+	return (qboolean)( eta_orderLoaded && !eta_switchSeen[m] );
+}
+
+/* The next to press: of those known not to be pressed first - after a
+   load, one not seen since may be pressed already; the tester was sent
+   to the south one, and found it pressed. */
 static int ETA_OrderNextModel(void)
 {
-	int m, best = 0;
+	int m, best = 0, pass;
 
-	for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+	for (pass = 0; pass < 2 && !best; pass++)
 	{
-		if (eta_switchPlace[m] && eta_switchPart[m] && !eta_switchPressed[m]
-		    && ( !best || eta_switchPlace[m] < eta_switchPlace[best] ))
+		for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
 		{
-			best = m;
+			if (eta_switchPlace[m] && eta_switchPart[m] && !eta_switchPressed[m]
+			    && ETA_SwitchUnknown(m) == (qboolean)( pass == 1 )
+			    && ( !best || eta_switchPlace[m] < eta_switchPlace[best] ))
+			{
+				best = m;
+			}
 		}
 	}
 	return best;
 }
 
+/* How many not seen since a load. */
+static int ETA_OrderUnknown(void)
+{
+	int m, count = 0;
+
+	for (m = 1; m < MAX_MODELS && m < cgs.numInlineModels; m++)
+	{
+		count += ( eta_switchPlace[m] && eta_switchPart[m] && ETA_SwitchUnknown(m) ) ? 1 : 0;
+	}
+	return count;
+}
