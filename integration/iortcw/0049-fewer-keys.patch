+/* For L, which says it first in a new place, as F3 did: "3 ways on: 2
+   doors, 1 doorway". The look L asked for is the one it describes. */
+void CG_AccessibilityWaysSummaryText(char *out, size_t size)
+{
+	ETA_WaysSummary(out, size);
+}
+
+static float ETA_FrontierFar(const vec3_t from, const vec3_t to);
+
+/*
+ * For L, after the ways on from here: the nearest way found anywhere in
+ * the level and never tried, as V led to before the keys were made few -
+ * one not among the ways on from here. qfalse with none.
+ */
+qboolean CG_AccessibilityNewWayNearest(vec3_t lead, char *name, size_t nameSize, char *text, size_t textSize)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	int                 i, j, best = -1, meters;
+	float               bestFar = 0.0f;
+	vec3_t              delta;
+
+	for (i = 0; i < eta_frontier.count; i++)
+	{
+		const eta_frontier_t *way = &eta_frontier.ways[i];
+		float                far;
+
+		if (way->tried)
+		{
+			continue;
+		}
+		for (j = 0; j < eta_ways.wayCount; j++)
+		{
+			if (ETA_FrontierNear(way->feature, eta_ways.ways[j].feature, ETA_FRONTIER_SAME))
+			{
+				break;
+			}
+		}
+		if (j < eta_ways.wayCount)
+		{
+			continue;   /* one of the ways on from here: said with them */
+		}
+		far = ETA_FrontierFar(ps->origin, way->feature);
+		if (best < 0 || far < bestFar)
+		{
+			best    = i;
+			bestFar = far;
+		}
+	}
+	if (best < 0)
+	{
+		return qfalse;
+	}
+
+	VectorCopy(eta_frontier.ways[best].lead, lead);
+	Com_sprintf(name, nameSize, "the new %s", eta_wayWords[eta_frontier.ways[best].kind]);
+	if (nameSize > 8)
+	{
+		name[8] = (char)tolower((unsigned char)name[8]);
+	}
+	VectorSubtract(eta_frontier.ways[best].feature, ps->origin, delta);
+	meters = (int)(VectorLength(delta) * ETA_QU_TO_METERS + 0.5f);
+	meters = meters < 1 ? 1 : meters;
+	Com_sprintf(text, textSize, "Nearest way not yet tried: %s, %s, %d %s", eta_wayWords[eta_frontier.ways[best].kind],
+	            ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(eta_frontier.ways[best].feature)), meters,
+	            meters == 1 ? "meter" : "meters");
+	return qtrue;
+}
+
 /* How far a way is, for choosing the nearest: a floor up or down counts
    double, as it does for the way out. */
 static float ETA_FrontierFar(const vec3_t from, const vec3_t to)
@@ -1672,7 +1740,7 @@ static void ETA_FrontierFrame(void)
