+/*
+ * Room for the player's own body, its full width and standing height, on
+ * the straight line to a point. The line the ping points along is looked
+ * at with a probe narrower than a player, so that a doorway is found
+ * wherever the squares fall; but the player walks it with their body. At
+ * the start of a walk on the tram level the ping pointed past the corner
+ * of a wall the probe slipped by and the player did not: W walked into
+ * it, and O said "Facing the way" again, a hundred times over. A line
+ * the body does not fit is not pointed along: the point nearer, which
+ * the search stepped to square by square, is.
+ */
+static qboolean ETA_RouteBodyClear(const vec3_t from, const vec3_t to)
+{
+	static const vec3_t mins = { -ETA_ROUTE_BODY_HALF + 1.0f, -ETA_ROUTE_BODY_HALF + 1.0f, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_BODY_HALF - 1.0f, ETA_ROUTE_BODY_HALF - 1.0f, ETA_ROUTE_BODY_TOP };
+	trace_t             trace;
+	vec3_t              a, b;
+
+	VectorCopy(from, a);
+	VectorCopy(to, b);
+	a[2] = b[2] = MAX(a[2], b[2]);
+	trap_CM_BoxTrace(&trace, a, b, mins, maxs, 0, MASK_PLAYERSOLID);
+	/* Already pressed into something where they stand: said by the
+	   other looks, not this one. */
+	return (qboolean)( trace.startsolid || trace.fraction >= 1.0f );
+}
