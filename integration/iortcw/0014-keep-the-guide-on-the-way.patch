+static void ETA_GuideJump(qboolean down)
+{
+	if (down == eta_guide.jumpHeld)
+	{
+		return;
+	}
+	trap_SendConsoleCommand(va("%smoveup " ETA_GUIDE_KEY_JUMP "\n", down ? "+" : "-"));
+	eta_guide.jumpHeld = down;
+	if (down)
+	{
+		eta_guide.jumpAt = cg.time;
+	}
+}
+
+static void ETA_GuideCrouch(qboolean down)
+{
+	if (down == eta_guide.crouchHeld)
