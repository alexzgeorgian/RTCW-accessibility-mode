+/**
+ * @brief Whether the way needs a jump just ahead, for the walk guide to
+ * take: the player is at its edge, and the landing is ahead of them.
+ */
+qboolean CG_AccessibilityMarkerJumpNow(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              toEdge, toLanding, forward;
+
+	if (!eta_marker.active || !eta_route.jumpNext)
+	{
+		return qfalse;
+	}
+
+	VectorSubtract(eta_route.jumpEdge, ps->origin, toEdge);
+	toEdge[2] = 0.0f;
+	if (VectorLength(toEdge) > 40.0f)
+	{
+		return qfalse;
+	}
+
+	VectorSubtract(eta_route.jumpLanding, ps->origin, toLanding);
+	toLanding[2] = 0.0f;
+	VectorNormalize(toLanding);
+	AngleVectors(ps->viewangles, forward, NULL, NULL);
+	forward[2] = 0.0f;
+	VectorNormalize(forward);
+
+	return (qboolean)(DotProduct(forward, toLanding) > 0.7f);
+}
+
+/**
+ * @brief Whether the way goes up or down a ladder next, for the walk
+ * guide to climb it once the player is at it.
+ */
+qboolean CG_AccessibilityMarkerLadderNext(void)
+{
+	return (qboolean)(eta_marker.active && eta_route.ladderNext);
+}
+
+/**
+ * @brief Whether the way goes under something low here, for the walk
+ * guide to crouch: told to crouch and not yet to stand.
+ */
+qboolean CG_AccessibilityMarkerCrouchNow(void)
+{
+	return (qboolean)(eta_marker.active && eta_route.crouched);
+}
