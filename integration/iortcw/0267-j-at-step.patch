+/* The step of the hidden way, or hidden place, the player stands at:
+   within 3 metres across and 2 up or down. */
+static const char *ETA_HiddenPlaceReached(const vec3_t at)
+{
+	char base[MAX_QPATH];
+	int  i;
+
+	COM_StripExtension(COM_SkipPath(cgs.mapname), base, sizeof(base));
+	for (i = 0; i < (int)ARRAY_LEN(eta_hiddenPlaces); i++)
+	{
+		const float *p = eta_hiddenPlaces[i].at;
+
+		if (!Q_stricmp(eta_hiddenPlaces[i].map, base)
+		    && ( at[0] - p[0] ) * ( at[0] - p[0] ) + ( at[1] - p[1] ) * ( at[1] - p[1] ) < 120.0f * 120.0f
+		    && fabsf(at[2] - 24.0f - p[2]) < 80.0f)
+		{
+			return eta_hiddenPlaces[i].name;
+		}
+	}
+	return NULL;
+}
