+/* With a step of a level's hidden way reached, J and F1 say so first:
+   outdoors one area runs on for a hundred metres and more, and the
+   tester, walking the forest's way round the gate, heard the same place
+   at every step. Said only once there, not as a distance. */
 void CG_AccessibilityAreaText(char *out, size_t size)
+{
+	const char *step = ETA_HiddenPlaceReached(cg.predictedPlayerState.origin);
+	char        rest[512];
+
+	ETA_AreaTextOnly(rest, sizeof(rest));
+	if (step)
+	{
+		Com_sprintf(out, size, "At %s. %s", step, rest);
+		return;
+	}
+	Q_strncpyz(out, rest, size);
+}
