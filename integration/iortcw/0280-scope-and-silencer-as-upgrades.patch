+/*
+ * A scope or a silencer put on or taken off: the same weapon, upgraded,
+ * not another one. The tester asked for them to be said so - "Scope on",
+ * not "Snooper rifle, scope, 5, 999 more" as if a new weapon were taken
+ * up. NULL for any other change of weapon.
+ */
+static const char *CG_AccessibilityAttachmentText( int from, int to ) {
+	qboolean scopedFrom, scopedTo;
+
+	if ( from <= WP_NONE || from >= WP_NUM_WEAPONS || to <= WP_NONE || to >= WP_NUM_WEAPONS
+		 || ( weapAlts[from] != to && weapAlts[to] != from ) ) {
+		return NULL;
+	}
+	scopedFrom = (qboolean)( from == WP_SNIPERRIFLE || from == WP_SNOOPERSCOPE || from == WP_FG42SCOPE );
+	scopedTo = (qboolean)( to == WP_SNIPERRIFLE || to == WP_SNOOPERSCOPE || to == WP_FG42SCOPE );
+	if ( scopedTo ) {
+		return "Scope on";
+	}
+	if ( scopedFrom ) {
+		return "Scope off";
+	}
+	if ( to == WP_SILENCER ) {
+		return "Silencer on";
+	}
+	if ( from == WP_SILENCER ) {
+		return "Silencer off";
+	}
+	return NULL;
+}
