 }
 
+#ifdef FEATURE_ACCESSIBILITY
+/* A heading the game made a button with nothing to do - the Save
+   screen's title, "Save", read before its Save button - is passed over:
+   a stop that Enter does nothing on, and said like the button. */
+static qboolean ETA_ItemInert( itemDef_t *item ) {
+	return (qboolean)( item && ( item->type == ITEM_TYPE_BUTTON || item->type == ITEM_TYPE_TEXT )
+					   && !item->action && !item->cvar && !item->onFocus );
+}
+#endif
