+++ b/SP/code/ui/ui_shared.c
@@ -1932,10 +1932,27 @@ const char *ETA_MenuItem_Label( itemDef_t *item ) {
 		char *out = trimmed[which = ( which + 1 ) & 3];
 		int end;
 
+		/* The skill levels, by the game's jokes for them: what each is. */
+		static const struct {
+			const char *name;
+			const char *what;
+		} skills[] = {
+			{ "wimpy", "easiest" }, { "wuss", "easy" }, { "hurt me", "medium" }, { "hurt me plenty", "hard" },
+		};
+		int i;
+
 		Q_strncpyz( out, item->text, ETA_MAX_MENU_TEXT_LENGTH );
 		for ( end = (int)strlen( out ); end > 0 && ( out[end - 1] == ' ' || out[end - 1] == ':' ); end-- ) {
 			out[end - 1] = '\0';
 		}
+		if ( item->parent && ( (menuDef_t*)item->parent )->window.name && item->window.name
+			 && !Q_stricmp( ( (menuDef_t*)item->parent )->window.name, "play_menu" ) ) {
+			for ( i = 0; i < (int)( sizeof( skills ) / sizeof( skills[0] ) ); i++ ) {
+				if ( !Q_stricmp( item->window.name, skills[i].name ) ) {
+					Q_strcat( out, ETA_MAX_MENU_TEXT_LENGTH, va( ", %s", skills[i].what ) );
+				}
+			}
+		}
 		if ( out[0] ) {
 			return out;
 		}
@@ -3574,6 +3591,16 @@ void Item_Action( itemDef_t *item ) {
