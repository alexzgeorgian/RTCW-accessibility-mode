+/* A secret area found - the mission's figures count one more - is the
+   one the player is at; and one not found, come near, is hinted at. */
+static void ETA_SecretsFrame(void)
+{
+	const playerState_t *ps    = &cg.predictedPlayerState;
+	int                 found = CG_AccessibilitySecretsFound(), i;
+
+	while (found > eta_things.secrets)
+	{
+		int   best = -1;
+		float bestFar = ETA_SECRET_FOUND;
+
+		eta_things.secrets++;
+		for (i = 0; i < eta_things.count; i++)
+		{
+			eta_thing_t *thing = &eta_things.things[i];
+
+			if (thing->kind == ETA_THING_SECRET && !thing->done && Distance(ps->origin, thing->point) < bestFar)
+			{
+				best    = i;
+				bestFar = Distance(ps->origin, thing->point);
+			}
+		}
+		if (best >= 0)
+		{
+			eta_things.things[best].done = qtrue;
+		}
+	}
+	eta_things.secrets = found;
+
+	for (i = 0; i < eta_things.count; i++)
+	{
+		eta_thing_t *thing = &eta_things.things[i];
+
+		if (thing->kind == ETA_THING_SECRET && !thing->done && !thing->hinted && i != eta_things.target
+		    && ETA_ThingNear(ps->origin, thing->point, ETA_SECRET_HINT))
+		{
+			int meters = (int)(Distance(ps->origin, thing->point) * ETA_QU_TO_METERS + 0.5f);
+
+			thing->hinted = qtrue;
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say(va("A secret area is near, %d %s, %s", meters < 1 ? 1 : meters, meters == 1 ? "meter" : "meters",
+			                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(thing->point))));
+			ETA_Speech_EndReport();
+			break;
+		}
+	}
 }
 
