 static qboolean ETA_ItemFocused(void)
@@ -1429,12 +1431,40 @@ void CG_AccessibilityAimLockDown_f(void)
 
 void CG_AccessibilityAimLockUp_f(void)
 {
-	if (eta_aim.mode == ETA_AIM_LOCK && !eta_aim.automatic)
+	if (eta_aim.mode == ETA_AIM_LOCK && !eta_aim.automatic && !eta_aim.toggled)
