+/**
+ * @brief The lock as a key to press, not to hold: U.
+ *
+ * The tester plays on a laptop, which has no Insert, and asked for the
+ * enemies to have their own key the way F is for things: U turns to the
+ * enemy chosen with I or Y - or else the nearest in sight - and keeps the
+ * aim on them, on to the next when they fall; U again, or a turn with
+ * the arrows, lets go.
+ */
+void CG_AccessibilityEnemyLock_f(void)
+{
+	if (eta_aim.mode == ETA_AIM_LOCK && !eta_aim.automatic && eta_aim.toggled)
+	{
+		ETA_AimStop();
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say("Lock off");
+		return;
+	}
+
+	CG_AccessibilityAimLockDown_f();
+
+	if (eta_aim.mode == ETA_AIM_LOCK)
+	{
+		eta_aim.automatic = qfalse;
+		eta_aim.toggled   = qtrue;
+	}
+}
+
 /**
  * @brief The lock by itself: an enemy in sight, where the lock may run.
  */
@@ -2551,7 +2581,7 @@ static void ETA_HitFrame(void)
 	{
 		eta_hit.saidAt = cg.time;
 		ETA_HudNarrator_HoldPassive(cg.time);
-		ETA_AimSay(va(focused && eta_autoLock.integer ? "Hit by %s. Insert turns to them" : "Hit by %s",
+		ETA_AimSay(va(focused && eta_autoLock.integer ? "Hit by %s. U turns to them" : "Hit by %s",
 		              CG_AccessibilityCharacterName(attacker)),
 		           cg_entities[attacker].lerpOrigin);
 	}
@@ -2811,6 +2841,13 @@ void CG_AccessibilityAimFrame(void)
 		eta_aim.saidLost = qtrue;
 		ETA_Speech_Say("Lock lost");
 	}
+
+	/* Pressed on with U: over, rather than waiting to turn the player to
+	   whoever comes next. */
+	if (eta_aim.toggled)
+	{
+		ETA_AimStop();
+	}
 }
 
