#include "ui/menudef.h"

// The Accessibility button, put into the game's own menus as they load
// (ui_main.c, UI_AccessibilityMenus): after OPTIONS in the main menu, and
// after SYSTEM among the paused game's tabs, so the arrows come to it
// there. Not among the Setup tabs that OPTIONS opens: that screen gives
// the keyboard to its Controls page at once, and the tabs above it are
// out of the arrows' reach. The game's menu files are the game's, and are
// not shipped; this is the one tab added to each, and the Load menus
// get their two categories (below).
//
//   tab <menu it goes in> <item it follows> itemDef { ... }
//   item <menu it goes in> <item it follows> itemDef { name ... }
//
// "item" is any other item of the mode's own, kept under its own name.
//
// The two names bare, not quoted: the menu reader joins quoted strings
// side by side into one.

{
	tab main options itemDef {
		text "ACCESSIBILITY"
		type ITEM_TYPE_BUTTON
		style 0
		textstyle 6
		rect 290 396 110 14
		textalign 0
		textscale .2308
		textalignx 2
		textaligny 14
		forecolor .9 .9 .9 1
		visible 1
		textfont UI_FONT_NORMAL
		action { play "sound/misc/zap.wav" ;
			uiScript etaAccessibilityClose ;
			open eta_accessibility }
	}

	tab ingame system itemDef {
		text "ACCESSIBILITY"
		type ITEM_TYPE_BUTTON
		textfont UI_FONT_NORMAL
		rect 454 110 120 14
		textstyle 6
		textalign 1
		textalignx 60
		textaligny 11
		textscale .2
		forecolor .8 .8 .8 1
		backcolor .4 .4 .4 .6
		visible 1
		action { close ingame_options ;
			close ingame_controls ;
			close ingame_system ;
			close ingame_save ;
			close ingame_load ;
			close ingame_leave ;
			uiScript etaAccessibilityClose ;
			open eta_accessibility }
	}

	// The Load menu's two categories, as Options has its pages: the saved
	// games, and the autosaves. The game's own switch between them has no
	// words on it; the arrows pass it by once these are in. Put second
	// after the first, each after the last of the menu's frames ("window2"),
	// so they come before the list.

	item load_menu window2 itemDef {
		name eta_saves_auto
		text "AUTOSAVES"
		type ITEM_TYPE_BUTTON
		style 0
		textstyle 6
		rect 400 170 150 14
		textalign 0
		textscale .23
		textalignx 2
		textaligny 12
		forecolor .9 .9 .9 1
		visible 1
		textfont UI_FONT_NORMAL
		action { setcvar ui_savegameListAutosave 1 ;
			uiScript update "ui_savegameListAutosave" ;
			uiScript etaSavesSay }
	}

	item load_menu window2 itemDef {
		name eta_saves_manual
		text "SAVED GAMES"
		type ITEM_TYPE_BUTTON
		style 0
		textstyle 6
		rect 400 152 150 14
		textalign 0
		textscale .23
		textalignx 2
		textaligny 12
		forecolor .9 .9 .9 1
		visible 1
		textfont UI_FONT_NORMAL
		action { setcvar ui_savegameListAutosave 0 ;
			uiScript update "ui_savegameListAutosave" ;
			uiScript etaSavesSay }
	}

	item ingame_load window2 itemDef {
		name eta_saves_auto
		text "AUTOSAVES"
		type ITEM_TYPE_BUTTON
		style 0
		textstyle 6
		rect 310 68 150 14
		textalign 0
		textscale .23
		textalignx 2
		textaligny 12
		forecolor .9 .9 .9 1
		visible 1
		textfont UI_FONT_NORMAL
		action { setcvar ui_savegameListAutosave 1 ;
			uiScript update "ui_savegameListAutosave" ;
			uiScript etaSavesSay }
	}

	item ingame_load window2 itemDef {
		name eta_saves_manual
		text "SAVED GAMES"
		type ITEM_TYPE_BUTTON
		style 0
		textstyle 6
		rect 310 50 150 14
		textalign 0
		textscale .23
		textalignx 2
		textaligny 12
		forecolor .9 .9 .9 1
		visible 1
		textfont UI_FONT_NORMAL
		action { setcvar ui_savegameListAutosave 0 ;
			uiScript update "ui_savegameListAutosave" ;
			uiScript etaSavesSay }
	}
}
