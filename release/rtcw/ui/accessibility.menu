#include "ui/menudef.h"

// The Accessibility pages: the mode's own settings, as the ET mode keeps
// them under ACCESSIBILITY in its Options. Reached by the ACCESSIBILITY
// button the mode puts among the Options screen's sections and the paused
// game's tabs (accessibility_tabs.menu), and laid over the screen where
// the game's own Options pages are. Up and Down go through a page,
// Enter changes a setting, Escape goes back. Each setting is a cvar the
// cgame reads every frame, so a change takes effect at once, and is kept
// in the config. The cvars and their defaults: cg_accessibility_settings.h.

#define ETA_PAGE_RECT rect 100 125 443 340

#define ETA_TITLE(TEXT) itemDef { \
		text TEXT \
		style 0 \
		textstyle 6 \
		rect 0 4 443 16 \
		textalign ITEM_ALIGN_CENTER \
		textalignx 221 \
		textaligny 13 \
		textscale .25 \
		forecolor 1 1 1 1 \
		visible 1 \
		decoration \
	}

#define ETA_WINDOW itemDef { \
		rect 0 2 443 300 \
		style WINDOW_STYLE_FILLED \
		border 1 \
		bordercolor .5 .5 .5 .5 \
		forecolor 1 1 1 1 \
		backcolor 0 0 0 .6 \
		visible 1 \
		decoration \
	}

#define ETA_BUTTON(Y, TEXT, ACTION) itemDef { \
		text TEXT \
		type ITEM_TYPE_BUTTON \
		style WINDOW_STYLE_FILLED \
		rect 121 Y 200 16 \
		textalign ITEM_ALIGN_CENTER \
		textalignx 100 \
		textaligny 12 \
		textscale .23 \
		backcolor 1 1 1 .07 \
		forecolor 1 1 1 1 \
		visible 1 \
		action { play "sound/misc/kcaction.wav" ; ACTION } \
	}

#define ETA_YESNO(Y, TEXT, CVAR) itemDef { \
		type ITEM_TYPE_YESNO \
		text TEXT \
		cvar CVAR \
		rect 32 Y 379 14 \
		textalign ITEM_ALIGN_RIGHT \
		textalignx 250 \
		textaligny 11 \
		textscale .22 \
		style WINDOW_STYLE_FILLED \
		backcolor 1 1 1 .07 \
		forecolor 1 1 1 1 \
		visible 1 \
	}

// A key of the mode's: Enter, then the key to put it on; Backspace
// clears it. The game's own keys stay on its Controls page.
#define ETA_KEY(Y, TEXT, COMMAND) itemDef { \
		type ITEM_TYPE_BIND \
		text TEXT \
		cvar COMMAND \
		rect 32 Y 379 14 \
		textalign ITEM_ALIGN_RIGHT \
		textalignx 250 \
		textaligny 11 \
		textscale .22 \
		style WINDOW_STYLE_FILLED \
		backcolor 1 1 1 .07 \
		forecolor 1 1 1 1 \
		visible 1 \
	}

/* The game's own volumes, 0 to 1, as on its System page: here too, as
   the tester found VoiceOver louder than the game, and turns the game up
   from where the mode's volumes are. */
#define ETA_GAME_VOLUME(Y, TEXT, CVAR) itemDef { \
		type ITEM_TYPE_MULTI \
		text TEXT \
		cvar CVAR \
		cvarFloatList { "Full" 1 "90 percent" 0.9 "80 percent" 0.8 "70 percent" 0.7 "60 percent" 0.6 "50 percent" 0.5 "40 percent" 0.4 "30 percent" 0.3 "25 percent" 0.25 "20 percent" 0.2 "10 percent" 0.1 "Off" 0 } \
		rect 32 Y 379 14 \
		textalign ITEM_ALIGN_RIGHT \
		textalignx 250 \
		textaligny 11 \
		textscale .22 \
		style WINDOW_STYLE_FILLED \
		backcolor 1 1 1 .07 \
		forecolor 1 1 1 1 \
		visible 1 \
	}

#define ETA_VOLUME(Y, TEXT, CVAR) itemDef { \
		type ITEM_TYPE_MULTI \
		text TEXT \
		cvar CVAR \
		cvarFloatList { "Full" 100 "75 percent" 75 "50 percent" 50 "25 percent" 25 "Off" 0 } \
		rect 32 Y 379 14 \
		textalign ITEM_ALIGN_RIGHT \
		textalignx 250 \
		textaligny 11 \
		textscale .22 \
		style WINDOW_STYLE_FILLED \
		backcolor 1 1 1 .07 \
		forecolor 1 1 1 1 \
		visible 1 \
	}

{

// The first page: one button for each of the others.
menuDef {
	name "eta_accessibility"
	visible 0
	fullscreen 0
	outOfBoundsClick
	ETA_PAGE_RECT
	focusColor 1 .75 0 1
	style 1
	border 1
	onEsc { uiScript etaAccessibilityLeave }

	ETA_WINDOW
	ETA_TITLE("ACCESSIBILITY")
	ETA_BUTTON(40, "WHAT YOU ARE TOLD", close eta_accessibility ; open eta_acc_told)
	ETA_BUTTON(64, "SOUNDS", close eta_accessibility ; open eta_acc_sounds)
	ETA_BUTTON(88, "VOLUMES", close eta_accessibility ; open eta_acc_volumes)
	ETA_BUTTON(112, "MOVING AND AIMING", close eta_accessibility ; open eta_acc_moving)
	ETA_BUTTON(136, "KEY BINDS", close eta_accessibility ; open eta_acc_keys)
	ETA_BUTTON(168, "BACK", uiScript etaAccessibilityLeave)
}

// What you are told: what the mode says as you play, without a key.
menuDef {
	name "eta_acc_told"
	visible 0
	fullscreen 0
	outOfBoundsClick
	ETA_PAGE_RECT
	focusColor 1 .75 0 1
	style 1
	border 1
	onEsc { close eta_acc_told ; open eta_accessibility }

	ETA_WINDOW
	ETA_TITLE("WHAT YOU ARE TOLD")
	ETA_YESNO(32, "Walls, doors, stairs and drops ahead", "eta_environmentCallouts")
	ETA_YESNO(50, "Openings to the side as you walk", "eta_openingCallouts")
	ETA_YESNO(68, "The kind of place you walk into", "eta_placeCallouts")
	ETA_YESNO(86, "New area and its doors out", "eta_waysCallouts")
	ETA_YESNO(104, "Enemies and friends near you", "eta_playerCallouts")
	ETA_YESNO(122, "Things on the ground", "eta_groundCallouts")
	ETA_YESNO(140, "Furniture as you pass it", "eta_furnitureCallouts")
	ETA_YESNO(158, "Direction as you turn", "eta_facingCallouts")
	ETA_BUTTON(186, "BACK", close eta_acc_told ; open eta_accessibility)
}

// Sounds: the mode's sounds, placed where things are.
menuDef {
	name "eta_acc_sounds"
	visible 0
	fullscreen 0
	outOfBoundsClick
	ETA_PAGE_RECT
	focusColor 1 .75 0 1
	style 1
	border 1
	onEsc { close eta_acc_sounds ; open eta_accessibility }

	ETA_WINDOW
	ETA_TITLE("SOUNDS")
	ETA_YESNO(32, "Door sounds", "eta_doorCues")
	ETA_YESNO(50, "Ladder sounds", "eta_ladderCues")
	ETA_YESNO(68, "Pickup sounds", "eta_pickupCues")
	ETA_YESNO(86, "Crosshair ticks", "eta_crosshairCues")
	ETA_YESNO(104, "Enemy sounds", "eta_enemyCues")
	ETA_YESNO(122, "Marker ping", "eta_markerCues")
	ETA_YESNO(140, "Bump sounds", "eta_bumpCues")
	ETA_BUTTON(168, "BACK", close eta_acc_sounds ; open eta_accessibility)
}

// Volumes: how loud each of the mode's sounds is.
menuDef {
	name "eta_acc_volumes"
	visible 0
	fullscreen 0
	outOfBoundsClick
	ETA_PAGE_RECT
	focusColor 1 .75 0 1
	style 1
	border 1
	onEsc { close eta_acc_volumes ; open eta_accessibility }

	ETA_WINDOW
	ETA_TITLE("VOLUMES")
	ETA_VOLUME(32, "Door volume", "eta_doorVolume")
	ETA_VOLUME(50, "Ladder volume", "eta_ladderVolume")
	ETA_VOLUME(68, "Pickup volume", "eta_pickupVolume")
	ETA_VOLUME(86, "Crosshair and enemy volume", "eta_crosshairVolume")
	ETA_VOLUME(104, "Bump volume", "eta_bumpVolume")
	ETA_VOLUME(122, "Marker volume", "eta_markerVolume")
	ETA_VOLUME(140, "The game's alarm volume", "eta_alarmVolume")
	ETA_GAME_VOLUME(158, "The game's sounds", "s_volume")
	ETA_GAME_VOLUME(176, "The game's music", "s_musicvolume")
	ETA_BUTTON(204, "BACK", close eta_acc_volumes ; open eta_accessibility)
}

// Moving and aiming: the help with turning, walking and aiming.
menuDef {
	name "eta_acc_moving"
	visible 0
	fullscreen 0
	outOfBoundsClick
	ETA_PAGE_RECT
	focusColor 1 .75 0 1
	style 1
	border 1
	onEsc { close eta_acc_moving ; open eta_accessibility }

	ETA_WINDOW
	ETA_TITLE("MOVING AND AIMING")
	ETA_YESNO(32, "Arrows turn by compass points", "eta_turnSteps")
	ETA_YESNO(50, "Turned along curved stairs", "eta_stairKeeper")
	ETA_YESNO(68, "Aim locks on to enemies by itself", "eta_autoLock")
	ETA_YESNO(86, "Turned along the way as you walk", "eta_autoSteer")
	ETA_YESNO(104, "T leads straight to secret areas", "eta_secretsLead")
	ETA_YESNO(122, "Stopped at the edge of a drop", "eta_edgeGuard")
	ETA_YESNO(140, "Crouch key: press to crouch, again to stand", "eta_crouchToggle")
	ETA_BUTTON(168, "BACK", close eta_acc_moving ; open eta_accessibility)
}

// The mode's keys, all on one page, as Enemy Territory's mode has them
// under Key binds - the tester found three pages of them not as one.
// Each row says its key; Enter puts it on another. The game's own keys
// stay on its Controls page. Taller than the other pages, to hold them.
menuDef {
	name "eta_acc_keys"
	visible 0
	fullscreen 0
	outOfBoundsClick
	rect 100 30 443 422
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen { uiScript loadControls }
	onEsc { close eta_acc_keys ; open eta_accessibility }
	itemDef {
		rect 0 2 443 416
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		backcolor 0 0 0 .75
		visible 1
		decoration
	}
	ETA_TITLE("KEY BINDS")
	ETA_KEY(28, "The way on", "accessibilityWayOut")
	ETA_KEY(44, "The doors out of this area", "accessibilityAreaExits")
	ETA_KEY(60, "Back through the areas explored", "accessibilityAreasBack")
	ETA_KEY(76, "Mark a waypoint where you stand", "accessibilityWaypointPlace")
	ETA_KEY(92, "Your waypoints, Shift goes back", "accessibilityWaypointList")
	ETA_KEY(108, "Go to the waypoint on top", "accessibilityWaypointTop")
	ETA_KEY(124, "Take the marker away", "accessibilityMarkerClear")
	ETA_KEY(140, "Turn left", "+accessibilityTurnLeft")
	ETA_KEY(156, "Turn right", "+accessibilityTurnRight")
	ETA_KEY(172, "Next thing to take, press or break", "accessibilityThingsNext")
	ETA_KEY(188, "Previous thing", "accessibilityThingsPrev")
	ETA_KEY(204, "Use, turn to a thing, climb a ladder", "+accessibilityActivate")
	ETA_KEY(220, "Lock on to an enemy, and again to let go", "accessibilityEnemyLock")
	ETA_KEY(236, "Lock on while held", "+accessibilityAimLock")
	ETA_KEY(252, "Where you are", "accessibilityStatus")
	ETA_KEY(268, "Health", "accessibilityHealth")
	ETA_KEY(284, "Weapon, ammo and what you carry", "accessibilityAmmo")
	ETA_KEY(300, "Facing and coordinates", "accessibilityFacing")
	ETA_KEY(316, "What is ahead", "accessibilityAhead")
	ETA_KEY(332, "Say the last thing again", "accessibilityRepeat")
	ETA_KEY(348, "Read the screen", "accessibilityReadScreen")
	ETA_KEY(364, "Stop speaking", "accessibilityStopSpeech")
	ETA_BUTTON(392, "BACK", close eta_acc_keys ; open eta_accessibility)
}
}
